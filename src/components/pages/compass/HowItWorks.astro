---
/**
 * WO-2.1 — /compass/how-it-works, shared across every locale.
 * 301 target for compass.bearingbridge.com/en/how-we-use-it.
 *
 * The page's whole subject is a sequence, so the layout is built around one:
 * a sticky route rail on the left that tracks which phase you are reading,
 * and full-bleed candid photography on the right. The shortlist and longlist
 * choice is a real control rather than two static cards, because the reader is
 * genuinely picking between them.
 *
 * The source page carried a "one project, one fee" section with amounts in it.
 * The spec bans figures, so the commercial section says how the engagement
 * works without putting a number on it.
 *
 * Motion: reveal-on-scroll, a scroll-driven route rail, a segmented control,
 * cursor spotlight and a slow hero parallax. Everything sits behind a
 * prefers-reduced-motion guard.
 */
import Layout from '../../../layouts/Layout.astro';
import CompassHero from './CompassHero.astro';
import { getLocaleFromUrl, localizePath } from '../../../i18n/utils';
import type { CompassCopy } from '../../../content/pages/compass/types';

interface Props {
  copy: CompassCopy;
}

const { copy } = Astro.props;
const { facts, howItWorks: c } = copy;

const locale = getLocaleFromUrl(Astro.url);
const homeHref = localizePath('/', locale);
const compassHref = localizePath('/compass', locale);
const shortlistHref = localizePath('/compass/shortlist', locale);
const whatIsInsideHref = localizePath('/compass/what-is-inside', locale);

const phaseImages = [
  '/Images/compass/hiw-brief.png',
  '/Images/compass/hiw-database.png',
  '/Images/compass/hiw-delivery.png',
];

/**
 * The dot cluster beside each option. It draws the size of the list rather
 * than labelling it, so the difference between three names and twenty reads
 * before the sentence does. Counts are the low end of each range in the copy.
 */
const optionDots = [5, 20];
---

<Layout title={c.title} description={c.description}>
  <!-- Hero, shared layout with the rest of the Find a partner section -->
  <CompassHero
    crumbs={[
      { label: c.crumbHome, href: homeHref },
      { label: c.crumbSection, href: compassHref },
    ]}
    eyebrow={c.eyebrow}
    rows={c.h1Rows}
    lead={c.lead}
    primary={{ label: c.ctaPrimary, href: shortlistHref }}
    secondary={{ label: c.ctaSecondary, href: '#engagement' }}
    stats={c.heroStats}
    image={{ src: '/Images/compass/hiw-hero.png', alt: c.heroAlt }}
    scrollCue={c.scrollCue}
    scrollTarget="#steps"
  />

  <!-- ------------------------------------------------------------- In short -->
  <section class="section hw-short" id="steps">
    <div class="container">
      <div class="section-header hw-reveal">
        <span class="eyebrow">{facts.steps.eyebrow}</span>
        <h2 class="h2">{facts.steps.title}</h2>
      </div>

      <ol class="hw-stations" data-stations>
        <span class="hw-stations__line" aria-hidden="true"></span>
        {
          facts.steps.items.map((step, i) => (
            <li class="hw-station hw-reveal" style={`--hw-d: ${i * 90}ms`}>
              <span class="hw-station__dot" aria-hidden="true"></span>
              <h3 class="hw-station__label">{step.label}</h3>
              <p class="hw-station__body">{step.body}</p>
            </li>
          ))
        }
      </ol>

      <blockquote class="hw-quote hw-reveal">{facts.steps.quote}</blockquote>
    </div>
  </section>

  <!-- ----------------------------------------------------------- Engagement -->
  <section class="section section--alt hw-engage" id="engagement">
    <div class="container">
      <div class="section-header hw-reveal">
        <span class="eyebrow">{c.engagementEyebrow}</span>
        <h2 class="h2">{c.engagementTitle}</h2>
        <p class="lead">{c.engagementLead}</p>
      </div>

      <div class="hw-track" data-track>
        <!-- Sticky rail: shows where you are in the sequence -->
        <aside class="hw-rail" aria-hidden="true">
          <div class="hw-rail__line">
            <span class="hw-rail__fill" data-track-fill></span>
          </div>
          <ul class="hw-rail__list">
            {
              c.phases.map((p, i) => (
                <li class="hw-rail__item" data-rail-item={i}>
                  <span class="hw-rail__tick"></span>
                  <span class="hw-rail__text">
                    <span class="hw-rail__when">{c.phaseWhen[i]}</span>
                    <span class="hw-rail__title">{p.title}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </aside>

        <div class="hw-phases">
          {
            c.phases.map((p, i) => (
              <article class="hw-phase" data-phase={i}>
                <figure class="hw-phase__figure">
                  <img
                    src={phaseImages[i]}
                    alt={c.phaseAlts[i]}
                    width="1536"
                    height="1024"
                    loading="lazy"
                  />
                </figure>
                <div class="hw-phase__copy">
                  <span class="hw-phase__when">{c.phaseWhen[i]}</span>
                  <h3 class="hw-phase__title">{p.title}</h3>
                  <p class="hw-phase__body">{p.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- --------------------------------------------- Shortlist or longlist -->
  <section class="section hw-options">
    <div class="container">
      <div class="section-header hw-reveal">
        <span class="eyebrow">{c.optionsEyebrow}</span>
        <h2 class="h2">{c.optionsTitle}</h2>
      </div>

      <div class="hw-switch hw-reveal" data-switch>
        <div class="hw-switch__control" role="tablist" aria-label={c.optionsEyebrow}>
          <span class="hw-switch__thumb" aria-hidden="true"></span>
          {
            c.options.map((o, i) => (
              <button
                type="button"
                role="tab"
                class="hw-switch__btn"
                id={`hw-tab-${i}`}
                aria-controls={`hw-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-switch-btn={i}
              >
                {o.label}
              </button>
            ))
          }
        </div>

        <div class="hw-switch__panels">
          {
            c.options.map((o, i) => (
              <div
                class="hw-panel"
                id={`hw-panel-${i}`}
                role="tabpanel"
                aria-labelledby={`hw-tab-${i}`}
                data-switch-panel={i}
                hidden={i !== 0}
              >
                <div class="hw-panel__dots" aria-hidden="true">
                  {Array.from({ length: optionDots[i] }).map((_, d) => (
                    <span class="hw-dot" style={`--hw-d: ${d * 26}ms`} />
                  ))}
                </div>
                <div class="hw-panel__copy">
                  <p class="hw-panel__tagline">{o.tagline}</p>
                  <p class="hw-panel__body">{o.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <p class="hw-note hw-reveal">{c.optionsNote}</p>
    </div>
  </section>

  <!-- ------------------------------------------------------- What you get -->
  <section class="section section--alt hw-deliver">
    <div class="container">
      <div class="section-header hw-reveal">
        <span class="eyebrow">{c.deliverablesEyebrow}</span>
        <h2 class="h2">{c.deliverablesTitle}</h2>
      </div>

      <div class="hw-deliver__grid">
        <figure class="hw-deliver__figure hw-reveal">
          <img
            src="/Images/compass/hiw-delivery.png"
            alt={c.figureAlt}
            loading="lazy"
            width="1536"
            height="1024"
          />
          <figcaption>{c.figureCaption}</figcaption>
        </figure>

        <div class="hw-deliver__list">
          {
            c.deliverables.map((d, i) => (
              <article class="hw-item hw-spot hw-reveal" style={`--hw-d: ${i * 90}ms`}>
                <h3 class="hw-item__title">{d.name}</h3>
                <p class="hw-item__body">{d.body}</p>
              </article>
            ))
          }
        </div>
      </div>

      <figure class="hw-intro hw-reveal">
        <img
          src="/Images/compass/hiw-intro.png"
          alt={c.introAlt}
          loading="lazy"
          width="1536"
          height="1024"
        />
      </figure>
    </div>
  </section>

  <!-- ------------------------------------------------------------- Limits -->
  <section class="section hw-limits">
    <div class="container">
      <div class="section-header hw-reveal">
        <span class="eyebrow">{c.limitsEyebrow}</span>
        <h2 class="h2">{c.limitsTitle}</h2>
      </div>
      <div class="hw-ledger">
        <div class="hw-ledger__col hw-ledger__col--can hw-reveal">
          <p>{c.limitsBody[0]}</p>
        </div>
        <div class="hw-ledger__col hw-ledger__col--cannot hw-reveal" style="--hw-d: 120ms">
          <p>{c.limitsBody[1]}</p>
        </div>
      </div>
      <p class="hw-ledger__note hw-reveal">{c.limitsBody[2]}</p>
    </div>
  </section>

  <!-- ------------------------------------------------------------ Pricing -->
  <section class="section section--dark hw-pricing">
    <div class="container hw-pricing__inner">
      <div class="hw-pricing__copy">
        <span class="eyebrow hw-reveal">{c.pricingEyebrow}</span>
        <h2 class="h2 hw-reveal" style="--hw-d: 80ms">{c.pricingTitle}</h2>
        <p class="hw-reveal" style="--hw-d: 140ms">{c.pricingBody[0]}</p>
        <p class="hw-reveal" style="--hw-d: 200ms">{c.pricingBody[1]}</p>
      </div>
      <aside class="hw-pledge hw-reveal" style="--hw-d: 160ms">
        <p class="hw-pledge__line">{facts.noCommission}</p>
        <p class="hw-pledge__body">{c.pricingCommissionTail}</p>
      </aside>
    </div>
  </section>

  <!-- ------------------------------------------------------------- Timing -->
  <section class="section hw-timing">
    <div class="container">
      <div class="section-header hw-reveal">
        <span class="eyebrow">{c.timingEyebrow}</span>
        <h2 class="h2">{c.timingTitle}</h2>
      </div>

      <div class="hw-moments">
        <span class="hw-moments__bar" aria-hidden="true"></span>
        {
          c.timing.map((t, i) => (
            <article class="hw-moment hw-spot hw-reveal" style={`--hw-d: ${i * 90}ms`}>
              <span class="hw-moment__pip" aria-hidden="true"></span>
              <h3 class="hw-moment__label">{t.label}</h3>
              <p class="hw-moment__body">{t.body}</p>
            </article>
          ))
        }
      </div>

      <div class="hw-next hw-reveal">
        <a href={shortlistHref} class="btn btn--primary">{c.nextCtaPrimary}</a>
        <a href={whatIsInsideHref} class="btn btn--ghost">{c.nextCtaSecondary}</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Reveal on scroll. Elements start hidden in CSS, so if the observer is
    //    unavailable everything is shown immediately rather than left blank.
    const revealables = document.querySelectorAll('.hw-reveal');
    if (!('IntersectionObserver' in window) || reduced) {
      revealables.forEach((el) => el.classList.add('is-in'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.15 },
      );
      revealables.forEach((el) => io.observe(el));
    }

    // 2. The route rail: fills as you scroll the process, and marks the phase
    //    currently under the reading line.
    const track = document.querySelector('[data-track]');
    const fill = document.querySelector('[data-track-fill]');
    const phases = document.querySelectorAll('[data-phase]');
    const railItems = document.querySelectorAll('[data-rail-item]');
    if (track && fill && phases.length) {
      let ticking = false;
      const update = function () {
        ticking = false;
        const rect = track.getBoundingClientRect();
        const anchor = window.innerHeight * 0.45;
        const p = Math.min(1, Math.max(0, (anchor - rect.top) / rect.height));
        fill.style.transform = 'scaleY(' + p + ')';

        let active = 0;
        phases.forEach(function (phase, i) {
          if (phase.getBoundingClientRect().top < anchor) active = i;
        });
        phases.forEach(function (phase, i) {
          phase.classList.toggle('is-active', i === active);
        });
        railItems.forEach(function (item, i) {
          item.classList.toggle('is-active', i === active);
          item.classList.toggle('is-done', i < active);
        });
      };
      if (reduced) {
        fill.style.transform = 'scaleY(1)';
        phases.forEach(function (p) {
          p.classList.add('is-active');
        });
        railItems.forEach(function (i) {
          i.classList.add('is-active');
        });
      } else {
        window.addEventListener(
          'scroll',
          function () {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true },
        );
        window.addEventListener('resize', update);
        update();
      }
    }

    // 3. Shortlist / longlist switch. Arrow keys move between tabs, matching
    //    the usual tablist behaviour.
    const sw = document.querySelector('[data-switch]');
    if (sw) {
      const btns = sw.querySelectorAll('[data-switch-btn]');
      const panels = sw.querySelectorAll('[data-switch-panel]');
      const thumb = sw.querySelector('.hw-switch__thumb');
      const select = function (index, focus) {
        btns.forEach(function (b, i) {
          const on = i === index;
          b.setAttribute('aria-selected', on ? 'true' : 'false');
          b.tabIndex = on ? 0 : -1;
          if (on && focus) b.focus();
        });
        panels.forEach(function (p, i) {
          p.hidden = i !== index;
          if (i === index) {
            // Restart the dot cascade each time a panel is shown.
            p.classList.remove('is-in');
            void p.offsetWidth;
            p.classList.add('is-in');
          }
        });
        if (thumb) {
          thumb.style.transform = 'translateX(' + index * 100 + '%)';
        }
      };
      btns.forEach(function (b, i) {
        b.addEventListener('click', function () {
          select(i, false);
        });
        b.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            select((i + 1) % btns.length, true);
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            select((i - 1 + btns.length) % btns.length, true);
          }
        });
      });
      select(0, false);
    }

    // 4. Cursor spotlight on the cards that carry one.
    const spots = document.querySelectorAll('.hw-spot');
    if (spots.length && window.matchMedia('(hover: hover)').matches) {
      spots.forEach(function (card) {
        card.addEventListener('mousemove', function (e) {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--hw-mx', e.clientX - rect.left + 'px');
          card.style.setProperty('--hw-my', e.clientY - rect.top + 'px');
        });
      });
    }

    // 5. Slow parallax on the hero photograph.
    const parallax = document.querySelector('[data-parallax]');
    if (parallax && !reduced) {
      let ticking = false;
      const update = function () {
        ticking = false;
        const y = Math.min(window.scrollY, window.innerHeight);
        parallax.style.transform = 'translateY(' + y * 0.06 + 'px)';
      };
      window.addEventListener(
        'scroll',
        function () {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
    }
  })();
</script>

<style>
  /* ---------------------------------------------------- Shared reveal ---- */
  .hw-reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 700ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--hw-d, 0ms),
      transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--hw-d, 0ms);
  }
  .hw-reveal.is-in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hw-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ------------------------------------------------------------- Hero ---- */
  .hw-hero {
    position: relative;
    overflow: hidden;
    padding-top: var(--space-9);
  }
  .hw-hero__glow,
  .hw-hero__lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hw-hero__glow {
    background:
      radial-gradient(50% 42% at 80% 14%, rgba(200, 16, 46, 0.2), transparent 70%),
      radial-gradient(38% 38% at 6% 88%, rgba(200, 16, 46, 0.1), transparent 70%);
  }
  .hw-hero__lines {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(72% 72% at 62% 42%, black 28%, transparent 100%);
    -webkit-mask-image: radial-gradient(72% 72% at 62% 42%, black 28%, transparent 100%);
  }
  .hw-hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--space-7);
    align-items: center;
  }
  .hw-hero .h1 {
    max-width: 17ch;
  }
  .hw-hero__lead {
    max-width: 54ch;
  }
  .hw-hero__body {
    max-width: 60ch;
    margin-top: var(--space-4);
    color: rgba(255, 255, 255, 0.68);
  }
  .hw-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .hw-hero__visual {
    position: relative;
  }
  .hw-hero__route {
    position: absolute;
    inset: -8% -6% auto auto;
    width: 78%;
    color: rgba(255, 255, 255, 0.34);
    pointer-events: none;
  }
  .hw-hero__figure {
    position: relative;
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 40px 80px -50px rgba(0, 0, 0, 0.9);
    will-change: transform;
  }
  .hw-hero__figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hw-hero__chip {
    position: absolute;
    left: var(--space-4);
    bottom: calc(var(--space-4) * -1);
    background: var(--bbg-white);
    color: var(--bbg-ink);
    font-size: var(--fs-small);
    font-weight: 600;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    box-shadow: 0 16px 30px -20px rgba(0, 0, 0, 0.6);
  }
  @media (max-width: 980px) {
    .hw-hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .hw-hero__route {
      display: none;
    }
  }

  /* --------------------------------------------------------- In short ---- */
  .hw-stations {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .hw-stations__line {
    position: absolute;
    top: 6px;
    left: 8%;
    right: 8%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--bbg-border) 12%,
      var(--bbg-border) 88%,
      transparent
    );
  }
  .hw-station {
    position: relative;
    padding-top: var(--space-5);
  }
  .hw-station__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--bbg-white);
    border: 3px solid #c8102e;
  }
  .hw-station__label {
    font-size: var(--fs-h4);
    font-weight: 600;
    color: var(--bbg-ink);
    margin-bottom: var(--space-3);
  }
  .hw-station__body {
    color: var(--bbg-text-muted);
    line-height: 1.7;
  }
  @media (max-width: 860px) {
    .hw-stations {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .hw-stations__line {
      top: 8px;
      bottom: 8px;
      left: 6px;
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(180deg, var(--bbg-border), transparent);
    }
    .hw-station {
      padding-top: 0;
      padding-left: var(--space-6);
    }
    .hw-station__dot {
      top: 4px;
    }
  }
  .hw-quote {
    margin-top: var(--space-7);
    padding-left: var(--space-5);
    border-left: 3px solid #c8102e;
    font-size: var(--fs-lead);
    font-weight: 500;
    color: var(--bbg-ink);
    max-width: 62ch;
  }

  /* ------------------------------------------------------- Engagement ---- */
  .hw-track {
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }
  .hw-rail {
    position: sticky;
    top: 8rem;
    display: grid;
    grid-template-columns: 2px 1fr;
    gap: var(--space-5);
  }
  .hw-rail__line {
    position: relative;
    background: var(--bbg-border);
    border-radius: 2px;
  }
  .hw-rail__fill {
    position: absolute;
    inset: 0;
    background: #c8102e;
    border-radius: 2px;
    transform: scaleY(0);
    transform-origin: top;
  }
  .hw-rail__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  .hw-rail__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    opacity: 0.42;
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }
  .hw-rail__item.is-active,
  .hw-rail__item.is-done {
    opacity: 1;
  }
  .hw-rail__item.is-active {
    transform: translateX(4px);
  }
  .hw-rail__tick {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bbg-border);
    flex: none;
    transition: background 300ms ease;
  }
  .hw-rail__item.is-active .hw-rail__tick,
  .hw-rail__item.is-done .hw-rail__tick {
    background: #c8102e;
  }
  .hw-rail__text {
    display: grid;
    gap: 2px;
  }
  .hw-rail__when {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bbg-text-muted);
  }
  .hw-rail__title {
    font-weight: 600;
    color: var(--bbg-ink);
  }

  .hw-phases {
    display: grid;
    gap: var(--space-8);
  }
  .hw-phase {
    display: grid;
    gap: var(--space-5);
    opacity: 0.55;
    transform: translateY(10px);
    transition:
      opacity 500ms ease,
      transform 500ms ease;
  }
