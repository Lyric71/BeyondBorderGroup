---
/**
 * WO-2.1 — the /compass pillar page, shared across every locale.
 *
 * Framing guardrail from the build spec: Compass is how the shortlist gets
 * built. It is never a product with access tiers. No plan names, no price, and
 * the main CTA is a brief or a call, never a login. The one exception is the
 * small account row in the hero: "Log in" for anyone with a Compass account
 * (staff, partners), and "Register your business" for distributors, which is
 * the only button the partner label introduces. It renders only when the
 * locale copy supplies it.
 *
 * Markup and styles live here once; each locale route supplies only the copy
 * object from src/content/pages/compass/<locale>.ts. The page stands alone:
 * the three former sub-pages are retired and 301 back here.
 *
 * Page flow, top to bottom:
 *   hero            shared CompassHero
 *   #problem        headline that inks in word by word, a wide photograph and
 *                   three short beats that overlap its lower edge
 *   #how            four expanding channel cards or, without channel copy,
 *                   the three-step timeline
 *   quote band      the pull quote over a full-bleed photograph, with the
 *                   door onto /how-we-work
 *   #difference     two-column duel board, scraped lists against Compass
 *   #coverage       partner types, an inspectable partner file, categories
 *   #brief          closing CTA
 *
 * Visual layer: scoped cx-* styles plus one inline script. Every effect sits
 * behind a prefers-reduced-motion guard, and everything that starts hidden is
 * gated on the cx-js class so the page reads fine with scripts off.
 */
import Layout from '../../../layouts/Layout.astro';
import CompassHero from './CompassHero.astro';
import { getLocaleFromUrl, localizePath, useTranslations } from '../../../i18n/utils';
import type { CompassCopy } from '../../../content/pages/compass/types';
import { APP_URL } from '../../../data/compass';

interface Props {
  copy: CompassCopy;
}

const { copy } = Astro.props;
const { facts, index: c } = copy;

const locale = getLocaleFromUrl(Astro.url);
const homeHref = localizePath('/', locale);
const shortlistHref = localizePath('/compass/shortlist', locale);
const toolsHref = localizePath('/tools', locale);
const distributionHref = localizePath('/enter-china/distribution', locale);
const howWeWorkHref = localizePath('/how-we-work', locale);
const t = useTranslations(locale);
// "Register your business" opens the public Chinese sign-up in the Compass app
// (/zh/become-partner, no login needed), which creates the account and drops
// the partner into the multi-step form at /zh/partner. Registration is for
// Chinese partners only, so every locale of this page links it. The app's
// login is linked at its real path (/en/login) so there is no redirect hop.
const partnersHref = `${APP_URL}/zh/become-partner`;
const loginHref = `${APP_URL}/en/login`;
const account = c.partnerAccess && {
  login: { prompt: c.partnerAccess.loginPrompt, label: c.partnerAccess.login, href: loginHref },
  register: {
    prompt: c.partnerAccess.registerPrompt,
    label: c.partnerAccess.register,
    href: partnersHref,
  },
};

// The ported strings stay verbatim; these splits only let the second sentence
// carry its own colour. Handles both western and CJK sentence breaks, and
// falls back to the whole string when a locale writes a single sentence.
const splitFirstSentence = (s: string): [string, string] => {
  const west = s.indexOf('. ');
  if (west !== -1) return [s.slice(0, west + 1), s.slice(west + 2)];
  const cjk = s.indexOf('。');
  if (cjk !== -1 && cjk < s.length - 1) return [s.slice(0, cjk + 1), s.slice(cjk + 1)];
  return [s, ''];
};
let [headlineA, headlineB] = splitFirstSentence(facts.headline);
if (!headlineB) {
  headlineB = headlineA;
  headlineA = '';
}
const [quoteA, quoteB] = splitFirstSentence(facts.steps.quote);

// Word lists for the two scroll-inked lines. The index runs across both halves
// so the second sentence keeps inking where the first one stopped.
const toWords = (s: string) => s.split(/\s+/).filter(Boolean);
const headA = toWords(headlineA);
const headB = toWords(headlineB);
const quoteWordsA = toWords(quoteA);
const quoteWordsB = toWords(quoteB);

const stepImages = [
  '/Images/compass/step-brief.png',
  '/Images/compass/step-shortlist.png',
  '/Images/compass/step-introductions.png',
];
const channelImages = [
  '/Images/compass/channel-store.webp',
  '/Images/compass/channel-social.webp',
  '/Images/compass/channel-online.webp',
  '/Images/compass/channel-offline.webp',
];

// Stroke icons, 24px grid. Matched to the copy by position, which every locale
// keeps in the same order. A list that outgrows its icons falls back to `dot`.
const dot = 'M12 9a3 3 0 100 6 3 3 0 000-6z';
const channelIcons = [
  'M4 9l1.5-5h13L20 9M4 9v11h16V9M4 9h16M9.5 20v-6h5v6',
  'M8 3h8a1 1 0 011 1v16a1 1 0 01-1 1H8a1 1 0 01-1-1V4a1 1 0 011-1zM10.5 9.5v5l4-2.5-4-2.5z',
  'M3 8l9-5 9 5v8l-9 5-9-5V8zM3 8l9 5 9-5M12 13v8',
  'M4 10h16l-1.5 9h-13L4 10zM8 10l3-6M16 10l-3-6M9 14v2M12 14v2M15 14v2',
];
const typeIcons = [
  'M2 7h11v9H2zM13 10h4l3 3v3h-7M6.5 19a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM16.5 19a1.5 1.5 0 100-3 1.5 1.5 0 000 3z',
  'M3 5h18v11H3zM9 20h6M12 16v4M8 9l3 2.5L8 14',
  'M4 15l1.5 4h13L20 15l-8-3-8 3zM7 13V8h10v5M12 4v4',
  'M4 4v16M20 4v16M4 9h16M4 15h16M7 6v3M10 6v3M14 12v3M17 12v3',
];
const categoryIcons = [
  'M12 3s6 6.5 6 11a6 6 0 01-12 0c0-4.5 6-11 6-11z',
  'M5 8h12v6a5 5 0 01-5 5h-2a5 5 0 01-5-5V8zM17 10h2a2 2 0 010 4h-2M9 3v2M13 3v2',
  'M8 4L3 7l2 4 2-1v10h10V10l2 1 2-4-5-3a4 4 0 01-8 0z',
  'M4 11l8-7 8 7M6 9.5V20h12V9.5M10 20v-6h4v6',
  'M5 19C5 10 10 5 19 5c0 9-5 14-14 14zM5 19l8-8',
  'M10 3h4v3h-4zM9 6h6l1 3v10a2 2 0 01-2 2h-4a2 2 0 01-2-2V9l1-3zM8 13h8',
  'M12 13c-3 0-5 2.2-5 4.2 0 1.6 1.3 2.3 2.6 2.3.9 0 1.6-.4 2.4-.4s1.5.4 2.4.4c1.3 0 2.6-.7 2.6-2.3 0-2-2-4.2-5-4.2zM6.5 11a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM10 8a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM14 8a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM17.5 11a1.5 1.5 0 100-3 1.5 1.5 0 000 3z',
  'M14 4a4.2 4.2 0 016 6L10 20a4.2 4.2 0 01-6-6L14 4zM9 9l6 6',
];
const beatIcons = [
  'M5 6h14M5 10h14M5 14h14M5 18h9',
  'M8 11a3 3 0 100-6 3 3 0 000 6zM16 11a3 3 0 100-6 3 3 0 000 6zM3 19c0-2.8 2.2-5 5-5s5 2.2 5 5M13.5 14.6A5 5 0 0121 19',
  'M12 21a9 9 0 100-18 9 9 0 000 18zM12 7v5l3 2',
];
// Short titled beats when the locale has them, else the long-form paragraphs.
const beats = c.problemBeats ?? facts.problemBody.map((body) => ({ title: '', body }));
const brandIcon = 'M4 8l8-4 8 4v8l-8 4-8-4V8zM4 8l8 4 8-4M12 12v8';

// Right-hand section rail. Labels are the section eyebrows, so every locale
// already has them.
const rail = [
  { id: 'problem', label: c.problemEyebrow },
  { id: 'how', label: c.channels ? c.channels.eyebrow : facts.steps.eyebrow },
  { id: 'difference', label: facts.comparison.eyebrow },
  { id: 'coverage', label: c.coverageEyebrow },
  { id: 'brief', label: c.closingEyebrow },
];
---

<Layout title={c.title} description={c.description}>
  <script is:inline>
    document.documentElement.classList.add('cx-js');
  </script>

  <!-- Hero, shared layout with the rest of the Find a partner section -->
  <CompassHero
    crumbs={[
      { label: c.crumbHome, href: homeHref },
      { label: c.crumbSection, href: `${homeHref}#services` },
    ]}
    eyebrow={c.eyebrow}
    rows={c.h1Rows}
    lead={c.lead}
    primary={{ label: c.ctaPrimary, href: shortlistHref }}
    secondary={{ label: c.ctaSecondary, href: '#how' }}
    stats={c.heroStats}
    account={account || undefined}
    image={{ src: '/Images/compass/compass-hero.png', alt: c.heroAlt }}
    scrollCue={c.scrollCue}
    scrollTarget="#problem"
  />

  <!-- Section rail, wide screens only -->
  <nav class="cx-rail" data-cx-rail aria-label={c.crumbSection}>
    {rail.map((item) => (
      <a href={`#${item.id}`} class="cx-rail__item" data-cx-rail-link={item.id}>
        <span class="cx-rail__label">{item.label}</span>
        <span class="cx-rail__dot" aria-hidden="true"></span>
      </a>
    ))}
  </nav>

  <!-- The problem -->
  <section class="section cx-problem" id="problem" data-cx-section="problem">
    <div class="container">
      <div class="cx-problem__head">
        <span class="eyebrow cx-reveal">{c.problemEyebrow}</span>
        <h2
          class="h2 cx-problem__headline"
          data-cx-scrub
          style={`--n: ${headA.length + headB.length}`}
        >
          {headA.length > 0 && (
            <span class="cx-problem__headline-a">
              {headA.map((w, i) => (
                <>
                  <span class="cx-w" style={`--i: ${i}`}>{w}</span>{' '}
                </>
              ))}
            </span>
          )}
          <span class="cx-problem__headline-b">
            {headB.map((w, i) => (
              <>
                <span class="cx-w" style={`--i: ${headA.length + i}`}>{w}</span>{' '}
              </>
            ))}
          </span>
        </h2>
      </div>

      <figure class="cx-problem__figure cx-reveal cx-reveal--zoom">
        <img
          src="/Images/compass/problem-pallets.png"
          alt={c.problemFigureAlt}
          width="1200"
          height="675"
          loading="lazy"
          data-cx-parallax="0.1"
        />
        <figcaption class="cx-problem__caption">
          <span class="cx-problem__caption-dot" aria-hidden="true"></span>
          {c.problemCaption}
        </figcaption>
      </figure>

      <div class="cx-beats">
        {beats.map((beat, i) => (
          <article class="cx-beat cx-spot cx-reveal" style={`--cx-d: ${120 + i * 110}ms`}>
            <span class="cx-beat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={beatIcons[i] || dot} />
              </svg>
            </span>
            {beat.title && <h3 class="cx-beat__title">{beat.title}</h3>}
            <p class="cx-beat__body">{beat.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Channel explorer when the copy has channels, else how it works in three steps */}
  {c.channels ? (
    <section class="section section--alt cx-how" id="how" data-cx-section="how">
      <div class="container">
        <div class="section-header cx-reveal">
          <span class="eyebrow">{c.channels.eyebrow}</span>
          <h2 class="h2">{c.channels.title}</h2>
        </div>

        <div class="cx-chs cx-reveal" data-cx-chs>
          {c.channels.items.map((ch, i) => (
            <article class:list={['cx-ch', i === 0 && 'is-active']} data-cx-ch>
              <img
                class="cx-ch__img"
                src={channelImages[i] || channelImages[0]}
                alt={ch.alt || ''}
                width="1536"
                height="1024"
                loading="lazy"
              />
              <div class="cx-ch__inner">
                <h3 class="cx-ch__heading">
                  <button
                    type="button"
                    class="cx-ch__toggle"
                    aria-expanded={i === 0 ? 'true' : 'false'}
                    aria-controls={`cx-ch-${i}`}
                  >
                    <span class="cx-ch__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d={channelIcons[i] || dot} />
                      </svg>
                    </span>
                    <span class="cx-ch__name">{ch.name}</span>
                  </button>
                </h3>
                <div class="cx-ch__content" id={`cx-ch-${i}`}>
                  <p class="cx-ch__text">{ch.body}</p>
                  <div class="cx-route">
                    <span class="cx-route__node cx-route__node--brand" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d={brandIcon} />
                      </svg>
                    </span>
                    <span class="cx-route__line" aria-hidden="true"></span>
                    <span class="cx-route__node cx-route__node--partner">
                      <span class="cx-route__label">{c.channels!.partnerLabel}</span> {ch.partner}
                    </span>
                    <span class="cx-route__line" aria-hidden="true"></span>
                    <span class="cx-route__node">{ch.where}</span>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="section section--alt cx-how" id="how" data-cx-section="how">
      <div class="container">
        <div class="section-header cx-reveal">
          <span class="eyebrow">{facts.steps.eyebrow}</span>
          <h2 class="h2">{facts.steps.title}</h2>
        </div>

        <div class="cx-timeline" data-cx-track>
          <div class="cx-timeline__rail" aria-hidden="true">
            <div class="cx-timeline__progress" data-cx-track-fill></div>
          </div>
          {facts.steps.items.map((step, i) => (
            <article class="cx-tl-row cx-reveal" data-cx-track-row>
              <span class="cx-tl-dot" aria-hidden="true"></span>
              <div class="cx-tl-media">
                <img src={stepImages[i]} alt={c.stepAlts[i]} width="1200" height="800" loading="lazy" />
              </div>
              <div class="cx-tl-copy">
                <h3 class="cx-tl-label">{step.label}</h3>
                <p class="cx-tl-body">{step.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Quote band: the pull quote over a photograph, and the way to /how-we-work -->
  <section class="cx-bearing">
    <div class="cx-bearing__bg" aria-hidden="true">
      <img src="/Images/compass/step-introductions.png" alt="" loading="lazy" data-cx-parallax="0.12" />
    </div>
    <div class="container cx-bearing__inner">
      <blockquote
        class="cx-bearing__quote"
        data-cx-scrub
        style={`--n: ${quoteWordsA.length + quoteWordsB.length}`}
      >
        {quoteWordsA.map((w, i) => (
          <>
            <span class="cx-w" style={`--i: ${i}`}>{w}</span>{' '}
          </>
        ))}
        {quoteWordsB.map((w, i) => (
          <>
            <span class="cx-w cx-w--accent" style={`--i: ${quoteWordsA.length + i}`}>{w}</span>{' '}
          </>
        ))}
      </blockquote>
      <a href={howWeWorkHref} class="btn btn--ghost-light cx-bearing__cta cx-reveal">
        {t('nav.work.howWeWork.label')}<span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- The duel board -->
  <section class="section cx-difference" id="difference" data-cx-section="difference">
    <div class="container">
      <div class="section-header cx-reveal">
        <span class="eyebrow">{facts.comparison.eyebrow}</span>
        <h2 class="h2">{facts.comparison.title}</h2>
      </div>

      <div class="cx-duel" data-cx-spot-host>
        <div class="cx-duel__bg cx-duel__bg--them" aria-hidden="true"></div>
        <div class="cx-duel__bg cx-duel__bg--us cx-spot" aria-hidden="true"></div>

        <div class="cx-duel__heads cx-reveal" aria-hidden="true">
          <div class="cx-duel__head cx-duel__head--them">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M5 6h14M5 10h14M5 14h14M5 18h9" />
            </svg>
            {facts.comparison.columnHeaders.scraped}
          </div>
          <div class="cx-duel__head cx-duel__head--us">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M15.5 8.500l-2 5-5 2 2-5 5-2z" />
            </svg>
            {facts.comparison.columnHeaders.ours}
          </div>
        </div>

        {facts.comparison.rows.map((row, i) => (
          <div class="cx-duel__row cx-reveal" style={`--cx-d: ${i * 90}ms`}>
            <h3 class="cx-duel__label"><span>{row.label}</span></h3>
            <div class="cx-duel__cell cx-duel__cell--them" data-col={facts.comparison.columnHeaders.scraped}>
              <svg class="cx-duel__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
              </svg>
              <p>
                <span class="sr-only">{facts.comparison.columnHeaders.scraped}: </span>
                {row.scraped}
              </p>
            </div>
            <div class="cx-duel__cell cx-duel__cell--us" data-col={facts.comparison.columnHeaders.ours}>
              <svg class="cx-duel__icon cx-duel__icon--check" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8.500l3.2 3L13 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" pathLength="1" />
              </svg>
              <p>
                <span class="sr-only">{facts.comparison.columnHeaders.ours}: </span>
                {row.ours}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Coverage -->
  <section class="section section--alt cx-coverage" id="coverage" data-cx-section="coverage">
    <div class="container">
      <div class="cx-coverage__top">
        <div class="cx-coverage__intro">
          <div class="section-header cx-reveal">
            <span class="eyebrow">{c.coverageEyebrow}</span>
            <h2 class="h2">{c.coverageTitle}</h2>
            <p class="lead">{c.coverageLead}</p>
          </div>

          <p class="cx-coverage__sublabel cx-reveal">{c.whoLabel}</p>
          <div class="cx-types">
            {facts.partnerTypes.map((t, i) => (
              <article class="cx-type cx-spot cx-reveal" style={`--cx-d: ${i * 80}ms`}>
                <span class="cx-type__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d={typeIcons[i] || dot} />
                  </svg>
                </span>
                <h3 class="cx-type__name">{t.name}</h3>
                <p class="cx-type__body">{t.body}</p>
              </article>
            ))}
          </div>
        </div>

        <!-- The partner file: what gets recorded, one field at a time -->
        <div class="cx-file-wrap cx-reveal cx-reveal--right" style="--cx-d: 160ms">
          <div class="cx-file" data-cx-tilt data-cx-file>
            <div class="cx-file__scan" aria-hidden="true"></div>
            <div class="cx-file__head">
              <span class="cx-file__logo" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M15.5 8.500l-2 5-5 2 2-5 5-2z" />
                </svg>
              </span>
              <span class="cx-file__brand">{facts.comparison.columnHeaders.ours}</span>
              <span class="cx-file__redact" aria-hidden="true"><i></i><i></i></span>
            </div>
            <ul class="cx-file__fields">
              {facts.profileFields.map((field, i) => (
                <li>
                  <button
                    type="button"
                    class:list={['cx-file__field', i === 0 && 'is-active']}
                    data-cx-field={i}
                    aria-controls="cx-file-detail"
                    aria-pressed={i === 0 ? 'true' : 'false'}
                  >
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 8.500l3.2 3L13 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    {field.name}
                  </button>
                </li>
              ))}
            </ul>
            <div class="cx-file__detail" id="cx-file-detail" aria-live="polite">
              {facts.profileFields.map((field, i) => (
                <p class:list={['cx-file__note', i === 0 && 'is-active']} data-cx-note={i}>
                  {field.body}
                </p>
              ))}
            </div>
          </div>
        </div>
      </div>

      <p class="cx-coverage__sublabel cx-reveal">{c.categoriesLabel}</p>
      <ul class="cx-cats">
        {facts.categories.map((cat, i) => (
          <li class="cx-cat cx-reveal cx-reveal--zoom" style={`--cx-d: ${i * 55}ms`}>
            <span class="cx-cat__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={categoryIcons[i] || dot} />
              </svg>
            </span>
            <span class="cx-cat__name">{cat}</span>
          </li>
        ))}
      </ul>
      <p class="cx-coverage__closing cx-reveal">{facts.categoriesClosing}</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark cx-cta" id="brief" data-cx-section="brief" data-cx-glow>
    <div class="cx-cta__glow" aria-hidden="true"></div>
    <div class="container cx-cta__inner">
      <div class="cx-cta__copy">
      <span class="eyebrow cx-reveal">{c.closingEyebrow}</span>
      <h2 class="h2 cx-reveal" style="--cx-d: 80ms">{c.closingTitle}</h2>
      <p class="cx-cta__lead cx-reveal" style="--cx-d: 160ms">{c.closingLead}</p>
      {
        c.toolsLine && (
          <p class="cx-cta__tools cx-reveal" style="--cx-d: 200ms">
            {c.toolsLine.before}
            <a href={toolsHref}>{c.toolsLine.link}</a>
            {c.toolsLine.after}
          </p>
        )
      }
      <p class="cx-cta__stamp cx-reveal" style="--cx-d: 320ms">{facts.noCommission}</p>
      <div class="cx-cta__actions cx-reveal" style="--cx-d: 400ms">
        <a href={shortlistHref} class="btn btn--primary" data-cx-magnet>{c.closingCtaPrimary}</a>
        <a href={distributionHref} class="btn btn--ghost">{c.closingCtaSecondary}</a>
      </div>
      </div>
      <figure class="cx-cta__media cx-reveal cx-reveal--right" style="--cx-d: 200ms">
        <img src="/Images/compass/step-shortlist.png" alt={c.stepAlts[1]} width="1200" height="800" loading="lazy" />
      </figure>
    </div>
  </section>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v));
      const $$ = (sel, root) => Array.from((root || document).querySelectorAll(sel));

      // 1. Reveal on scroll
      const revealEls = $$('.cx-reveal');
      if (reduced || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              el.classList.add('is-in');
              io.unobserve(el);
              // Once the entrance is over, drop the stagger delay so hover
              // effects on the same element answer straight away.
              setTimeout(() => el.style.setProperty('--cx-d', '0ms'), 1400);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // 2. Everything that follows the scroll position, in one rAF pass:
      //    inked lines, the timeline track, photo parallax.
      const scrubs = $$('[data-cx-scrub]');
      const tracks = $$('[data-cx-track]').map((el) => ({
        el,
        fill: el.querySelector('[data-cx-track-fill]'),
        rows: $$('[data-cx-track-row]', el),
      }));
      const parallax = $$('[data-cx-parallax]');

      const update = () => {
        const vh = window.innerHeight;
        scrubs.forEach((el) => {
          const top = el.getBoundingClientRect().top;
          el.style.setProperty('--cx-p', clamp((vh * 0.88 - top) / (vh * 0.5), 0, 1).toFixed(3));
        });
        tracks.forEach(({ el, fill, rows }) => {
          const rect = el.getBoundingClientRect();
          const anchor = vh * 0.68;
          if (fill) fill.style.transform = 'scaleY(' + clamp((anchor - rect.top) / rect.height, 0, 1) + ')';
          rows.forEach((row) => row.classList.toggle('is-active', row.getBoundingClientRect().top < anchor));
        });
        parallax.forEach((el) => {
          const rect = el.getBoundingClientRect();
          const factor = parseFloat(el.dataset.cxParallax || '0.08');
          // Never travel further than the slack the 1.14 scale leaves around the photo.
          const slack = rect.height * 0.06;
          const y = clamp((rect.top + rect.height / 2 - vh / 2) * -factor, -slack, slack);
          el.style.setProperty('--cx-py', y.toFixed(1) + 'px');
        });
      };

      if (reduced) {
        tracks.forEach(({ fill, rows }) => {
          if (fill) fill.style.transform = 'scaleY(1)';
          rows.forEach((row) => row.classList.add('is-active'));
        });
      } else if (scrubs.length || tracks.length || parallax.length) {
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            update();
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        update();
      }

      // 3. Channel cards: one open at a time. Click, focus or (with a mouse)
      //    hover opens a card and folds the others.
      $$('[data-cx-chs]').forEach((group) => {
        const cards = $$('[data-cx-ch]', group);
        const open = (card) => {
          cards.forEach((c) => {
            const on = c === card;
            c.classList.toggle('is-active', on);
            const btn = c.querySelector('.cx-ch__toggle');
            if (btn) btn.setAttribute('aria-expanded', on ? 'true' : 'false');
          });
        };
        cards.forEach((card) => {
          const btn = card.querySelector('.cx-ch__toggle');
          if (btn) {
            btn.addEventListener('click', () => open(card));
            btn.addEventListener('focus', () => open(card));
          }
          if (canHover) card.addEventListener('mouseenter', () => open(card));
        });
      });

      // 4. Partner file: hover, focus or tap a field to read what it records
      $$('[data-cx-file]').forEach((file) => {
        const fields = $$('[data-cx-field]', file);
        const notes = $$('[data-cx-note]', file);
        const show = (i) => {
          fields.forEach((f, j) => {
            f.classList.toggle('is-active', j === i);
            f.setAttribute('aria-pressed', j === i ? 'true' : 'false');
          });
          notes.forEach((n, j) => n.classList.toggle('is-active', j === i));
        };
        fields.forEach((field, i) => {
          field.addEventListener('click', () => show(i));
          field.addEventListener('focus', () => show(i));
          if (canHover) field.addEventListener('mouseenter', () => show(i));
        });
      });

      if (canHover && !reduced) {
        // 5. Cursor spotlight. A spot inside a host reads the host's pointer,
        //    so a backdrop that ignores the mouse can still light up.
        $$('.cx-spot').forEach((el) => {
          const host = el.closest('[data-cx-spot-host]') || el;
          host.addEventListener('mousemove', (e) => {
            const rect = el.getBoundingClientRect();
            el.style.setProperty('--cx-mx', e.clientX - rect.left + 'px');
            el.style.setProperty('--cx-my', e.clientY - rect.top + 'px');
          });
        });

        // 6. Tilt on the partner file
        $$('[data-cx-tilt]').forEach((el) => {
          el.addEventListener('mousemove', (e) => {
            const rect = el.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width - 0.5;
            const y = (e.clientY - rect.top) / rect.height - 0.5;
            el.style.setProperty('--cx-ry', (x * 7).toFixed(2) + 'deg');
            el.style.setProperty('--cx-rx', (y * -7).toFixed(2) + 'deg');
          });
          el.addEventListener('mouseleave', () => {
            el.style.setProperty('--cx-ry', '0deg');
            el.style.setProperty('--cx-rx', '0deg');
          });
        });

        // 7. Magnetic primary button and pointer glow in the closing section
        $$('[data-cx-magnet]').forEach((btn) => {
          const zone = btn.parentElement || btn;
          zone.addEventListener('mousemove', (e) => {
            const rect = btn.getBoundingClientRect();
            const dx = e.clientX - (rect.left + rect.width / 2);
            const dy = e.clientY - (rect.top + rect.height / 2);
            btn.style.translate = clamp(dx * 0.12, -8, 8) + 'px ' + clamp(dy * 0.2, -6, 6) + 'px';
          });
          zone.addEventListener('mouseleave', () => {
            btn.style.translate = '0 0';
          });
        });
        $$('[data-cx-glow]').forEach((el) => {
          el.addEventListener('mousemove', (e) => {
            const rect = el.getBoundingClientRect();
            el.style.setProperty('--cx-gx', e.clientX - rect.left + 'px');
            el.style.setProperty('--cx-gy', e.clientY - rect.top + 'px');
          });
        });
      }

      // 8. Section rail: shows once the hero is gone, tracks the live section
      const railEl = document.querySelector('[data-cx-rail]');
      if (railEl && 'IntersectionObserver' in window) {
        const links = $$('[data-cx-rail-link]', railEl);
        const hero = document.querySelector('[data-cph-hero]');
        if (hero) {
          new IntersectionObserver(
            ([entry]) => railEl.classList.toggle('is-visible', !entry.isIntersecting),
            { threshold: 0.15 },
          ).observe(hero);
        } else {
          railEl.classList.add('is-visible');
        }
        const spy = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const id = entry.target.getAttribute('data-cx-section');
              links.forEach((link) => {
                const on = link.getAttribute('data-cx-rail-link') === id;
                link.classList.toggle('is-active', on);
                if (on) link.setAttribute('aria-current', 'true');
                else link.removeAttribute('aria-current');
              });
            });
          },
          { rootMargin: '-45% 0px -50% 0px' },
        );
        $$('[data-cx-section]').forEach((section) => spy.observe(section));
      }
    })();
  </script>
</Layout>

<style>
  /* ---------- Shared reveal ----------
     Hidden states only apply once the inline script has tagged <html>, so the
     page stays readable with scripts off. --cx-t lets a component add its own
     hover transitions without clobbering the entrance ones. */
  :global(.cx-js) .cx-reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 700ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--cx-d, 0ms),
      transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--cx-d, 0ms),
      var(--cx-t, visibility 0s);
  }
  :global(.cx-js) .cx-reveal--zoom {
    transform: scale(0.92);
  }
  :global(.cx-js) .cx-reveal--right {
    transform: translateX(40px);
  }
  :global(.cx-js) .cx-reveal.is-in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cx-js) .cx-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Sections jumped to from the rail or the hero clear the sticky nav. */
  [data-cx-section] {
    scroll-margin-top: 72px;
  }

  /* Words that ink in as the line scrolls up the viewport. --cx-p is written
     by the script (0 to 1); with no script it stays at 1 and the line is
     simply printed. */
  .cx-w {
    opacity: clamp(0.14, calc(var(--cx-p, 1) * (var(--n, 1) + 3) - var(--i, 0)), 1);
    transition: opacity 260ms linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .cx-w {
      opacity: 1;
      transition: none;
    }
  }

  /* ---------- Section rail ---------- */
  .cx-rail {
    position: fixed;
    top: 50%;
    right: 18px;
    z-index: 40;
    display: none;
    flex-direction: column;
    gap: 2px;
    padding: 10px 8px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    box-shadow: 0 10px 30px -12px rgba(20, 24, 40, 0.35);
    opacity: 0;
    transform: translate(16px, -50%);
    pointer-events: none;
    transition:
      opacity 300ms var(--ease),
      transform 300ms var(--ease);
  }
  .cx-rail.is-visible {
    opacity: 1;
    transform: translate(0, -50%);
    pointer-events: auto;
  }
  @media (min-width: 1360px) {
    .cx-rail {
      display: flex;
    }
  }
  .cx-rail__item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 20px;
    height: 24px;
    text-decoration: none;
  }
  .cx-rail__dot {
    width: 8px;
    height: 8px;
    margin: 0 6px;
    border-radius: 999px;
    background: rgba(26, 26, 26, 0.28);
    transition:
      height 250ms var(--ease),
      background 250ms var(--ease);
  }
  .cx-rail__item:hover .cx-rail__dot {
    background: var(--bbg-ink);
  }
  .cx-rail__item.is-active .cx-rail__dot {
    height: 20px;
    background: var(--bbg-blue);
  }
  .cx-rail__label {
    position: absolute;
    right: 34px;
    top: 50%;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--bbg-ink);
    color: var(--bbg-white);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0;
    transform: translate(8px, -50%);
    pointer-events: none;
    transition:
      opacity 200ms var(--ease),
      transform 200ms var(--ease);
  }
  .cx-rail__item:hover .cx-rail__label,
  .cx-rail__item:focus-visible .cx-rail__label {
    opacity: 1;
    transform: translate(0, -50%);
  }
  .cx-rail__item:focus-visible {
    outline: 3px solid var(--bbg-blue);
    outline-offset: 2px;
    border-radius: 999px;
  }
  @media (prefers-reduced-motion: reduce) {
    .cx-rail,
    .cx-rail__dot,
    .cx-rail__label {
      transition: none;
    }
  }

  /* ---------- Problem ---------- */
  .cx-problem {
    background:
      radial-gradient(60% 50% at 0% 0%, rgba(200, 16, 46, 0.05), transparent 70%),
      var(--bbg-white);
  }
  .cx-problem__head {
    margin-bottom: var(--space-6);
  }
  .cx-problem__headline {
    max-width: 24ch;
    margin: 0;
    font-size: clamp(2rem, 3vw + 1rem, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .cx-problem__headline-a {
    display: block;
    color: var(--bbg-text-muted);
    font-weight: 600;
  }
  .cx-problem__headline-b {
    display: block;
    color: var(--bbg-ink);
  }
  .cx-problem__figure {
    position: relative;
    margin: 0;
    aspect-ratio: 21 / 9;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 40px 80px -40px rgba(20, 24, 40, 0.55);
  }
  .cx-problem__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 14, 22, 0) 40%, rgba(6, 14, 22, 0.55));
    pointer-events: none;
  }
  .cx-problem__figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate3d(0, var(--cx-py, 0px), 0) scale(1.16);
  }
  .cx-problem__caption {
    position: absolute;
    z-index: 1;
    top: var(--space-5);
    left: var(--space-5);
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.5rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(6, 14, 22, 0.62);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--bbg-white);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .cx-problem__caption-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bbg-blue);
    box-shadow: 0 0 0 0 rgba(200, 16, 46, 0.6);
    animation: cx-pulse 2.4s ease-out infinite;
  }
  @keyframes cx-pulse {
    to {
      box-shadow: 0 0 0 10px rgba(200, 16, 46, 0);
    }
  }
  /* Three beats, pulled up over the lower edge of the photograph. */
  .cx-beats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin: calc(var(--space-8) * -1) var(--space-6) 0;
  }
  .cx-beat {
    --cx-t: translate 300ms var(--ease), box-shadow 300ms var(--ease);
    padding: var(--space-5);
    border: 1px solid var(--bbg-border);
    border-radius: 20px;
    background: var(--bbg-white);
    box-shadow: 0 24px 48px -28px rgba(20, 24, 40, 0.4);
    overflow: hidden;
  }
  .cx-beat::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--bbg-blue), #e84a60);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease);
  }
  .cx-beat:hover {
    translate: 0 -6px;
    box-shadow: 0 36px 60px -30px rgba(200, 16, 46, 0.45);
  }
  .cx-beat:hover::before {
    transform: scaleX(1);
  }
  .cx-beat__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--space-4);
    border-radius: 12px;
    background: var(--bbg-blue-light);
    color: var(--bbg-blue);
  }
  .cx-beat__icon svg {
    width: 22px;
    height: 22px;
  }
  .cx-beat__title {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-h4);
    font-weight: 600;
    line-height: 1.25;
    color: var(--bbg-ink);
    text-wrap: balance;
  }
  .cx-beat__body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--bbg-text);
  }
  @media (prefers-reduced-motion: reduce) {
    .cx-problem__caption-dot {
      animation: none;
    }
    .cx-problem__figure img {
      transform: scale(1.02);
    }
    .cx-beat::before {
      transition: none;
    }
  }
  @media (max-width: 900px) {
    .cx-problem__figure {
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-lg);
    }
    .cx-beats {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      margin: calc(var(--space-6) * -1) var(--space-4) 0;
    }
  }

  /* ---------- Channel cards ----------
     Four photographs side by side. The open one takes the width and shows its
     copy; the rest fold down to a sliver with an icon and a name. */
  .cx-how .section-header {
    margin-bottom: calc(var(--space-5) + var(--space-3));
  }
  .cx-chs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .cx-ch {
    position: relative;
    display: flex;
    min-height: 420px;
    border-radius: 24px;
    overflow: hidden;
    background: #0b131c;
    color: var(--bbg-white);
    isolation: isolate;
  }
  .cx-ch__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 600ms var(--ease);
  }
  .cx-ch::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(6, 14, 22, 0) 0%, rgba(6, 14, 22, 0.3) 40%, rgba(6, 14, 22, 0.92) 100%);
    transition: opacity 500ms var(--ease);
  }
  .cx-ch__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    padding: var(--space-5);
  }
  .cx-ch__heading {
    margin: 0;
    font-size: inherit;
    color: inherit;
  }
  .cx-ch__toggle {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: var(--bbg-white);
    cursor: pointer;
  }
  /* The whole card is the hit area. */
  .cx-ch__toggle::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .cx-ch__toggle:focus-visible {
    outline: none;
  }
  .cx-ch:has(.cx-ch__toggle:focus-visible) {
    outline: 3px solid var(--bbg-blue);
    outline-offset: 3px;
  }
  .cx-ch__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition:
      background 300ms var(--ease),
      border-color 300ms var(--ease);
  }
  .cx-ch__icon svg {
    width: 22px;
    height: 22px;
  }
  .cx-ch__name {
    font-size: clamp(1.25rem, 1vw + 1rem, 1.625rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .cx-ch__content {
    position: relative;
    margin-top: var(--space-4);
  }
  .cx-ch__text {
    margin: 0;
    max-width: 56ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
  }

  /* Scripts on: fold the cards into one row. */
  :global(.cx-js) .cx-chs {
    display: flex;
    height: 520px;
  }
  :global(.cx-js) .cx-ch {
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    transition: flex-grow 650ms cubic-bezier(0.3, 0.9, 0.3, 1);
  }
  :global(.cx-js) .cx-ch.is-active {
    flex-grow: 5;
  }
  :global(.cx-js) .cx-ch:not(.is-active) .cx-ch__img {
    filter: grayscale(1) brightness(0.8);
    transform: scale(1.08);
  }
  :global(.cx-js) .cx-ch:not(.is-active):hover .cx-ch__img {
    filter: grayscale(0.4) brightness(0.85);
  }
  :global(.cx-js) .cx-ch:not(.is-active) .cx-ch__toggle {
    flex-direction: column;
    align-items: flex-start;
  }
  :global(.cx-js) .cx-ch:not(.is-active) .cx-ch__name {
    font-size: 1.0625rem;
  }
  :global(.cx-js) .cx-ch.is-active .cx-ch__icon {
    border-color: var(--bbg-blue);
    background: var(--bbg-blue);
  }
  :global(.cx-js) .cx-ch:not(.is-active) .cx-ch__content {
    display: none;
  }
  /* Fixed measure so the copy does not reflow while the card is still
     growing; it fades in once there is room for it. */
  :global(.cx-js) .cx-ch.is-active .cx-ch__content {
    width: min(620px, calc(100vw - 2 * var(--container-pad, 24px) - 3rem));
    animation: cx-ch-in 600ms var(--ease) 250ms both;
  }
  @keyframes cx-ch-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* Brand, then partner, then where the shopper finds you. */
  .cx-route {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .cx-route__node {
    flex: none;
    max-width: 46%;
    padding: 0.45rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.35;
    color: var(--bbg-white);
  }
  .cx-route__node--brand {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
  }
  .cx-route__node--brand svg {
    width: 20px;
    height: 20px;
  }
  .cx-route__node--partner {
    border-color: rgba(255, 90, 112, 0.7);
    background: rgba(200, 16, 46, 0.55);
  }
  .cx-route__label {
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
  }
  .cx-route__line {
    position: relative;
    flex: 1 1 24px;
    min-width: 24px;
    height: 2px;
    background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.35) 0 6px, transparent 6px 12px);
    overflow: hidden;
  }
  .cx-route__line::after {
    content: '';
    position: absolute;
    top: 0;
    left: -24px;
    width: 24px;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ff5a70);
    animation: cx-flow 2.2s linear infinite;
  }
  .cx-route__line + .cx-route__node + .cx-route__line::after {
    animation-delay: 1.1s;
  }
  @keyframes cx-flow {
    to {
      left: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cx-js) .cx-ch,
    .cx-ch__img {
      transition: none;
    }
    :global(.cx-js) .cx-ch.is-active .cx-ch__content {
      animation: none;
    }
    .cx-route__line::after {
      animation: none;
      display: none;
    }
  }
  @media (max-width: 900px) {
    .cx-chs {
      grid-template-columns: 1fr;
    }
    :global(.cx-js) .cx-chs {
      flex-direction: column;
      height: auto;
    }
    :global(.cx-js) .cx-ch {
      flex: none;
      min-height: 84px;
      border-radius: var(--radius-lg);
    }
    :global(.cx-js) .cx-ch.is-active {
      min-height: 440px;
    }
    :global(.cx-js) .cx-ch:not(.is-active) .cx-ch__toggle {
      flex-direction: row;
      align-items: center;
    }
    :global(.cx-js) .cx-ch:not(.is-active) .cx-ch__inner {
      justify-content: center;
    }
    :global(.cx-js) .cx-ch.is-active .cx-ch__content {
      width: auto;
    }
  }
  @media (max-width: 640px) {
    .cx-route {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }
    .cx-route__node {
      max-width: 100%;
    }
    .cx-route__line {
      flex: none;
      width: 2px;
      min-width: 0;
      height: 18px;
      margin-left: 19px;
      background: repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.35) 0 5px, transparent 5px 9px);
    }
    .cx-route__line::after {
      display: none;
    }
  }

  /* ---------- Timeline (locales without channel copy) ---------- */
  .cx-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-4) 0;
  }
  .cx-timeline__rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: var(--bbg-border);
    border-radius: 1px;
    overflow: hidden;
  }
  .cx-timeline__progress {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, var(--bbg-blue), #e84a60);
    transform: scaleY(0);
    transform-origin: top;
  }
  .cx-tl-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 96px minmax(0, 1fr);
    align-items: center;
  }
  .cx-tl-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--bbg-surface);
    border: 2px solid var(--bbg-border);
    transition:
      border-color 300ms var(--ease),
      background 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }
  .cx-tl-row.is-active .cx-tl-dot {
    border-color: var(--bbg-blue);
    background: var(--bbg-blue);
    box-shadow: 0 0 0 6px rgba(200, 16, 46, 0.14);
  }
  .cx-tl-media {
    grid-column: 1;
    grid-row: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 48px -28px rgba(20, 24, 40, 0.45);
    transition:
      translate 400ms var(--ease),
      box-shadow 400ms var(--ease);
  }
  .cx-tl-media img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 600ms var(--ease);
  }
  .cx-tl-row:hover .cx-tl-media {
    translate: 0 -4px;
    box-shadow: 0 32px 56px -28px rgba(20, 24, 40, 0.55);
  }
  .cx-tl-row:hover .cx-tl-media img {
    transform: scale(1.03);
  }
  .cx-tl-copy {
    grid-column: 3;
    grid-row: 1;
    padding: var(--space-5);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-lg);
    background: var(--bbg-white);
    box-shadow: 0 20px 40px -32px rgba(20, 24, 40, 0.4);
  }
  .cx-tl-row:nth-child(odd of .cx-tl-row) .cx-tl-media {
    grid-column: 3;
  }
  .cx-tl-row:nth-child(odd of .cx-tl-row) .cx-tl-copy {
    grid-column: 1;
  }
  .cx-tl-label {
    display: inline-block;
    font-size: var(--fs-h4);
    font-weight: 600;
    color: var(--bbg-ink);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--bbg-blue);
  }
  .cx-tl-body {
    margin: 0;
    line-height: 1.65;
  }
  @media (max-width: 900px) {
    .cx-timeline {
      gap: var(--space-6);
    }
    .cx-timeline__rail {
      left: 6px;
      transform: none;
    }
    .cx-tl-row {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      padding-left: var(--space-6);
    }
    .cx-tl-dot {
      left: 7px;
      top: 10px;
      transform: translate(-50%, 0);
    }
  }

  /* ---------- Quote band ---------- */
  .cx-bearing {
    position: relative;
    padding: clamp(var(--space-8), 13vw, 11rem) 0;
    background: #060e16;
    color: var(--bbg-white);
    overflow: hidden;
    isolation: isolate;
  }
  .cx-bearing__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .cx-bearing__bg img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    transform: translate3d(0, var(--cx-py, 0px), 0) scale(1.16);
    filter: saturate(0.85);
  }
  .cx-bearing__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgba(6, 14, 22, 0.94) 0%, rgba(6, 14, 22, 0.8) 45%, rgba(6, 14, 22, 0.45) 100%),
      radial-gradient(80% 90% at 0% 100%, rgba(200, 16, 46, 0.35), transparent 60%);
  }
  .cx-bearing__quote {
    margin: 0;
    padding: 0;
    border: 0;
    max-width: 20ch;
    font-size: clamp(1.875rem, 3.4vw + 0.75rem, 3.5rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--bbg-white);
    text-wrap: balance;
  }
  .cx-w--accent {
    color: #ff5a70;
  }
  .cx-bearing__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin-top: var(--space-6);
  }
  .cx-bearing__cta span {
    transition: transform 200ms var(--ease);
  }
  .cx-bearing__cta:hover span {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .cx-bearing__bg img {
      transform: scale(1.02);
    }
    .cx-bearing__cta span {
      transition: none;
    }
  }

  /* ---------- Duel board ---------- */
  .cx-duel {
    --cx-duel-gap: var(--space-5);
    position: relative;
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-5);
  }
  .cx-duel__bg {
    position: absolute;
    top: 0;
    bottom: 0;
    width: calc(50% - var(--cx-duel-gap) / 2);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .cx-duel__bg--them {
    left: 0;
    border: 1px solid var(--bbg-border);
    background: var(--bbg-surface);
  }
  .cx-duel__bg--us {
    right: 0;
    border: 1px solid rgba(200, 16, 46, 0.28);
    border-top: 3px solid var(--bbg-blue);
    background: var(--bbg-white);
    box-shadow:
      0 40px 80px -40px rgba(200, 16, 46, 0.45),
      0 12px 28px -18px rgba(20, 24, 40, 0.25);
  }
  .cx-duel__heads,
  .cx-duel__row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--cx-duel-gap);
  }
  .cx-duel__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6) var(--space-2);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cx-duel__head svg {
    width: 22px;
    height: 22px;
  }
  .cx-duel__head--them {
    color: var(--bbg-text-muted);
  }
  .cx-duel__head--us {
    color: var(--bbg-blue);
  }
  .cx-duel__label {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: var(--space-4) 0 0;
    font-size: var(--fs-small);
    font-weight: 600;
    text-align: center;
  }
  .cx-duel__label span {
    position: relative;
    z-index: 1;
    padding: 0.4rem 1rem;
    border: 1px solid var(--bbg-border);
    border-radius: 999px;
    background: var(--bbg-white);
    color: var(--bbg-ink);
    box-shadow: 0 6px 16px -10px rgba(20, 24, 40, 0.4);
    transition:
      border-color 250ms var(--ease),
      color 250ms var(--ease);
  }
  .cx-duel__row:hover .cx-duel__label span {
    border-color: var(--bbg-blue);
    color: var(--bbg-blue-dark);
  }
  .cx-duel__cell {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4) var(--space-6);
    line-height: 1.55;
  }
  .cx-duel__cell p {
    margin: 0;
  }
  .cx-duel__cell--them {
    color: var(--bbg-text-muted);
  }
  .cx-duel__cell--us {
    color: var(--bbg-ink);
    font-size: 1.125rem;
    font-weight: 600;
    transition: translate 300ms var(--ease);
  }
  .cx-duel__row:hover .cx-duel__cell--us {
    translate: 6px 0;
  }
  .cx-duel__icon {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 0.15em;
    padding: 4px;
    border-radius: 50%;
  }
  .cx-duel__cell--them .cx-duel__icon {
    background: rgba(26, 26, 26, 0.07);
    color: var(--bbg-text-muted);
  }
  .cx-duel__cell--us .cx-duel__icon {
    background: var(--bbg-blue);
    color: var(--bbg-white);
  }
  :global(.cx-js) .cx-duel__icon--check path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 600ms var(--ease) calc(var(--cx-d, 0ms) + 350ms);
  }
  :global(.cx-js) .cx-duel__row.is-in .cx-duel__icon--check path {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cx-js) .cx-duel__icon--check path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
  @media (max-width: 760px) {
    .cx-duel {
      gap: var(--space-5);
      padding-bottom: 0;
    }
    .cx-duel__bg,
    .cx-duel__heads {
      display: none;
    }
    .cx-duel__row {
      grid-template-columns: 1fr;
      row-gap: var(--space-3);
    }
    .cx-duel__label {
      justify-content: flex-start;
      margin: 0;
    }
    .cx-duel__label span {
      padding: 0;
      border: 0;
      background: none;
      box-shadow: none;
      font-size: var(--fs-body);
    }
    .cx-duel__cell {
      flex-wrap: wrap;
      padding: var(--space-4);
      border-radius: var(--radius-md);
    }
    .cx-duel__cell::before {
      content: attr(data-col);
      flex: 0 0 100%;
      font-size: var(--fs-label);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
    }
    .cx-duel__cell p {
      flex: 1;
    }
    .cx-duel__cell--them {
      border: 1px solid var(--bbg-border);
      background: var(--bbg-surface);
    }
    .cx-duel__cell--us {
      border: 1px solid rgba(200, 16, 46, 0.3);
      border-left: 3px solid var(--bbg-blue);
      background: var(--bbg-white);
      box-shadow: 0 12px 28px -18px rgba(200, 16, 46, 0.4);
    }
    .cx-duel__cell--us::before {
      color: var(--bbg-blue);
    }
    .cx-duel__row:hover .cx-duel__cell--us {
      translate: none;
    }
  }

  /* ---------- Cursor spotlight ---------- */
  .cx-spot {
    position: relative;
  }
  .cx-spot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms var(--ease);
    background: radial-gradient(
      280px circle at var(--cx-mx, 50%) var(--cx-my, 50%),
      rgba(200, 16, 46, 0.09),
      transparent 65%
    );
  }
  .cx-spot:hover::after,
  [data-cx-spot-host]:hover .cx-spot::after {
    opacity: 1;
  }
  .cx-duel__bg--us.cx-spot {
    position: absolute;
  }

  /* ---------- Coverage ---------- */
  .cx-coverage__top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: start;
  }
  .cx-coverage__intro .section-header {
    margin-bottom: var(--space-5);
  }
  .cx-coverage__sublabel {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bbg-text-muted);
    margin: var(--space-6) 0 var(--space-4);
  }
  .cx-coverage__sublabel::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--bbg-border);
  }
  .cx-types {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  .cx-type {
    --cx-t: translate 300ms var(--ease), border-color 300ms var(--ease), box-shadow 300ms var(--ease);
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    overflow: hidden;
  }
  .cx-type:hover {
    translate: 0 -4px;
    border-color: var(--bbg-blue);
    box-shadow: 0 24px 40px -28px rgba(200, 16, 46, 0.55);
  }
  .cx-type__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--space-4);
    border-radius: 12px;
    background: var(--bbg-blue-light);
    color: var(--bbg-blue);
    transition:
      background 300ms var(--ease),
      color 300ms var(--ease),
      rotate 300ms var(--ease);
  }
  .cx-type__icon svg {
    width: 22px;
    height: 22px;
  }
  .cx-type:hover .cx-type__icon {
    background: var(--bbg-blue);
    color: var(--bbg-white);
    rotate: -6deg;
  }
  .cx-type__name {
    font-size: var(--fs-h4);
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }
  .cx-type__body {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--bbg-text-muted);
  }

  /* The partner file */
  .cx-file-wrap {
    position: sticky;
    top: 112px;
    perspective: 1100px;
  }
  .cx-file {
    position: relative;
    padding: var(--space-5);
    border-radius: 20px;
    background:
      radial-gradient(90% 60% at 100% 0%, rgba(200, 16, 46, 0.32), transparent 60%),
      #0b131c;
    color: var(--bbg-white);
    overflow: hidden;
    box-shadow:
      0 50px 80px -40px rgba(6, 14, 22, 0.75),
      0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    transform: rotateX(var(--cx-rx, 0deg)) rotateY(var(--cx-ry, 0deg));
    transition: transform 250ms ease-out;
    will-change: transform;
  }
  .cx-file__scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 90px;
    background: linear-gradient(180deg, transparent, rgba(255, 90, 112, 0.14), transparent);
    animation: cx-scan 5.5s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes cx-scan {
    0% {
      transform: translateY(-100px);
    }
    60%,
    100% {
      transform: translateY(640px);
    }
  }
  .cx-file__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .cx-file__logo {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--bbg-blue);
  }
  .cx-file__logo svg {
    width: 20px;
    height: 20px;
  }
  .cx-file__brand {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* The partner's name stays blacked out. It is a private file. */
  .cx-file__redact {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
    margin-left: auto;
  }
  .cx-file__redact i {
    display: block;
    width: 96px;
    height: 9px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.22);
  }
  .cx-file__redact i + i {
    width: 60px;
    background: rgba(255, 255, 255, 0.12);
  }
  .cx-file__fields {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cx-file__field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 0;
    border-radius: 10px;
    background: transparent;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    text-align: left;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition:
      background 200ms var(--ease),
      color 200ms var(--ease),
      padding-left 200ms var(--ease);
  }
  .cx-file__field svg {
    flex: none;
    width: 16px;
    height: 16px;
    color: rgba(255, 255, 255, 0.35);
    transition: color 200ms var(--ease);
  }
  .cx-file__field.is-active {
    padding-left: 1rem;
    background: rgba(255, 255, 255, 0.09);
    color: var(--bbg-white);
  }
  .cx-file__field.is-active svg {
    color: #ff5a70;
  }
  .cx-file__field:focus-visible {
    outline: 3px solid var(--bbg-blue);
    outline-offset: 1px;
  }
  .cx-file__detail {
    display: grid;
    margin-top: var(--space-4);
    padding: var(--space-4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
  }
  .cx-file__note {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
  }
  .cx-file__note + .cx-file__note {
    margin-top: var(--space-3);
  }
  :global(.cx-js) .cx-file__note {
    grid-area: 1 / 1;
    margin-top: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 250ms var(--ease),
      transform 250ms var(--ease),
      visibility 0s linear 250ms;
  }
  :global(.cx-js) .cx-file__note.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .cx-file,
    .cx-file__field,
    :global(.cx-js) .cx-file__note {
      transition: none;
    }
    .cx-file__scan {
      animation: none;
      display: none;
    }
  }

  /* Category tiles */
  .cx-cats {
    list-style: none;
    margin: 0;
