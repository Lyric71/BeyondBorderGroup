---
/**
 * WO-2.1 — the /compass pillar page, shared across every locale.
 *
 * Framing guardrail from the build spec: Compass is how the shortlist gets
 * built. It is never a product with access tiers. No plan names, no signup
 * language, no price, and the CTA is a brief or a call, never a login.
 *
 * Markup and styles live here once; each locale route supplies only the copy
 * object from src/content/pages/compass/<locale>.ts.
 *
 * Visual layer: scoped cx-* styles plus one inline script (reveal-on-scroll,
 * timeline progress, card spotlight; the hero owns its own motion). All motion
 * sits behind a prefers-reduced-motion guard.
 */
import Layout from '../../../layouts/Layout.astro';
import CompassHero from './CompassHero.astro';
import { getLocaleFromUrl, localizePath } from '../../../i18n/utils';
import type { CompassCopy } from '../../../content/pages/compass/types';

interface Props {
  copy: CompassCopy;
}

const { copy } = Astro.props;
const { facts, index: c } = copy;

const locale = getLocaleFromUrl(Astro.url);
const homeHref = localizePath('/', locale);
const shortlistHref = localizePath('/compass/shortlist', locale);
const toolsHref = localizePath('/tools', locale);
const howItWorksHref = localizePath('/compass/how-it-works', locale);
const cardHrefs = [
  localizePath('/compass/why-vetted', locale),
  localizePath('/compass/what-is-inside', locale),
  howItWorksHref,
];
const distributionHref = localizePath('/enter-china/distribution', locale);

// The ported strings stay verbatim; these splits only let the second sentence
// carry its own colour. Handles both western and CJK sentence breaks, and
// falls back to the whole string when a locale writes a single sentence.
const splitFirstSentence = (s: string): [string, string] => {
  const west = s.indexOf('. ');
  if (west !== -1) return [s.slice(0, west + 1), s.slice(west + 2)];
  const cjk = s.indexOf('。');
  if (cjk !== -1 && cjk < s.length - 1) return [s.slice(0, cjk + 1), s.slice(cjk + 1)];
  return [s, ''];
};
let [headlineA, headlineB] = splitFirstSentence(facts.headline);
if (!headlineB) {
  headlineB = headlineA;
  headlineA = '';
}
const [quoteA, quoteB] = splitFirstSentence(facts.steps.quote);

const stepImages = [
  '/Images/compass/step-brief.png',
  '/Images/compass/step-shortlist.png',
  '/Images/compass/step-introductions.png',
];
const cardImages = [
  '/Images/compass/why-vetted.png',
  '/Images/compass/what-is-inside.png',
  '/Images/compass/how-it-works.png',
];
---

<Layout title={c.title} description={c.description}>
  <!-- Hero, shared layout with the rest of the Find a partner section -->
  <CompassHero
    crumbs={[
      { label: c.crumbHome, href: homeHref },
      { label: c.crumbSection, href: `${homeHref}#services` },
    ]}
    eyebrow={c.eyebrow}
    rows={c.h1Rows}
    lead={c.lead}
    primary={{ label: c.ctaPrimary, href: shortlistHref }}
    secondary={{ label: c.ctaSecondary, href: howItWorksHref }}
    stats={c.heroStats}
    image={{ src: '/Images/compass/compass-hero.png', alt: c.heroAlt }}
    scrollCue={c.scrollCue}
    scrollTarget="#problem"
  />

  <!-- The problem -->
  <section class="section cx-problem" id="problem">
    <div class="container cx-problem__grid">
      <div class="cx-problem__copy">
        <span class="eyebrow cx-reveal">{c.problemEyebrow}</span>
        <h2 class="h2 cx-problem__headline cx-reveal" style="--cx-d: 80ms">
          {headlineA && <span class="cx-problem__headline-a">{headlineA}</span>}
          <span class="cx-problem__headline-b">{headlineB}</span>
        </h2>
        {facts.problemBody.map((p, i) => (
          <p class="cx-reveal" style={`--cx-d: ${140 + i * 60}ms`}>{p}</p>
        ))}
      </div>
      <div class="cx-problem__media cx-reveal" style="--cx-d: 200ms">
        <div class="cx-problem__frame" aria-hidden="true"></div>
        <figure class="cx-problem__figure">
          <img
            src="/Images/compass/problem-pallets.png"
            alt={c.problemFigureAlt}
            width="1200"
            height="675"
            loading="lazy"
          />
        </figure>
        <p class="cx-problem__caption">{c.problemCaption}</p>
      </div>
    </div>
  </section>

  <!-- How it works, the three steps -->
  <section class="section section--alt cx-steps">
    <div class="container">
      <div class="section-header cx-reveal">
        <span class="eyebrow">{facts.steps.eyebrow}</span>
        <h2 class="h2">{facts.steps.title}</h2>
      </div>

      <div class="cx-timeline" data-timeline>
        <div class="cx-timeline__rail" aria-hidden="true">
          <div class="cx-timeline__progress" data-timeline-progress></div>
        </div>
        {facts.steps.items.map((step, i) => (
          <article class="cx-tl-row cx-reveal" data-tl-row>
            <span class="cx-tl-dot" aria-hidden="true"></span>
            <div class="cx-tl-media">
              <img
                src={stepImages[i]}
                alt={c.stepAlts[i]}
                width="1200"
                height="800"
                loading="lazy"
              />
            </div>
            <div class="cx-tl-copy">
              <h3 class="cx-tl-label">{step.label}</h3>
              <p class="cx-tl-body">{step.body}</p>
            </div>
          </article>
        ))}
      </div>

      <blockquote class="cx-pullquote cx-reveal">
        {quoteA && <span class="cx-pullquote__a">{quoteA + ' '}</span>}
        {quoteB ? <span class="cx-pullquote__b">{quoteB}</span> : null}
      </blockquote>
    </div>
  </section>

  <!-- The comparison board -->
  <section class="section cx-versus-section">
    <div class="container">
      <div class="section-header cx-reveal">
        <span class="eyebrow">{facts.comparison.eyebrow}</span>
        <h2 class="h2">{facts.comparison.title}</h2>
      </div>

      <div class="cx-versus">
        <div class="cx-versus__head cx-reveal" aria-hidden="true">
          <span></span>
          <span class="cx-versus__head-them">{facts.comparison.columnHeaders.scraped}</span>
          <span class="cx-versus__head-us">{facts.comparison.columnHeaders.ours}</span>
        </div>
        {facts.comparison.rows.map((row, i) => (
          <div class="cx-versus__row cx-reveal" style={`--cx-d: ${i * 90}ms`}>
            <h3 class="cx-versus__label">{row.label}</h3>
            <div
              class="cx-versus__cell cx-versus__cell--them"
              data-col={facts.comparison.columnHeaders.scraped}
            >
              <svg class="cx-versus__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
              </svg>
              <p>
                <span class="sr-only">{facts.comparison.columnHeaders.scraped}: </span>
                {row.scraped}
              </p>
            </div>
            <div
              class="cx-versus__cell cx-versus__cell--us"
              data-col={facts.comparison.columnHeaders.ours}
            >
              <svg class="cx-versus__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8.5l3.2 3L13 4.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <p>
                <span class="sr-only">{facts.comparison.columnHeaders.ours}: </span>
                {row.ours}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Coverage -->
  <section class="section section--alt cx-coverage">
    <div class="container">
      <div class="section-header cx-reveal">
        <span class="eyebrow">{c.coverageEyebrow}</span>
        <h2 class="h2">{c.coverageTitle}</h2>
        <p class="lead">{c.coverageLead}</p>
      </div>

      <p class="cx-coverage__sublabel cx-reveal">{c.whoLabel}</p>
      <div class="cx-types">
        {facts.partnerTypes.map((t, i) => (
          <article class="cx-type cx-reveal" style={`--cx-d: ${i * 80}ms`}>
            <h3 class="cx-type__name">{t.name}</h3>
            <p class="cx-type__body">{t.body}</p>
          </article>
        ))}
      </div>

      <p class="cx-coverage__sublabel cx-reveal">{c.categoriesLabel}</p>
      <div class="cx-chips">
        {facts.categories.map((cat, i) => (
          <span class="cx-chip cx-reveal" style={`--cx-d: ${i * 50}ms`}>{cat}</span>
        ))}
      </div>
      <p class="cx-coverage__closing cx-reveal">{facts.categoriesClosing}</p>
    </div>
  </section>

  <!-- Read more -->
  <section class="section">
    <div class="container">
      <div class="section-header cx-reveal">
        <span class="eyebrow">{c.readMoreEyebrow}</span>
        <h2 class="h2">{c.readMoreTitle}</h2>
      </div>
      <div class="grid grid-3">
        {c.cards.map((card, i) => (
          <a href={cardHrefs[i]} class="card cx-card cx-spot cx-reveal" style={`--cx-d: ${i * 90}ms`}>
            <div class="card__image">
              <img
                src={cardImages[i]}
                alt={c.cardAlts[i]}
                width="1200"
                height="800"
                loading="lazy"
              />
            </div>
            <h3 class="card__title">{card.title}</h3>
            <p>{card.body}</p>
            <span class="card__footer btn btn--ghost">{c.readMoreCta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark cx-cta">
    <div class="cx-cta__glow" aria-hidden="true"></div>
    <div class="container cx-cta__inner">
      <span class="eyebrow cx-reveal">{c.closingEyebrow}</span>
      <h2 class="h2 cx-reveal" style="--cx-d: 80ms">{c.closingTitle}</h2>
      <p class="cx-cta__lead cx-reveal" style="--cx-d: 160ms">{c.closingLead}</p>
      {
        c.toolsLine && (
          <p class="cx-cta__tools cx-reveal" style="--cx-d: 200ms">
            {c.toolsLine.before}
            <a href={toolsHref}>{c.toolsLine.link}</a>
            {c.toolsLine.after}
          </p>
        )
      }
      <p class="cx-cta__stamp cx-reveal" style="--cx-d: 240ms">{facts.noCommission}</p>
      <div class="cx-cta__actions cx-reveal" style="--cx-d: 320ms">
        <a href={shortlistHref} class="btn btn--primary">{c.closingCtaPrimary}</a>
        <a href={distributionHref} class="btn btn--ghost">{c.closingCtaSecondary}</a>
      </div>
    </div>
  </section>
  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
      // 1. Reveal-on-scroll
      const revealEls = document.querySelectorAll('.cx-reveal');
      if (revealEls.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-in');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
          );
          revealEls.forEach((el) => io.observe(el));
        }
      }
  
      // 2. Timeline: progress line fills with scroll, dots light up as rows pass
      const timeline = document.querySelector('[data-timeline]');
      const progress = document.querySelector('[data-timeline-progress]');
      const rows = document.querySelectorAll('[data-tl-row]');
      if (timeline && progress) {
        let ticking = false;
        const update = () => {
          ticking = false;
          const rect = timeline.getBoundingClientRect();
          const anchor = window.innerHeight * 0.7;
          const p = Math.min(1, Math.max(0, (anchor - rect.top) / rect.height));
          progress.style.transform = 'scaleY(' + p + ')';
          rows.forEach((row) => {
            row.classList.toggle('is-active', row.getBoundingClientRect().top < anchor);
          });
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        if (reduced) {
          progress.style.transform = 'scaleY(1)';
          rows.forEach((row) => row.classList.add('is-active'));
        } else {
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          update();
        }
      }
  
      // 3. Cursor spotlight on the read-more cards
      const spots = document.querySelectorAll('.cx-spot');
      if (spots.length && window.matchMedia('(hover: hover)').matches) {
        spots.forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty('--cx-mx', e.clientX - rect.left + 'px');
            card.style.setProperty('--cx-my', e.clientY - rect.top + 'px');
          });
        });
      }
    })();
  </script>
</Layout>

<style>
  /* ---------- Shared reveal ---------- */
  .cx-reveal {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 700ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--cx-d, 0ms),
      transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--cx-d, 0ms);
  }
  .cx-reveal.is-in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .cx-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ---------- Problem ---------- */
  .cx-problem__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.85fr);
    gap: var(--space-8);
    align-items: center;
  }
  .cx-problem__copy p {
    max-width: 58ch;
  }
  .cx-problem__copy p + p {
    margin-top: var(--space-4);
  }
  .cx-problem__headline {
    max-width: 22ch;
    text-wrap: balance;
  }
  .cx-problem__headline-a {
    display: block;
    color: var(--bbg-text-muted);
    font-weight: 600;
  }
  .cx-problem__headline-b {
    display: block;
    color: var(--bbg-ink);
  }
  .cx-problem__headline-b::after {
    content: '';
    display: block;
    width: 72px;
    height: 4px;
    margin-top: var(--space-3);
    border-radius: 2px;
    background: var(--bbg-blue);
  }
  .cx-problem__media {
    position: relative;
    padding: var(--space-4) var(--space-4) 0 0;
  }
  .cx-problem__frame {
    position: absolute;
    top: 0;
    right: 0;
    width: 82%;
    height: 82%;
    border: 1px solid rgba(200, 16, 46, 0.35);
    border-radius: var(--radius-lg);
    pointer-events: none;
  }
  .cx-problem__figure {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 32px 64px -32px rgba(20, 24, 40, 0.5);
  }
  .cx-problem__figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  .cx-problem__caption {
    margin: var(--space-3) 0 0;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--bbg-text-muted);
  }
  @media (max-width: 980px) {
    .cx-problem__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .cx-problem__media {
      max-width: 560px;
    }
  }

  /* ---------- Timeline ---------- */
  .cx-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-4) 0;
  }
  .cx-timeline__rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: var(--bbg-border);
    border-radius: 1px;
    overflow: hidden;
  }
  .cx-timeline__progress {
    width: 100%;
    height: 100%;
    background: var(--bbg-blue);
    transform: scaleY(0);
    transform-origin: top;
  }
  .cx-tl-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 96px minmax(0, 1fr);
    align-items: center;
  }
  .cx-tl-dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--bbg-surface);
    border: 2px solid var(--bbg-border);
    transition:
      border-color 300ms var(--ease),
      background 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }
  .cx-tl-row.is-active .cx-tl-dot {
    border-color: var(--bbg-blue);
    background: var(--bbg-blue);
    box-shadow: 0 0 0 6px rgba(200, 16, 46, 0.14);
  }
  .cx-tl-media {
    grid-column: 1;
    grid-row: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 48px -28px rgba(20, 24, 40, 0.45);
    transition:
      transform 400ms var(--ease),
      box-shadow 400ms var(--ease);
  }
  .cx-tl-media img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 600ms var(--ease);
  }
  .cx-tl-row:hover .cx-tl-media {
    transform: translateY(-4px);
    box-shadow: 0 32px 56px -28px rgba(20, 24, 40, 0.55);
  }
  .cx-tl-row:hover .cx-tl-media img {
    transform: scale(1.03);
  }
  .cx-tl-copy {
    grid-column: 3;
    grid-row: 1;
  }
  .cx-tl-row:nth-child(odd of .cx-tl-row) .cx-tl-media {
    grid-column: 3;
  }
  .cx-tl-row:nth-child(odd of .cx-tl-row) .cx-tl-copy {
    grid-column: 1;
  }
  .cx-tl-label {
    display: inline-block;
    font-size: var(--fs-h4);
    font-weight: 600;
    color: var(--bbg-ink);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--bbg-blue);
  }
  .cx-tl-body {
    margin: 0;
    line-height: 1.65;
    max-width: 46ch;
  }
  @media (max-width: 900px) {
    .cx-timeline {
      gap: var(--space-6);
    }
    .cx-timeline__rail {
      left: 6px;
      transform: none;
    }
    .cx-tl-row {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
      padding-left: var(--space-6);
    }
    .cx-tl-dot {
      left: 7px;
      top: 10px;
      transform: translate(-50%, 0);
    }
    .cx-tl-body {
      max-width: none;
    }
  }

  .cx-pullquote {
    margin: var(--space-8) auto 0;
    max-width: 34ch;
    text-align: center;
    font-size: clamp(1.375rem, 2.2vw + 0.5rem, 1.875rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--bbg-ink);
    text-wrap: balance;
  }
  .cx-pullquote__b {
    color: var(--bbg-blue);
  }

  /* ---------- Versus board ---------- */
  .cx-versus {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .cx-versus__head,
  .cx-versus__row {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: stretch;
  }
  .cx-versus__head {
    padding: 0 var(--space-2);
  }
  .cx-versus__head-them,
  .cx-versus__head-us {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0 var(--space-5);
  }
  .cx-versus__head-them {
    color: var(--bbg-text-muted);
  }
  .cx-versus__head-us {
    color: var(--bbg-blue);
  }
  .cx-versus__label {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--bbg-ink);
    margin: 0;
    padding: var(--space-4) var(--space-2);
    align-self: center;
  }
  .cx-versus__cell {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    line-height: 1.55;
  }
  .cx-versus__cell p {
    margin: 0;
  }
  .cx-versus__cell--them {
    background: var(--bbg-surface);
    border: 1px solid var(--bbg-border);
    color: var(--bbg-text-muted);
  }
  .cx-versus__cell--us {
    background: var(--bbg-white);
    border: 1px solid rgba(200, 16, 46, 0.3);
    border-left: 3px solid var(--bbg-blue);
    color: var(--bbg-ink);
    font-weight: 500;
    box-shadow: 0 12px 28px -18px rgba(200, 16, 46, 0.35);
    transition:
      transform 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }
  .cx-versus__row:hover .cx-versus__cell--us {
    transform: translateY(-3px);
    box-shadow: 0 18px 36px -18px rgba(200, 16, 46, 0.45);
  }
  .cx-versus__icon {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 0.2em;
  }
  .cx-versus__cell--them .cx-versus__icon {
    color: var(--bbg-text-muted);
  }
  .cx-versus__cell--us .cx-versus__icon {
    color: var(--bbg-blue);
  }
  @media (max-width: 820px) {
    .cx-versus__head {
      display: none;
    }
    .cx-versus__row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding-bottom: var(--space-5);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cx-versus__row:last-child {
      border-bottom: none;
    }
    .cx-versus__label {
      padding: 0;
    }
    .cx-versus__cell::before {
      content: attr(data-col);
      display: block;
      flex: none;
      width: 9rem;
      font-size: var(--fs-label);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-top: 0.25em;
    }
    .cx-versus__cell--us::before {
      color: var(--bbg-blue);
    }
    .cx-versus__icon {
      display: none;
    }
  }

  /* ---------- Coverage ---------- */
  .cx-coverage__sublabel {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bbg-text-muted);
