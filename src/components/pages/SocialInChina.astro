  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- 1. Reveal on scroll ---- */
      const revealEls = document.querySelectorAll('.sic-reveal');
      if (reduced || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
        );
        revealEls.forEach((el) => io.observe(el));
      }

      /* ---- 2. Counters ---- */
      const counters = document.querySelectorAll('[data-counter]');
      const format = (n, el) =>
        el.dataset.group ? Math.round(n).toLocaleString('en-US') : String(Math.round(n));
      const runCounter = (el) => {
        const target = parseFloat(el.dataset.counter || '0');
        const suffix = el.dataset.suffix || '';
        const start = performance.now();
        const dur = 1500;
        const tick = (now) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = format(target * eased, el) + suffix;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      if (reduced || !('IntersectionObserver' in window)) {
        counters.forEach((el) => {
          el.textContent = format(parseFloat(el.dataset.counter || '0'), el) + (el.dataset.suffix || '');
        });
      } else {
        const cio = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                runCounter(e.target);
                cio.unobserve(e.target);
              }
            });
          },
          { threshold: 0.6 },
        );
        counters.forEach((el) => cio.observe(el));
      }

      /* ---- 3. Hero parallax + scroll progress ---- */
      const parallax = document.querySelector('[data-parallax]');
      const bar = document.querySelector('.sic-progress__bar');
      const hero = document.querySelector('[data-hero]');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY || window.pageYOffset;
          if (parallax && hero && !reduced && y < hero.offsetHeight) {
            parallax.style.setProperty('--parallax-y', y * 0.18 + 'px');
          }
          if (bar) {
            const h = document.documentElement.scrollHeight - window.innerHeight;
            bar.style.setProperty('--progress', (h > 0 ? Math.min(100, (y / h) * 100) : 0) + '%');
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      /* ---- 4. Platform switcher ---- */
      const sw = document.querySelector('[data-switch]');
      if (sw) {
        const rail = sw.querySelector('.sic-switch__rail');
        const thumb = sw.querySelector('.sic-switch__thumb');
        const tabs = Array.from(sw.querySelectorAll('.sic-tab'));
        const panels = Array.from(sw.querySelectorAll('.sic-panel'));
        const vertical = () => window.matchMedia('(min-width: 961px)').matches;

        const moveThumb = (tab) => {
          if (!thumb || !rail) return;
          if (vertical()) {
            thumb.style.width = '';
            thumb.style.height = tab.offsetHeight + 'px';
            thumb.style.transform = `translateY(${tab.offsetTop}px)`;
          } else {
            thumb.style.height = '';
            thumb.style.width = tab.offsetWidth + 'px';
            thumb.style.transform = `translateX(${tab.offsetLeft - rail.scrollLeft}px)`;
          }
        };

        const activate = (key, focus) => {
          const tab = tabs.find((t) => t.dataset.tab === key);
          if (!tab) return;
          tabs.forEach((t) => {
            const on = t === tab;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          panels.forEach((p) => {
            const on = p.id === 'panel-' + key;
            p.classList.toggle('is-active', on);
            if (on) p.removeAttribute('hidden');
            else p.setAttribute('hidden', '');
          });
          moveThumb(tab);
          if (focus) tab.focus();
        };

        tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => activate(tab.dataset.tab));
          tab.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft' && e.key !== 'ArrowDown' && e.key !== 'ArrowUp')
              return;
            e.preventDefault();
            const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : -1;
            const next = tabs[(i + step + tabs.length) % tabs.length];
            activate(next.dataset.tab, true);
          });
        });

        if (rail) rail.addEventListener('scroll', () => {
          const active = tabs.find((t) => t.classList.contains('is-active'));
          if (active) moveThumb(active);
        }, { passive: true });

        window.addEventListener('resize', () => {
          const active = tabs.find((t) => t.classList.contains('is-active'));
          if (active) moveThumb(active);
        });

        // Hero chips jump into the switcher
        document.querySelectorAll('[data-jump]').forEach((chip) => {
          chip.addEventListener('click', () => {
            activate(chip.dataset.jump);
            sw.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
          });
        });

        requestAnimationFrame(() => {
          const active = tabs.find((t) => t.classList.contains('is-active')) || tabs[0];
          if (active) moveThumb(active);
        });
      }

      /* ---- 5. The split: highlight by what the work is measured on ---- */
      const test = document.querySelector('[data-test]');
      const board = document.querySelector('[data-board]');
      if (test && board) {
        const btns = Array.from(test.querySelectorAll('.sic-seg__btn'));
        const thumb = test.querySelector('.sic-seg__thumb');
        const cols = Array.from(board.querySelectorAll('[data-col]'));
        const moveThumb = (btn) => {
          if (!thumb) return;
          thumb.style.setProperty('--thumb-w', btn.offsetWidth + 'px');
          thumb.style.setProperty('--thumb-x', btn.offsetLeft + 'px');
        };
        btns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const side = btn.dataset.side;
            btns.forEach((b) => b.classList.toggle('is-active', b === btn));
            moveThumb(btn);
            cols.forEach((c) => {
              const on = side === 'both' || c.dataset.col === side;
              c.classList.toggle('is-focus', side !== 'both' && on);
              c.classList.toggle('is-faded', side !== 'both' && !on);
            });
          });
        });
        const settle = () => {
          const active = btns.find((b) => b.classList.contains('is-active')) || btns[0];
          if (active) moveThumb(active);
        };
        requestAnimationFrame(settle);
        window.addEventListener('resize', settle);
      }

      /* ---- 6. Tilt on the partner-site door ---- */
      const tilt = document.querySelector('[data-tilt]');
      if (tilt && !reduced && window.matchMedia('(hover: hover)').matches) {
        tilt.addEventListener('mousemove', (e) => {
          const r = tilt.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width - 0.5;
          const py = (e.clientY - r.top) / r.height - 0.5;
          tilt.style.setProperty('--ry', (px * 7).toFixed(2) + 'deg');
          tilt.style.setProperty('--rx', (-py * 5).toFixed(2) + 'deg');
        });
        tilt.addEventListener('mouseleave', () => {
          tilt.style.setProperty('--ry', '0deg');
          tilt.style.setProperty('--rx', '0deg');
        });
      }

      /* ---- 7. Magnetic buttons ---- */
      if (!reduced && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll('.sic-magnetic').forEach((el) => {
          el.addEventListener('mousemove', (e) => {
            const r = el.getBoundingClientRect();
            const x = e.clientX - r.left - r.width / 2;
            const y = e.clientY - r.top - r.height / 2;
            el.style.transform = `translate(${x * 0.12}px, ${y * 0.18}px)`;
          });
          el.addEventListener('mouseleave', () => {
            el.style.transform = '';
          });
        });
      }

      /* ---- 8. Smooth in-page anchors ---- */
      document.querySelectorAll('.sic a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = link.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        });
      });
    })();
  </script>
</Layout>
