---
/**
 * /social-in-china, shared across every locale.
 *
 * The page carries a large inline stylesheet, a platform tab switcher and a
 * filter bar. Holding that once here, and letting each locale supply only a
 * copy object, keeps the four language versions from drifting and means a fix
 * happens in one place. Shape: src/content/pages/social-in-china/types.ts.
 *
 * Guardrails from the build spec, in every language:
 *  - no pricing (fixed scope and fixed price is the offer shape, never a figure)
 *  - one outbound target, theredscroll.com, reachable from two places
 */
import Layout from '../../layouts/Layout.astro';
import type { SocialInChinaCopy } from '../../content/pages/social-in-china/types';

interface Props {
  copy: SocialInChinaCopy;
  /** Locale-correct path for the "talk to us instead" fallback. */
  contactHref: string;
}

const { copy, contactHref } = Astro.props;
const c = copy;
const TRS = 'https://theredscroll.com';
const stages = c.stages;
---

<Layout title={c.meta.title} description={c.meta.description}>
  <div class="sic-progress" aria-hidden="true"><div class="sic-progress__bar"></div></div>

  <article class="sic">
    <!-- 1. Hero -->
    <section class="sic-hero" data-hero>
      <div class="sic-hero__bg" aria-hidden="true" data-parallax>
        <img
          src="/Images/social/douyin.png"
          alt=""
          width="1536"
          height="1024"
          fetchpriority="high"
        />
      </div>
      <div class="sic-hero__veil" aria-hidden="true"></div>
      <div class="sic-hero__grain" aria-hidden="true"></div>

      <div class="container sic-hero__inner">
        <div class="sic-hero__copy">
          <nav class="sic-crumbs" aria-label="Breadcrumb">
            <a href="/">{c.hero.crumbHome}</a>
            <span aria-hidden="true">/</span>
            <span>{c.hero.crumbSection}</span>
          </nav>
          <span class="eyebrow sic-reveal">{c.hero.eyebrow}</span>
          <h1 class="sic-hero__title sic-reveal" style="--reveal-delay:60ms">
            {c.hero.titleBefore}<em>{c.hero.titleEm}</em>{c.hero.titleAfter}
          </h1>
          <p class="sic-hero__lead sic-reveal" style="--reveal-delay:140ms">{c.hero.lead}</p>
          <p class="sic-hero__body sic-reveal" style="--reveal-delay:210ms">
            {c.hero.bodyBefore}<a href={TRS}>{c.hero.trsAnchor}</a>{c.hero.bodyAfter}
          </p>
          <div class="sic-hero__cta sic-reveal" style="--reveal-delay:280ms">
            <a href={TRS} class="btn btn--primary sic-magnetic">{c.hero.ctaPrimary}</a>
            <a href="#the-split" class="btn btn--ghost-light sic-magnetic">{c.hero.ctaSecondary}</a>
          </div>

          <div class="sic-hero__strip sic-reveal" style="--reveal-delay:360ms">
            {
              c.platforms.map((p) => (
                <button class="sic-chip" type="button" data-jump={p.key}>
                  <span class="sic-chip__logo" style={`--logo:url(${p.logo})`} aria-hidden="true" />
                  <span class="sic-chip__name">{p.name}</span>
                  <span class="sic-chip__cn">{p.cn}</span>
                </button>
              ))
            }
          </div>
        </div>

        <a
          class="sic-door__frame sic-hero__shot sic-reveal"
          href={TRS}
          data-tilt
          aria-label={c.hero.shotAria}
          style="--reveal-delay:300ms"
        >
          <span class="sic-door__chrome" aria-hidden="true">
            <i></i><i></i><i></i>
            <span class="sic-door__url">theredscroll.com</span>
          </span>
          <img
            src="/Images/doors/theredscroll-home.png"
            alt={c.hero.shotAlt}
            width="1440"
            height="756"
            fetchpriority="high"
          />
          <span class="sic-door__cta">{c.hero.shotCta} <span aria-hidden="true">&#8594;</span></span>
        </a>
      </div>

      <a href="#platform-map" class="sic-scroll" aria-label={c.hero.scrollAria}>
        <span class="sic-scroll__line"></span>
        <span>{c.hero.scrollLabel}</span>
      </a>
    </section>

    <!-- 2. The platform map -->
    <section class="section sic-mapsec" id="platform-map">
      <div class="container">
        <div class="section-header sic-reveal">
          <span class="eyebrow">{c.map.eyebrow}</span>
          <h2 class="h2">{c.map.title}</h2>
          <p class="lead">{c.map.lead}</p>
        </div>

        <div class="sic-switch" data-switch>
          <div class="sic-switch__rail" role="tablist" aria-label={c.map.tablistAria}>
            {
              c.platforms.map((p, i) => (
                <button
                  class={`sic-tab${i === 0 ? ' is-active' : ''}`}
                  type="button"
                  role="tab"
                  id={`tab-${p.key}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls={`panel-${p.key}`}
                  data-tab={p.key}
                  style={`--tint:${p.tint}`}
                >
                  <span class="sic-tab__logo" style={`--logo:url(${p.logo})`} aria-hidden="true" />
                  <span class="sic-tab__text">
                    <span class="sic-tab__name">{p.name}</span>
                    <span class="sic-tab__cn">{p.cn}</span>
                  </span>
                  <span class="sic-tab__role">{p.role}</span>
                </button>
              ))
            }
            <span class="sic-switch__thumb" aria-hidden="true"></span>
          </div>

          <div class="sic-switch__stage">
            {
              c.platforms.map((p, i) => (
                <div
                  class={`sic-panel${i === 0 ? ' is-active' : ''}`}
                  id={`panel-${p.key}`}
                  role="tabpanel"
                  aria-labelledby={`tab-${p.key}`}
                  hidden={i !== 0}
                  style={`--tint:${p.tint}`}
                >
                  <figure class="sic-panel__media">
                    <img src={p.image} alt={p.alt} loading={i === 0 ? 'eager' : 'lazy'} />
                    <figcaption>
                      <span class="sic-panel__badge">{p.cn}</span>
                    </figcaption>
                  </figure>

                  <div class="sic-panel__copy">
                    <span class="sic-panel__role">{p.role}</span>
                    <h3 class="sic-panel__name">{p.name}</h3>
                    <p class="sic-panel__body">{p.body}</p>

                    <div class="sic-funnel" aria-hidden="true">
                      <span class="sic-funnel__title">{c.map.funnelTitle}</span>
                      <div class="sic-funnel__track">
                        {p.weights.map((w, j) => (
                          <span
                            class={`sic-funnel__cell is-w${w}`}
                            style={`--cell-delay:${j * 70}ms`}
                          >
                            <i />
                            <em>{stages[j]}</em>
                          </span>
                        ))}
                      </div>
                    </div>

                    <p class="sic-panel__owner">
                      <span class="sic-panel__owner-dot" aria-hidden="true" />
                      <span class="sic-panel__owner-text">
                        {p.owner === 'Split' ? c.map.ownerSplit : c.map.ownerTrs}{' '}
                        <a href="#the-split">{c.map.ownerLink}</a>
                      </span>
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Long tail -->
        <div class="sic-tail sic-reveal">
          <div class="sic-tail__intro">
            <h3 class="sic-tail__h3">{c.map.tailTitle}</h3>
            <p>{c.map.tailBody}</p>
          </div>
          <ul class="sic-tail__grid">
            {
              c.longTail.map((t, i) => (
                <li class="sic-tail__chip" style={`--chip-delay:${i * 55}ms`}>
                  <span class="sic-tail__logo" style={`--logo:url(${t.logo})`} aria-hidden="true" />
                  <span class="sic-tail__name">
                    {t.name} <b>{t.cn}</b>
                  </span>
                  <span class="sic-tail__who">{t.who}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- 3. Where social sells and where it only builds -->
    <section class="section sic-splitsec" id="the-split">
      <div class="container">
        <div class="section-header section-header--center sic-reveal">
          <span class="eyebrow">{c.splitSection.eyebrow}</span>
          <h2 class="h2">{c.splitSection.title}</h2>
          <p class="lead">{c.splitSection.lead}</p>
        </div>

        <div class="sic-testbar sic-reveal" data-test>
          <span class="sic-testbar__label">{c.splitSection.testLabel}</span>
          <div class="sic-seg" role="group" aria-label={c.splitSection.filterAria}>
            <button type="button" class="sic-seg__btn is-active" data-side="both">
              {c.splitSection.filterBoth}
            </button>
            <button type="button" class="sic-seg__btn" data-side="gmv">
              {c.splitSection.filterGmv}
            </button>
            <button type="button" class="sic-seg__btn" data-side="audience">
              {c.splitSection.filterAudience}
            </button>
            <span class="sic-seg__thumb" aria-hidden="true"></span>
          </div>
        </div>

        <div class="sic-board" data-board>
          {
            c.split.map((s, i) => (
              <article
                class="sic-col sic-reveal"
                data-col={s.key}
                style={`--reveal-delay:${i * 90}ms`}
              >
                <header class="sic-col__head">
                  <span class="sic-col__owner">{s.owner}</span>
                  <h3 class="sic-col__title">{s.title}</h3>
                  <span class="sic-col__metric">{s.metric}</span>
                </header>
                <ul class="sic-list">
                  {s.items.map((it, j) => (
                    <li style={`--li-delay:${j * 60}ms`}>{it}</li>
                  ))}
                </ul>
                <p class="sic-col__why">{s.why}</p>
              </article>
            ))
          }
          <span class="sic-board__seam" aria-hidden="true"></span>
        </div>

        <p class="sic-note sic-reveal">{c.splitSection.note}</p>
      </div>
    </section>

    <!-- 4. Proof -->
    <section class="section section--alt sic-proofsec">
      <div class="container">
        <div class="section-header sic-reveal">
          <span class="eyebrow">{c.proof.eyebrow}</span>
          <h2 class="h2">{c.proof.title}</h2>
        </div>

        <div class="sic-proof">
          <div class="sic-proof__item sic-reveal">
            <span class="sic-proof__figure">
              <span class="sic-proof__from">43K</span>
              <span class="sic-proof__arrow" aria-hidden="true">&#8594;</span>
              <span data-counter="187" data-suffix="K">0K</span>
            </span>
            <p class="sic-proof__label">{c.proof.followersLabel}</p>
            <span class="sic-proof__track" aria-hidden="true"><i style="--w:100%"></i></span>
          </div>

          <div class="sic-proof__item sic-reveal" style="--reveal-delay:90ms">
            <span class="sic-proof__figure">
              <span class="sic-proof__plus">+</span><span data-counter="31" data-suffix="%">0%</span>
            </span>
            <p class="sic-proof__label">{c.proof.sameStoreLabel}</p>
            <span class="sic-proof__track" aria-hidden="true"><i style="--w:62%"></i></span>
          </div>

          <div class="sic-proof__item sic-reveal" style="--reveal-delay:180ms">
            <span class="sic-proof__figure"><span data-counter="10000" data-group="1">0</span></span>
            <p class="sic-proof__label">{c.proof.blueLabel}</p>
            <span class="sic-proof__track" aria-hidden="true"><i style="--w:78%"></i></span>
          </div>
        </div>

        <p class="sic-source">{c.proof.source}</p>
      </div>
    </section>

    <!-- 5. The handoff -->
    <section class="section sic-door" id="handoff">
      <div class="container sic-door__grid sic-door__grid--single">
        <div class="sic-door__copy sic-reveal">
          <span class="eyebrow">{c.door.eyebrow}</span>
          <h2 class="h2">{c.door.title}</h2>
          <p>
            {c.door.bodyOneBefore}<a href={TRS}>{c.door.trsAnchor}</a>{c.door.bodyOneAfter}
          </p>
          <p>{c.door.bodyTwo}</p>
          <div class="sic-hero__cta">
            <a href={TRS} class="btn btn--primary sic-magnetic">{c.door.ctaPrimary}</a>
            <a href={contactHref} class="btn btn--secondary sic-magnetic">{c.door.ctaSecondary}</a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <style is:global>
    /* ============================================================
       /social-in-china
       ============================================================ */
    .sic {
      overflow-x: clip;
    }

    /* ---------- Reveal + motion primitives ---------- */
    @media (prefers-reduced-motion: no-preference) {
      .sic-reveal {
        opacity: 0;
        transform: translateY(18px);
        transition:
          opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
          transform 700ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms);
      }
      .sic-reveal.is-in {
        opacity: 1;
        transform: none;
      }
      .sic-magnetic {
        will-change: transform;
        transition:
          transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
          background-color 200ms ease,
          color 200ms ease,
          border-color 200ms ease;
      }
    }

    /* ---------- Scroll progress ---------- */
    .sic-progress {
      position: fixed;
      inset: 0 0 auto 0;
      height: 3px;
      z-index: 1000;
      pointer-events: none;
    }
    .sic-progress__bar {
      height: 100%;
      width: var(--progress, 0%);
      background: linear-gradient(90deg, #c8102e 0%, #ff5c74 100%);
      box-shadow: 0 0 12px rgba(200, 16, 46, 0.5);
      transition: width 90ms linear;
    }

    /* ---------- HERO ---------- */
    .sic-hero {
      position: relative;
      min-height: clamp(600px, 82vh, 820px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      color: var(--bbg-white);
      overflow: hidden;
      isolation: isolate;
      padding: clamp(88px, 10vh, 128px) 0 clamp(96px, 12vh, 132px);
    }
    .sic-hero__bg {
      position: absolute;
      inset: -8% 0 0;
      z-index: -3;
    }
    .sic-hero__bg img {
      width: 100%;
      height: 112%;
      object-fit: cover;
      object-position: 62% 45%;
      transform: translate3d(0, var(--parallax-y, 0px), 0) scale(1.05);
      transition: transform 80ms linear;
    }
    .sic-hero__veil {
      position: absolute;
      inset: 0;
      z-index: -2;
      background:
        linear-gradient(
          104deg,
          rgba(6, 8, 12, 0.95) 0%,
          rgba(6, 8, 12, 0.86) 34%,
          rgba(6, 8, 12, 0.5) 72%,
          rgba(6, 8, 12, 0.35) 100%
        ),
        radial-gradient(110% 80% at 0% 100%, rgba(200, 16, 46, 0.34) 0%, rgba(200, 16, 46, 0) 62%);
    }
    .sic-hero__grain {
      position: absolute;
      inset: 0;
      z-index: -1;
      background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
      background-size: 3px 3px;
      mix-blend-mode: overlay;
      opacity: 0.5;
      pointer-events: none;
    }
    .sic-hero__inner {
      position: relative;
      max-width: 1200px;
      display: grid;
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
      align-items: center;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
    .sic-hero__copy {
      min-width: 0;
    }

    /* The screenshot, framed as a browser window. It is the primary action in
       the hero: the page hands this work to TheRedScroll, so show the place it
       goes before making the argument. */
    .sic-hero__shot {
      align-self: center;
    }
    .sic-hero__shot img {
      display: block;
      width: 100%;
      height: auto;
    }

    @media (max-width: 1024px) {
      .sic-hero__inner {
        grid-template-columns: 1fr;
      }
      .sic-hero__shot {
        max-width: 640px;
      }
    }
    @media (max-width: 700px) {
      .sic-hero__shot {
        display: none;
      }
    }

    .sic-door__grid--single {
      grid-template-columns: 1fr !important;
      max-width: 820px;
    }
    .sic-crumbs {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      font-size: var(--fs-small);
      color: rgba(255, 255, 255, 0.55);
      margin-bottom: var(--space-4);
    }
    .sic-crumbs a {
      color: rgba(255, 255, 255, 0.82);
      font-weight: 500;
    }
    .sic-crumbs a:hover {
      color: var(--bbg-white);
    }
    .sic-hero .eyebrow {
      color: #ff6b81;
    }
    .sic-hero__title {
      font-size: clamp(2.4rem, 4vw + 1rem, 4.25rem);
      line-height: 1.03;
      letter-spacing: -0.03em;
      color: var(--bbg-white);
      max-width: 13ch;
      margin-bottom: var(--space-5);
    }
    .sic-hero__title em {
      font-style: italic;
      color: #ff6b81;
    }
    .sic-hero__lead {
      font-size: var(--fs-lead);
      line-height: 1.5;
      color: rgba(255, 255, 255, 0.88);
      max-width: 48ch;
    }
    .sic-hero__body {
      color: rgba(255, 255, 255, 0.62);
      max-width: 50ch;
      font-size: var(--fs-small);
      line-height: 1.7;
    }
    .sic-hero__body a,
    .sic-hero__body a:visited {
      color: var(--bbg-white);
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: rgba(255, 255, 255, 0.4);
    }
    .sic-hero__body a:hover {
      text-decoration-color: var(--bbg-white);
    }
    .sic-hero__cta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      align-items: center;
      margin-top: var(--space-5);
    }

    /* Platform chips under the hero copy: a preview of the section below */
    .sic-hero__strip {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: var(--space-7);
      padding-top: var(--space-5);
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      max-width: 640px;
    }
    .sic-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.95rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.05);
      color: rgba(255, 255, 255, 0.82);
      cursor: pointer;
      font-size: var(--fs-small);
      font-weight: 600;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      transition:
        background 220ms ease,
        border-color 220ms ease,
        transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1),
        color 220ms ease;
    }
    .sic-chip:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.35);
      color: var(--bbg-white);
      transform: translateY(-2px);
    }
    .sic-chip__logo {
      width: 18px;
      height: 18px;
      background-color: currentColor;
      -webkit-mask-image: var(--logo);
      mask-image: var(--logo);
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
      flex-shrink: 0;
    }
    .sic-chip__cn {
      color: rgba(255, 255, 255, 0.45);
      font-weight: 500;
    }

    /* ---------- Scroll cue ---------- */
    .sic-scroll {
      position: absolute;
      left: 50%;
      bottom: 1.5rem;
      transform: translateX(-50%);
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.7rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.45);
    }
    .sic-scroll:hover {
      color: rgba(255, 255, 255, 0.85);
    }
    .sic-scroll__line {
      width: 1px;
      height: 42px;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.65));
      transform-origin: top;
      animation: sic-drop 2.4s ease-in-out infinite;
    }
    @keyframes sic-drop {
      0%,
      100% {
        transform: scaleY(0.45);
        opacity: 0.4;
      }
      50% {
        transform: scaleY(1);
        opacity: 1;
      }
    }
    @media (max-width: 900px) {
      .sic-scroll {
        display: none;
      }
    }

    /* ---------- Section 2: platform switcher ---------- */
    .sic-switch {
      display: grid;
      grid-template-columns: minmax(240px, 0.62fr) minmax(0, 1.38fr);
      gap: clamp(1.5rem, 3.5vw, 3rem);
      align-items: start;
    }
    @media (max-width: 960px) {
      .sic-switch {
        grid-template-columns: 1fr;
      }
    }
    .sic-switch__rail {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 2px;
      border-left: 2px solid var(--bbg-border);
    }
    .sic-switch__thumb {
      position: absolute;
      left: -2px;
      width: 2px;
      background: var(--bbg-blue);
      border-radius: 2px;
      top: 0;
      height: 0;
      transition:
        transform 380ms cubic-bezier(0.2, 0.8, 0.2, 1),
        height 380ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .sic-tab {
      position: relative;
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'logo text'
        'logo role';
      gap: 0.15rem 0.85rem;
      align-items: center;
      text-align: left;
      width: 100%;
      padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
      background: none;
      border: 0;
      cursor: pointer;
      color: var(--bbg-text-muted);
      transition:
        background 240ms ease,
        color 240ms ease;
    }
    .sic-tab:hover {
      background: var(--bbg-surface);
      color: var(--bbg-ink);
    }
    .sic-tab.is-active {
      background: var(--bbg-surface);
      color: var(--bbg-ink);
    }
    .sic-tab__logo {
      grid-area: logo;
      width: 30px;
      height: 30px;
      background-color: currentColor;
      -webkit-mask-image: var(--logo);
      mask-image: var(--logo);
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
      opacity: 0.45;
      transition:
        opacity 240ms ease,
        background-color 240ms ease,
        transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .sic-tab.is-active .sic-tab__logo,
