</style>

<script is:inline>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reveal on scroll
    const revealEls = document.querySelectorAll('.home-reveal');
    if (revealEls.length) {
      if (reduced || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        revealEls.forEach((el) => io.observe(el));
      }
    }

    // Hero meta counters render their final value in static HTML so AI
    // crawlers (no JS) read the real numbers, not 0. Keep the data
    // attributes wired in case the animation is reintroduced later, but
    // skip animating when the static value already matches the target.
    const counters = document.querySelectorAll('[data-home-counter]');
    counters.forEach((el) => {
      const target = (el.dataset.homeCounter || '0') + (el.dataset.suffix || '');
      if (el.textContent.trim() !== target) {
        el.textContent = target;
      }
    });

    // Hero parallax + scroll progress bar (single rAF loop).
    // Hero height and doc height are cached and refreshed on resize so the
    // scroll handler does not force a synchronous layout every tick.
    // Every slide of the hero carries its own backdrop, so move them all.
    const parallaxImgs = document.querySelectorAll('[data-home-parallax] img');
    const progressEl = document.querySelector('.home-progress__bar');
    const heroEl = document.querySelector('[data-home-hero]');
    let heroH = heroEl ? heroEl.offsetHeight : 0;
    let docH = document.documentElement.scrollHeight - window.innerHeight;
    let ticking = false;
    const refreshMetrics = () => {
      if (heroEl) heroH = heroEl.offsetHeight;
      docH = document.documentElement.scrollHeight - window.innerHeight;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scrollY = window.scrollY || window.pageYOffset;
        if (parallaxImgs.length && heroEl && !reduced && scrollY < heroH) {
          parallaxImgs.forEach((img) => img.style.setProperty('--parallax-y', scrollY * 0.18 + 'px'));
        }
        if (progressEl) {
          const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
          progressEl.style.setProperty('--progress', pct + '%');
        }
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', refreshMetrics, { passive: true });
    // Doc height grows as lazy content/images load; refresh after load too.
    window.addEventListener('load', refreshMetrics, { once: true });
    onScroll();

    // Hero slides: advance every 5 seconds, plus tabs, arrow keys and swipe.
    // The active tab's bar fills over the interval. Autoplay pauses while
    // keyboard focus is in the hero and while the page is hidden, and is off
    // entirely for visitors who ask for reduced motion. No hover pause: the
    // hero fills the viewport, so the cursor sits on it almost all the time
    // and a hover pause meant the slides often never started.
    const slider = document.querySelector('[data-hero-slider]');
    if (slider) {
      const slides = Array.from(slider.querySelectorAll('[data-hero-slide]'));
      const tabs = Array.from(slider.querySelectorAll('[data-hero-tab]'));
      const INTERVAL = 5000;
      let current = 0;
      let timer = null;
      let focused = false;
      const canPlay = () => !reduced && !focused && !document.hidden;
      const schedule = () => {
        clearTimeout(timer);
        slider.classList.remove('is-auto');
        if (!canPlay()) return;
        // Re-adding the class restarts the progress fill on the active tab.
        void slider.offsetWidth;
        slider.classList.add('is-auto');
        timer = setTimeout(() => show(current + 1), INTERVAL);
      };
      slider.style.setProperty('--hero-interval', INTERVAL + 'ms');
      const show = (i, focus) => {
        const next = (i + slides.length) % slides.length;
        if (next === current) return schedule();
        current = next;
        slides.forEach((slide, n) => {
          const on = n === current;
          slide.classList.toggle('is-active', on);
          slide.toggleAttribute('inert', !on);
          if (on) slide.removeAttribute('aria-hidden');
          else slide.setAttribute('aria-hidden', 'true');
          if (on && !reduced) {
            // Replay the entrance for the incoming slide.
            const els = slide.querySelectorAll('.home-reveal');
            els.forEach((el) => el.classList.remove('is-in'));
            void slide.offsetWidth;
            els.forEach((el) => el.classList.add('is-in'));
          }
        });
        tabs.forEach((tab, n) => {
          const on = n === current;
          tab.classList.toggle('is-active', on);
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
          tab.tabIndex = on ? 0 : -1;
          if (on && focus) tab.focus();
        });
        schedule();
      };
      // Only keyboard focus pauses. A mouse click on a tab or button also
      // moves focus into the hero, and that used to stop autoplay for good.
      slider.addEventListener('focusin', (e) => {
        let keyboard = true;
        try {
          keyboard = e.target.matches(':focus-visible');
        } catch (_) {}
        if (!keyboard) return;
        focused = true;
        schedule();
      });
      slider.addEventListener('focusout', (e) => {
        if (slider.contains(e.relatedTarget)) return;
        focused = false;
        schedule();
      });
      document.addEventListener('visibilitychange', schedule);
      // Back/forward cache restores the page with a stale timer; restart it.
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) schedule();
      });
      tabs.forEach((tab, n) => {
        tab.addEventListener('click', () => show(n));
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') {
            e.preventDefault();
            show(current + 1, true);
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            show(current - 1, true);
          }
        });
      });
      // Deep link for campaigns: /#find-a-partner opens on the Compass slide.
      if (location.hash === '#find-a-partner') show(1);
      else schedule();
      let startX = null;
      let startY = null;
      slider.addEventListener(
        'touchstart',
        (e) => {
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
        },
        { passive: true },
      );
      slider.addEventListener(
        'touchend',
        (e) => {
          if (startX === null) return;
          const dx = e.changedTouches[0].clientX - startX;
          const dy = e.changedTouches[0].clientY - startY;
          startX = null;
          if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
        },
        { passive: true },
      );
    }

    // Smooth-scroll the hero anchor
    const scrollLink = document.querySelector('.home-hero__scroll');
    if (scrollLink) {
      scrollLink.addEventListener('click', (e) => {
        const id = scrollLink.getAttribute('href');
        if (!id || id === '#') return;
        const target = document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      });
    }
  })();
</script>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-stage-panels]');
    if (!root) return;
    const panels = Array.from(root.querySelectorAll('.stage-panel'));
    if (!panels.length) return;

    const triggers = panels.map((p) => p.querySelector('.stage-panel__hit'));

    const setActive = (key, opts = {}) => {
      if (!key) return;
      let activated = null;
      panels.forEach((panel) => {
        const isActive = panel.dataset.stage === key;
        panel.classList.toggle('is-active', isActive);
        const trig = panel.querySelector('.stage-panel__hit');
        if (trig) trig.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        if (isActive) activated = panel;
      });
      root.setAttribute('data-active', key);
      if (opts.focus && activated) {
        const trig = activated.querySelector('.stage-panel__hit');
        if (trig) trig.focus();
      }
    };

    triggers.forEach((trig, idx) => {
      if (!trig) return;
      trig.addEventListener('click', () => {
        const key = trig.dataset.stageTrigger;
        if (root.dataset.active === key) return;
        setActive(key);
      });
      trig.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          const next = triggers[(idx + 1) % triggers.length];
          if (next) setActive(next.dataset.stageTrigger, { focus: true });
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          const prev = triggers[(idx - 1 + triggers.length) % triggers.length];
          if (prev) setActive(prev.dataset.stageTrigger, { focus: true });
        } else if (e.key === 'Home') {
          e.preventDefault();
          const first = triggers[0];
          if (first) setActive(first.dataset.stageTrigger, { focus: true });
        } else if (e.key === 'End') {
          e.preventDefault();
          const last = triggers[triggers.length - 1];
          if (last) setActive(last.dataset.stageTrigger, { focus: true });
        }
      });
    });

    const section = document.getElementById('pillars');
    if (section && 'IntersectionObserver' in window) {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        section.classList.add('is-pre-reveal');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                section.classList.remove('is-pre-reveal');
                section.classList.add('is-revealed');
                io.disconnect();
              }
            });
          },
          { threshold: 0.18 },
        );
        io.observe(section);
      }
    }
  })();

  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tabs = Array.from(document.querySelectorAll('.svc-tab'));
    const indicator = document.querySelector('.svc-tabs__indicator');

    const moveIndicator = (tab) => {
      if (!indicator || !tab) return;
      const parent = tab.parentElement;
      const pRect = parent.getBoundingClientRect();
      const tRect = tab.getBoundingClientRect();
      indicator.style.setProperty('--x', tRect.left - pRect.left + 'px');
      indicator.style.setProperty('--w', tRect.width + 'px');
    };

    const setActive = (tab) => {
      const stage = tab.dataset.stage;
      tabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      document.querySelectorAll('.svc-panel').forEach((p) => {
        const on = p.dataset.stage === stage;
        p.classList.toggle('is-active', on);
        if (on) {
          const tiles = p.querySelectorAll('[data-svc-tile]');
          // Re-trigger the entrance animation without a forced reflow:
          // strip the class on this frame, re-add on the next, so the
          // browser does ONE layout pass instead of one per tile.
          tiles.forEach((tile) => tile.classList.remove('is-in'));
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              tiles.forEach((tile) => tile.classList.add('is-in'));
            });
          });
        }
      });
      moveIndicator(tab);
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => setActive(tab));
    });

    // Pillar CTAs ("Explore Enter China" etc.) → scroll to services section
    // and activate the matching stage tab.
    document.querySelectorAll('[data-stage-jump]').forEach((cta) => {
      cta.addEventListener('click', (e) => {
        const key = cta.dataset.stageJump;
        const targetTab = tabs.find((t) => t.dataset.stage === key);
        const section = document.getElementById('services');
        if (!targetTab || !section) return;
        e.preventDefault();
        setActive(targetTab);
        section.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      });
    });

    const active = document.querySelector('.svc-tab.is-active');
    if (active) requestAnimationFrame(() => moveIndicator(active));
    window.addEventListener('resize', () => {
      const a = document.querySelector('.svc-tab.is-active');
      if (a) moveIndicator(a);
    });

    // Tiles: scroll reveal + mouse spotlight + 3D tilt + image parallax
    const tiles = document.querySelectorAll('[data-svc-tile]');
    if (tiles.length) {
      if (reduced || !('IntersectionObserver' in window)) {
        tiles.forEach((t) => t.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
        );
        tiles.forEach((tile) => io.observe(tile));
      }

      tiles.forEach((tile) => {
        if (reduced) return;
        const img = tile.querySelector('[data-svc-parallax] img');

        tile.addEventListener('pointermove', (e) => {
          const r = tile.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width;
          const y = (e.clientY - r.top) / r.height;
          tile.style.setProperty('--mx', x * 100 + '%');
          tile.style.setProperty('--my', y * 100 + '%');
          const rx = (0.5 - y) * 6;
          const ry = (x - 0.5) * 8;
          tile.style.setProperty('--rx', rx + 'deg');
          tile.style.setProperty('--ry', ry + 'deg');
          if (img) {
            const px = (x - 0.5) * -10;
            const py = (y - 0.5) * -10;
            img.style.setProperty('--px', px + 'px');
            img.style.setProperty('--py', py + 'px');
          }
        });
        tile.addEventListener('pointerleave', () => {
          tile.style.setProperty('--mx', '50%');
          tile.style.setProperty('--my', '50%');
          tile.style.setProperty('--rx', '0deg');
          tile.style.setProperty('--ry', '0deg');
          if (img) {
            img.style.setProperty('--px', '0px');
            img.style.setProperty('--py', '0px');
          }
        });
      });

      // Image scroll-parallax inside each tile (subtle).
      // Two-pass: all reads first, then all writes, so the browser does a
      // single layout pass per frame instead of one per tile.
      if (!reduced) {
        const parallaxImgs = document.querySelectorAll('[data-svc-parallax] img');
        let parallaxTicking = false;
        const shifts = new Array(parallaxImgs.length);
        const updateParallax = () => {
          const vh = window.innerHeight;
          parallaxImgs.forEach((img, i) => {
            const r = img.parentElement.getBoundingClientRect();
            if (r.bottom < 0 || r.top > vh) {
              shifts[i] = null;
              return;
            }
            const center = r.top + r.height / 2;
            const ratio = (center - vh / 2) / vh;
            shifts[i] = Math.max(-14, Math.min(14, ratio * -22));
          });
          parallaxImgs.forEach((img, i) => {
            if (shifts[i] !== null) img.style.setProperty('--sy', shifts[i] + 'px');
          });
          parallaxTicking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (parallaxTicking) return;
            parallaxTicking = true;
            requestAnimationFrame(updateParallax);
          },
          { passive: true },
        );
        updateParallax();
      }
    }
  })();

  // BeyondCompass: trigger stagger animation when section enters viewport
  (() => {
    const bc = document.querySelector('[data-bc-section]');
    if (!bc) return;
    if (!('IntersectionObserver' in window)) {
      bc.classList.add('is-in');
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            bc.classList.add('is-in');
            io.unobserve(bc);
          }
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -10% 0px' },
    );
    io.observe(bc);
  })();

  // Hub Studio module: reveal on scroll, tabs, mouse parallax, indicator
  (() => {
    const studio = document.querySelector('.studio');
    if (!studio) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Scroll reveal
    const reveals = studio.querySelectorAll('[data-reveal]');
    if (reduced || !('IntersectionObserver' in window)) {
      reveals.forEach((el) => el.classList.add('is-in'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
      );
      reveals.forEach((el) => io.observe(el));
    }

    // Tabs
    const tabs = Array.from(studio.querySelectorAll('.studio__tab'));
    const panels = Array.from(studio.querySelectorAll('.studio__panel'));
    const indicator = studio.querySelector('.studio__tabs-indicator');
    const positionIndicator = (tab) => {
      if (!indicator || !tab) return;
      const tabsEl = tab.parentElement;
      const r = tab.getBoundingClientRect();
      const pr = tabsEl.getBoundingClientRect();
      indicator.style.setProperty('--x', r.left - pr.left + 'px');
      indicator.style.setProperty('--w', r.width + 'px');
    };
    const activateTab = (key) => {
      tabs.forEach((t) => {
        const isActive = t.dataset.tab === key;
        t.classList.toggle('is-active', isActive);
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        if (isActive) positionIndicator(t);
      });
      panels.forEach((p) => {
        const isActive = p.dataset.panel === key;
        if (isActive) {
          p.removeAttribute('hidden');
          requestAnimationFrame(() => p.classList.add('is-active'));
        } else {
          p.classList.remove('is-active');
          p.setAttribute('hidden', '');
        }
      });
    };
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activateTab(tab.dataset.tab));
      tab.addEventListener('keydown', (e) => {
        const i = tabs.indexOf(tab);
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          const next = tabs[(i + 1) % tabs.length];
          next.focus();
          activateTab(next.dataset.tab);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          const prev = tabs[(i - 1 + tabs.length) % tabs.length];
          prev.focus();
          activateTab(prev.dataset.tab);
        }
      });
    });
    const first = tabs.find((t) => t.classList.contains('is-active')) || tabs[0];
    if (first) {
      // Wait one frame so layout is stable before positioning indicator
      requestAnimationFrame(() => positionIndicator(first));
    }
    window.addEventListener('resize', () => {
      const active = tabs.find((t) => t.classList.contains('is-active'));
      positionIndicator(active);
    });

    // Mouse parallax on the hero visual
    if (!reduced) {
      const visual = studio.querySelector('[data-parallax]');
      if (visual) {
        const main = visual.querySelector('.studio__frame--main');
        const sub = visual.querySelector('.studio__frame--sub');
        visual.addEventListener('pointermove', (e) => {
          const r = visual.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          if (main) {
            main.style.setProperty('--px', x * -14 + 'px');
            main.style.setProperty('--py', y * -14 + 'px');
            main.style.setProperty('--rx', y * 4 + 'deg');
            main.style.setProperty('--ry', x * -6 + 'deg');
          }
          if (sub) {
            sub.style.setProperty('--px', x * 22 + 'px');
            sub.style.setProperty('--py', y * 22 + 'px');
          }
        });
        visual.addEventListener('pointerleave', () => {
          [main, sub].forEach((el) => {
            if (!el) return;
            el.style.setProperty('--px', '0px');
            el.style.setProperty('--py', '0px');
            el.style.setProperty('--rx', '0deg');
            el.style.setProperty('--ry', '0deg');
          });
        });
      }

      // Scroll parallax on backdrop image
      const atmos = studio.querySelector('.studio__atmos img');
      if (atmos) {
        let ticking = false;
        const update = () => {
          const r = studio.getBoundingClientRect();
          const vh = window.innerHeight;
          if (r.bottom < 0 || r.top > vh) {
            ticking = false;
            return;
          }
          const center = r.top + r.height / 2;
          const ratio = (center - vh / 2) / vh;
          const shift = Math.max(-30, Math.min(30, ratio * -40));
          atmos.style.setProperty('--sy', shift + 'px');
          ticking = false;
        };
        window.addEventListener(
          'scroll',
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
          },
          { passive: true },
        );
        update();
      }
    }
  })();
</script>
