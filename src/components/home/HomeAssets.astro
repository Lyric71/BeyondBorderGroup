  }

  .hww-how {
    max-width: 1000px;
    margin: var(--space-8) auto 0;
  }
  .hww-how__title {
    margin: 0 0 var(--space-5);
    font-size: var(--fs-h4);
    font-weight: 600;
    color: var(--bbg-ink);
    text-align: center;
  }
  .hww-how__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .hww-how__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--space-4);
    border-radius: 12px;
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    color: var(--bbg-blue);
  }
  .hww-how__icon svg {
    width: 20px;
    height: 20px;
  }
  .hww-how__item-title {
    margin: 0 0 var(--space-2);
    font-size: 1.0625rem;
