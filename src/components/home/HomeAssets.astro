    .hww-how__item {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      column-gap: var(--space-4);
    }
    .hww-how__icon {
      grid-row: span 2;
      margin-bottom: 0;
    }
    .hww-foot {
      flex-direction: column;
      align-items: flex-start;
      max-width: 560px;
    }
