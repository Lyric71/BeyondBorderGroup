<style is:global>
  /* ---------- Home hero: reveal motion ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .home-reveal {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
        transform 700ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms);
    }
    .home-reveal.is-in {
      opacity: 1;
      transform: translateY(0);
    }
    .home-magnetic {
      will-change: transform;
      transition:
        transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
        box-shadow 220ms ease,
        background-color 200ms ease,
        color 200ms ease;
    }
    .home-magnetic:hover {
      transform: translateY(-2px);
    }
  }

  /* ---------- Scroll progress bar ---------- */
  .home-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 1000;
    background: transparent;
    pointer-events: none;
  }
  .home-progress__bar {
    height: 100%;
    width: var(--progress, 0%);
    background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 60%, #c8102e 100%);
    box-shadow: 0 0 12px rgba(200, 16, 46, 0.55);
    transition: width 80ms linear;
  }

  /* ---------- Home hero ---------- */
  .home-hero {
    position: relative;
    min-height: clamp(520px, 78vh, 760px);
    display: flex;
    align-items: flex-start;
    padding: clamp(8px, 1.25vh, 16px) 0 clamp(64px, 9vh, 104px);
    color: var(--bbg-white);
    overflow: hidden;
    isolation: isolate;
  }
  /* Override the global :has(.home-hero) padding-top with a tighter value */
  body:has(.home-hero) .home-hero {
    padding-top: clamp(140px, 14vh, 184px);
  }
  @media (max-width: 1024px) {
    body:has(.home-hero) .home-hero {
      padding-top: clamp(112px, 12vh, 140px);
    }
  }
  .home-hero__bg {
    position: absolute;
    inset: -10% 0 0;
    z-index: -3;
  }
  .home-hero__bg picture,
  .home-hero__bg img {
    display: block;
    width: 100%;
    height: 110%;
    object-fit: cover;
    object-position: center;
  }
  .home-hero__bg img {
    transform: translate3d(0, var(--parallax-y, 0px), 0) scale(1.04);
    transition: transform 80ms linear;
    filter: saturate(0.95);
  }
  .home-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(
        110deg,
        rgba(8, 18, 28, 0.92) 0%,
        rgba(8, 18, 28, 0.72) 42%,
        rgba(8, 18, 28, 0.32) 100%
      ),
      radial-gradient(120% 80% at 0% 100%, rgba(200, 16, 46, 0.28) 0%, rgba(200, 16, 46, 0) 60%);
  }
  .home-hero__grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 3px 3px;
    mix-blend-mode: overlay;
    opacity: 0.45;
    pointer-events: none;
  }
  .home-hero__inner {
    max-width: 980px;
    position: relative;
  }
  .home-hero__inner .eyebrow--on-dark {
    display: inline-block;
    margin-bottom: var(--space-3);
    color: #c8102e;
  }
  .home-hero__title {
    font-size: clamp(2.25rem, 4vw + 1rem, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--bbg-white);
    margin: 0 0 var(--space-4);
    max-width: 18ch;
    font-weight: 700;
    display: flex;
    flex-direction: column;
    gap: 0.05em;
  }
  .home-hero__title-row {
    display: block;
  }
  .home-hero__title-row--accent {
    color: #c8102e;
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.018em;
  }
  .home-hero__title-row--highlight {
    position: relative;
    display: inline-block;
    align-self: flex-start;
    padding: 0 0.15em;
  }
  .home-hero__title-row--highlight::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.18em;
    background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 100%);
    border-radius: 2px;
    transform-origin: left center;
    animation: home-underline 900ms cubic-bezier(0.16, 1, 0.3, 1) 600ms both;
    z-index: -1;
  }
  @keyframes home-underline {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .home-hero__lead {
    font-size: clamp(1.0625rem, 0.5vw + 1rem, 1.25rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.86);
    max-width: 58ch;
    margin: 0 0 var(--space-5);
  }
  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .home-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(var(--space-4), 4vw, var(--space-7));
    padding-top: var(--space-5);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    max-width: 760px;
  }
  .home-hero__meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .home-hero__meta-num {
    font-size: clamp(1.625rem, 1.2vw + 1rem, 2.125rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--bbg-white);
    font-feature-settings: 'tnum';
  }
  .home-hero__meta-label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.66);
    letter-spacing: 0.02em;
  }

  .home-hero__scroll {
    position: absolute;
    bottom: var(--space-5);
    right: clamp(var(--space-5), 4vw, var(--space-7));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    transition: color 200ms ease;
  }
  .home-hero__scroll:hover {
    color: var(--bbg-white);
  }
  .home-hero__scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.6) 100%);
    position: relative;
    overflow: hidden;
  }
  .home-hero__scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(180deg, transparent 0%, var(--bbg-white) 100%);
    animation: home-scroll-tick 1.8s ease-in-out infinite;
  }
  @keyframes home-scroll-tick {
    0% {
      top: -50%;
    }
    100% {
      top: 100%;
    }
  }
  @media (max-width: 720px) {
    .home-hero__scroll {
      display: none;
    }
    .home-hero__meta {
      gap: var(--space-4);
    }
  }

  /* ---------- Home hero: two slides, autoplay every 5s ----------
     Slides share one grid cell, so the hero takes the taller slide's height
     and nothing shifts on switch. Each slide isolates its own backdrop, which
     is positioned against the hero itself. Autoplay is a user-requested
     exception to the house motion rule. */
  .home-hero--slider {
    flex-direction: column;
  }
  .home-hero__slides {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
  }
  .home-hero__slide {
    grid-area: 1 / 1;
    min-width: 0;
    isolation: isolate;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 500ms ease,
      visibility 0s linear 500ms;
  }
  .home-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 500ms ease,
      visibility 0s;
  }
  /* Replay the underline each time a slide comes in. */
  .home-hero__slide:not(.is-active) .home-hero__title-row--highlight::before {
    animation: none;
    transform: scaleX(0);
  }
  .home-hero__switch-wrap {
    /* Above the slides: each slide is its own stacking context and its
       backdrop covers the whole hero. */
    position: relative;
    z-index: 1;
    max-width: 980px;
    margin: var(--space-6) auto 0;
  }
  .home-hero__switch {
    display: flex;
    gap: var(--space-4);
  }
  .home-hero__tab {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 180px;
    padding: 0 0 0.25rem;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    color: rgba(255, 255, 255, 0.6);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 200ms ease;
  }
  .home-hero__tab:hover,
  .home-hero__tab.is-active {
    color: var(--bbg-white);
  }
  .home-hero__tab:focus-visible {
    outline: 3px solid var(--bbg-blue);
    outline-offset: 4px;
  }
  .home-hero__tab-bar {
    position: relative;
    display: block;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.22);
    overflow: hidden;
  }
  .home-hero__tab-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #c8102e;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .home-hero__tab.is-active .home-hero__tab-bar::after {
    transform: scaleX(1);
  }
  /* While autoplay runs, the active bar fills over the interval instead. */
  .home-hero--slider.is-auto .home-hero__tab.is-active .home-hero__tab-bar::after {
    transition: none;
    animation: home-hero-progress var(--hero-interval, 5000ms) linear forwards;
  }
  @keyframes home-hero-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (max-width: 720px) {
    .home-hero__switch-wrap {
      margin-top: var(--space-5);
    }
    .home-hero__tab {
      width: auto;
      flex: 1 1 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-hero__slide,
    .home-hero__slide.is-active,
    .home-hero__tab-bar::after {
      transition: none;
    }
  }

  /* ---------- How we work ---------- */
  .hww-head {
    max-width: 780px;
    margin: 0 auto var(--space-7);
    text-align: center;
  }
  .hww-head__title {
    margin: 0 0 var(--space-4);
    text-wrap: balance;
  }
  .hww-head__lead {
    margin: 0 auto;
    max-width: 660px;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--bbg-text);
  }

  .hww-compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    max-width: 1000px;
    margin: 0 auto;
    align-items: stretch;
  }
  .hww-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3vw, 40px);
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-lg);
  }
  .hww-card--fit {
    border: 2px solid var(--bbg-blue);
    box-shadow: 0 24px 48px -24px rgba(200, 16, 46, 0.35);
  }
  .hww-card__tag {
    align-self: flex-start;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bbg-text-muted);
    margin-bottom: var(--space-3);
  }
  .hww-card--fit .hww-card__tag {
    color: var(--bbg-blue);
  }
  .hww-card__title {
    margin: 0 0 var(--space-5);
    font-size: var(--fs-h3);
    line-height: 1.25;
    color: var(--bbg-ink);
  }
  .hww-card__points {
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .hww-card__point {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--bbg-text);
  }
  .hww-card__point .hww-sr {
    grid-column: 1;
  }
  .hww-card__mark {
    display: grid;
    place-items: center;
    width: 24px;
