  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector('.hw');
      if (!root) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const $ = (s, el = root) => el.querySelector(s);
      const $$ = (s, el = root) => Array.from(el.querySelectorAll(s));
      const clamp = (v, a, b) => Math.min(b, Math.max(a, v));

      /* ---- Reveal on scroll ---- */
      const onReveal = new Map();
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('is-in');
            const fn = onReveal.get(e.target);
            if (fn) fn();
            io.unobserve(e.target);
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
      );
      $$('.hw-reveal, [data-journey], [data-chart]').forEach((el) => io.observe(el));

      /* ---- Hero: counters + check card ---- */
      const counters = $$('[data-count]');
      const runCounters = () => {
        counters.forEach((el) => {
          const end = +el.dataset.count;
          const suffix = el.dataset.suffix || '';
          if (reduce) return;
          const t0 = performance.now();
          const dur = 1400;
          const tick = (t) => {
            const p = clamp((t - t0) / dur, 0, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(end * eased) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      };
      const proof = $('[data-proof]');
      if (proof) onReveal.set(proof, runCounters);

      const card = $('[data-checkcard]');
      if (card) {
        const rows = $$('.hw-checkcard__row', card);
        // The store row lights first, then the two that matter.
        const order = [2, 0, 1];
        const start = () =>
          order.forEach((idx, n) => setTimeout(() => rows[idx] && rows[idx].classList.add('is-on'), reduce ? 0 : 700 + n * 550));
        const cardIo = new IntersectionObserver((es) => {
          if (es[0].isIntersecting) {
            start();
            cardIo.disconnect();
          }
        });
        cardIo.observe(card);
      }

      /* ---- Sticky subnav: offset under the site header + scrollspy ---- */
      const subnav = $('[data-subnav]');
      const track = $('[data-subnav-track]');
      const pill = $('[data-subnav-pill]');
      const links = $$('[data-subnav-link]');
      const sectionsEls = $$('[data-section]');
      const siteNav = document.getElementById('site-nav');
      let activeId = null;

      const setActiveLink = (id) => {
        if (id === activeId) return;
        activeId = id;
        links.forEach((a) => a.classList.toggle('is-active', a.dataset.subnavLink === id));
        const a = links.find((l) => l.dataset.subnavLink === id);
        if (!a || !pill) {
          pill && pill.classList.remove('is-on');
          return;
        }
        pill.style.width = a.offsetWidth + 'px';
        pill.style.transform = `translateX(${a.offsetLeft}px)`;
        pill.classList.add('is-on');
        const target = a.offsetLeft - track.clientWidth / 2 + a.offsetWidth / 2;
        track.scrollTo({ left: target, behavior: reduce ? 'auto' : 'smooth' });
      };

      /* ---- Why story ---- */
      const story = $('[data-story]');
      const storySteps = $$('[data-story-step]');
      const storyImgs = $$('[data-story-img]');
      const storyDots = $$('[data-story-dot]');
      let storyIdx = 0;
      const setStory = (i) => {
        if (i === storyIdx) return;
        storyIdx = i;
        storySteps.forEach((s, n) => s.classList.toggle('is-active', n === i));
        storyImgs.forEach((s, n) => s.classList.toggle('is-active', n === i));
        storyDots.forEach((d, n) => {
          d.classList.toggle('is-active', n === i);
          d.classList.toggle('is-done', n < i);
        });
      };

      /* ---- Verdict words ---- */
      const verdict = $('[data-verdict]');
      const words = verdict ? $$('.hw-verdict__w', verdict) : [];

      /* ---- Timeline ---- */
      const tl = $('[data-timeline]');
      const tlFill = $('[data-tl-fill]');
      const tlItems = $$('[data-tl-item]');

      /* ---- Hero parallax ---- */
      const parallax = $('[data-parallax]');

      let ticking = false;
      const onScroll = () => {
        ticking = false;
        const vh = window.innerHeight;

        // Keep the subnav tucked right under the site header when it shows.
        if (siteNav && subnav) {
          const bar = siteNav.querySelector('.nav__bar');
          const bottom = bar ? Math.max(0, bar.getBoundingClientRect().bottom) : 0;
          root.style.setProperty('--hw-subnav-top', Math.round(bottom) + 'px');
        }

        // Scrollspy
        if (subnav) {
          const line = subnav.getBoundingClientRect().bottom + 80;
          let current = null;
          sectionsEls.forEach((s) => {
            const r = s.getBoundingClientRect();
            if (r.top <= line && r.bottom > line) current = s.id;
          });
          setActiveLink(current);
        }

        // Story
        if (story && storySteps.length && window.innerWidth > 900) {
          const mid = vh * 0.5;
          let best = 0;
          let bestD = Infinity;
          storySteps.forEach((s, n) => {
            const r = s.getBoundingClientRect();
            const d = Math.abs(r.top + r.height / 2 - mid);
            if (d < bestD) {
              bestD = d;
              best = n;
            }
          });
          setStory(best);
        }

        // Verdict
        if (verdict && words.length && !reduce) {
          const r = verdict.getBoundingClientRect();
          const p = clamp((vh * 0.9 - r.top) / (vh * 0.5), 0, 1);
          const lit = Math.round(p * words.length);
          words.forEach((w, n) => w.classList.toggle('is-lit', n < lit));
        }

        // Timeline
        if (tl && tlFill) {
          const r = tl.getBoundingClientRect();
          const p = clamp((vh * 0.6 - r.top) / r.height, 0, 1);
          tlFill.style.setProperty('--tl', reduce ? 1 : p);
          tlItems.forEach((it) => {
            const dot = it.querySelector('.hw-tl__dot').getBoundingClientRect();
            it.classList.toggle('is-active', dot.top + dot.height / 2 < vh * 0.6);
          });
        }

        // Parallax
        if (parallax && !reduce) {
          const r = parallax.parentElement.getBoundingClientRect();
          if (r.bottom > 0 && r.top < vh) {
            const p = (r.top + r.height / 2 - vh / 2) / vh;
            parallax.style.transform = `translate3d(0, ${(-6 + p * 10).toFixed(2)}%, 0)`;
          }
        }
      };
      const requestTick = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      };
      window.addEventListener('scroll', requestTick, { passive: true });
      window.addEventListener('resize', () => {
        activeId = null;
        requestTick();
        drawMap();
      });
      if (!reduce && tlFill) tlFill.style.setProperty('--tl', 0);
      requestTick();

      /* ---- Map (who sits where) ---- */
      const map = $('[data-map]');
      const stage = $('[data-map-stage]');
      const svg = $('[data-map-lines]');
      const nodes = $$('[data-node]');
      const links2 = [
        ['you', 'us'],
        ['us', 'tp'],
        ['us', 'logistics'],
        ['us', 'online'],
        ['us', 'offline'],
      ].filter(([a, b]) => [a, b].every((k) => nodes.some((n) => n.dataset.node === k)));
      const NS = 'http://www.w3.org/2000/svg';

      function drawMap() {
        if (!stage || !svg || getComputedStyle(stage).display === 'none') return;
        const s = stage.getBoundingClientRect();
        svg.setAttribute('viewBox', `0 0 ${s.width} ${s.height}`);
        svg.innerHTML = '';
        const box = (key) => {
          const el = nodes.find((n) => n.dataset.node === key);
          const r = el.getBoundingClientRect();
          return { l: r.left - s.left, r: r.right - s.left, t: r.top - s.top, b: r.bottom - s.top, cx: r.left - s.left + r.width / 2, cy: r.top - s.top + r.height / 2 };
        };
        links2.forEach(([a, b]) => {
          const A = box(a);
          const B = box(b);
          let d;
          if (a === 'you') {
            d = `M ${A.cx} ${A.b} L ${B.cx} ${B.t}`;
          } else {
            const dx = (B.l - A.r) / 2;
            d = `M ${A.r} ${A.cy} C ${A.r + dx} ${A.cy}, ${B.l - dx} ${B.cy}, ${B.l} ${B.cy}`;
          }
          const p = document.createElementNS(NS, 'path');
          p.setAttribute('d', d);
          p.setAttribute('class', 'hw-map__line is-active');
          p.dataset.a = a;
          p.dataset.b = b;
          svg.appendChild(p);
        });
      }
      if (map) {
        drawMap();
        if ('ResizeObserver' in window) new ResizeObserver(drawMap).observe(stage);
      }

      /* ---- TP / DP segmented toggle ---- */
      const tpdp = $('[data-tpdp]');
      if (tpdp) {
        const btns = $$('[data-mode-btn]', tpdp);
        const sums = $$('[data-sum]', tpdp);
        const setMode = (m, focus) => {
          tpdp.dataset.mode = m;
          btns.forEach((b) => {
            const on = b.dataset.modeBtn === m;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-selected', on ? 'true' : 'false');
            b.tabIndex = on ? 0 : -1;
            if (on && focus) b.focus();
          });
          sums.forEach((s) => s.classList.toggle('is-active', s.dataset.sum === m));
        };
        btns.forEach((b) => {
          b.addEventListener('click', () => setMode(b.dataset.modeBtn));
          b.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
              e.preventDefault();
              setMode(b.dataset.modeBtn === 'tp' ? 'dp' : 'tp', true);
            }
          });
        });
        setMode('tp');
      }

      /* ---- Chart: cut the ad budget ---- */
      const chart = $('[data-chart]');
      if (chart) {
        const btn = $('[data-chart-toggle]', chart);
        const label = $('[data-chart-label]', chart);
        const lineA = $('[data-line="a"]', chart);
        const lineB = $('[data-line="b"]', chart);
        const areaA = $('[data-area="a"]', chart);
        const areaB = $('[data-area="b"]', chart);
        const on = {
          a: [22, 28, 34, 40, 46, 52, 58, 63, 68, 72, 76, 80, 84],
          b: [30, 35, 41, 47, 53, 59, 64, 69, 73, 77, 81, 84, 87],
        };
        const off = {
          a: [22, 28, 34, 40, 46, 52, 58, 36, 22, 16, 14, 13, 12],
          b: [30, 35, 41, 47, 53, 59, 64, 61, 60, 61, 63, 64, 66],
        };
        const X = (i) => 40 + i * 45;
        const Y = (v) => 220 - v * 1.8;
        const toPath = (vals) => {
          const pts = vals.map((v, i) => [X(i), Y(v)]);
          let d = `M ${pts[0][0]} ${pts[0][1]}`;
          for (let i = 0; i < pts.length - 1; i++) {
            const p0 = pts[i - 1] || pts[i];
            const p1 = pts[i];
            const p2 = pts[i + 1];
            const p3 = pts[i + 2] || p2;
            const c1x = p1[0] + (p2[0] - p0[0]) / 6;
            const c1y = p1[1] + (p2[1] - p0[1]) / 6;
            const c2x = p2[0] - (p3[0] - p1[0]) / 6;
            const c2y = p2[1] - (p3[1] - p1[1]) / 6;
            d += ` C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2[0]} ${p2[1].toFixed(1)}`;
          }
          return d;
        };
        const area = (d) => `${d} L ${X(12)} 220 L ${X(0)} 220 Z`;
        let cur = { a: on.a.slice(), b: on.b.slice() };
        const render = () => {
          const da = toPath(cur.a);
          const db = toPath(cur.b);
          lineA.setAttribute('d', da);
          lineB.setAttribute('d', db);
          areaA.setAttribute('d', area(da));
          areaB.setAttribute('d', area(db));
        };
        render();

        // Draw the lines in the first time the card is seen.
        const drawIn = () => {
          if (reduce) return;
          [lineA, lineB].forEach((l, n) => {
            const len = l.getTotalLength();
            l.style.strokeDasharray = len;
            l.style.strokeDashoffset = len;
            l.getBoundingClientRect();
            l.style.transition = `stroke-dashoffset 1600ms cubic-bezier(.22,1,.36,1) ${n * 200}ms`;
            l.style.strokeDashoffset = 0;
            setTimeout(() => {
              l.style.strokeDasharray = '';
              l.style.transition = '';
            }, 2000);
          });
        };
        onReveal.set(chart, drawIn);

        let raf = 0;
        const animateTo = (target) => {
          cancelAnimationFrame(raf);
          const from = { a: cur.a.slice(), b: cur.b.slice() };
          const t0 = performance.now();
          const dur = reduce ? 1 : 900;
          const step = (t) => {
            const p = clamp((t - t0) / dur, 0, 1);
            const e = 1 - Math.pow(1 - p, 3);
            cur.a = from.a.map((v, i) => v + (target.a[i] - v) * e);
            cur.b = from.b.map((v, i) => v + (target.b[i] - v) * e);
            render();
            if (p < 1) raf = requestAnimationFrame(step);
          };
          raf = requestAnimationFrame(step);
        };
        btn.addEventListener('click', () => {
          const cut = btn.getAttribute('aria-pressed') !== 'true';
          btn.setAttribute('aria-pressed', cut ? 'true' : 'false');
          label.textContent = cut ? btn.dataset.labelRestore : btn.dataset.labelCut;
          chart.classList.toggle('is-cut', cut);
          animateTo(cut ? off : on);
        });
      }

      /* ---- Pitch checklist ---- */
      const pitch = $('[data-pitch]');
      if (pitch) {
        const items = $$('[data-check]', pitch);
        const ring = $('[data-ring]', pitch);
        const status = $('[data-status]', pitch);
        const C = 2 * Math.PI * 27;
        const update = () => {
          const n = items.filter((b) => b.getAttribute('aria-checked') === 'true').length;
          ring.style.strokeDashoffset = C * (1 - n / items.length);
          status.textContent =
            n === 0
              ? pitch.dataset.statusNone
              : n < items.length
                ? pitch.dataset.statusSome
                : pitch.dataset.statusAll;
          pitch.classList.toggle('is-complete', n === items.length);
          pitch.classList.toggle('has-any', n > 0);
        };
        items.forEach((b) =>
          b.addEventListener('click', () => {
            b.setAttribute('aria-checked', b.getAttribute('aria-checked') === 'true' ? 'false' : 'true');
            update();
          }),
        );
        update();
      }

      /* ---- Who does what: filter ---- */
      const raci = $('[data-raci]');
      if (raci) {
        const btns = $$('[data-filter-btn]', raci);
        const rows = $$('[data-roles]', raci);
        btns.forEach((b) =>
          b.addEventListener('click', () => {
            const f = b.dataset.filterBtn;
            raci.dataset.filter = f;
            btns.forEach((x) => {
              const on = x === b;
              x.classList.toggle('is-active', on);
              x.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
            rows.forEach((r) => r.classList.toggle('is-dim', f !== 'all' && !r.dataset.roles.split(' ').includes(f)));
          }),
        );
      }

      /* ---- Spotlight cards + gentle tilt ---- */
      if (!reduce && window.matchMedia('(hover: hover)').matches) {
        $$('.hw-spot').forEach((el) =>
          el.addEventListener('pointermove', (e) => {
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', e.clientX - r.left + 'px');
            el.style.setProperty('--my', e.clientY - r.top + 'px');
          }),
        );
        $$('.hw-tilt').forEach((el) => {
          el.addEventListener('pointermove', (e) => {
            if (!el.classList.contains('is-in')) return;
            const r = el.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            el.style.transform = `perspective(900px) rotateX(${(-y * 3).toFixed(2)}deg) rotateY(${(x * 4).toFixed(2)}deg) translateY(-3px)`;
          });
          el.addEventListener('pointerleave', () => {
            el.style.transform = '';
          });
        });
        const cta = $('[data-cta]');
        if (cta) {
          cta.addEventListener('pointermove', (e) => {
            const r = cta.getBoundingClientRect();
            cta.style.setProperty('--gx', ((e.clientX - r.left) / r.width) * 100 + '%');
            cta.style.setProperty('--gy', ((e.clientY - r.top) / r.height) * 100 + '%');
          });
        }
      }

      /* ---- FAQ accordion ---- */
      $$('[data-faq-btn]').forEach((b) =>
        b.addEventListener('click', () => {
          const open = b.getAttribute('aria-expanded') !== 'true';
          b.setAttribute('aria-expanded', open ? 'true' : 'false');
          const panel = document.getElementById(b.getAttribute('aria-controls'));
          if (panel) panel.classList.toggle('is-open', open);
        }),
      );
    })();
  </script>
</Layout>
