---
/**
 * Where we stand and what we handle, channel by channel. Renders the `stance`,
 * `supportLabel` and `scope` blocks of the How we work copy, plus the parties
 * they reference. Used under the map on How we work (dark) and in the home
 * page's How we work section (light).
 */
import type { HowWeWorkCopy, Party } from '../../i18n/how-we-work/en';
import { icons } from './icons';

interface Props {
  role: HowWeWorkCopy['role'];
  tone?: 'dark' | 'light';
  showStance?: boolean;
  showSupport?: boolean;
  /** One tab per channel instead of stacking every row. */
  tabbed?: boolean;
  /** Drop the block's own kicker and title when the host section heading already says it. */
  hideHead?: boolean;
  /** Use each channel's short copy (`summary`, `valueShort`, sow `brief`). */
  compact?: boolean;
}

const {
  role,
  tone = 'dark',
  showStance = true,
  showSupport = true,
  tabbed = false,
  hideHead = false,
  compact = false,
} = Astro.props;
const uid = `scope-${tone}-${Math.random().toString(36).slice(2, 8)}`;

type Key = 'you' | 'us' | 'tp' | 'logistics' | 'online' | 'offline';
const partyIcons: Record<Key, string> = {
  you: 'tag',
  us: 'handshake',
  tp: 'store',
  logistics: 'truck',
  online: 'cart',
  offline: 'building',
};
const withIcon = (keys: Key[]) =>
  keys.flatMap((key) => {
    const p: Party | undefined = role.parties[key];
    return p ? [{ key, icon: partyIcons[key], ...p }] : [];
  });

const support = withIcon(['you', 'logistics']);
const rows = role.scope?.channels ?? [];
---

<div class:list={['hw-scope', `hw-scope--${tone}`, { 'is-compact': compact }]}>
  {
    showStance && role.stance && (
      <div class="hw-scope__stance">
        <span class="hw-scope__stanceicon" aria-hidden="true" set:html={icons.handshake} />
        <div>
          <span class="hw-scope__kicker">{role.stance.label}</span>
          <h3>{role.stance.title}</h3>
          <p>{role.stance.body}</p>
          <ul class="hw-scope__points">
            {role.stance.points.map((pt) => (
              <li>
                <span aria-hidden="true" set:html={icons.check} />
                {pt}
              </li>
            ))}
          </ul>
        </div>
      </div>
    )
  }

  {
    showSupport && support.length > 0 && (
      <div class="hw-scope__support">
        <span class="hw-scope__kicker">{role.supportLabel}</span>
        <div class="hw-scope__supportgrid">
          {support.map((p) => (
            <div class="hw-scope__supportcard" id={`party-${p.key}`}>
              <span class="hw-scope__rowicon" aria-hidden="true" set:html={icons[p.icon]} />
              <div>
                <h4>{p.name}</h4>
                <p>{p.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  {
    role.scope && (
      <div class:list={['hw-scope__channels', { 'is-tabbed': tabbed }]} data-scope-tabs={tabbed ? '' : undefined}>
        <div class="hw-scope__channelshead">
          {!hideHead && (
            <>
              <span class="hw-scope__kicker">{role.scope.label}</span>
              <h3>{role.scope.title}</h3>
            </>
          )}
          {tabbed && (
            <div class="hw-scope__tabs" role="tablist" aria-label={role.scope.title}>
              {rows.map((p, i) => (
                <button
                  type="button"
                  class="hw-scope__tab"
                  role="tab"
                  id={`${uid}-tab-${p.key}`}
                  aria-controls={`${uid}-panel-${p.key}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-scope-tab
                >
                  <span class="hw-scope__tabicon" aria-hidden="true" set:html={icons[p.icon]} />
                  {p.tab ?? p.name}
                </button>
              ))}
            </div>
          )}
        </div>
        {rows.map((p, i) => (
          <article
            class="hw-scope__row"
            id={tabbed ? `${uid}-panel-${p.key}` : `channel-${p.key}`}
            role={tabbed ? 'tabpanel' : undefined}
            aria-labelledby={tabbed ? `${uid}-tab-${p.key}` : undefined}
            hidden={tabbed && i > 0}
            data-scope-panel={tabbed ? '' : undefined}
          >
            <div class="hw-scope__who">
              <span class="hw-scope__rowicon" aria-hidden="true" set:html={icons[p.icon]} />
              <div>
                <h4>{p.name}</h4>
                {p.hint && <span class="hw-scope__hint">{p.hint}</span>}
                <p>{compact ? (p.summary ?? p.body) : p.body}</p>
              </div>
            </div>
            <div class="hw-scope__value">
              <span class="hw-scope__collabel">{role.scope!.colValue}</span>
              <p>{compact ? (p.valueShort ?? p.value) : p.value}</p>
            </div>
            <div class="hw-scope__sow">
              <span class="hw-scope__collabel">{role.scope!.sowLabel}</span>
              <div class="hw-scope__sowgrid">
                {p.sow.map((col) => (
                  <div class:list={['hw-scope__sowcol', { 'is-us': col.us }]}>
                    <h5>{col.who}</h5>
                    <ul>
                      {(compact ? (col.brief ?? col.items) : col.items).map((item) => (
                        <li>
                          <span aria-hidden="true" set:html={icons.check} />
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    )
  }
</div>

<style is:global>
  .hw-scope {
    --s-accent: #ff3b5c;
    --s-accent-text: #ff6b84;
    --s-ink: #ffffff;
    --s-text: rgba(255, 255, 255, 0.75);
    --s-strong: rgba(255, 255, 255, 0.88);
    --s-muted: rgba(255, 255, 255, 0.55);
    --s-card: rgba(255, 255, 255, 0.04);
    --s-border: rgba(255, 255, 255, 0.12);
    --s-divider: rgba(255, 255, 255, 0.08);
    --s-icon-bg: rgba(255, 255, 255, 0.08);
    --s-pill-bg: rgba(255, 255, 255, 0.08);
    --s-pill-border: rgba(255, 255, 255, 0.16);
    --s-stance-bg: linear-gradient(135deg, rgba(200, 16, 46, 0.3), rgba(200, 16, 46, 0.08));
    --s-stance-border: rgba(255, 59, 92, 0.55);
    --s-stance-text: rgba(255, 255, 255, 0.85);
    --s-value-bg: rgba(200, 16, 46, 0.14);
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    margin-top: 2.5rem;
  }
  .hw-scope--light {
    --s-accent: var(--bbg-blue);
    --s-accent-text: var(--bbg-blue);
    --s-ink: var(--bbg-ink);
    --s-text: var(--bbg-text);
    --s-strong: var(--bbg-ink);
    --s-muted: var(--bbg-text-muted);
    --s-card: var(--bbg-white);
    --s-border: var(--bbg-border);
    --s-divider: var(--bbg-border);
    --s-icon-bg: var(--bbg-blue-light);
    --s-pill-bg: var(--bbg-white);
    --s-pill-border: var(--bbg-border);
    --s-stance-bg: var(--bbg-white);
    --s-stance-border: var(--bbg-blue);
    --s-stance-text: var(--bbg-text);
    --s-value-bg: var(--bbg-blue-light);
    margin-top: 0;
  }
  .hw-scope__kicker,
  .hw-scope__collabel {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--s-accent-text);
  }
  .hw-scope__collabel {
    margin-bottom: 0.7rem;
    color: var(--s-muted);
  }
  .hw-scope h3 {
    font-size: clamp(1.35rem, 1vw + 1rem, 1.6rem);
    line-height: 1.25;
    color: var(--s-ink);
    margin: 0.4rem 0 0;
  }
  .hw-scope h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--s-ink);
    margin: 0;
  }
  .hw-scope p {
    line-height: 1.6;
    color: var(--s-text);
  }
  .hw-scope__stance {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 20px;
    background: var(--s-stance-bg);
    border: 1px solid var(--s-stance-border);
  }
  .hw-scope__stance p {
    max-width: 70ch;
    margin-top: 0.6rem;
    color: var(--s-stance-text);
  }
  .hw-scope__stanceicon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 16px;
    background: var(--bbg-blue);
    color: #fff;
  }
  .hw-scope__stanceicon svg {
    width: 28px;
    height: 28px;
  }
  .hw-scope__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hw-scope__points li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: var(--s-pill-bg);
    border: 1px solid var(--s-pill-border);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--s-ink);
  }
  .hw-scope__points li span,
  .hw-scope__do li span {
    display: inline-flex;
    flex-shrink: 0;
    width: 15px;
    height: 15px;
    color: var(--s-accent-text);
  }
  .hw-scope__points li span svg,
  .hw-scope__do li span svg {
    width: 100%;
    height: 100%;
  }
  .hw-scope__supportgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 0.8rem;
  }
  .hw-scope__supportcard {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem 1.25rem;
    border-radius: 16px;
    background: var(--s-card);
    border: 1px solid var(--s-border);
  }
  .hw-scope__supportcard p {
    margin-top: 0.3rem;
    font-size: 0.95rem;
  }
  .hw-scope__rowicon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--s-icon-bg);
    color: var(--s-accent-text);
  }
  .hw-scope__rowicon svg {
    width: 21px;
    height: 21px;
  }
  .hw-scope__channels {
    border-radius: 20px;
    background: var(--s-card);
    border: 1px solid var(--s-border);
    overflow: hidden;
  }
  .hw-scope--light .hw-scope__channels {
    box-shadow: 0 24px 60px -40px rgba(0, 0, 0, 0.25);
  }
  .hw-scope__channelshead {
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--s-border);
  }
  .hw-scope__row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    grid-template-areas:
      'who value'
      'sow sow';
    gap: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--s-divider);
  }
  .hw-scope.is-compact .hw-scope__row {
    align-items: center;
  }
  .hw-scope.is-compact .hw-scope__value {
    padding: 0.8rem 1rem;
  }
  .hw-scope.is-compact .hw-scope__value p {
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .hw-scope__row > .hw-scope__who {
    grid-area: who;
  }
  .hw-scope__row > .hw-scope__value {
    grid-area: value;
  }
  .hw-scope__row > .hw-scope__sow {
    grid-area: sow;
  }
  .hw-scope__sowgrid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 0.75rem;
  }
  .hw-scope__sowcol {
    padding: 1rem 1.1rem;
    border-radius: 14px;
    border: 1px solid var(--s-border);
  }
  .hw-scope__sowcol.is-us {
    border-color: var(--s-accent);
    background: var(--s-value-bg);
  }
  .hw-scope h5 {
    margin: 0 0 0.7rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--s-ink);
  }
  .hw-scope__sowcol.is-us h5 {
    color: var(--s-accent-text);
  }
  .hw-scope__sowcol ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hw-scope__sowcol li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--s-strong);
  }
  .hw-scope__sowcol li span {
    display: inline-flex;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin-top: 0.25rem;
    color: var(--s-accent-text);
  }
  .hw-scope__sowcol li span svg {
    width: 100%;
    height: 100%;
  }
  .hw-scope__row:last-child {
    border-bottom: none;
  }
  .hw-scope__who {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .hw-scope__who p {
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }
  .hw-scope__hint {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--s-muted);
  }
  .hw-scope__do ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hw-scope__do li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--s-strong);
  }
  .hw-scope__do li span {
    margin-top: 0.25rem;
  }
  .hw-scope__value {
    align-self: start;
    padding: 1rem 1.1rem;
    border-radius: 14px;
    background: var(--s-value-bg);
    border-left: 3px solid var(--s-accent);
  }
  .hw-scope__value p {
    font-weight: 600;
    color: var(--s-ink);
  }
  .hw-scope__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .hw-scope__tabs:first-child {
    margin-top: 0;
  }
  .hw-scope__channels.is-tabbed .hw-scope__tabs {
    justify-content: center;
  }
  .hw-scope__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem 0.55rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--s-border);
    background: transparent;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--s-ink);
    cursor: pointer;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }
  .hw-scope__tab:hover {
    border-color: var(--s-accent);
  }
  .hw-scope__tab:focus-visible {
    outline: 3px solid var(--s-accent);
    outline-offset: 2px;
  }
  .hw-scope__tab[aria-selected='true'] {
    background: var(--bbg-blue);
    border-color: var(--bbg-blue);
    color: #fff;
  }
  .hw-scope__tabicon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    color: var(--s-accent-text);
  }
  .hw-scope__tab[aria-selected='true'] .hw-scope__tabicon {
    color: #fff;
  }
  .hw-scope__tabicon svg {
    width: 100%;
    height: 100%;
  }
  .hw-scope__channels.is-tabbed .hw-scope__row {
    border-bottom: none;
  }
  .hw-scope__row[hidden] {
    display: none;
  }
  .hw-scope__channels.is-tabbed .hw-scope__row:not([hidden]) {
    animation: hw-scope-in 300ms ease;
  }
  @keyframes hw-scope-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hw-scope__channels.is-tabbed .hw-scope__row:not([hidden]) {
      animation: none;
    }
  }
  @media (max-width: 960px) {
    .hw-scope__row {
      grid-template-columns: 1fr;
      grid-template-areas:
        'who'
        'value'
        'sow';
    }
  }
  @media (max-width: 760px) {
    .hw-scope__sowgrid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 820px) {
    .hw-scope {
      margin-top: 0;
    }
  }
  @media (max-width: 640px) {
    .hw-scope__stance {
      flex-direction: column;
    }
    .hw-scope__supportgrid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Tabbed variant: one channel at a time, arrow keys move between tabs.
  document.querySelectorAll<HTMLElement>('[data-scope-tabs]').forEach((box) => {
    const tabs = Array.from(box.querySelectorAll<HTMLButtonElement>('[data-scope-tab]'));
    const panels = Array.from(box.querySelectorAll<HTMLElement>('[data-scope-panel]'));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, n) => {
        const on = n === i;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p, n) => (p.hidden = n !== i));
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next =
          e.key === 'ArrowRight' ? (i === last ? 0 : i + 1)
          : e.key === 'ArrowLeft' ? (i === 0 ? last : i - 1)
          : e.key === 'Home' ? 0
          : e.key === 'End' ? last
          : -1;
        if (next < 0) return;
        e.preventDefault();
        select(next, true);
      });
    });
  });
</script>
