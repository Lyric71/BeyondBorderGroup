---
import { getLocaleFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { locales, localeLabels, localeNamesNative, type Locale } from '../i18n/ui';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => localizePath(path, locale);

const icon = {
  compass: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5.5-5.5 2 2-5.5z"/></svg>`,
  store: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9 5 4h14l1 5"/><path d="M5 9v11h14V9"/><path d="M9 20v-6h6v6"/><path d="M4 9h16"/></svg>`,
  truck: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h12v9H2z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>`,
  bag: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>`,
  chat: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-12 7l-5 1 1-4a8 8 0 1 1 16-4z"/><path d="M9 11h.01M12 11h.01M15 11h.01"/></svg>`,
  network: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M8 6h8M7 8l4 8M17 8l-4 8"/></svg>`,
  tag: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12V4h8l10 10-8 8z"/><circle cx="8" cy="9" r="1.5"/></svg>`,
  broadcast: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M16.5 7.5a6 6 0 0 1 0 9M7.5 7.5a6 6 0 0 0 0 9"/><path d="M19.5 4.5a10 10 0 0 1 0 15M4.5 4.5a10 10 0 0 0 0 15"/></svg>`,
  monitor: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="1"/><path d="M3 9h18"/><circle cx="6" cy="6.5" r=".5" fill="currentColor"/><circle cx="8" cy="6.5" r=".5" fill="currentColor"/><circle cx="10" cy="6.5" r=".5" fill="currentColor"/></svg>`,
  cap: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9 12 5l10 4-10 4z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/><path d="M22 9v5"/></svg>`,
  pin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-7-7-7-13a7 7 0 1 1 14 0c0 6-7 13-7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>`,
  bulb: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a6 6 0 0 0-4 10c1 1 1.5 2 1.5 3h5c0-1 .5-2 1.5-3a6 6 0 0 0-4-10z"/></svg>`,
  grid: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>`,
  camera: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h3l2-3h8l2 3h3v12H3z"/><circle cx="12" cy="13" r="4"/></svg>`,
  megaphone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4a1 1 0 0 0 1 1h2l9 5V4L6 9H4a1 1 0 0 0-1 1z"/><path d="M18 9a4 4 0 0 1 0 6"/><path d="M7 15v3a2 2 0 0 0 4 0v-2"/></svg>`,
  newspaper: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h14v14a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/><path d="M18 8h2v11a2 2 0 0 1-2 2"/><path d="M7 9h8M7 13h8M7 17h5"/></svg>`,
  globe: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18"/><path d="M12 3a14 14 0 0 0 0 18"/></svg>`,
};

const enterChina = [
  {
    label: t('nav.enter.marketEntry.label'),
    desc: t('nav.enter.marketEntry.desc'),
    href: lp('/enter-china/market-entry-consulting'),
    svg: icon.compass,
  },
  {
    label: t('nav.enter.crossBorder.label'),
    desc: t('nav.enter.crossBorder.desc'),
    href: lp('/enter-china/cross-border-setup'),
    svg: icon.store,
  },
  {
    label: t('nav.enter.distribution.label'),
    desc: t('nav.enter.distribution.desc'),
    href: lp('/enter-china/distribution'),
    svg: icon.truck,
  },
  {
    label: t('nav.enter.branding.label'),
    desc: t('nav.enter.branding.desc'),
    href: lp('/enter-china/branding-localisation'),
    svg: icon.tag,
  },
];

const enterChinaFeature = {
  label: 'Compass',
  desc: t('nav.feature.beyondcompass.desc'),
  href: 'https://compass.bearingbridge.com/en',
  logo: '/Images/AgencyLogos/Compass%20-%20Horizontal.svg',
};

const growChina = [
  {
    label: t('nav.grow.ecommerce.label'),
    desc: t('nav.grow.ecommerce.desc'),
    href: lp('/grow-in-china/cross-border-ecommerce'),
    svg: icon.bag,
  },
  {
    label: t('nav.grow.social.label'),
    desc: t('nav.grow.social.desc'),
    href: lp('/grow-in-china/social-commerce'),
    svg: icon.chat,
  },
  {
    label: t('nav.grow.campaigns.label'),
    desc: t('nav.grow.campaigns.desc'),
    href: lp('/grow-in-china/campaigns'),
    svg: icon.tag,
  },
  {
    label: t('nav.grow.media.label'),
    desc: t('nav.grow.media.desc'),
    href: lp('/grow-in-china/media'),
    svg: icon.broadcast,
  },
  {
    label: t('nav.grow.kols.label'),
    desc: t('nav.grow.kols.desc'),
    href: lp('/grow-in-china/influencers-kols'),
    svg: icon.megaphone,
  },
];

const growChinaFeature = {
  label: 'ChinaWebFoundry',
  desc: t('nav.feature.chinawebfoundry.desc'),
  href: 'https://chinawebfoundry.com',
  logo: '/Images/AgencyLogos/Logo-ChinaWebFoundry-transparent.webp',
};

const growChinaFeatureHub = {
  label: 'hubStudio',
  desc: t('nav.feature.hubstudio.desc'),
  href: 'https://hubstudio.ai',
  logo: '/Images/AgencyLogos/hubStudio%20(2).webp',
};

const learnChina = [
  {
    label: t('nav.learn.platforms.label'),
    desc: t('nav.learn.platforms.desc'),
    href: lp('/learn-china/platforms'),
    svg: icon.grid,
  },
  {
    label: t('nav.learn.masterclass.label'),
    desc: t('nav.learn.masterclass.desc'),
    href: lp('/learn-china/masterclass'),
    svg: icon.cap,
  },
  {
    label: t('nav.learn.expeditions.label'),
    desc: t('nav.learn.expeditions.desc'),
    href: lp('/learn-china/learning-expeditions'),
    svg: icon.pin,
  },
  {
    label: t('nav.learn.insights.label'),
    desc: t('nav.learn.insights.desc'),
    href: lp('/insights'),
    svg: icon.bulb,
  },
];

const sections = [
  {
    key: 'enter',
    label: t('nav.section.enter'),
    href: lp('/enter-china'),
    intro: t('nav.enter.intro'),
    items: enterChina,
  },
  {
    key: 'grow',
    label: t('nav.section.grow'),
    href: lp('/grow-in-china'),
    intro: t('nav.grow.intro'),
    items: growChina,
  },
  {
    key: 'learn',
    label: t('nav.section.learn'),
    href: lp('/learn-china'),
    intro: t('nav.learn.intro'),
    items: learnChina,
  },
];

// Country flags used by the language switcher. USA stands in for English;
// the other locales use their national flag. Inline SVG keeps the asset
// fast, China-safe (no external CDN), and crisp at any size.
const flags: Record<Locale, string> = {
  en: `<svg viewBox="0 0 7410 3900" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="7410" height="3900" fill="#B22234"/><g fill="#FFFFFF"><rect y="300" width="7410" height="300"/><rect y="900" width="7410" height="300"/><rect y="1500" width="7410" height="300"/><rect y="2100" width="7410" height="300"/><rect y="2700" width="7410" height="300"/><rect y="3300" width="7410" height="300"/></g><rect width="2964" height="2100" fill="#3C3B6E"/></svg>`,
  fr: `<svg viewBox="0 0 3 2" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="1" height="2" fill="#002395"/><rect x="1" width="1" height="2" fill="#FFFFFF"/><rect x="2" width="1" height="2" fill="#ED2939"/></svg>`,
  de: `<svg viewBox="0 0 5 3" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="5" height="1" fill="#000000"/><rect y="1" width="5" height="1" fill="#DD0000"/><rect y="2" width="5" height="1" fill="#FFCE00"/></svg>`,
  es: `<svg viewBox="0 0 6 4" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="6" height="4" fill="#AA151B"/><rect y="1" width="6" height="2" fill="#F1BF00"/></svg>`,
};

// Build a sibling URL for each available locale, used by the language switcher.
const otherLocales = (locales as readonly Locale[]).filter((l) => l !== locale);
const switcherCurrent = {
  code: locale,
  label: localeLabels[locale],
  name: localeNamesNative[locale],
  href: localizePath(Astro.url.pathname, locale),
  flag: flags[locale],
};
const switcherOthers = otherLocales.map((l) => ({
  code: l,
  label: localeLabels[l],
  name: localeNamesNative[l],
  href: localizePath(Astro.url.pathname, l),
  flag: flags[l],
}));
---

<header class="nav" id="site-nav">
  <div class="container nav__inner">
    <a href={lp('/')} class="nav__logo" aria-label={t('footer.aria.brand')}>
      <img
        class="nav__logo-img nav__logo-img--default"
        src="/Images/thechinapath-horizontal.png"
        alt="TheChinaPath"
        width="440"
        height="189"
      />
      <img
        class="nav__logo-img nav__logo-img--light"
        src="/Images/thechinapath-horizontal-light.png"
        alt=""
        aria-hidden="true"
        width="440"
        height="189"
      />
    </a>

    <nav class="nav__primary" aria-label={t('nav.aria.primary')}>
      <ul class="nav__links">
        {
          sections.map((section) => (
            <li class="nav__item nav__item--mega">
              <a href={section.href} class="nav__link" aria-haspopup="true">
                {section.label}
              </a>
              <div class="mega" role="menu" aria-label={section.label}>
                <div class="container mega__inner">
                  <div class="mega__head">
                    <span class="mega__eyebrow">{section.label}</span>
                    <p class="mega__intro">{section.intro}</p>
                    <a href={section.href} class="btn btn--ghost mega__cta">
                      {t('nav.allServices', { section: section.label })}
                    </a>
                  </div>
                  <div
                    class={`mega__grid ${section.key === 'grow' ? 'mega__grid--grow' : section.items.length > 3 ? 'mega__grid--6' : 'mega__grid--3'}`}
                  >
                    {section.items.map((item) => (
                      <a href={item.href} class="mega-item">
                        <span class="mega-item__icon" set:html={item.svg} />
                        <span class="mega-item__body">
                          <span class="mega-item__title">{item.label}</span>
                          <span class="mega-item__desc">{item.desc}</span>
                        </span>
                      </a>
                    ))}
                    {section.key === 'enter' && (
                      <a
                        href={enterChinaFeature.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mega-item mega-item--feature"
                        data-spotlight
                        aria-label={t('nav.opensInNewTab', {
                          name: enterChinaFeature.label,
                          desc: enterChinaFeature.desc,
                        })}
                      >
                        <span class="mega-feature__logobox">
                          <img
                            src={enterChinaFeature.logo}
                            alt={enterChinaFeature.label}
                            loading="lazy"
                            width="320"
                            height="80"
                          />
                        </span>
                        <span class="mega-item__desc mega-feature__desc">
                          {enterChinaFeature.desc}
                        </span>
                      </a>
                    )}
                    {section.key === 'grow' && (
                      <a
                        href={growChinaFeature.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mega-item mega-item--feature mega-item--feature-cwf"
                        data-spotlight
                        aria-label={t('nav.opensInNewTab', {
                          name: growChinaFeature.label,
                          desc: growChinaFeature.desc,
                        })}
                      >
                        <span class="mega-feature__logobox">
                          <img
                            src={growChinaFeature.logo}
                            alt={growChinaFeature.label}
                            loading="lazy"
                            width="320"
                            height="80"
                          />
                        </span>
                        <span class="mega-item__desc mega-feature__desc">
                          {growChinaFeature.desc}
                        </span>
                      </a>
                    )}
                    {section.key === 'grow' && (
                      <a
                        href={growChinaFeatureHub.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mega-item mega-item--feature mega-item--feature-hub"
                        data-spotlight
                        aria-label={t('nav.opensInNewTab', {
                          name: growChinaFeatureHub.label,
                          desc: growChinaFeatureHub.desc,
                        })}
                      >
                        <span class="mega-feature__logobox">
                          <img
                            src={growChinaFeatureHub.logo}
                            alt={growChinaFeatureHub.label}
                            loading="lazy"
                            width="320"
                            height="80"
                          />
                        </span>
                        <span class="mega-item__desc mega-feature__desc">
                          {growChinaFeatureHub.desc}
                        </span>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </li>
          ))
        }

        <li class="nav__item">
          <a href={lp('/work')} class="nav__link">{t('nav.work')}</a>
        </li>
        <li class="nav__item">
          <a href={lp('/about')} class="nav__link">{t('nav.about')}</a>
        </li>
      </ul>
    </nav>

    <div class="nav__right">
      <div class="nav__lang" data-lang-switch>
        <button
          class="nav__lang-trigger"
          type="button"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label={t('lang.switch.aria')}
        >
          <span class="nav__lang-flag" set:html={switcherCurrent.flag} />
          <span class="nav__lang-current">{switcherCurrent.label}</span>
          <svg
            class="nav__lang-caret"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <ul class="nav__lang-menu" role="listbox" aria-label={t('lang.switch.aria')}>
          <li role="option" aria-selected="true">
            <a
              class="nav__lang-option is-current"
              href={switcherCurrent.href}
              hreflang={switcherCurrent.code}
            >
              <span class="nav__lang-flag" set:html={switcherCurrent.flag} />
              <span class="nav__lang-option-code">{switcherCurrent.label}</span>
              <span class="nav__lang-option-name">{switcherCurrent.name}</span>
            </a>
          </li>
          {
            switcherOthers.map((opt) => (
              <li role="option" aria-selected="false">
                <a class="nav__lang-option" href={opt.href} hreflang={opt.code}>
                  <span class="nav__lang-flag" set:html={opt.flag} />
                  <span class="nav__lang-option-code">{opt.label}</span>
                  <span class="nav__lang-option-name">{opt.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <a href={lp('/contact')} class="btn btn--primary btn--sm">{t('nav.contact')}</a>
      <button class="nav__burger" type="button" aria-label={t('nav.menu')} aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const nav = document.getElementById('site-nav');
    const onScroll = () => nav.classList.toggle('nav--scrolled', window.scrollY > 4);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const burger = nav.querySelector('.nav__burger');
    const closeDrawer = () => {
      nav.classList.remove('nav--open');
      burger?.setAttribute('aria-expanded', 'false');
    };
    burger?.addEventListener('click', () => {
      const open = nav.classList.toggle('nav--open');
      burger.setAttribute('aria-expanded', String(open));
    });
    // Close drawer when a nav link is tapped
    nav.querySelectorAll('.nav__primary a').forEach((a) => {
      a.addEventListener('click', closeDrawer);
    });
    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('nav--open')) closeDrawer();
    });
    // Close when the viewport grows past the breakpoint where the desktop
    // nav takes over. FR, DE and ES carry longer labels than EN, so they
    // keep the burger up to 1180px before the desktop nav takes over.
    const htmlLang = document.documentElement.lang;
    const needsWide = htmlLang === 'fr' || htmlLang === 'de' || htmlLang === 'es';
    const mq = window.matchMedia(needsWide ? '(min-width: 1181px)' : '(min-width: 1025px)');
    const onMq = (e) => {
      if (e.matches) closeDrawer();
    };
    if (mq.addEventListener) mq.addEventListener('change', onMq);
    else mq.addListener(onMq);

    nav.querySelectorAll('[data-spotlight]').forEach((el) => {
      const onMove = (e) => {
        const rect = el.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        el.style.setProperty('--mx', x + '%');
        el.style.setProperty('--my', y + '%');
      };
      const onLeave = () => {
        el.style.setProperty('--mx', '50%');
        el.style.setProperty('--my', '50%');
      };
      el.addEventListener('pointermove', onMove);
      el.addEventListener('pointerleave', onLeave);
    });

    // Language switcher: click-to-toggle dropdown, click-away to close.
    const lang = nav.querySelector('[data-lang-switch]');
    if (lang) {
      const trigger = lang.querySelector('.nav__lang-trigger');
      const close = () => {
        lang.classList.remove('is-open');
        trigger?.setAttribute('aria-expanded', 'false');
      };
      trigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = lang.classList.toggle('is-open');
        trigger.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', (e) => {
        if (!lang.contains(e.target)) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    }
  })();
</script>
