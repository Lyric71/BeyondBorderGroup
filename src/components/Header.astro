---
/**
 * Site header and mega menu.
 *
 * Design note. The logo is a map pin on a winding path, and the whole brand
 * rests on that one idea: a route through a market. So the nav is built as a
 * route rather than as a row of dropdowns. A hairline rail runs under the top
 * level, a red marker travels along it to whichever stop you are on, and when a
 * panel opens the rail drops into it as the vertical spine the rows hang off.
 * That is the one place this component spends its boldness. Everything else,
 * the rows, the type, the spacing, stays quiet.
 *
 * Structure per panel: a dark spine on the left carrying the group's promise, a
 * readable list of rows in the middle, and a feature card on the right that
 * shows rather than tells. Partner logos live in that third zone.
 *
 * WO-1.1 — five top-level groups, labels naming the visitor's need. "Who We Are"
 * sits in the footer and "Insights" sits under Learn China.
 *
 * Link policy. Every row points at thechinapath.com except one, the hubStudio
 * row. WO-P2: the Compass pages and the two door pages now ship in every
 * locale, so every row goes through localizePath and a German reader stays on
 * German pages from the German menu.
 */
import { getLocaleFromUrl, localizePath, useTranslations } from '../i18n/utils';
import { locales, localeLabels, localeNamesNative, type Locale } from '../i18n/ui';
import { localesForPath } from '../i18n/route-locales';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const lp = (path: string) => localizePath(path, locale);

const icon = {
