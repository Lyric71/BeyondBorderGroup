/**
 * The third zone of each panel. One kind per group, because each group has a
 * different thing worth showing: the platforms we operate on, the two sister
 * teams, the database, the room a masterclass happens in.
 */
type Feature =
  | { kind: 'logos'; label: string; note: string; logos: { src: string; alt: string }[] }
  | {
      kind: 'partners';
      label: string;
      cards: { src: string; alt: string; name: string; line: string; href: string }[];
    }
  | { kind: 'image'; label: string; title: string; line: string; href: string; cta: string; src: string; alt: string };

const features: Record<string, Feature> = {
  sell: {
    kind: 'logos',
    label: t('nav.feature.platforms.label'),
    note: t('nav.feature.platforms.note'),
    logos: [
      { src: '/Images/platforms/tmall-logo.svg', alt: 'Tmall' },
      { src: '/Images/platforms/jd-logo.webp', alt: 'JD.com' },
      { src: '/Images/platforms/douyin-logo.svg', alt: 'Douyin' },
      { src: '/Images/platforms/wechat-logo.svg', alt: 'WeChat' },
      { src: '/Images/platforms/rednote-logo.svg', alt: 'RedNote' },
      { src: '/Images/platforms/pdd-logo.svg', alt: 'Pinduoduo' },
    ],
  },
  web: {
    kind: 'partners',
    label: t('nav.feature.teams.label'),
    cards: [
      {
        src: '/Images/AgencyLogos/Logo-ChinaWebFoundry-transparent.webp',
        alt: 'ChinaWebFoundry',
        name: 'ChinaWebFoundry',
        line: t('nav.feature.cwf.line'),
        href: lp('/build-in-china'),
      },
      {
        src: '/Images/AgencyLogos/TheredScroll%20PNG.webp',
        alt: 'TheRedScroll',
