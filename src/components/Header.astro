        line: t('nav.feature.trs.line'),
        href: lp('/social-in-china'),
      },
    ],
  },
  find: {
    kind: 'image',
    label: t('nav.feature.compass.label'),
    title: t('nav.feature.compass.title'),
    line: t('nav.feature.compass.line'),
    href: lp('/compass'),
    cta: t('nav.feature.compass.cta'),
    src: '/Images/compass/compass-hero.png',
    alt: t('nav.feature.compass.alt'),
  },
  learn: {
    kind: 'image',
    label: t('nav.feature.learn.label'),
    title: t('nav.feature.learn.title'),
    line: t('nav.feature.learn.line'),
    href: lp('/learn-china/masterclass'),
    cta: t('nav.feature.learn.cta'),
    src: '/Images/masterclass.jpg',
    alt: t('nav.feature.learn.alt'),
  },
};

interface NavSection {
  key: string;
  label: string;
  href: string;
  title: string;
  intro: string;
  cta: { label: string; href: string } | null;
  items: NavItem[];
}

const sections: NavSection[] = [
  {
    key: 'sell',
    label: t('nav.section.sell'),
    href: lp('/grow-in-china'),
    title: t('nav.sell.title'),
    intro: t('nav.sell.intro'),
    cta: { label: t('nav.cta.sell'), href: lp('/grow-in-china') },
    items: sellInChina,
  },
  {
    key: 'web',
    label: t('nav.section.web'),
    href: lp('/build-in-china'),
    title: t('nav.web.title'),
    intro: t('nav.web.intro'),
    cta: null,
    items: websiteAndSocial,
  },
  {
    key: 'find',
    label: t('nav.section.find'),
    href: lp('/compass'),
    title: t('nav.find.title'),
    intro: t('nav.find.intro'),
    cta: null,
    items: findPartner,
  },
  {
    key: 'learn',
    label: t('nav.section.learn'),
    href: lp('/learn-china'),
    title: t('nav.learn.title'),
    intro: t('nav.learn.intro'),
    cta: { label: t('nav.cta.learn'), href: lp('/learn-china') },
    items: learnChina,
  },
];

/**
 * Which stop the rail marker rests on when the page loads. Matched on the
 * canonical English path so it works identically in every locale.
 */
const here = localizePath(Astro.url.pathname, 'en');
const sectionRoots: Record<string, string[]> = {
  sell: ['/grow-in-china', '/enter-china'],
  web: ['/build-in-china', '/social-in-china'],
  find: ['/compass'],
  learn: ['/learn-china', '/insights'],
};
const activeKey =
  Object.keys(sectionRoots).find((k) => sectionRoots[k].some((r) => here === r || here.startsWith(r + '/'))) ??
  (here === '/work' || here.startsWith('/work/') ? 'work' : null) ??
  (here === '/tools' || here.startsWith('/tools/') ? 'tools' : null);

// Country flags for the language switcher. Inline SVG keeps the asset fast,
// China-safe (no external CDN) and crisp at any size.
const flags: Record<Locale, string> = {
  en: `<svg viewBox="0 0 7410 3900" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="7410" height="3900" fill="#B22234"/><g fill="#FFFFFF"><rect y="300" width="7410" height="300"/><rect y="900" width="7410" height="300"/><rect y="1500" width="7410" height="300"/><rect y="2100" width="7410" height="300"/><rect y="2700" width="7410" height="300"/><rect y="3300" width="7410" height="300"/></g><rect width="2964" height="2100" fill="#3C3B6E"/></svg>`,
  fr: `<svg viewBox="0 0 3 2" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="1" height="2" fill="#002395"/><rect x="1" width="1" height="2" fill="#FFFFFF"/><rect x="2" width="1" height="2" fill="#ED2939"/></svg>`,
  de: `<svg viewBox="0 0 5 3" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="5" height="1" fill="#000000"/><rect y="1" width="5" height="1" fill="#DD0000"/><rect y="2" width="5" height="1" fill="#FFCE00"/></svg>`,
  es: `<svg viewBox="0 0 6 4" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="6" height="4" fill="#AA151B"/><rect y="1" width="6" height="2" fill="#F1BF00"/></svg>`,
};

// WO-2.3: the locale set is per route. Every page keeps EN, FR, DE, ES; only
// the routes in route-locales.ts differ. This is what keeps 中文 off the
// homepage and off every service page.
const offered = localesForPath(Astro.url.pathname);
const otherLocales = (offered as readonly Locale[]).filter((l) => l !== locale);
const switcherCurrent = {
  code: locale,
  label: localeLabels[locale],
  name: localeNamesNative[locale],
  href: localizePath(Astro.url.pathname, locale),
  flag: flags[locale],
};
const switcherOthers = otherLocales.map((l) => ({
  code: l,
  label: localeLabels[l],
  name: localeNamesNative[l],
  href: localizePath(Astro.url.pathname, l),
  flag: flags[l],
}));
---

<div class="nav-progress" aria-hidden="true"><span data-progress></span></div>

<header class="nav" id="site-nav" data-nav>
  <div class="nav__bar">
    <div class="container nav__inner">
      <a href={lp('/')} class="nav__logo" aria-label={t('footer.aria.brand')}>
        <img
          class="nav__logo-img"
          src="/Images/thechinapath-horizontal.png"
          alt="TheChinaPath"
          width="440"
          height="189"
        />
      </a>

      <nav class="nav__primary" aria-label={t('nav.aria.primary')}>
        <ul class="nav__links" data-rail-scope>
          {
            sections.map((section) => (
              <li
                class="nav__item"
                data-mega={section.key}
                data-active={activeKey === section.key ? 'true' : undefined}
              >
                <a
                  href={section.href}
                  class="nav__link"
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls={`mega-${section.key}`}
                >
                  <span>{section.label}</span>
                  <svg class="nav__chev" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="m7 10 5 5 5-5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>

                <div class="mega" id={`mega-${section.key}`} data-panel>
                  <div class="mega__sheet">
                    <div class="container mega__grid">
                      {/* Zone one: the spine the rail drops into */}
                      <div class="mega__spine">
                        <span class="mega__eyebrow">{section.label}</span>
                        <p class="mega__title">{section.title}</p>
                        <p class="mega__intro">{section.intro}</p>
                        {section.cta && (
                          <a href={section.cta.href} class="mega__cta">
                            {section.cta.label}
                          </a>
                        )}
                      </div>

                      {/* Zone two: the rows */}
                      <ul class="mega__rows">
                        {section.items.map((item, i) => (
                          <li style={`--i:${i}`}>
                            <a
                              href={item.href}
                              class="mega-row"
                              target={item.external ? '_blank' : undefined}
                              rel={item.external ? 'noopener noreferrer' : undefined}
                              aria-label={
                                item.external
                                  ? t('nav.opensInNewTab', { name: item.label, desc: item.desc })
                                  : undefined
                              }
                            >
                              <span class="mega-row__icon" set:html={item.svg} />
                              <span class="mega-row__body">
                                <span class="mega-row__title">
                                  {item.label}
                                  {item.external && (
                                    <svg class="mega-row__ext" viewBox="0 0 24 24" aria-hidden="true">
                                      <path
                                        d="M7 17 17 7M9 7h8v8"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                      />
                                    </svg>
                                  )}
                                </span>
                                <span class="mega-row__desc">{item.desc}</span>
                              </span>
                              <span class="mega-row__go" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                  <path
                                    d="M5 12h13M12 5l7 7-7 7"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                  />
                                </svg>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>

                      {/* Zone three: show, do not tell */}
                      <div class="mega__feature" data-spotlight>
                        {features[section.key]?.kind === 'logos' && (
                          <div class="feat feat--logos">
                            <span class="feat__label">{(features[section.key] as any).label}</span>
                            <div class="feat__logos">
                              {(features[section.key] as any).logos.map((l: any) => (
                                <span class="feat__logo">
                                  <img src={l.src} alt={l.alt} loading="lazy" width="120" height="40" />
                                </span>
                              ))}
                            </div>
                            <p class="feat__note">{(features[section.key] as any).note}</p>
                          </div>
                        )}

                        {features[section.key]?.kind === 'partners' && (
                          <div class="feat feat--partners">
                            <span class="feat__label">{(features[section.key] as any).label}</span>
                            {(features[section.key] as any).cards.map((c: any) => (
                              <a href={c.href} class="feat-partner">
                                <span class="feat-partner__logo">
                                  <img src={c.src} alt={c.alt} loading="lazy" width="200" height="60" />
                                </span>
                                <span class="feat-partner__line">{c.line}</span>
                              </a>
                            ))}
                          </div>
                        )}

                        {features[section.key]?.kind === 'image' && (
                          <a href={(features[section.key] as any).href} class="feat feat--image">
                            <span class="feat__media">
                              <img
                                src={(features[section.key] as any).src}
                                alt={(features[section.key] as any).alt}
                                loading="lazy"
                                width="640"
                                height="420"
                              />
                            </span>
                            <span class="feat__label feat__label--on-media">
                              {(features[section.key] as any).label}
                            </span>
                            <span class="feat__body">
                              <span class="feat__title">{(features[section.key] as any).title}</span>
                              <span class="feat__note">{(features[section.key] as any).line}</span>
                              <span class="feat__cta">{(features[section.key] as any).cta}</span>
                            </span>
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            ))
          }

          <li class="nav__item" data-active={activeKey === 'work' ? 'true' : undefined}>
            <a href={lp('/work')} class="nav__link"><span>{t('nav.work')}</span></a>
          </li>

          <li class="nav__item" data-active={activeKey === 'tools' ? 'true' : undefined}>
            <a href={lp('/tools')} class="nav__link"><span>{t('nav.calculator')}</span></a>
          </li>

          <span class="nav__rail" data-rail aria-hidden="true"></span>
        </ul>

        <div class="nav__drawer-cta">
          <a href={lp('/contact')} class="btn btn--primary">{t('nav.talkToUs')}</a>
        </div>
      </nav>

      <div class="nav__right">
        <div class="nav__lang" data-lang-switch>
          <button
            class="nav__lang-trigger"
            type="button"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label={t('lang.switch.aria')}
          >
            <span class="nav__lang-flag" set:html={switcherCurrent.flag} />
            <span class="nav__lang-current">{switcherCurrent.label}</span>
            <svg class="nav__chev" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="m7 10 5 5 5-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <ul class="nav__lang-menu" role="listbox" aria-label={t('lang.switch.aria')}>
            <li role="option" aria-selected="true">
              <a
                class="nav__lang-option is-current"
                href={switcherCurrent.href}
                hreflang={switcherCurrent.code}
              >
                <span class="nav__lang-flag" set:html={switcherCurrent.flag} />
                <span class="nav__lang-option-code">{switcherCurrent.label}</span>
                <span class="nav__lang-option-name">{switcherCurrent.name}</span>
              </a>
            </li>
            {
              switcherOthers.map((opt) => (
                <li role="option" aria-selected="false">
                  <a class="nav__lang-option" href={opt.href} hreflang={opt.code}>
                    <span class="nav__lang-flag" set:html={opt.flag} />
                    <span class="nav__lang-option-code">{opt.label}</span>
                    <span class="nav__lang-option-name">{opt.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <a href={lp('/contact')} class="btn btn--primary btn--sm nav__contact">{t('nav.talkToUs')}</a>

        <button class="nav__burger" type="button" aria-label={t('nav.menu')} aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>

  <div class="nav__scrim" data-scrim aria-hidden="true"></div>
</header>

<script is:inline>
  (function () {
    const nav = document.getElementById('site-nav');
    if (!nav) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = window.matchMedia('(min-width: 1181px)');

    /* ---------- scroll: progress hairline, condense, hide on the way down --- */
    const progress = document.querySelector('[data-progress]');
    let lastY = window.scrollY;
    let ticking = false;

    function onScroll() {
      const y = window.scrollY;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (progress) progress.style.transform = 'scaleX(' + (max > 0 ? y / max : 0) + ')';

      nav.classList.toggle('nav--scrolled', y > 8);
      // Panels are fixed, so they need the bar's live bottom edge.
      const bar = nav.querySelector('.nav__bar');
      if (bar) nav.style.setProperty('--nav-bottom', bar.getBoundingClientRect().bottom + 'px');

      // Only retreat once well past the fold, and never while a panel is open
      // or the drawer is out.
      const busy = nav.classList.contains('nav--mega') || nav.classList.contains('nav--open');
      if (!busy && y > 420 && y > lastY + 6) nav.classList.add('nav--tucked');
      else if (y < lastY - 6 || y < 200) nav.classList.remove('nav--tucked');
      lastY = y;
      ticking = false;
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true },
    );
    onScroll();

    /* ---------- the rail marker ------------------------------------------- */
    const scope = nav.querySelector('[data-rail-scope]');
    const rail = nav.querySelector('[data-rail]');
    const items = Array.from(nav.querySelectorAll('.nav__item'));
    const home = items.find((i) => i.dataset.active === 'true') || null;

    function moveRail(el) {
      if (!rail || !scope || !el) return;
      const a = el.querySelector('.nav__link');
      if (!a) return;
      const r = a.getBoundingClientRect();
      const s = scope.getBoundingClientRect();
      rail.style.setProperty('--rail-x', r.left - s.left + 'px');
      rail.style.setProperty('--rail-w', r.width + 'px');
      rail.classList.add('is-on');
    }
    function restRail() {
      if (home) moveRail(home);
      else if (rail) rail.classList.remove('is-on');
    }
    items.forEach((it) => {
      it.addEventListener('pointerenter', () => desktop.matches && moveRail(it));
      it.addEventListener('focusin', () => desktop.matches && moveRail(it));
    });
    scope?.addEventListener('pointerleave', () => desktop.matches && restRail());
    window.addEventListener('resize', () => {
      restRail();
      onScroll();
    });
    nav.querySelector('.nav__bar')?.addEventListener('transitionend', onScroll);
    restRail();

    /* ---------- mega panels: open on intent, close on leave ---------------- */
    let openTimer = null;
    let closeTimer = null;

    function openPanel(li) {
      clearTimeout(closeTimer);
      items.forEach((i) => {
        if (i !== li) {
          i.classList.remove('is-open');
          i.querySelector('.nav__link')?.setAttribute('aria-expanded', 'false');
        }
      });
      li.classList.add('is-open');
      li.querySelector('.nav__link')?.setAttribute('aria-expanded', 'true');
      nav.classList.add('nav--mega');
    }
    function closePanels() {
      items.forEach((i) => {
        i.classList.remove('is-open');
        i.querySelector('.nav__link')?.setAttribute('aria-expanded', 'false');
      });
      nav.classList.remove('nav--mega');
    }

    items.forEach((li) => {
      if (!li.dataset.mega) return;
      li.addEventListener('pointerenter', () => {
        if (!desktop.matches) return;
        clearTimeout(closeTimer);
        // A short delay so a cursor crossing the row on its way elsewhere does
        // not flash three panels open behind it.
        openTimer = setTimeout(() => openPanel(li), reduce ? 0 : 90);
      });
      li.addEventListener('pointerleave', () => {
        if (!desktop.matches) return;
        clearTimeout(openTimer);
        closeTimer = setTimeout(closePanels, 140);
      });
      li.addEventListener('focusin', () => desktop.matches && openPanel(li));
    });

    nav.addEventListener('focusout', (e) => {
      if (desktop.matches && !nav.contains(e.relatedTarget)) closePanels();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      closePanels();
      closeDrawer();
      restRail();
    });

    /* ---------- drawer ----------------------------------------------------- */
    const burger = nav.querySelector('.nav__burger');
    const scrim = nav.querySelector('[data-scrim]');

    function closeDrawer() {
      nav.classList.remove('nav--open');
      burger?.setAttribute('aria-expanded', 'false');
      document.documentElement.style.removeProperty('overflow');
    }
    burger?.addEventListener('click', () => {
      const open = nav.classList.toggle('nav--open');
      burger.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
    });
    scrim?.addEventListener('click', closeDrawer);
    nav.querySelectorAll('.nav__primary a').forEach((a) => a.addEventListener('click', closeDrawer));

    // In the drawer each group is a disclosure rather than a hover panel.
    nav.querySelectorAll('.nav__item[data-mega] > .nav__link').forEach((link) => {
      link.addEventListener('click', (e) => {
        if (desktop.matches) return;
        e.preventDefault();
        e.stopPropagation();
        const li = link.parentElement;
        const wasOpen = li.classList.contains('is-open');
        items.forEach((i) => i.classList.remove('is-open'));
        if (!wasOpen) {
          li.classList.add('is-open');
          link.setAttribute('aria-expanded', 'true');
        } else {
          link.setAttribute('aria-expanded', 'false');
        }
      });
    });

    const onMq = (e) => {
      if (e.matches) closeDrawer();
      else closePanels();
      restRail();
    };
    if (desktop.addEventListener) desktop.addEventListener('change', onMq);
    else desktop.addListener(onMq);

    /* ---------- pointer spotlight on the feature card ---------------------- */
    if (!reduce) {
      nav.querySelectorAll('[data-spotlight]').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', ((e.clientX - r.left) / r.width) * 100 + '%');
          el.style.setProperty('--my', ((e.clientY - r.top) / r.height) * 100 + '%');
        });
        el.addEventListener('pointerleave', () => {
          el.style.setProperty('--mx', '50%');
          el.style.setProperty('--my', '50%');
        });
      });
    }

    /* ---------- language switcher ------------------------------------------ */
    const lang = nav.querySelector('[data-lang-switch]');
    if (lang) {
      const trigger = lang.querySelector('.nav__lang-trigger');
      const close = () => {
        lang.classList.remove('is-open');
        trigger?.setAttribute('aria-expanded', 'false');
      };
      trigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = lang.classList.toggle('is-open');
        trigger.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('click', (e) => {
        if (!lang.contains(e.target)) close();
      });
      document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
    }
  })();
</script>
