---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allInsights = await getCollection('insights', ({ data }) => !data.draft);

const sorted = allInsights.sort((a, b) => {
  const da = a.data.pubDate?.valueOf() ?? 0;
  const db = b.data.pubDate?.valueOf() ?? 0;
  if (db !== da) return db - da;
  return a.data.title.localeCompare(b.data.title);
});

function readingTime(body: string | undefined) {
  if (!body) return '';
  const words = body.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.round(words / 200));
  return `${minutes} min read`;
}

function formatDate(d?: Date) {
  if (!d) return '';
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}

const categories = Array.from(new Set(sorted.map((p) => p.data.category))).sort();
---

<Layout
  title="Insights | Beyond Border Group"
  description="Articles and market commentary on China e-commerce, marketing, branding and digital platforms, written by the team running brands on Tmall, JD, Douyin, WeChat and RED."
>
  <section class="insights-intro">
    <div class="container">
      <span class="eyebrow">Insights</span>
      <h1>Notes from inside the China market.</h1>
      <p class="lead">
        Articles and commentary from the team that runs brands on Tmall, JD, Douyin, WeChat and RED.
        Written by operators, not analysts recycling last year's slides.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {categories.length > 1 && (
        <div class="insights-filter" role="tablist" aria-label="Filter by category">
          <button type="button" class="insights-filter__btn is-active" data-category="all" role="tab" aria-selected="true">All</button>
          {categories.map((c) => (
            <button type="button" class="insights-filter__btn" data-category={c} role="tab" aria-selected="false">{c}</button>
          ))}
        </div>
      )}

      <div class="grid grid-3 insights-grid">
        {sorted.map((post) => (
          <a
            href={`/insights/${post.id}`}
            class="insight-card"
            data-category={post.data.category}
          >
            <div class="insight-card__image">
              {post.data.heroImage && (
                <img
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="400"
                />
              )}
            </div>
            <div class="insight-card__body">
              <span class="insight-card__tag">{post.data.category}</span>
              <h3 class="insight-card__title">{post.data.title}</h3>
              <div class="insight-card__meta">
                <span>{readingTime(post.body)}</span>
                {post.data.pubDate && (
                  <>
                    <span class="insight-card__meta-sep" aria-hidden="true">|</span>
                    <span>{formatDate(post.data.pubDate)}</span>
                  </>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>

      {sorted.length === 0 && (
        <p class="insights-empty">We're moving older articles over. Check back in a few days.</p>
      )}

      <nav class="insights-pagination" aria-label="Insights pagination" hidden>
        <button type="button" class="insights-pagination__btn" data-page-prev aria-label="Previous page">
          <span aria-hidden="true">&larr;</span> Prev
        </button>
        <ol class="insights-pagination__pages" data-page-list></ol>
        <button type="button" class="insights-pagination__btn" data-page-next aria-label="Next page">
          Next <span aria-hidden="true">&rarr;</span>
        </button>
      </nav>
    </div>
  </section>

  <script is:inline>
    (function () {
      const PER_PAGE = 12;
      const grid = document.querySelector('.insights-grid');
      const cards = Array.from(document.querySelectorAll('.insight-card'));
      const pagination = document.querySelector('.insights-pagination');
      const pageList = document.querySelector('[data-page-list]');
      const prevBtn = document.querySelector('[data-page-prev]');
      const nextBtn = document.querySelector('[data-page-next]');
      let currentCategory = 'all';
      let currentPage = 1;

      function readUrl() {
        const params = new URLSearchParams(window.location.search);
        const page = parseInt(params.get('page') || '1', 10);
        const cat = params.get('category') || 'all';
        currentPage = Number.isFinite(page) && page > 0 ? page : 1;
        currentCategory = cat;
      }

      function writeUrl(push) {
        const params = new URLSearchParams(window.location.search);
        if (currentPage > 1) params.set('page', String(currentPage));
        else params.delete('page');
        if (currentCategory && currentCategory !== 'all') params.set('category', currentCategory);
        else params.delete('category');
        const qs = params.toString();
        const url = window.location.pathname + (qs ? '?' + qs : '') + window.location.hash;
        if (push) history.pushState({ page: currentPage, category: currentCategory }, '', url);
        else history.replaceState({ page: currentPage, category: currentCategory }, '', url);
      }

      function syncFilterUi() {
        document.querySelectorAll('.insights-filter__btn').forEach((b) => {
          const on = b.dataset.category === currentCategory;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
      }

      function getFiltered() {
        return cards.filter((c) => currentCategory === 'all' || c.dataset.category === currentCategory);
      }

      function pageNumbers(total, current) {
        if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
        const set = new Set([1, total, current - 1, current, current + 1]);
        const out = [];
        let prev = 0;
        Array.from(set)
          .filter((n) => n >= 1 && n <= total)
          .sort((a, b) => a - b)
          .forEach((n) => {
            if (prev && n - prev > 1) out.push('...');
            out.push(n);
            prev = n;
          });
        return out;
      }

      function render() {
        const filtered = getFiltered();
        const totalPages = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
        if (currentPage > totalPages) currentPage = totalPages;

        cards.forEach((card) => {
          card.style.display = 'none';
        });
        const start = (currentPage - 1) * PER_PAGE;
        filtered.slice(start, start + PER_PAGE).forEach((card) => {
          card.style.display = '';
        });

        if (totalPages <= 1) {
          pagination.hidden = true;
          return;
        }
        pagination.hidden = false;
        prevBtn.disabled = currentPage === 1;
        nextBtn.disabled = currentPage === totalPages;

        pageList.innerHTML = '';
        pageNumbers(totalPages, currentPage).forEach((n) => {
          const li = document.createElement('li');
          if (n === '...') {
            li.className = 'insights-pagination__ellipsis';
            li.setAttribute('aria-hidden', 'true');
            li.textContent = '...';
          } else {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'insights-pagination__page';
            btn.textContent = String(n);
            btn.setAttribute('aria-label', `Page ${n}`);
            if (n === currentPage) {
              btn.classList.add('is-active');
              btn.setAttribute('aria-current', 'page');
            }
            btn.addEventListener('click', () => goTo(n));
            li.appendChild(btn);
          }
          pageList.appendChild(li);
        });
      }

      function goTo(page) {
        currentPage = page;
        writeUrl(true);
        render();
        const top = grid.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top, behavior: 'smooth' });
      }

      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) goTo(currentPage - 1);
      });
      nextBtn.addEventListener('click', () => {
        const total = Math.max(1, Math.ceil(getFiltered().length / PER_PAGE));
        if (currentPage < total) goTo(currentPage + 1);
      });

      document.querySelectorAll('.insights-filter__btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCategory = btn.dataset.category;
          currentPage = 1;
          syncFilterUi();
          writeUrl(true);
          render();
        });
      });

      window.addEventListener('popstate', () => {
        readUrl();
        syncFilterUi();
        render();
      });

      readUrl();
      syncFilterUi();
      writeUrl(false);
      render();
    })();
  </script>

  <style>
    .insights-intro {
      padding: var(--space-8) 0 var(--space-6);
      text-align: center;
    }
    .insights-intro .eyebrow { display: inline-block; margin-bottom: var(--space-4); }
    .insights-intro h1 { max-width: 18ch; margin-inline: auto; margin-bottom: var(--space-4); }
    .insights-intro .lead { max-width: 60ch; margin-inline: auto; color: var(--bbg-text); }

    .insights-filter {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      justify-content: center;
      margin-bottom: var(--space-7);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--bbg-border);
    }
    .insights-filter__btn {
      appearance: none;
      border: 1px solid var(--bbg-border);
      background: transparent;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--bbg-text-muted);
      cursor: pointer;
      transition: all var(--dur) var(--ease);
    }
    .insights-filter__btn:hover {
      border-color: var(--bbg-blue);
      color: var(--bbg-blue);
    }
    .insights-filter__btn.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }

    .insights-grid {
      gap: var(--space-6) var(--space-5);
    }
    .insights-empty {
      text-align: center;
      color: var(--bbg-text-muted);
      padding: var(--space-8) 0;
    }

  </style>

  <style is:global>
    .insights-pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-top: var(--space-7);
      padding-top: var(--space-6);
      border-top: 1px solid var(--bbg-border);
    }
    .insights-pagination[hidden] { display: none; }
    .insights-pagination__btn {
      appearance: none;
      border: 1px solid var(--bbg-border);
      background: transparent;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--bbg-ink);
      cursor: pointer;
      transition: all var(--dur) var(--ease);
    }
    .insights-pagination__btn:hover:not(:disabled) {
      border-color: var(--bbg-blue);
      color: var(--bbg-blue);
    }
    .insights-pagination__btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .insights-pagination__pages {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .insights-pagination__page {
      appearance: none;
      border: 1px solid transparent;
      background: transparent;
      min-width: 2.25rem;
      height: 2.25rem;
      padding: 0 0.5rem;
      border-radius: 8px;
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--bbg-text-muted);
      cursor: pointer;
      transition: all var(--dur) var(--ease);
    }
    .insights-pagination__page:hover {
      color: var(--bbg-blue);
      border-color: var(--bbg-blue);
    }
    .insights-pagination__page.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }
    .insights-pagination__ellipsis {
      padding: 0 0.25rem;
      color: var(--bbg-text-muted);
      user-select: none;
    }
  </style>
</Layout>
