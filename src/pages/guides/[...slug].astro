---
import GuidePage from '../../components/GuidePage.astro';
import { getCollection, render } from 'astro:content';
import { slugMap } from '../../i18n/slug-map.mjs';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const words = (guide.body ?? '').split(/\s+/).filter(Boolean).length;
// Most guides are English only; the ones with a FR, DE or ES twin in the slug
// table get hreflang alternates.
const path = `/guides/${guide.id}`;
const translated = Object.values(slugMap).some((map) => path in map);
---

<GuidePage
  data={guide.data}
  Content={Content}
  headings={headings}
  words={words}
  dateLocale="en-US"
  labels={{ eyebrow: 'Guide', updated: 'Updated', print: 'Print this guide', related: 'Read the article it comes from', contents: 'Contents', minRead: 'min read', start: 'Start reading', talk: 'Talk to us', talkLine: 'Map your route and your costs with our Shanghai team.' }}
  noAlternate={!translated}
/>
