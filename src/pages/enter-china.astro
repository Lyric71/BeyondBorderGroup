---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    eyebrow: 'Strategy',
    title: 'Market Entry Consulting',
    tagline: 'A model built for your category, your budget, your timeline. Plus a roadmap your team can actually run.',
    href: '/enter-china/market-entry-consulting',
    cta: 'See the consulting work',
    image: '/Images/enter-china/phase-4-financial.png',
    alt: 'A finance analyst reviewing a China market entry financial model on a desktop in a Shanghai office',
    accent: '#C8102E',
    accentSoft: '#FBE9EC',
  },
  {
    eyebrow: 'Brand',
    title: 'Branding & Localisation',
    tagline: 'Your brand, sharpened for the Chinese shopper. Name, identity, packaging, voice.',
    href: '/enter-china/branding-localisation',
    cta: 'See the brand work',
    image: '/Images/branding/visual-identity.webp',
    alt: 'Visual identity layouts adapted for Chinese platforms and packaging',
    accent: '#E54B6E',
    accentSoft: '#FCEAEF',
  },
  {
    eyebrow: 'Launch',
    title: 'Cross-Border eCommerce Setup',
    tagline: 'Tmall Global or JD Worldwide, live in months. No Chinese entity needed.',
    href: '/enter-china/cross-border-setup',
    cta: 'See the setup work',
    image: '/Images/enter-china/route-sellin.png',
    alt: 'A Chinese eCommerce distributor team reviewing inventory in a Shanghai fulfillment warehouse',
    accent: '#0EA46C',
    accentSoft: '#E6F5EE',
  },
  {
    eyebrow: 'Reach',
    title: 'Distribution',
    tagline: 'Online, offline, every region. The right partner for your category, vetted on our side of the table.',
    href: '/enter-china/distribution',
    cta: 'See the distribution work',
    image: '/Images/enter-china/route-sellout.png',
    alt: 'A foreign brand manager and Chinese operator reviewing a Tmall flagship dashboard in a Shanghai office',
    accent: '#C8102E',
    accentSoft: '#FCEAEF',
  },
];
---

<Layout
  title="Enter China | Market entry agency | TheChinaPath"
  description="A China market-entry agency for foreign brands. Consulting, branding and localisation, cross-border eCommerce setup, distribution. Four ways into China, run by one team."
>

  {/* ---------- HERO ---------- */}
  <section class="hero-fullbleed">
    <picture>
      <img
        src="/Images/enter-china/hero-skyline.png"
        alt=""
        class="hero-fullbleed__image"
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-fullbleed__overlay" aria-hidden="true"></div>

    <div class="container hero-fullbleed__inner">
      <div class="hero-fullbleed__copy">
        <span class="eyebrow eyebrow--on-dark">Enter China</span>
        <h1 class="hero-fullbleed__title">Get into China.</h1>
        <p class="hero-fullbleed__lead">
          Strategy, brand, cross-border setup, distribution. Four services that take you from idea to first sales, run by one team.
        </p>
        <div class="hero-fullbleed__actions">
          <a class="btn btn--primary" href="/contact">Talk to us</a>
          <a class="btn btn--ghost-light" href="#services">See the four services</a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- HOW TO ENTER CHINA (citable Q&A passage) ---------- */}
  <section class="section section--tight enter-explainer">
    <div class="container">
      <div class="enter-explainer__copy">
        <span class="eyebrow">The starting question</span>
        <h2 class="enter-explainer__title">How do foreign brands enter China?</h2>
        <p class="enter-explainer__lead">
          Four routes. Each one fits a different appetite for risk, capital and operational depth.
        </p>
        <div class="enter-explainer__grid">
          <article class="enter-explainer__route">
            <h3>Cross-border eCommerce</h3>
            <p>
              Tmall Global or JD Worldwide. Ship from a bonded warehouse, no Chinese entity
              required, launch in 8 to 12 weeks. Thinner margins, real customs paperwork,
              platform compliance that has hardened in the last two years.
            </p>
          </article>
          <article class="enter-explainer__route">
            <h3>Vetted distributor</h3>
            <p>
              A local partner takes the operational risk off your team. They hold inventory,
              they sell into the channels they know, you protect brand equity through a
              marketing contract on top. Common route for FMCG, F&amp;B and consumer health.
            </p>
          </article>
          <article class="enter-explainer__route">
            <h3>Trade partner (TP)</h3>
            <p>
              The middle option. You keep the brand and the customer relationship, the TP runs
              your Tmall Global or Douyin EC store under a fixed fee plus revenue share. Our
              senior team has been running TP-model stores in China for more than a decade.
            </p>
          </article>
          <article class="enter-explainer__route">
            <h3>WFOE (China entity)</h3>
            <p>
              Wholly foreign-owned enterprise. 12 to 18 months of setup, your own license, your
              own staff, your own customer data. The right move when China becomes a top-three
              line in your global P&amp;L.
            </p>
          </article>
        </div>
        <p class="enter-explainer__note">
          We have run all four with international brands for two decades. The right answer
          depends on your category, your margin structure, and how much downside you can carry
          in year one.
        </p>
      </div>
    </div>
  </section>

  {/* ---------- PROOF STRIP ---------- */}
  <section class="section section--tight enter-proof">
    <div class="container">
      <div class="enter-proof__intro">
        <span class="eyebrow">Brands we have brought into China</span>
        <p class="enter-proof__pitch">
          Three weeks of market and regulatory diagnosis. Channel selection. Distributor shortlist or cross-border setup. We phase commitments so you only buy the next step.
        </p>
      </div>
      <ul class="enter-proof__strip" role="list">
        <li class="enter-proof__card">
          <img src="/Images/Clients%20Logos/Marriot.png" alt="Marriott" width="160" height="60" loading="lazy" />
          <p class="enter-proof__metric">Eight-figure RMB GMV on Tmall Super Brand Day</p>
        </li>
        <li class="enter-proof__card">
          <img src="/Images/Clients%20Logos/camper_black.png" alt="Camper" width="160" height="60" loading="lazy" />
          <p class="enter-proof__metric">+330% audience growth on WeChat, Weibo and RED</p>
        </li>
        <li class="enter-proof__card">
          <img src="/Images/Clients%20Logos/Valio.png" alt="Valio" width="160" height="60" loading="lazy" />
          <p class="enter-proof__metric">Sub-brand eila launched with localised name and full visual identity</p>
        </li>
        <li class="enter-proof__card">
          <img src="/Images/Clients%20Logos/pierre-black.png" alt="Pierre Fabre" width="160" height="60" loading="lazy" />
          <p class="enter-proof__metric">Leadership masterclass and the 3D Digital Growth Model</p>
        </li>
      </ul>
    </div>
  </section>

  {/* ---------- SERVICES GRID ---------- */}
  <section class="section" id="services">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Four ways in</span>
        <h2>Pick the one that fits where you are today.</h2>
        <p class="section-header__lead">
          Some brands need a strategy before anything moves. Some are ready to launch. Some need the brand rebuilt for a Chinese audience first. Start where it makes sense.
        </p>
      </header>

      <div class="enter-grid">
        {services.map((s) => (
          <a
            href={s.href}
            class="enter-tile"
            style={`--accent: ${s.accent}; --accent-soft: ${s.accentSoft};`}
          >
            <div class="enter-tile__media">
              <img src={s.image} alt={s.alt} width="1200" height="800" loading="lazy" decoding="async" />
              <div class="enter-tile__scrim" aria-hidden="true"></div>
            </div>

            <div class="enter-tile__body">
              <span class="enter-tile__eyebrow">{s.eyebrow}</span>
              <h3 class="enter-tile__title">{s.title}</h3>
              <p class="enter-tile__tagline">{s.tagline}</p>
              <span class="enter-tile__cta">
                {s.cta}
                <span class="enter-tile__arrow" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- FINAL CTA ---------- */}
  <section class="section section--tight section--alt">
    <div class="container">
      <div class="enter-cta">
        <div class="enter-cta__copy">
          <span class="eyebrow">Not sure which one fits?</span>
          <h2>Tell us where you are. We will tell you what to do next.</h2>
          <p class="enter-cta__lead">
            A senior member of the team writes back, never a chatbot. 20 minutes on the phone usually saves you a year of guessing.
          </p>
        </div>
        <div class="enter-cta__actions">
          <a class="btn btn--primary" href="/contact">Start the conversation</a>
          <a class="btn btn--ghost" href="/work">See our work</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ---------- How to enter China (citable Q&A passage) ---------- */
  .enter-explainer__copy {
    max-width: 920px;
    margin: 0 auto;
  }
  .enter-explainer__title {
    font-size: clamp(1.875rem, 1.4rem + 1.8vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0.5rem 0 1rem;
    color: var(--bbg-ink, #1a1a1a);
  }
  .enter-explainer__lead {
    font-size: 1.125rem;
    line-height: 1.55;
    color: #333;
    margin: 0 0 2rem;
  }
  .enter-explainer__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin: 0 0 1.5rem;
  }
  .enter-explainer__route {
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    padding: 1.5rem 1.5rem 1.6rem;
    background: #fff;
    transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }
  .enter-explainer__route:hover {
    border-color: #C8102E;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -16px rgba(200, 16, 46, 0.45);
  }
  .enter-explainer__route h3 {
    font-size: 1.125rem;
    line-height: 1.3;
    margin: 0 0 0.6rem;
    color: var(--bbg-ink, #1a1a1a);
  }
  .enter-explainer__route p {
    font-size: 1rem;
    line-height: 1.6;
    color: #333;
    margin: 0;
  }
  .enter-explainer__note {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
    margin: 1rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid #e5e5e5;
  }
  @media (max-width: 720px) {
    .enter-explainer__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Services grid (bento, image-led) ---------- */
  .enter-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .enter-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 460px;
    padding: 2rem;
    border-radius: 16px;
    overflow: hidden;
    color: #fff;
    background: var(--bbg-ink);
    isolation: isolate;
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .enter-tile::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--accent);
    z-index: 3;
  }

  .enter-tile__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .enter-tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .enter-tile__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.25) 45%, rgba(0,0,0,0.85) 100%);
    z-index: 1;
    transition: opacity 300ms ease;
  }

  .enter-tile__body {
    position: relative;
    z-index: 2;
    max-width: 36rem;
  }

  .enter-tile__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    margin-bottom: 1rem;
  }

  .enter-tile__title {
    font-size: clamp(1.5rem, 2vw + 1rem, 2rem);
    line-height: 1.15;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.6rem;
    letter-spacing: -0.01em;
  }

  .enter-tile__tagline {
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.92);
    margin: 0 0 1.25rem;
    max-width: 30rem;
  }

  .enter-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(255,255,255,0.4);
    width: fit-content;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .enter-tile__arrow {
    display: inline-block;
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Hover */
  .enter-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.18);
    color: #fff;
  }
  .enter-tile:hover .enter-tile__media img {
    transform: scale(1.05);
  }
  .enter-tile:hover .enter-tile__scrim {
    background:
      linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.45) 45%, rgba(0,0,0,0.9) 100%);
  }
  .enter-tile:hover .enter-tile__cta {
    border-color: #fff;
  }
  .enter-tile:hover .enter-tile__arrow {
    transform: translateX(6px);
  }

  /* Focus state for keyboard users */
  .enter-tile:focus-visible {
    outline: 3px solid var(--bbg-blue);
    outline-offset: 4px;
  }

  /* ---------- Final CTA ---------- */
  .enter-cta {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .enter-cta__copy h2 {
    margin: 0 0 0.75rem;
  }
  .enter-cta__lead {
    font-size: 1.0625rem;
    color: var(--bbg-text);
    margin: 0;
    max-width: 38rem;
  }
  .enter-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1024px) {
    .enter-grid {
      grid-template-columns: 1fr;
    }
    .enter-tile {
      min-height: clamp(360px, 50vw, 460px);
      padding: 1.75rem;
    }
  }
  /* Collapse the CTA earlier than 1024 — at 1024 the right-aligned
     actions buttons sit edge-to-edge against the title block. */
  @media (max-width: 900px) {
    .enter-cta {
      grid-template-columns: 1fr;
    }
    .enter-cta__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 480px) {
    .enter-tile {
      min-height: 360px;
      padding: 1.25rem;
    }
    .enter-tile__tagline {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .enter-tile,
    .enter-tile__media img,
    .enter-tile__scrim,
    .enter-tile__cta,
    .enter-tile__arrow {
      transition: none !important;
    }
  }

  /* ---------- Proof strip ---------- */
  .enter-proof {
    padding-block: var(--space-7);
    background: var(--bbg-surface);
  }
  .enter-proof__intro {
    max-width: 720px;
    margin: 0 auto var(--space-6);
    text-align: center;
  }
  .enter-proof__pitch {
    margin-top: var(--space-3);
    font-size: 1.05rem;
    color: var(--bbg-text);
    line-height: 1.55;
  }
  .enter-proof__strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .enter-proof__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: var(--space-5) var(--space-4);
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-md);
    text-align: center;
  }
  .enter-proof__card img {
    height: 36px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .enter-proof__metric {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--bbg-ink);
    font-weight: 500;
  }
  /* 4 logos in a row at 270px each get tight on tablets. Drop to 2-col
     once the row shrinks below ~1100px. */
  @media (max-width: 1100px) {
    .enter-proof__strip { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .enter-proof__strip { grid-template-columns: 1fr; }
  }
</style>
