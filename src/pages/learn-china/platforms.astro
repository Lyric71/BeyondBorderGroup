      .lcp-trs__stat:last-child { border-bottom: 0; }
    }
    @media (max-width: 640px) {
      .lcp-trs__title { font-size: clamp(1.5rem, 4vw + 0.5rem, 2rem); }
      .lcp-trs__brand { flex-wrap: wrap; gap: var(--space-3); }
      .lcp-trs__wordmark { border-left: 0; padding-left: 0; }
