      transition: left 700ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .lcp-trs__btn-primary:hover::after { left: 100%; }
    .lcp-trs__btn-primary:hover {
      background: linear-gradient(90deg, #FF3D55 0%, #FF2741 100%);
