---
import Layout from '../../layouts/Layout.astro';
import CaseStudyStrip from '../../components/CaseStudyStrip.astro';

const heroBadges = [
  'HEC MBA',
  'ESCP MBA',
  'EU Chamber',
  'AmCham',
  'Business France',
  'SJTU Executive MBA',
];

const heroStats = [
  { value: 15, suffix: '+', label: 'years training executives' },
  { value: 6, suffix: '', label: 'partner institutions' },
  { value: 3, suffix: '', label: 'working languages' },
];

const audience = [
  'Business owners and country managers looking at China',
  'Marketing and digital teams who need to understand why China is different',
  'eCommerce teams preparing to sell on Tmall, JD, Douyin or RED',
  'Entrepreneurs and startups sizing up the opportunity',
  'International marketing leads expanding their toolkit',
];

const takeaways = [
  {
    h: 'Operator trainers',
    p: 'Trainers who run stores, media budgets and campaigns today. Not ex-consultants reading slides from last year. You learn from the person still getting WeChat notifications at 11pm.',
    feature: true,
  },
  {
    h: 'Real case studies',
    p: 'Brands that grew in China, brands that burned money. Both matter, and the numbers come with each one.',
  },
  {
    h: 'Current numbers',
    p: 'Platforms, consumer behaviour, media costs. Refreshed before every session because last quarter is already stale.',
  },
  {
    h: 'Your brief, not ours',
    p: 'A working session tied to your category, your price point and your team. Not a deck anyone could find online.',
  },
  {
    h: 'Ready-to-use tools',
    p: 'Frameworks, checklists and templates your team can put to work the following Monday morning.',
  },
];

const moduleIcon: Record<string, string> = {
  compass:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>',
  grid: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>',
  target:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>',
};

const modules = [
  {
    icon: 'compass',
    tab: 'Ecosystem',
    tabSub: 'Map of the market',
    image: '/Images/learn-china/masterclass/ecosystem.png',
    imageAlt:
      'Chinese eCommerce shopper holding a smartphone showing Tmall and Douyin app interfaces, Shanghai cityscape in the background',
    title: "China's digital and eCommerce ecosystem",
    lead: 'The map of the market. Who uses what, how the platforms make money, where your category fits.',
    topics: [
      {
        h: 'Market overview',
        items: [
          'Current numbers: internet users, eCommerce penetration, category splits',
          'Mobile and super-app behaviour',
          'Chinese consumer profiles by tier, age and income',
          'Regional differences and why one national plan rarely works',
        ],
      },
      {
        h: 'Consumer behaviour',
        items: [
          'How Chinese consumers actually discover, compare and buy',
          'The real purchase journey across search, social and eCommerce',
          'What drives decisions: price, content, trust, recommendation',
          'The weight of mobile and social in every category',
        ],
      },
      {
        h: 'Current trends',
        items: [
          'Livestreaming, short video and social commerce',
          'AI, personalisation and the rise of GEO on Chinese search',
          'What is growing, what is peaking, what is already over',
        ],
      },
    ],
  },
  {
    icon: 'grid',
    tab: 'Platforms',
    tabSub: 'How each one works',
    image: '/Images/learn-china/masterclass/platforms.png',
    imageAlt:
      'Flat-lay of several smartphones showing Tmall, JD, Douyin, WeChat and Xiaohongshu eCommerce app interfaces',
    title: 'Platforms',
    lead: 'The rules of each platform, the kind of brand it rewards, and what it actually costs to operate.',
    topics: [
      {
        h: 'WeChat',
        items: [
          'Official Accounts: setup, content formats, what works',
          'Mini Programs for commerce, service and CRM',
          'WeChat Pay and the basics of WeCom',
          'Content strategy and paid amplification',
        ],
      },
      {
        h: 'eCommerce platforms',
        items: [
          'Tmall and Tmall Global: model, fees, operations',
          'JD and JD Worldwide: where it wins and where it does not',
          'Taobao and the C2C layer underneath Tmall',
          'Douyin eCommerce and closed-loop social commerce',
          'Pricing, promotions and the shopping calendar',
        ],
      },
      {
        h: 'Social platforms',
        items: [
          'Weibo: still relevant for PR and seeding',
          'Douyin: content formats, algorithm, commercial mechanics',
          'Xiaohongshu (RED): category discovery and KOC marketing',
          'Zhihu: B2B and high-consideration categories',
          'Bilibili: Gen Z, long-form video and fandom',
        ],
      },
    ],
  },
  {
    icon: 'target',
    tab: 'Best practice',
    tabSub: 'What good brands do',
    image: '/Images/learn-china/masterclass/best-practice.png',
    imageAlt:
      'Chinese livestream eCommerce studio scene with a host presenting a product on camera, sales graph and viewer count overlaid',
    title: 'Best practice and case studies',
    lead: 'What the good brands actually do. What the failed launches got wrong. A plan you can take back to the office.',
    topics: [
      {
        h: 'Marketing in China',
        items: [
          'Influencer and KOL programmes that move the needle',
          'Multi-platform content strategy',
          'The Chinese promotional calendar: 618, Double 11, Chinese New Year, 38',
          'Budget allocation and ROI benchmarks',
        ],
      },
      {
        h: 'Case studies',
        items: [
          'Brands that grew, and why',
          'Expensive mistakes to avoid',
          'Local adaptations that changed the outcome',
          'Campaigns that went viral, broken down step by step',
        ],
      },
      {
        h: 'Getting things done',
        items: [
          'How to structure a China team, in-house or agency',
          'Selecting the right local partners and distributors',
          'Customer service and logistics fundamentals',
          'Regulatory and compliance essentials',
        ],
      },
      {
        h: 'Your action plan',
        items: [
          'Entry strategy workshop tied to your brief',
          'Budget planning and phasing',
          'A custom roadmap you leave the room with',
        ],
      },
    ],
  },
];

const formatIcon: Record<string, string> = {
  layers:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
  pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
  clock:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  package:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>',
  globe:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
  life: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="14.83" y1="9.17" x2="18.36" y2="5.64"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/></svg>',
};

const format = [
  {
    icon: 'layers',
    label: 'Content',
    body: 'Customised for your industry. Beauty, food and beverage, tourism, automotive, luxury, services. We rewrite examples and case studies to match the category you actually sell in.',
  },
  {
    icon: 'pin',
    label: 'Venue',
    body: 'Our consultants travel. Shanghai, Hong Kong, Paris, your office, your offsite. In person or remote.',
  },
  {
    icon: 'clock',
    label: 'Duration',
    body: 'Full day (8 hours), half day (4 hours), or a multi-session format spread across weeks.',
  },
  {
    icon: 'package',
    label: 'Deliverables',
    body: 'Complete course materials, the session deck, and access to the trainers for follow-up questions after the workshop.',
  },
  {
    icon: 'globe',
    label: 'Languages',
    body: 'English, French and Mandarin. Bilingual sessions are standard, not an upsell.',
  },
  {
    icon: 'life',
    label: 'Post-training',
    body: '30 days of follow-up support for in-house training: email Q&A, two video call sessions, and ongoing access to our market updates.',
  },
];

const faqs = [
  {
    cat: 'Programme',
    q: 'Do you customise the programme?',
    a: 'Yes. We start from your goals, your industry and your current level of China exposure, then build the programme around that. A short briefing call before the session is enough to tailor the modules, examples and case studies.',
  },
  {
    cat: 'Engagement',
    q: 'Can we work with you as consultants rather than trainers?',
    a: 'Yes. We also run strategic and operational consulting: digital audits, market entry strategy, distributor selection, eCommerce setup. The training often becomes the starting point of a longer engagement.',
  },
  {
    cat: 'Programme',
    q: 'Can we pick specific modules?',
    a: 'Yes. The programme is modular. Clients often run half-day sessions focused on WeChat, eCommerce platforms, social commerce, or KOL and influencer marketing alone.',
  },
  {
    cat: 'Programme',
    q: 'Can you go deeper on a specific topic?',
    a: 'Yes. We can spend a full session on Tmall Global strategy, livestream commerce, Douyin closed-loop, Xiaohongshu for beauty, or any other topic your team needs to dig into.',
  },
  {
    cat: 'Engagement',
    q: 'Do you run in-house corporate training?',
    a: 'Yes. We come to your office, adapt the content to your internal context, and run the session for your full team. In-house formats unlock the best discussions because everyone is working on the same business.',
  },
  {
    cat: 'Format',
    q: 'In which languages do you train?',
    a: 'English, French and Mandarin. Trainers are bilingual or trilingual, which helps on cultural and commercial nuance.',
  },
  {
    cat: 'Engagement',
    q: 'What support do you offer after the session?',
    a: 'For in-house training, 30 days of post-session support: email Q&A, two video call sessions for the team, and access to our market updates.',
  },
  {
    cat: 'Programme',
    q: 'What does a typical training day look like?',
    a: 'A mix of content modules, live case studies, structured Q&A, working exercises tied to your business, and a closing action plan. We keep the pace high and break regularly.',
  },
  {
    cat: 'Audience',
    q: 'Any prerequisites?',
    a: 'No technical prerequisites. A basic familiarity with digital marketing helps. A real project or interest in the Chinese market is the only thing we really need from the room.',
  },
  {
    cat: 'Pricing',
    q: 'How much does it cost?',
    a: 'Fees depend on format, duration, location and number of participants. Contact us for a tailored quote.',
  },
  {
    cat: 'Format',
    q: 'How many people can attend?',
    a: 'Between 8 and 30 in a working session. Smaller than 8, the room loses energy on discussion. Larger than 30, the exercises and breakouts stop working properly. For full-company days or conference keynotes (50 to 300 people) we run a lecture-format version with structured Q&A instead of group work.',
  },
  {
    cat: 'Format',
    q: 'How quickly can you run a session?',
    a: 'Two weeks of lead time is the comfortable range. We have run sessions on five working days notice when a board meeting moved. Tighter turnarounds cost flexibility on dates and trainer pairing, not on content quality.',
  },
  {
    cat: 'Format',
    q: 'Does it work remotely, or only in person?',
    a: 'Both. About half of in-house sessions now run remote or hybrid. Remote works best in 3 to 4 hour blocks across two days rather than one long Zoom marathon. In person still wins when the team needs to break into working groups or whiteboard a strategy.',
  },
  {
    cat: 'Format',
    q: 'Can we record the session for colleagues who cannot attend?',
    a: 'Yes, for internal use. We ask that the recording stays inside your company, off public channels, and is not repackaged into external commercial content. Slides and supporting materials come with you either way.',
  },
  {
    cat: 'Programme',
    q: 'What should we prepare beforehand?',
    a: 'A short brief on your current China activity, what you do not know yet, and the three or four questions you most want answered. Plus any internal data you are happy to share: channel mix, current agency setup, recent campaign results, distributor structure. The more concrete the input, the sharper the working session output.',
  },
  {
    cat: 'Audience',
    q: 'Which industries have you trained?',
    a: 'Beauty, fashion, luxury, food and beverage, tourism, automotive, professional services, B2B industrial, large tech and SaaS players. Platform mechanics are mostly the same across categories. What changes is the case studies, benchmarks and tactics we plug in.',
  },
  {
    cat: 'Audience',
    q: 'We are completely new to China. Is this too advanced?',
    a: 'No. Module 1 is built for teams starting from zero. We calibrate depth during the briefing call. A beginner room spends more time on platform basics and consumer behaviour. A senior room moves faster through the map and digs into operations and budget allocation.',
  },
  {
    cat: 'Audience',
    q: 'We already run a China office. Is there anything in this for us?',
    a: 'Yes. A good share of our in-house clients are teams who have been operating in market for years. For them the value sits in benchmarking, fresh category data, and an outside diagnostic on the parts of their setup that are quietly under-performing. The agenda tilts toward audit and operations, away from introduction.',
  },
  {
    cat: 'Engagement',
    q: 'Do you sign NDAs?',
    a: 'Yes. Before any briefing call that touches your numbers. Internal data and strategy stay in the room. Nothing surfaces in another client deck or public case study.',
  },
  {
    cat: 'Programme',
    q: 'How current is the material?',
    a: 'Refreshed before every session. Anything older than the most recent full quarter gets flagged or removed. Chinese platforms change fees, formats and algorithms several times a year, so we treat stale slides as a real risk and plan the prep around it.',
  },
];

const faqCategories = ['All', 'Programme', 'Format', 'Audience', 'Engagement', 'Pricing'];
---

<Layout
  title="China Digital & eCommerce Masterclass | TheChinaPath"
  description="A practitioner-led masterclass on China's digital ecosystem, eCommerce platforms, consumer behaviour and campaign mechanics. Customised for your category and your team."
>
  <div class="mc-progress" aria-hidden="true"><div class="mc-progress__bar"></div></div>

  <article class="mc">
    {/* ---------- HERO (cinematic) ---------- */}
    <section class="mc-hero cbs-hero" data-hero>
      <div class="mc-hero__bg" aria-hidden="true" data-parallax>
        <img
          src="/Images/CyrilMasterclass.jpg"
          alt="Cyril Drouin on stage at the Shanghai International MCN Conference"
        />
      </div>
      <div class="mc-hero__overlay" aria-hidden="true"></div>
      <div class="mc-hero__grain" aria-hidden="true"></div>

      <div class="container mc-hero__inner">
        <nav class="mc-hero__crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/learn-china">Learn China</a>
        </nav>

        <span class="eyebrow eyebrow--on-dark mc-reveal">Learn China · Masterclass</span>

        <h1 class="mc-hero__title mc-reveal" style="--reveal-delay: 80ms;">
          <span class="mc-hero__title-row">A China masterclass</span>
          <span class="mc-hero__title-row mc-hero__title-row--accent">taught by operators,</span>
          <span class="mc-hero__title-row">not by</span>
          <span class="mc-hero__title-row mc-hero__title-row--highlight">ex-consultants.</span>
        </h1>

        <p class="mc-hero__lead mc-reveal" style="--reveal-delay: 200ms;">
          A concentrated training programme on China's digital and eCommerce ecosystem. Platforms,
          consumer behaviour, campaign mechanics. Tailored to your industry, delivered by operators
          with 20 years on the ground.
        </p>

        <div class="mc-hero__actions mc-reveal" style="--reveal-delay: 280ms;">
          <a href="/contact" class="btn btn--primary mc-magnetic">Book a masterclass</a>
          <a href="#curriculum" class="btn btn--ghost-light mc-magnetic">See the curriculum</a>
        </div>

        <div class="mc-hero__meta mc-reveal" style="--reveal-delay: 360ms;">
          {
            heroStats.map((s) => (
              <div class="mc-hero__meta-item">
                <span class="mc-hero__meta-num" data-counter={s.value} data-suffix={s.suffix}>
                  0
                </span>
                <span class="mc-hero__meta-label">{s.label}</span>
              </div>
            ))
          }
        </div>

        <ul
          class="mc-hero__badges mc-reveal"
          aria-label="Where we have trained"
          style="--reveal-delay: 440ms;"
        >
          {heroBadges.map((b) => <li>{b}</li>)}
        </ul>
      </div>

      <a href="#why" class="mc-hero__scroll" aria-label="Scroll to next section">
        <span class="mc-hero__scroll-line"></span>
        <span class="mc-hero__scroll-text">Scroll</span>
      </a>
    </section>

    {/* ---------- WHY / AUDIENCE ---------- */}
    <section id="why" class="section section--alt">
      <div class="container">
        <div class="mc-value">
          <div class="mc-value__copy mc-reveal">
            <span class="eyebrow">Why this training</span>
            <h2>Understand how China really works, not how a report says it works.</h2>
            <p>
              This is a deep dive into how China's digital and online shopping ecosystem operates in
              practice. You leave with a clear view of the platforms, the consumer behaviour that
              moves sales, and the mechanics of a campaign that actually converts.
            </p>
            <p>
              No recycled trend slides. No playbook translated from the US. Numbers get refreshed
              before every session because the market moves fast enough that last quarter's deck is
              already wrong.
            </p>
          </div>

          <aside
            class="mc-promise mc-reveal"
            style="--reveal-delay: 120ms;"
            aria-label="Who this training is for"
          >
            <span class="eyebrow">Who it's for</span>
            <ul class="mc-promise__list">
              {
                audience.map((a) => (
                  <li class="mc-promise__item">
                    <span class="mc-promise__check" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="5 12 10 17 19 8" />
                      </svg>
                    </span>
                    <span>{a}</span>
                  </li>
                ))
              }
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {/* ---------- WHAT YOU TAKE AWAY (bento) ---------- */}
    <section class="section mc-take-section">
      <div class="container">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">What you take away</span>
          <h2>Training that stays useful after you leave the room.</h2>
          <p class="section-header__lead">
            Five reasons teams keep coming back. The first one is what most other trainings cannot
            offer.
          </p>
        </header>

        <div class="mc-bento">
          {
            takeaways.map((t, i) =>
              t.feature ? (
                <article class="mc-bento__card mc-bento__card--feature mc-reveal">
                  <img
                    class="mc-bento__feature-img"
                    src="/Images/work/pierre-fabre.png"
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="mc-bento__feature-bg" aria-hidden="true" />
                  <div class="mc-bento__feature-body">
                    <span class="mc-bento__chip">The difference</span>
                    <h3>{t.h}</h3>
                    <p>{t.p}</p>
                    <ul class="mc-bento__feature-stats">
                      <li>
                        <span class="mc-bento__stat-num">
                          20<span>+</span>
                        </span>
                        <span class="mc-bento__stat-label">years on the ground</span>
                      </li>
                      <li>
                        <span class="mc-bento__stat-num">
                          100<span>%</span>
                        </span>
                        <span class="mc-bento__stat-label">operator-led, every session</span>
                      </li>
                    </ul>
                  </div>
                </article>
              ) : (
                <article
                  class="mc-bento__card mc-bento__card--small mc-reveal"
                  style={`--reveal-delay: ${i * 70}ms;`}
                >
                  <h3>{t.h}</h3>
                  <p>{t.p}</p>
                </article>
              ),
            )
          }
        </div>
      </div>
    </section>

    {/* ---------- CURRICULUM (tabbed) ---------- */}
    <section class="section section--alt" id="curriculum">
      <div class="container">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">Curriculum</span>
          <h2>Three modules. Your pick of depth, your pick of format.</h2>
          <p class="section-header__lead">
            Delivered as a full day, split across half-day sessions, or configured into a longer
            programme. Depth on the topics that matter to your category, summary on the ones that do
            not.
          </p>
        </header>

        <div class="mc-curriculum mc-reveal" data-mc-tabs>
          <div class="mc-curriculum__nav" role="tablist" aria-label="Curriculum modules">
            {
              modules.map((m, i) => (
                <button
                  type="button"
                  class={`mc-curriculum__tab${i === 0 ? ' is-active' : ''}`}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls={`mc-module-panel-${i}`}
                  id={`mc-module-tab-${i}`}
                  data-tab-target={`mc-module-panel-${i}`}
                >
                  <span
                    class="mc-curriculum__tab-icon"
                    aria-hidden="true"
                    set:html={moduleIcon[m.icon]}
                  />
                  <span class="mc-curriculum__tab-body">
                    <span class="mc-curriculum__tab-label">{m.tab}</span>
                    <span class="mc-curriculum__tab-sub">{m.tabSub}</span>
                  </span>
                </button>
              ))
            }
            <span class="mc-curriculum__indicator" aria-hidden="true"></span>
          </div>

          <div class="mc-curriculum__panels">
            {
              modules.map((m, i) => (
                <div
                  class={`mc-curriculum__panel${i === 0 ? ' is-active' : ''}`}
                  role="tabpanel"
                  id={`mc-module-panel-${i}`}
                  aria-labelledby={`mc-module-tab-${i}`}
                  hidden={i !== 0}
                >
                  <div class="mc-curriculum__panel-grid">
                    <aside class="mc-curriculum__lead" data-tilt>
                      <figure class="mc-curriculum__lead-figure">
                        <img
                          src={m.image}
                          alt={m.imageAlt}
                          loading="lazy"
                          decoding="async"
                          width="640"
                          height="800"
                        />
                        <span class="mc-curriculum__lead-tag">
                          <span
                            class="mc-curriculum__lead-tag-icon"
                            aria-hidden="true"
                            set:html={moduleIcon[m.icon]}
                          />
                          <span class="mc-curriculum__lead-tag-text">{m.tab}</span>
                        </span>
                        <div class="mc-curriculum__lead-poster">
                          <span class="mc-curriculum__lead-eyebrow">Module</span>
                          <h3 class="mc-curriculum__lead-title">{m.title}</h3>
                        </div>
                      </figure>

                      <div class="mc-curriculum__lead-body">
                        <p class="mc-curriculum__lead-desc">{m.lead}</p>
                        <div class="mc-curriculum__lead-meta">
                          <span class="mc-curriculum__lead-meta-stat">
                            <span class="mc-curriculum__lead-meta-num">{m.topics.length}</span>
                            <span class="mc-curriculum__lead-meta-label">topics</span>
                          </span>
                          <span class="mc-curriculum__lead-meta-divider" aria-hidden="true" />
                          <span class="mc-curriculum__lead-meta-stat">
                            <span class="mc-curriculum__lead-meta-num">½ &middot; 1</span>
                            <span class="mc-curriculum__lead-meta-label">day formats</span>
                          </span>
                        </div>
                        <a
                          href="/contact"
                          class="btn btn--primary btn--sm mc-magnetic mc-curriculum__lead-cta"
                        >
                          <span>Tailor this module</span>
                          <span class="mc-curriculum__lead-cta-arrow" aria-hidden="true">
                            →
                          </span>
                        </a>
                      </div>
                    </aside>

                    <div class="mc-curriculum__topics">
                      {m.topics.map((t) => (
                        <div class="mc-curriculum__topic">
                          <h4 class="mc-curriculum__topic-title">{t.h}</h4>
                          <ul class="mc-curriculum__topic-list">
                            {t.items.map((i) => (
                              <li>{i}</li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* ---------- TRAINERS ---------- */}
    <section class="section mc-trainers-section">
      <div class="container">
        <div class="mc-trainers">
          <div class="mc-trainers__copy mc-reveal">
            <span class="eyebrow">Who teaches it</span>
            <h2>Operators, not academics.</h2>
            <p>
              Cyril has been training executives on China's digital market in English and French for
              more than a decade. Liyan runs the same programme for Mandarin-speaking audiences.
              Together they have trained at HEC MBA, ESCP MBA, the European Chamber of Commerce in
              China, the American Chamber, Business France and Shanghai Jiaotong Executive MBA.
            </p>
            <div class="mc-trainers__actions">
              <a href="/about" class="btn btn--secondary">Meet the team</a>
              <a href="/contact" class="btn btn--ghost">Talk to a trainer</a>
            </div>
          </div>

          <ul
            class="mc-trainers__list mc-reveal"
            style="--reveal-delay: 120ms;"
            aria-label="Lead trainers"
          >
            <li class="mc-trainer">
              <span class="mc-trainer__avatar">
                <img
                  src="/Images/team/cyril-drouin.jpg"
                  alt="Portrait of Cyril Drouin"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <div class="mc-trainer__body">
                <span class="mc-trainer__name">Cyril Drouin</span>
                <span class="mc-trainer__role">Founder & CEO</span>
                <span class="mc-trainer__meta">Shanghai / Paris</span>
                <span class="mc-trainer__langs">English · French</span>
              </div>
            </li>
            <li class="mc-trainer">
              <span class="mc-trainer__avatar">
                <img
                  src="/Images/team/liyan-ye.jpg"
                  alt="Portrait of Liyan Ye"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <div class="mc-trainer__body">
                <span class="mc-trainer__name">Liyan Ye</span>
                <span class="mc-trainer__role">Senior Director</span>
                <span class="mc-trainer__meta">Shanghai</span>
                <span class="mc-trainer__langs">Mandarin · English</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    {/* ---------- FORMAT / LOGISTICS (spec sheet) ---------- */}
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">Format and logistics</span>
          <h2>Built around your team's schedule.</h2>
          <p class="section-header__lead">
            Six knobs you turn before we walk in the room. Content, venue, timing, language,
            deliverables, and what we keep doing after the session ends.
          </p>
        </header>

        <div class="mc-spec mc-reveal">
          <div class="mc-spec__header" aria-hidden="true">
            <span class="mc-spec__header-eyebrow">Programme sheet</span>
            <span class="mc-spec__header-dot"></span>
            <span class="mc-spec__header-eyebrow mc-spec__header-eyebrow--muted"
              >Six variables, fully flexible</span
            >
          </div>
          <dl class="mc-spec__list">
            {
              format.map((f, i) => (
                <div class="mc-spec__row" style={`--row-delay: ${i * 40}ms;`}>
                  <dt class="mc-spec__key">
                    <span class="mc-spec__icon" aria-hidden="true" set:html={formatIcon[f.icon]} />
                    <span class="mc-spec__label">{f.label}</span>
                  </dt>
                  <dd class="mc-spec__value">{f.body}</dd>
                </div>
              ))
            }
          </dl>
          <footer class="mc-spec__footer">
            <span class="mc-spec__footer-text"
              >Need a different shape? We will build the brief around it.</span
            >
            <a href="/contact" class="mc-spec__footer-link"
              >Talk to us <span aria-hidden="true">→</span></a
            >
          </footer>
        </div>
      </div>
    </section>

    {/* ---------- FAQ (with category filter) ---------- */}
    <section class="section">
      <div class="container container--narrow">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">FAQ</span>
          <h2>Twenty questions we get every week.</h2>
          <p class="section-header__lead">
            Practical questions from teams sizing up a masterclass. Filter by topic.
          </p>
        </header>

        <div
          class="mc-faq-filter mc-reveal"
          data-faq-filter
          role="tablist"
          aria-label="Filter FAQs by category"
        >
          {
            faqCategories.map((c, i) => (
              <button
                type="button"
                class={`mc-faq-chip${i === 0 ? ' is-active' : ''}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-faq-cat={c}
              >
                <span class="mc-faq-chip__label">{c}</span>
                <span class="mc-faq-chip__count">
                  {c === 'All' ? faqs.length : faqs.filter((f) => f.cat === c).length}
                </span>
              </button>
            ))
          }
        </div>

        <div class="mc-faq" data-faq-list>
          {
            faqs.map((f, i) => (
              <details
                class="mc-faq__item mc-reveal"
                data-faq-cat={f.cat}
                open={i === 0}
                style={`--reveal-delay: ${Math.min(i, 6) * 40}ms;`}
              >
                <summary class="mc-faq__q">
                  <span class="mc-faq__cat-tag">{f.cat}</span>
                  <span class="mc-faq__q-text">{f.q}</span>
                  <span class="mc-faq__icon" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </span>
                </summary>
                <div class="mc-faq__a">
                  <p>{f.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- FINAL CTA ---------- */}
    <CaseStudyStrip slugs={["pierre-fabre","langnese","valio"]} />

    <section class="section section--tight">
      <div class="container container--narrow">
        <div class="mc-cta">
          <span class="eyebrow eyebrow--on-dark">Get in touch</span>
          <h2 class="mc-cta__title">Thinking about a China masterclass for your team?</h2>
          <p class="mc-cta__lead">
            Tell us about your team, your category and what you want to walk away with. We will come
            back within one business day with a tailored programme.
          </p>
          <div class="mc-cta__actions">
            <a href="/contact" class="btn mc-cta__btn-primary">Book a masterclass</a>
            <a href="/work" class="btn mc-cta__btn-ghost">See our case studies</a>
          </div>
        </div>
      </div>
    </section>
  </article>
</Layout>

