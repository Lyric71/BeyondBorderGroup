          <div class="studio__hero-visual" data-parallax>
            <figure class="studio__frame studio__frame--main">
              <img src="/Images/hub-studio/creative.jpg" alt="" loading="lazy" decoding="async" />
              <figcaption class="studio__frame-meta">
                <span class="studio__rec" aria-hidden="true"></span>
                <span class="studio__frame-meta-label">Aufnahme läuft</span>
                <span class="studio__frame-meta-sub">Studio · Shanghai</span>
              </figcaption>
            </figure>
            <figure class="studio__frame studio__frame--sub" aria-hidden="true">
              <img src="/Images/hub-studio/production.jpg" alt="" loading="lazy" decoding="async" />
            </figure>
            <div class="studio__brace studio__brace--tl" aria-hidden="true"></div>
            <div class="studio__brace studio__brace--br" aria-hidden="true"></div>
          </div>
        </div>

        {/* ----- Capability switcher ----- */}
        <div class="studio__switch" data-reveal>
          <div class="studio__tabs" role="tablist" aria-label="Hub-Studio-Kompetenzen">
            <span class="studio__tabs-indicator" aria-hidden="true"></span>
            <button
              type="button"
              class="studio__tab is-active"
              role="tab"
              data-tab="creative"
              aria-selected="true"
              aria-controls="studio-panel-creative"
              id="studio-tab-creative"
            >
              <span class="studio__tab-mark" aria-hidden="true"></span>
              <span class="studio__tab-label">Kreation</span>
              <span class="studio__tab-sub">Konzept und Art-Direction</span>
            </button>
            <button
              type="button"
              class="studio__tab"
              role="tab"
              data-tab="production"
              aria-selected="false"
              aria-controls="studio-panel-production"
              id="studio-tab-production"
            >
              <span class="studio__tab-mark" aria-hidden="true"></span>
              <span class="studio__tab-label">Produktion</span>
              <span class="studio__tab-sub">Foto, Film, Live</span>
            </button>
            <button
              type="button"
              class="studio__tab"
              role="tab"
              data-tab="ai"
              aria-selected="false"
              aria-controls="studio-panel-ai"
              id="studio-tab-ai"
            >
              <span class="studio__tab-mark" aria-hidden="true"></span>
              <span class="studio__tab-label">KI-Produktion</span>
              <span class="studio__tab-sub">Maßgeschneiderte Modelle</span>
            </button>
          </div>

          <div class="studio__panels">
            <article
              class="studio__panel is-active"
              data-panel="creative"
              id="studio-panel-creative"
              role="tabpanel"
              aria-labelledby="studio-tab-creative"
            >
              <div class="studio__panel-visual">
                <img src="/Images/hub-studio/creative.jpg" alt="" loading="lazy" decoding="async" />
                <div class="studio__tags">
                  <span>Konzept</span>
                  <span>Art-Direction</span>
                  <span>Key Visuals</span>
                </div>
              </div>
              <div class="studio__panel-copy">
                <span class="studio__panel-kicker">
                  <span class="studio__panel-kicker-dot" aria-hidden="true"></span>
                  Kreation
                </span>
                <h3 class="studio__panel-title">Konzept und Art-Direction.</h3>
                <p class="studio__panel-body">
                  Key Visuals, Kampagnenideen, Verpackung, OOH. Konzipiert für Xiaohongshu, Douyin,
                  WeChat und Tmall, also dort, wo Ihre Käufer wirklich unterwegs sind.
                </p>
                <ul class="studio__list">
                  <li>Kreativ-Direktion im Dienst der Marke</li>
                  <li>Key Visuals, plattformgerecht entwickelt</li>
                  <li>Verpackungs- und OOH-Systeme</li>
                </ul>
              </div>
            </article>

            <article
              class="studio__panel"
              data-panel="production"
              id="studio-panel-production"
              role="tabpanel"
              aria-labelledby="studio-tab-production"
              hidden
            >
              <div class="studio__panel-visual">
                <img
                  src="/Images/hub-studio/production.jpg"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <div class="studio__tags">
                  <span>Foto</span>
                  <span>Film</span>
                  <span>Livestream</span>
                </div>
              </div>
              <div class="studio__panel-copy">
                <span class="studio__panel-kicker">
                  <span class="studio__panel-kicker-dot" aria-hidden="true"></span>
                  Produktion
                </span>
                <h3 class="studio__panel-title">Foto, Film, Livestream.</h3>
                <p class="studio__panel-body">
                  Festes Team in Shanghai. Drehs in Peking, Shenzhen oder Guangzhou, wenn das
                  Briefing es verlangt. Studiotage, Außendrehs, Crew und Schnitt bleiben im Haus.
                </p>
                <ul class="studio__list">
                  <li>Studio- und Außendrehs</li>
                  <li>Volle Crew, Schnitt unter einem Dach</li>
                  <li>Livestream-Sets und Live-Betrieb</li>
                </ul>
              </div>
            </article>

            <article
              class="studio__panel"
              data-panel="ai"
              id="studio-panel-ai"
              role="tabpanel"
              aria-labelledby="studio-tab-ai"
              hidden
            >
              <div class="studio__panel-visual">
                <img src="/Images/hub-studio/aigc.jpg" alt="" loading="lazy" decoding="async" />
                <div class="studio__tags">
                  <span>AIGC</span>
                  <span>Neueste Modelle</span>
                  <span>Volumen</span>
                </div>
              </div>
              <div class="studio__panel-copy">
                <span class="studio__panel-kicker">
                  <span class="studio__panel-kicker-dot" aria-hidden="true"></span>
                  KI-Produktion
                </span>
                <h3 class="studio__panel-title">AIGC, auf den besten Modellen.</h3>
                <p class="studio__panel-body">
                  KI-generierte Inhalte, gefahren auf den besten Text-zu-Bild- und Video-Modellen am
                  Markt. Produkt, Mode, Lifestyle, Social, eCommerce in hoher Stückzahl. Jedes Bild
                  läuft vor der Veröffentlichung über ein menschliches Auge.
                </p>
                <ul class="studio__list">
                  <li>Aktuelle Text-zu-Bild- und Video-Modelle</li>
                  <li>Eigener Look und Stil der Marke</li>
                  <li>Menschliche Endkontrolle jedes Bildes</li>
                </ul>
              </div>
            </article>
          </div>
        </div>

        {/* ----- Capability ribbon ----- */}
        <div class="studio__ribbon" aria-hidden="true">
          <div class="studio__ribbon-track">
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Foto</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Film</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Livestream</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>KI-Pipelines</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Packaging</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>OOH</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Markenvisuals</span>
            <span class="studio__chip"
              ><span class="studio__chip-bullet"></span>Social-first-Schnitte</span
            >
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Foto</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Film</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Livestream</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>KI-Pipelines</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Packaging</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>OOH</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Markenvisuals</span>
            <span class="studio__chip"
              ><span class="studio__chip-bullet"></span>Social-first-Schnitte</span
            >
          </div>
        </div>

        {/* ----- Footer CTA ----- */}
        <div class="studio__foot" data-reveal>
          <a class="studio__cta" href="/de/in-china-wachsen/produktionsstudio">
            <span class="studio__cta-text">Produktionen ansehen</span>
            <span class="studio__cta-arrow" aria-hidden="true">
              <svg
                width="22"
                height="14"
                viewBox="0 0 22 14"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M1 7H21M21 7L15 1M21 7L15 13"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
          <a
            class="studio__cta studio__cta--secondary"
            href="https://www.hubstudio.ai"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="studio__cta-text">Oder direkt auf hubstudio.ai</span>
            <span class="studio__cta-external" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- OUR WORK ---------- */}
  <section class="section section--alt">
    <div class="container">
      <header class="section-header section-header--split">
        <div>
          <span class="eyebrow">Referenzen</span>
          <h2>Marken, die wir mit nach China genommen haben</h2>
        </div>
        <a href="/de/referenzen" class="btn btn--secondary btn--sm">Alle Fallstudien</a>
      </header>

      <div class="grid grid-3">
        {
          featuredCases.map((c) => (
            <a href={`/de/referenzen/${c.id}`} class="work-card">
              <div class="work-card__image">
                <img
                  src={c.data.heroImage}
                  alt={c.data.heroImageAlt || `Fallstudie ${c.data.brand}`}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="400"
                />
              </div>
              <div class="work-card__body">
                <span class="work-card__tag">{c.data.category}</span>
                <h3 class="work-card__title">{c.data.brand}</h3>
                <p class="work-card__summary">{c.data.title}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- INSIGHTS ---------- */}
  <section class="section">
    <div class="container">
      <header class="insights-header">
        <span class="insights-header__rule" aria-hidden="true"></span>
        <span class="eyebrow">Analysen</span>
        <h2>Unsere Lesart des chinesischen Marktes, frisch aus dem Tagesgeschäft.</h2>
      </header>

      <div class="grid grid-3">
        {
          latestInsights.map((post) => (
            <a href={`/de/analysen/${slugFor(post.id)}`} class="insight-card">
              <div class="insight-card__image">
                {post.data.heroImage && (
                  <img
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt}
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="400"
                  />
                )}
              </div>
              <div class="insight-card__body">
                <span class="insight-card__tag">
                  {insightCategoryDe[post.data.category] ?? post.data.category}
                </span>
                <h3 class="insight-card__title">{post.data.title}</h3>
                <div class="insight-card__meta">
                  <span>{readingTime(post.body)}</span>
                  {post.data.pubDate && (
                    <>
                      <span class="insight-card__meta-sep" aria-hidden="true">
                        |
                      </span>
                      <span>{formatInsightDate(post.data.pubDate)}</span>
                    </>
                  )}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- FINAL CTA CARD ---------- */}
  <section class="section section--tight">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__copy">
          <span class="eyebrow">Auf einen Kaffee?</span>
          <h2>Sie denken über China nach? Reden wir bei einem Kaffee darüber.</h2>
          <p class="cta-card__lead">
            Sagen Sie uns, wo Sie stehen und wohin Sie wollen. Es antwortet jemand aus dem
            Senior-Team. Kein Chatbot, kein Verkaufstrichter.
          </p>
          <div class="cta-card__actions">
            <a href="/de/kontakt" class="btn btn--primary">Gespräch beginnen</a>
          </div>
        </div>

        <div class="cta-card__visual" aria-hidden="true">
          <div class="hello-stack">
            <article class="hello-card hello-card--1">
              <header class="hello-card__head">
                <span class="hello-card__avatar">上</span>
                <div>
                  <span class="hello-card__city">Shanghai</span>
                  <span class="hello-card__role">Betrieb</span>
                </div>
                <span class="hello-card__dot" title="online"></span>
              </header>
              <p class="hello-card__hi">
                <span class="hello-card__zh">你好</span>
                <span class="hello-card__latin">Nǐ hǎo</span>
              </p>
            </article>

            <article class="hello-card hello-card--2">
              <header class="hello-card__head">
                <span class="hello-card__avatar">港</span>
                <div>
                  <span class="hello-card__city">Hongkong</span>
                  <span class="hello-card__role">Cross-Border</span>
                </div>
                <span class="hello-card__dot" title="online"></span>
              </header>
              <p class="hello-card__hi">
                <span class="hello-card__zh">你好</span>
                <span class="hello-card__latin">Neih hóu</span>
              </p>
            </article>

            <article class="hello-card hello-card--3">
              <header class="hello-card__head">
                <span class="hello-card__avatar">P</span>
                <div>
                  <span class="hello-card__city">Paris</span>
                  <span class="hello-card__role">Markteintritt</span>
                </div>
                <span class="hello-card__dot" title="online"></span>
              </header>
              <p class="hello-card__hi"><span class="hello-card__zh">Hallo</span></p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <HomeAssets />
</Layout>
