const allCases = await getCollection('casesDe', ({ data }) => !data.draft);
const featuredCases = allCases
  .slice()
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const allInsights = await getCollection('insightsDe', ({ data }) => !data.draft);

const insightCategoryDe: Record<string, string> = {
  'Platforms': 'Plattformen',
  'E-Commerce': 'eCommerce',
  'KOLs & Livestream': 'KOL und Livestream',
  'Brand & Localization': 'Marke und Lokalisierung',
  'AI & Innovation': 'KI und Innovation',
  'Market Strategy': 'Marktstrategie',
  'Compliance & Setup': 'Compliance und Aufbau',
};

const latestInsights = allInsights
  .slice()
  .sort((a, b) => {
    const da = a.data.pubDate?.valueOf() ?? 0;
    const db = b.data.pubDate?.valueOf() ?? 0;
    return db - da;
  })
  .slice(0, 3);

function readingTime(body: string | undefined) {
  if (!body) return '';
  const words = body.trim().split(/\s+/).length;
  return `${Math.max(1, Math.round(words / 200))} Min. Lesezeit`;
}

function formatInsightDate(d?: Date) {
  if (!d) return '';
  return d.toLocaleDateString('de-DE', { month: 'short', year: 'numeric' });
}

---

<Layout
  title="Marketing- und eCommerce-Agentur in China | Beyond Border Group"
  description="Marketing-, eCommerce- und Vertriebsagentur für internationale Marken in China. Wir führen Tmall, JD, Douyin, WeChat und RED im Tagesgeschäft. Shanghai, Hongkong, Paris."
>

  {/* ---------- SCROLL PROGRESS ---------- */}
  <div class="home-progress" aria-hidden="true"><div class="home-progress__bar"></div></div>

  {/* ---------- HERO ---------- */}
  <section class="home-hero" data-home-hero>
    <div class="home-hero__bg" aria-hidden="true" data-home-parallax>
      <picture>
        <source srcset="/Images/hero-livestream.webp" type="image/webp" />
        <img
          src="/Images/hero-livestream.jpg"
          alt=""
          width="1376"
          height="768"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>
    <div class="home-hero__overlay" aria-hidden="true"></div>
    <div class="home-hero__grain" aria-hidden="true"></div>

    <div class="container home-hero__inner">
      <span class="eyebrow eyebrow--on-dark home-reveal">Marketing und eCommerce in China</span>
      <h1 class="home-hero__title home-reveal" style="--reveal-delay: 80ms;">
        <span class="home-hero__title-row">In China verkaufen.</span>
        <span class="home-hero__title-row home-hero__title-row--accent">Dort wachsen.</span>
        <span class="home-hero__title-row home-hero__title-row--highlight">China verstehen.</span>
      </h1>
      <p class="home-hero__lead home-reveal" style="--reveal-delay: 200ms;">
        Wir bringen Marken in China auf den Markt. Shops auf Tmall und JD, Social Commerce
        auf Douyin und RED, und der passende Vertriebspartner für Ihre Kategorie.
      </p>
      <div class="home-hero__actions home-reveal" style="--reveal-delay: 280ms;">
        <a class="btn btn--primary home-magnetic" href="/de/kontakt">Sprechen wir</a>
        <a class="btn btn--ghost-light home-magnetic" href="/de/referenzen">Unsere Arbeit ansehen</a>
      </div>

      <div class="home-hero__meta home-reveal" style="--reveal-delay: 360ms;">
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num" data-home-counter="20" data-suffix="+">0</span>
          <span class="home-hero__meta-label">Jahre vor Ort</span>
        </div>
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num" data-home-counter="75" data-suffix="+">0</span>
          <span class="home-hero__meta-label">Markenlaunches</span>
        </div>
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num">Millionen</span>
          <span class="home-hero__meta-label">GMV unter Management</span>
        </div>
      </div>
    </div>

    <a href="#day-commerce" class="home-hero__scroll" aria-label="Zum nächsten Abschnitt scrollen">
      <span class="home-hero__scroll-line"></span>
      <span class="home-hero__scroll-text">Scrollen</span>
    </a>
  </section>

  {/* ---------- DAY IN CHINESE COMMERCE ---------- */}
  <section id="day-commerce" class="section day-timeline-section">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Ein Tag im chinesischen Handel</span>
        <h2>Ihre Marke, in jedem Moment des Tages</h2>
        <p class="section-header__lead">
          Vom Morgen bis zum Abend wechseln chinesische Verbraucher zwischen einem halben
          Dutzend Apps. Jede hat ihre eigene Zielgruppe und ihre eigenen Regeln.
        </p>
      </header>

      <ol class="day-timeline" aria-label="Ein Tag auf chinesischen Plattformen">
        {dayStops.map((s) => (
          <li class="day-stop">
            <figure class="day-stop__photo">
              <img src={s.photo} alt="" loading="lazy" decoding="async" />
            </figure>
            <div class="day-stop__info">
              <span class="day-stop__time">{s.time}</span>
              <span class="day-stop__moment">{s.moment}</span>
              <span class="day-stop__platform">
                <img class="day-stop__logo" src={s.logo} alt="" loading="lazy" decoding="async" />
                <span class="day-stop__platform-text">
