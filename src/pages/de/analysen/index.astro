---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { INSIGHT_CATEGORIES } from '../../../content.config';
import { insightEnToDe } from '../../../i18n/insight-slugs.mjs';

const slugMap = insightEnToDe as Record<string, string>;

const allInsights = await getCollection('insights', ({ data }) => !data.draft);

const sorted = allInsights.sort((a, b) => {
  const da = a.data.pubDate?.valueOf() ?? 0;
  const db = b.data.pubDate?.valueOf() ?? 0;
  if (db !== da) return db - da;
  return a.data.title.localeCompare(b.data.title, 'de');
});

const categoryLabelsDe: Record<string, string> = {
  'Platforms': 'Plattformen',
  'E-Commerce': 'eCommerce',
  'KOLs & Livestream': 'KOL und Livestream',
  'Brand & Localization': 'Marke und Lokalisierung',
  'AI & Innovation': 'KI und Innovation',
  'Market Strategy': 'Marktstrategie',
  'Compliance & Setup': 'Compliance und Aufbau',
};

function readingTime(body: string | undefined) {
  if (!body) return '';
  const words = body.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.round(words / 200));
  return `${minutes} Min. Lesezeit`;
}

function formatDate(d?: Date) {
  if (!d) return '';
  return d.toLocaleDateString('de-DE', { month: 'short', year: 'numeric' });
}

const categoryCounts = new Map<string, number>();
for (const post of sorted) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}

const categories = INSIGHT_CATEGORIES.filter((c) => (categoryCounts.get(c) ?? 0) > 0).map((c) => ({
  value: c,
  label: categoryLabelsDe[c] ?? c,
  count: categoryCounts.get(c) ?? 0,
}));

const slugFor = (enSlug: string) => slugMap[enSlug] ?? enSlug;
---

<Layout
  title="Analysen | Beyond Border Group"
  description="Analysen des chinesischen eCommerce, der digitalen Plattformen und der Markenstrategie. Vom Team, das Marken auf Tmall, JD, Douyin, WeChat und RED aus Shanghai, Hongkong und Paris steuert."
>
  <section class="insights-intro">
    <div class="container">
      <span class="eyebrow">Analysen</span>
      <h1>China, direkt vom Boden.</h1>
      <p class="lead">
        Das Team, das Marken auf Tmall, JD, Douyin, WeChat und RED bedient, schreibt selbst. Aus Shanghai, Hongkong und Paris. Nie aus einer abgehobenen Kanzlei.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {categories.length > 1 && (
        <div class="insights-filter" role="tablist" aria-label="Nach Kategorie filtern">
          <button type="button" class="insights-filter__btn is-active" data-category="all" role="tab" aria-selected="true">
            <span class="insights-filter__label">Alle</span>
            <span class="insights-filter__count" aria-hidden="true">{sorted.length}</span>
          </button>
          {categories.map((c) => (
            <button type="button" class="insights-filter__btn" data-category={c.value} role="tab" aria-selected="false">
              <span class="insights-filter__label">{c.label}</span>
              <span class="insights-filter__count" aria-hidden="true">{c.count}</span>
            </button>
          ))}
        </div>
      )}

      <div class="grid grid-3 insights-grid">
        {sorted.map((post) => (
          <a
            href={`/de/analysen/${slugFor(post.id)}`}
            class="insight-card"
            data-category={post.data.category}
          >
            <div class="insight-card__image">
              {post.data.heroImage && (
                <img
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="400"
                />
              )}
            </div>
            <div class="insight-card__body">
              <span class="insight-card__tag">{categoryLabelsDe[post.data.category] ?? post.data.category}</span>
              <h3 class="insight-card__title">{post.data.title}</h3>
              <div class="insight-card__meta">
                <span class="insight-card__author">{post.data.author}</span>
                <span class="insight-card__meta-sep" aria-hidden="true">|</span>
                <span>{readingTime(post.body)}</span>
                {post.data.pubDate && (
                  <>
                    <span class="insight-card__meta-sep" aria-hidden="true">|</span>
                    <span>{formatDate(post.data.pubDate)}</span>
                  </>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>

      <p class="insights-empty" hidden={sorted.length !== 0}>
        Die Archive kommen zurück. Es dauert noch ein paar Tage.
      </p>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('.insights-filter__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category;
        document.querySelectorAll('.insights-filter__btn').forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        document.querySelectorAll('.insight-card').forEach((card) => {
          const show = cat === 'all' || card.dataset.category === cat;
          card.style.display = show ? '' : 'none';
        });
      });
    });
  </script>

  <style>
    .insights-intro { padding: var(--space-8) 0 var(--space-6); text-align: center; }
    .insights-intro .eyebrow { display: inline-block; margin-bottom: var(--space-4); }
    .insights-intro h1 { max-width: 22ch; margin-inline: auto; margin-bottom: var(--space-4); }
    .insights-intro .lead { max-width: 66ch; margin-inline: auto; color: var(--bbg-text); }

    .insights-filter {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      justify-content: center;
      margin-bottom: var(--space-7);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--bbg-border);
    }
    .insights-filter__btn {
      appearance: none;
      border: 1px solid var(--bbg-border);
      background: transparent;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--bbg-text-muted);
      cursor: pointer;
      transition: all var(--dur) var(--ease);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .insights-filter__btn:hover {
      border-color: var(--bbg-blue);
      color: var(--bbg-blue);
    }
    .insights-filter__btn.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }
    .insights-filter__count {
      font-size: 0.75rem;
      font-weight: 600;
      opacity: 0.7;
    }
    .insights-empty {
      text-align: center;
      color: var(--bbg-text-muted);
      padding: var(--space-8) 0;
    }
  </style>
</Layout>
