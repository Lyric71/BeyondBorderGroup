---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { articleSchema } from '../../../lib/seo';
import { insightEnToDe } from '../../../i18n/insight-slugs.mjs';

const enToDe = insightEnToDe as Record<string, string>;

export async function getStaticPaths() {
  const posts = await getCollection('insightsDe', ({ data }) => !data.draft);
  const map = insightEnToDe as Record<string, string>;
  return posts.map((post) => ({
    params: { slug: map[post.id] ?? post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, heroImage, heroImageAlt, pubDate, updatedDate, category, author } =
  post.data;

// Inhaltsverzeichnis aus den gerenderten Überschriften. H2 und H3, ohne eine
// einleitende Überschrift, die nur den Artikeltitel wiederholt.
const normalizeHeading = (s: string) =>
  s
    .trim()
    .replace(/[‘’]/g, "'")
    .replace(/[“”]/g, '"')
    .replace(/\s+/g, ' ');
const toc = headings.filter(
  (h) => (h.depth === 2 || h.depth === 3) && normalizeHeading(h.text) !== normalizeHeading(title),
);

const articleJsonLd = articleSchema({
  url: `/de/analysen/${enToDe[post.id] ?? post.id}`,
  title,
  description,
  image: heroImage,
  pubDate,
  updatedDate,
  author,
  inLanguage: 'de',
  category,
  breadcrumb: [
    { name: 'Startseite', url: '/de' },
    { name: 'Analysen', url: '/de/analysen' },
    { name: title, url: `/de/analysen/${enToDe[post.id] ?? post.id}` },
  ],
});

const categoryLabelsDe: Record<string, string> = {
  Platforms: 'Plattformen',
  'E-Commerce': 'eCommerce',
  'KOLs & Livestream': 'KOL und Livestream',
  'Brand & Localization': 'Marke und Lokalisierung',
  'AI & Innovation': 'KI und Innovation',
  'Market Strategy': 'Marktstrategie',
  'Compliance & Setup': 'Compliance und Aufbau',
};

function formatDate(d?: Date) {
  if (!d) return '';
  return d.toLocaleDateString('de-DE', { month: 'long', day: 'numeric', year: 'numeric' });
}

function readingTime(body: string | undefined) {
  if (!body) return '';
  const words = body.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.round(words / 200));
  return `${minutes} Min. Lesezeit`;
}

const allInsights = await getCollection('insightsDe', ({ data }) => !data.draft);
const related = allInsights
  .filter((p) => p.id !== post.id && p.data.category === category)
  .slice(0, 3);

const categoryLabel = categoryLabelsDe[category] ?? category;
const slugFor = (enSlug: string) => enToDe[enSlug] ?? enSlug;
---

<Layout
  title={`${title} | TheChinaPath`}
  description={description}
  schema={articleJsonLd}
  ogType="article"
  ogImage={heroImage}
  ogImageAlt={heroImageAlt || title}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  articleAuthor={author}
>
  <article class="insight-article">
    <header class="insight-article__header">
      <div class="container container--narrow">
        <nav class="insight-article__crumbs" aria-label="Brotkrumen-Navigation">
          <a href="/de/analysen">← Zurück zu den Analysen</a>
        </nav>
        <span class="eyebrow">{categoryLabel}</span>
        <h1 class="insight-article__title">{title}</h1>
        <p class="insight-article__lead">{description}</p>
        <div class="insight-article__meta">
          {pubDate && <span>{formatDate(pubDate)}</span>}
          {pubDate && <span aria-hidden="true">·</span>}
          <span>{readingTime(post.body)}</span>
        </div>
      </div>
    </header>

    {
      heroImage && (
        <figure class="insight-article__hero">
          <img src={heroImage} alt={heroImageAlt || title} loading="eager" decoding="async" />
        </figure>
      )
    }

    <div class="insight-article__body">
      <div class="container">
        <div class="insight-article__layout">
          {
            toc.length > 0 && (
              <aside class="insight-article__toc" aria-label="Inhaltsverzeichnis">
                <p class="insight-article__toc-title eyebrow">Auf dieser Seite</p>
                <nav>
                  <ul>
                    {toc.map((h) => (
                      <li
                        class:list={[
                          'insight-article__toc-item',
                          h.depth === 3 && 'insight-article__toc-item--sub',
                        ]}
                      >
                        <a href={`#${h.slug}`} data-toc-link={h.slug}>
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </aside>
            )
          }

          <div class="insight-article__main">
            <div class="prose">
              <Content />
            </div>
          </div>
        </div>
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="section section--alt">
          <div class="container">
            <header class="section-header section-header--split">
              <div>
                <span class="eyebrow">Weiterlesen</span>
                <h2>In derselben Kategorie: {categoryLabel}</h2>
              </div>
              <a href="/de/analysen" class="btn btn--secondary btn--sm">
                Alle Analysen
              </a>
            </header>

            <div class="grid grid-3">
              {related.map((r) => (
                <a href={`/de/analysen/${slugFor(r.id)}`} class="insight-card">
                  <div class="insight-card__image">
                    {r.data.heroImage && (
                      <img
                        src={r.data.heroImage}
                        alt={r.data.heroImageAlt}
                        loading="lazy"
                        decoding="async"
                        width="600"
                        height="400"
                      />
                    )}
                  </div>
                  <div class="insight-card__body">
                    <span class="insight-card__tag">
                      {categoryLabelsDe[r.data.category] ?? r.data.category}
                    </span>
                    <h3 class="insight-card__title">{r.data.title}</h3>
                    <div class="insight-card__meta">
                      <span>{readingTime(r.body)}</span>
                      {r.data.pubDate && (
                        <>
                          <span class="insight-card__meta-sep" aria-hidden="true">
                            |
                          </span>
                          <span>{formatDate(r.data.pubDate)}</span>
                        </>
                      )}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="section section--tight">
      <div class="container container--narrow">
        <div class="cta-card">
          <div class="cta-card__copy">
            <span class="eyebrow">Sprechen wir</span>
            <h2>Schildern Sie uns Ihre Lage in China.</h2>
            <p>Es antwortet jemand aus dem Senior-Team. Kein Verkaufstrichter.</p>
            <div class="cta-card__actions">
              <a href="/de/kontakt" class="btn btn--primary">Gespräch beginnen</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>

  <style>
    .insight-article__header {
      padding: var(--space-7) 0 var(--space-5);
    }
    .insight-article__crumbs {
      font-size: var(--fs-small);
      margin-bottom: var(--space-4);
    }
    .insight-article__crumbs a {
      color: var(--bbg-text-muted);
      font-weight: 500;
    }
    .insight-article__crumbs a:hover {
      color: var(--bbg-blue);
    }
    .insight-article__title {
      font-size: clamp(2rem, 3vw + 1rem, 3rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--bbg-ink);
      margin: var(--space-3) 0 var(--space-4);
    }
    .insight-article__lead {
      font-size: var(--fs-lead);
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0 0 var(--space-4);
      max-width: 60ch;
    }
    .insight-article__meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      font-size: var(--fs-small);
      color: var(--bbg-text-muted);
    }
    .insight-article__hero {
      margin: 0 auto var(--space-6);
      max-width: 1200px;
      padding: 0 var(--container-pad);
    }
    .insight-article__hero img {
      width: 100%;
      height: auto;
      border-radius: var(--radius-md);
      display: block;
    }
    .insight-article__body {
      padding-bottom: var(--space-8);
    }

    /* Zweispaltiges Layout: Text bleibt bei 760px zentriert, das
       Inhaltsverzeichnis sitzt in der linken Spalte. */
    .insight-article__layout {
      display: grid;
      grid-template-columns: 1fr min(760px, 100%) 1fr;
      gap: 0 var(--space-6);
      align-items: start;
    }
    .insight-article__main {
      grid-column: 2;
      min-width: 0;
    }
    .insight-article__toc {
      grid-column: 1;
      justify-self: end;
      width: 100%;
      max-width: 240px;
      position: sticky;
      top: calc(var(--nav-h) + var(--space-5));
      max-height: calc(100vh - var(--nav-h) - var(--space-6));
      overflow-y: auto;
      padding-right: var(--space-4);
    }
    .insight-article__toc-title {
      display: block;
      margin-bottom: var(--space-3);
    }
    .insight-article__toc ul {
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: 1px solid var(--bbg-border);
    }
    .insight-article__toc-item a {
      display: block;
      padding: 0.3rem 0 0.3rem var(--space-4);
      margin-left: -1px;
      border-left: 2px solid transparent;
      color: var(--bbg-text-muted);
      font-size: 0.9rem;
      line-height: 1.4;
      text-decoration: none;
      transition:
        color 200ms ease,
        border-color 200ms ease;
    }
    .insight-article__toc-item--sub a {
      padding-left: calc(var(--space-4) + var(--space-4));
      font-size: 0.85rem;
    }
    .insight-article__toc-item a:hover {
      color: var(--bbg-blue);
    }
    .insight-article__toc-item a.is-active {
      color: var(--bbg-blue-dark);
      border-left-color: var(--bbg-blue);
      font-weight: 600;
    }
    .insight-article__body .prose :is(h2, h3) {
      scroll-margin-top: calc(var(--nav-h) + var(--space-4));
    }

    @media (max-width: 1100px) {
      .insight-article__layout {
        display: block;
      }
      .insight-article__toc {
        display: none;
      }
      .insight-article__main {
        max-width: 760px;
        margin-inline: auto;
      }
    }

    .insight-article__body .prose h2 {
      font-size: clamp(1.5rem, 1.5vw + 1rem, 2rem);
      margin: var(--space-7) 0 var(--space-3);
      color: var(--bbg-ink);
    }
    .insight-article__body .prose h3 {
      font-size: 1.25rem;
      margin: var(--space-5) 0 var(--space-2);
      color: var(--bbg-ink);
    }
    .insight-article__body .prose p {
      margin-bottom: var(--space-3);
      line-height: 1.75;
      color: var(--bbg-text);
    }
    .insight-article__body .prose ul,
    .insight-article__body .prose ol {
      margin: 0 0 var(--space-4) 1.5rem;
    }
    .insight-article__body .prose li {
      margin-bottom: var(--space-2);
      line-height: 1.6;
      color: var(--bbg-text);
    }
    .insight-article__body .prose a {
      color: var(--bbg-blue);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .insight-article__body .prose a:hover {
      color: var(--bbg-blue-dark);
    }
  </style>

  <style is:global>
    html {
      scroll-behavior: smooth;
    }
    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }
    }
  </style>

  <script>
    // Hebt beim Scrollen den aktuellen Abschnitt im Inhaltsverzeichnis hervor.
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.insight-article__toc a[data-toc-link]'),
    );
    if (links.length > 0) {
      const byId = new Map(links.map((a) => [a.dataset.tocLink, a]));
      const headings = links
        .map((a) => document.getElementById(a.dataset.tocLink ?? ''))
        .filter((el): el is HTMLElement => el !== null);

      let active: HTMLAnchorElement | null = null;
      const setActive = (id: string | undefined) => {
        if (!id) return;
        const next = byId.get(id) ?? null;
        if (next === active) return;
        active?.classList.remove('is-active');
        next?.classList.add('is-active');
        active = next;
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length > 0) {
            setActive(visible[0].target.id);
          }
        },
        { rootMargin: '-20% 0px -70% 0px', threshold: 0 },
      );

      headings.forEach((h) => observer.observe(h));
    }
  </script>
</Layout>
