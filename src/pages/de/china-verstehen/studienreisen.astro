---
import Layout from '../../../layouts/Layout.astro';
import CaseStudyStrip from '../../../components/CaseStudyStrip.astro';
---

<Layout
  title="Studienreisen China für Führungsteams | TheChinaPath"
  description="Programme vor Ort in Shanghai, Shenzhen und darüber hinaus. Im Markt mit Ihrem Team, im direkten Austausch mit Plattformen, Praktikern und Vertriebspartnern."
>
  <section class="hero-fullbleed">
    <picture>
      <img
        src="/Images/learn-china/hero-livestream-expedition.png"
        alt=""
        class="hero-fullbleed__image"
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-fullbleed__overlay" aria-hidden="true"></div>

    <div class="container hero-fullbleed__inner">
      <div class="hero-fullbleed__copy">
        <span class="eyebrow eyebrow--on-dark">Studienreisen</span>
        <h1 class="hero-fullbleed__title">Eine Woche in China, Ihr Team mittendrin im Markt.</h1>
        <p class="hero-fullbleed__lead">
          Programme vor Ort in Shanghai, Shenzhen, Hangzhou und in den aufstrebenden Städten. Tmall-
          und Douyin-Zentralen, Livestream-Studios, KOL-Treffen, Premium-Einzelhandelsbesuche und
          Arbeitsrunden mit unseren Senior-Praktikern.
        </p>
        <div class="hero-fullbleed__actions">
          <a class="btn btn--primary" href="/de/kontakt">Studienreise anfragen</a>
          <a class="btn btn--ghost-light" href="#leistungen">Programm ansehen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="leistungen">
    <div class="container container--narrow">
      <header class="section-header">
        <span class="eyebrow">Was Sie sehen</span>
        <h2>Ein maßgeschneidertes Programm, keine Standard-Bustour.</h2>
      </header>

      <article class="prose">
        <h3>Plattform-Zentralen</h3>
        <p>
          Wir bringen Sie an einen Tisch mit den Account-Teams von Tmall, JD, Douyin oder RED, je
          nach Ihrer Kategorie. Direkte Gespräche, keine PR-Tour.
        </p>

        <h3>Livestream-Studios</h3>
        <p>
          Besuch laufender Livestreams in Shanghai und Hangzhou. Sie sehen, wie ein
          chinesischer Top-Host an einem normalen Mittwoch arbeitet, und sprechen danach mit dem
          Team hinter der Kamera.
        </p>

        <h3>Einzelhandel und Konzepte</h3>
        <p>
          Premium-Supermärkte, neue Retail-Konzepte, Pop-ups, Concept-Stores in Shanghai und
          Shenzhen. Was vor Ort funktioniert, was nicht. Mit Notizen, die Sie direkt ins
          Tagesgeschäft mitnehmen.
        </p>

        <h3>KOL- und Praktiker-Treffen</h3>
        <p>
          Ein bis zwei direkte Termine mit Top-KOL oder mit den Praktikern, die Ihre Marke in China
          steuern würden. Eine seltene Gelegenheit, weil solche Termine im Tagesgeschäft schwer zu
          bekommen sind.
        </p>

        <h3>Strategierunden</h3>
        <p>
          Abendliche Arbeitsrunden mit unseren Senior-Leuten: Was Sie an dem Tag gesehen haben, wie es zu
          Ihrer Marke passt, welche Entscheidungen daraus folgen. Eine Lesart des Marktes in
          Echtzeit.
        </p>
      </article>
    </div>
  </section>

  <CaseStudyStrip slugs={["pierre-fabre","marriott","chery"]} />

  <section class="section section--tight section--alt">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__copy">
          <span class="eyebrow">Sprechen wir</span>
          <h2>Sagen Sie uns, wer mitkommt und worauf es ankommt. Wir bauen das Programm dazu.</h2>
          <div class="cta-card__actions">
            <a href="/de/kontakt" class="btn btn--primary">Gespräch beginnen</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
