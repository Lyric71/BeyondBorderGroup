  </section>

  {/* ---------- Email gate ---------- */}
  <div class="calc-gate" id="calc-gate" hidden aria-hidden="true">
    <div class="calc-gate__backdrop" data-close></div>
    <div class="calc-gate__panel" role="dialog" aria-modal="true" aria-labelledby="calc-gate-title">
      <button class="calc-gate__close" type="button" data-close aria-label="Schließen">×</button>
      <span class="eyebrow">Ein Schritt</span>
      <h2 class="calc-gate__title" id="calc-gate-title">Ihre vollständige Aufschlüsselung freischalten</h2>
      <p class="calc-gate__lead">
        Ihre Zahlen stehen bereit. Tragen Sie Ihre geschäftliche E-Mail-Adresse ein, dann öffnen wir
        die vollständige Aufschlüsselung direkt hier auf der Seite. Sobald sie auf dem Bildschirm
        steht, können Sie sie als PDF exportieren.
      </p>

      <form class="calc-gate__form" id="calc-gate-form" novalidate>
        <div class="calc-field">
          <label class="calc-field__label" for="lead-name">Name</label>
          <input class="calc-input calc-input--text" type="text" id="lead-name" name="name" autocomplete="name" required />
        </div>
        <div class="calc-field">
          <label class="calc-field__label" for="lead-email">Geschäftliche E-Mail</label>
          <input class="calc-input calc-input--text" type="email" id="lead-email" name="email" autocomplete="email" required />
        </div>
        <div class="calc-field">
          <label class="calc-field__label" for="lead-company">Unternehmen</label>
          <input class="calc-input calc-input--text" type="text" id="lead-company" name="company" autocomplete="organization" />
        </div>

        <button type="submit" class="btn btn--primary calc-gate__submit" id="lead-submit">
          Ergebnisse anzeigen
        </button>
        <p class="calc-gate__note">
          Wir nutzen Ihre Adresse, um nachzufassen, und schicken Ihnen ab und an Notizen zum
          Verkaufen in China. Kein Spam, und Sie können sich jederzeit abmelden.
        </p>
        <p class="calc-gate__status" id="lead-status" role="status" aria-live="polite"></p>
      </form>
