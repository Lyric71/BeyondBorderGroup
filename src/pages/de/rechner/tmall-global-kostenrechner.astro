            <div class="calc-compo__spine" id="compo-bar" role="img" aria-label="Zusammensetzung der Kosten">
              <div class="calc-compo__tip" id="compo-tip" aria-hidden="true"></div>
            </div>
            <div class="calc-compo__cards" id="compo-cards"></div>
