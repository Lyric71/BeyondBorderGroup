---
import Layout from '../../../layouts/Layout.astro';
import { webApplicationSchema } from '../../../lib/seo';

// ---- Key drivers, shown as sliders at the top of the calculator ----
type Driver = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number';
  min: string;
  max: string;
  step: string;
  hint?: string;
};

const drivers: Driver[] = [
  { id: 'gmv', label: 'Ziel-GMV im ersten Jahr', value: '3500000', kind: 'money', min: '200000', max: '10000000', step: '100000' },
  { id: 'aov', label: 'Durchschnittlicher Bestellwert', value: '250', kind: 'money', min: '20', max: '2000', step: '5' },
  { id: 'gmvGrowth', label: 'GMV-Wachstum im zweiten Jahr', value: '50', kind: 'percent', min: '0', max: '200', step: '5' },
  { id: 'dpRetainer', label: 'Monatshonorar des TP', value: '35000', kind: 'money', min: '0', max: '200000', step: '5000' },
  { id: 'coFund', label: 'Co-Funding für Kampagnen', value: '0', kind: 'money', min: '0', max: '500000', step: '10000' },
  { id: 'dpCommission', label: 'TP-Provision auf den GMV', value: '10', kind: 'percent', min: '0', max: '20', step: '0.5' },
  { id: 'paidShare', label: 'Paid Media', value: '60', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolShare', label: 'KOL und Livestream', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'organicShare', label: 'Organisch', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolCommission', label: 'KOL-Provisionssatz', value: '20', kind: 'percent', min: '0', max: '40', step: '1' },
  { id: 'roas', label: 'ROAS (Return on Ad Spend)', value: '2', kind: 'number', min: '0.5', max: '8', step: '0.1' },
];

// The three channel shares are grouped together and must always total 100%.
const shareIds = ['paidShare', 'kolShare', 'organicShare'];
const mainDrivers = drivers.filter((d) => !shareIds.includes(d.id));
const shareDrivers = drivers.filter((d) => shareIds.includes(d.id));

// Year 2 carries its own mix: organic normally climbs once the flagship has
// reviews and repeat buyers, which is what makes the second year cheaper to run.
const shareDrivers2: Driver[] = [
  { id: 'paidShare2', label: 'Paid Media', value: '50', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolShare2', label: 'KOL und Livestream', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'organicShare2', label: 'Organisch', value: '30', kind: 'percent', min: '0', max: '100', step: '1' },
];
const mixRows = [
  { year: '1', title: 'Jahr 1', drivers: shareDrivers, noteId: 'mix-note' },
  { year: '2', title: 'Jahr 2', drivers: shareDrivers2, noteId: 'mix-note-2' },
];

// ---- Advanced inputs, grouped in the collapsible section ----
type Field = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number' | 'select';
  step?: string;
  hint?: string;
  fx?: boolean;
  readonly?: boolean;
  suffix?: string;
  options?: { value: string; label: string; deposit?: string; fee?: string; annual?: string }[];
};

// Tmall Global (天猫国际) categories. Each one sets three numbers that move with
// the product category: the security deposit (保证金), the platform commission
// (技术服务费, capped at 5%) and the annual software service fee (软件服务年费,
// 30k or 60k). Directional 2025 bands from the published 招商 standards; the
// exact rate is confirmed at onboarding. A TM trademark or a 专营店 raises the
// deposit above the R-flagship 50k baseline shown here.
const categories: { value: string; label: string; deposit: string; fee: string; annual: string }[] = [
  { value: 'food', label: 'Verpackte Lebensmittel, Getreide, Öl, Snacks', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'tea', label: 'Tee und Getränkepulver', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'alcohol', label: 'Alkoholische Getränke', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'supplements', label: 'Nahrungsergänzungsmittel (Sonderkategorie)', deposit: '300000', fee: '3', annual: '30000' },
  { value: 'baby', label: 'Mutter, Baby und Säuglingsnahrung', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'skincare', label: 'Hautpflege', deposit: '50000', fee: '4', annual: '30000' },
  { value: 'makeup', label: 'Make-up und Duft', deposit: '50000', fee: '4', annual: '30000' },
  { value: 'personal-care', label: 'Körperpflege, Wasch- und Reinigungsmittel', deposit: '50000', fee: '2.5', annual: '60000' },
  { value: 'apparel', label: 'Bekleidung', deposit: '50000', fee: '5', annual: '60000' },
  { value: 'footwear', label: 'Schuhe', deposit: '50000', fee: '5', annual: '60000' },
  { value: 'bags', label: 'Taschen und Koffer', deposit: '50000', fee: '5', annual: '60000' },
  { value: 'jewellery', label: 'Modeschmuck und Accessoires', deposit: '50000', fee: '5', annual: '60000' },
  { value: 'watches', label: 'Uhren', deposit: '50000', fee: '2', annual: '60000' },
  { value: '3c', label: '3C und Elektronikzubehör', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'phones', label: 'Smartphones, Notebooks, Tablets', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'home', label: 'Haushalt, Bettwaren, Küchenartikel', deposit: '50000', fee: '5', annual: '30000' },
  { value: 'appliances', label: 'Kleingeräte', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'sports', label: 'Sport und Outdoor', deposit: '50000', fee: '5', annual: '60000' },
  { value: 'pet', label: 'Tiernahrung und Heimtierbedarf', deposit: '50000', fee: '5', annual: '30000' },
  { value: 'custom', label: 'Individuell (Kaution, Provision und Jahresgebühr selbst eintragen)', deposit: '', fee: '', annual: '' },
];

const gicon = {
  tax: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  platform: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 18v3"/></svg>`,
  kol: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 15z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
  logistics: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h12v9H2z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>`,
  media: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4a1 1 0 0 0 1 1h2l9 5V4L6 9H4a1 1 0 0 0-1 1z"/><path d="M18 9a4 4 0 0 1 0 6"/></svg>`,
  margin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l3-4 3 2 4-6"/></svg>`,
};

const groups: { title: string; icon: string; note?: string; fields: Field[] }[] = [
  {
    title: 'Kategorie',
    icon: gicon.platform,
    note: 'Wählen Sie Ihre Produktkategorie. Bei Tmall Global hängen Kaution, Plattformprovision und Jahresgebühr an der Kategorie, deshalb setzt diese Auswahl die drei Werte unten. Ihr TP nennt Ihnen womöglich andere Zahlen; dann tragen Sie sie von Hand ein.',
    fields: [
      {
        id: 'category',
        label: 'Produktkategorie (天猫国际)',
        value: 'food',
        kind: 'select',
        options: categories,
      },
    ],
  },
  {
    title: 'Wechselkurs und Steuer',
    icon: gicon.tax,
    fields: [
      { id: 'fx', label: 'Wechselkurs USD / RMB', value: '7.1', kind: 'number', step: '0.01', fx: true },
      { id: 'cbecTax', label: 'Cross-Border-Einfuhrsteuer (综合税)', value: '9.1', kind: 'percent', step: '0.1', hint: '13 % Mehrwertsteuer auf 70 % des Verkaufspreises, macht 9,1 % für normale Waren. Kosmetik, Parfum und Alkohol unterliegen zusätzlich der Verbrauchsteuer und liegen höher.' },
      { id: 'cbecTaxPayer', label: 'Wer trägt die Steuer', value: 'consumer', kind: 'select', options: [ { value: 'consumer', label: 'Der Kunde zahlt sie auf den Preis auf' }, { value: 'brand', label: 'Die Marke übernimmt sie' } ] },
    ],
  },
  {
    title: 'Plattform und TP',
    icon: gicon.platform,
    fields: [
      { id: 'period', label: 'Laufzeit', value: '12', kind: 'number', readonly: true, suffix: 'Monate', hint: 'Fest hinterlegt. Das Modell rechnet zwölf volle Monate; alle Jahreswerte folgen diesem Zeitraum.' },
      { id: 'platformDeposit', label: 'Kaution bei Tmall Global', value: '50000', kind: 'money', hint: 'Rückzahlbar, wenn der Shop ohne Beanstandung geschlossen wird. Ergibt sich aus Ihrer Kategorie oben; eine TM-Marke oder ein 专营店 treibt sie nach oben.' },
      { id: 'techFee', label: 'Plattformprovision (技术服务费)', value: '2', kind: 'percent', step: '0.1', hint: 'Fällt auf jeden Verkauf an, gedeckelt bei 5 %. Ergibt sich aus Ihrer Kategorie oben.' },
      { id: 'paymentFee', label: 'Zahlungsgebühr (Alipay)', value: '1', kind: 'percent', step: '0.1', hint: 'Gebühr des Zahlungsdienstleisters je Bestellung, bei Alipay rund 1 %.' },
      { id: 'annualFee', label: 'Jährliche Softwaregebühr (软件服务年费)', value: '30000', kind: 'money', hint: '30.000 oder 60.000 im Jahr, je nach Hauptkategorie. Ergibt sich aus Ihrer Kategorie oben.' },
      { id: 'agentFee', label: 'Zollagent, jährlich', value: '0', kind: 'money', hint: 'Optional. Viele Marken lassen die Zollabwicklung vom TP oder vom Lager erledigen. Lassen Sie den Wert auf null, solange Sie keinen eigenen 境内代理人 beauftragen.' },
      { id: 'trademark', label: 'Markenanmeldung in China', value: '0', kind: 'money' },
      { id: 'brandSetup', label: 'Shop-Aufbau und Launch-Content', value: '25000', kind: 'money' },
    ],
  },
  {
    title: 'Logistik',
    icon: gicon.logistics,
    fields: [
      { id: 'whDeposit', label: 'Kaution für das Zolllager', value: '100000', kind: 'money' },
      { id: 'whTaxPrepay', label: 'Steuervorauszahlung ans Zolllager', value: '300000', kind: 'money' },
      { id: 'storage', label: 'Lagerkosten je Einheit und Monat', value: '0.8', kind: 'number', step: '0.1' },
      { id: 'fulfillment', label: 'Fulfillment je Bestellung (Kommissionierung und Verpackung)', value: '4', kind: 'money', step: '0.5' },
      { id: 'shipping', label: 'Zustellung je Paket', value: '11', kind: 'money' },
      { id: 'returnRate', label: 'Retourenquote', value: '5', kind: 'percent', step: '0.1' },
      { id: 'returnHandling', label: 'Retourenbearbeitung je Paket', value: '15', kind: 'money' },
    ],
  },
  {
    title: 'Ihre Wirtschaftlichkeit',
    icon: gicon.margin,
    note: 'Tragen Sie Ihre Bruttomarge je Bestellung ein, dann zeigt der Rechner das Betriebsergebnis beider Jahre und Ihren Break-even-GMV. Shop-Aufbau und Markenanmeldung werden über die Abschreibungsdauer unten verteilt; die rückzahlbaren Kautionen tauchen in der GuV nie auf.',
    fields: [
      { id: 'grossMargin', label: 'Bruttomarge je Bestellung', value: '75', kind: 'percent' },
      { id: 'amortYears', label: 'Abschreibungsdauer für den Aufbau', value: '3', kind: 'number', step: '1', suffix: 'Jahre', hint: 'Shop-Aufbau und Markenanmeldung werden zu gleichen Teilen über so viele Jahre abgeschrieben. Drei Jahre sind üblich.' },
    ],
  },
];

const steps = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 11h18M7 15h4"/></svg>`,
    title: 'Sie finanzieren',
    body: 'Kautionen für Plattform und Zolllager, Markenanmeldung, Launch-Content. Das einmalige Geld, das den Shop überhaupt online bringt.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>`,
    title: 'Der TP betreibt',
    body: 'Ein Tmall Partner (TP) stellt das Team und führt den Flagship-Store im Tagesgeschäft. Bezahlt wird er über ein festes Monatshonorar plus Provision auf den Umsatz.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 15z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
    title: 'Traffic verkauft',
    body: 'Bezahlte Suche und Display füllen den Shop. Livestream und KOL bringen zusätzlich Volumen, bezahlt rein auf Provision.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 2 5-6"/></svg>`,
    title: 'Sie messen',
    body: 'Der Rechner summiert jede Position, trennt den Aufbau vom laufenden Betrieb und weist aus, was beim Ausstieg zurückfließt.',
  },
];

const perks = [
  'Jahr 1 und Jahr 2 nebeneinander',
  'Der volle Kostenblock in RMB und USD',
  'Kaution und Provision nach Kategorie',
  'Rückzahlbare Kautionen gegen echten Mittelabfluss',
  'Break-even-GMV aus Ihrer Marge',
];

// Plain-language explanation for every field, shown in the overlay bubble.
const help: Record<string, string> = {
  gmv: 'Der Gross Merchandise Value ist der Umsatz, den Sie dem Tmall-Global-Flagship in seinen ersten zwölf Monaten zutrauen, bevor irgendeine Kostenposition abgezogen wird. Auf dieser Zahl skaliert das gesamte Modell. Wenn Sie unsicher sind, setzen Sie sie konservativ an und ziehen Sie nach, sobald der Shop liefert.',
  aov: 'Was ein Kunde im Schnitt in einer einzelnen Bestellung ausgibt. Teilen Sie Ihren erwarteten Jahresumsatz durch die Zahl der Bestellungen, dann landen Sie hier. Der Wert bestimmt, wie viele Pakete Sie versenden, und damit Ihre Kosten für Fulfillment, Zustellung und Retouren.',
  paidShare:
    'Der Anteil Ihres Umsatzes, den bezahlte Werbung treibt, also die Such- und Display-Tools von Tmall (直通车, 引力魔方) statt organischer Reichweite oder eines Creators. Drehen Sie den Wert hoch, geben Sie mehr für Anzeigen aus, um denselben Umsatz zu erreichen.',
  dpRetainer:
    'Das feste Monatshonorar, das Ihr TP (Tmall Partner) für den Betrieb des Flagship-Stores berechnet: Storefront, Kampagnenkalender, Anzeigenschaltung, Kundenservice. In aller Regel der größte Fixposten. Für eine ernsthaft aufgestellte internationale Marke sind rund 35.000 RMB im Monat üblich, bei umfangreicherem Setup mehr.',
  dpCommission:
    'Ein Prozentsatz, den der TP zusätzlich zum Honorar auf den von ihm erzielten Umsatz erhält. Zehn Prozent sind gängig. Damit ist das Mediabudget nicht abgedeckt: Paid Media zahlen Sie direkt ins Werbekonto ein.',
  category:
    'Ihre Produktkategorie bei Tmall Global (天猫国际). Sie legt drei Werte fest, die je nach Kategorie schwanken: die Kaution, die Plattformprovision (技术服务费) und die jährliche Softwaregebühr. Wählen Sie die passendste Kategorie, dann füllen sich die Felder unten. Für eigene Zahlen wählen Sie "Individuell".',
  kolCommission:
    'Der Anteil, den ein Livestream-Host oder ein Kurzvideo-Creator von jedem Verkauf behält, den er auslöst. Reine Provision, fällig nur bei tatsächlichem Verkauf. Lebensmittel und Alltagsware liegen meist zwischen 8 und 20 Prozent, Beauty und Luxus höher.',
  roas:
    'Return on Ad Spend ist der Umsatz geteilt durch die Werbeausgaben. Ein ROAS von 2 heißt: Jeder RMB Anzeigenbudget bringt 2 RMB Umsatz zurück. Als Faustformel für den Break-even gilt in China 1 geteilt durch die Bruttomarge. Bei 50 Prozent Marge brauchen Sie also schon eine 2, nur um die Produktrechnung zu decken; margenschwächere Kategorien brauchen mehr. Die bezahlte Suche auf Tmall reift schneller als ein kaltes Social-Konto, weil der Kunde bereits mit Kaufabsicht kommt. Tragen Sie den Wert ein, den Sie im ersten Jahr im Schnitt erwarten.',
  fx: 'Wie viele RMB ein US-Dollar kauft. Der Kurs wirkt nur auf den USD-Wert am Ende, gerechnet wird durchgängig in RMB. Über den Aktualisieren-Link holen Sie den aktuellen Tageskurs.',
  cbecTax:
    'Die Cross-Border-Sammelsteuer, faktisch eine Einfuhrumsatzsteuer auf Ware, die über das Zolllagermodell verkauft wird. Erhoben werden 13 Prozent Mehrwertsteuer auf 70 Prozent des Verkaufspreises, was für normale Waren ohne Verbrauchsteuer bei 9,1 Prozent des Umsatzes landet. Kosmetik, Parfum und Alkohol lösen zusätzlich Verbrauchsteuer aus und liegen darüber.',
  cbecTaxPayer:
    'Wer die Einfuhrsteuer trägt. In den meisten Flagship-Konstruktionen zahlt der Kunde sie an der Kasse zusätzlich zum Regalpreis. Dann ist sie für Sie keine Kostenposition und bleibt im Modell außen vor. Stellen Sie auf "Die Marke übernimmt sie", zieht der Rechner den Betrag direkt von Ihrer Rechnung ab.',
  platformDeposit:
    'Eine rückzahlbare Kaution, die Tmall Global für die Dauer Ihres Shops einbehält und bei einer Schließung ohne Beanstandung erstattet. Für ein Flagship mit R-Marke sind 50.000 RMB der Ausgangswert. Eine TM-Marke, ein 专营店 oder eine Sonderkategorie wie Nahrungsergänzung treibt ihn nach oben. Die Kategorieauswahl setzt einen typischen Wert.',
  techFee:
    'Die Plattformprovision (技术服务费), die Tmall Global auf jeden Verkauf erhebt, gemessen am GMV. Je nach Kategorie liegt sie zwischen 0,5 und 5 Prozent und ist bei 5 Prozent gedeckelt. Die Kategorieauswahl setzt den Wert für Sie.',
  paymentFee:
    'Die Gebühr des Zahlungsdienstleisters je Bestellung, gemessen am GMV. Bei Tmall Global ist das Alipay, mit rund 1 Prozent.',
  annualFee:
    'Die jährliche Softwaregebühr (软件服务年费), die Tmall Global erhebt, ob Sie verkaufen oder nicht. Je nach Hauptkategorie sind das 30.000 oder 60.000 RMB. Die Kategorieauswahl setzt den Wert. Achtung: Das ist eine Gebühr von Tmall Global. Das inländische Tmall hat seine Jahresgebühr 2024 gestrichen, Tmall Global hat sie behalten.',
  agentFee:
    'Eine optionale Jahresgebühr für einen Zollagenten auf dem Festland (境内代理人). Im Zolllagermodell übernimmt meist der TP oder das Lager die Abwicklung, deshalb lassen viele Marken diesen Posten auf null. Tragen Sie nur dann etwas ein, wenn Sie einen eigenen Zollagenten mandatieren.',
  trademark:
    'Einmalige Kosten, um Ihre Marke in China in der einschlägigen Klasse eintragen zu lassen. Wer das früh erledigt, sichert sich den Namen, bevor jemand anderes zugreift. Für eine einzelne Klasse rund 8.000 RMB.',
  brandSetup:
    'Die Anfangsinvestition in den Shop und seine Launch-Inhalte: Banner, Produktseiten, ein Foto- oder Videodreh für das Hauptmotiv. Fällt einmal an, ganz am Anfang.',
  coFund:
    'Ein jährlicher gemeinsamer Topf zusätzlich zum TP-Honorar, reserviert für die großen Momente: Double 11, ein Markenlaunch, eine Leitkampagne. Er bezahlt Arbeit, die über das hinausgeht, was das Honorar im Tagesgeschäft ohnehin abdeckt.',
  kolShare:
    'Der Anteil am Gesamtumsatz, der über Creator läuft, also Livestream und Kurzvideo, statt über Ihre eigene Shopseite oder die bezahlte Suche. Er bestimmt, wie viel KOL-Provision am Ende fällig wird.',
  organicShare:
    'Umsatz, hinter dem weder Anzeigenbudget noch Creator-Provision steckt: Ihre eigene Shopseite, die Suche, Follower, Wiederkäufer. Es ist schlicht das, was nach Paid Media und KOL übrig bleibt. Ein steigender organischer Anteil ist der Grund, warum Jahr 2 günstiger ausfällt als Jahr 1.',
  gmvGrowth:
    'Wie viel mehr das Flagship im zweiten Jahr verkauft als im ersten. Ein Shop, der sein erstes Jahr übersteht, gewinnt normalerweise an Fahrt: Er hat Bewertungen, Follower und Wiederkäufer, und sein Suchgewicht innerhalb von Tmall steigt. 50 Prozent sind eine vernünftige Planungsgröße für einen Shop, der Tritt gefasst hat. Setzen Sie den Wert auf null, um Jahr 1 unverändert zu wiederholen. Jede umsatzabhängige Kostenposition in der Spalte für Jahr 2 skaliert damit.',
  paidShare2:
    'Der Anteil des Umsatzes in Jahr 2, den bezahlte Werbung treibt. Bis dahin hat der Shop Historie, Bewertungen und Follower. Viele Marken halten diese Position deshalb konstant oder fahren sie zurück, während Organik den Ausfall auffängt.',
  kolShare2:
    'Der Anteil des Umsatzes in Jahr 2, der über Creator läuft. Die meisten Marken behalten Livestream und KOL im Mix, nur weniger dominant, weil Shopseite und Wiederkäufer inzwischen selbst verkaufen.',
  organicShare2:
    'Der Anteil in Jahr 2, der ohne Anzeigenbudget und ohne Creator-Provision zustande kommt: Shopseite, Tmall-Suche, Follower, Wiederkäufer. Diese Zahl sollte steigen, und genau sie ist der Hauptgrund, warum Jahr 2 billiger läuft als Jahr 1.',
  period:
    'Das Modell rechnet mit einem Mandat über zwölf Monate. Das GMV-Ziel, das TP-Honorar, die Jahresgebühr der Plattform und der Kampagnentopf decken jeweils ein volles Jahr ab. Jahr 2 im Ergebnis zeigt dieselben zwölf Monate ohne den einmaligen Aufbau. Das Feld steht hier, damit die Annahme offenliegt; ändern lässt es sich nicht.',
  whDeposit:
    'Eine rückzahlbare Kaution, die das Zolllager als Betriebsmittel einbehält, solange Ihre Ware dort liegt. Sie bekommen sie beim Ausstieg zurück, sie ist also gebunden, nicht verloren.',
  whTaxPrepay:
    'Geld, das Sie dem Zolllager im Voraus für die Einfuhrsteuer auf die abzufertigende Ware überlassen. Der Betrag wird abgebaut, sobald Sendungen nach China eingehen. Behandeln Sie ihn als Geld, das später zurückkommt, nicht als Ausgabe.',
  storage:
    'Was das Zolllager für die Einlagerung einer Einheit über einen Monat berechnet. Multipliziert mit Ihrem Bestellvolumen und einer durchschnittlichen Liegezeit von zwei Monaten ergibt sich Ihre Lagerrechnung.',
  fulfillment:
    'Was Kommissionierung, Verpackung und Handling einer Bestellung im Zolllager kosten, bevor sie das Haus verlässt. Die Zustellung auf der letzten Meile darunter ist davon getrennt. Multiplizieren Sie den Wert mit der Zahl der Bestellungen, dann steht die Jahresrechnung fürs Fulfillment.',
  shipping:
    'Was die Zustellung eines Pakets vom Zolllager bis zur Haustür des Kunden kostet. Multipliziert mit der Zahl der Bestellungen ergibt sich die Jahresrechnung für den Versand. Sie kommt zur Fulfillment-Gebühr hinzu.',
  returnRate:
    'Der Anteil der Bestellungen, die zurückkommen. Bei Cross-Border-Verkäufen liegt er üblicherweise niedrig, um die fünf Prozent. Jede Retoure verursacht Bearbeitungskosten.',
  returnHandling:
    'Was die Bearbeitung eines zurückgesandten Pakets kostet: Prüfung, dann Wiedereinlagerung oder Entsorgung. Multipliziert mit Ihrer Retourenquote und dem Bestellvolumen.',
  grossMargin:
    'Ihre Bruttomarge auf eine einzelne Bestellung: der Anteil des Verkaufspreises, der nach den Produktkosten übrig bleibt, aber vor allen Kanalkosten dieses Modells. Der Prozentsatz gilt für jede Bestellung gleichermaßen. Tragen Sie ihn ein, dann zeigt der Rechner das Betriebsergebnis beider Jahre und Ihren Break-even-GMV.',
  amortYears:
    'Über wie viele Jahre der einmalige Aufbau abgeschrieben wird. Shop-Aufbau und Markenanmeldung sind echte Kosten. Die Buchhaltung verteilt sie deshalb auf die Jahre, in denen sie sich auszahlen, statt die volle Rechnung Jahr 1 aufzubürden. Drei Jahre sind bei einer Investition dieser Art die übliche Konvention. Kautionen und Steuervorauszahlung stecken nicht in dieser Zahl: Sie bekommen sie zurück, das ist gebundenes Kapital, keine Kostenposition.',
};

const notes = [
  'Der Aufbau wird einmal bezahlt, ist aber nicht in voller Höhe eine Kostenposition von Jahr 1. Shop-Aufbau und Markenanmeldung werden über die von Ihnen gesetzte Abschreibungsdauer verteilt. Jedes Jahr trägt seinen Anteil, und das Betriebsergebnis wird nicht von einer Rechnung erdrückt, von der es noch jahrelang zehrt. Bei Kautionen und Steuervorauszahlung liegt der Fall anders: Sie fließen beim Ausstieg zurück, sind also gebundenes Kapital und erreichen die GuV nie. Deshalb weichen die Cash-Spalte und die Ergebnisspalte voneinander ab, und beide haben recht.',
  'Das Modell rechnet ausschließlich Cross-Border, über das Zolllager (天猫国际). Lagerkaution und Steuervorauszahlung bekommen Sie beim Ausstieg zurück, deshalb führt der Rechner sie als Geld, das wiederkommt, nicht als Geld, das weg ist.',
  'Das TP-Honorar samt Provision auf den GMV ist neben Paid Media einer der größten Posten. Paid Media zahlen Sie direkt ins Werbekonto ein, es läuft nicht über die Rechnung des TP. Diese Trennung ist Absicht: Partner, die das Mediabudget vorstrecken wollen, kippen früher oder später um.',
  'Der TP betreibt den Flagship-Store. Seine Personalkosten stecken im Honorar und in der Provision, eine eigene Zeile für Köpfe gibt es deshalb nicht. Die KOL-Provision wird separat abgerechnet, auf den Umsatz, den die Creator tatsächlich bringen.',
  'Kaution, Plattformprovision und Jahresgebühr hängen an Ihrer Produktkategorie. Wählen Sie eine Kategorie im Feintuning-Bereich, dann füllen sich alle drei Werte aus den veröffentlichten Bändern von Tmall Global. Eine TM-Marke oder ein 专营店 hebt die Kaution über den hier gezeigten Wert für ein Flagship mit R-Marke.',
  'Die Cross-Border-Einfuhrsteuer beträgt für normale Waren 9,1 Prozent des Umsatzes: 13 Prozent Mehrwertsteuer, erhoben auf 70 Prozent des Preises. In den meisten Flagship-Konstruktionen trägt der Kunde sie an der Kasse, deshalb bleibt sie standardmäßig aus Ihrer Rechnung heraus. Stellen Sie den Zahler auf die Marke um, wenn Sie sie übernehmen. Und bedenken Sie: Kosmetik, Parfum und Alkohol liegen höher.',
  'Bei einem GMV von 3,5 Mio. RMB schreibt Jahr 1 in aller Regel rote Zahlen. Die Tabelle stellt Jahr 1 gegen Jahr 2, wenn der einmalige Aufbau wegfällt, der Kanalmix auf Ihre Regler für Jahr 2 umspringt und der GMV um Ihre Wachstumsannahme zulegt. Der Break-even-GMV zeigt, welche Größenordnung nötig ist, damit der Rohertrag die Rechnung deckt. Er liegt oft ein Vielfaches über dem Ziel des ersten Jahres.',
];

const refreshIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>`;

// WO-P3. WebApplication node plus breadcrumb, merged into the site graph by Layout.
const calcSchema = webApplicationSchema({
  url: Astro.url.pathname,
  name: "Tmall Global: Kostenrechner für Aufbau und Betrieb",
  description: "Was ein Tmall-Global-Flagship im ersten Jahr kostet: Kaution, Jahresgebühr und Provision je Kategorie, TP-Honorar, Zolllager, Versand und Einfuhrsteuer. In RMB und USD.",
  inLanguage: 'de',
  breadcrumb: [
    { name: "Startseite", url: "/de" },
    { name: "Rechner", url: "/de/rechner" },
    { name: "Tmall Global: Kostenrechner für Aufbau und Betrieb", url: Astro.url.pathname },
  ],
});
---

<Layout
  schema={calcSchema}
  title="Tmall Global: Kostenrechner für Aufbau und Betrieb | TheChinaPath"
  description="Was ein Tmall-Global-Flagship im ersten Jahr kostet: Kaution, Jahresgebühr und Provision je Kategorie, TP-Honorar, Zolllager, Versand und Einfuhrsteuer. In RMB und USD."
>
  <section
    class="tool-hero tool-hero--image"
    style="--tool-hero-img: url('/Images/tools/tmall-jd-hero-bg.png')"
  >
    <div class="container tool-hero__inner">
      <nav class="tool-hero__crumbs" aria-label="Brotkrumen-Navigation">
        <a href="/de">Start</a>
        <span aria-hidden="true">/</span>
        <a href="/de/rechner">Rechner</a>
        <span aria-hidden="true">/</span>
        <span>Tmall Global: Aufbau und Betrieb</span>
      </nav>
      <span class="eyebrow">Kostenrechner</span>
      <h1 class="tool-hero__title">Was ein Tmall-Global-Flagship <em>wirklich</em> kostet.</h1>
      <p class="tool-hero__lead">
        Rechnen Sie durch, was ein Flagship-Store auf Tmall Global über einen Tmall Partner (TP)
        kostet, im Cross-Border-Zolllagermodell (天猫国际), über die ersten zwei Jahre. Kaution,
        Provision und Jahresgebühr hängen an Ihrer Kategorie.
      </p>
      <div class="tool-hero__meta">
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">Jahr 1 + 2</span>
          <span class="tool-hero__meta-label">der Kostenblock, nebeneinander</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">RMB + USD</span>
          <span class="tool-hero__meta-label">die volle Rechnung, in beiden Währungen</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">Live</span>
          <span class="tool-hero__meta-label">jede Annahme können Sie ändern</span>
        </div>
      </div>
      <a href="#calculator" class="tool-hero__scroll">
        <span>Jetzt rechnen</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
      </a>
    </div>
  </section>

  {/* ---------- How it works ---------- */}
  <section class="section calc-how">
    <div class="container">
      <div class="calc-how__head reveal">
        <span class="eyebrow">So rechnet das Modell</span>
        <h2 class="calc-how__title">Vier bewegliche Teile, zwei Jahre Kosten.</h2>
      </div>
      <ol class="calc-flow">
        {
          steps.map((s, idx) => (
            <li class="calc-flow__step reveal" style={`--i:${idx}`}>
              <span class="calc-flow__icon" set:html={s.icon} />
              <h3 class="calc-flow__step-title">{s.title}</h3>
              <p class="calc-flow__step-body">{s.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="calc-perks reveal">
        <span class="calc-perks__label">Das bekommen Sie</span>
        <ul class="calc-perks__list">
          {
            perks.map((p) => (
              <li class="calc-perks__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8" /></svg>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- Calculator ---------- */}
  <section class="section section--alt calc" id="calculator">
    <div class="container">
      <div class="calc__head reveal">
        <span class="eyebrow">Der Rechner</span>
        <h2 class="calc__title">Setzen Sie Ihre Annahmen</h2>
      </div>

      <form class="calc-form" id="calc-form" novalidate>
        <div class="calc-shell">
          <div class="calc-main">
            {/* Key drivers as sliders */}
            <div class="calc-card calc-drivers reveal">
              <div class="calc-card__head">
                <h3 class="calc-card__title">Die zentralen Annahmen</h3>
                <span class="calc-card__hint">Die Zahlen, die das Ergebnis am stärksten bewegen.</span>
              </div>
              <div class="calc-drivers__grid">
                {
                  mainDrivers.map((d) => (
                    <div class="driver" data-driver>
                      <div class="driver__top">
                        <span class="calc-label-wrap">
                          <label class="driver__label" for={d.id}>
                            {d.label}
                          </label>
                          {help[d.id] && (
                            <button
                              type="button"
                              class="calc-help__btn"
                              data-help={help[d.id]}
                              aria-label={`Was ist ${d.label}?`}
                            >
                              ?
                            </button>
                          )}
                        </span>
                        <span class="driver__value">
                          <input
                            class="driver__num"
                            type="number"
                            id={d.id}
                            name={d.id}
                            value={d.value}
                            data-kind={d.kind}
                            data-label={d.label}
                            step={d.step}
                            min={d.min}
                            max={d.max}
                          />
                          <span class="driver__unit">{d.kind === 'percent' ? '%' : d.kind === 'money' ? 'RMB' : 'x'}</span>
                        </span>
                      </div>
                      <input
                        class="driver__range"
                        type="range"
                        min={d.min}
                        max={d.max}
                        step={d.step}
                        value={d.value}
                        data-target={d.id}
                        aria-hidden="true"
                        tabindex="-1"
                      />
                    </div>
                  ))
                }
              </div>

              {/* Channel mix: paid + KOL + organic, 100% of GMV, one row per year */}
              <div class="driver-group">
                <div class="driver-group__head">
                  <span class="driver-group__title">Kanalmix</span>
                  <span class="driver-group__sub">Woher der Umsatz kommt, Jahr für Jahr. Jede Zeile ergibt 100 % des GMV.</span>
                </div>
                {
                  mixRows.map((row) => (
                    <div class="driver-group__row">
                      <span class="driver-group__year">{row.title}</span>
                      <div class="driver-group__grid">
                        {row.drivers.map((d) => (
                          <div class="driver driver--share" data-driver>
                            <div class="driver__top">
                              <span class="calc-label-wrap">
                                <label class="driver__label" for={d.id}>
                                  {d.label}
                                </label>
                                {help[d.id] && (
                                  <button
                                    type="button"
                                    class="calc-help__btn"
                                    data-help={help[d.id]}
                                    aria-label={`Was ist ${d.label} (${row.title})?`}
                                  >
                                    ?
                                  </button>
                                )}
                              </span>
                              <span class="driver__value">
                                <input
                                  class="driver__num"
                                  type="number"
                                  id={d.id}
                                  name={d.id}
                                  value={d.value}
                                  data-kind={d.kind}
                                  data-label={`${d.label} (${row.title})`}
                                  step={d.step}
                                  min={d.min}
                                  max={d.max}
                                />
                                <span class="driver__unit">%</span>
                              </span>
                            </div>
                            <input
                              class="driver__range"
                              type="range"
                              min={d.min}
                              max={d.max}
                              step={d.step}
                              value={d.value}
                              data-target={d.id}
                              aria-hidden="true"
                              tabindex="-1"
                            />
                          </div>
                        ))}
                      </div>
                      <p class="calc-mix" id={row.noteId} aria-live="polite"></p>
                    </div>
                  ))
                }
              </div>
            </div>

            {/* Advanced inputs, collapsible */}
            <div class="calc-card calc-advanced reveal">
              <button type="button" class="calc-advanced__toggle" id="advanced-toggle" aria-expanded="false" aria-controls="advanced-body">
                <span class="calc-advanced__toggle-text">
                  <span class="calc-advanced__toggle-title">Jede Eingabe feinjustieren</span>
                  <span class="calc-advanced__toggle-sub">Gebühren, Kautionen, Logistik, Steuer und Marge</span>
                </span>
                <span class="calc-advanced__chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                </span>
              </button>
              <div class="calc-advanced__body" id="advanced-body" hidden>
                <div class="calc-advanced__body-inner">
                <div class="calc-tabs" role="tablist" aria-label="Eingabegruppen">
                  {
                    groups.map((group, idx) => (
                      <button
                        type="button"
                        class:list={['calc-tab', { 'is-active': idx === 0 }]}
                        role="tab"
                        id={`tab-${idx}`}
                        data-tab={idx}
                        aria-controls={`panel-${idx}`}
                        aria-selected={idx === 0 ? 'true' : 'false'}
                      >
                        <span class="calc-tab__icon" set:html={group.icon} />
                        <span class="calc-tab__label">{group.title}</span>
                      </button>
                    ))
                  }
                </div>
                <div class="calc-tabpanels">
                  {
                    groups.map((group, idx) => (
                      <div
                        class:list={['calc-tabpanel', { 'is-active': idx === 0 }]}
                        id={`panel-${idx}`}
                        data-panel={idx}
                        role="tabpanel"
                        aria-labelledby={`tab-${idx}`}
                        hidden={idx !== 0}
                      >
                        {group.note && <p class="calc-group__note">{group.note}</p>}
                        <div class="calc-tabpanel__fields">
                          {group.fields.map((f) => (
                            <div class="calc-field">
                              <span class="calc-label-wrap">
                                <label class="calc-field__label" for={f.id}>
                                  {f.label}
                                </label>
                                {help[f.id] && (
                                  <button
                                    type="button"
                                    class="calc-help__btn"
                                    data-help={help[f.id]}
                                    aria-label={`Was ist ${f.label}?`}
                                  >
                                    ?
                                  </button>
                                )}
                              </span>
                              {f.kind === 'select' ? (
                                <select class="calc-select" id={f.id} name={f.id}>
                                  {(f.options ?? []).map((o) => (
                                    <option
                                      value={o.value}
                                      data-deposit={o.deposit}
                                      data-fee={o.fee}
                                      data-annual={o.annual}
                                      selected={o.value === f.value}
                                    >
                                      {o.label}
                                    </option>
                                  ))}
                                </select>
                              ) : (
                                <div class="calc-input-wrap" data-kind={f.kind}>
                                  {f.kind === 'money' && <span class="calc-input-affix">RMB</span>}
                                  <input
                                    class:list={['calc-input', { 'calc-input--static': f.readonly }]}
                                    type="number"
                                    inputmode="decimal"
                                    id={f.id}
                                    name={f.id}
                                    value={f.value}
                                    data-kind={f.kind}
                                    data-label={f.label}
                                    step={f.step ?? '1'}
                                    min="0"
                                    placeholder={f.kind === 'percent' ? '%' : ''}
                                    readonly={f.readonly}
                                    tabindex={f.readonly ? '-1' : undefined}
                                    aria-readonly={f.readonly ? 'true' : undefined}
                                  />
                                  {f.kind === 'percent' && <span class="calc-input-affix calc-input-affix--suffix">%</span>}
                                  {f.suffix && <span class="calc-input-affix calc-input-affix--suffix">{f.suffix}</span>}
                                </div>
                              )}
                              {f.fx && (
                                <button type="button" class="calc-fx-link" id="fx-refresh">
                                  <span class="calc-fx-link__icon" set:html={refreshIcon} />
                                  Aktuellen Kurs holen
                                </button>
                              )}
                              {f.id === 'category' && (
                                <div class="calc-impact" id="category-impact" aria-live="polite" hidden>
                                  <span class="calc-impact__label">Setzt die Werte unten</span>
                                  <span class="calc-impact__chips">
                                    <span class="calc-impact__chip">
                                      Kaution
                                      <strong id="impact-deposit"></strong>
                                    </span>
                                    <span class="calc-impact__chip">
                                      Provision
                                      <strong id="impact-fee"></strong>
                                    </span>
                                    <span class="calc-impact__chip">
                                      Jahresgebühr
                                      <strong id="impact-annual"></strong>
                                    </span>
                                  </span>
                                </div>
                              )}
                              {f.hint && <p class="calc-field__hint">{f.hint}</p>}
                              {f.fx && <p class="calc-field__hint" id="fx-note"></p>}
                            </div>
                          ))}
                        </div>
                      </div>
                    ))
                  }
                </div>
                </div>
              </div>
            </div>
          </div>

          {/* Sticky live preview rail */}
          <aside class="calc-rail reveal">
            <div class="calc-preview">
              <div class="calc-preview__glow" aria-hidden="true"></div>
              <span class="calc-preview__eyebrow">Live-Vorschau</span>
              <div class="calc-preview__orders">
                <span class="calc-preview__orders-num" id="live-orders" data-pulse>20.000</span>
                <span class="calc-preview__orders-label">Bestellungen im Jahr, nach Ihren Eingaben</span>
              </div>

              <div class="calc-preview__locked">
                <div class="calc-preview__locked-row">
                  <span>Gesamtkosten Jahr 1</span>
                  <span class="calc-preview__blur">RMB 0.000.000</span>
                </div>
                <div class="calc-preview__locked-row">
                  <span>Tatsächlicher Mittelabfluss</span>
                  <span class="calc-preview__blur">RMB 0.000.000</span>
                </div>
                <div class="calc-preview__locked-row">
                  <span>Kosten je Bestellung</span>
                  <span class="calc-preview__blur">RMB 000</span>
                </div>
                <div class="calc-preview__lock" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                </div>
              </div>

              <button type="submit" class="btn btn--primary calc-preview__cta" id="calc-submit">
                Vollständige Aufschlüsselung ansehen
              </button>
              <p class="calc-preview__note">
                Eine geschäftliche E-Mail-Adresse schaltet die vollständige Aufschlüsselung hier
                frei. Danach können Sie sie als PDF exportieren.
              </p>
            </div>
          </aside>
        </div>
      </form>

      {/* ---------- Results, hidden until the email gate is cleared ---------- */}
      <div class="calc-results" id="calc-results" hidden>
        {/* Print-only header: brand mark on the exported PDF */}
        <div class="calc-print calc-print__head" aria-hidden="true">
          <img src="/Images/thechinapath-horizontal.png" alt="TheChinaPath" class="calc-print__logo" />
          <div class="calc-print__meta">
            <span>Kostenschätzung für ein Tmall-Global-Flagship</span>
            <span>thechinapath.com · hello@thechinapath.com</span>
          </div>
        </div>

        <div class="calc-results__head reveal">
          <div class="calc-results__head-text">
            <span class="eyebrow">Ihre Schätzung</span>
            <h2 class="calc-results__title">Kosten für Jahr 1 und Jahr 2 im Detail</h2>
            <p class="calc-results__sub" id="calc-results-sub"></p>
          </div>
          <button type="button" class="btn btn--secondary btn--sm calc-results__pdf" id="calc-pdf" data-export-pdf>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M8 11l4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
            Als PDF exportieren
          </button>
        </div>

        <div class="calc-scenario reveal">
          <div class="calc-view-toolbar">
            <div class="calc-period__tabs" role="tablist" aria-label="Jahr">
              <button type="button" class="calc-period__tab is-active" data-year="1" role="tab" aria-selected="true">Jahr 1</button>
              <button type="button" class="calc-period__tab" data-year="2" role="tab" aria-selected="false">Jahr 2</button>
            </div>
          </div>

          <div class="calc-focus">
            <div class="calc-focus__hero">
              <span class="calc-focus__hero-label" id="focus-hero-label">Gesamtkosten Jahr 1</span>
              <span class="calc-focus__hero-num" id="focus-total">RMB 0</span>
              <span class="calc-focus__hero-usd" id="focus-usd">$0</span>
            </div>
            <div class="calc-focus__stats">
              <div class="calc-stat calc-stat--pl" id="focus-pl1-wrap">
                <span class="calc-stat__label" id="focus-pl1-label">Betriebsergebnis</span>
                <span class="calc-stat__value" id="focus-pl1">Marge eintragen</span>
                <span class="calc-stat__foot" id="focus-pl1-foot">bei Ihrer Bruttomarge, ohne Aufbau</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Netto-Kanalmarge</span>
                <span class="calc-stat__value" id="focus-ncm">RMB 0</span>
                <span class="calc-stat__foot" id="focus-ncm-foot">GMV abzüglich laufender Kosten, vor Produktkosten</span>
              </div>
              <div class="calc-stat calc-stat--capex" id="focus-capex-wrap">
                <span class="calc-stat__label">Abschreibung des Aufbaus</span>
                <span class="calc-stat__value" id="focus-capex">RMB 0</span>
                <span class="calc-stat__foot" id="focus-capex-foot">der Anteil dieses Jahres am Aufbau</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Tatsächlicher Mittelabfluss</span>
                <span class="calc-stat__value" id="focus-sunk">RMB 0</span>
                <span class="calc-stat__foot" id="focus-sunk-foot">nach rückzahlbaren Kautionen</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Kosten je Bestellung</span>
                <span class="calc-stat__value" id="focus-cpo">RMB 0</span>
