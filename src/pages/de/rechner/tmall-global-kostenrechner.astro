    letter-spacing: -0.02em;
    color: var(--bbg-ink);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  /* segmented spine */
  .calc-compo__spine {
    position: relative;
    display: flex;
    gap: 3px;
    height: 40px;
    padding: 4px;
    border-radius: 999px;
    background: var(--bbg-surface);
    border: 1px solid var(--bbg-border);
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.05);
  }
  .calc-compo__seg {
    position: relative;
    width: 0;
    border-radius: 999px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--c) 82%, white), var(--c));
    transition:
      width 0.9s var(--ease),
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease),
      filter 0.25s var(--ease);
    cursor: pointer;
  }
  .calc-compo__seg::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.35), transparent 45%);
  }
  .calc-compo__seg.is-grown {
    width: var(--w);
  }
  .calc-compo__seg.is-focus {
    transform: scaleY(1.12);
    filter: saturate(1.15) brightness(1.03);
    z-index: 2;
  }
  .calc-compo__seg.is-dim {
    opacity: 0.32;
  }
  .calc-compo__tip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 0;
    transform: translate(-50%, 6px);
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 0.5rem 0.7rem;
    background: var(--bbg-ink);
    color: #fff;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    box-shadow: var(--shadow-md);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.16s var(--ease),
      transform 0.16s var(--ease);
    z-index: 5;
  }
  .calc-compo__tip.is-open {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .calc-compo__tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--bbg-ink);
  }
  .calc-compo__tip-key {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
