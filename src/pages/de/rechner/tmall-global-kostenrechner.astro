  .calc-compo__tip-val {
    font-size: var(--fs-small);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  /* ranked cost cards */
  .calc-compo__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: var(--space-4);
