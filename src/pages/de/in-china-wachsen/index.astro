---
import Layout from '../../../layouts/Layout.astro';

const services = [
  {
    eyebrow: 'Shops',
    title: 'Cross-Border eCommerce',
    tagline: 'Tmall Global, JD Worldwide. Operative Steuerung der Flagship-Shops, vom Warenfluss im Lager bis zur Kasse beim Käufer.',
    href: '/de/in-china-wachsen/cross-border-ecommerce',
    cta: 'Shop-Operations entdecken',
    image: '/Images/grow-in-china/hero-livestream-shopper.png',
    alt: 'Eine chinesische Verbraucherin schliesst ihren Tmall-Global-Warenkorb während eines Livestreams am Smartphone ab',
    accent: '#C8102E',
    accentSoft: '#FBE9EC',
    span: 'wide',
  },
  {
    eyebrow: 'Kanäle',
    title: 'Social Commerce',
    tagline: 'Douyin, WeChat, Xiaohongshu. Eigene Livestream-Studios, Content-Produktion im Tagestakt.',
    href: '/de/in-china-wachsen/social-commerce',
    cta: 'Social-Bereich entdecken',
    image: '/Images/grow-in-china/social-commerce/hero-douyin-livestream.png',
    alt: 'Ein Douyin-Livestream-Set, Moderatorin vor der Kamera, Operator am Pult',
    accent: '#E54B6E',
    accentSoft: '#FCEAEF',
    span: 'narrow',
  },
  {
    eyebrow: 'Höhepunkte',
    title: 'Kampagnen',
    tagline: '618, Singles Day, Chinesisches Neujahr. Die Termine, die das Handelsjahr tragen, durchgefahren von A bis Z.',
    href: '/de/in-china-wachsen/kampagnen',
    cta: 'Kampagnen-Bereich entdecken',
    image: '/Images/grow-in-china/campaigns/hero-campaign-warroom.png',
    alt: 'Ein Kampagnen-Warroom während eines chinesischen Shopping-Festivals, Operatoren verfolgen ein Live-GMV-Board',
    accent: '#DC2626',
    accentSoft: '#FEE2E2',
    span: 'third',
  },
  {
    eyebrow: 'Reichweite',
    title: 'Media',
    tagline: 'Performance- und Marken-Media-Einkauf auf den chinesischen Plattformen. Reporting, mit dem Ihr Team auch arbeiten kann.',
    href: '/de/in-china-wachsen/media',
    cta: 'Media-Bereich entdecken',
    image: '/Images/grow-in-china/media/hero-media-buying.png',
    alt: 'Ein Media-Einkäufer prüft Tencent- und ByteDance-Dashboards in einem Shanghaier Büro',
    accent: '#C8102E',
    accentSoft: '#FCEAEF',
    span: 'third',
  },
  {
    eyebrow: 'Stimme',
    title: 'Influencer und KOL',
    tagline: 'Auswahl der KOL und bezahlte Aktivierungen auf den Plattformen, die tatsächlich zum Kauf führen.',
    href: '/de/in-china-wachsen/influencer-und-kol',
    cta: 'KOL-Bereich entdecken',
    image: '/Images/grow-in-china/influencers-kols/hero-kol-livestream.png',
    alt: 'Eine Douyin-KOL stellt ihrer Community eine ausländische Marke während eines gesponserten Livestreams vor',
    accent: '#F59E0B',
    accentSoft: '#FFF4E0',
    span: 'third',
  },
];

const studios = [
  {
    label: 'ChinaWebFoundry',
    desc: 'Ihre Website, in Shanghai konzipiert, für den chinesischen Markt gemacht. ICP-Registrierung, lokales Hosting, stabile Performance hinter der Great Firewall.',
    href: 'https://chinawebfoundry.com',
    logo: '/Images/AgencyLogos/Logo-ChinaWebFoundry-transparent.webp',
  },
  {
    label: 'hubStudio',
    desc: 'Unser integriertes Produktionshaus. Dreh, Schnitt, Post-Produktion, Motion Design. Formate, abgestimmt auf die chinesischen Plattformen.',
    href: 'https://hubstudio.ai',
    logo: '/Images/AgencyLogos/hubStudio%20(2).webp',
  },
];
---

<Layout
  title="In China wachsen | Marketing- und eCommerce-Agentur | TheChinaPath"
  description="Unsere Marketing- und eCommerce-Agentur in Shanghai führt Ihr China-Geschäft im Tagesbetrieb: Cross-Border, Social Commerce, Kampagnen, Media, Influencer und KOL."
>

  {/* ---------- HERO ---------- */}
  <section class="hero-fullbleed">
    <picture>
      <img
        src="/Images/grow-in-china/hero-livestream-shopper.png"
        alt=""
        class="hero-fullbleed__image"
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-fullbleed__overlay" aria-hidden="true"></div>

    <div class="container hero-fullbleed__inner">
      <div class="hero-fullbleed__copy">
        <span class="eyebrow eyebrow--on-dark">In China wachsen</span>
        <h1 class="hero-fullbleed__title">Das China-Geschäft, Tag für Tag im Griff.</h1>
        <p class="hero-fullbleed__lead">
          Ein Team mit Sitz in Shanghai übernimmt Ihre Shops, Ihre Kanäle und die Stimme Ihrer Marke. Sie entscheiden, was Sie uns übergeben, und wie schnell.
        </p>
        <div class="hero-fullbleed__actions">
          <a class="btn btn--primary" href="/de/kontakt">Kontakt aufnehmen</a>
          <a class="btn btn--ghost-light" href="#services">Leistungen ansehen</a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- SERVICES GRID ---------- */}
  <section class="section" id="services">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Fünf Leistungen, ein Team</span>
        <h2>Sagen Sie uns, wo wir einsteigen sollen.</h2>
        <p class="section-header__lead">
          Manche Marken brauchen ein Team, das die Steuerung des Flagship-Shops übernimmt. Andere wollen einen festen Rhythmus auf Livestream etablieren. Wieder andere haben den 618-Plan stehen, aber nicht das Team, das ihn umsetzt. Setzen Sie dort an, wo es am dringendsten brennt.
        </p>
      </header>

      <div class="grow-grid">
        {services.map((s) => (
          <a
            href={s.href}
            class={`grow-tile grow-tile--${s.span}`}
            style={`--accent: ${s.accent}; --accent-soft: ${s.accentSoft};`}
          >
            <div class="grow-tile__media">
              <img src={s.image} alt={s.alt} loading="lazy" decoding="async" />
              <div class="grow-tile__scrim" aria-hidden="true"></div>
            </div>

            <div class="grow-tile__body">
              <span class="grow-tile__eyebrow">{s.eyebrow}</span>
              <h3 class="grow-tile__title">{s.title}</h3>
              <p class="grow-tile__tagline">{s.tagline}</p>
              <span class="grow-tile__cta">
                {s.cta}
                <span class="grow-tile__arrow" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- STUDIOS ---------- */}
  <section class="section section--tight section--alt" id="studios">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Studios der Gruppe</span>
        <h2>Zwei integrierte Studios, nahtlos zuschaltbar.</h2>
        <p class="section-header__lead">
          Wenn ein Auftrag eine Website hinter der Great Firewall verlangt oder eine komplette Produktionsstrasse, übernehmen diese beiden Studios in ihrem Bereich.
        </p>
      </header>

      <div class="studio-grid">
        {studios.map((st) => (
          <a
            href={st.href}
            target="_blank"
            rel="noopener noreferrer"
            class="studio-card"
            aria-label={`${st.label} (öffnet in neuem Tab): ${st.desc}`}
          >
            <span class="studio-card__logobox">
              <img src={st.logo} alt={st.label} loading="lazy" width="320" height="80" />
            </span>
            <span class="studio-card__desc">{st.desc}</span>
            <span class="studio-card__cta">
              Website öffnen
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- FINAL CTA ---------- */}
  <section class="section section--tight">
    <div class="container">
      <div class="grow-cta">
        <div class="grow-cta__copy">
          <span class="eyebrow">Unsicher, wo Sie ansetzen sollen?</span>
          <h2>Schicken Sie uns Ihren letzten Kampagnen-Report. Wir zeigen Ihnen, was fehlt.</h2>
          <p class="grow-cta__lead">
            Es antwortet ein Senior-Praktiker, direkt, kein Chatbot. Zwanzig Minuten Gespräch ersparen meistens ein Quartal voller Probierens.
          </p>
        </div>
        <div class="grow-cta__actions">
          <a class="btn btn--primary" href="/de/kontakt">Gespräch beginnen</a>
          <a class="btn btn--ghost" href="/de/referenzen">Referenzen ansehen</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .grow-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.5rem;
  }

  .grow-tile--wide   { grid-column: span 4; }
  .grow-tile--narrow { grid-column: span 2; }
  .grow-tile--third  { grid-column: span 2; }

  .grow-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 380px;
    padding: 2rem;
    border-radius: 16px;
    overflow: hidden;
    color: #fff;
    background: var(--bbg-ink);
    isolation: isolate;
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .grow-tile--wide { min-height: 440px; }
  .grow-tile--narrow { min-height: 440px; }

  .grow-tile::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--accent);
    z-index: 3;
  }

  .grow-tile__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .grow-tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .grow-tile__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.3) 45%, rgba(0,0,0,0.85) 100%);
    z-index: 1;
    transition: opacity 300ms ease;
  }

  .grow-tile__body {
    position: relative;
    z-index: 2;
    max-width: 36rem;
  }

  .grow-tile__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    margin-bottom: 1rem;
  }

  .grow-tile__title {
    font-size: clamp(1.4rem, 1.6vw + 0.9rem, 1.85rem);
    line-height: 1.15;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.55rem;
    letter-spacing: -0.01em;
  }

  .grow-tile--wide .grow-tile__title {
    font-size: clamp(1.6rem, 2.2vw + 1rem, 2.25rem);
  }

  .grow-tile__tagline {
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(255,255,255,0.92);
    margin: 0 0 1.15rem;
    max-width: 28rem;
  }

  .grow-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(255,255,255,0.4);
    width: fit-content;
    transition: border-color 200ms ease, color 200ms ease;
  }

  .grow-tile__arrow {
    display: inline-block;
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .grow-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.18);
    color: #fff;
  }
  .grow-tile:hover .grow-tile__media img { transform: scale(1.05); }
  .grow-tile:hover .grow-tile__scrim {
    background:
      linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.5) 45%, rgba(0,0,0,0.9) 100%);
  }
  .grow-tile:hover .grow-tile__cta { border-color: #fff; }
  .grow-tile:hover .grow-tile__arrow { transform: translateX(6px); }

  .grow-tile:focus-visible {
    outline: 3px solid var(--bbg-blue);
    outline-offset: 4px;
  }

  .studio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .studio-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--bbg-border);
    color: var(--bbg-text);
    text-decoration: none;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .studio-card__logobox {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 56px;
  }
  .studio-card__logobox img {
    max-height: 100%;
    width: auto;
    object-fit: contain;
  }

  .studio-card__desc {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--bbg-text);
    margin: 0;
  }

  .studio-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--bbg-blue);
    font-size: 0.95rem;
  }

  .studio-card:hover {
    transform: translateY(-3px);
    border-color: var(--bbg-blue);
    box-shadow: 0 16px 32px rgba(200, 16, 46, 0.1);
  }
  .studio-card:focus-visible {
    outline: 3px solid var(--bbg-blue);
    outline-offset: 3px;
  }

  .grow-cta {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .grow-cta__copy h2 { margin: 0 0 0.75rem; }
  .grow-cta__lead {
    font-size: 1.0625rem;
    color: var(--bbg-text);
    margin: 0;
    max-width: 38rem;
  }
  .grow-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  @media (max-width: 1024px) {
    .grow-grid { grid-template-columns: repeat(2, 1fr); }
    .grow-tile--wide,
    .grow-tile--narrow,
    .grow-tile--third { grid-column: span 1; }
    .grow-tile--wide { grid-column: span 2; }
  }

  @media (max-width: 720px) {
    .grow-grid { grid-template-columns: 1fr; gap: 1rem; }
    .grow-tile--wide,
    .grow-tile--narrow,
    .grow-tile--third { grid-column: span 1; min-height: 360px; }
    .studio-grid { grid-template-columns: 1fr; }
    .grow-cta { grid-template-columns: 1fr; }
    .grow-cta__actions { justify-content: flex-start; }
  }

  @media (max-width: 480px) {
    .grow-tile { min-height: 340px; padding: 1.5rem; }
    .grow-tile__tagline { font-size: 0.95rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .grow-tile,
    .grow-tile__media img,
    .grow-tile__scrim,
    .grow-tile__cta,
    .grow-tile__arrow,
    .studio-card { transition: none !important; }
  }
</style>
