---
import ChannelKit from '../../../components/ChannelKit.astro';
import Layout from '../../../layouts/Layout.astro';
import CaseStudyStrip from '../../../components/CaseStudyStrip.astro';

const eventCosts = [
  {
    platform: 'Tmall',
    cost: 'Alimama-Werbung, Affiliate-Provisionen von 5 bis 50 %, die Rabatte, die Sie bei 88VIP und Preisaktionen finanzieren',
  },
  {
    platform: 'JD',
    cost: 'JD-Werbung mit rund 10 bis 40 RMB je Bestellung, Affiliates und Aktionskosten, die zu 618 und 11.11 weitere 15 bis 20 % des Umsatzes ausmachen können',
  },
  {
    platform: 'Douyin',
    cost: 'Qianchuan-Werbung, Creator-Provision (seit April 2026 mindestens 5 %), Platzierungsgebühren',
  },
  {
    platform: 'Xiaohongshu',
    cost: 'Such- und Feed-Anzeigen zu 0,8 bis 3 RMB je Klick, Note-Boosts, Creator-Honorare plus 10 % Plattformgebühr',
  },
];
---

<Layout
  title="Kampagnen für 618, Double 11 und CNY in China | TheChinaPath"
  description="Kampagnen für Chinas große Shopping-Termine, von 618 über Double 11 bis zum Chinesischen Neujahr: Strategie, KOL, Media, Kreation und Reporting."
>
  <section class="hero-fullbleed">
    <picture>
      <img
        src="/Images/grow-in-china/campaigns/hero-campaign-warroom.png"
        alt=""
        class="hero-fullbleed__image"
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-fullbleed__overlay" aria-hidden="true"></div>

    <div class="container hero-fullbleed__inner">
      <div class="hero-fullbleed__copy">
        <span class="eyebrow eyebrow--on-dark">Kampagnen</span>
        <h1 class="hero-fullbleed__title">
          Die großen chinesischen Shopping-Termine, vom Warm-up bis zum Peak durchgefahren.
        </h1>
        <p class="hero-fullbleed__lead">
          618, Singles Day, Chinesisches Neujahr und die kleineren Plattform-Festivals. Wir wählen
          die Momente, für die sich der Kampf lohnt, entwickeln die Kreation, fahren das Warm-up und
          bleiben in der Peak-Phase Stunde für Stunde dran.
        </p>
        <div class="hero-fullbleed__actions">
          <a class="btn btn--primary" href="/de/kontakt">Kampagne anfragen</a>
          <a class="btn btn--ghost-light" href="#leistungen">Vorgehen ansehen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="leistungen">
    <div class="container container--narrow">
      <header class="section-header">
        <span class="eyebrow">Was wir machen</span>
        <h2>Sechs Wochen Warm-up, 24 Stunden Peak, ein Plan.</h2>
      </header>

      <article class="prose">
        <h3>Kalender- und Zielplanung</h3>
        <p>
          Welche Festivals für Ihre Kategorie wirklich Umsatz bringen, welche nur Lärm sind. Wir
          legen einen Jahreskalender mit klaren GMV-Zielen pro Termin auf und entscheiden gemeinsam,
          wo das Budget hingehört.
        </p>

        <h3>Kreation und Botschaft</h3>
        <p>
          Plattformspezifische Visuals, Hero-Filme, KOL-Hooks, Display-Banner. Wir entwickeln
          Kreation, die zu dem Kaufmoment passt, in dem chinesische Käufer gerade stecken.
        </p>

        <h3>Warm-up</h3>
        <p>
          Vier bis sechs Wochen vor dem Peak: KOL-Drops, Display-Tests, Keyword-Abdeckung auf Tmall
          und JD, Aufbau der Pre-Sale-Listen. Wir bringen die Marke heiß in den Peak, nicht kalt.
        </p>

        <h3>Peak-Steuerung</h3>
        <p>
          Warroom in Shanghai mit Praktikern, Media-Einkäufern und Plattform-Ansprechpartnern.
          Stunde für Stunde optimiert: Budget verschieben, Listings tauschen, Livestream-Slots
          nachsteuern, KOL nachfeuern.
        </p>

        <h3>Nachbereitung</h3>
        <p>
          Was wirklich gegriffen hat, was nicht, was wir nächstes Jahr anders machen. Ein
          Bericht, den der Vorstand lesen kann, ohne Übersetzung aus dem Marketing-Slang.
        </p>
      </article>
    </div>
  </section>

  {/* ---------- EVENT COSTS ---------- */}
  <section id="event-costs" class="section ck-section" data-ck-section>
    <div class="container">
      <header data-ck-rv>
        <span class="ck-kicker">Aktionskosten</span>
        <h2 class="ck-h2">Was eine Verkaufsaktion wirklich kostet</h2>
      </header>

      <div class="ck-block" data-ck-rv>
        <div class="table-scroll" data-ck="cards">
          <table>
            <thead>
              <tr>
                <th scope="col">Plattform</th>
                <th scope="col">Was Sie im Store bezahlen</th>
              </tr>
            </thead>
            <tbody>
              {
                eventCosts.map((row) => (
                  <tr>
                    <th scope="row">{row.platform}</th>
                    <td>{row.cost}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="ck-block ck-callout" data-ck-rv>
        <span class="ck-callout__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.5"/></svg></span>
        <div>
          <p>
            Im Eigenhandel holt sich die Plattform Aktionsrabatte über den Margenschutz bei der
            Marke zurück. Wir planen sie deshalb als Marketingausgabe ein und behandeln sie nicht
            als Preisentscheidung.
          </p>
        </div>
      </div>

      <div class="ck-more" data-ck-rv>
        <a href="/de/ratgeber/in-china-verkaufen-ohne-chinesische-firma" class="btn btn--ghost">Zum vollständigen Ratgeber</a>
      </div>
    </div>
  </section>
  <ChannelKit />

  <CaseStudyStrip slugs={["chery","master-martini","exeed"]} />

  <section class="section section--tight section--alt">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__copy">
          <span class="eyebrow">Sprechen wir</span>
          <h2>
            Schicken Sie uns Ihren letzten 618- oder Double-11-Bericht. Wir zeigen Ihnen, wo der
            eigentliche Hebel sitzt.
          </h2>
          <div class="cta-card__actions">
            <a href="/de/kontakt" class="btn btn--primary">Gespräch beginnen</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
