    image: '/Images/grow-in-china/decision-tp-unboxing.png',
    imageAlt: 'A Chinese student in a tier-2 city apartment unboxing a cross-border parcel with imported products on the floor',
  },
  {
    name: 'Distributor model',
    tag: 'We own the inventory, we run the store',
    desc: 'We buy your product at wholesale and own the stock in China. The store is operated under our license, the inventory sits on our balance sheet, and we carry the commercial risk. You sell to us, we sell to the consumer.',
    when: 'You already have brand awareness in China, you want China revenue without China complexity, you do not want to fund inventory or carry stock risk, and you want a single accountable partner buying your product and selling it through. New-to-market brands rarely fit this model.',
    owns: [
      { label: 'Inventory', value: 'Ours' },
      { label: 'Store license', value: 'Ours' },
      { label: 'Customer data', value: 'Ours' },
      { label: 'Content, media, contracts', value: 'Ours' },
      { label: 'Media spend', value: 'Brand budget + TheChinaPath co-invest' },
      { label: 'Revenue', value: 'Wholesale invoice, recognised as B2B' },
    ],
    yourSide: [
      'Wholesale revenue with no inventory risk',
      'A single B2B invoice instead of a complex direct-to-consumer P&L',
      'No working capital tied up in China stock',
      'Aggregated performance reporting and category insight',
    ],
    ourSide: [
      'Inventory purchase, financing and warehousing',
      'Everything in the TP model, plus the commercial risk',
      'Pricing strategy across platforms within agreed brand guardrails',
      'Returns, refunds, customer service liability',
    ],
    image: '/Images/grow-in-china/decision-distributor-mother.png',
    imageAlt: 'A young Chinese mother on a sofa watching a livestream commerce broadcast on her tablet while her daughter plays nearby',
    highlight: false,
  },
];

const compareRows = [
  { label: 'Who owns the inventory', tp: 'You', dist: 'TheChinaPath' },
  { label: 'Who owns the store and the data', tp: 'You', dist: 'TheChinaPath' },
  { label: 'Working capital you put in', tp: 'High', dist: 'None' },
  { label: 'Revenue you book', tp: 'Retail GMV minus fees', dist: 'Wholesale price' },
  { label: 'Margin upside', tp: 'Full retail margin', dist: 'Capped at wholesale' },
  { label: 'Risk you carry', tp: 'Stock and demand', dist: 'None on inventory' },
  { label: 'Media and promotion costs', tp: '100% on you', dist: 'Brand budget + TheChinaPath co-invest' },
  { label: 'Brand equity in China', tp: 'Yours, fully', dist: 'Yours, built through us' },
  { label: 'Best for', tp: 'Brands building long-term China P&L', dist: 'Brands already known in China' },
];

const costLedger = {
  tp: {
    label: 'TP model',
    sub: 'You own the store. We run it.',
    agency: {
      tag: 'Agency line',
      headlineLead: 'From',
      headlineNum: 7500,
      headlinePrefix: '$',
      headlineSuffix: '',
      headlineUnit: 'per month',
      pill: '+ 10% on GMV',
      body: 'Monthly retainer starting from $7,500 plus a 10% revenue share on GMV, with movement up or down depending on category and platforms covered. Media and content production billed at pass-through.',
      footer: 'We rarely take new-to-market brands as a distributor. The brand-building lift from zero is too costly unless you commit a serious launch fund. For most new entrants, TP is the right answer.',
    },
    brand: {
      tag: 'Brand budget',
      headlineNum: 100,
      headlinePrefix: '',
      headlineSuffix: '%',
      headlineUnit: 'on you',
      pill: 'From $120K in year one',
      body: 'You fund 100% of media, content and promotion. We execute against your approved budget. Every yuan flows through your platform account, fully visible to you.',
      footer: 'Typical ranges: paid media from $120,000 across the first twelve months. Content billed at cost plus a small handling fee. KOL and KOC invoiced by the talent agency. We never take referral commissions on KOL spend.',
    },
  },
  distributor: {
    label: 'Distributor model',
    sub: 'We buy. We sell. You ship.',
    agency: {
      tag: 'Agency line',
      headlineLead: '',
      headlineNum: 0,
      headlinePrefix: '$',
      headlineSuffix: '',
      headlineUnit: 'retainer',
      pill: 'Margin sits in retail price',
      body: 'No retainer, no revenue share. Our margin sits in the retail price. Wholesale terms depend on volume commitment, exclusivity and the campaign calendar.',
      footer: 'Distributor terms suit brands already known in China. New entrants almost always start on TP and graduate later, once awareness justifies the volume commit.',
    },
    brand: {
      tag: 'Brand budget',
      headlineText: 'Co-funded',
      headlineUnit: 'brand + TheChinaPath',
      pill: 'Heavy lift on 618 + 11.11',
      body: 'The brand provides a marketing budget for the year, and we deploy it against a co-agreed plan. TheChinaPath often co-invests from retail margin on top, particularly on always-on platform media and promotional mechanics for 618 and 11.11.',
      footer: 'Co-invest sits inside the wholesale margin we earn. You see the plan, you sign the plan, and we report against it line by line.',
    },
  },
};

const platformLedger = {
  tag: 'Platform fees',
  headlineNum: 5,
  headlinePrefix: '~',
  headlineSuffix: '%',
  headlineUnit: 'commission, top end',
  pill: 'Pass-through, never marked up',
  body: 'Platform fees on Tmall Global and JD Worldwide come straight off the official Chinese-language fee schedule, not estimated. Three buckets to plan for.',
  buckets: [
    {
      title: 'Annual platform fee',
      sub: 'Fixed annual fee plus a refundable deposit on Tmall Global. JD Worldwide runs similar brackets.',
      meter: 'Fixed',
      meterPct: 35,
    },
    {
      title: 'Transaction commission',
      sub: 'Roughly 2% to 5% on each sale. Beauty and supplements at the high end. Hard goods at the low end.',
      meter: '2 to 5%',
      meterPct: 80,
    },
    {
      title: 'Payment gateway',
      sub: 'Alipay and WeChat Pay each take a small percentage on every transaction.',
      meter: 'Per txn',
      meterPct: 22,
    },
  ],
  footer: 'These are the same numbers every brand pays. We do not mark them up, ever.',
};

const steps = [
  {
    icon: 'compass',
    phase: 'Phase one',
    duration: '2 to 3 weeks',
    title: 'Audit and growth diagnosis',
    desc: 'We pull the store apart and rebuild the picture across traffic, conversion, retention, content and media efficiency. You walk away with three ranked growth levers, the numbers behind them, and a 90-day priority plan.',
  },
  {
    icon: 'palette',
    phase: 'Phase two',
    duration: '4 to 6 weeks',
    title: 'Store and content rebuild',
    desc: 'New PDPs, new banners, new video, a working livestream room. The store starts looking like it sells in 2026, not 2021, and the content survives platform algorithm changes.',
  },
  {
    icon: 'rocket',
    phase: 'Phase three',
    duration: '4 to 8 weeks',
    title: 'Media and traffic activation',
    desc: 'Paid search, paid display, paid livestream, KOL and KOC. We turn on the taps across Alimama, JD media and Douyin Qianchuan, with RED seeding feeding the upper funnel. Every yuan tied to conversion.',
  },
  {
    icon: 'trend',
    phase: 'Phase four',
    duration: 'Always on, annual reset',
    title: 'Operations and scale',
    desc: 'Daily operations, weekly optimisation, monthly business review, quarterly campaign planning. We run the calendar (618, 99, 11.11, Double 12, Chinese New Year) and reset the priority list with a fresh audit every twelve months.',
  },
];

const sisterPackages = [
  {
    title: 'Always-on social',
    desc: 'Daily WeChat, RED, Douyin and Weibo run alongside your flagship store. For brands whose store is live and needs constant content fuel.',
  },
  {
    title: 'Launch sprint',
    desc: 'A three-month intensive across all four channels around a Tmall Global or JD Worldwide launch. For the opening wave.',
  },
  {
    title: 'Festival drive',
    desc: 'Campaign-specific social activation for 618, 11.11, Double 12 or Chinese New Year. For brands where the calendar moment matters more than the always-on cadence.',
  },
];

const contextCards = [
  {
    image: '/Images/grow-in-china/truth-comparing-products.png',
    alt: 'A Chinese man in his late 30s comparing two imported product boxes while looking at a Chinese eCommerce app in a quiet cafe',
    kicker: 'One roof',
    title: 'The team that wrote the plan stays on the store',
    body: 'Most agencies split strategy from execution. We keep both under one roof. The senior who wrote the plan runs your weekly ops sync.',
    flow: ['Strategy', 'Planning', 'Operations'],
    chipLabel: 'Weekly ops sync',
    chipSub: 'Strategy + ops in the same room',
    avatars: [
      { letter: 'L', tone: 'blue' },
      { letter: 'C', tone: 'dark' },
      { letter: 'Y', tone: 'green' },
      { letter: 'M', tone: 'amber' },
    ],
    extraAvatars: '+3',
    pinLabel: 'Live dashboard',
    pinValue: 'Open at any time',
  },
  {
    image: '/Images/enter-china/team.png',
    alt: 'The TheChinaPath eCommerce operations team working in an open office',
    kicker: 'Scars from the platform',
    title: 'Operators first, strategists second',
    body: 'Our senior team ran Tmall and JD stores at Publicis Commerce China. They have lost a Double 11 and won the next one.',
    credentials: ['Beauty', 'FMCG', 'Lifestyle', 'Supplements'],
    chipLabel: 'Ex-Publicis Commerce',
    chipSub: 'Senior leads, ten years on platform',
    badge: 'Won the next 11.11',
    badgeSub: 'After losing one. The lesson stuck.',
  },
];

const faqs = [
  { cat: 'Operations', q: 'What does running a Tmall Global store actually involve day to day?', a: 'More than people expect. Daily store updates, banner swaps, promotion setup, inventory sync with the bonded warehouse, Mandarin customer service, order checks, returns, review moderation, livestream prep. A flagship store left untouched for a week loses ranking. Leave it untouched for a month and it loses category position. The work is steady, not glamorous, and it is what separates the stores that grow from the ones that just exist.' },
  { cat: 'Operations', q: 'How fast can you take over an existing store?', a: 'Two to four weeks for an audit and clean handover. Longer if the previous partner is uncooperative (it happens). We pull everything first: backend access, media accounts, customer data, content library, supplier contracts. Then we map what is missing. We run two weeks in parallel before cutting over, so you do not lose a campaign window in the transition.' },
  { cat: 'Operations', q: 'Do you handle customer service in Mandarin?', a: 'Yes. Native Mandarin team working platform hours (9 a.m. to 11 p.m. local time, longer during 11.11). Tmall Global, JD Worldwide and Douyin EC Global all measure response time and bake it into your store score. We hold response time under 30 seconds and we keep ratings above platform average.' },
  { cat: 'Operations', q: 'How do you handle logistics and bonded warehouse?', a: 'We coordinate with your existing bonded warehouse provider, or we introduce one if you do not have one. Most Tmall Global brands run through Cainiao bonded warehouses. For JD Worldwide, JD’s own bonded network is usually the faster route. We track stock, file customs, handle returns and chase delays. Logistics is not glamorous. It is just the difference between a 4.9 store rating and a 4.5.' },
  { cat: 'Operations', q: 'What happens when an SKU sells out mid-campaign?', a: 'We flag it before it happens. Stock reorder triggers are set in the dashboard. If you cannot replenish in time, we shift the campaign weight to a sister SKU, redirect paid media, and protect the store rating with a clear holding page. The worst outcome is a silent stockout, and we make sure that does not happen.' },
  { cat: 'Operations', q: 'How do you handle returns and fake reviews?', a: 'Returns are managed by the bonded warehouse partner under our coordination. Return rates typically run 8% to 15% in beauty, 15% to 25% in fashion, under 5% in F&B and supplements. Fake reviews and review-bombing attacks happen, especially after a viral moment. We monitor daily, file removal requests with the platform, and seed genuine customer reviews through our KOC network.' },
  { cat: 'Platforms', q: 'Which platform should I run first?', a: 'Depends on category, brand maturity and content readiness. Tmall Global is the default for beauty, supplements, F&B and lifestyle, where brand trust matters most. JD Worldwide wins on electronics, home, male-skewing categories and consumables that benefit from JD logistics. Douyin EC Global is the right call when content is your strength and you can produce livestream every day. We pick the right one in Phase one, not by default.' },
  { cat: 'Platforms', q: 'Can we run Tmall Global and JD Worldwide at the same time?', a: 'Yes, and most brands at scale do. Tmall Global usually carries the brand flagship. JD Worldwide picks up logistics-sensitive categories and male shoppers. Be ready for double the operations workload, double the campaign cadence, and a clear pricing strategy across both. We run multi-platform accounts every day.' },
  { cat: 'Platforms', q: 'What about Douyin EC Global?', a: 'Growing fast. Douyin closed the gap on Tmall Global across beauty, F&B and lifestyle in 2025 and 2026, because livestream is the format where conversion sits highest. The catch is content production: daily livestream, weekly creative refresh, constant short video. Brands without content discipline burn money on Douyin. Brands that have it, win.' },
  { cat: 'Platforms', q: 'Where does RED (Xiaohongshu) fit?', a: 'Discovery, not transaction. RED is where Chinese consumers research before buying on Tmall Global, JD Worldwide or Douyin EC Global. We use it for KOC seeding, brand reputation and demand creation. In-app commerce on RED is still small for cross-border. The standard play is RED for influence and Tmall Global or JD Worldwide for conversion, though some categories now flip that order.' },
  { cat: 'Performance', q: 'What growth should I expect in year one?', a: 'Depends on category, starting point and budget. New flagship stores on Tmall Global or JD Worldwide typically land their first full year between $400,000 and the low single-digit millions in GMV, depending on media spend and category. Relaunched stores with an existing baseline tend to grow 30% to 80% in the first twelve months under our operations. Anyone quoting a single number without seeing your category and budget is selling, not advising.' },
  { cat: 'Performance', q: 'When do we see results?', a: 'First metrics shift in week six (conversion, traffic mix, content engagement). Revenue shifts usually land in month three or four. The first big campaign window after takeover (618, 99, 11.11) is where the real number prints. Cross-border in China rewards patience, not impatience.' },
  { cat: 'Performance', q: 'How do you report?', a: 'Live dashboard you can open at any time (traffic, GMV, ROAS, conversion, repeat rate). A weekly written summary covering what moved and what is next. A monthly senior business review on video with Cyril or Liyan. A quarterly planning session. No PDFs that arrive a week late. We share the same dashboard we use internally.' },
  { cat: 'Compliance', q: 'What if my product cannot be sold through cross-border?', a: 'We tell you before we sign. Some products do not qualify (restricted categories, certain medical claims, formulation issues). If yours is one, we say so in week one, and we either help you reposition or recommend a different route to market. We do not run stores for products that will get pulled six months in.' },
  { cat: 'Compliance', q: 'What about platform takedowns or penalties?', a: 'We handle them. A penalty notice on Tmall Global or JD Worldwide has to be answered within 24 to 72 hours depending on severity. Our ops team handles the response, the rectification plan and the platform negotiation. Penalties happen, even at top brands. What matters is how fast you recover.' },
  { cat: 'Contract', q: 'What is the minimum engagement length?', a: 'Twelve months for the TP model. Twenty-four months for the distributor model. Cross-border stores need time to ramp, especially through the first major campaign window, and an inventory commitment needs a longer runway to recover. Shorter engagements are possible for project-based work (618 sprint, 11.11 sprint, launch sprint) but not for always-on operations. Anyone promising always-on results inside three months is signing you up for a poor outcome.' },
  { cat: 'Contract', q: 'Who owns the store license, customer data and content?', a: 'Depends entirely on the model. In the TP model, you own everything: store license, customer data, content library, media accounts and supplier contracts. We run operations under your brand and your assets. Nothing transfers at exit because nothing was ever ours. In the distributor model, we own everything: the store, the inventory, the customer data, the content and the media accounts. You sell to us, we sell to the consumer. Brand IP and trademarks stay yours, naturally, but the China commercial infrastructure sits on our side.' },
  { cat: 'Team', q: 'Who runs my account day to day?', a: 'A dedicated senior account director, a store operations lead, a content producer and a media buyer. They are full-time on China cross-border, not splitting their hours across five clients. Cyril or Liyan join the monthly review and step in on commercial calls.' },
  { cat: 'Team', q: 'Where is the team based?', a: 'Native team based in mainland China, working platform hours. Senior leadership splits time between China, Hong Kong and Paris. You get one inbox, one Slack channel, and a working day that overlaps with both China and Europe.' },
  { cat: 'Team', q: 'Do you work with my global agency or in-house team?', a: 'Yes. We slot into existing brand frameworks and we share what we learn back to your global team. We do not try to wedge ourselves into work that is already covered elsewhere. The brief from week one is to run the China stores, not to redo the global plan.' },
];

const faqCategories = ['All', 'Operations', 'Platforms', 'Performance', 'Compliance', 'Contract', 'Team'];

const icons: Record<string, string> = {
  compass: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="16 8 13 13 8 16 11 11 16 8"/></svg>`,
  palette: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 0 18c1 0 2-1 2-2s-1-2-2-2h-1a2 2 0 0 1 0-4h3a5 5 0 0 0 5-5 5 5 0 0 0-5-5z"/><circle cx="7.5" cy="11" r="1"/><circle cx="9.5" cy="7.5" r="1"/><circle cx="14" cy="6.5" r="1"/><circle cx="17.5" cy="9.5" r="1"/></svg>`,
  rocket: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4c4 0 6 2 6 6-4 0-6 2-6 6-4 0-6-2-6-6 4 0 6-2 6-6z"/><circle cx="14" cy="10" r="1.5"/><path d="M8 16l-3 3M11 19l-2 2M5 13l-2 2"/></svg>`,
  trend: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="15 7 21 7 21 13"/></svg>`,
  wallet: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 7V5a2 2 0 0 1 2-2h11l3 4"/><circle cx="16.5" cy="13.5" r="1.25" fill="currentColor"/></svg>`,
  'platform-fee': `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/><path d="M7 15h4"/><path d="M14 15h3"/></svg>`,
  megaphone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11v2a2 2 0 0 0 2 2h2l8 4V5L7 9H5a2 2 0 0 0-2 2z"/><path d="M19 8a4 4 0 0 1 0 8"/></svg>`,
  spark: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l3 3M15 15l3 3M18 6l-3 3M9 15l-3 3"/></svg>`,
  scroll: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5z"/><path d="M8 7h7M8 11h7M8 15h4"/></svg>`,
};
---

<Layout
  title="Cross-Border eCommerce Agency in China | TheChinaPath"
  description="We run Tmall Global, JD Worldwide and Douyin EC Global stores for foreign brands. Daily ops, content, paid media, livestream. One senior team."
>
  <div class="cbs-progress" aria-hidden="true"><div class="cbs-progress__bar"></div></div>
  <article class="cbs">

    {/* ---------- HERO ---------- */}
    <section class="cbs-hero" data-hero>
      <div class="cbs-hero__bg" aria-hidden="true" data-parallax>
        <img src="/Images/grow-in-china/hero-livestream-shopper.png" alt="A young Chinese woman scrolling a livestream commerce broadcast on her phone at night during a Chinese shopping festival" />
      </div>
      <div class="cbs-hero__overlay" aria-hidden="true"></div>
      <div class="cbs-hero__grain" aria-hidden="true"></div>

      <div class="container cbs-hero__inner">
        <nav class="cbs-hero__crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/#services">Grow in China</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark cbs-reveal">Cross-Border eCommerce</span>
        <h1 class="cbs-hero__title cbs-reveal" style="--reveal-delay: 80ms;">
          <span class="cbs-hero__title-row">Opening the store takes weeks.</span>
          <span class="cbs-hero__title-row cbs-hero__title-row--accent">Growing it takes years.</span>
          <span class="cbs-hero__title-row cbs-hero__title-row--highlight">We do the years.</span>
        </h1>
        <p class="cbs-hero__lead cbs-reveal" style="--reveal-delay: 200ms;">
          Most foreign brands have a Tmall Global or JD Worldwide store. Few have one
          that grows. We run flagship stores every day, with one senior lead on call.
        </p>
        <div class="cbs-hero__actions cbs-reveal" style="--reveal-delay: 280ms;">
          <a href="/contact" class="btn btn--primary cbs-magnetic">Talk to us</a>
          <a href="#how-we-work" class="btn btn--ghost-light cbs-magnetic">See how we work</a>
        </div>

        <div class="cbs-hero__meta cbs-reveal" style="--reveal-delay: 360ms;">
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num" data-counter="15" data-suffix="+">0</span>
            <span class="cbs-hero__meta-label">years running Chinese eCommerce stores</span>
          </div>
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num" data-counter="15" data-suffix="+">0</span>
            <span class="cbs-hero__meta-label">flagship stores operated end to end</span>
          </div>
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num">Daily</span>
            <span class="cbs-hero__meta-label">Store ops, content, media, livestream</span>
          </div>
        </div>
      </div>

      <a href="#two-truths" class="cbs-hero__scroll" aria-label="Scroll to next section">
        <span class="cbs-hero__scroll-line"></span>
        <span class="cbs-hero__scroll-text">Scroll</span>
      </a>
    </section>

    {/* ---------- TWO TRUTHS ---------- */}
    <section id="two-truths" class="section cbs-truths-section">
      <div class="cbs-truths-bg" aria-hidden="true">
        <div class="cbs-truths-bg__blob cbs-truths-bg__blob--a"></div>
        <div class="cbs-truths-bg__blob cbs-truths-bg__blob--b"></div>
        <div class="cbs-truths-bg__grid"></div>
      </div>

      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Our approach</span>
          <h2>Two things to know before we touch your store</h2>
          <p class="section-header__lead">
            A cross-border store in China is a daily product, not a quarterly project.
            Here is how that shapes the way we work.
          </p>
        </header>

        <div class="cbs-truths" data-truths>
          {contextCards.map((c, i) => (
            <article
              class={`cbs-truth${i === 1 ? ' cbs-truth--alt' : ''} cbs-reveal`}
              style={`--reveal-delay: ${i * 140}ms;`}
              data-truth-tilt
            >
              <div class="cbs-truth__inner">
                <div class="cbs-truth__stage">
                  <div class="cbs-truth__frame">
                    <img
                      src={c.image}
                      alt={c.alt}
                      loading="lazy"
                      decoding="async"
                      data-truth-parallax
                    />
                    <div class="cbs-truth__shade" aria-hidden="true"></div>
                    <div class="cbs-truth__sheen" aria-hidden="true"></div>
                  </div>

                  <div class="cbs-truth__kicker" aria-hidden="true">
                    <span class="cbs-truth__kicker-dot"></span>
                    {c.kicker}
                  </div>

                  {i === 0 && (
                    <div class="cbs-truth__chip cbs-truth__chip--bl" data-float="1">
                      <div class="cbs-truth__chip-row">
                        <span class="cbs-truth__pulse" aria-hidden="true"></span>
                        <span class="cbs-truth__chip-label">{c.chipLabel}</span>
                      </div>
                      <p class="cbs-truth__chip-sub">{c.chipSub}</p>
                      <div class="cbs-truth__avatars">
                        {c.avatars && c.avatars.map((a) => (
                          <span class={`cbs-truth__avatar cbs-truth__avatar--${a.tone}`}>{a.letter}</span>
                        ))}
                        <span class="cbs-truth__avatar cbs-truth__avatar--more">{c.extraAvatars}</span>
                      </div>
                    </div>
                  )}

                  {i === 0 && (
                    <div class="cbs-truth__pin" data-float="2">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="3 17 9 11 13 15 21 7"></polyline>
                        <polyline points="15 7 21 7 21 13"></polyline>
                      </svg>
                      <div class="cbs-truth__pin-text">
                        <span class="cbs-truth__pin-label">{c.pinLabel}</span>
                        <span class="cbs-truth__pin-value">{c.pinValue}</span>
                      </div>
                    </div>
                  )}

                  {i === 1 && (
                    <div class="cbs-truth__chip cbs-truth__chip--tr" data-float="1">
                      <div class="cbs-truth__chip-row">
                        <svg class="cbs-truth__chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M12 2l3 6 6 .9-4.5 4.3 1 6.3L12 16.8 6.5 19.5l1-6.3L3 8.9 9 8z"/>
                        </svg>
                        <span class="cbs-truth__chip-label">{c.chipLabel}</span>
                      </div>
                      <p class="cbs-truth__chip-sub">{c.chipSub}</p>
                    </div>
                  )}

                  {i === 1 && (
                    <div class="cbs-truth__badge" data-float="2">
                      <span class="cbs-truth__badge-eyebrow">Track record</span>
                      <span class="cbs-truth__badge-title">{c.badge}</span>
                      <span class="cbs-truth__badge-sub">{c.badgeSub}</span>
                    </div>
                  )}
                </div>

                <div class="cbs-truth__content">
                  <h3 class="cbs-truth__title">{c.title}</h3>
                  <p class="cbs-truth__body">{c.body}</p>

                  {i === 0 && c.flow && (
                    <ol class="cbs-truth__flow" aria-label="Strategy, planning and operations under one roof">
                      {c.flow.map((step, idx) => (
                        <>
                          <li class="cbs-truth__flow-step" style={`--flow-delay: ${idx * 90}ms`}>
                            <span class="cbs-truth__flow-bubble">
                              {idx === 0 && (
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polygon points="16 8 13 13 8 16 11 11 16 8"/></svg>
                              )}
                              {idx === 1 && (
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>
                              )}
                              {idx === 2 && (
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3h0a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8v0a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
                              )}
                            </span>
                            <span class="cbs-truth__flow-label">{step}</span>
                          </li>
                          {idx < c.flow.length - 1 && (
                            <li class="cbs-truth__flow-arrow" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                            </li>
                          )}
                        </>
                      ))}
                    </ol>
                  )}

                  {i === 1 && c.credentials && (
                    <ul class="cbs-truth__tags" aria-label="Categories the team has run on platform">
                      {c.credentials.map((tag) => (
                        <li class="cbs-truth__tag">{tag}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- DECISION POINT (Two models) ---------- */}
    <section class="section section--alt cbs-models-section">
      <div class="cbs-models-section__bg" aria-hidden="true">
        <img src="/Images/enter-china/four-ways-tiles.png" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Decision point</span>
          <h2>Who owns the inventory. Two ways we run your store.</h2>
          <p class="section-header__lead">
            The first commercial question on any cross-border store is who owns the stock
            in the bonded warehouse. That answer shapes the contract, the margin and how
            you book China revenue. We work in two models. Pick the one that fits how you
            want China on your books.
          </p>
        </header>

        <div class="cbs-tabs cbs-tabs--two cbs-reveal" data-tabs>
          <div class="cbs-tabs__nav" role="tablist">
            {models.map((m, i) => (
              <button
                type="button"
                class={`cbs-tabs__tab${i === 0 ? ' is-active' : ''}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`model-panel-${i}`}
                id={`model-tab-${i}`}
                data-tab-target={`model-panel-${i}`}
              >
                <span class="cbs-tabs__tab-label">{m.name}</span>
                <span class="cbs-tabs__tab-tag">{m.tag}</span>
                {m.highlight && <span class="cbs-tabs__tab-pop">Most common</span>}
              </button>
            ))}
            <span class="cbs-tabs__indicator" aria-hidden="true"></span>
          </div>

          <div class="cbs-tabs__panels">
            {models.map((m, i) => (
              <div
                class={`cbs-tabs__panel${i === 0 ? ' is-active' : ''}`}
                role="tabpanel"
                id={`model-panel-${i}`}
                aria-labelledby={`model-tab-${i}`}
                hidden={i !== 0}
              >
                <div class="cbs-tabs__panel-grid cbs-tabs__panel-grid--with-image">
                  <div class="cbs-tabs__lead">
                    <span class="cbs-tabs__pillset">
                      <span class="cbs-tabs__pill">{m.tag}</span>
                    </span>
                    <h3 class="cbs-tabs__title">{m.name}</h3>
                    <p class="cbs-tabs__desc">{m.desc}</p>
                    <div class="cbs-tabs__when">
                      <span class="cbs-tabs__when-label">Best when</span>
                      <p>{m.when}</p>
                    </div>

                    <div class="cbs-owns">
                      <span class="cbs-owns__label">Who owns what</span>
                      <ul class="cbs-owns__list">
                        {m.owns.map((o) => (
                          <li>
                            <span class="cbs-owns__key">{o.label}</span>
                            <span class="cbs-owns__val">{o.value}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <a href="/contact" class="btn btn--primary cbs-magnetic">Talk about the {m.name}</a>
                  </div>

                  <div class="cbs-tabs__body">
                    <figure class="cbs-tabs__image">
                      <img src={m.image} alt={m.imageAlt} loading="lazy" decoding="async" />
                    </figure>

                    <div class="cbs-tabs__list-wrap">
                      <span class="cbs-tabs__list-label">You receive</span>
                      <ul class="cbs-tabs__list">
                        {m.yourSide.map((b) => (
                          <li>
                            <span class="cbs-tabs__check" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8"/></svg>
                            </span>
                            <span>{b}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="cbs-tabs__list-wrap cbs-tabs__list-wrap--alt">
                      <span class="cbs-tabs__list-label">We handle</span>
                      <ul class="cbs-tabs__list">
                        {m.ourSide.map((b) => (
                          <li>
                            <span class="cbs-tabs__check cbs-tabs__check--alt" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8"/></svg>
                            </span>
                            <span>{b}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* ---------- HOW TO PICK: Comparison Table ---------- */}
        <div class="cbs-compare cbs-reveal">
          <div class="cbs-compare__intro">
            <span class="eyebrow">How to pick</span>
            <h3>One question, two answers</h3>
            <p>Do you want to own the customer relationship in China, or do you want a clean wholesale exit? That is what decides the model.</p>
          </div>
          <div class="cbs-compare__table-wrap">
            <table class="cbs-compare__table">
              <thead>
                <tr>
                  <th scope="col" class="cbs-compare__row-head-col"></th>
                  <th scope="col" class="cbs-compare__head cbs-compare__head--tp">
                    <span class="cbs-compare__head-label">TP model</span>
                    <span class="cbs-compare__head-sub">You own the inventory</span>
                  </th>
                  <th scope="col" class="cbs-compare__head cbs-compare__head--dist">
                    <span class="cbs-compare__head-label">Distributor model</span>
                    <span class="cbs-compare__head-sub">We own the inventory</span>
                  </th>
                </tr>
              </thead>
              <tbody>
                {compareRows.map((r) => (
                  <tr>
                    <th scope="row" class="cbs-compare__row-label">{r.label}</th>
                    <td class="cbs-compare__cell cbs-compare__cell--tp">{r.tp}</td>
                    <td class="cbs-compare__cell cbs-compare__cell--dist">{r.dist}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="cbs-compare__note">
            The model that fits depends on two things: how big you want China to be in
            your global revenue, and how much cash flow you can put behind that ambition.
            Brands with high ambition and the working capital to fund inventory and media
            usually pick TP. Brands wanting steady China revenue without tying up cash
            usually pick distributor. Some brands run both in parallel across different
            categories. None of this is a maturity ladder.
          </p>
        </div>
      </div>
    </section>

    {/* ---------- CATEGORY NOTE ---------- */}
    <section class="section">
      <div class="container">
        <div class="cbs-value">
          <div class="cbs-value__copy">
            <span class="eyebrow">Category matters</span>
            <h2>One country, ten playbooks</h2>
            <p>
              Beauty needs RED seeding plus a Tmall Global flagship. Supplements run on
              JD Worldwide. Premium F&B wins on Douyin livestream. Electronics belong on
              JD. Each category has its own platform logic.
            </p>
            <p>
              Which model fits depends on what you sell. The cross-border platforms do
              not reward one playbook.
            </p>
          </div>

          <ul class="cbs-promise">
            <li>
              <span class="eyebrow">Where each category lands</span>
            </li>
            <li class="cbs-cat-row"><span class="cbs-cat-row__cat">Beauty</span><span class="cbs-cat-row__home">RED seeding + Tmall Global flagship</span></li>
            <li class="cbs-cat-row"><span class="cbs-cat-row__cat">Supplements</span><span class="cbs-cat-row__home">JD Worldwide for trust signal</span></li>
            <li class="cbs-cat-row"><span class="cbs-cat-row__cat">Premium F&B</span><span class="cbs-cat-row__home">Douyin EC Global livestream</span></li>
            <li class="cbs-cat-row"><span class="cbs-cat-row__cat">Fashion</span><span class="cbs-cat-row__home">Tmall Global + RED influence</span></li>
            <li class="cbs-cat-row"><span class="cbs-cat-row__cat">Electronics</span><span class="cbs-cat-row__home">JD Worldwide</span></li>
            <li class="cbs-cat-row"><span class="cbs-cat-row__cat">Pet, home, lifestyle</span><span class="cbs-cat-row__home">Platform mix per category</span></li>
          </ul>
        </div>
      </div>
    </section>

    {/* ---------- COST ---------- */}
    <section class="section section--alt cbs-cost-section">
      <div class="cbs-cost-section__bg" aria-hidden="true">
        <div class="cbs-cost-section__grid"></div>
        <div class="cbs-cost-section__glow cbs-cost-section__glow--a"></div>
        <div class="cbs-cost-section__glow cbs-cost-section__glow--b"></div>
      </div>
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">What it costs</span>
          <h2>The three lines that hit your P&L</h2>
          <p class="section-header__lead">
            Agency, platform, brand. Every cross-border P&L lives on those three lines. We
            put real numbers behind all three before you sign anything.
          </p>
        </header>

        <div class="cbs-cost cbs-reveal" data-cost>
          <div class="cbs-cost__switcher" role="tablist" aria-label="Engagement model">
            <span class="cbs-cost__switcher-pill" data-cost-pill aria-hidden="true"></span>
            <button
              type="button"
              role="tab"
              class="cbs-cost__switcher-tab is-active"
              data-cost-tab="tp"
              aria-selected="true"
            >
              <span class="cbs-cost__switcher-dot" aria-hidden="true"></span>
              <span class="cbs-cost__switcher-label">{costLedger.tp.label}</span>
              <span class="cbs-cost__switcher-sub">{costLedger.tp.sub}</span>
            </button>
            <button
              type="button"
              role="tab"
              class="cbs-cost__switcher-tab"
              data-cost-tab="distributor"
              aria-selected="false"
            >
              <span class="cbs-cost__switcher-dot" aria-hidden="true"></span>
              <span class="cbs-cost__switcher-label">{costLedger.distributor.label}</span>
              <span class="cbs-cost__switcher-sub">{costLedger.distributor.sub}</span>
            </button>
          </div>

          <div class="cbs-cost__grid">
            {/* AGENCY CARD */}
            <article class="cbs-ledger cbs-ledger--agency" data-tilt data-cost-card="agency">
              <div class="cbs-ledger__sheen" aria-hidden="true"></div>
              <span class="cbs-ledger__corner" aria-hidden="true"></span>
              <header class="cbs-ledger__top">
                <span class="cbs-ledger__icon" aria-hidden="true" set:html={icons.wallet} />
                <span class="cbs-ledger__tag" data-cost-field="agency.tag">
                  {costLedger.tp.agency.tag}
                </span>
              </header>
              <h3 class="cbs-ledger__title">What you pay us</h3>
              <div class="cbs-ledger__headline" data-cost-field="agency.headline">
                <span class="cbs-ledger__lead">{costLedger.tp.agency.headlineLead}</span>
                <span class="cbs-ledger__prefix">{costLedger.tp.agency.headlinePrefix}</span>
                <span
                  class="cbs-ledger__num"
                  data-counter={costLedger.tp.agency.headlineNum}
                  data-counter-format="comma"
                >0</span>
                <span class="cbs-ledger__suffix">{costLedger.tp.agency.headlineSuffix}</span>
              </div>
              <p class="cbs-ledger__unit" data-cost-field="agency.unit">{costLedger.tp.agency.headlineUnit}</p>
              <span class="cbs-ledger__pill" data-cost-field="agency.pill">{costLedger.tp.agency.pill}</span>
              <p class="cbs-ledger__body" data-cost-field="agency.body">{costLedger.tp.agency.body}</p>
              <footer class="cbs-ledger__foot">
                <span class="cbs-ledger__foot-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v6"/><circle cx="12" cy="16.5" r="0.6" fill="currentColor"/></svg>
                </span>
                <p data-cost-field="agency.footer">{costLedger.tp.agency.footer}</p>
              </footer>
            </article>

            {/* PLATFORM CARD (universal) */}
            <article class="cbs-ledger cbs-ledger--platform" data-tilt>
              <div class="cbs-ledger__sheen" aria-hidden="true"></div>
              <span class="cbs-ledger__corner" aria-hidden="true"></span>
              <header class="cbs-ledger__top">
                <span class="cbs-ledger__icon" aria-hidden="true" set:html={icons['platform-fee']} />
                <span class="cbs-ledger__tag cbs-ledger__tag--universal">
                  {platformLedger.tag}
                  <span class="cbs-ledger__tag-dot" aria-hidden="true"></span>
                  Universal
                </span>
              </header>
              <h3 class="cbs-ledger__title">What you pay the platforms</h3>
              <div class="cbs-ledger__headline">
                <span class="cbs-ledger__prefix">{platformLedger.headlinePrefix}</span>
                <span
                  class="cbs-ledger__num"
                  data-counter={platformLedger.headlineNum}
                >0</span>
                <span class="cbs-ledger__suffix">{platformLedger.headlineSuffix}</span>
              </div>
              <p class="cbs-ledger__unit">{platformLedger.headlineUnit}</p>
              <span class="cbs-ledger__pill">{platformLedger.pill}</span>
              <p class="cbs-ledger__body">{platformLedger.body}</p>
              <ul class="cbs-ledger__buckets">
                {platformLedger.buckets.map((b) => (
                  <li class="cbs-bucket" style={`--meter: ${b.meterPct}%;`}>
                    <div class="cbs-bucket__row">
                      <span class="cbs-bucket__title">{b.title}</span>
                      <span class="cbs-bucket__chip">{b.meter}</span>
                    </div>
                    <p class="cbs-bucket__sub">{b.sub}</p>
                    <span class="cbs-bucket__meter" aria-hidden="true">
                      <span class="cbs-bucket__meter-fill"></span>
                    </span>
                  </li>
                ))}
              </ul>
              <footer class="cbs-ledger__foot">
                <span class="cbs-ledger__foot-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
                </span>
                <p>{platformLedger.footer}</p>
              </footer>
            </article>

            {/* BRAND CARD */}
            <article class="cbs-ledger cbs-ledger--brand" data-tilt data-cost-card="brand">
              <div class="cbs-ledger__sheen" aria-hidden="true"></div>
              <span class="cbs-ledger__corner" aria-hidden="true"></span>
              <header class="cbs-ledger__top">
                <span class="cbs-ledger__icon" aria-hidden="true" set:html={icons.megaphone} />
                <span class="cbs-ledger__tag" data-cost-field="brand.tag">
                  {costLedger.tp.brand.tag}
                </span>
              </header>
              <h3 class="cbs-ledger__title">What you put behind the brand</h3>
              <div class="cbs-ledger__headline" data-cost-field="brand.headline">
                <span class="cbs-ledger__prefix">{costLedger.tp.brand.headlinePrefix}</span>
                <span
                  class="cbs-ledger__num"
                  data-counter={costLedger.tp.brand.headlineNum}
                >0</span>
                <span class="cbs-ledger__suffix">{costLedger.tp.brand.headlineSuffix}</span>
              </div>
              <p class="cbs-ledger__unit" data-cost-field="brand.unit">{costLedger.tp.brand.headlineUnit}</p>
              <span class="cbs-ledger__pill" data-cost-field="brand.pill">{costLedger.tp.brand.pill}</span>
              <p class="cbs-ledger__body" data-cost-field="brand.body">{costLedger.tp.brand.body}</p>
              <footer class="cbs-ledger__foot">
                <span class="cbs-ledger__foot-mark" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14l4-8 4 6 4-4 4 7"/><path d="M3 19h18"/></svg>
                </span>
                <p data-cost-field="brand.footer">{costLedger.tp.brand.footer}</p>
              </footer>
            </article>
          </div>

          <div
            class="cbs-cost__data"
            data-cost-data
            data-tp={JSON.stringify(costLedger.tp)}
            data-distributor={JSON.stringify(costLedger.distributor)}
          ></div>
        </div>

        <div class="cbs-pledge cbs-reveal">
          <div class="cbs-pledge__mark" aria-hidden="true">
            <svg viewBox="0 0 32 24" fill="currentColor"><path d="M8 0H0v12c0 6.6 5.4 12 12 12V20c-2.2 0-4-1.8-4-4v-4h4V0H8zm20 0h-8v12c0 6.6 5.4 12 12 12V20c-2.2 0-4-1.8-4-4v-4h4V0h-4z"/></svg>
          </div>
          <p class="cbs-pledge__line">
            Your margin stays your margin. We are paid by you on TP, by the retail price on distributor.
          </p>
          <ul class="cbs-pledge__never" aria-label="What we will never accept">
            <li>
              <span class="cbs-pledge__x" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6l-12 12"/></svg>
              </span>
              <span>Alimama kickbacks</span>
