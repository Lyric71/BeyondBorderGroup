      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .cbs-tabs__lead { display: flex; flex-direction: column; gap: var(--space-4); }
    .cbs-tabs__pillset { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .cbs-tabs__pill {
      font-size: 0.78rem; font-weight: 600;
      padding: 0.35em 0.85em;
      border-radius: 999px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      letter-spacing: 0.01em;
    }
    .cbs-tabs__title {
      font-size: clamp(1.625rem, 1.8vw + 1rem, 2.25rem);
      line-height: 1.1; margin: 0;
      letter-spacing: -0.015em;
    }
    .cbs-tabs__desc {
      font-size: 1rem; line-height: 1.6;
      color: var(--bbg-text); margin: 0;
    }
    .cbs-tabs__when {
      padding: var(--space-4);
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--bbg-blue);
    }
    .cbs-tabs__when-label {
      display: block;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.35rem;
    }
    .cbs-tabs__when p { margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--bbg-text); }
    .cbs-tabs__body { display: flex; flex-direction: column; gap: var(--space-4); }
    .cbs-tabs__image {
      margin: 0;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: var(--radius-md);
      background: var(--bbg-border);
    }
    .cbs-tabs__image img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
    .cbs-tabs__list-wrap {
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .cbs-tabs__list-wrap--alt {
      background: var(--bbg-blue-light);
    }
    .cbs-tabs__list-label {
      display: block;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .cbs-tabs__list-wrap--alt .cbs-tabs__list-label { color: var(--bbg-blue-dark); }
    .cbs-tabs__list {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-tabs__list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 0.95rem; line-height: 1.5;
      color: var(--bbg-text);
    }
    .cbs-tabs__check {
      width: 22px; height: 22px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0; margin-top: 1px;
    }
    .cbs-tabs__check--alt {
      background: var(--bbg-white);
      color: var(--bbg-blue);
      box-shadow: inset 0 0 0 1.5px var(--bbg-blue);
    }
    .cbs-tabs__check svg { width: 12px; height: 12px; }

    .cbs-owns {
      padding: var(--space-4);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      background: var(--bbg-white);
    }
    .cbs-owns__label {
      display: block;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .cbs-owns__list {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column;
      gap: 0.6rem;
    }
    .cbs-owns__list li {
      display: grid;
      grid-template-columns: minmax(150px, auto) 1fr;
      gap: var(--space-4);
      align-items: baseline;
      padding-bottom: 0.6rem;
      border-bottom: 1px dashed var(--bbg-border);
      font-size: 0.9rem;
      line-height: 1.45;
    }
    .cbs-owns__list li:last-child { border-bottom: none; padding-bottom: 0; }
    .cbs-owns__key { color: var(--bbg-text-muted); font-weight: 600; }
    .cbs-owns__val { color: var(--bbg-ink); }

    @media (max-width: 1024px) {
      .cbs-tabs--two .cbs-tabs__nav { grid-template-columns: 1fr; }
      .cbs-tabs__tab { border-right: none; border-bottom: 1px solid var(--bbg-border); }
      .cbs-tabs--two .cbs-tabs__indicator { display: none; }
      .cbs-tabs__panel-grid { grid-template-columns: 1fr; }
    }

    /* ---------- COMPARISON TABLE ---------- */
    .cbs-compare {
      margin-top: var(--space-8);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: clamp(var(--space-5), 3vw + 1rem, var(--space-7));
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    }
    .cbs-compare__intro { text-align: center; margin-bottom: var(--space-6); }
    .cbs-compare__intro h3 {
      font-size: clamp(1.375rem, 1.2vw + 1rem, 1.75rem);
      margin: var(--space-2) 0 var(--space-3);
      letter-spacing: -0.01em;
    }
    .cbs-compare__intro p {
      color: var(--bbg-text);
      max-width: 60ch; margin: 0 auto;
      line-height: 1.6; font-size: 1rem;
    }
    .cbs-compare__table-wrap { overflow-x: auto; }
    .cbs-compare__table {
      width: 100%; border-collapse: separate;
      border-spacing: 0;
      min-width: 640px;
    }
    .cbs-compare__head {
      background: var(--bbg-surface);
      padding: var(--space-4);
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-compare__head--tp { border-bottom-color: var(--bbg-blue); }
    .cbs-compare__head--dist { border-bottom-color: var(--bbg-blue-dark); }
    .cbs-compare__head-label {
      display: block;
      font-size: 1rem; font-weight: 700;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-compare__head-sub {
      display: block;
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      margin-top: 0.25rem;
    }
    .cbs-compare__row-head-col {
      width: 38%;
      background: var(--bbg-surface);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-compare__row-label {
      text-align: left;
      padding: var(--space-4);
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--bbg-text-muted);
      letter-spacing: 0.01em;
      border-bottom: 1px solid var(--bbg-border);
      background: var(--bbg-white);
    }
    .cbs-compare__cell {
      padding: var(--space-4);
      font-size: 0.95rem;
      color: var(--bbg-ink);
      border-bottom: 1px solid var(--bbg-border);
      vertical-align: top;
    }
    .cbs-compare__cell--tp {
      background: rgba(200, 16, 46, 0.04);
    }
    .cbs-compare__cell--dist {
      background: var(--bbg-white);
    }
    .cbs-compare__table tbody tr:last-child .cbs-compare__row-label,
    .cbs-compare__table tbody tr:last-child .cbs-compare__cell {
      border-bottom: none;
    }
    .cbs-compare__note {
      margin: var(--space-5) auto 0;
      max-width: 70ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 0.975rem;
    }

    /* ---------- COST SECTION (ledger redesign) ---------- */
    .cbs-cost-section {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    .cbs-cost-section__bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      overflow: hidden;
    }
    .cbs-cost-section__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(200, 16, 46, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(200, 16, 46, 0.07) 1px, transparent 1px);
      background-size: 48px 48px;
      background-position: center;
      mask-image: radial-gradient(ellipse 70% 60% at center, #000 25%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at center, #000 25%, transparent 75%);
    }
    .cbs-cost-section__glow {
      position: absolute;
      width: 520px; height: 520px;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.55;
    }
    .cbs-cost-section__glow--a {
      top: -120px; left: -100px;
      background: radial-gradient(circle, rgba(200, 16, 46, 0.22) 0%, transparent 70%);
    }
    .cbs-cost-section__glow--b {
      bottom: -150px; right: -120px;
      background: radial-gradient(circle, rgba(91, 194, 240, 0.18) 0%, transparent 70%);
    }

    .cbs-cost {
      position: relative;
    }

    /* Model switcher */
    .cbs-cost__switcher {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      max-width: 720px;
      margin: 0 auto var(--space-6);
      padding: 6px;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(200, 16, 46, 0.16);
      border-radius: 999px;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 18px 40px -28px rgba(200, 16, 46, 0.35);
    }
    .cbs-cost__switcher-pill {
      position: absolute;
      top: 6px; left: 6px;
      width: calc(50% - 6px);
      height: calc(100% - 12px);
      border-radius: 999px;
      background: linear-gradient(135deg, var(--bbg-blue) 0%, #A50C26 100%);
      box-shadow:
        0 6px 18px -8px rgba(200, 16, 46, 0.6),
        0 1px 0 rgba(255, 255, 255, 0.3) inset;
      transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 0;
    }
    .cbs-cost__switcher[data-active="distributor"] .cbs-cost__switcher-pill {
      transform: translateX(100%);
    }
    .cbs-cost__switcher-tab {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 2px;
      align-items: center;
      justify-content: center;
      padding: 14px 18px;
      background: none;
      border: 0;
      cursor: pointer;
      color: var(--bbg-text);
      transition: color 280ms ease;
      font-family: inherit;
    }
    .cbs-cost__switcher-tab.is-active {
      color: #fff;
    }
    .cbs-cost__switcher-dot {
      display: none;
    }
    .cbs-cost__switcher-label {
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: -0.005em;
    }
    .cbs-cost__switcher-sub {
      font-size: 0.78rem;
      opacity: 0.78;
      font-weight: 500;
    }
    .cbs-cost__switcher-tab:focus-visible {
      outline: 2px solid var(--bbg-blue);
      outline-offset: 4px;
      border-radius: 999px;
    }

    /* Grid */
    .cbs-cost__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
      perspective: 1400px;
    }
    .cbs-cost__data { display: none; }

    /* Ledger card */
    .cbs-ledger {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      padding: 28px 28px 24px;
      background:
        linear-gradient(180deg, #ffffff 0%, #fafdff 100%);
      border: 1px solid rgba(200, 16, 46, 0.18);
      border-radius: 22px;
      overflow: hidden;
      isolation: isolate;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 24px 48px -34px rgba(15, 50, 85, 0.18),
        0 6px 16px -10px rgba(200, 16, 46, 0.10);
      transform-style: preserve-3d;
      transform:
        perspective(1200px)
        rotateX(var(--rx, 0deg))
        rotateY(var(--ry, 0deg))
        translateY(var(--lift, 0px));
      transition:
        transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 320ms ease;
    }
    .cbs-ledger::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #E84A60 50%, var(--bbg-blue) 100%);
      background-size: 200% 100%;
      animation: cbs-stripe 6s linear infinite;
      transform-origin: left;
      transform: scaleX(0.45);
      transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-stripe {
      from { background-position: 0% 0; }
      to { background-position: 200% 0; }
    }
    .cbs-ledger:hover {
      --lift: -6px;
      border-color: rgba(200, 16, 46, 0.45);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 40px 64px -36px rgba(15, 50, 85, 0.28),
        0 10px 24px -12px rgba(200, 16, 46, 0.28);
    }
    .cbs-ledger:hover::before {
      transform: scaleX(1);
    }
    .cbs-ledger__sheen {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(
          240px circle at var(--mx, 50%) var(--my, 0%),
          rgba(200, 16, 46, 0.12) 0%,
          transparent 60%
        );
      opacity: 0;
      transition: opacity 320ms ease;
      z-index: 0;
    }
    .cbs-ledger[data-tilt-active] .cbs-ledger__sheen {
      opacity: 1;
    }
    .cbs-ledger__corner {
      position: absolute;
      top: 14px; right: 14px;
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--bbg-blue);
      box-shadow:
        0 0 0 4px rgba(200, 16, 46, 0.14),
        0 0 14px rgba(200, 16, 46, 0.4);
    }
    .cbs-ledger > * { position: relative; z-index: 1; }

    .cbs-ledger__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 0.25rem;
    }
    .cbs-ledger__icon {
      display: inline-flex;
      width: 44px; height: 44px;
      align-items: center; justify-content: center;
      border-radius: 14px;
      background:
        linear-gradient(135deg, rgba(232, 244, 252, 0.95) 0%, rgba(200, 16, 46, 0.18) 100%);
      color: var(--bbg-blue);
      box-shadow: 0 4px 12px -6px rgba(200, 16, 46, 0.45);
    }
    .cbs-ledger__icon svg { width: 20px; height: 20px; }
    .cbs-ledger__tag {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 5px 11px;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: rgba(232, 244, 252, 0.85);
      border: 1px solid rgba(200, 16, 46, 0.22);
      border-radius: 999px;
    }
    .cbs-ledger__tag--universal {
      color: #1f6f4a;
      background: rgba(220, 245, 232, 0.9);
      border-color: rgba(38, 165, 110, 0.25);
    }
    .cbs-ledger__tag-dot {
      display: inline-block;
      width: 4px; height: 4px; border-radius: 50%;
      background: currentColor;
      opacity: 0.65;
    }
    .cbs-ledger__title {
      font-size: 1.05rem;
      line-height: 1.25;
      letter-spacing: -0.01em;
      color: var(--bbg-text-muted);
      font-weight: 600;
      margin: 0;
    }
    .cbs-ledger__headline {
      display: flex;
      align-items: baseline;
      gap: 2px;
      font-size: clamp(2.4rem, 4.6vw, 3.2rem);
      line-height: 1;
      font-weight: 700;
      letter-spacing: -0.025em;
      color: var(--bbg-ink);
      font-variant-numeric: tabular-nums;
      margin: 2px 0 0;
    }
    .cbs-ledger__headline--text {
      letter-spacing: -0.015em;
    }
    .cbs-ledger__lead {
      display: inline-flex;
      align-items: center;
      font-size: 0.32em;
      font-weight: 700;
      color: var(--bbg-text-muted);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-right: 8px;
      padding: 4px 8px;
      background: rgba(200, 16, 46, 0.10);
      border-radius: 6px;
      align-self: center;
      transform: translateY(-4px);
    }
    .cbs-ledger__lead:empty { display: none; }
    .cbs-ledger__prefix,
    .cbs-ledger__suffix {
      font-size: 0.65em;
      font-weight: 700;
      color: var(--bbg-blue);
      letter-spacing: -0.01em;
    }
    .cbs-ledger__num {
      display: inline-block;
      transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-ledger__num.is-flashing {
      animation: cbs-num-flash 480ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-num-flash {
      0% { transform: translateY(8px); opacity: 0; }
      100% { transform: translateY(0); opacity: 1; }
    }
    .cbs-ledger__unit {
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--bbg-text-muted);
      margin: 4px 0 0;
    }
    .cbs-ledger__pill {
      display: inline-flex;
      align-self: flex-start;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--bbg-ink);
      background: linear-gradient(180deg, #fff 0%, #f1f7fc 100%);
      border: 1px solid rgba(200, 16, 46, 0.22);
      border-radius: 8px;
      margin-top: 6px;
      box-shadow: 0 2px 6px -4px rgba(200, 16, 46, 0.35);
    }
    .cbs-ledger__pill::before {
      content: "";
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--bbg-blue);
      box-shadow: 0 0 8px rgba(200, 16, 46, 0.6);
    }
    .cbs-ledger__body {
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 6px 0 0;
    }

    /* Platform card buckets */
    .cbs-ledger__buckets {
      list-style: none; margin: 8px 0 0; padding: 0;
      display: flex; flex-direction: column;
      gap: 12px;
      padding-top: 14px;
      border-top: 1px dashed rgba(200, 16, 46, 0.22);
    }
    .cbs-bucket {
      display: flex; flex-direction: column;
      gap: 4px;
    }
    .cbs-bucket__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .cbs-bucket__title {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--bbg-ink);
    }
    .cbs-bucket__chip {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--bbg-blue);
      padding: 2px 8px;
      background: rgba(232, 244, 252, 0.7);
      border-radius: 6px;
    }
    .cbs-bucket__sub {
      font-size: 0.82rem;
      line-height: 1.5;
      color: var(--bbg-text-muted);
      margin: 0;
    }
    .cbs-bucket__meter {
      display: block;
      position: relative;
      height: 4px;
      background: rgba(200, 16, 46, 0.12);
      border-radius: 4px;
      overflow: hidden;
      margin-top: 4px;
    }
    .cbs-bucket__meter-fill {
      display: block;
      position: absolute;
      inset: 0;
      width: 0;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #E84A60 100%);
      border-radius: 4px;
      transition: width 1100ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-ledger.is-in .cbs-bucket__meter-fill {
      width: var(--meter, 50%);
    }

    .cbs-ledger__foot {
      display: grid;
      grid-template-columns: 22px 1fr;
      gap: 10px;
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px dashed rgba(15, 50, 85, 0.08);
    }
    .cbs-ledger__foot-mark {
      display: inline-flex;
      align-items: center; justify-content: center;
      width: 22px; height: 22px;
      color: var(--bbg-blue);
      opacity: 0.85;
    }
    .cbs-ledger__foot svg { width: 14px; height: 14px; }
    .cbs-ledger__foot p {
      margin: 0;
      font-size: 0.82rem;
      line-height: 1.55;
      color: var(--bbg-text-muted);
    }

    /* Variant accents */
    .cbs-ledger--platform {
      background:
        linear-gradient(180deg, #fbfffd 0%, #f3fbf7 100%);
      border-color: rgba(38, 165, 110, 0.22);
    }
    .cbs-ledger--platform::before {
      background: linear-gradient(90deg, #2EA56C 0%, #6FD7A6 50%, #2EA56C 100%);
      background-size: 200% 100%;
    }
    .cbs-ledger--platform .cbs-ledger__corner {
      background: #2EA56C;
      box-shadow:
        0 0 0 4px rgba(46, 165, 108, 0.14),
        0 0 14px rgba(46, 165, 108, 0.4);
    }
    .cbs-ledger--platform .cbs-ledger__icon {
      background: linear-gradient(135deg, rgba(220, 245, 232, 0.95) 0%, rgba(46, 165, 108, 0.2) 100%);
      color: #1f6f4a;
      box-shadow: 0 4px 12px -6px rgba(46, 165, 108, 0.45);
    }
    .cbs-ledger--platform .cbs-ledger__prefix,
    .cbs-ledger--platform .cbs-ledger__suffix {
      color: #1f6f4a;
    }
    .cbs-ledger--platform .cbs-bucket__chip {
      color: #1f6f4a;
      background: rgba(220, 245, 232, 0.75);
    }
    .cbs-ledger--platform .cbs-bucket__meter-fill {
      background: linear-gradient(90deg, #2EA56C 0%, #6FD7A6 100%);
    }
    .cbs-ledger--platform .cbs-ledger__pill {
      border-color: rgba(46, 165, 108, 0.28);
    }
    .cbs-ledger--platform .cbs-ledger__pill::before {
      background: #2EA56C;
      box-shadow: 0 0 8px rgba(46, 165, 108, 0.5);
    }
    .cbs-ledger--platform:hover {
      border-color: rgba(46, 165, 108, 0.5);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 40px 64px -36px rgba(20, 60, 40, 0.28),
        0 10px 24px -12px rgba(46, 165, 108, 0.25);
    }
    .cbs-ledger--platform .cbs-ledger__sheen {
      background:
        radial-gradient(
          240px circle at var(--mx, 50%) var(--my, 0%),
          rgba(46, 165, 108, 0.14) 0%,
          transparent 60%
        );
    }
    .cbs-ledger--platform .cbs-ledger__foot-mark { color: #1f6f4a; }

    .cbs-ledger--brand {
      background:
        linear-gradient(180deg, #fefbff 0%, #faf4ff 100%);
      border-color: rgba(124, 86, 200, 0.22);
    }
    .cbs-ledger--brand::before {
      background: linear-gradient(90deg, #7C56C8 0%, #B89BE8 50%, #7C56C8 100%);
      background-size: 200% 100%;
    }
    .cbs-ledger--brand .cbs-ledger__corner {
      background: #7C56C8;
      box-shadow:
        0 0 0 4px rgba(124, 86, 200, 0.14),
        0 0 14px rgba(124, 86, 200, 0.4);
    }
    .cbs-ledger--brand .cbs-ledger__icon {
      background: linear-gradient(135deg, rgba(238, 230, 255, 0.95) 0%, rgba(124, 86, 200, 0.2) 100%);
      color: #5C3CA2;
      box-shadow: 0 4px 12px -6px rgba(124, 86, 200, 0.45);
    }
    .cbs-ledger--brand .cbs-ledger__tag {
      color: #5C3CA2;
      background: rgba(238, 230, 255, 0.85);
      border-color: rgba(124, 86, 200, 0.25);
    }
    .cbs-ledger--brand .cbs-ledger__prefix,
    .cbs-ledger--brand .cbs-ledger__suffix {
      color: #5C3CA2;
    }
    .cbs-ledger--brand .cbs-ledger__pill {
      border-color: rgba(124, 86, 200, 0.28);
    }
    .cbs-ledger--brand .cbs-ledger__pill::before {
      background: #7C56C8;
      box-shadow: 0 0 8px rgba(124, 86, 200, 0.5);
    }
    .cbs-ledger--brand:hover {
      border-color: rgba(124, 86, 200, 0.5);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 40px 64px -36px rgba(60, 30, 100, 0.28),
        0 10px 24px -12px rgba(124, 86, 200, 0.28);
    }
    .cbs-ledger--brand .cbs-ledger__sheen {
      background:
        radial-gradient(
          240px circle at var(--mx, 50%) var(--my, 0%),
          rgba(124, 86, 200, 0.13) 0%,
          transparent 60%
        );
    }
    .cbs-ledger--brand .cbs-ledger__foot-mark { color: #5C3CA2; }

    /* Pledge block */
    .cbs-pledge {
      position: relative;
      margin: calc(var(--space-6) + 12px) auto 0;
      max-width: 880px;
      padding: 32px 36px 28px;
      border-radius: 24px;
      background:
        radial-gradient(circle at 0% 0%, rgba(200, 16, 46, 0.22) 0%, transparent 55%),
        radial-gradient(circle at 100% 100%, rgba(91, 194, 240, 0.18) 0%, transparent 55%),
        linear-gradient(135deg, #0d2a3e 0%, #143955 60%, #1c4f74 100%);
      color: #fff;
      overflow: hidden;
      isolation: isolate;
      box-shadow:
        0 30px 70px -40px rgba(13, 42, 62, 0.7),
        0 1px 0 rgba(255, 255, 255, 0.06) inset;
    }
    .cbs-pledge::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
      background-size: 24px 24px;
      mask-image: radial-gradient(ellipse 80% 70% at 80% 30%, #000 30%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse 80% 70% at 80% 30%, #000 30%, transparent 80%);
      pointer-events: none;
      z-index: 0;
    }
    .cbs-pledge > * { position: relative; z-index: 1; }
    .cbs-pledge__mark {
      width: 38px; height: 28px;
      color: rgba(255, 255, 255, 0.32);
      margin-bottom: 10px;
    }
    .cbs-pledge__mark svg { width: 100%; height: 100%; }
    .cbs-pledge__line {
      margin: 0;
      font-size: clamp(1.15rem, 1.6vw, 1.5rem);
      line-height: 1.35;
      letter-spacing: -0.015em;
      font-weight: 600;
      color: #fff;
      max-width: 56ch;
    }
    .cbs-pledge__never {
      list-style: none;
      margin: 22px 0 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .cbs-pledge__never li {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      font-size: 0.85rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.95);
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 999px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .cbs-pledge__x {
      display: inline-flex;
      align-items: center; justify-content: center;
      width: 16px; height: 16px;
      color: #FF8B7A;
    }
    .cbs-pledge__x svg { width: 100%; height: 100%; }

    .cbs-cost-note {
      margin: var(--space-5) auto 0;
      max-width: 60ch;
      text-align: center;
      font-size: 0.95rem;
      color: var(--bbg-text-muted);
      line-height: 1.6;
    }

    /* Field-swap animation */
    .cbs-cost__grid.is-swapping [data-cost-field],
    .cbs-cost__grid.is-swapping .cbs-ledger__num {
      animation: cbs-field-swap 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-field-swap {
      0% { opacity: 0; transform: translateY(6px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 1024px) {
      .cbs-cost__grid { grid-template-columns: 1fr; gap: var(--space-4); }
      .cbs-cost__switcher { max-width: 100%; }
    }
    @media (max-width: 640px) {
      .cbs-cost__switcher-sub { display: none; }
      .cbs-pledge { padding: 26px 22px 22px; }
      .cbs-ledger { padding: 22px 22px 20px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .cbs-ledger { transform: none !important; transition: none; }
      .cbs-ledger__sheen { display: none; }
      .cbs-bucket__meter-fill { transition: none; }
      .cbs-cost__switcher-pill { transition: none; }
    }

    /* ---------- JOURNEY (vertical timeline) ---------- */
    .cbs-journey-section { position: relative; isolation: isolate; overflow: hidden; }
    .cbs-journey-section__bg {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: -2;
      opacity: 0.10;
      pointer-events: none;
    }
    .cbs-journey-section__bg::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, var(--bbg-white) 0%, rgba(255, 255, 255, 0.4) 40%, rgba(255, 255, 255, 0.7) 100%);
    }
    .cbs-journey-section__bg img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center;
      filter: saturate(0.55);
    }
    .cbs-journey {
      position: relative;
      max-width: 880px;
      margin: 0 auto;
      padding-left: 56px;
    }
    .cbs-journey__rail {
      position: absolute;
      top: 0; bottom: 0;
      left: 22px; width: 2px;
    }
    .cbs-journey__rail-track {
      position: absolute; inset: 0;
      background: var(--bbg-border);
      border-radius: 2px;
    }
    .cbs-journey__rail-fill {
      position: absolute;
      top: 0; left: 0; width: 100%;
      height: var(--journey-progress, 0%);
      background: linear-gradient(180deg, var(--bbg-blue) 0%, #E84A60 100%);
      border-radius: 2px;
      transition: height 120ms linear;
      box-shadow: 0 0 8px rgba(200, 16, 46, 0.4);
    }
    .cbs-journey__list {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column;
      gap: var(--space-7);
    }
    .cbs-journey__item { position: relative; }
    .cbs-journey__dot {
      position: absolute;
      left: -56px; top: 0;
      width: 44px; height: 44px;
      border-radius: 50%;
      background: var(--bbg-white);
      border: 2px solid var(--bbg-border);
      display: flex; align-items: center; justify-content: center;
      z-index: 2;
      transition: border-color 320ms ease;
    }
    .cbs-journey__dot-inner {
      width: 14px; height: 14px;
      border-radius: 50%;
      background: var(--bbg-border);
      transition: background 320ms ease, transform 320ms ease;
    }
    .cbs-journey__item.is-active .cbs-journey__dot { border-color: var(--bbg-blue); }
    .cbs-journey__item.is-active .cbs-journey__dot-inner {
      background: var(--bbg-blue);
      transform: scale(1.1);
      box-shadow: 0 0 0 4px var(--bbg-blue-light);
    }
    .cbs-journey__phase {
      display: inline-block;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-2);
      transition: color 320ms ease;
    }
    .cbs-journey__duration {
      font-weight: 500;
      color: var(--bbg-text-muted);
      letter-spacing: 0.04em;
      text-transform: none;
    }
    .cbs-journey__item.is-active .cbs-journey__phase { color: var(--bbg-blue); }
    .cbs-journey__card {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5) var(--space-6);
      display: flex; align-items: flex-start;
      gap: var(--space-4);
      transition: border-color 320ms ease, box-shadow 320ms ease, transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-journey__item:hover .cbs-journey__card,
    .cbs-journey__item.is-active .cbs-journey__card {
      border-color: var(--bbg-blue);
      box-shadow: 0 18px 38px -22px rgba(200, 16, 46, 0.4);
      transform: translateX(4px);
    }
    .cbs-journey__icon {
      display: inline-flex;
      width: 48px; height: 48px;
      align-items: center; justify-content: center;
      border-radius: 14px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      flex-shrink: 0;
    }
    .cbs-journey__icon svg { width: 24px; height: 24px; }
    .cbs-journey__title {
      font-size: 1.25rem; line-height: 1.25;
      margin: 0 0 0.4rem;
      letter-spacing: -0.005em;
    }
    .cbs-journey__desc {
      font-size: 0.95rem; line-height: 1.55;
      color: var(--bbg-text); margin: 0;
    }
    @media (max-width: 600px) {
      .cbs-journey { padding-left: 40px; }
      .cbs-journey__rail { left: 16px; }
      .cbs-journey__dot { left: -40px; width: 32px; height: 32px; }
      .cbs-journey__dot-inner { width: 10px; height: 10px; }
      .cbs-journey__card { flex-direction: column; gap: var(--space-3); }
    }

    /* ---------- SISTER PRODUCT ---------- */
    .cbs-sister {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-6);
      align-items: stretch;
    }
    .cbs-sister__hero {
      position: relative;
      padding: clamp(var(--space-6), 4vw, var(--space-8));
      background: linear-gradient(160deg, #1a0f1f 0%, #2a1530 60%, #401a45 100%);
      color: var(--bbg-white);
      border-radius: 24px;
      overflow: hidden;
      isolation: isolate;
      display: flex; flex-direction: column;
      gap: var(--space-4);
    }
    .cbs-sister__hero::before {
      content: "";
      position: absolute; inset: 0; z-index: -1;
      background:
        radial-gradient(60% 80% at 100% 0%, rgba(255, 90, 130, 0.25) 0%, transparent 60%),
        radial-gradient(40% 60% at 0% 100%, rgba(255, 60, 100, 0.18) 0%, transparent 60%);
    }
    .cbs-sister__chip {
      display: inline-block;
      align-self: flex-start;
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: #FFC2D1;
      background: rgba(255, 90, 130, 0.18);
      padding: 0.4em 0.85em;
      border-radius: 999px;
      border: 1px solid rgba(255, 194, 209, 0.3);
    }
    .cbs-sister__title {
      font-size: clamp(1.5rem, 1.6vw + 1rem, 2.125rem);
      line-height: 1.15;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-white);
    }
    .cbs-sister__desc {
      font-size: 1rem; line-height: 1.6;
      color: rgba(255, 255, 255, 0.82);
      margin: 0;
    }
    .cbs-sister__stats {
      list-style: none; padding: var(--space-4) 0 0;
      margin: 0;
      display: flex; flex-direction: column;
      gap: var(--space-3);
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }
    .cbs-sister__stats li {
      display: grid;
      grid-template-columns: minmax(96px, auto) 1fr;
      gap: var(--space-4);
      align-items: baseline;
    }
    .cbs-sister__stat-num {
      font-size: 1.25rem;
      font-weight: 700;
      color: #FFC2D1;
      letter-spacing: -0.01em;
      font-feature-settings: "tnum";
    }
    .cbs-sister__stat-label {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.5;
    }
    .cbs-sister__actions {
      display: flex; flex-wrap: wrap; gap: var(--space-3);
      margin-top: var(--space-3);
    }
    .cbs-sister__btn-primary {
      background: var(--bbg-white);
      color: #2a1530;
      border: 1px solid var(--bbg-white);
    }
    .cbs-sister__btn-primary:hover {
      background: #FFC2D1; color: #2a1530;
    }
    .cbs-sister__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: var(--bbg-white);
    }
    .cbs-sister__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }
    .cbs-sister__packs {
      display: flex; flex-direction: column;
      gap: var(--space-4);
    }
    .cbs-sister__pack {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      display: flex; flex-direction: column;
      gap: var(--space-2);
      transition: border-color 280ms ease, box-shadow 280ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-sister__pack:hover {
      transform: translateY(-3px);
      border-color: var(--bbg-blue);
      box-shadow: 0 14px 28px -18px rgba(200, 16, 46, 0.35);
    }
    .cbs-sister__pack-icon {
      display: inline-flex;
      width: 36px; height: 36px;
      align-items: center; justify-content: center;
      border-radius: 10px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      margin-bottom: 0.4rem;
    }
    .cbs-sister__pack-icon svg { width: 18px; height: 18px; }
    .cbs-sister__pack h4 {
      font-size: 1.0625rem;
      margin: 0;
      letter-spacing: -0.005em;
      color: var(--bbg-ink);
    }
    .cbs-sister__pack p {
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .cbs-sister { grid-template-columns: 1fr; }
    }

    /* ---------- FAQ ---------- */
    .cbs-faq {
      display: flex; flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-faq__item {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition: border-color 240ms ease, box-shadow 240ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-faq__item:hover {
      transform: translateX(2px);
      border-color: rgba(200, 16, 46, 0.4);
    }
    .cbs-faq__item[open] {
      border-color: var(--bbg-blue);
      box-shadow: 0 8px 22px -14px rgba(200, 16, 46, 0.4);
    }
    .cbs-faq__q {
      cursor: pointer;
      padding: var(--space-5);
      display: flex; align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      font-weight: 600;
      font-size: 1.0625rem; line-height: 1.3;
      color: var(--bbg-ink);
      list-style: none;
      transition: color var(--dur) var(--ease);
    }
    .cbs-faq__q::-webkit-details-marker { display: none; }
    .cbs-faq__q::marker { display: none; }
    .cbs-faq__item:hover .cbs-faq__q { color: var(--bbg-blue); }
    .cbs-faq__icon {
      flex-shrink: 0;
      width: 28px; height: 28px;
      display: inline-flex;
      align-items: center; justify-content: center;
      border-radius: 50%;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
                  color var(--dur) var(--ease),
                  background var(--dur) var(--ease);
    }
    .cbs-faq__item[open] .cbs-faq__icon {
      transform: rotate(180deg);
      color: var(--bbg-white);
      background: var(--bbg-blue);
    }
    .cbs-faq__a {
      padding: 0 var(--space-5) var(--space-5);
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
      animation: cbs-faq-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-faq-in {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .cbs-faq__a p { margin: 0; }

    /* ---------- FAQ FILTER ---------- */
    .cbs-faq-filter {
      display: flex; flex-wrap: wrap;
      gap: 0.5rem; justify-content: center;
      margin-bottom: var(--space-6);
    }
    .cbs-faq-chip {
      display: inline-flex; align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.95rem;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 999px;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--bbg-text);
      transition: all 220ms ease;
      font-family: inherit;
    }
    .cbs-faq-chip:hover { border-color: var(--bbg-blue); color: var(--bbg-blue); }
    .cbs-faq-chip.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }
    .cbs-faq-chip__count {
      font-size: 0.72rem; font-weight: 700;
      padding: 0.15em 0.5em;
      border-radius: 999px;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition: all 220ms ease;
    }
    .cbs-faq-chip:hover .cbs-faq-chip__count { background: var(--bbg-blue-light); color: var(--bbg-blue); }
    .cbs-faq-chip.is-active .cbs-faq-chip__count {
      background: rgba(255, 255, 255, 0.2);
      color: var(--bbg-white);
    }
    .cbs-faq__cat-tag {
      display: inline-block;
      font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 0.25em 0.6em;
      border-radius: 4px;
      margin-right: var(--space-3);
      flex-shrink: 0;
    }
    .cbs-faq__q-text { flex-grow: 1; }
    .cbs-faq__item.is-hidden { display: none; }

    /* ---------- FINAL CTA ---------- */
    .cbs-cta {
      padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8)) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
      color: var(--bbg-white);
      border-radius: var(--radius-lg);
      text-align: center;
      position: relative; overflow: hidden;
    }
    .cbs-cta::before {
      content: ""; position: absolute;
      top: -40%; right: -10%;
      width: 420px; height: 420px;
      background: radial-gradient(circle at center, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 65%);
      pointer-events: none;
    }
    .cbs-cta .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-4);
      color: rgba(255, 255, 255, 0.9);
    }
    .cbs-cta__title {
      font-size: clamp(1.75rem, 1.5vw + 1rem, 2.5rem);
      line-height: 1.15;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      letter-spacing: -0.015em;
    }
    .cbs-cta__lead {
      color: rgba(255, 255, 255, 0.92);
      font-size: 1.0625rem;
      max-width: 52ch;
      margin: 0 auto var(--space-5);
      line-height: 1.55;
    }
    .cbs-cta__actions {
      display: flex; flex-wrap: wrap;
      gap: var(--space-3);
      justify-content: center;
      position: relative;
    }
    .cbs-cta__btn-primary {
      background: var(--bbg-white);
      color: var(--bbg-blue-dark);
      border: 1px solid var(--bbg-white);
    }
    .cbs-cta__btn-primary:hover {
      background: rgba(255, 255, 255, 0.92);
      color: var(--bbg-blue-dark);
    }
    .cbs-cta__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: var(--bbg-white);
    }
    .cbs-cta__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }
  </style>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Reveal-on-scroll
      const revealEls = document.querySelectorAll('.cbs-reveal');
      if (revealEls.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          revealEls.forEach((el) => io.observe(el));
        }
      }

      // 2. Animated number counters
      const formatCounter = (n, format) => {
        if (format === 'comma' || n >= 1000) return n.toLocaleString('en-US');
        return String(n);
      };
      const counters = document.querySelectorAll('[data-counter]');
      if (counters.length && !reduced && 'IntersectionObserver' in window) {
        const animate = (el) => {
          const raw = el.dataset.counter;
          const target = parseFloat(raw);
          if (isNaN(target)) return;
          const suffix = el.dataset.suffix || '';
          const format = el.dataset.counterFormat || '';
          const duration = 1400;
          const start = performance.now();
          const tick = (now) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = Math.round(target * eased);
            el.textContent = formatCounter(value, format) + suffix;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const counterIo = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animate(entry.target);
              counterIo.unobserve(entry.target);
            }
          });
        }, { threshold: 0.5 });
        counters.forEach((el) => counterIo.observe(el));
      } else {
        counters.forEach((el) => {
          const raw = el.dataset.counter;
          const n = parseFloat(raw);
          if (isNaN(n)) return;
          el.textContent = formatCounter(n, el.dataset.counterFormat) + (el.dataset.suffix || '');
        });
      }

      // 3. Hero parallax + scroll progress bar
      const parallaxEl = document.querySelector('[data-parallax]');
      const progressEl = document.querySelector('.cbs-progress__bar');
      const heroEl = document.querySelector('[data-hero]');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;
          if (parallaxEl && heroEl && !reduced) {
            const heroH = heroEl.offsetHeight;
            if (scrollY < heroH) {
              parallaxEl.style.setProperty('--parallax-y', (scrollY * 0.18) + 'px');
            }
          }
          if (progressEl) {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
            progressEl.style.setProperty('--progress', pct + '%');
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // 4. Smooth scroll for anchors
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = link.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        });
      });

      // 5. FAQ accordion - close others on open
      const faqItems = document.querySelectorAll('.cbs-faq__item');
      faqItems.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (item.open) {
            faqItems.forEach((other) => {
              if (other !== item && other.open) other.open = false;
            });
          }
        });
      });

      // 6. Business model tabs
      const tabsRoot = document.querySelector('[data-tabs]');
      if (tabsRoot) {
        const tabs = Array.from(tabsRoot.querySelectorAll('.cbs-tabs__tab'));
        const panels = Array.from(tabsRoot.querySelectorAll('.cbs-tabs__panel'));
        const indicator = tabsRoot.querySelector('.cbs-tabs__indicator');

        const setActive = (tab) => {
          tabs.forEach((t) => {
            const active = t === tab;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          const targetId = tab.getAttribute('data-tab-target');
          panels.forEach((p) => {
            const active = p.id === targetId;
            p.classList.toggle('is-active', active);
            if (active) p.removeAttribute('hidden');
            else p.setAttribute('hidden', '');
          });
          if (indicator) {
            const idx = tabs.indexOf(tab);
            const w = 100 / tabs.length;
            indicator.style.width = w + '%';
            indicator.style.transform = `translateX(${idx * 100}%)`;
          }
        };

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => setActive(tab));
          tab.addEventListener('keydown', (e) => {
            const idx = tabs.indexOf(tab);
            if (e.key === 'ArrowRight') {
              e.preventDefault();
              const next = tabs[(idx + 1) % tabs.length];
              next.focus(); setActive(next);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
              prev.focus(); setActive(prev);
            }
          });
        });

        const initialActive = tabs.find((t) => t.classList.contains('is-active')) || tabs[0];
        if (initialActive) setActive(initialActive);
      }

      // 7. Journey vertical timeline scroll progress + active state
      const journey = document.querySelector('[data-journey]');
      if (journey) {
        const fill = journey.querySelector('[data-journey-fill]');
        const items = Array.from(journey.querySelectorAll('[data-journey-item]'));
        const updateJourney = () => {
          const rect = journey.getBoundingClientRect();
          const vh = window.innerHeight;
          const total = rect.height;
          const visible = Math.max(0, Math.min(total, vh * 0.55 - rect.top));
          const pct = Math.max(0, Math.min(100, (visible / total) * 100));
          if (fill) fill.style.setProperty('--journey-progress', pct + '%');
          items.forEach((item) => {
            const r = item.getBoundingClientRect();
            const center = r.top + r.height / 2;
            const inActive = center < vh * 0.6 && center > 0;
            item.classList.toggle('is-active', inActive);
          });
        };
        let journeyTicking = false;
        const onJourneyScroll = () => {
          if (journeyTicking) return;
          journeyTicking = true;
          requestAnimationFrame(() => {
            updateJourney();
            journeyTicking = false;
          });
        };
        window.addEventListener('scroll', onJourneyScroll, { passive: true });
        window.addEventListener('resize', onJourneyScroll, { passive: true });
        updateJourney();
      }

      // 7b. Two-truths: cursor tilt + scroll-driven image parallax
      const truths = document.querySelectorAll('[data-truth-tilt]');
      if (truths.length && !reduced) {
        truths.forEach((card) => {
          const onMove = (e) => {
            const rect = card.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width;
            const y = (e.clientY - rect.top) / rect.height;
            const ry = (x - 0.5) * 5;
            const rx = (0.5 - y) * 4;
            card.style.setProperty('--ry', ry.toFixed(2) + 'deg');
            card.style.setProperty('--rx', rx.toFixed(2) + 'deg');
            card.setAttribute('data-tilt-active', '');
          };
          const onLeave = () => {
            card.style.setProperty('--ry', '0deg');
            card.style.setProperty('--rx', '0deg');
            card.removeAttribute('data-tilt-active');
          };
          card.addEventListener('mousemove', onMove);
          card.addEventListener('mouseleave', onLeave);
        });

        const parallaxImgs = document.querySelectorAll('[data-truth-parallax]');
        let truthsTicking = false;
        const updateTruthParallax = () => {
          parallaxImgs.forEach((img) => {
            const frame = img.parentElement;
            if (!frame) return;
            const rect = frame.getBoundingClientRect();
            const vh = window.innerHeight;
            if (rect.bottom < 0 || rect.top > vh) return;
            const center = rect.top + rect.height / 2;
            const offset = (center - vh / 2) / vh;
            const shift = Math.max(-16, Math.min(16, -offset * 22));
            img.style.setProperty('--img-y', shift.toFixed(1) + 'px');
          });
        };
        const onTruthsScroll = () => {
          if (truthsTicking) return;
          truthsTicking = true;
          requestAnimationFrame(() => {
            updateTruthParallax();
            truthsTicking = false;
          });
        };
        window.addEventListener('scroll', onTruthsScroll, { passive: true });
        window.addEventListener('resize', onTruthsScroll, { passive: true });
        updateTruthParallax();
      }

      // 7c. Cost section: model switcher + 3D tilt + meter reveal
      const costRoot = document.querySelector('[data-cost]');
      if (costRoot) {
        const ledgerCards = Array.from(costRoot.querySelectorAll('[data-tilt]'));

        // 3D mouse tilt + radial sheen
        if (!reduced) {
          ledgerCards.forEach((card) => {
            const onMove = (e) => {
              const rect = card.getBoundingClientRect();
              const x = (e.clientX - rect.left) / rect.width;
              const y = (e.clientY - rect.top) / rect.height;
              card.style.setProperty('--ry', ((x - 0.5) * 6).toFixed(2) + 'deg');
              card.style.setProperty('--rx', ((0.5 - y) * 5).toFixed(2) + 'deg');
              card.style.setProperty('--mx', (x * 100).toFixed(1) + '%');
              card.style.setProperty('--my', (y * 100).toFixed(1) + '%');
              card.setAttribute('data-tilt-active', '');
            };
            const onLeave = () => {
              card.style.setProperty('--ry', '0deg');
              card.style.setProperty('--rx', '0deg');
              card.removeAttribute('data-tilt-active');
            };
            card.addEventListener('mousemove', onMove);
            card.addEventListener('mouseleave', onLeave);
          });
        }

        // Reveal cards (drives meter fill)
        if ('IntersectionObserver' in window) {
          const ledgerIo = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                ledgerIo.unobserve(entry.target);
              }
            });
          }, { threshold: 0.18 });
          ledgerCards.forEach((c) => ledgerIo.observe(c));
        } else {
          ledgerCards.forEach((c) => c.classList.add('is-in'));
        }

        // Model switcher
        const tabs = Array.from(costRoot.querySelectorAll('[data-cost-tab]'));
        const switcher = costRoot.querySelector('.cbs-cost__switcher');
        const dataEl = costRoot.querySelector('[data-cost-data]');
        const grid = costRoot.querySelector('.cbs-cost__grid');
        let dataTp = {}, dataDist = {};
        try {
          if (dataEl) {
            dataTp = JSON.parse(dataEl.getAttribute('data-tp') || '{}');
            dataDist = JSON.parse(dataEl.getAttribute('data-distributor') || '{}');
          }
        } catch (e) {}

        const animateNum = (el, target) => {
          const fromRaw = el.textContent.replace(/[^0-9-]/g, '');
          const from = parseFloat(fromRaw) || 0;
          if (reduced) {
            el.textContent = formatCounter(target, el.dataset.counterFormat);
            return;
          }
          const duration = 700;
          const start = performance.now();
          const tick = (now) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = Math.round(from + (target - from) * eased);
            el.textContent = formatCounter(value, el.dataset.counterFormat);
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };

        const applyModel = (model) => {
          if (!switcher) return;
          const dataset = model === 'tp' ? dataTp : dataDist;
          switcher.setAttribute('data-active', model);
          tabs.forEach((t) => {
            const active = t.getAttribute('data-cost-tab') === model;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });

          if (grid) {
            grid.classList.remove('is-swapping');
            // force reflow so animation re-runs
            void grid.offsetWidth;
            grid.classList.add('is-swapping');
          }

          ['agency', 'brand'].forEach((key) => {
            const card = costRoot.querySelector('[data-cost-card="' + key + '"]');
            if (!card || !dataset[key]) return;
            const cfg = dataset[key];

            const tagEl = card.querySelector('[data-cost-field="' + key + '.tag"]');
            const unitEl = card.querySelector('[data-cost-field="' + key + '.unit"]');
            const pillEl = card.querySelector('[data-cost-field="' + key + '.pill"]');
            const bodyEl = card.querySelector('[data-cost-field="' + key + '.body"]');
            const footerEl = card.querySelector('[data-cost-field="' + key + '.footer"]');
            const headlineEl = card.querySelector('[data-cost-field="' + key + '.headline"]');

            if (tagEl) tagEl.textContent = cfg.tag || '';
            if (unitEl) unitEl.textContent = cfg.headlineUnit || '';
            if (pillEl) pillEl.textContent = cfg.pill || '';
            if (bodyEl) bodyEl.textContent = cfg.body || '';
            if (footerEl) footerEl.textContent = cfg.footer || '';

            if (headlineEl) {
              const lead = headlineEl.querySelector('.cbs-ledger__lead');
              const prefix = headlineEl.querySelector('.cbs-ledger__prefix');
              const suffix = headlineEl.querySelector('.cbs-ledger__suffix');
              const num = headlineEl.querySelector('.cbs-ledger__num');
              const isNumeric = typeof cfg.headlineNum === 'number';

              if (lead) {
                const leadText = cfg.headlineLead || '';
                lead.textContent = leadText;
                lead.style.display = leadText ? '' : 'none';
              }

              if (isNumeric) {
                headlineEl.classList.remove('cbs-ledger__headline--text');
                if (prefix) prefix.textContent = cfg.headlinePrefix || '';
                if (suffix) suffix.textContent = cfg.headlineSuffix || '';
                if (num) {
                  num.dataset.counter = String(cfg.headlineNum);
                  animateNum(num, cfg.headlineNum);
                }
              } else {
                headlineEl.classList.add('cbs-ledger__headline--text');
                if (prefix) prefix.textContent = '';
                if (suffix) suffix.textContent = '';
                if (num) {
                  num.textContent = cfg.headlineText || '';
                  num.dataset.counter = '';
                }
              }
            }
          });
        };

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            applyModel(tab.getAttribute('data-cost-tab'));
          });
          tab.addEventListener('keydown', (e) => {
            const idx = tabs.indexOf(tab);
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
              e.preventDefault();
              const next = tabs[(idx + 1) % tabs.length];
              next.focus();
              applyModel(next.getAttribute('data-cost-tab'));
            } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
              e.preventDefault();
              const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
              prev.focus();
              applyModel(prev.getAttribute('data-cost-tab'));
            }
          });
        });
      }

      // 8. FAQ category filter
      const faqFilter = document.querySelector('[data-faq-filter]');
      const faqList = document.querySelector('[data-faq-list]');
      if (faqFilter && faqList) {
        const chips = Array.from(faqFilter.querySelectorAll('.cbs-faq-chip'));
        const items = Array.from(faqList.querySelectorAll('.cbs-faq__item'));
        chips.forEach((chip) => {
          chip.addEventListener('click', () => {
            const cat = chip.dataset.faqCat;
            chips.forEach((c) => {
              const on = c === chip;
              c.classList.toggle('is-active', on);
              c.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            items.forEach((item) => {
              const matches = cat === 'All' || item.dataset.faqCat === cat;
              item.classList.toggle('is-hidden', !matches);
            });
          });
        });
      }
    })();
  </script>
</Layout>
