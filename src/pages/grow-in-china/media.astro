<Layout
  title="Media Buying in China: WeChat, Douyin, RED & Baidu"
  description="Paid media in China across WeChat, Douyin, RED and Baidu, run by one senior team that owns the numbers. Start with a media audit."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} is:inline />

  <div class="cbs-progress" aria-hidden="true"><div class="cbs-progress__bar"></div></div>
  <article class="cbs">

    {/* ---------- HERO ---------- */}
    <section class="cbs-hero" data-hero>
      <div class="cbs-hero__bg" aria-hidden="true" data-parallax>
        <img src="/Images/grow-in-china/media/hero-media-buying.png" alt="A media buyer at a desk in a Shanghai office, late afternoon, two monitors showing Chinese ad-platform dashboards" />
      </div>
      <div class="cbs-hero__overlay" aria-hidden="true"></div>
      <div class="cbs-hero__grain" aria-hidden="true"></div>

      <div class="container cbs-hero__inner">
        <nav class="cbs-hero__crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/#services">Grow in China</a>
