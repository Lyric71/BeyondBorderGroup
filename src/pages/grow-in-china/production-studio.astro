---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Production Studio | hub Studio | TheChinaPath"
  description="hub Studio is the creative production house inside TheChinaPath. Concepts, real shoots, AIGC pipelines, all in-studio at tier-1 China cost."
>

  {/* ---------- HUB STUDIO HERO ---------- */}
  <section id="hub-studio" class="section hub-studio" data-hub-root>
    <div class="hub-studio__bg" aria-hidden="true">
      <div class="hub-studio__bg-image" data-parallax></div>
      <div class="hub-studio__bg-tint"></div>
      <div class="hub-studio__bg-vignette"></div>
    </div>

    <div class="container hub-studio__inner">

      {/* Editorial opener */}
      <div class="hub-editorial" data-reveal>
        <div class="hub-editorial__text">
          <span class="eyebrow eyebrow--on-dark"><span class="eyebrow__bar" aria-hidden="true"></span>A TheChinaPath studio</span>
          <h1 class="hub-editorial__title">
            The creative engine
            <span class="hub-editorial__title-emph">behind the work.</span>
          </h1>
          <p class="lead hub-editorial__lead">
            Across the group, every campaign that hits a Chinese screen runs through
            hub Studio. Art directors, copywriters, photographers, designers and AIGC
            engineers under one Shanghai roof.
          </p>
          <ul class="hub-editorial__list">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6"/></svg>
              <span>Same senior team, from concept to shoot.</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6"/></svg>
              <span>Native to Chinese platforms, from Tmall to Xiaohongshu.</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6"/></svg>
              <span>A human curates every output before it ships.</span>
            </li>
          </ul>
          <div class="hub-editorial__actions">
            <a class="hub-editorial__cta" href="https://hubstudio.ai" target="_blank" rel="noopener noreferrer">
              <span>Brief the studio</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <span class="hub-editorial__meta">hub Studio · Shanghai</span>
          </div>
        </div>

        <aside class="hub-editorial__aside" aria-label="hub Studio at a glance">
          <span class="hub-editorial__index" aria-hidden="true">Studio</span>
          <div class="hub-editorial__logo" data-tilt>
            <img
              src="/Images/hubStudio.png"
              alt="hub Studio"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="hub-editorial__rule" aria-hidden="true"></div>
          <div class="hub-editorial__stat">
            <span class="hub-editorial__stat-label">Production cost</span>
            <div class="hub-editorial__stat-value">
              <span class="hub-editorial__stat-prefix">~</span>
              <span class="hub-editorial__stat-num" data-counter data-target="25">
                <span class="proof-metric__num">25</span>
              </span>
              <span class="hub-editorial__stat-unit">%</span>
            </div>
            <p class="hub-editorial__stat-note">
              of EU or US pricing. China shoots and AIGC pipelines, tier-1 quality.
            </p>
          </div>
        </aside>
      </div>

      {/* Tabbed pillar showcase */}
      <div class="hub-tabs" data-tabs data-reveal>
        <div class="hub-tabs__header">
          <span class="eyebrow eyebrow--on-dark">Three disciplines, one studio</span>
          <h2 class="hub-tabs__heading">How the studio splits the work.</h2>
        </div>

        <div class="hub-tabs__layout">
          <div class="hub-tabs__nav" role="tablist" aria-label="hub Studio disciplines">
            <button class="hub-tab is-active" role="tab" aria-selected="true" data-tab="creative" type="button">
              <span class="hub-tab__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 3.5l6 6L9 21H3v-6z"/><path d="M11.5 6.5l6 6"/></svg>
              </span>
              <span class="hub-tab__body">
                <span class="hub-tab__title">Creative</span>
                <span class="hub-tab__desc">Concepts and key visuals built per platform.</span>
              </span>
              <span class="hub-tab__chev" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
              </span>
            </button>

            <button class="hub-tab" role="tab" aria-selected="false" data-tab="production" type="button">
              <span class="hub-tab__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h3l2-3h8l2 3h3v12H3z"/><circle cx="12" cy="13" r="4"/></svg>
              </span>
              <span class="hub-tab__body">
                <span class="hub-tab__title">Production</span>
                <span class="hub-tab__desc">Real shoots, real crews, in tier-1 cities.</span>
              </span>
              <span class="hub-tab__chev" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
              </span>
            </button>

            <button class="hub-tab" role="tab" aria-selected="false" data-tab="aigc" type="button">
              <span class="hub-tab__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 16.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/></svg>
              </span>
              <span class="hub-tab__body">
                <span class="hub-tab__title">AIGC</span>
                <span class="hub-tab__desc">Custom models and batch pipelines, curated.</span>
              </span>
              <span class="hub-tab__chev" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
              </span>
            </button>

            <div class="hub-tabs__progress" aria-hidden="true"><span></span></div>
          </div>

          <div class="hub-tabs__stage">
            <div class="hub-panel is-active" role="tabpanel" data-panel="creative">
              <figure class="hub-panel__visual">
                <img src="/Images/hub-studio/creative.jpg" alt="" loading="lazy" decoding="async" />
                <figcaption>Beauty key visual, Xiaohongshu and Tmall.</figcaption>
              </figure>
              <div class="hub-panel__copy">
                <h3>Creative</h3>
                <p>
                  Visual identity, campaign concepts and key visuals for Baidu, WeChat,
                  Xiaohongshu, Douyin and Tmall. Each platform has its own grammar.
                  We write in it.
                </p>
                <ul class="hub-panel__tags">
                  <li>Visual identity</li>
                  <li>Campaign concepts</li>
                  <li>Key visuals</li>
                  <li>Platform adaptations</li>
                  <li>Social storytelling</li>
                </ul>
              </div>
            </div>

            <div class="hub-panel" role="tabpanel" data-panel="production" hidden>
              <figure class="hub-panel__visual">
                <img src="/Images/hub-studio/production.jpg" alt="" loading="lazy" decoding="async" />
                <figcaption>Furniture campaign, in-studio.</figcaption>
              </figure>
              <div class="hub-panel__copy">
                <h3>Production</h3>
                <p>
                  Image and video are the bulk of what ships. Real shoots, real crews,
                  real props. Plus packaging, motion and OOH for the long tail every
                  brand needs across China platforms.
                </p>
                <ul class="hub-panel__tags">
                  <li>Photo &amp; film</li>
                  <li>Motion</li>
                  <li>Packaging</li>
                  <li>OOH</li>
                  <li>Post-production</li>
                </ul>
              </div>
            </div>

            <div class="hub-panel" role="tabpanel" data-panel="aigc" hidden>
              <figure class="hub-panel__visual">
                <img src="/Images/hub-studio/aigc.jpg" alt="" loading="lazy" decoding="async" />
                <figcaption>Curated AIGC output, in-studio review.</figcaption>
              </figure>
              <div class="hub-panel__copy">
                <h3>AIGC</h3>
                <p>
                  Custom-trained models, LoRA work and batch pipelines where they earn
                  their keep. Every output passes a human before it ships, so the work
                  stays on-brand and on-platform.
                </p>
                <ul class="hub-panel__tags">
                  <li>Custom models</li>
                  <li>LoRA training</li>
                  <li>Batch pipelines</li>
                  <li>Human curation</li>
                  <li>On-brand control</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Closing pull quote */}
      <figure class="hub-quote" data-reveal>
        <span class="hub-quote__mark" aria-hidden="true">&ldquo;</span>
        <blockquote>
          A campaign shot in Paris can land flat in Shanghai. The team has spent
          years inside the codes that make Chinese audiences stop scrolling. What
          feels aspirational on Instagram doesn't always read that way on
          Xiaohongshu, and that gap is usually invisible from Europe.
        </blockquote>
        <figcaption>
          <span class="hub-quote__name">hub Studio</span>
          <span class="hub-quote__role">Creative production, Shanghai</span>
        </figcaption>
      </figure>

    </div>
  </section>

  {/* ---------- FINAL CTA ---------- */}
  <section class="section section--alt">
    <div class="container">
      <div class="hub-final">
        <span class="eyebrow">Ready to brief us?</span>
        <h2 class="hub-final__title">Tell us what you are shooting. We will scope, crew and ship it.</h2>
        <p class="lead hub-final__lead">
          Brief hub Studio directly, or talk to the TheChinaPath team if you want
          the campaign tied into media and commerce.
        </p>
        <div class="hub-final__actions">
          <a href="https://hubstudio.ai" target="_blank" rel="noopener noreferrer" class="btn btn--primary">Visit hub Studio</a>
          <a href="/contact" class="btn btn--secondary">Talk to the group</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Counter animation ---- */
      const counters = document.querySelectorAll('[data-counter]');
      const animateCounter = (numEl, target) => {
        if (reduced) { numEl.textContent = target.toString(); return; }
        const duration = 1600;
        const start = performance.now();
        const tick = (now) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          numEl.textContent = Math.round(target * eased).toString();
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;
          const target = parseInt(el.dataset.target, 10);
          const numEl = el.querySelector('.proof-metric__num');
          if (!Number.isFinite(target) || !numEl) return;
          numEl.textContent = reduced ? target.toString() : '0';
          animateCounter(numEl, target);
          counterObserver.unobserve(el);
        });
      }, { threshold: 0.35 });
      counters.forEach((el) => counterObserver.observe(el));

      /* ---- Reveal on scroll ---- */
      const reveals = document.querySelectorAll('[data-reveal]');
      if (reveals.length) {
        if (reduced) {
          reveals.forEach((el) => el.classList.add('is-revealed'));
        } else {
          const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-revealed');
              revealObserver.unobserve(entry.target);
            });
          }, { threshold: 0.15, rootMargin: '0px 0px -80px 0px' });
          reveals.forEach((el) => revealObserver.observe(el));
        }
      }

      /* ---- Tabbed pillar showcase ---- */
      const tabRoots = document.querySelectorAll('[data-tabs]');
      tabRoots.forEach((root) => {
        const tabs = root.querySelectorAll('.hub-tab');
        const panels = root.querySelectorAll('.hub-panel');
        const progress = root.querySelector('.hub-tabs__progress span');
        const ROTATE_MS = 6000;
        let activeIdx = 0;
        let timerStart = 0;
        let paused = false;

        const tick = (now) => {
          if (paused) { requestAnimationFrame(tick); return; }
          const elapsed = now - timerStart;
          if (progress) progress.style.width = Math.min(100, (elapsed / ROTATE_MS) * 100) + '%';
          if (elapsed >= ROTATE_MS) {
            activate((activeIdx + 1) % tabs.length);
          }
          requestAnimationFrame(tick);
        };

        const activate = (idx) => {
          activeIdx = idx;
          tabs.forEach((t, i) => {
            const on = i === idx;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          panels.forEach((p, i) => {
            const on = i === idx;
            p.classList.toggle('is-active', on);
            if (on) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
          });
          timerStart = performance.now();
          if (progress) progress.style.width = '0%';
        };

        tabs.forEach((tab, i) => {
          tab.addEventListener('click', () => activate(i));
          tab.addEventListener('mouseenter', () => { paused = true; activate(i); });
          tab.addEventListener('mouseleave', () => { paused = false; });
          tab.addEventListener('focus', () => { paused = true; activate(i); });
          tab.addEventListener('blur', () => { paused = false; });
        });

        if (!reduced) {
          const startWhenVisible = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              timerStart = performance.now();
              requestAnimationFrame(tick);
              startWhenVisible.unobserve(root);
            });
          }, { threshold: 0.2 });
          startWhenVisible.observe(root);
        }
      });

      /* ---- Logo tilt on mousemove ---- */
      const tilts = document.querySelectorAll('[data-tilt]');
      if (!reduced) {
        tilts.forEach((el) => {
          el.addEventListener('mousemove', (e) => {
            const rect = el.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width - 0.5;
            const y = (e.clientY - rect.top) / rect.height - 0.5;
            el.style.transform = 'perspective(800px) rotateX(' + (-y * 8) + 'deg) rotateY(' + (x * 10) + 'deg)';
          });
          el.addEventListener('mouseleave', () => {
            el.style.transform = 'perspective(800px) rotateX(0) rotateY(0)';
          });
        });
      }

      /* ---- Subtle parallax on hub backdrop ---- */
      const parallax = document.querySelector('.hub-studio [data-parallax]');
      const hubRoot = document.querySelector('[data-hub-root]');
      if (parallax && hubRoot && !reduced) {
        let ticking = false;
        const update = () => {
          const rect = hubRoot.getBoundingClientRect();
          const vh = window.innerHeight || 1;
          const progress = Math.max(-1, Math.min(1, (rect.top + rect.height / 2 - vh / 2) / vh));
          parallax.style.transform = 'translate3d(0, ' + (progress * -40) + 'px, 0)';
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { requestAnimationFrame(update); ticking = true; }
        }, { passive: true });
        update();
      }
    })();
  </script>

</Layout>

<style>
  /* ============================================================
     hub Studio / Production house
     ============================================================ */
  .hub-studio {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: var(--bbg-white);
    padding-top: clamp(96px, 12vh, 160px);
    padding-bottom: clamp(72px, 9vh, 120px);
  }

  /* ---- Backdrop layers ---- */
  .hub-studio__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .hub-studio__bg-image {
    position: absolute;
    inset: -10% 0 -10% 0;
    background: url('/Images/hub-studio/backdrop.jpg') center/cover no-repeat;
    transform: translate3d(0, 0, 0);
    will-change: transform;
    filter: saturate(0.9) contrast(1.04);
  }
  .hub-studio__bg-tint {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 14, 24, 0.72) 0%, rgba(8, 14, 24, 0.78) 55%, rgba(8, 14, 24, 0.92) 100%);
  }
  .hub-studio__bg-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 70% 30%, transparent 0%, rgba(8, 14, 24, 0.55) 75%);
    pointer-events: none;
  }

  .hub-studio__inner { position: relative; }

  /* ---- Reveal animation ---- */
  [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 24px, 0);
    transition: opacity 700ms var(--ease), transform 700ms var(--ease);
  }
  [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }

  /* ---- Editorial opener ---- */
  .hub-editorial {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(var(--space-6), 6vw, var(--space-8));
    align-items: stretch;
    padding-block: var(--space-5);
  }
  .hub-editorial__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-self: center;
    max-width: 56ch;
  }
  .hub-editorial .eyebrow--on-dark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }
  .eyebrow__bar {
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--bbg-blue);
  }
  .hub-editorial__title {
    color: var(--bbg-white);
    font-size: clamp(2.5rem, 5vw + 0.5rem, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 600;
    margin: 0;
  }
  .hub-editorial__title-emph {
    display: block;
    color: var(--bbg-blue);
    font-style: italic;
    font-weight: 500;
  }
  .hub-editorial__lead {
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    font-size: clamp(1.05rem, 0.5vw + 0.95rem, 1.25rem);
    line-height: 1.55;
    max-width: 52ch;
  }
  .hub-editorial__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .hub-editorial__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--fs-body);
  }
  .hub-editorial__list svg {
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    margin-top: 4px;
    color: var(--bbg-blue);
  }
  .hub-editorial__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-3);
  }
  .hub-editorial__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--bbg-white);
    font-weight: 600;
    font-size: var(--fs-body);
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .hub-editorial__cta svg { width: 18px; height: 18px; transition: transform var(--dur) var(--ease); }
  .hub-editorial__cta:hover { color: var(--bbg-blue); border-color: var(--bbg-blue); }
  .hub-editorial__cta:hover svg { transform: translateX(6px); }
  .hub-editorial__meta {
    color: rgba(255, 255, 255, 0.45);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Aside, poster-like panel with logo + cost */
  .hub-editorial__aside {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hub-editorial__index {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    color: rgba(255, 255, 255, 0.18);
    font-size: var(--fs-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .hub-editorial__logo {
    display: grid;
    place-items: center;
    padding: var(--space-5) var(--space-5);
    background: #F4F1EA;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 18px 40px rgba(0, 0, 0, 0.45),
      0 4px 12px rgba(0, 0, 0, 0.25);
    transform-style: preserve-3d;
    transition: transform 200ms var(--ease);
    min-height: 180px;
  }
  .hub-editorial__logo img {
    max-width: 100%;
    max-height: 120px;
    width: auto;
    height: auto;
    transition: transform 400ms var(--ease);
  }
  .hub-editorial__logo:hover img { transform: scale(1.03); }
  .hub-editorial__rule {
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 100%);
  }
  .hub-editorial__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .hub-editorial__stat-label {
    color: rgba(255, 255, 255, 0.55);
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .hub-editorial__stat-value {
    display: flex;
    align-items: baseline;
    gap: 4px;
    color: var(--bbg-white);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .hub-editorial__stat-prefix {
    font-size: clamp(2rem, 2.6vw + 0.5rem, 2.8rem);
    color: rgba(255, 255, 255, 0.4);
    font-weight: 400;
  }
  .hub-editorial__stat-num {
    font-size: clamp(4rem, 7vw + 0.5rem, 6.4rem);
    color: var(--bbg-white);
    font-variant-numeric: tabular-nums;
  }
  .hub-editorial__stat-unit {
    font-size: clamp(2rem, 2.6vw + 0.5rem, 2.8rem);
    color: var(--bbg-blue);
  }
  .hub-editorial__stat-note {
    color: rgba(255, 255, 255, 0.62);
    font-size: var(--fs-small);
    line-height: 1.5;
    margin: 0;
    max-width: 36ch;
  }

