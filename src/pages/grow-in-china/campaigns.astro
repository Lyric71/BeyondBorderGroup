    .cbs-reality__note {
      margin: var(--space-6) auto 0;
      max-width: 70ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
    }

    /* ---------- STEPS (no number badges, check-icon led) ---------- */
    .cbs-steps {
      list-style: none; padding: 0; margin: 0;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-5);
      counter-reset: none;
    }
    .cbs-steps__item {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      display: flex; flex-direction: column;
      gap: var(--space-3);
      position: relative;
      transition: border-color 260ms ease, box-shadow 260ms ease, transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-steps__item::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #E84A60 100%);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }
    .cbs-steps__item:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: 0 16px 32px -20px rgba(200, 16, 46, 0.4);
    }
    .cbs-steps__item:hover::before { transform: scaleX(1); }
    .cbs-steps__check {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .cbs-steps__check svg { width: 18px; height: 18px; }
    .cbs-steps__title {
      font-size: 1.0625rem;
      line-height: 1.25;
      margin: 0;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-steps__body {
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .cbs-steps { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .cbs-steps { grid-template-columns: 1fr; }
    }

    .cbs-approach__cta {
      margin-top: var(--space-6);
      text-align: center;
    }

    /* ---------- QUOTE / CALLOUT ---------- */
    .cbs-quote {
      margin: var(--space-6) auto 0;
      max-width: 760px;
      padding: var(--space-5) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.10) 100%);
      border-left: 4px solid var(--bbg-blue);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
    }
    .cbs-quote p {
      margin: 0;
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--bbg-ink);
      font-weight: 500;
      font-style: italic;
    }
    .cbs-quote--warning {
      background: linear-gradient(135deg, #FFF6E5 0%, #FFEDC9 100%);
      border-left-color: #D89B2A;
    }
    .cbs-quote--warning p { color: #5B3E0A; font-style: normal; font-weight: 500; }

    /* ---------- CALENDAR TABLE ---------- */
    .cbs-compare {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: clamp(var(--space-4), 2vw + 1rem, var(--space-6));
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    }
    .cbs-compare__table-wrap { overflow-x: auto; }
    .cbs-calendar {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      min-width: 880px;
      font-size: 0.95rem;
    }
    .cbs-calendar thead th {
      text-align: left;
      vertical-align: top;
      padding: var(--space-4);
      background: var(--bbg-surface);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-calendar__th--accent {
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
    }
    .cbs-calendar tbody td {
      padding: var(--space-4);
      border-bottom: 1px solid var(--bbg-border);
      vertical-align: top;
      color: var(--bbg-ink);
      line-height: 1.55;
    }
    .cbs-calendar tbody tr:last-child td { border-bottom: none; }
    .cbs-calendar tbody tr:hover td { background: rgba(200, 16, 46, 0.03); }
    .cbs-calendar__date {
      font-weight: 700;
      color: var(--bbg-ink);
      white-space: nowrap;
    }
    .cbs-calendar__event {
      font-weight: 600;
      color: var(--bbg-ink);
    }
    .cbs-calendar__prep {
      font-weight: 700;
      color: var(--bbg-blue);
      white-space: nowrap;
      background: rgba(200, 16, 46, 0.04);
    }
    .cbs-calendar__what {
      color: var(--bbg-text);
      max-width: 36ch;
    }
    .cbs-calendar__who {
      color: var(--bbg-text-muted);
      font-size: 0.9rem;
    }
    .cbs-compare__note {
      margin: var(--space-5) auto 0;
      max-width: 70ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 0.975rem;
    }

    /* ---------- FIT (two cards) ---------- */
    .cbs-fit {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
    .cbs-fit__card {
      padding: clamp(var(--space-5), 2vw + 1rem, var(--space-7));
      border-radius: var(--radius-lg);
      border: 1px solid var(--bbg-border);
      background: var(--bbg-white);
      display: flex; flex-direction: column;
      gap: var(--space-3);
      position: relative;
      transition: border-color 260ms ease, box-shadow 260ms ease, transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-fit__card:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 28px -18px rgba(8, 18, 28, 0.18);
    }
    .cbs-fit__card--yes {
      background: linear-gradient(160deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.08) 100%);
      border-color: rgba(200, 16, 46, 0.35);
    }
    .cbs-fit__card--yes:hover { border-color: var(--bbg-blue); }
    .cbs-fit__tag {
      align-self: flex-start;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      padding: 0.35em 0.85em;
      border-radius: 999px;
    }
    .cbs-fit__card--yes .cbs-fit__tag {
      color: var(--bbg-white);
      background: var(--bbg-blue);
    }
    .cbs-fit__card--not .cbs-fit__tag {
      color: var(--bbg-text-muted);
      background: var(--bbg-surface);
      border: 1px solid var(--bbg-border);
    }
    .cbs-fit__card p {
      color: var(--bbg-ink);
      font-size: 1.0625rem;
      line-height: 1.65;
      margin: 0;
    }
    .cbs-fit__card--not p { color: var(--bbg-text); }
    @media (max-width: 1024px) {
      .cbs-fit { grid-template-columns: 1fr; }
    }

    /* ---------- FINAL CTA ---------- */
    .cbs-cta {
      padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8)) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
      color: var(--bbg-white);
      border-radius: var(--radius-lg);
      text-align: center;
      position: relative; overflow: hidden;
    }
    .cbs-cta::before {
      content: ""; position: absolute;
      top: -40%; right: -10%;
      width: 420px; height: 420px;
      background: radial-gradient(circle at center, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 65%);
      pointer-events: none;
    }
    .cbs-cta .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-4);
      color: rgba(255, 255, 255, 0.9);
    }
    .cbs-cta__title {
      font-size: clamp(1.75rem, 1.5vw + 1rem, 2.5rem);
      line-height: 1.15;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      letter-spacing: -0.015em;
    }
    .cbs-cta__lead {
      color: rgba(255, 255, 255, 0.92);
      font-size: 1.0625rem;
      max-width: 58ch;
      margin: 0 auto var(--space-4);
      line-height: 1.6;
    }
    .cbs-cta__pull {
      font-size: 1.125rem;
      font-style: italic;
      font-weight: 500;
      color: var(--bbg-white);
      max-width: 50ch;
      margin: 0 auto var(--space-5);
      padding-top: var(--space-4);
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      line-height: 1.45;
      position: relative;
    }
    .cbs-cta__actions {
      display: flex; flex-wrap: wrap;
      gap: var(--space-3);
      justify-content: center;
      position: relative;
    }
    .cbs-cta__btn-primary {
      background: var(--bbg-white);
      color: var(--bbg-blue-dark);
      border: 1px solid var(--bbg-white);
    }
    .cbs-cta__btn-primary:hover {
      background: rgba(255, 255, 255, 0.92);
      color: var(--bbg-blue-dark);
    }
    .cbs-cta__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: var(--bbg-white);
    }
    .cbs-cta__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }
  </style>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const revealEls = document.querySelectorAll('.cbs-reveal');
      if (revealEls.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          revealEls.forEach((el) => io.observe(el));
        }
      }

      const parallaxEl = document.querySelector('[data-parallax]');
      const progressEl = document.querySelector('.cbs-progress__bar');
      const heroEl = document.querySelector('[data-hero]');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;
          if (parallaxEl && heroEl && !reduced) {
            const heroH = heroEl.offsetHeight;
            if (scrollY < heroH) {
              parallaxEl.style.setProperty('--parallax-y', (scrollY * 0.18) + 'px');
            }
          }
          if (progressEl) {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
            progressEl.style.setProperty('--progress', pct + '%');
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = link.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
          history.replaceState(null, '', id);
        });
      });

      // Truth cards: cursor tilt + scroll-driven image parallax
      const truths = document.querySelectorAll('[data-truth-tilt]');
      if (truths.length && !reduced) {
        truths.forEach((card) => {
          const onMove = (e) => {
            const rect = card.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width;
            const y = (e.clientY - rect.top) / rect.height;
            const ry = (x - 0.5) * 5;
            const rx = (0.5 - y) * 4;
            card.style.setProperty('--ry', ry.toFixed(2) + 'deg');
            card.style.setProperty('--rx', rx.toFixed(2) + 'deg');
            card.setAttribute('data-tilt-active', '');
          };
          const onLeave = () => {
            card.style.setProperty('--ry', '0deg');
            card.style.setProperty('--rx', '0deg');
            card.removeAttribute('data-tilt-active');
          };
          card.addEventListener('mousemove', onMove);
          card.addEventListener('mouseleave', onLeave);
        });

        const parallaxImgs = document.querySelectorAll('[data-truth-parallax]');
        let truthsTicking = false;
        const updateTruthParallax = () => {
          parallaxImgs.forEach((img) => {
            const frame = img.parentElement;
            if (!frame) return;
            const rect = frame.getBoundingClientRect();
            const vh = window.innerHeight;
            if (rect.bottom < 0 || rect.top > vh) return;
            const center = rect.top + rect.height / 2;
            const offset = (center - vh / 2) / vh;
            const shift = Math.max(-16, Math.min(16, -offset * 22));
            img.style.setProperty('--img-y', shift.toFixed(1) + 'px');
          });
        };
        const onTruthsScroll = () => {
          if (truthsTicking) return;
          truthsTicking = true;
          requestAnimationFrame(() => {
            updateTruthParallax();
            truthsTicking = false;
          });
        };
        window.addEventListener('scroll', onTruthsScroll, { passive: true });
        window.addEventListener('resize', onTruthsScroll, { passive: true });
        updateTruthParallax();
      }
    })();
  </script>
</Layout>
