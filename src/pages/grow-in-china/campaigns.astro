    /* ---------- PROSE BLOCK ---------- */
    .cbs-prose p {
      color: var(--bbg-text);
      line-height: 1.75;
      font-size: 1.0625rem;
      margin: 0 0 var(--space-4);
    }
    .cbs-prose p:last-child { margin-bottom: 0; }
    .cbs-prose + .cbs-quote { margin-top: var(--space-5); }
    .cbs-quote + .cbs-prose { margin-top: var(--space-5); }

    /* ---------- BASICS (two-column read) ---------- */
    .cbs-basics {
      max-width: 1080px;
      margin: 0 auto;
    }
    .cbs-basics__head {
      max-width: 720px;
      margin: 0 auto var(--space-6);
      text-align: center;
    }
    .cbs-basics__head h2 {
      font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
      line-height: 1.15;
      letter-spacing: -0.015em;
      margin: var(--space-3) 0 0;
    }
    .cbs-basics__cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .cbs-basics__col p {
      color: var(--bbg-text);
      font-size: 1.0625rem;
      line-height: 1.75;
      margin: 0 0 var(--space-4);
