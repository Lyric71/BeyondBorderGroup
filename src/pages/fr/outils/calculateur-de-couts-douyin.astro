<script is:inline>
  (function () {
    const form = document.getElementById('calc-form');
    const gate = document.getElementById('calc-gate');
    const gateForm = document.getElementById('calc-gate-form');
    const gateStatus = document.getElementById('lead-status');
    const leadSubmit = document.getElementById('lead-submit');
    const results = document.getElementById('calc-results');
    if (!form || !gate || !gateForm) return;

    const prefersReduced =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- number helpers ----
    const rmb0 = (n) => 'RMB ' + Math.round(n).toLocaleString('en-US');
    const usd0 = (n) => '$' + Math.round(n).toLocaleString('en-US');
    const pct1 = (n) => (n * 100).toFixed(1) + '%';

    // ---------- scroll reveal ----------
    if ('IntersectionObserver' in window && !prefersReduced) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
    }

    // ---------- slider <-> number sync + fill ----------
    function paintRange(range) {
      const min = parseFloat(range.min || '0');
      const max = parseFloat(range.max || '100');
      const val = parseFloat(range.value || '0');
      const pct = max > min ? ((val - min) / (max - min)) * 100 : 0;
      range.style.setProperty('--pct', pct + '%');
    }
    document.querySelectorAll('.driver__range').forEach((range) => {
      const num = document.getElementById(range.getAttribute('data-target'));
      paintRange(range);
      range.addEventListener('input', () => {
        if (num) {
          num.value = range.value;
          num.dispatchEvent(new Event('input', { bubbles: true }));
        }
        paintRange(range);
      });
      if (num) {
        num.addEventListener('input', () => {
          range.value = num.value;
          paintRange(range);
        });
      }
    });

    // ---------- live preview ----------
    const liveOrders = document.getElementById('live-orders');
    function updatePreview() {
      const gmv = parseFloat(document.getElementById('gmv').value) || 0;
      const aov = parseFloat(document.getElementById('aov').value) || 0;
      const orders = aov > 0 ? gmv / aov : 0;
      if (liveOrders) {
        liveOrders.textContent = Math.round(orders).toLocaleString('en-US');
        if (!prefersReduced) {
          liveOrders.classList.remove('is-pulse');
          void liveOrders.offsetWidth;
          liveOrders.classList.add('is-pulse');
        }
      }
    }
    form.addEventListener('input', updatePreview);
    updatePreview();

    // ---------- channel mix: check the three shares total 100% (no auto-edit) ----------
    let mixIs100 = true;
    (function () {
      const ids = ['paidShare', 'kolShare', 'organicShare'];
      const labels = ['média payant', 'KOL', 'organique'];
      const els = ids.map((id) => document.getElementById(id));
      if (els.some((e) => !e)) return;
      const mixNote = document.getElementById('mix-note');
      function validateMix() {
        const v = els.map((e) => Math.max(0, Math.round(parseFloat(e.value) || 0)));
        const sum = v[0] + v[1] + v[2];
        mixIs100 = sum === 100;
        if (!mixNote) return;
        const chips = ids
          .map(
            (id, k) =>
              '<span class="calc-mix__seg calc-mix__seg--' +
              id +
              '"><span class="calc-mix__dot"></span>' +
              v[k] +
              '% ' +
              labels[k] +
              '</span>',
          )
          .join('');
        const status = mixIs100
          ? '<span class="calc-mix__status calc-mix__status--ok">Total 100 % ✓</span>'
          : '<span class="calc-mix__status calc-mix__status--bad">Total ' +
            sum +
            ' %, doit faire 100 %</span>';
        mixNote.innerHTML = chips + status;
        mixNote.classList.toggle('calc-mix--bad', !mixIs100);
      }
      els.forEach((e) => e.addEventListener('input', validateMix));
      validateMix();
    })();

    // ---------- advanced accordion ----------
    const advToggle = document.getElementById('advanced-toggle');
    const advBody = document.getElementById('advanced-body');
    if (advToggle && advBody) {
      advToggle.addEventListener('click', () => {
        const open = advToggle.getAttribute('aria-expanded') === 'true';
        advToggle.setAttribute('aria-expanded', String(!open));
        if (open) {
          advBody.style.maxHeight = advBody.scrollHeight + 'px';
          void advBody.offsetWidth;
          advBody.style.maxHeight = '0px';
          advBody.addEventListener(
            'transitionend',
            () => {
              if (advToggle.getAttribute('aria-expanded') === 'false') advBody.hidden = true;
            },
            { once: true },
          );
        } else {
          advBody.hidden = false;
          advBody.style.maxHeight = advBody.scrollHeight + 'px';
          advBody.addEventListener(
            'transitionend',
            () => {
              if (advToggle.getAttribute('aria-expanded') === 'true') advBody.style.maxHeight = 'none';
            },
            { once: true },
          );
        }
      });
    }

    // ---------- fine-tune tabs ----------
    const tabs = Array.from(document.querySelectorAll('.calc-tab'));
    const panels = Array.from(document.querySelectorAll('.calc-tabpanel'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', String(on));
        });
        panels.forEach((p) => {
          const on = p.getAttribute('data-panel') === idx;
          p.classList.toggle('is-active', on);
          p.hidden = !on;
        });
        // panel height may differ; let the open accordion grow to fit
        if (advBody && advToggle && advToggle.getAttribute('aria-expanded') === 'true') {
          advBody.style.maxHeight = 'none';
        }
      });
    });

    // ---------- field help bubbles ----------
    const pop = document.getElementById('field-pop');
    let popTrigger = null;
    function showPop(btn) {
      pop.textContent = btn.getAttribute('data-help') || '';
      pop.hidden = false;
      const pw = Math.min(320, window.innerWidth - 24);
      pop.style.width = pw + 'px';
      const r = btn.getBoundingClientRect();
      let left = r.left + r.width / 2 - pw / 2;
      left = Math.max(12, Math.min(left, window.innerWidth - pw - 12));
      pop.style.left = left + 'px';
      const ph = pop.offsetHeight;
      let top = r.bottom + 8;
      if (top + ph > window.innerHeight - 8) top = r.top - ph - 8;
      pop.style.top = Math.max(8, top) + 'px';
      pop.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      popTrigger = btn;
    }
    let popPinned = false;
    function hidePop() {
      if (!pop) return;
      pop.hidden = true;
      pop.classList.remove('is-open');
      if (popTrigger) popTrigger.setAttribute('aria-expanded', 'false');
      popTrigger = null;
      popPinned = false;
    }
    if (pop) {
      const canHover = window.matchMedia && window.matchMedia('(hover: hover)').matches;
      document.querySelectorAll('.calc-help__btn').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        // click pins the bubble open (works on touch too)
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (popTrigger === btn && popPinned) {
            hidePop();
          } else {
            showPop(btn);
            popPinned = true;
          }
        });
        // hover shows it transiently on pointer devices
        if (canHover) {
          btn.addEventListener('mouseenter', () => {
            if (!popPinned) showPop(btn);
          });
          btn.addEventListener('mouseleave', () => {
            if (!popPinned) hidePop();
          });
          btn.addEventListener('focus', () => {
            if (!popPinned) showPop(btn);
          });
          btn.addEventListener('blur', () => {
            if (!popPinned) hidePop();
          });
        }
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest || !e.target.closest('.calc-help__btn')) hidePop();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') hidePop();
      });
      window.addEventListener('scroll', hidePop, true);
      window.addEventListener('resize', hidePop);
    }

    // ---------- FX live rate ----------
    const fxBtn = document.getElementById('fx-refresh');
    const fxNote = document.getElementById('fx-note');
    async function refreshFx() {
      if (fxBtn) fxBtn.classList.add('is-spinning');
      if (fxNote) {
        fxNote.textContent = 'Récupération du taux…';
        fxNote.className = 'calc-field__hint';
      }
      try {
        const res = await fetch('/api/fx-rate');
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.rate) throw new Error(data.error || 'No rate returned.');
        const fxInput = document.getElementById('fx');
        fxInput.value = data.rate;
        fxInput.dispatchEvent(new Event('input', { bubbles: true }));
        if (fxNote) {
          fxNote.textContent = 'Taux du jour : 1 USD = ' + data.rate + ' RMB.';
          fxNote.className = 'calc-field__hint calc-field__hint--ok';
        }
      } catch (err) {
        if (fxNote) {
          fxNote.textContent = 'Impossible de récupérer le taux. Votre valeur est conservée.';
          fxNote.className = 'calc-field__hint calc-field__hint--err';
        }
      } finally {
        if (fxBtn) fxBtn.classList.remove('is-spinning');
      }
    }
    if (fxBtn) fxBtn.addEventListener('click', refreshFx);
    // Pull today's rate on load so the USD figure starts current.
    refreshFx();

    // ---------- category picker sets deposit + tech fee ----------
    const catSelect = document.getElementById('category');
    if (catSelect) {
      const impactBox = document.getElementById('category-impact');
      const impactDeposit = document.getElementById('impact-deposit');
      const impactFee = document.getElementById('impact-fee');

      function applyCategory(fillForm) {
        const opt = catSelect.options[catSelect.selectedIndex];
        const deposit = opt.getAttribute('data-deposit');
        const fee = opt.getAttribute('data-fee');
        // Custom leaves both fields untouched, so there is nothing to preview.
        if (!deposit && !fee) {
          if (impactBox) impactBox.hidden = true;
          return;
        }
        if (fillForm && deposit) {
          const dep = document.getElementById('platformDeposit');
          if (dep) {
            dep.value = deposit;
            dep.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }
        if (fillForm && fee) {
          const tf = document.getElementById('techFee');
          if (tf) {
            tf.value = fee;
            tf.dispatchEvent(new Event('input', { bubbles: true }));
          }
        }
        if (impactBox) {
          if (impactDeposit && deposit)
            impactDeposit.textContent = 'RMB ' + Number(deposit).toLocaleString('en-US');
          if (impactFee && fee) impactFee.textContent = fee + '%';
          impactBox.hidden = false;
        }
      }

      catSelect.addEventListener('change', () => applyCategory(true));
      // Show what the default category drives, without overwriting the fields.
      applyCategory(false);
    }

    // ---------- compute (faithful port of the DP cost model spec) ----------
    function readInputs() {
      const out = {};
      form.querySelectorAll('input[data-kind]').forEach((el) => {
        const kind = el.getAttribute('data-kind');
        const raw = el.value.trim();
        if (raw === '') {
          out[el.name] = null;
          return;
        }
        let v = parseFloat(raw);
        if (!Number.isFinite(v)) v = 0;
        if (kind === 'percent') v = v / 100;
        out[el.name] = v;
      });
      return out;
    }

    function compute(i) {
      const gmv = i.gmv || 0;
      const aov = i.aov || 1;
      const orders = gmv / aov;

      const setup = {
        'Dépôt plateforme (remboursable)': i.platformDeposit || 0,
        'Dépôt entrepôt sous douane (remboursable)': i.whDeposit || 0,
        'Avance de taxe à l\'entrepôt sous douane': i.whTaxPrepay || 0,
        'Enregistrement de la marque en Chine': i.trademark || 0,
        'Contribution à la création de la boutique': i.brandSetup || 0,
      };
      const setupTotal = Object.values(setup).reduce((a, b) => a + b, 0);

      // Fixed and per-order coefficients for break-even (Section 9 of the spec).
      // Refundable capital is left out on purpose: it comes back on exit, so it
      // is not a P&L cost.
      const dpRetainerAnnual = (i.dpRetainer || 0) * 12;
      // Service-side VAT (agency, DP, platform, ad-buying) is assumed to be baked
      // into the DP fee quote, so it is not modelled as a separate line.
      const fixedServices = (i.agentFee || 0) + dpRetainerAnnual + (i.coFund || 0);
      const F = fixedServices + (i.trademark || 0) + (i.brandSetup || 0);
      // Year 2 fixed cost: the one-time sunk setup (trademark + brand setup) is gone.
      const F2 = fixedServices;
      const vQ = (i.storage || 0) * 2 + (i.shipping || 0) + (i.returnRate || 0) * (i.returnHandling || 0);

      function scenario(roas) {
        const media = roas > 0 ? (gmv * (i.paidShare || 0)) / roas : 0;
        const dpCommission = gmv * (i.dpCommission || 0);
        const techFee = gmv * (i.techFee || 0);
        const op = {
          'Agent local (境内代理人)': i.agentFee || 0,
          'Honoraires mensuels du DP (× 12)': dpRetainerAnnual,
          'Commission du DP sur le GMV': dpCommission,
          'Cofinancement de campagne': i.coFund || 0,
          'Média payant (千川 Qianchuan)': media,
          'Commission KOL': gmv * (i.kolShare || 0) * (i.kolCommission || 0),
          'Frais de service technique de la plateforme': techFee,
          'Stockage entrepôt sous douane': orders * (i.storage || 0) * 2,
          'Livraison dernier kilomètre': orders * (i.shipping || 0),
          'Traitement des retours': orders * (i.returnRate || 0) * (i.returnHandling || 0),
          'Taxe à l\'import cross-border (综合税)': gmv * (i.cbecTax || 0),
        };
        const opTotal = Object.values(op).reduce((a, b) => a + b, 0);
        const total = setupTotal + opTotal;
        const refundable = (i.platformDeposit || 0) + (i.whDeposit || 0) + (i.whTaxPrepay || 0);
        const netSunk = total - refundable;
        const totalUSD = i.fx > 0 ? total / i.fx : 0;
        const costPerOrder = orders > 0 ? total / orders : 0;
        const totalPctGmv = gmv > 0 ? total / gmv : 0;
        const opPctGmv = gmv > 0 ? opTotal / gmv : 0;

        // %-of-GMV variable rate for this ROAS (Section 9.3).
        const paidRate = roas > 0 ? (i.paidShare || 0) / roas : 0;
        const vG =
          (i.dpCommission || 0) +
          (i.kolShare || 0) * (i.kolCommission || 0) +
          (i.techFee || 0) +
          (i.cbecTax || 0) +
          paidRate;

        let breakeven = null;
        let breakevenMonthly = null;
        let breakevenOrders = null;
        let contribution = null;
        if (i.grossMargin != null) {
          contribution = gmv * i.grossMargin - total;
          const denom = i.grossMargin - vG - (aov > 0 ? vQ / aov : 0);
          if (denom <= 0) {
            breakeven = 'GM too low';
          } else {
            breakeven = F / denom;
            breakevenMonthly = breakeven / 12;
            breakevenOrders = aov > 0 ? breakeven / aov : 0;
          }
        }

        // Buckets for the composition bar
        const buckets = [
          { key: 'Investissement de départ', color: '#c8102e', value: setupTotal },
          { key: 'Honoraires + commission DP', color: '#e2683b', value: op['Honoraires mensuels du DP (× 12)'] + op['Commission du DP sur le GMV'] },
          { key: 'Média payant', color: '#f4874b', value: op['Média payant (千川 Qianchuan)'] },
          { key: 'Commission KOL', color: '#f4b740', value: op['Commission KOL'] },
          { key: 'Taxes et frais de plateforme', color: '#7b61a8', value: op['Taxe à l\'import cross-border (综合税)'] + op['Frais de service technique de la plateforme'] },
          { key: 'Logistique', color: '#3aa0c8', value: op['Stockage entrepôt sous douane'] + op['Livraison dernier kilomètre'] + op['Traitement des retours'] },
          { key: 'Agent + cofinancement', color: '#2fb67f', value: op['Agent local (境内代理人)'] + op['Cofinancement de campagne'] },
        ];

        return { op, opTotal, total, refundable, netSunk, totalUSD, costPerOrder, totalPctGmv, opPctGmv, vG, breakeven, breakevenMonthly, breakevenOrders, contribution, buckets };
      }

      return {
        orders,
        aov,
        gmv,
        setup,
        setupTotal,
        F,
        F2,
        vQ,
        s: scenario(i.roas || 0),
        hasGm: i.grossMargin != null,
      };
    }

    // ---------- count-up ----------
    function animateCount(el, target, fmt) {
      if (prefersReduced) {
        el.textContent = fmt(target);
        return;
      }
      const start = performance.now();
      const dur = 850;
      function tick(now) {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(target * eased);
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    // ---------- results rendering ----------
    let state = null; // { i, r }
    let activeYear = '1'; // '1' or '2', driven by the Year 1 / Year 2 tabs
    // Once the visitor has handed over their email, they can tweak assumptions
    // and re-run as many times as they like without seeing the gate again. Scoped
    // to the browser session: a refresh keeps them in, a new session re-gates.
    let unlocked = false;
    try {
      unlocked = sessionStorage.getItem('douyinCalcUnlocked') === '1';
    } catch (_) {
      /* private mode or storage disabled: fall back to in-session unlock */
    }
    // When they're already unlocked, the CTA is a re-run, not a locked gate.
    function paintCta() {
      const cta = document.getElementById('calc-submit');
      const note = document.querySelector('.calc-preview__note');
      if (unlocked && cta) cta.textContent = 'Mettre à jour mon détail';
      if (unlocked && note) note.textContent = 'Modifiez une hypothèse ci-dessus, puis relancez. Pas besoin de vous réidentifier.';
    }
    paintCta();

    function renderFocus() {
      if (!state) return;
      const r = state.r;
      const s = r.s;
      const i = state.i;
      const y2 = activeYear === '2';

      // period-dependent figures. Year 2 drops the one-time setup, so its cost
      // is the operating stack only, and no refundable capital is in play.
      const cost = y2 ? s.opTotal : s.total;
      const costUSD = i.fx > 0 ? cost / i.fx : 0;
      const cash = y2 ? s.opTotal : s.netSunk;
      const cpo = r.orders > 0 ? cost / r.orders : 0;
      const pctGmv = r.gmv > 0 ? cost / r.gmv : 0;

      document.getElementById('focus-hero-label').textContent = y2 ? 'Coût total année 2' : 'Coût total année 1';
      animateCount(document.getElementById('focus-total'), cost, rmb0);
      animateCount(document.getElementById('focus-usd'), costUSD, usd0);
      animateCount(document.getElementById('focus-sunk'), cash, rmb0);
      document.getElementById('focus-sunk-foot').textContent = y2
        ? 'coûts récurrents, dépôts déjà immobilisés'
        : 'après dépôts remboursables';
      animateCount(document.getElementById('focus-cpo'), cpo, rmb0);
      document.getElementById('focus-cpo-foot').textContent = 'vs ' + rmb0(i.aov || 0) + ' de panier moyen';
      document.getElementById('focus-pct').textContent = pct1(pctGmv);

      // breakeven, year aware (Year 2 fixed cost drops the sunk setup)
      const Fyear = y2 ? r.F2 : r.F;
      const be = document.getElementById('focus-be');
      const beWrap = document.getElementById('focus-be-wrap');
      const beFoot = document.getElementById('focus-be-foot');
      if (r.hasGm) {
        const denom = i.grossMargin - s.vG - (r.aov > 0 ? r.vQ / r.aov : 0);
        if (denom <= 0) {
          be.textContent = 'Marge trop faible';
          beFoot.textContent = 'relevez d\'abord votre marge';
        } else {
          const beVal = Fyear / denom;
          be.textContent = rmb0(beVal);
          beFoot.textContent =
            'environ ' +
            rmb0(beVal / 12) +
            '/mois · ' +
            Math.round(r.aov > 0 ? beVal / r.aov : 0).toLocaleString('en-US') +
            ' commandes/an';
        }
        beWrap.classList.remove('is-muted');
      } else {
        be.textContent = 'Ajouter la marge';
        beFoot.textContent = 'pour couvrir l\'année';
        beWrap.classList.add('is-muted');
      }

      // single profit or loss card, switched by the year tab
      const plEl = document.getElementById('focus-pl1');
      const plFoot = document.getElementById('focus-pl1-foot');
      const plWrap = document.getElementById('focus-pl1-wrap');
      plEl.classList.remove('is-profit', 'is-loss');
      if (r.hasGm) {
        const grossProfit = (i.gmv || 0) * i.grossMargin;
        const amount = y2 ? grossProfit - s.opTotal : s.contribution;
        const sign = amount >= 0 ? '+' : '−';
        plEl.textContent = sign + rmb0(Math.abs(amount));
        plEl.classList.add(amount >= 0 ? 'is-profit' : 'is-loss');
        plFoot.textContent =
          (amount >= 0 ? 'bénéfice. ' : 'perte. ') + (y2 ? 'sans investissement de départ' : 'selon votre marge brute');
        plWrap.classList.remove('is-muted');
      } else {
        plEl.textContent = 'Ajouter la marge';
        plFoot.textContent = 'renseignez la marge brute par commande';
        plWrap.classList.add('is-muted');
      }

      // Net channel margin: GMV less cash actually spent (refundable deposits
      // excluded, they come back on exit), before product cost.
      const ncm = (i.gmv || 0) - cash;
      const ncmEl = document.getElementById('focus-ncm');
      ncmEl.classList.remove('is-profit', 'is-loss');
      ncmEl.textContent = (ncm >= 0 ? '+' : '−') + rmb0(Math.abs(ncm));
      ncmEl.classList.add(ncm >= 0 ? 'is-profit' : 'is-loss');
      document.getElementById('focus-ncm-foot').textContent = y2
        ? 'GMV moins coûts récurrents, avant coût produit'
        : 'GMV moins dépense réelle, avant coût produit';

      document.getElementById('compo-sub').textContent = y2
        ? 'Votre coût récurrent de l\'année 2, du plus élevé au plus faible.'
        : 'Votre coût de première année, du plus élevé au plus faible.';
      document.getElementById('compo-total-label').textContent = y2 ? 'Total année 2' : 'Total année 1';
      const compoBuckets = y2 ? s.buckets.filter((b) => b.key !== 'Investissement de départ') : s.buckets;
      renderCompo(compoBuckets, y2 ? s.opTotal : s.total);
    }

    // line icons keyed by bucket, drawn in currentColor
    const BUCKET_ICONS = {
      'Investissement de départ':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1.5-4.5A2 2 0 0 1 6.4 3h11.2a2 2 0 0 1 1.9 1.5L21 9"/><path d="M3 9v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9"/><path d="M3 9h18"/><path d="M9 13h6"/></svg>',
      'Honoraires + commission DP':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M2 20a7 7 0 0 1 14 0"/><path d="M16 6a3 3 0 0 1 0 6"/><path d="M20 20a6 6 0 0 0-4-5.6"/></svg>',
      'Média payant':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4"/></svg>',
      'Commission KOL':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4a1 1 0 0 0 1 1h2l9 5V4L6 9H4a1 1 0 0 0-1 1z"/><path d="M18 9a4 4 0 0 1 0 6"/></svg>',
      'Taxes et frais de plateforme':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h10a1 1 0 0 1 1 1v17l-3-2-3 2-3-2-3 2V4a1 1 0 0 1 1-1z"/><path d="M14.5 9.5l-5 5"/><circle cx="9.7" cy="9.7" r=".6"/><circle cx="14.3" cy="14.3" r=".6"/></svg>',
      'Logistique':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h12v9H2z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>',
      'Agent + cofinancement':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/></svg>',
    };

    let compoTipHideT = null;
    function renderCompo(buckets, grandTotal) {
      const bar = document.getElementById('compo-bar');
      const cards = document.getElementById('compo-cards');
      const tip = document.getElementById('compo-tip');
      const totalEl = document.getElementById('compo-total');
      if (!bar || !cards) return;
      const total = grandTotal || 1;
      animateCount(totalEl, grandTotal, rmb0);

      const items = buckets
        .filter((b) => b.value > 0)
        .slice()
        .sort((a, b) => b.value - a.value)
        .map((b) => ({ ...b, pct: (b.value / total) * 100 }));

      // spine segments (keep the tooltip node)
      bar.querySelectorAll('.calc-compo__seg').forEach((el) => el.remove());
      items.forEach((b) => {
        const seg = document.createElement('span');
        seg.className = 'calc-compo__seg';
        seg.dataset.key = b.key;
        seg.style.setProperty('--w', b.pct + '%');
        seg.style.setProperty('--c', b.color);
        bar.appendChild(seg);
      });

      // ranked cost cards
      cards.innerHTML = items
        .map((b, idx) => {
          const icon = BUCKET_ICONS[b.key] || '';
          return (
            '<article class="cost-card" data-key="' +
            b.key +
            '" style="--c:' +
            b.color +
            ';--i:' +
            idx +
            '">' +
            '<span class="cost-card__icon">' +
            icon +
            '</span>' +
            '<div class="cost-card__body">' +
            '<div class="cost-card__top"><span class="cost-card__name">' +
            b.key +
            '</span><span class="cost-card__pct">' +
            b.pct.toFixed(0) +
            '%</span></div>' +
            '<span class="cost-card__value" data-val="' +
            b.value +
            '">' +
            rmb0(b.value) +
            '</span>' +
            '<div class="cost-card__meter"><span class="cost-card__meter-fill" style="--w:' +
            b.pct +
            '%"></span></div>' +
            '</div>' +
            '</article>'
          );
        })
        .join('');

      const segEls = Array.from(bar.querySelectorAll('.calc-compo__seg'));
      const cardEls = Array.from(cards.querySelectorAll('.cost-card'));

      // grow the spine, meters and count up the card values
      const grow = () => {
        segEls.forEach((el) => el.classList.add('is-grown'));
        cardEls.forEach((el, idx) => {
          el.classList.add('is-in');
          const fill = el.querySelector('.cost-card__meter-fill');
          if (fill) fill.classList.add('is-grown');
          const valEl = el.querySelector('.cost-card__value');
          if (valEl) {
            const target = parseFloat(valEl.getAttribute('data-val')) || 0;
            if (prefersReduced) valEl.textContent = rmb0(target);
            else setTimeout(() => animateCount(valEl, target, rmb0), 120 + idx * 60);
          }
        });
      };
      if (prefersReduced) grow();
      else requestAnimationFrame(grow);

      // link the spine and the cards on hover / focus
      const focus = (key, on) => {
        segEls.forEach((el) => {
          el.classList.toggle('is-focus', on && el.dataset.key === key);
          el.classList.toggle('is-dim', on && el.dataset.key !== key);
        });
        cardEls.forEach((el) => {
          el.classList.toggle('is-focus', on && el.dataset.key === key);
          el.classList.toggle('is-dim', on && el.dataset.key !== key);
        });
      };
      const showTip = (seg) => {
        if (!tip) return;
        if (compoTipHideT) clearTimeout(compoTipHideT);
        const item = items.find((x) => x.key === seg.dataset.key);
        if (!item) return;
        tip.innerHTML =
          '<span class="calc-compo__tip-key">' +
          item.key +
          '</span><span class="calc-compo__tip-val">' +
          rmb0(item.value) +
          ' · ' +
          item.pct.toFixed(1) +
          '%</span>';
        tip.style.left = seg.offsetLeft + seg.offsetWidth / 2 + 'px';
        tip.classList.add('is-open');
      };
      const hideTip = () => {
        if (!tip) return;
        compoTipHideT = setTimeout(() => tip.classList.remove('is-open'), 60);
      };
      segEls.forEach((seg) => {
        seg.addEventListener('mouseenter', () => {
          focus(seg.dataset.key, true);
          showTip(seg);
        });
        seg.addEventListener('mouseleave', () => {
          focus(seg.dataset.key, false);
          hideTip();
        });
      });
      cardEls.forEach((card) => {
        card.addEventListener('mouseenter', () => focus(card.dataset.key, true));
        card.addEventListener('mouseleave', () => focus(card.dataset.key, false));
      });
    }

    function renderTable() {
      const r = state.r;
      const i = state.i;
      const s = r.s;
      const gmv = i.gmv || 0;
      const fx = i.fx > 0 ? i.fx : 0;
      const body = document.getElementById('calc-table-body');
      const sectionRow = (label) =>
        '<tr class="calc-table__section"><td colspan="3">' + label + '</td></tr>';
      // A null year-2 value means the line does not recur (setup, deposits).
      const cell = (v) => (v === null ? '<span class="calc-table__na">—</span>' : rmb0(v));
      const dataRow = (label, y1, y2, strong) =>
        '<tr' + (strong ? ' class="calc-table__total"' : '') + '><td>' + label + '</td><td>' + cell(y1) + '</td><td>' + cell(y2) + '</td></tr>';
      // signed profit/loss cell, coloured by sign
      const plCell = (n) => {
        const cls = n >= 0 ? 'calc-pl--pos' : 'calc-pl--neg';
        const sign = n >= 0 ? '+' : '−';
        return '<td class="calc-pl ' + cls + '">' + sign + rmb0(Math.abs(n)) + '</td>';
      };
      const plRow = (label, y1, y2) =>
        '<tr class="calc-table__total calc-table__pl"><td>' + label + '</td>' + plCell(y1) + plCell(y2) + '</tr>';

      // Setup and refundable deposits are Year 1 only: they drop off in Year 2.
      let rows = sectionRow('Investissement de départ, ponctuel');
      Object.keys(r.setup).forEach((k) => {
        rows += dataRow(k, r.setup[k], null, false);
      });
      rows += dataRow('Sous-total investissement', r.setupTotal, null, true);

      // Operating cost recurs, so it fills both columns.
      rows += sectionRow('Exploitation, annuel');
      Object.keys(s.op).forEach((k) => {
        rows += dataRow(k, s.op[k], s.op[k], false);
      });
      rows += dataRow('Sous-total exploitation', s.opTotal, s.opTotal, true);

      rows += sectionRow('Totaux');
      rows += dataRow('Coût total (RMB)', s.total, s.opTotal, true);
      rows += dataRow('Dont remboursable', s.refundable, null, false);
      rows += dataRow('Dépense réelle', s.netSunk, s.opTotal, true);
      if (fx) {
        rows +=
          '<tr class="calc-table__total"><td>Coût total (USD)</td><td>' +
          usd0(s.totalUSD) +
          '</td><td>' +
          usd0(s.opTotal / fx) +
          '</td></tr>';
      }
      rows += dataRow('Économie année 1 vers année 2', s.total - s.opTotal, null, false);
      rows += plRow('Marge nette du canal (avant coût produit)', gmv - s.netSunk, gmv - s.opTotal);

      rows += sectionRow('Résultat selon votre marge');
      if (r.hasGm) {
        // Breakeven differs by year: Year 2 carries the lower fixed cost (F2), so
        // its breakeven GMV is lower. Both share the same contribution margin.
        const denom = i.grossMargin - s.vG - (r.aov > 0 ? r.vQ / r.aov : 0);
        const beCell = (F) => (denom <= 0 ? 'Marge trop faible' : rmb0(F / denom));
        const grossProfit = gmv * i.grossMargin;
        rows += dataRow('Marge brute (GMV × marge)', grossProfit, grossProfit, false);
        rows += plRow('Résultat (bénéfice ou perte)', s.contribution, grossProfit - s.opTotal);
        rows +=
          '<tr><td>GMV de rentabilité</td><td>' + beCell(r.F) + '</td><td>' + beCell(r.F2) + '</td></tr>';
      } else {
        rows +=
          '<tr class="calc-table__prompt"><td colspan="3">Ajoutez votre marge brute ci-dessous (ouvrez « Ajuster chaque paramètre », puis l\'onglet « Votre rentabilité ») pour voir le résultat des années 1 et 2.</td></tr>';
      }
      body.innerHTML = rows;
    }

    function renderResults() {
      const i = state.i;
      const r = state.r;
      const roas = i.roas || 0;
      document.getElementById('calc-results-sub').textContent =
        'Sur la base de ' + rmb0(i.gmv || 0) + ' de GMV, ' + Math.round(r.orders).toLocaleString('en-US') + ' commandes par an à ' + rmb0(i.aov || 0) + ' de panier moyen, ROAS ' + roas + 'x.';
      renderFocus();
      renderTable();
      results.hidden = false;
      results.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
    }

    // export to PDF via the browser print dialog (no dependency, China-safe)
    function exportPdf() {
      const detail = document.querySelector('.calc-detail');
      if (detail) detail.open = true; // make sure the full table prints
      window.print();
    }
    document.querySelectorAll('[data-export-pdf]').forEach((btn) => btn.addEventListener('click', exportPdf));

    // year tabs (Year 1 / Year 2). There is more than one group on the page
    // (the toolbar and the "Where the money goes" header), so switching one
    // keeps every group in sync by matching on data-year.
    function setYear(year) {
      activeYear = year;
      document.querySelectorAll('.calc-period__tab').forEach((t) => {
        const on = t.getAttribute('data-year') === year;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      renderFocus();
    }
    document.querySelectorAll('.calc-period__tab').forEach((tab) => {
      tab.addEventListener('click', () => setYear(tab.getAttribute('data-year')));
    });

    // ---------- lead payload ----------
    function leadPayloadExtras(r) {
      const inputs = [];
      form.querySelectorAll('input[data-kind]').forEach((el) => {
        const label = el.getAttribute('data-label') || el.name;
        const kind = el.getAttribute('data-kind');
        let val = el.value.trim();
        if (val === '') val = '(non renseigné)';
        else if (kind === 'money') val = 'RMB ' + Number(val).toLocaleString('en-US');
        else if (kind === 'percent') val = val + '%';
        inputs.push({ label, value: val });
      });
      const out = [
        { label: 'Total année 1', value: rmb0(r.s.total) + ' / ' + usd0(r.s.totalUSD) },
        { label: 'Total année 2', value: rmb0(r.s.opTotal) },
        { label: 'Dépense réelle, année 1', value: rmb0(r.s.netSunk) },
        { label: 'Coût par commande', value: rmb0(r.s.costPerOrder) },
        { label: 'Coût en % du GMV', value: pct1(r.s.totalPctGmv) },
      ];
      if (r.hasGm) {
        const be = typeof r.s.breakeven === 'string' ? r.s.breakeven : rmb0(r.s.breakeven);
        out.push({ label: 'GMV de rentabilité', value: be });
      }
      return { inputs, results: out };
    }

    // ---------- gate ----------
    let lastFocus = null;
    function openGate() {
      lastFocus = document.activeElement;
      gate.hidden = false;
      gate.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      const first = document.getElementById('lead-name');
      if (first) first.focus();
    }
    function closeGate() {
      gate.hidden = true;
      gate.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    gate.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeGate));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !gate.hidden) closeGate();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!mixIs100) {
        const note = document.getElementById('mix-note');
        if (note) {
          note.classList.add('calc-mix--shake');
          note.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(() => note.classList.remove('calc-mix--shake'), 500);
        }
        return;
      }
      const i = readInputs();
      state = { i, r: compute(i) };
      if (unlocked) {
        // Already gave us their email: recompute and reveal, no gate.
        renderResults();
        results.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        openGate();
      }
    });

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    gateForm.addEventListener('submit', (e) => {
      e.preventDefault();
      gateStatus.textContent = '';
      gateStatus.className = 'calc-gate__status';
      const data = new FormData(gateForm);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const company = String(data.get('company') || '').trim();
      if (!name || !EMAIL_RE.test(email)) {
        gateStatus.textContent = 'Please add your name and a valid work email.';
        gateStatus.classList.add('calc-gate__status--error');
        return;
      }

      // Capture the lead in the background. The reveal never waits on it, so a
      // mail-backend hiccup can't block the visitor from seeing their numbers.
      const extras = state ? leadPayloadExtras(state.r) : { inputs: [], results: [] };
      fetch('/api/calculator-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, company, inputs: extras.inputs, results: extras.results }),
      }).catch(() => {
        /* lead capture is best-effort; ignore failures */
      });

      // Remember the visitor so re-runs never ask again.
      unlocked = true;
      try {
        sessionStorage.setItem('douyinCalcUnlocked', '1');
      } catch (_) {
        /* storage disabled: unlock still holds for this session */
      }
      paintCta();

      // Reveal the Cost Stack results immediately.
      closeGate();
      renderResults();
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

<style is:global>
  /* Styles are global on purpose: much of this UI (cost cards, the spine bar,
     the results table body, the channel-mix note) is built with innerHTML at
     runtime, and Astro's scoped styles never reach nodes created after render.
     A page's CSS ships only with that page, so global here stays on this page. */

  /* ---------- scroll reveal ---------- */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease);
  }
  .reveal.is-in {
    opacity: 1;
    transform: none;
  }
  .calc-flow__step.reveal {
    transition-delay: calc(var(--i) * 90ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ---------- hero scroll cue ---------- */
  .tool-hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-6);
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .tool-hero__scroll:hover {
    color: #fff;
