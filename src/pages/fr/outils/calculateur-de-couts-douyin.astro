---
import Layout from '../../../layouts/Layout.astro';

// ---- Key drivers, shown as sliders at the top of the calculator ----
type Driver = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number';
  min: string;
  max: string;
  step: string;
  hint?: string;
};

const drivers: Driver[] = [
  { id: 'gmv', label: 'GMV visé (année 1)', value: '2000000', kind: 'money', min: '200000', max: '10000000', step: '100000' },
  { id: 'aov', label: 'Panier moyen', value: '250', kind: 'money', min: '20', max: '500', step: '5' },
  { id: 'dpRetainer', label: 'Honoraires mensuels du DP', value: '30000', kind: 'money', min: '20000', max: '150000', step: '5000' },
  { id: 'coFund', label: 'Cofinancement de campagne', value: '0', kind: 'money', min: '0', max: '300000', step: '10000' },
  { id: 'dpCommission', label: 'Commission du DP sur le GMV', value: '5', kind: 'percent', min: '0', max: '12', step: '0.5' },
  { id: 'paidShare', label: 'Média payant', value: '0', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolShare', label: 'KOL', value: '100', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'organicShare', label: 'Organique', value: '0', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolCommission', label: 'Taux de commission KOL', value: '20', kind: 'percent', min: '0', max: '40', step: '1' },
  { id: 'roas', label: 'ROAS (retour sur dépense publicitaire)', value: '1.3', kind: 'number', min: '0.5', max: '6', step: '0.1' },
];

// The three channel shares are grouped together and must always total 100%.
const shareIds = ['paidShare', 'kolShare', 'organicShare'];
const mainDrivers = drivers.filter((d) => !shareIds.includes(d.id));
const shareDrivers = drivers.filter((d) => shareIds.includes(d.id));

// ---- Advanced inputs, grouped in the collapsible section ----
type Field = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number' | 'select';
  step?: string;
  hint?: string;
  fx?: boolean;
  options?: { value: string; label: string; deposit?: string; fee?: string }[];
};

// CBEC 抖音全球购 categories. Each one sets the platform deposit and the tech
// service fee, the only two model inputs that move with product category
// (see Section 8 of the model spec). Fee is the mid of the published band.
const categories: { value: string; label: string; deposit: string; fee: string }[] = [
  { value: 'food-packaged', label: 'Alimentaire emballé (céréales, huile, épicerie sèche, condiments)', deposit: '50000', fee: '4' },
  { value: 'snacks', label: 'Snacks, fruits secs, spécialités', deposit: '50000', fee: '5' },
  { value: 'drinks', label: 'Café, flocons, poudres à boire', deposit: '50000', fee: '5' },
  { value: 'tea', label: 'Thé', deposit: '50000', fee: '2' },
  { value: 'supplements', label: 'Compléments alimentaires', deposit: '50000', fee: '4' },
  { value: 'tonics', label: 'Toniques traditionnels (nid d\'hirondelle et similaires)', deposit: '200000', fee: '5' },
  { value: 'alcohol', label: 'Alcools', deposit: '100000', fee: '5' },
  { value: 'skincare', label: 'Soins de la peau', deposit: '100000', fee: '5' },
  { value: 'makeup', label: 'Maquillage, parfums', deposit: '100000', fee: '5' },
  { value: 'beauty-device', label: 'Appareils de beauté et de soin', deposit: '100000', fee: '4' },
  { value: 'personal-care', label: 'Hygiène et soin personnel', deposit: '50000', fee: '4' },
  { value: 'home', label: 'Maison, linge de lit, art de la table', deposit: '50000', fee: '3' },
  { value: 'appliances', label: 'Petit électroménager', deposit: '75000', fee: '4' },
  { value: '3c', label: 'Accessoires 3C, appareils photo', deposit: '50000', fee: '4' },
  { value: 'phones', label: 'Téléphones, ordinateurs portables, tablettes', deposit: '100000', fee: '2.5' },
  { value: 'apparel', label: 'Vêtements, sous-vêtements', deposit: '100000', fee: '5' },
  { value: 'footwear', label: 'Chaussures', deposit: '100000', fee: '5' },
  { value: 'bags', label: 'Sacs, ceintures, accessoires', deposit: '100000', fee: '5' },
  { value: 'jewellery', label: 'Bijoux fantaisie', deposit: '100000', fee: '5.5' },
  { value: 'sports', label: 'Sport, plein air', deposit: '75000', fee: '5' },
  { value: 'infant-formula', label: 'Lait infantile', deposit: '100000', fee: '4' },
  { value: 'baby', label: 'Puériculture, jouets', deposit: '50000', fee: '5' },
  { value: 'pet', label: 'Alimentation et accessoires animaliers', deposit: '50000', fee: '5' },
  { value: 'custom', label: 'Personnalisé (saisir le dépôt et les frais à la main)', deposit: '', fee: '' },
];

const gicon = {
  tax: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  platform: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 18v3"/></svg>`,
  kol: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 15z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
  logistics: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h12v9H2z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>`,
  media: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4a1 1 0 0 0 1 1h2l9 5V4L6 9H4a1 1 0 0 0-1 1z"/><path d="M18 9a4 4 0 0 1 0 6"/></svg>`,
  margin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l3-4 3 2 4-6"/></svg>`,
};

const groups: { title: string; icon: string; note?: string; fields: Field[] }[] = [
  {
    title: 'Catégorie',
    icon: gicon.platform,
    note: 'Choisissez votre catégorie de produit. Sur 抖音全球购, le dépôt et les frais de service technique dépendent tous deux de la catégorie, ce qui règle les deux chiffres ci-dessous. Votre DP peut vous annoncer d\'autres montants ; corrigez-les à la main le cas échéant.',
    fields: [
      {
        id: 'category',
        label: 'Catégorie de produit (CBEC 抖音全球购)',
        value: 'food-packaged',
        kind: 'select',
        options: categories,
      },
    ],
  },
  {
    title: 'Change et taxes',
    icon: gicon.tax,
    fields: [
      { id: 'fx', label: 'Taux de change USD / RMB', value: '7.1', kind: 'number', step: '0.01', fx: true },
      { id: 'cbecTax', label: 'Taxe à l\'import cross-border (综合税)', value: '9.1', kind: 'percent', step: '0.1', hint: 'TVA de 13 % sur 70 % de la valeur de vente. La plupart des produits alimentaires et de maison ne portent pas de taxe à la consommation.' },
    ],
  },
  {
    title: 'Plateforme et DP',
    icon: gicon.platform,
    fields: [
      { id: 'platformDeposit', label: 'Dépôt plateforme Douyin 全球购', value: '50000', kind: 'money', hint: 'Remboursable à la fermeture de la boutique. Réglé par votre catégorie ci-dessus.' },
      { id: 'techFee', label: 'Frais de service technique de la plateforme', value: '4', kind: 'percent', step: '0.1', hint: 'Prélevés sur chaque vente. Réglés par votre catégorie ci-dessus.' },
      { id: 'agentFee', label: 'Frais annuels du 境内代理人 (agent local)', value: '60000', kind: 'money' },
      { id: 'trademark', label: 'Enregistrement de la marque en Chine', value: '0', kind: 'money' },
      { id: 'brandSetup', label: 'Contribution à la création de la boutique', value: '25000', kind: 'money' },
    ],
  },
  {
    title: 'Logistique',
    icon: gicon.logistics,
    fields: [
      { id: 'whDeposit', label: 'Dépôt entrepôt sous douane', value: '100000', kind: 'money' },
      { id: 'whTaxPrepay', label: 'Avance de taxe à l\'entrepôt sous douane', value: '300000', kind: 'money' },
      { id: 'storage', label: 'Stockage par unité et par mois', value: '0.8', kind: 'number', step: '0.1' },
      { id: 'shipping', label: 'Livraison du dernier kilomètre par colis', value: '11', kind: 'money' },
      { id: 'returnRate', label: 'Taux de retour', value: '5', kind: 'percent', step: '0.1' },
      { id: 'returnHandling', label: 'Traitement des retours par colis', value: '15', kind: 'money' },
    ],
  },
  {
    title: 'Votre rentabilité',
    icon: gicon.margin,
    note: 'Ajoutez votre marge brute par commande pour débloquer le résultat, le GMV de rentabilité et la contribution.',
    fields: [
      { id: 'grossMargin', label: 'Marge brute par commande', value: '75', kind: 'percent' },
    ],
  },
];

const steps = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 11h18M7 15h4"/></svg>`,
    title: 'Vous financez',
    body: 'Dépôts plateforme et entrepôt, marque, contenus de lancement. La mise de départ qui met la boutique en ligne.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>`,
    title: 'Le DP opère',
    body: 'Un Douyin Partner (DP) porte l\'équipe et pilote la boutique et les lives au quotidien.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4v10.5a3.5 3.5 0 1 1-3-3.46"/><path d="M9 4c.4 2.4 2.2 4.2 4.6 4.6"/></svg>`,
    title: 'Les créateurs vendent',
    body: 'Les KOL font le volume à la commission. Le média payant sur 千川 réchauffe l\'algorithme et remplit le live.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 2 5-6"/></svg>`,
    title: 'Vous mesurez',
    body: 'Le calculateur additionne chaque poste, sépare l\'investissement de départ des coûts récurrents et signale ce qui revient à la sortie.',
  },
];

const perks = [
  'Année 1 et année 2, côte à côte',
  'La structure de coûts complète, en RMB et USD',
  'Coût par commande face à votre panier moyen',
  'Dépôts remboursables face à la vraie dépense',
  'GMV de rentabilité selon votre marge',
];

// Plain-English explanation for every field, shown in the overlay bubble.
const help: Record<string, string> = {
  gmv: 'Le GMV (Gross Merchandise Value) correspond au chiffre d\'affaires total que vous attendez du canal Douyin sur ses douze premiers mois, avant le moindre coût. C\'est la ligne de tête à partir de laquelle tout le modèle se dimensionne. En cas de doute, partez d\'un objectif prudent et relevez-le une fois le canal éprouvé.',
  aov: 'Le montant moyen dépensé par un client sur une seule commande. Prenez le chiffre d\'affaires attendu la première année, divisez par le nombre de commandes et vous y êtes. Il détermine le nombre de colis expédiés, donc vos coûts de logistique et de retours.',
  paidShare:
    'La part de vos ventes portée par la publicité payante sur la régie de Douyin (千川 Qianchuan), plutôt que par la portée organique ou l\'audience propre d\'un créateur. Montez ce curseur et vous dépensez davantage en publicité pour atteindre le même chiffre.',
  dpRetainer:
    'Les honoraires mensuels fixes que votre Douyin Partner facture pour opérer le canal : la boutique, le calendrier des lives, la gestion des campagnes, le service client. Sur une année, c\'est souvent la ligne la plus lourde. Les honoraires vont d\'environ 30 000 RMB par mois pour une structure légère à 100 000 pour le niveau des marques internationales.',
  dpCommission:
    'Un pourcentage que le DP prélève sur les ventes qu\'il génère, en plus des honoraires. Le niveau des marques internationales se situe entre 5 et 8 %, et le secteur plafonne autour de 10 %. C\'est distinct du média payant que vous financez directement.',
  category:
    'Votre catégorie de produit sur la boutique cross-border (抖音全球购). Elle règle deux chiffres : le dépôt plateforme et les frais de service technique, qui varient tous deux selon la catégorie. Choisissez la plus proche et les champs ci-dessous se remplissent. Sélectionnez Personnalisé pour saisir les vôtres.',
  kolCommission:
    'La part qu\'un animateur de live ou un créateur de vidéos courtes conserve sur chaque vente qu\'il génère. C\'est de la pure commission, versée seulement quand il vend vraiment. L\'alimentaire et les produits agricoles tournent autour de 8 à 20 % ; la beauté et le luxe montent plus haut.',
  roas:
    'Le ROAS (Return On Ad Spend) est le rapport entre les ventes et la dépense publicitaire. Un ROAS de 1,5 signifie que chaque RMB de publicité rapporte 1,5 RMB de ventes. Un compte Douyin récent démarre bas les premiers mois, puis grimpe à mesure que l\'algorithme apprend à qui vous montrer. Indiquez la valeur que vous attendez en moyenne sur la première année.',
  fx: 'Combien de RMB s\'achètent avec un dollar américain. Cela n\'agit que sur le montant en USD affiché à la fin ; tous les calculs tournent en RMB. Utilisez le bouton pour récupérer le taux du jour.',
  cbecTax:
    'La taxe à l\'importation du e-commerce transfrontalier sur les produits vendus en régime sous douane. C\'est une TVA de 13 % appliquée à 70 % du prix de vente, soit 9,1 % des ventes pour la plupart des produits alimentaires et de maison, qui ne portent pas de taxe à la consommation. Cosmétiques, parfums et alcools déclenchent la taxe à la consommation et montent plus haut, autour de 23 %.',
  platformDeposit:
    'Un dépôt de garantie que Douyin conserve tant que votre boutique est ouverte, restitué à la fermeture en règle. La base cross-border est de 50 000 RMB, et certaines catégories vont jusqu\'à 100 000 ou 200 000. Le sélecteur de catégorie le règle pour vous.',
  techFee:
    'Des frais de service technique que Douyin prélève sur chaque vente, sous forme d\'une part du GMV. Ils vont d\'environ 2 à 6 % selon la catégorie. Le sélecteur de catégorie les règle pour vous.',
  agentFee:
    'Les frais annuels d\'un agent douanier local (境内代理人), l\'entité chinoise agréée qui doit dédouaner les colis transfrontaliers en votre nom. C\'est un coût annuel fixe, indépendant de votre volume de ventes.',
  trademark:
    'Un coût unique pour déposer votre marque en Chine, dans la classe concernée. Le faire tôt protège le nom avant que quelqu\'un d\'autre ne le revendique. Environ 8 000 RMB pour une seule classe.',
  brandSetup:
    'Le coût initial pour construire la boutique et ses contenus de lancement : bannière, fiches produits, une séance photo ou vidéo phare. Payé une seule fois, au démarrage.',
  coFund:
    'Un fonds commun annuel qui s\'ajoute aux honoraires du DP, réservé aux grands rendez-vous : Double 11, un lancement de marque, une campagne phare. Il finance le travail qui sort du quotidien déjà couvert par les honoraires.',
  kolShare:
    'La part des ventes totales qui passe par les créateurs (lives et vidéos courtes), plutôt que par votre propre page boutique ou vos publicités. Elle détermine le montant de commission KOL que vous finissez par payer.',
  organicShare:
    'Les ventes qui arrivent sans publicité payante ni commission de créateur : votre propre page boutique, la recherche, vos abonnés, les repartages. C\'est ce qui reste après le média payant et les KOL. Une part organique qui grimpe, c\'est ce qui rend l\'année 2 moins chère que l\'année 1.',
  whDeposit:
    'Un dépôt remboursable que l\'entrepôt sous douane conserve comme fonds de roulement pendant que vos marchandises y sont stockées. Vous le récupérez à la sortie : il est recouvrable, pas perdu.',
  whTaxPrepay:
    'Une somme versée d\'avance à l\'entrepôt sous douane pour couvrir la taxe à l\'importation au fur et à mesure du dédouanement. Elle se consomme à l\'entrée des marchandises en Chine, donc traitez-la comme de l\'argent que vous récupérez plus tard, pas comme une dépense.',
  storage:
    'Ce que l\'entrepôt sous douane facture pour stocker une unité pendant un mois. Multiplié par votre volume de commandes et une durée moyenne de séjour de deux mois, cela devient votre facture de stockage.',
  shipping:
    'Le coût de livraison du dernier kilomètre par colis, de l\'entrepôt sous douane jusqu\'à la porte du client. Multipliez par le nombre de commandes pour obtenir la facture annuelle d\'expédition.',
  returnRate:
    'La part des commandes qui reviennent. Les retours en alimentaire et en cross-border sont en général faibles, autour de cinq pour cent. Chaque retour porte un coût de traitement.',
  returnHandling:
    'Ce que coûte le traitement d\'un colis retourné : contrôle, puis remise en stock ou destruction. Multiplié par votre taux de retour et votre volume de commandes.',
  grossMargin:
    'Votre marge brute sur une seule commande : la part du prix de vente qui reste après le coût produit, mais avant les coûts du canal Douyin dans ce modèle. Le même pourcentage s\'applique à chaque commande. Renseignez-la pour débloquer le résultat des années 1 et 2, le GMV de rentabilité et votre contribution.',
};

const notes = [
  'Le modèle tourne uniquement en cross-border, via l\'entrepôt sous douane (抖音全球购). Le dépôt d\'entrepôt et l\'avance de taxe vous reviennent à la sortie, donc le calculateur les compte comme de l\'argent que vous récupérez, pas comme une dépense.',
  'Les honoraires du DP et sa commission sur le GMV forment l\'une des lignes les plus lourdes, à égalité avec le média payant. Le média payant sur 千川, c\'est vous qui l\'alimentez directement dans le compte publicitaire, il ne transite pas par le DP. Ce partage est voulu : les DP qui essaient d\'avancer le budget publicitaire finissent par caler.',
  'Le DP opère Douyin, rien d\'autre. Le coût de son équipe est déjà inclus dans les honoraires et la commission, il n\'y a donc pas de ligne de personnel à part. La commission KOL est facturée séparément, sur les ventes que les créateurs génèrent réellement.',
  'Ici, le ROAS est un seul chiffre : celui que vous attendez en moyenne sur la première année. Un compte Douyin récent démarre bas les premiers mois, puis grimpe une fois que l\'algorithme apprend à qui vous montrer ; visez donc une valeur mélangée plutôt qu\'un scénario idéal.',
  'Le dépôt plateforme et les frais de service technique dépendent de votre catégorie de produit. Choisissez une catégorie dans le panneau de réglage et les deux se remplissent à partir des barèmes cross-border publiés.',
  'L\'année 1 se solde en général par une perte à 2 M de RMB de GMV. Le tableau oppose l\'année 1 à l\'année 2, quand l\'investissement de départ disparaît. Le GMV de rentabilité indique l\'échelle nécessaire pour que la marge brute couvre la facture, et il se situe souvent à plusieurs fois un objectif de première année.',
];

const refreshIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>`;
---

<Layout
  title="Calculateur de coûts Douyin cross-border | TheChinaPath"
  description="Estimez ce que coûtent le lancement et l'exploitation d'un canal Douyin cross-border en Chine via un Douyin Partner. Fonctionne pour toute catégorie de produit. Logistique sous douane, commission KOL, média payant, taxes et frais de plateforme, en RMB et USD."
>
  <section
    class="tool-hero tool-hero--image"
    style="--tool-hero-img: url('/Images/tools/douyin-hero-bg.png')"
  >
    <div class="container tool-hero__inner">
      <nav class="tool-hero__crumbs" aria-label="Fil d'Ariane">
        <a href="/fr">Accueil</a>
        <span aria-hidden="true">/</span>
        <span>Calculateurs</span>
        <span aria-hidden="true">/</span>
        <span>Coût Douyin cross-border</span>
      </nav>
      <span class="eyebrow">Calculateur de coûts</span>
      <h1 class="tool-hero__title">Ce qu'un canal Douyin cross-border coûte <em>vraiment</em>.</h1>
      <p class="tool-hero__lead">
        Modélisez le coût complet de la première année de vente sur Douyin via un Douyin Partner (DP),
        en régime cross-border sous douane (抖音全球购). Fonctionne pour toute catégorie de produit.
      </p>
      <div class="tool-hero__meta">
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">Années 1 + 2</span>
          <span class="tool-hero__meta-label">la structure de coûts, côte à côte</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">RMB + USD</span>
          <span class="tool-hero__meta-label">toute la structure de coûts, dans les deux devises</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">En direct</span>
          <span class="tool-hero__meta-label">chaque hypothèse est modifiable</span>
        </div>
      </div>
      <a href="#calculator" class="tool-hero__scroll">
        <span>Lancer le calcul</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
      </a>
    </div>
  </section>

  {/* ---------- How it works ---------- */}
  <section class="section calc-how">
    <div class="container">
      <div class="calc-how__head reveal">
        <span class="eyebrow">Comment fonctionne le modèle</span>
        <h2 class="calc-how__title">Quatre rouages, un seul chiffre pour la première année.</h2>
      </div>
      <ol class="calc-flow">
        {
          steps.map((s, idx) => (
            <li class="calc-flow__step reveal" style={`--i:${idx}`}>
              <span class="calc-flow__icon" set:html={s.icon} />
              <h3 class="calc-flow__step-title">{s.title}</h3>
              <p class="calc-flow__step-body">{s.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="calc-perks reveal">
        <span class="calc-perks__label">Ce que vous obtenez</span>
        <ul class="calc-perks__list">
          {
            perks.map((p) => (
              <li class="calc-perks__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8" /></svg>
                {p}
              </li>
            ))
