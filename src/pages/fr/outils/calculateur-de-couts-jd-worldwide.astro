---
import Layout from '../../../layouts/Layout.astro';

// ---- Key drivers, shown as sliders at the top of the calculator ----
type Driver = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number';
  min: string;
  max: string;
  step: string;
  hint?: string;
};

const drivers: Driver[] = [
  { id: 'gmv', label: 'GMV visé (année 1)', value: '3500000', kind: 'money', min: '200000', max: '10000000', step: '100000' },
  { id: 'aov', label: 'Panier moyen', value: '250', kind: 'money', min: '20', max: '2000', step: '5' },
  { id: 'gmvGrowth', label: 'Croissance du GMV en année 2', value: '50', kind: 'percent', min: '0', max: '200', step: '5' },
  { id: 'dpRetainer', label: 'Honoraires mensuels du TP', value: '35000', kind: 'money', min: '0', max: '200000', step: '5000' },
  { id: 'coFund', label: 'Cofinancement de campagne', value: '0', kind: 'money', min: '0', max: '500000', step: '10000' },
  { id: 'dpCommission', label: 'Commission du TP sur le GMV', value: '10', kind: 'percent', min: '0', max: '20', step: '0.5' },
  { id: 'paidShare', label: 'Média payant', value: '60', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolShare', label: 'KOL et live', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'organicShare', label: 'Organique', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolCommission', label: 'Taux de commission KOL', value: '20', kind: 'percent', min: '0', max: '40', step: '1' },
  { id: 'roas', label: 'ROAS (retour sur dépense publicitaire)', value: '2', kind: 'number', min: '0.5', max: '8', step: '0.1' },
];

// The three channel shares are grouped together and must always total 100%.
const shareIds = ['paidShare', 'kolShare', 'organicShare'];
const mainDrivers = drivers.filter((d) => !shareIds.includes(d.id));
const shareDrivers = drivers.filter((d) => shareIds.includes(d.id));

// Year 2 carries its own mix: organic normally climbs once the store has
// reviews and repeat buyers, which is what makes the second year cheaper to run.
const shareDrivers2: Driver[] = [
  { id: 'paidShare2', label: 'Média payant', value: '50', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolShare2', label: 'KOL et live', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'organicShare2', label: 'Organique', value: '30', kind: 'percent', min: '0', max: '100', step: '1' },
];
const mixRows = [
  { year: '1', title: 'Année 1', drivers: shareDrivers, noteId: 'mix-note' },
  { year: '2', title: 'Année 2', drivers: shareDrivers2, noteId: 'mix-note-2' },
];

// ---- Advanced inputs, grouped in the collapsible section ----
type Field = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number' | 'select';
  step?: string;
  hint?: string;
  fx?: boolean;
  readonly?: boolean;
  suffix?: string;
  options?: { value: string; label: string; deposit?: string; fee?: string; annual?: string }[];
};

// JD Worldwide (京东全球购) categories. Each one sets the security deposit and the
// platform commission (运营支持服务费, 2%-6% band) that move with the product
// category. JD quotes the deposit in a TIERED USD ladder that steps up with
// cumulative sales; the RMB figures here seed the entry tier at about 7.1 to the
// dollar (US$5,000 for most categories, US$2,000 for fresh, US$15,000 for
// high-value electronics, US$40,000 for pharma). The annual platform usage fee
// is a flat US$1,000. Directional 2025 bands; confirm the exact rate at onboarding.
const categories: { value: string; label: string; deposit: string; fee: string; annual: string }[] = [
  { value: 'fresh', label: 'Produits frais (生鲜)', deposit: '14200', fee: '4', annual: '7100' },
  { value: 'food', label: 'Alimentaire emballé (céréales, huile, snacks)', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'tea', label: 'Thé et poudres à boire', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'alcohol', label: 'Alcools', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'supplements', label: 'Compléments alimentaires', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'baby', label: 'Puériculture et lait infantile', deposit: '35500', fee: '3', annual: '7100' },
  { value: 'skincare', label: 'Soins de la peau', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'makeup', label: 'Maquillage et parfums', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'personal-care', label: 'Hygiène et soin personnel', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'apparel', label: 'Vêtements', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'footwear', label: 'Chaussures', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'bags', label: 'Sacs et bagagerie', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'jewellery', label: 'Bijoux fantaisie', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'watches', label: 'Horlogerie (palier de dépôt supérieur)', deposit: '106500', fee: '5', annual: '7100' },
  { value: '3c', label: 'Accessoires 3C et électronique', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'phones', label: 'Téléphones et ordinateurs (palier de dépôt supérieur)', deposit: '106500', fee: '3', annual: '7100' },
  { value: 'home', label: 'Maison, cuisine, art de la table', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'appliances', label: 'Petit électroménager', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'sports', label: 'Sport et plein air', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'pet', label: 'Alimentation et accessoires animaliers', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'pharma', label: 'Pharmacie (医药, palier de dépôt maximal)', deposit: '284000', fee: '5', annual: '7100' },
  { value: 'custom', label: 'Personnalisé (saisir le dépôt et la commission à la main)', deposit: '', fee: '', annual: '' },
];

const gicon = {
  tax: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  platform: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 18v3"/></svg>`,
  kol: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 15z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
  logistics: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h12v9H2z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>`,
  media: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4a1 1 0 0 0 1 1h2l9 5V4L6 9H4a1 1 0 0 0-1 1z"/><path d="M18 9a4 4 0 0 1 0 6"/></svg>`,
  margin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l3-4 3 2 4-6"/></svg>`,
};

const groups: { title: string; icon: string; note?: string; fields: Field[] }[] = [
  {
    title: 'Catégorie',
    icon: gicon.platform,
    note: 'Choisissez votre catégorie de produit. Sur JD Worldwide, le dépôt de garantie et la commission de plateforme dépendent tous deux de la catégorie : ce choix règle donc les deux chiffres ci-dessous. Le dépôt suit des paliers libellés en dollars, et le montant en RMB affiché correspond au premier palier. Votre TP peut vous annoncer d\'autres montants ; corrigez-les à la main le cas échéant.',
    fields: [
      {
        id: 'category',
        label: 'Catégorie de produit (京东全球购)',
        value: 'food',
        kind: 'select',
        options: categories,
      },
    ],
  },
  {
    title: 'Change et taxes',
    icon: gicon.tax,
    fields: [
      { id: 'fx', label: 'Taux de change USD / RMB', value: '7.1', kind: 'number', step: '0.01', fx: true },
      { id: 'cbecTax', label: 'Taxe à l\'import cross-border (综合税)', value: '9.1', kind: 'percent', step: '0.1', hint: 'TVA de 13 % sur 70 % de la valeur de vente, soit 9,1 % pour les produits courants. Cosmétiques, parfums et alcools portent en plus la taxe à la consommation et montent plus haut.' },
      { id: 'cbecTaxPayer', label: 'Qui supporte la taxe', value: 'consumer', kind: 'select', options: [ { value: 'consumer', label: 'Le client la paie, en plus du prix' }, { value: 'brand', label: 'La marque l\'absorbe' } ] },
    ],
  },
  {
    title: 'Plateforme et TP',
    icon: gicon.platform,
    fields: [
      { id: 'period', label: 'Durée de la mission', value: '12', kind: 'number', readonly: true, suffix: 'mois', hint: 'Valeur fixe. Le modèle chiffre douze mois pleins, et tous les montants annuels suivent cette fenêtre.' },
      { id: 'platformDeposit', label: 'Dépôt de garantie JD Worldwide', value: '35500', kind: 'money', hint: 'Remboursable, libellé en dollars et relevé par paliers à mesure que les ventes cumulées montent. Le premier palier tourne autour de 5 000 USD pour la plupart des catégories, 2 000 USD pour le frais, davantage pour les produits à forte valeur. Réglé par votre catégorie ci-dessus.' },
      { id: 'techFee', label: 'Commission de plateforme (运营支持服务费)', value: '4', kind: 'percent', step: '0.1', hint: 'Prélevée sur chaque vente, dans une fourchette de 2 à 6 % selon la catégorie. Réglée par votre catégorie ci-dessus.' },
      { id: 'paymentFee', label: 'Frais de transaction (交易服务费)', value: '0.9', kind: 'percent', step: '0.1', hint: 'Un forfait de 0,9 % par commande sur JD Worldwide, toutes catégories confondues.' },
      { id: 'annualFee', label: 'Frais d\'utilisation de la plateforme (平台使用费)', value: '7100', kind: 'money', hint: 'Environ 1 000 USD par an, montant fixe. Certaines catégories bénéficient d\'une période d\'essai gratuite : vérifiez la vôtre à l\'ouverture du compte.' },
      { id: 'agentFee', label: 'Agent en douane, coût annuel', value: '0', kind: 'money', hint: 'Facultatif. Beaucoup de marques laissent le TP ou l\'entrepôt gérer le dédouanement : laissez à zéro sauf si vous mandatez un 境内代理人 distinct.' },
      { id: 'trademark', label: 'Enregistrement de la marque en Chine', value: '0', kind: 'money' },
      { id: 'brandSetup', label: 'Création de la boutique et contenus de lancement', value: '25000', kind: 'money' },
    ],
  },
  {
    title: 'Logistique',
    icon: gicon.logistics,
    fields: [
      { id: 'whDeposit', label: 'Dépôt entrepôt sous douane', value: '100000', kind: 'money' },
      { id: 'whTaxPrepay', label: 'Avance de taxe à l\'entrepôt sous douane', value: '300000', kind: 'money' },
      { id: 'storage', label: 'Stockage par unité et par mois', value: '0.8', kind: 'number', step: '0.1' },
      { id: 'fulfillment', label: 'Préparation par commande (picking et emballage)', value: '4', kind: 'money', step: '0.5' },
      { id: 'shipping', label: 'Livraison du dernier kilomètre par colis', value: '11', kind: 'money' },
      { id: 'returnRate', label: 'Taux de retour', value: '5', kind: 'percent', step: '0.1' },
      { id: 'returnHandling', label: 'Traitement des retours par colis', value: '15', kind: 'money' },
    ],
  },
  {
    title: 'Votre rentabilité',
    icon: gicon.margin,
    note: 'Ajoutez votre marge brute par commande pour débloquer le résultat des deux années et votre GMV de rentabilité. La création de la boutique et le dépôt de marque s\'amortissent sur la durée réglée ci-dessous ; les dépôts remboursables, eux, ne touchent jamais le compte de résultat.',
    fields: [
      { id: 'grossMargin', label: 'Marge brute par commande', value: '75', kind: 'percent' },
      { id: 'amortYears', label: 'Durée d\'amortissement de l\'investissement de départ', value: '3', kind: 'number', step: '1', suffix: 'ans', hint: 'La création de la boutique et le dépôt de marque s\'amortissent en parts égales sur ce nombre d\'années. Trois ans est la convention la plus courante.' },
    ],
  },
];

const steps = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 11h18M7 15h4"/></svg>`,
    title: 'Vous financez',
    body: 'Dépôts plateforme et entrepôt, marque, contenus de lancement. La mise de départ qui met la boutique en ligne.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>`,
    title: 'Le TP opère',
    body: 'Un partenaire (TP) porte l\'équipe et pilote la boutique JD Worldwide au quotidien, contre des honoraires mensuels fixes et une commission sur les ventes.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 15z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
    title: 'Le trafic vend',
    body: 'Le search et le display payants (JD 快车) remplissent la boutique. Les lives et les KOL font du volume par-dessus, à la commission.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 2 5-6"/></svg>`,
    title: 'Vous mesurez',
    body: 'Le calculateur additionne chaque poste, sépare l\'investissement de départ des coûts récurrents et signale ce qui revient à la sortie.',
  },
];

const perks = [
  'Année 1 et année 2, côte à côte',
  'La structure de coûts complète, en RMB et USD',
  'Dépôt et commission selon la catégorie',
  'Dépôts remboursables face à la vraie dépense',
  'GMV de rentabilité selon votre marge',
];

// Plain-English explanation for every field, shown in the overlay bubble.
const help: Record<string, string> = {
  gmv: 'Le GMV (Gross Merchandise Value) correspond au chiffre d\'affaires total que vous attendez de la boutique JD Worldwide sur ses douze premiers mois, avant le moindre coût. C\'est la ligne de tête à partir de laquelle tout le modèle se dimensionne. En cas de doute, partez d\'un objectif prudent et relevez-le une fois la boutique éprouvée.',
  aov: 'Le montant moyen dépensé par un client sur une seule commande. Prenez le chiffre d\'affaires attendu la première année, divisez par le nombre de commandes et vous y êtes. Il détermine le nombre de colis expédiés, donc vos coûts de préparation, de livraison et de retours.',
  paidShare:
    'La part de vos ventes portée par la publicité payante, les outils de search et de display de JD (JD 快车), plutôt que par la portée organique ou par un créateur. Montez ce curseur et vous dépensez davantage en publicité pour atteindre le même chiffre.',
  dpRetainer:
    'Les honoraires mensuels fixes que votre partenaire (TP) facture pour opérer la boutique : la vitrine, le calendrier des campagnes, la gestion publicitaire, le service client. C\'est en général la plus lourde des lignes fixes. Pour une marque internationale sérieuse, comptez environ 35 000 RMB par mois, davantage pour une structure plus étoffée.',
  dpCommission:
    'Un pourcentage que le partenaire prélève sur les ventes qu\'il génère, en plus des honoraires. Dix pour cent est un niveau courant. C\'est distinct du média payant que vous financez directement sur le compte publicitaire.',
  category:
    'Votre catégorie de produit sur JD Worldwide (京东全球购). Elle règle deux chiffres qui varient selon la catégorie : le dépôt de garantie et la commission de plateforme (运营支持服务费). Choisissez la plus proche et les champs ci-dessous se remplissent. Sélectionnez Personnalisé pour saisir les vôtres.',
  kolCommission:
    'La part qu\'un animateur de live ou un créateur de vidéos courtes conserve sur chaque vente qu\'il génère. C\'est de la pure commission, versée seulement quand il vend vraiment. L\'alimentaire et les produits du quotidien tournent autour de 8 à 20 % ; la beauté et le luxe montent plus haut.',
  roas:
    'Le ROAS (Return On Ad Spend) est le rapport entre les ventes et la dépense publicitaire. Un ROAS de 2 signifie que chaque RMB de publicité rapporte 2 RMB de ventes. La règle empirique du secteur en Chine, c\'est 1 divisé par votre marge brute : à 50 % de marge, il vous faut déjà 2 pour couvrir l\'économie du produit, et les catégories à marge plus fine en demandent davantage. Le search payant de JD monte en régime plus vite qu\'un compte social parti de zéro, puisque le client arrive avec une intention d\'achat. Indiquez la valeur que vous attendez en moyenne sur la première année.',
  fx: 'Combien de RMB s\'achètent avec un dollar américain. Cela n\'agit que sur le montant en USD affiché à la fin ; tous les calculs tournent en RMB. Utilisez le bouton pour récupérer le taux du jour.',
  cbecTax:
    'La taxe globale à l\'importation du e-commerce transfrontalier, une TVA à l\'import dans les faits, sur les produits vendus en régime sous douane. C\'est une TVA de 13 % appliquée à 70 % du prix de vente, soit 9,1 % des ventes pour les produits courants qui ne portent pas de taxe à la consommation. Cosmétiques, parfums et alcools la déclenchent et montent plus haut.',
  cbecTaxPayer:
    'Qui absorbe la taxe cross-border. Dans la plupart des boutiques officielles, le client la paie au moment du paiement, en plus du prix affiché : elle ne vous coûte donc rien et le modèle la laisse de côté. Basculez sur « la marque l\'absorbe » et le calculateur la prélève directement sur votre ligne.',
  platformDeposit:
    'Un dépôt de garantie remboursable que JD Worldwide conserve tant que votre boutique est ouverte, restitué à la fermeture en règle. Il suit des paliers libellés en dollars, qui montent avec les ventes cumulées. Le premier palier tourne autour de 5 000 USD pour la plupart des catégories, 2 000 USD pour le frais, davantage pour les produits à forte valeur et la pharmacie. Le sélecteur de catégorie règle le montant d\'entrée en RMB.',
  techFee:
    'La commission de plateforme (运营支持服务费) que JD Worldwide prélève sur chaque vente, sous forme d\'une part du GMV. Elle va de 2 à 6 % selon la catégorie. Elle est distincte des frais de transaction de 0,9 %. Le sélecteur de catégorie la règle pour vous.',
  paymentFee:
    'Les frais de service sur transaction (交易服务费) appliqués à chaque commande, un forfait de 0,9 % du GMV sur JD Worldwide.',
  annualFee:
    'Les frais annuels d\'utilisation de la plateforme (平台使用费) que JD Worldwide facture, que vous vendiez ou non. Ils tournent autour de 1 000 USD, la valeur par défaut en RMB est donc calée sur le taux de change. Certaines catégories bénéficient d\'une période d\'essai gratuite : vérifiez la vôtre à l\'ouverture du compte.',
  agentFee:
    'Des frais annuels facultatifs pour un agent en douane en Chine continentale (境内代理人). Sur la boutique officielle en régime sous douane, le TP ou l\'entrepôt gère souvent le dédouanement, et beaucoup de marques laissent donc cette ligne à zéro. Ne saisissez un montant que si vous mandatez un agent distinct.',
  trademark:
    'Un coût unique pour déposer votre marque en Chine, dans la classe concernée. Le faire tôt protège le nom avant que quelqu\'un d\'autre ne le revendique. Environ 8 000 RMB pour une seule classe.',
  brandSetup:
    'Le coût initial pour construire la boutique et ses contenus de lancement : bannière, fiches produits, une séance photo ou vidéo phare. Payé une seule fois, au démarrage.',
  coFund:
    'Un fonds commun annuel qui s\'ajoute aux honoraires du TP, réservé aux grands rendez-vous : Double 11, un lancement de marque, une campagne phare. Il finance le travail qui sort du quotidien déjà couvert par les honoraires.',
  kolShare:
    'La part des ventes totales qui passe par les créateurs (lives et vidéos courtes), plutôt que par votre page boutique ou le search payant. Elle détermine le montant de commission KOL que vous finissez par payer.',
  organicShare:
    'Les ventes qui arrivent sans publicité payante ni commission de créateur : votre page boutique, la recherche, vos abonnés, les clients qui reviennent. C\'est ce qui reste après le média payant et les KOL. Une part organique qui grimpe, c\'est ce qui rend l\'année 2 moins chère que l\'année 1.',
  gmvGrowth:
    'Ce que la boutique vend en plus l\'année 2 par rapport à l\'année 1. Une boutique qui passe le cap de la première année capitalise : elle a des avis, des abonnés, des clients fidèles, et son poids dans le moteur de recherche de JD s\'améliore. 50 % est une hypothèse raisonnable pour une boutique qui a trouvé son rythme ; réglez sur zéro pour modéliser une année 2 identique à l\'année 1. Tous les coûts liés aux ventes de la colonne année 2 se dimensionnent dessus.',
  paidShare2:
    'La part des ventes de l\'année 2 portée par la publicité payante. À ce stade, la boutique a un historique, des avis et une audience : beaucoup de marques maintiennent ou allègent cette ligne pendant que l\'organique prend le relais.',
  kolShare2:
    'La part des ventes de l\'année 2 qui passe par les créateurs. La plupart des marques gardent les lives et les KOL dans le dispositif, mais leur poids recule à mesure que la page boutique et les clients fidèles vendent d\'eux-mêmes.',
  organicShare2:
    'La part de l\'année 2 qui arrive sans dépense publicitaire ni commission de créateur : page boutique, recherche interne à JD, abonnés, clients fidèles. C\'est le chiffre qui doit grimper, et la principale raison pour laquelle l\'année 2 coûte moins cher que l\'année 1.',
  period:
    'Le modèle repose sur une mission de douze mois. L\'objectif de GMV, les honoraires du TP, les frais de plateforme et le cofinancement couvrent tous une année pleine, et l\'année 2 affichée dans les résultats reprend les mêmes douze mois sans l\'investissement de départ. Le champ figure ici pour rendre l\'hypothèse explicite ; il n\'est pas modifiable.',
  whDeposit:
    'Un dépôt remboursable que l\'entrepôt sous douane conserve comme fonds de roulement pendant que vos marchandises y sont stockées. Vous le récupérez à la sortie : il est recouvrable, pas perdu.',
  whTaxPrepay:
    'Une somme versée d\'avance à l\'entrepôt sous douane pour couvrir la taxe à l\'importation au fur et à mesure du dédouanement. Elle se consomme à l\'entrée des marchandises en Chine, donc traitez-la comme de l\'argent que vous récupérez plus tard, pas comme une dépense.',
  storage:
    'Ce que l\'entrepôt sous douane facture pour stocker une unité pendant un mois. Multiplié par votre volume de commandes et une durée moyenne de séjour de deux mois, cela devient votre facture de stockage.',
  fulfillment:
    'Le coût de picking, d\'emballage et de manutention d\'une commande à l\'intérieur de l\'entrepôt sous douane, avant l\'expédition. C\'est distinct de la livraison du dernier kilomètre ci-dessous. Multipliez par le nombre de commandes pour obtenir la facture annuelle de préparation.',
  shipping:
    'Le coût de livraison du dernier kilomètre par colis, de l\'entrepôt sous douane jusqu\'à la porte du client. Multipliez par le nombre de commandes pour obtenir la facture annuelle d\'expédition. Il s\'ajoute aux frais de préparation.',
  returnRate:
    'La part des commandes qui reviennent. Les retours en cross-border sont en général faibles, autour de cinq pour cent. Chaque retour porte un coût de traitement.',
  returnHandling:
    'Ce que coûte le traitement d\'un colis retourné : contrôle, puis remise en stock ou destruction. Multiplié par votre taux de retour et votre volume de commandes.',
  grossMargin:
    'Votre marge brute sur une seule commande : la part du prix de vente qui reste après le coût produit, mais avant les coûts du canal dans ce modèle. Le même pourcentage s\'applique à chaque commande. Renseignez-la pour débloquer le résultat des deux années et votre GMV de rentabilité.',
  amortYears:
    'Le nombre d\'années sur lequel l\'investissement de départ est amorti. La création de la boutique et le dépôt de marque sont de vraies dépenses, mais la comptabilité les étale sur les années où elles produisent leurs effets plutôt que de faire porter toute la facture à l\'année 1. Trois ans est la convention habituelle pour ce type d\'investissement. Les dépôts et l\'avance de taxe n\'entrent pas dans ce chiffre : vous les récupérez, ce sont donc des fonds de roulement, pas un coût.',
};

const notes = [
  'L\'investissement de départ se paie une fois, mais il ne pèse pas entièrement sur l\'année 1. La création de la boutique et le dépôt de marque s\'amortissent sur la durée que vous réglez : chaque année en porte sa part, et le résultat d\'exploitation n\'est pas écrasé par une facture dont la boutique profitera pendant des années. Les dépôts et l\'avance de taxe, c\'est autre chose : vous les récupérez à la sortie, ce sont des fonds de roulement et ils n\'atteignent jamais le compte de résultat. D\'où l\'écart entre la colonne trésorerie et la colonne résultat. Les deux sont justes.',
  'Le modèle tourne uniquement en cross-border, via l\'entrepôt sous douane (京东全球购). Le dépôt d\'entrepôt et l\'avance de taxe vous reviennent à la sortie, donc le calculateur les compte comme de l\'argent que vous récupérez, pas comme une dépense.',
  'Les honoraires du TP et sa commission sur le GMV forment l\'une des lignes les plus lourdes, à égalité avec le média payant. Le média payant, c\'est vous qui l\'alimentez directement dans le compte publicitaire, il ne transite pas par le TP. Ce partage est voulu : les partenaires qui essaient d\'avancer le budget publicitaire finissent par caler.',
  'JD Worldwide facture deux lignes distinctes sur chaque vente : la commission de plateforme (运营支持服务费), de 2 à 6 % selon la catégorie, et un forfait de 0,9 % de frais de transaction (交易服务费). Les deux figurent dans le modèle. Les frais annuels d\'utilisation de la plateforme tournent autour de 1 000 USD, convertis au taux du jour.',
  'Le dépôt de garantie suit des paliers libellés en dollars, qui montent avec les ventes cumulées. La plupart des catégories démarrent près de 5 000 USD, les produits frais près de 2 000 USD, l\'électronique de valeur et la pharmacie plus haut. Le sélecteur de catégorie cale le premier palier en RMB. Comme il est remboursable, il reste à l\'écart du calcul de résultat, au titre du fonds de roulement.',
  'La taxe cross-border représente 9,1 % des ventes pour les produits courants : une TVA de 13 % appliquée à 70 % du prix. Dans la plupart des boutiques, le client la paie au moment du paiement, elle est donc exclue de vos coûts par défaut. Basculez le payeur sur la marque si vous l\'absorbez, et gardez en tête que cosmétiques, parfums et alcools montent plus haut.',
  'À 3,5 M de RMB de GMV, l\'année 1 se solde en général par une perte. Le tableau oppose l\'année 1 à l\'année 2, quand l\'investissement de départ disparaît, que la répartition des canaux bascule sur vos curseurs année 2 et que le GMV progresse selon votre hypothèse de croissance. Le GMV de rentabilité indique l\'échelle nécessaire pour que la marge brute couvre la facture, et il se situe souvent à plusieurs fois un objectif de première année.',
];

const refreshIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>`;
---

<Layout
  title="Calculateur de coûts JD Worldwide | TheChinaPath"
  description="Chiffrez le coût réel d'une boutique JD Worldwide en Chine : dépôt et commission selon la catégorie, frais de transaction, honoraires du TP, logistique sous douane, média payant et taxe cross-border. Résultat en RMB et en USD."
>
  <section
    class="tool-hero tool-hero--image"
    style="--tool-hero-img: url('/Images/tools/tmall-jd-hero-bg.png')"
  >
    <div class="container tool-hero__inner">
      <nav class="tool-hero__crumbs" aria-label="Fil d'Ariane">
        <a href="/fr">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href="/fr/outils">Calculateurs</a>
        <span aria-hidden="true">/</span>
        <span>Coût d'une boutique JD Worldwide</span>
      </nav>
      <span class="eyebrow">Calculateur de coûts</span>
      <h1 class="tool-hero__title">Ce qu'une boutique JD Worldwide coûte <em>vraiment</em>.</h1>
      <p class="tool-hero__lead">
        Modélisez ce que coûte une boutique JD Worldwide opérée par un partenaire (TP), en régime
        cross-border sous douane (京东全球购), sur vos deux premières années. Le dépôt par paliers
        et la commission varient selon votre catégorie.
      </p>
      <div class="tool-hero__meta">
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">Années 1 + 2</span>
          <span class="tool-hero__meta-label">la structure de coûts, côte à côte</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">RMB + USD</span>
          <span class="tool-hero__meta-label">toute la structure de coûts, dans les deux devises</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">En direct</span>
          <span class="tool-hero__meta-label">chaque hypothèse est modifiable</span>
        </div>
      </div>
      <a href="#calculator" class="tool-hero__scroll">
        <span>Lancer le calcul</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
      </a>
    </div>
  </section>

  {/* ---------- How it works ---------- */}
  <section class="section calc-how">
    <div class="container">
      <div class="calc-how__head reveal">
        <span class="eyebrow">Comment fonctionne le modèle</span>
        <h2 class="calc-how__title">Quatre rouages, deux années de coûts.</h2>
      </div>
      <ol class="calc-flow">
        {
          steps.map((s, idx) => (
            <li class="calc-flow__step reveal" style={`--i:${idx}`}>
              <span class="calc-flow__icon" set:html={s.icon} />
              <h3 class="calc-flow__step-title">{s.title}</h3>
              <p class="calc-flow__step-body">{s.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="calc-perks reveal">
        <span class="calc-perks__label">Ce que vous obtenez</span>
        <ul class="calc-perks__list">
          {
            perks.map((p) => (
              <li class="calc-perks__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8" /></svg>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- Calculator ---------- */}
  <section class="section section--alt calc" id="calculator">
    <div class="container">
      <div class="calc__head reveal">
        <span class="eyebrow">Le calculateur</span>
        <h2 class="calc__title">Réglez vos hypothèses</h2>
      </div>

      <form class="calc-form" id="calc-form" novalidate>
        <div class="calc-shell">
          <div class="calc-main">
            {/* Key drivers as sliders */}
            <div class="calc-card calc-drivers reveal">
              <div class="calc-card__head">
                <h3 class="calc-card__title">Hypothèses clés</h3>
                <span class="calc-card__hint">Les chiffres qui pèsent le plus sur le total.</span>
              </div>
              <div class="calc-drivers__grid">
                {
                  mainDrivers.map((d) => (
                    <div class="driver" data-driver>
                      <div class="driver__top">
                        <span class="calc-label-wrap">
                          <label class="driver__label" for={d.id}>
                            {d.label}
                          </label>
                          {help[d.id] && (
                            <button
                              type="button"
                              class="calc-help__btn"
                              data-help={help[d.id]}
                              aria-label={`Qu'est-ce que ${d.label} ?`}
                            >
                              ?
                            </button>
                          )}
                        </span>
                        <span class="driver__value">
                          <input
                            class="driver__num"
                            type="number"
                            id={d.id}
                            name={d.id}
                            value={d.value}
                            data-kind={d.kind}
                            data-label={d.label}
                            step={d.step}
                            min={d.min}
                            max={d.max}
                          />
                          <span class="driver__unit">{d.kind === 'percent' ? '%' : d.kind === 'money' ? 'RMB' : 'x'}</span>
                        </span>
                      </div>
                      <input
                        class="driver__range"
                        type="range"
                        min={d.min}
                        max={d.max}
                        step={d.step}
                        value={d.value}
                        data-target={d.id}
                        aria-hidden="true"
                        tabindex="-1"
                      />
                    </div>
                  ))
                }
              </div>

              {/* Channel mix: paid + KOL + organic, 100% of GMV, one row per year */}
              <div class="driver-group">
                <div class="driver-group__head">
                  <span class="driver-group__title">Répartition des canaux</span>
                  <span class="driver-group__sub">D'où viennent les ventes, année par année. Chaque ligne totalise 100 % du GMV.</span>
                </div>
                {
                  mixRows.map((row) => (
                    <div class="driver-group__row">
                      <span class="driver-group__year">{row.title}</span>
                      <div class="driver-group__grid">
                        {row.drivers.map((d) => (
                          <div class="driver driver--share" data-driver>
                            <div class="driver__top">
                              <span class="calc-label-wrap">
                                <label class="driver__label" for={d.id}>
                                  {d.label}
                                </label>
                                {help[d.id] && (
                                  <button
                                    type="button"
                                    class="calc-help__btn"
                                    data-help={help[d.id]}
                                    aria-label={`Qu'est-ce que ${d.label} (${row.title}) ?`}
                                  >
                                    ?
                                  </button>
                                )}
                              </span>
                              <span class="driver__value">
                                <input
                                  class="driver__num"
                                  type="number"
                                  id={d.id}
                                  name={d.id}
                                  value={d.value}
                                  data-kind={d.kind}
                                  data-label={`${d.label} (${row.title})`}
                                  step={d.step}
                                  min={d.min}
                                  max={d.max}
                                />
                                <span class="driver__unit">%</span>
                              </span>
                            </div>
                            <input
                              class="driver__range"
                              type="range"
                              min={d.min}
                              max={d.max}
                              step={d.step}
                              value={d.value}
                              data-target={d.id}
                              aria-hidden="true"
                              tabindex="-1"
                            />
                          </div>
                        ))}
                      </div>
                      <p class="calc-mix" id={row.noteId} aria-live="polite"></p>
                    </div>
                  ))
                }
              </div>
            </div>

            {/* Advanced inputs, collapsible */}
            <div class="calc-card calc-advanced reveal">
              <button type="button" class="calc-advanced__toggle" id="advanced-toggle" aria-expanded="false" aria-controls="advanced-body">
                <span class="calc-advanced__toggle-text">
                  <span class="calc-advanced__toggle-title">Ajuster chaque paramètre</span>
                  <span class="calc-advanced__toggle-sub">Frais, dépôts, logistique, taxes et marge</span>
                </span>
                <span class="calc-advanced__chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                </span>
              </button>
              <div class="calc-advanced__body" id="advanced-body" hidden>
                <div class="calc-advanced__body-inner">
                <div class="calc-tabs" role="tablist" aria-label="Groupes de paramètres">
                  {
                    groups.map((group, idx) => (
                      <button
                        type="button"
                        class:list={['calc-tab', { 'is-active': idx === 0 }]}
                        role="tab"
                        id={`tab-${idx}`}
                        data-tab={idx}
                        aria-controls={`panel-${idx}`}
                        aria-selected={idx === 0 ? 'true' : 'false'}
                      >
                        <span class="calc-tab__icon" set:html={group.icon} />
                        <span class="calc-tab__label">{group.title}</span>
                      </button>
                    ))
                  }
                </div>
                <div class="calc-tabpanels">
                  {
                    groups.map((group, idx) => (
                      <div
                        class:list={['calc-tabpanel', { 'is-active': idx === 0 }]}
                        id={`panel-${idx}`}
                        data-panel={idx}
                        role="tabpanel"
                        aria-labelledby={`tab-${idx}`}
                        hidden={idx !== 0}
                      >
                        {group.note && <p class="calc-group__note">{group.note}</p>}
                        <div class="calc-tabpanel__fields">
                          {group.fields.map((f) => (
                            <div class="calc-field">
                              <span class="calc-label-wrap">
                                <label class="calc-field__label" for={f.id}>
                                  {f.label}
                                </label>
                                {help[f.id] && (
                                  <button
                                    type="button"
                                    class="calc-help__btn"
                                    data-help={help[f.id]}
                                    aria-label={`Qu'est-ce que ${f.label} ?`}
                                  >
                                    ?
                                  </button>
                                )}
                              </span>
                              {f.kind === 'select' ? (
                                <select class="calc-select" id={f.id} name={f.id}>
                                  {(f.options ?? []).map((o) => (
                                    <option
                                      value={o.value}
                                      data-deposit={o.deposit}
                                      data-fee={o.fee}
                                      data-annual={o.annual}
                                      selected={o.value === f.value}
                                    >
                                      {o.label}
                                    </option>
                                  ))}
                                </select>
                              ) : (
                                <div class="calc-input-wrap" data-kind={f.kind}>
                                  {f.kind === 'money' && <span class="calc-input-affix">RMB</span>}
                                  <input
                                    class:list={['calc-input', { 'calc-input--static': f.readonly }]}
                                    type="number"
                                    inputmode="decimal"
                                    id={f.id}
                                    name={f.id}
                                    value={f.value}
                                    data-kind={f.kind}
                                    data-label={f.label}
                                    step={f.step ?? '1'}
                                    min="0"
                                    placeholder={f.kind === 'percent' ? '%' : ''}
                                    readonly={f.readonly}
                                    tabindex={f.readonly ? '-1' : undefined}
                                    aria-readonly={f.readonly ? 'true' : undefined}
                                  />
                                  {f.kind === 'percent' && <span class="calc-input-affix calc-input-affix--suffix">%</span>}
                                  {f.suffix && <span class="calc-input-affix calc-input-affix--suffix">{f.suffix}</span>}
                                </div>
                              )}
                              {f.fx && (
                                <button type="button" class="calc-fx-link" id="fx-refresh">
                                  <span class="calc-fx-link__icon" set:html={refreshIcon} />
                                  Actualiser le taux
                                </button>
                              )}
                              {f.id === 'category' && (
                                <div class="calc-impact" id="category-impact" aria-live="polite" hidden>
                                  <span class="calc-impact__label">Met à jour ci-dessous</span>
                                  <span class="calc-impact__chips">
                                    <span class="calc-impact__chip">
                                      Dépôt de garantie
                                      <strong id="impact-deposit"></strong>
                                    </span>
                                    <span class="calc-impact__chip">
                                      Commission de plateforme
                                      <strong id="impact-fee"></strong>
                                    </span>
                                    <span class="calc-impact__chip">
                                      Frais annuels
                                      <strong id="impact-annual"></strong>
                                    </span>
                                  </span>
                                </div>
                              )}
                              {f.hint && <p class="calc-field__hint">{f.hint}</p>}
                              {f.fx && <p class="calc-field__hint" id="fx-note"></p>}
                            </div>
                          ))}
                        </div>
                      </div>
                    ))
                  }
                </div>
                </div>
              </div>
            </div>
          </div>

          {/* Sticky live preview rail */}
          <aside class="calc-rail reveal">
            <div class="calc-preview">
              <div class="calc-preview__glow" aria-hidden="true"></div>
              <span class="calc-preview__eyebrow">Aperçu en direct</span>
              <div class="calc-preview__orders">
                <span class="calc-preview__orders-num" id="live-orders" data-pulse>14 000</span>
                <span class="calc-preview__orders-label">commandes par an selon vos hypothèses</span>
              </div>

              <div class="calc-preview__locked">
                <div class="calc-preview__locked-row">
                  <span>Coût total année 1</span>
                  <span class="calc-preview__blur">RMB 0 000 000</span>
                </div>
                <div class="calc-preview__locked-row">
                  <span>Dépense réelle</span>
                  <span class="calc-preview__blur">RMB 0 000 000</span>
                </div>
                <div class="calc-preview__locked-row">
                  <span>Coût par commande</span>
                  <span class="calc-preview__blur">RMB 000</span>
                </div>
                <div class="calc-preview__lock" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                </div>
              </div>

              <button type="submit" class="btn btn--primary calc-preview__cta" id="calc-submit">
                Voir le détail complet
              </button>
              <p class="calc-preview__note">
                Un e-mail professionnel débloque le détail complet ici. Exportez-le en PDF une fois terminé.
              </p>
            </div>
          </aside>
        </div>
      </form>

      {/* ---------- Results, hidden until the email gate is cleared ---------- */}
      <div class="calc-results" id="calc-results" hidden>
        {/* Print-only header: brand mark on the exported PDF */}
        <div class="calc-print calc-print__head" aria-hidden="true">
          <img src="/Images/thechinapath-horizontal.png" alt="TheChinaPath" class="calc-print__logo" />
          <div class="calc-print__meta">
            <span>Estimation du coût d'une boutique JD Worldwide</span>
            <span>thechinapath.com · hello@thechinapath.com</span>
          </div>
        </div>

        <div class="calc-results__head reveal">
          <div class="calc-results__head-text">
            <span class="eyebrow">Votre estimation</span>
            <h2 class="calc-results__title">Détail des coûts, année 1 et année 2</h2>
            <p class="calc-results__sub" id="calc-results-sub"></p>
          </div>
          <button type="button" class="btn btn--secondary btn--sm calc-results__pdf" id="calc-pdf" data-export-pdf>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M8 11l4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
            Exporter en PDF
          </button>
        </div>

        <div class="calc-scenario reveal">
          <div class="calc-view-toolbar">
            <div class="calc-period__tabs" role="tablist" aria-label="Année">
              <button type="button" class="calc-period__tab is-active" data-year="1" role="tab" aria-selected="true">Année 1</button>
              <button type="button" class="calc-period__tab" data-year="2" role="tab" aria-selected="false">Année 2</button>
            </div>
          </div>

          <div class="calc-focus">
            <div class="calc-focus__hero">
              <span class="calc-focus__hero-label" id="focus-hero-label">Coût total année 1</span>
              <span class="calc-focus__hero-num" id="focus-total">RMB 0</span>
              <span class="calc-focus__hero-usd" id="focus-usd">$0</span>
            </div>
            <div class="calc-focus__stats">
              <div class="calc-stat calc-stat--pl" id="focus-pl1-wrap">
                <span class="calc-stat__label" id="focus-pl1-label">Résultat d'exploitation</span>
                <span class="calc-stat__value" id="focus-pl1">Ajouter la marge</span>
                <span class="calc-stat__foot" id="focus-pl1-foot">selon votre marge brute, hors investissement de départ</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Marge nette du canal</span>
                <span class="calc-stat__value" id="focus-ncm">RMB 0</span>
                <span class="calc-stat__foot" id="focus-ncm-foot">GMV moins les coûts récurrents, avant coût produit</span>
              </div>
              <div class="calc-stat calc-stat--capex" id="focus-capex-wrap">
                <span class="calc-stat__label">Amortissement du départ</span>
                <span class="calc-stat__value" id="focus-capex">RMB 0</span>
                <span class="calc-stat__foot" id="focus-capex-foot">la part de l'année dans l'investissement de départ</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Dépense réelle</span>
                <span class="calc-stat__value" id="focus-sunk">RMB 0</span>
                <span class="calc-stat__foot" id="focus-sunk-foot">après dépôts remboursables</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Coût par commande</span>
                <span class="calc-stat__value" id="focus-cpo">RMB 0</span>
                <span class="calc-stat__foot" id="focus-cpo-foot">vs votre panier moyen</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Coût en % du GMV</span>
                <span class="calc-stat__value" id="focus-pct">0 %</span>
                <span class="calc-stat__foot">dépense rapportée au chiffre</span>
              </div>
              <div class="calc-stat" id="focus-be-wrap">
                <span class="calc-stat__label">GMV de rentabilité</span>
                <span class="calc-stat__value" id="focus-be">Ajouter la marge</span>
                <span class="calc-stat__foot" id="focus-be-foot">pour couvrir l'année entière</span>
              </div>
            </div>
          </div>

          {/* Animated cost composition */}
          <div class="calc-compo" id="calc-compo">
            <div class="calc-compo__head">
              <div class="calc-compo__head-text">
                <h3 class="calc-compo__title">Où part l'argent</h3>
                <p class="calc-compo__sub" id="compo-sub">Votre coût de première année, du plus élevé au plus faible.</p>
                <div class="calc-period__tabs calc-period__tabs--sm" role="tablist" aria-label="Année">
                  <button type="button" class="calc-period__tab is-active" data-year="1" role="tab" aria-selected="true">Année 1</button>
                  <button type="button" class="calc-period__tab" data-year="2" role="tab" aria-selected="false">Année 2</button>
                </div>
              </div>
              <div class="calc-compo__total-wrap">
                <span class="calc-compo__total-label" id="compo-total-label">Total année 1</span>
                <span class="calc-compo__total" id="compo-total">RMB 0</span>
              </div>
            </div>
            <div class="calc-compo__spine" id="compo-bar" role="img" aria-label="Composition des coûts">
              <div class="calc-compo__tip" id="compo-tip" aria-hidden="true"></div>
            </div>
            <div class="calc-compo__cards" id="compo-cards"></div>
          </div>
        </div>

        <details class="calc-detail reveal">
          <summary class="calc-detail__summary">
            <span>Voir le détail ligne par ligne</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
          </summary>
          <div class="calc-table-bar">
            <span class="calc-table-bar__label">Détail complet année 1 et année 2</span>
            <button type="button" class="btn btn--secondary btn--sm calc-table-bar__pdf" data-export-pdf>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M8 11l4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
              Exporter ce tableau en PDF
            </button>
          </div>
          <div class="calc-table-wrap">
            <table class="calc-table" id="calc-table">
              <thead>
                <tr>
                  <th scope="col">Poste de coût</th>
                  <th scope="col">Année 1</th>
                  <th scope="col">Année 2</th>
                </tr>
              </thead>
              <tbody id="calc-table-body"></tbody>
            </table>
          </div>
        </details>

        <div class="calc-notes reveal">
          <h3 class="calc-notes__title">Comment lire les chiffres</h3>
          <ul class="calc-notes__list">
            {notes.map((n) => <li>{n}</li>)}
          </ul>
        </div>

        <div class="calc-cta reveal">
          <p>Envie qu'on confronte ces hypothèses à votre propre cahier des charges ?</p>
          <a class="btn btn--secondary" href="/fr/nous-contacter">Parler à notre équipe Chine</a>
        </div>

        {/* Print-only footer: contact + disclaimer on the exported PDF */}
        <div class="calc-print calc-print__foot" aria-hidden="true">
          <div class="calc-print__foot-brand">
            <img src="/Images/thechinapath-horizontal.png" alt="TheChinaPath" class="calc-print__logo" />
            <span>thechinapath.com · hello@thechinapath.com</span>
          </div>
          <p class="calc-print__disclaimer">
            Estimation de planification, pas un devis. Établie à partir de références publiques et des
            chiffres que vous avez saisis, la sortie n'est donc qu'indicative. TheChinaPath ne garantit
            ni les totaux, ni les hypothèses, ni les calculs. Pour information seulement. Vérifiez chaque
            ligne face à de vrais devis de votre TP, de votre entrepôt et de la plateforme avant de vous engager.
          </p>
        </div>
      </div>

      <p class="calc-disclaimer">
        Une précision rapide. Ces chiffres sont une estimation de planification, pas un devis. Le modèle
        s'appuie sur des références publiques et sur les valeurs que vous saisissez, la sortie n'est donc
        qu'indicative. Nous ne garantissons ni les totaux, ni les hypothèses, ni les calculs qui les
        sous-tendent. C'est ici pour la démonstration et l'information, rien de plus. Avant d'engager de
        l'argent réel, vérifiez chaque ligne face à de vrais devis de votre TP, de votre entrepôt et de la plateforme.
      </p>
    </div>
  </section>

  {/* ---------- Email gate ---------- */}
  <div class="calc-gate" id="calc-gate" hidden aria-hidden="true">
    <div class="calc-gate__backdrop" data-close></div>
    <div class="calc-gate__panel" role="dialog" aria-modal="true" aria-labelledby="calc-gate-title">
      <button class="calc-gate__close" type="button" data-close aria-label="Fermer">×</button>
      <span class="eyebrow">Une étape</span>
      <h2 class="calc-gate__title" id="calc-gate-title">Débloquez votre détail complet</h2>
      <p class="calc-gate__lead">
        Vos chiffres sont prêts. Indiquez votre e-mail professionnel et nous ouvrons le détail complet
        directement sur cette page. Vous pourrez l'exporter en PDF une fois affiché.
      </p>

      <form class="calc-gate__form" id="calc-gate-form" novalidate>
        <div class="calc-field">
          <label class="calc-field__label" for="lead-name">Nom</label>
          <input class="calc-input calc-input--text" type="text" id="lead-name" name="name" autocomplete="name" required />
        </div>
        <div class="calc-field">
          <label class="calc-field__label" for="lead-email">E-mail professionnel</label>
          <input class="calc-input calc-input--text" type="email" id="lead-email" name="email" autocomplete="email" required />
        </div>
        <div class="calc-field">
          <label class="calc-field__label" for="lead-company">Entreprise</label>
          <input class="calc-input calc-input--text" type="text" id="lead-company" name="company" autocomplete="organization" />
        </div>

        <button type="submit" class="btn btn--primary calc-gate__submit" id="lead-submit">
          Afficher mes résultats
        </button>
        <p class="calc-gate__note">
          Nous utilisons votre e-mail pour vous recontacter et, de temps en temps, partager des notes sur
          la vente en Chine. Pas de spam, et vous pouvez vous désinscrire à tout moment.
        </p>
        <p class="calc-gate__status" id="lead-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  {/* Shared field-explanation bubble, positioned by JS to dodge clipping */}
  <div class="field-pop" id="field-pop" role="tooltip" hidden></div>
</Layout>

<script is:inline>
  (function () {
    const form = document.getElementById('calc-form');
    const gate = document.getElementById('calc-gate');
    const gateForm = document.getElementById('calc-gate-form');
    const gateStatus = document.getElementById('lead-status');
    const leadSubmit = document.getElementById('lead-submit');
    const results = document.getElementById('calc-results');
    if (!form || !gate || !gateForm) return;

    const prefersReduced =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- number helpers ----
    const rmb0 = (n) => 'RMB ' + Math.round(n).toLocaleString('fr-FR');
    const usd0 = (n) => '$' + Math.round(n).toLocaleString('fr-FR');
    const pct1 = (n) => (n * 100).toFixed(1).replace('.', ',') + ' %';

    // ---------- scroll reveal ----------
    if ('IntersectionObserver' in window && !prefersReduced) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
    }

    // ---------- slider <-> number sync + fill ----------
    function paintRange(range) {
      const min = parseFloat(range.min || '0');
      const max = parseFloat(range.max || '100');
      const val = parseFloat(range.value || '0');
      const pct = max > min ? ((val - min) / (max - min)) * 100 : 0;
      range.style.setProperty('--pct', pct + '%');
    }
    document.querySelectorAll('.driver__range').forEach((range) => {
      const num = document.getElementById(range.getAttribute('data-target'));
      paintRange(range);
      range.addEventListener('input', () => {
        if (num) {
          num.value = range.value;
          num.dispatchEvent(new Event('input', { bubbles: true }));
        }
        paintRange(range);
      });
      if (num) {
        num.addEventListener('input', () => {
          range.value = num.value;
          paintRange(range);
        });
      }
    });

    // ---------- live preview ----------
    const liveOrders = document.getElementById('live-orders');
    function updatePreview() {
      const gmv = parseFloat(document.getElementById('gmv').value) || 0;
      const aov = parseFloat(document.getElementById('aov').value) || 0;
      const orders = aov > 0 ? gmv / aov : 0;
      if (liveOrders) {
        liveOrders.textContent = Math.round(orders).toLocaleString('fr-FR');
        if (!prefersReduced) {
          liveOrders.classList.remove('is-pulse');
          void liveOrders.offsetWidth;
          liveOrders.classList.add('is-pulse');
        }
      }
    }
    form.addEventListener('input', updatePreview);
    updatePreview();

    // ---------- channel mix: each year's three shares must total 100% (no auto-edit) ----------
    let mixIs100 = true;
    let mix2Is100 = true;
    function wireMix(ids, noteId, setOk) {
      const labels = ['média payant', 'KOL', 'organique'];
      const els = ids.map((id) => document.getElementById(id));
      if (els.some((e) => !e)) return;
      const mixNote = document.getElementById(noteId);
      function validateMix() {
        const v = els.map((e) => Math.max(0, Math.round(parseFloat(e.value) || 0)));
        const sum = v[0] + v[1] + v[2];
        const ok = sum === 100;
        setOk(ok);
        if (!mixNote) return;
        const chips = ids
          .map(
            (id, k) =>
              '<span class="calc-mix__seg calc-mix__seg--' +
              id.replace(/2$/, '') +
              '"><span class="calc-mix__dot"></span>' +
              v[k] +
              ' % ' +
              labels[k] +
              '</span>',
          )
          .join('');
        const status = ok
          ? '<span class="calc-mix__status calc-mix__status--ok">Total 100 % ✓</span>'
          : '<span class="calc-mix__status calc-mix__status--bad">Total ' +
            sum +
            ' %, il faut 100 %</span>';
        mixNote.innerHTML = chips + status;
        mixNote.classList.toggle('calc-mix--bad', !ok);
      }
      els.forEach((e) => e.addEventListener('input', validateMix));
      validateMix();
    }
    wireMix(['paidShare', 'kolShare', 'organicShare'], 'mix-note', (ok) => (mixIs100 = ok));
    wireMix(['paidShare2', 'kolShare2', 'organicShare2'], 'mix-note-2', (ok) => (mix2Is100 = ok));

    // ---------- advanced accordion ----------
    const advToggle = document.getElementById('advanced-toggle');
    const advBody = document.getElementById('advanced-body');
    if (advToggle && advBody) {
      advToggle.addEventListener('click', () => {
        const open = advToggle.getAttribute('aria-expanded') === 'true';
        advToggle.setAttribute('aria-expanded', String(!open));
        if (open) {
          advBody.style.maxHeight = advBody.scrollHeight + 'px';
          void advBody.offsetWidth;
          advBody.style.maxHeight = '0px';
          advBody.addEventListener(
            'transitionend',
            () => {
              if (advToggle.getAttribute('aria-expanded') === 'false') advBody.hidden = true;
            },
            { once: true },
          );
        } else {
          advBody.hidden = false;
          advBody.style.maxHeight = advBody.scrollHeight + 'px';
          advBody.addEventListener(
            'transitionend',
            () => {
              if (advToggle.getAttribute('aria-expanded') === 'true') advBody.style.maxHeight = 'none';
            },
            { once: true },
          );
        }
      });
    }

    // ---------- fine-tune tabs ----------
    const tabs = Array.from(document.querySelectorAll('.calc-tab'));
    const panels = Array.from(document.querySelectorAll('.calc-tabpanel'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', String(on));
        });
        panels.forEach((p) => {
          const on = p.getAttribute('data-panel') === idx;
          p.classList.toggle('is-active', on);
          p.hidden = !on;
        });
        // panel height may differ; let the open accordion grow to fit
        if (advBody && advToggle && advToggle.getAttribute('aria-expanded') === 'true') {
          advBody.style.maxHeight = 'none';
        }
      });
    });

    // ---------- field help bubbles ----------
    const pop = document.getElementById('field-pop');
    let popTrigger = null;
    function showPop(btn) {
      pop.textContent = btn.getAttribute('data-help') || '';
      pop.hidden = false;
      const pw = Math.min(320, window.innerWidth - 24);
      pop.style.width = pw + 'px';
      const r = btn.getBoundingClientRect();
      let left = r.left + r.width / 2 - pw / 2;
      left = Math.max(12, Math.min(left, window.innerWidth - pw - 12));
      pop.style.left = left + 'px';
      const ph = pop.offsetHeight;
      let top = r.bottom + 8;
      if (top + ph > window.innerHeight - 8) top = r.top - ph - 8;
      pop.style.top = Math.max(8, top) + 'px';
      pop.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      popTrigger = btn;
    }
    let popPinned = false;
    function hidePop() {
      if (!pop) return;
      pop.hidden = true;
      pop.classList.remove('is-open');
      if (popTrigger) popTrigger.setAttribute('aria-expanded', 'false');
      popTrigger = null;
      popPinned = false;
    }
    if (pop) {
      const canHover = window.matchMedia && window.matchMedia('(hover: hover)').matches;
      document.querySelectorAll('.calc-help__btn').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        // click pins the bubble open (works on touch too)
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (popTrigger === btn && popPinned) {
            hidePop();
          } else {
            showPop(btn);
            popPinned = true;
          }
        });
        // hover shows it transiently on pointer devices
        if (canHover) {
          btn.addEventListener('mouseenter', () => {
            if (!popPinned) showPop(btn);
          });
          btn.addEventListener('mouseleave', () => {
            if (!popPinned) hidePop();
          });
          btn.addEventListener('focus', () => {
            if (!popPinned) showPop(btn);
          });
          btn.addEventListener('blur', () => {
            if (!popPinned) hidePop();
          });
        }
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest || !e.target.closest('.calc-help__btn')) hidePop();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') hidePop();
      });
      window.addEventListener('scroll', hidePop, true);
      window.addEventListener('resize', hidePop);
    }

    // ---------- FX live rate ----------
    const fxBtn = document.getElementById('fx-refresh');
    const fxNote = document.getElementById('fx-note');
    async function refreshFx() {
      if (fxBtn) fxBtn.classList.add('is-spinning');
      if (fxNote) {
        fxNote.textContent = 'Récupération du taux…';
        fxNote.className = 'calc-field__hint';
      }
      try {
        const res = await fetch('/api/fx-rate');
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.rate) throw new Error(data.error || 'Aucun taux renvoyé.');
        const fxInput = document.getElementById('fx');
        fxInput.value = data.rate;
        fxInput.dispatchEvent(new Event('input', { bubbles: true }));
        if (fxNote) {
          fxNote.textContent = 'Taux du jour : 1 USD = ' + data.rate + ' RMB.';
          fxNote.className = 'calc-field__hint calc-field__hint--ok';
        }
      } catch (err) {
        if (fxNote) {
          fxNote.textContent = 'Impossible de récupérer le taux. Votre valeur est conservée.';
          fxNote.className = 'calc-field__hint calc-field__hint--err';
        }
      } finally {
        if (fxBtn) fxBtn.classList.remove('is-spinning');
      }
    }
    if (fxBtn) fxBtn.addEventListener('click', refreshFx);
    // Pull today's rate on load so the USD figure starts current.
    refreshFx();

    // ---------- category picker sets deposit + commission + annual fee ----------
    const catSelect = document.getElementById('category');
    if (catSelect) {
      const impactBox = document.getElementById('category-impact');
      const impactDeposit = document.getElementById('impact-deposit');
      const impactFee = document.getElementById('impact-fee');
      const impactAnnual = document.getElementById('impact-annual');

      function applyCategory(fillForm) {
        const opt = catSelect.options[catSelect.selectedIndex];
        const deposit = opt.getAttribute('data-deposit');
        const fee = opt.getAttribute('data-fee');
        const annual = opt.getAttribute('data-annual');
        // Custom leaves the fields untouched, so there is nothing to preview.
        if (!deposit && !fee && !annual) {
          if (impactBox) impactBox.hidden = true;
          return;
        }
        const setField = (id, val) => {
          if (!val) return;
          const el = document.getElementById(id);
          if (el) {
            el.value = val;
            el.dispatchEvent(new Event('input', { bubbles: true }));
          }
        };
        if (fillForm) {
          setField('platformDeposit', deposit);
          setField('techFee', fee);
          setField('annualFee', annual);
        }
        if (impactBox) {
          if (impactDeposit && deposit)
            impactDeposit.textContent = 'RMB ' + Number(deposit).toLocaleString('fr-FR');
          if (impactFee && fee) impactFee.textContent = fee + ' %';
          if (impactAnnual && annual)
            impactAnnual.textContent = 'RMB ' + Number(annual).toLocaleString('fr-FR');
          impactBox.hidden = false;
        }
      }

      catSelect.addEventListener('change', () => applyCategory(true));
      // Show what the default category drives, without overwriting the fields.
      applyCategory(false);
    }

    // ---------- compute (faithful port of the DP cost model spec) ----------
    function readInputs() {
      const out = {};
      form.querySelectorAll('input[data-kind]').forEach((el) => {
        const kind = el.getAttribute('data-kind');
        const raw = el.value.trim();
        if (raw === '') {
          out[el.name] = null;
          return;
        }
        let v = parseFloat(raw);
        if (!Number.isFinite(v)) v = 0;
        if (kind === 'percent') v = v / 100;
        out[el.name] = v;
      });
      return out;
    }

    function compute(i) {
      const gmv = i.gmv || 0;
      const aov = i.aov || 1;
      const orders = gmv / aov;
      const taxPayer = (document.getElementById('cbecTaxPayer') || {}).value || 'consumer';
      const brandPaysTax = taxPayer === 'brand';
      // Year 2 sells more: its stack scales off Year 1 GMV grown by the
      // "Year 2 GMV growth" assumption.
      const gmv2 = gmv * (1 + (i.gmvGrowth || 0));
      const orders2 = gmv2 / aov;

      const setup = {
        'Dépôt de garantie plateforme (remboursable)': i.platformDeposit || 0,
        'Dépôt entrepôt sous douane (remboursable)': i.whDeposit || 0,
        'Avance de taxe à l\'entrepôt sous douane': i.whTaxPrepay || 0,
        'Enregistrement de la marque en Chine': i.trademark || 0,
        'Création de la boutique et contenus de lancement': i.brandSetup || 0,
      };
      const setupTotal = Object.values(setup).reduce((a, b) => a + b, 0);

      // Setup splits in two. The deposits and the tax prepayment come back on
      // exit, so they are working capital and never touch the P&L. The trademark
      // and the store build are spent for good: a real cost, but one that earns
      // over several years, so it is amortized rather than charged to Year 1.
      const refundableCapex = (i.platformDeposit || 0) + (i.whDeposit || 0) + (i.whTaxPrepay || 0);
      const sunkCapex = (i.trademark || 0) + (i.brandSetup || 0);
      const amortYears = Math.max(1, Math.round(i.amortYears || 1));
      const amortAnnual = sunkCapex / amortYears;
      // A one-year write-off is fully expensed in Year 1, so Year 2 carries none.
      const amortY1 = amortAnnual;
      const amortY2 = amortYears >= 2 ? amortAnnual : 0;
      const amortLabel =
        'Amortissement du départ (sur ' + amortYears + (amortYears === 1 ? ' an' : ' ans') + ')';

      // Fixed and per-order coefficients for break-even. The fixed side is the
      // running services plus the year's amortization: break-even asks what GMV
      // covers the annual bill the P&L actually carries.
      const tpRetainerAnnual = (i.dpRetainer || 0) * 12;
      // The platform annual fee, the TP retainer, the co-fund and any clearance
      // agent are the fixed running cost. Service-side VAT on those fees is
      // assumed baked into the quotes, so it is not modelled separately.
      const fixedServices =
        (i.agentFee || 0) + tpRetainerAnnual + (i.coFund || 0) + (i.annualFee || 0);
      const F = fixedServices + amortY1;
      const F2 = fixedServices + amortY2;
      const vQ =
        (i.storage || 0) * 2 +
        (i.fulfillment || 0) +
        (i.shipping || 0) +
        (i.returnRate || 0) * (i.returnHandling || 0);

      function scenario(roas) {
        // One operating stack per year. Year 2 differs on three inputs: its own
        // channel mix (paid vs KOL vs organic), a grown GMV, and the share of
        // the setup write-off it still carries.
        function opStack(paidShare, kolShare, g, o, amort) {
          const media = roas > 0 ? (g * (paidShare || 0)) / roas : 0;
          const tpCommission = g * (i.dpCommission || 0);
          const commission = g * (i.techFee || 0);
          const payment = g * (i.paymentFee || 0);
          const vat = brandPaysTax ? g * (i.cbecTax || 0) : 0;
          const op = {
            'Honoraires mensuels du TP (× 12)': tpRetainerAnnual,
            'Commission du TP sur le GMV': tpCommission,
            'Frais annuels de plateforme': i.annualFee || 0,
            'Commission de plateforme (运营支持服务费)': commission,
            'Frais de transaction': payment,
            'Média payant (JD 快车 et display)': media,
            'Commission KOL et live': g * (kolShare || 0) * (i.kolCommission || 0),
            'Cofinancement de campagne': i.coFund || 0,
            'Agent en douane': i.agentFee || 0,
            'Stockage entrepôt sous douane': o * (i.storage || 0) * 2,
            'Préparation de commande (picking et emballage)': o * (i.fulfillment || 0),
            'Livraison dernier kilomètre': o * (i.shipping || 0),
            'Traitement des retours': o * (i.returnRate || 0) * (i.returnHandling || 0),
          };
          // Consumer carries the VAT in most store setups, so it only lands on
          // the brand P&L when the payer toggle says so.
          if (brandPaysTax) op['Taxe à l\'import cross-border (综合税)'] = vat;

          // Cash leaving the building this year, before the write-off.
          const cashOp = Object.values(op).reduce((a, b) => a + b, 0);
          // The write-off is a P&L cost with no cash behind it: the money was
          // already paid at setup. It is charged here and nowhere else, so the
          // cash column and the profit column never double-count it.
          op[amortLabel] = amort;
          const opTotal = cashOp + amort;

          // %-of-GMV variable rate for this ROAS and mix.
          const paidRate = roas > 0 ? (paidShare || 0) / roas : 0;
          const vG =
            (i.dpCommission || 0) +
            (kolShare || 0) * (i.kolCommission || 0) +
            (i.techFee || 0) +
            (i.paymentFee || 0) +
            (brandPaysTax ? i.cbecTax || 0 : 0) +
            paidRate;

          // Buckets for the composition bar
          const buckets = [
            { key: 'Investissement de départ', color: '#c8102e', value: setupTotal },
            { key: 'Honoraires + commission TP', color: '#e2683b', value: tpRetainerAnnual + tpCommission },
            { key: 'Média payant', color: '#f4874b', value: op['Média payant (JD 快车 et display)'] },
            { key: 'KOL et live', color: '#f4b740', value: op['Commission KOL et live'] },
            { key: 'Frais de plateforme et de transaction', color: '#7b61a8', value: op['Commission de plateforme (运营支持服务费)'] + op['Frais de transaction'] + (op['Frais annuels de plateforme'] || 0) },
            { key: 'Taxe cross-border', color: '#9b5bb0', value: vat },
            { key: 'Logistique', color: '#3aa0c8', value: op['Stockage entrepôt sous douane'] + op['Préparation de commande (picking et emballage)'] + op['Livraison dernier kilomètre'] + op['Traitement des retours'] },
            { key: 'Agent + cofinancement', color: '#2fb67f', value: op['Agent en douane'] + op['Cofinancement de campagne'] },
          ];
          return { op, opTotal, cashOp, vG, buckets };
        }

        const y1 = opStack(i.paidShare, i.kolShare, gmv, orders, amortY1);
        const y2 = opStack(i.paidShare2, i.kolShare2, gmv2, orders2, amortY2);

        const opTotal = y1.opTotal;
        const vG = y1.vG;
        // total = every RMB that leaves the building in Year 1: the setup cheque
        // in full, plus the running cash. The write-off is excluded here, since
        // the cash it represents is already in setupTotal.
        const total = setupTotal + y1.cashOp;
        const refundable = refundableCapex;
        const netSunk = total - refundable;
        const totalUSD = i.fx > 0 ? total / i.fx : 0;
        const costPerOrder = orders > 0 ? total / orders : 0;
        const totalPctGmv = gmv > 0 ? total / gmv : 0;
        const opPctGmv = gmv > 0 ? opTotal / gmv : 0;

        let breakeven = null;
        let breakevenMonthly = null;
        let breakevenOrders = null;
        let contribution = null;
        if (i.grossMargin != null) {
          // Operating P&L: gross profit less the running cost and this year's
          // share of the setup write-off.
          contribution = gmv * i.grossMargin - opTotal;
          const denom = i.grossMargin - vG - (aov > 0 ? vQ / aov : 0);
          if (denom <= 0) {
            breakeven = 'Marge trop faible';
          } else {
            breakeven = F / denom;
            breakevenMonthly = breakeven / 12;
            breakevenOrders = aov > 0 ? breakeven / aov : 0;
          }
        }

        return {
          op: y1.op,
          opTotal,
          cashOp: y1.cashOp,
          vG,
          buckets: y1.buckets,
          op2: y2.op,
          opTotal2: y2.opTotal,
          cashOp2: y2.cashOp,
          vG2: y2.vG,
          buckets2: y2.buckets,
          total,
          refundable,
          netSunk,
          totalUSD,
          costPerOrder,
          totalPctGmv,
          opPctGmv,
          breakeven,
          breakevenMonthly,
          breakevenOrders,
          contribution,
        };
      }

      return {
        orders,
        aov,
        gmv,
        gmv2,
        orders2,
        setup,
        setupTotal,
        refundableCapex,
        sunkCapex,
        amortYears,
        amortY1,
        amortY2,
        F,
        F2,
        vQ,
        s: scenario(i.roas || 0),
        hasGm: i.grossMargin != null,
      };
    }

    // ---------- count-up ----------
    function animateCount(el, target, fmt) {
      if (prefersReduced) {
        el.textContent = fmt(target);
        return;
      }
      const start = performance.now();
      const dur = 850;
      function tick(now) {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(target * eased);
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    // ---------- results rendering ----------
    let state = null; // { i, r }
    let activeYear = '1'; // '1' or '2', driven by the Year 1 / Year 2 tabs
    // Once the visitor has handed over their email, they can tweak assumptions
    // and re-run as many times as they like without seeing the gate again. Scoped
    // to the browser session: a refresh keeps them in, a new session re-gates.
    let unlocked = false;
    try {
      unlocked = sessionStorage.getItem('jdCalcUnlocked') === '1';
    } catch (_) {
      /* private mode or storage disabled: fall back to in-session unlock */
    }
    // When they're already unlocked, the CTA is a re-run, not a locked gate.
    function paintCta() {
      if (!unlocked) return;
      const cta = document.getElementById('calc-submit');
      const note = document.querySelector('.calc-preview__note');
      // The blurred teaser only makes sense while the numbers are still hidden.
      // Once they are on the page, the rail is just a re-run button.
      const locked = document.querySelector('.calc-preview__locked');
      if (locked) locked.remove();
      if (cta) cta.textContent = 'Mettre à jour mon détail';
      if (note) note.textContent = 'Modifiez une hypothèse ci-dessus, puis relancez. Pas besoin de vous réidentifier.';
    }
    paintCta();

    function renderFocus() {
      if (!state) return;
      const r = state.r;
      const s = r.s;
      const i = state.i;
      const y2 = activeYear === '2';

      // period-dependent figures, on a CASH basis: Year 2 writes no setup cheque
      // and runs on its own channel mix, so its cash cost is the Year 2 running
      // stack. The amortization is a P&L line and is deliberately not in here.
      const cost = y2 ? s.cashOp2 : s.total;
      const costUSD = i.fx > 0 ? cost / i.fx : 0;
      const cash = y2 ? s.cashOp2 : s.netSunk;
      // Year 2 runs on grown GMV, so its per-order and %-of-GMV figures
      // divide by the Year 2 volumes.
      const gmvYear = y2 ? r.gmv2 : r.gmv;
      const ordersYear = y2 ? r.orders2 : r.orders;
      const cpo = ordersYear > 0 ? cost / ordersYear : 0;
      const pctGmv = gmvYear > 0 ? cost / gmvYear : 0;

      document.getElementById('focus-hero-label').textContent = y2
        ? 'Coût total année 2'
        : 'Décaissement total année 1 (départ + fonctionnement)';
      animateCount(document.getElementById('focus-total'), cost, rmb0);
      animateCount(document.getElementById('focus-usd'), costUSD, usd0);
      animateCount(document.getElementById('focus-sunk'), cash, rmb0);
      document.getElementById('focus-sunk-foot').textContent = y2
        ? 'coûts récurrents, les dépôts sont déjà immobilisés'
        : 'après dépôts remboursables';
      animateCount(document.getElementById('focus-cpo'), cpo, rmb0);
      document.getElementById('focus-cpo-foot').textContent =
        'vs ' + rmb0(i.aov || 0) + ' de panier moyen';
      document.getElementById('focus-pct').textContent = pct1(pctGmv);

      // breakeven, year aware (Year 2 drops the sunk setup and runs its own mix)
      const Fyear = y2 ? r.F2 : r.F;
      const be = document.getElementById('focus-be');
      const beWrap = document.getElementById('focus-be-wrap');
      const beFoot = document.getElementById('focus-be-foot');
      if (r.hasGm) {
        const denom = i.grossMargin - (y2 ? s.vG2 : s.vG) - (r.aov > 0 ? r.vQ / r.aov : 0);
        if (denom <= 0) {
          be.textContent = 'Marge trop faible';
          beFoot.textContent = 'relevez d\'abord votre marge';
        } else {
          const beVal = Fyear / denom;
          be.textContent = rmb0(beVal);
          beFoot.textContent =
            'environ ' +
            rmb0(beVal / 12) +
            '/mois · ' +
            Math.round(r.aov > 0 ? beVal / r.aov : 0).toLocaleString('fr-FR') +
            ' commandes/an';
        }
        beWrap.classList.remove('is-muted');
      } else {
        be.textContent = 'Ajouter la marge';
        beFoot.textContent = 'pour couvrir l\'année';
        beWrap.classList.add('is-muted');
      }

      // Operating profit or loss: gross profit less the running cost and this
      // year's share of the setup write-off. The refundable deposits stay out.
      const opYear = y2 ? s.opTotal2 : s.opTotal;
      const plEl = document.getElementById('focus-pl1');
      const plFoot = document.getElementById('focus-pl1-foot');
      const plWrap = document.getElementById('focus-pl1-wrap');
      plEl.classList.remove('is-profit', 'is-loss');
      if (r.hasGm) {
        const grossProfit = gmvYear * i.grossMargin;
        const amount = grossProfit - opYear;
        const sign = amount >= 0 ? '+' : '−';
        plEl.textContent = sign + rmb0(Math.abs(amount));
        plEl.classList.add(amount >= 0 ? 'is-profit' : 'is-loss');
        plFoot.textContent =
          (amount >= 0 ? 'bénéfice. ' : 'perte. ') +
          'après coûts récurrents et amortissement du départ';
        plWrap.classList.remove('is-muted');
      } else {
        plEl.textContent = 'Ajouter la marge';
        plFoot.textContent = 'renseignez la marge brute par commande';
        plWrap.classList.add('is-muted');
      }

      // Setup capex: the cheque is written in Year 1, but the P&L only carries
      // the year's amortized share, which is what this card reports per year.
      const capexEl = document.getElementById('focus-capex');
      const capexFoot = document.getElementById('focus-capex-foot');
      const capexWrap = document.getElementById('focus-capex-wrap');
      const amortYear = y2 ? r.amortY2 : r.amortY1;
      if (y2) {
        animateCount(capexEl, amortYear, rmb0);
        capexFoot.textContent =
          amortYear > 0
            ? 'part amortie, aucune sortie de trésorerie. Le départ a été payé en année 1'
            : 'passé en charges dès l\'année 1, il ne reste rien à imputer';
        capexWrap.classList.add('is-muted');
      } else {
        animateCount(capexEl, amortYear, rmb0);
        capexFoot.textContent =
          'la part de l\'année sur ' +
          rmb0(r.sunkCapex) +
          ' amortis sur ' +
          r.amortYears +
          (r.amortYears === 1 ? ' an' : ' ans') +
          '. ' +
          rmb0(r.refundableCapex) +
          ' de dépôts vous reviennent';
        capexWrap.classList.remove('is-muted');
      }

      // Net channel margin: GMV less the operating cost (which now carries the
      // write-off), before product cost.
      const ncm = gmvYear - opYear;
      const ncmEl = document.getElementById('focus-ncm');
      ncmEl.classList.remove('is-profit', 'is-loss');
      ncmEl.textContent = (ncm >= 0 ? '+' : '−') + rmb0(Math.abs(ncm));
      ncmEl.classList.add(ncm >= 0 ? 'is-profit' : 'is-loss');
      document.getElementById('focus-ncm-foot').textContent =
        'GMV moins les coûts récurrents, avant coût produit';

      document.getElementById('compo-sub').textContent = y2
        ? 'Votre coût récurrent de l\'année 2, du plus élevé au plus faible.'
        : 'Votre coût de première année, du plus élevé au plus faible.';
      document.getElementById('compo-total-label').textContent = y2
        ? 'Total année 2'
        : 'Total année 1';
      // The composition bar is a cash picture: Year 1 shows the setup cheque in
      // full, Year 2 shows running cash only. The write-off is not a bucket.
      const compoBuckets = y2
        ? s.buckets2.filter((b) => b.key !== 'Investissement de départ')
        : s.buckets;
      renderCompo(compoBuckets, y2 ? s.cashOp2 : s.total);
    }

    // line icons keyed by bucket, drawn in currentColor
    const BUCKET_ICONS = {
      'Investissement de départ':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1.5-4.5A2 2 0 0 1 6.4 3h11.2a2 2 0 0 1 1.9 1.5L21 9"/><path d="M3 9v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9"/><path d="M3 9h18"/><path d="M9 13h6"/></svg>',
      'Honoraires + commission TP':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M2 20a7 7 0 0 1 14 0"/><path d="M16 6a3 3 0 0 1 0 6"/><path d="M20 20a6 6 0 0 0-4-5.6"/></svg>',
      'Média payant':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4"/></svg>',
      'KOL et live':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4a1 1 0 0 0 1 1h2l9 5V4L6 9H4a1 1 0 0 0-1 1z"/><path d="M18 9a4 4 0 0 1 0 6"/></svg>',
      'Frais de plateforme et de transaction':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>',
      'Taxe cross-border':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h10a1 1 0 0 1 1 1v17l-3-2-3 2-3-2-3 2V4a1 1 0 0 1 1-1z"/><path d="M14.5 9.5l-5 5"/><circle cx="9.7" cy="9.7" r=".6"/><circle cx="14.3" cy="14.3" r=".6"/></svg>',
      Logistique:
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h12v9H2z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>',
      'Agent + cofinancement':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/></svg>',
    };

    let compoTipHideT = null;
    function renderCompo(buckets, grandTotal) {
      const bar = document.getElementById('compo-bar');
      const cards = document.getElementById('compo-cards');
      const tip = document.getElementById('compo-tip');
      const totalEl = document.getElementById('compo-total');
      if (!bar || !cards) return;
      const total = grandTotal || 1;
      animateCount(totalEl, grandTotal, rmb0);

      const items = buckets
        .filter((b) => b.value > 0)
        .slice()
        .sort((a, b) => b.value - a.value)
        .map((b) => ({ ...b, pct: (b.value / total) * 100 }));

      // spine segments (keep the tooltip node)
      bar.querySelectorAll('.calc-compo__seg').forEach((el) => el.remove());
      items.forEach((b) => {
        const seg = document.createElement('span');
        seg.className = 'calc-compo__seg';
        seg.dataset.key = b.key;
        seg.style.setProperty('--w', b.pct + '%');
        seg.style.setProperty('--c', b.color);
        bar.appendChild(seg);
      });

      // ranked cost cards
      cards.innerHTML = items
        .map((b, idx) => {
          const icon = BUCKET_ICONS[b.key] || '';
          return (
            '<article class="cost-card" data-key="' +
            b.key +
            '" style="--c:' +
            b.color +
            ';--i:' +
            idx +
            '">' +
            '<span class="cost-card__icon">' +
            icon +
            '</span>' +
            '<div class="cost-card__body">' +
            '<div class="cost-card__top"><span class="cost-card__name">' +
            b.key +
            '</span><span class="cost-card__pct">' +
            b.pct.toFixed(0) +
            '%</span></div>' +
            '<span class="cost-card__value" data-val="' +
            b.value +
            '">' +
            rmb0(b.value) +
            '</span>' +
            '<div class="cost-card__meter"><span class="cost-card__meter-fill" style="--w:' +
            b.pct +
            '%"></span></div>' +
            '</div>' +
            '</article>'
          );
        })
        .join('');

      const segEls = Array.from(bar.querySelectorAll('.calc-compo__seg'));
      const cardEls = Array.from(cards.querySelectorAll('.cost-card'));

      // grow the spine, meters and count up the card values
      const grow = () => {
        segEls.forEach((el) => el.classList.add('is-grown'));
        cardEls.forEach((el, idx) => {
          el.classList.add('is-in');
          const fill = el.querySelector('.cost-card__meter-fill');
          if (fill) fill.classList.add('is-grown');
          const valEl = el.querySelector('.cost-card__value');
          if (valEl) {
            const target = parseFloat(valEl.getAttribute('data-val')) || 0;
            if (prefersReduced) valEl.textContent = rmb0(target);
            else setTimeout(() => animateCount(valEl, target, rmb0), 120 + idx * 60);
          }
        });
      };
      if (prefersReduced) grow();
      else requestAnimationFrame(grow);

      // link the spine and the cards on hover / focus
      const focus = (key, on) => {
        segEls.forEach((el) => {
          el.classList.toggle('is-focus', on && el.dataset.key === key);
          el.classList.toggle('is-dim', on && el.dataset.key !== key);
        });
        cardEls.forEach((el) => {
          el.classList.toggle('is-focus', on && el.dataset.key === key);
          el.classList.toggle('is-dim', on && el.dataset.key !== key);
        });
      };
      const showTip = (seg) => {
        if (!tip) return;
        if (compoTipHideT) clearTimeout(compoTipHideT);
        const item = items.find((x) => x.key === seg.dataset.key);
        if (!item) return;
        tip.innerHTML =
          '<span class="calc-compo__tip-key">' +
          item.key +
          '</span><span class="calc-compo__tip-val">' +
          rmb0(item.value) +
          ' · ' +
          item.pct.toFixed(1) +
          '%</span>';
        tip.style.left = seg.offsetLeft + seg.offsetWidth / 2 + 'px';
        tip.classList.add('is-open');
      };
      const hideTip = () => {
        if (!tip) return;
        compoTipHideT = setTimeout(() => tip.classList.remove('is-open'), 60);
      };
      segEls.forEach((seg) => {
        seg.addEventListener('mouseenter', () => {
          focus(seg.dataset.key, true);
          showTip(seg);
        });
        seg.addEventListener('mouseleave', () => {
          focus(seg.dataset.key, false);
          hideTip();
        });
      });
      cardEls.forEach((card) => {
        card.addEventListener('mouseenter', () => focus(card.dataset.key, true));
        card.addEventListener('mouseleave', () => focus(card.dataset.key, false));
      });
    }

    function renderTable() {
      const r = state.r;
      const i = state.i;
      const s = r.s;
      const gmv = i.gmv || 0;
      const fx = i.fx > 0 ? i.fx : 0;
      const body = document.getElementById('calc-table-body');
      const sectionRow = (label) =>
        '<tr class="calc-table__section"><td colspan="3">' + label + '</td></tr>';
      // A null year-2 value means the line does not recur (setup, deposits).
      const cell = (v) => (v === null ? '<span class="calc-table__na">-</span>' : rmb0(v));
      const dataRow = (label, y1, y2, strong) =>
        '<tr' + (strong ? ' class="calc-table__total"' : '') + '><td>' + label + '</td><td>' + cell(y1) + '</td><td>' + cell(y2) + '</td></tr>';
      // signed profit/loss cell, coloured by sign
      const plCell = (n) => {
        const cls = n >= 0 ? 'calc-pl--pos' : 'calc-pl--neg';
        const sign = n >= 0 ? '+' : '−';
        return '<td class="calc-pl ' + cls + '">' + sign + rmb0(Math.abs(n)) + '</td>';
      };
      const plRow = (label, y1, y2) =>
        '<tr class="calc-table__total calc-table__pl"><td>' + label + '</td>' + plCell(y1) + plCell(y2) + '</tr>';

      // The setup cheque is written once, in Year 1. Part of it comes back on
      // exit; the rest is amortized into the operating lines below.
      let rows = sectionRow('Investissement de départ, décaissé une fois (année 1)');
      Object.keys(r.setup).forEach((k) => {
        rows += dataRow(k, r.setup[k], null, false);
      });
      rows += dataRow('Sous-total investissement de départ', r.setupTotal, null, true);
      rows += dataRow('Dont remboursable à la sortie (jamais une charge)', r.refundableCapex, null, false);
      rows += dataRow(
        'Dont dépensé pour de bon (amorti sur ' + r.amortYears + (r.amortYears === 1 ? ' an' : ' ans') + ')',
        r.sunkCapex,
        null,
        false,
      );

      // Operating cost recurs, but Year 2 runs on its own channel mix and a
      // grown GMV, so the sales-driven lines differ between the two columns.
      // The last line is the write-off: a cost with no cash behind it.
      rows += sectionRow('Exploitation, par an (le compte de résultat)');
      Object.keys(s.op).forEach((k) => {
        rows += dataRow(k, s.op[k], s.op2[k], false);
      });
      rows += dataRow('Sous-total exploitation', s.opTotal, s.opTotal2, true);

      rows += sectionRow('Vue trésorerie (hors amortissement, qui ne déplace aucun cash)');
      rows += dataRow('GMV retenu', gmv, r.gmv2, false);
      rows += dataRow('Décaissement total (départ + fonctionnement)', s.total, s.cashOp2, true);
      rows += dataRow('Dépense réelle, après remboursements', s.netSunk, s.cashOp2, true);
      if (fx) {
        rows +=
          '<tr class="calc-table__total"><td>Décaissement total (USD)</td><td>' +
          usd0(s.totalUSD) +
          '</td><td>' +
          usd0(s.cashOp2 / fx) +
          '</td></tr>';
      }
      rows += dataRow('Économie de l\'année 1 à l\'année 2', s.total - s.cashOp2, null, false);
      rows += plRow(
        'Marge nette du canal (GMV moins coûts d\'exploitation, avant coût produit)',
        gmv - s.opTotal,
        r.gmv2 - s.opTotal2,
      );

      rows += sectionRow('Résultat d\'exploitation selon votre marge');
      if (r.hasGm) {
        // Break-even asks what GMV covers the running bill, so the fixed side is
        // services only. The two years differ on their channel mix (vG vs vG2).
        const beCell = (F, vG) => {
          const denom = i.grossMargin - vG - (r.aov > 0 ? r.vQ / r.aov : 0);
          return denom <= 0 ? 'Marge trop faible' : rmb0(F / denom);
        };
        const grossProfit = gmv * i.grossMargin;
        const grossProfit2 = r.gmv2 * i.grossMargin;
        rows += dataRow('Marge brute (GMV × marge)', grossProfit, grossProfit2, false);
        rows += dataRow('Moins les coûts d\'exploitation (amortissement du départ inclus)', s.opTotal, s.opTotal2, false);
        rows += plRow('Résultat d\'exploitation (bénéfice ou perte)', s.contribution, grossProfit2 - s.opTotal2);
        rows +=
          '<tr><td>GMV de rentabilité</td><td>' + beCell(r.F, s.vG) + '</td><td>' + beCell(r.F2, s.vG2) + '</td></tr>';
        rows +=
          '<tr class="calc-table__memo"><td>Pour mémoire : dépôts remboursables, décaissés mais jamais une charge</td><td>' +
          rmb0(r.refundableCapex) +
          '</td><td><span class="calc-table__na">-</span></td></tr>';
      } else {
        rows +=
          '<tr class="calc-table__prompt"><td colspan="3">Renseignez votre marge brute ci-dessous (ouvrez « Ajuster chaque paramètre », puis l\'onglet « Votre rentabilité ») pour voir le résultat d\'exploitation des années 1 et 2.</td></tr>';
      }
      body.innerHTML = rows;
    }

    function renderResults() {
      const i = state.i;
      const r = state.r;
      const roas = String(i.roas || 0).replace('.', ',');
      document.getElementById('calc-results-sub').textContent =
        'Sur la base de ' + rmb0(i.gmv || 0) + ' de GMV, ' + Math.round(r.orders).toLocaleString('fr-FR') + ' commandes par an à ' + rmb0(i.aov || 0) + ' de panier moyen, ROAS ' + roas + 'x. L\'année 2 retient ' + rmb0(r.gmv2) + ' de GMV (+' + Math.round((i.gmvGrowth || 0) * 100) + ' %).';
      renderFocus();
      renderTable();
      results.hidden = false;
      results.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
    }

    // export to PDF via the browser print dialog (no dependency, China-safe)
    function exportPdf() {
      const detail = document.querySelector('.calc-detail');
      if (detail) detail.open = true; // make sure the full table prints
      window.print();
    }
    document.querySelectorAll('[data-export-pdf]').forEach((btn) => btn.addEventListener('click', exportPdf));

    // year tabs (Year 1 / Year 2). There is more than one group on the page
    // (the toolbar and the "Where the money goes" header), so switching one
    // keeps every group in sync by matching on data-year.
    function setYear(year) {
      activeYear = year;
      document.querySelectorAll('.calc-period__tab').forEach((t) => {
        const on = t.getAttribute('data-year') === year;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      renderFocus();
    }
    document.querySelectorAll('.calc-period__tab').forEach((tab) => {
      tab.addEventListener('click', () => setYear(tab.getAttribute('data-year')));
    });

    // ---------- lead payload ----------
    function leadPayloadExtras(r) {
      const inputs = [];
      form.querySelectorAll('input[data-kind]').forEach((el) => {
        const label = el.getAttribute('data-label') || el.name;
        const kind = el.getAttribute('data-kind');
        let val = el.value.trim();
        if (val === '') val = '(non renseigné)';
        else if (kind === 'money') val = 'RMB ' + Number(val).toLocaleString('fr-FR');
        else if (kind === 'percent') val = val + ' %';
        inputs.push({ label, value: val });
      });
      const out = [
        { label: 'Décaissement total année 1', value: rmb0(r.s.total) + ' / ' + usd0(r.s.totalUSD) },
        { label: 'Investissement de départ, décaissé une fois', value: rmb0(r.setupTotal) + ', dont ' + rmb0(r.refundableCapex) + ' remboursables' },
        { label: 'Amortissement du départ, par an', value: rmb0(r.amortY1) + ' sur ' + r.amortYears + ' ans' },
        { label: 'Coûts d\'exploitation, année 1 (amortissement inclus)', value: rmb0(r.s.opTotal) },
        { label: 'Coûts d\'exploitation, année 2 (amortissement inclus)', value: rmb0(r.s.opTotal2) },
        { label: 'GMV retenu pour l\'année 2', value: rmb0(r.gmv2) },
        { label: 'Dépense réelle, année 1', value: rmb0(r.s.netSunk) },
        { label: 'Coût par commande', value: rmb0(r.s.costPerOrder) },
        { label: 'Coût en % du GMV', value: pct1(r.s.totalPctGmv) },
      ];
      if (r.hasGm) {
        const be = typeof r.s.breakeven === 'string' ? r.s.breakeven : rmb0(r.s.breakeven);
        out.push({ label: 'Résultat d\'exploitation, année 1 (amortissement inclus)', value: rmb0(r.s.contribution) });
        out.push({ label: 'GMV de rentabilité', value: be });
      }
      return { inputs, results: out };
    }

    // ---------- gate ----------
    let lastFocus = null;
    function openGate() {
      lastFocus = document.activeElement;
      gate.hidden = false;
      gate.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      const first = document.getElementById('lead-name');
      if (first) first.focus();
    }
    function closeGate() {
      gate.hidden = true;
      gate.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    gate.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeGate));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !gate.hidden) closeGate();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const badMixNote = !mixIs100 ? 'mix-note' : !mix2Is100 ? 'mix-note-2' : null;
      if (badMixNote) {
        const note = document.getElementById(badMixNote);
        if (note) {
          note.classList.add('calc-mix--shake');
          note.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(() => note.classList.remove('calc-mix--shake'), 500);
        }
        return;
      }
      const i = readInputs();
      state = { i, r: compute(i) };
      if (unlocked) {
        // Already gave us their email: recompute and reveal, no gate.
        renderResults();
        results.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        openGate();
      }
    });

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    gateForm.addEventListener('submit', (e) => {
      e.preventDefault();
      gateStatus.textContent = '';
      gateStatus.className = 'calc-gate__status';
      const data = new FormData(gateForm);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const company = String(data.get('company') || '').trim();
      if (!name || !EMAIL_RE.test(email)) {
        gateStatus.textContent = 'Indiquez votre nom et un e-mail professionnel valide.';
        gateStatus.classList.add('calc-gate__status--error');
        return;
      }

      // Capture the lead in the background. The reveal never waits on it, so a
      // mail-backend hiccup can't block the visitor from seeing their numbers.
      const extras = state ? leadPayloadExtras(state.r) : { inputs: [], results: [] };
      fetch('/api/calculator-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, company, inputs: extras.inputs, results: extras.results }),
      }).catch(() => {
        /* lead capture is best-effort; ignore failures */
      });

      // Remember the visitor so re-runs never ask again.
      unlocked = true;
      try {
        sessionStorage.setItem('jdCalcUnlocked', '1');
      } catch (_) {
        /* storage disabled: unlock still holds for this session */
      }
      paintCta();

      // Reveal the Cost Stack results immediately.
      closeGate();
      renderResults();
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

