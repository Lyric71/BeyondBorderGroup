  @media (max-width: 1024px) {
    .mc-value { grid-template-columns: 1fr; gap: var(--space-6); }
  }

  /* ---------- TAKEAWAYS BENTO ---------- */
  .mc-take-section { position: relative; isolation: isolate; }
  .mc-bento {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: var(--space-4);
  }
  .mc-bento__card {
    position: relative;
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    overflow: hidden;
    isolation: isolate;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 280ms ease, box-shadow 280ms ease;
  }
  .mc-bento__card:hover {
    transform: translateY(-4px);
    border-color: var(--bbg-blue);
    box-shadow: 0 16px 32px -20px rgba(38, 154, 218, 0.4);
  }
  .mc-bento__card--small h3 {
    font-size: 1.0625rem;
    line-height: 1.3;
    margin: 0 0 var(--space-2);
    color: var(--bbg-ink);
    letter-spacing: -0.005em;
    position: relative;
    padding-top: var(--space-3);
  }
  .mc-bento__card--small h3::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 28px;
    height: 3px;
    background: var(--bbg-blue);
    border-radius: 2px;
  }
  .mc-bento__card--small p {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--bbg-text);
    margin: 0;
  }
  .mc-bento__card--feature {
    grid-column: 1 / 2;
    grid-row: 1 / 3;
    padding: var(--space-7);
    background: linear-gradient(160deg, #102434 0%, #0c1a26 60%);
    color: var(--bbg-white);
    border-color: rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    overflow: hidden;
  }
  .mc-bento__card--feature:hover {
    border-color: rgba(155, 217, 245, 0.4);
    box-shadow: 0 18px 40px -22px rgba(38, 154, 218, 0.5);
  }
  .mc-bento__card--feature:hover .mc-bento__feature-img {
    transform: scale(1.04);
    opacity: 0.95;
  }
  .mc-bento__feature-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
    opacity: 0.82;
    filter: saturate(0.95) contrast(0.98);
    transform: scale(1.02);
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1), opacity 600ms ease;
  }
  .mc-bento__feature-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(120deg,
        rgba(8, 18, 28, 0.78) 0%,
        rgba(8, 18, 28, 0.55) 45%,
        rgba(8, 18, 28, 0.28) 100%),
      radial-gradient(70% 80% at 0% 100%, rgba(8, 18, 28, 0.55) 0%, rgba(8, 18, 28, 0) 60%),
      radial-gradient(80% 60% at 100% 0%, rgba(38, 154, 218, 0.22) 0%, rgba(38, 154, 218, 0) 60%);
  }
  .mc-bento__feature-body { display: flex; flex-direction: column; gap: var(--space-3); }
  .mc-bento__chip {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9DDBF5;
    background: rgba(38, 154, 218, 0.18);
    padding: 0.4em 0.85em;
    border-radius: 999px;
    border: 1px solid rgba(155, 217, 245, 0.25);
  }
  .mc-bento__card--feature h3 {
    font-size: clamp(1.5rem, 1.4vw + 1rem, 2rem);
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.015em;
    color: var(--bbg-white);
  }
  .mc-bento__card--feature p {
    font-size: 1rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    margin: 0;
  }
  .mc-bento__feature-stats {
    list-style: none;
    padding: var(--space-4) 0 0;
    margin: 0;
    display: flex;
    gap: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .mc-bento__feature-stats li { display: flex; flex-direction: column; gap: 0.25rem; }
  .mc-bento__stat-num {
    font-size: clamp(1.625rem, 1.4vw + 1rem, 2.125rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #9DDBF5;
    font-feature-settings: "tnum";
  }
  .mc-bento__stat-num span {
    font-size: 0.7em;
    margin-left: 0.05em;
    color: rgba(157, 219, 245, 0.7);
  }
  .mc-bento__stat-label {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.02em;
    line-height: 1.4;
  }
  @media (max-width: 1024px) {
    .mc-bento { grid-template-columns: 1fr 1fr; }
    .mc-bento__card--feature { grid-column: 1 / -1; grid-row: auto; }
  }
  @media (max-width: 560px) {
    .mc-bento { grid-template-columns: 1fr; }
    .mc-bento__feature-stats { gap: var(--space-4); flex-wrap: wrap; }
  }

  /* ---------- CURRICULUM (tabbed showcase) ---------- */
  .mc-curriculum {
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .mc-curriculum__nav {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--bbg-surface);
    border-bottom: 1px solid var(--bbg-border);
  }
  .mc-curriculum__tab {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-5);
    background: transparent;
    border: 0;
    border-right: 1px solid var(--bbg-border);
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    color: var(--bbg-text);
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
    position: relative;
  }
  .mc-curriculum__tab:last-child { border-right: 0; }
  .mc-curriculum__tab:hover { background: var(--bbg-white); color: var(--bbg-ink); }
  .mc-curriculum__tab.is-active {
    background: var(--bbg-white);
    color: var(--bbg-ink);
  }
  .mc-curriculum__tab:focus-visible {
    outline: 3px solid var(--bbg-blue);
    outline-offset: -3px;
  }
  .mc-curriculum__tab-icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    background: var(--bbg-blue-light);
    color: var(--bbg-blue);
    flex-shrink: 0;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease), transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mc-curriculum__tab-icon svg { width: 22px; height: 22px; }
  .mc-curriculum__tab.is-active .mc-curriculum__tab-icon {
    background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
    color: var(--bbg-white);
    transform: scale(1.04);
  }
  .mc-curriculum__tab-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .mc-curriculum__tab-label {
    font-weight: 700;
    font-size: 1.0625rem;
    color: inherit;
    letter-spacing: -0.005em;
  }
  .mc-curriculum__tab-sub {
    font-size: 0.82rem;
    color: var(--bbg-text-muted);
    line-height: 1.3;
  }
  .mc-curriculum__indicator {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 3px;
    width: 33.333%;
    background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 100%);
    border-radius: 2px 2px 0 0;
    transform: translateX(0);
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .mc-curriculum__panels {
    padding: clamp(var(--space-5), 3vw + 0.5rem, var(--space-7));
  }
  .mc-curriculum__panel {
    animation: mc-tab-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mc-curriculum__panel[hidden] { display: none; }
  @keyframes mc-tab-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .mc-curriculum__panel-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.7fr);
    gap: clamp(var(--space-5), 3vw, var(--space-7));
    align-items: start;
  }
  /* ---------- Magazine-cover lead card ---------- */
  .mc-curriculum__lead {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bbg-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(8, 18, 28, 0.04),
      0 24px 48px -28px rgba(8, 18, 28, 0.22);
    transform: translateZ(0);
    transition:
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 420ms ease;
    isolation: isolate;
  }
  .mc-curriculum__lead::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(38, 154, 218, 0.12) 0%, rgba(38, 154, 218, 0) 35%);
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 360ms ease;
  }
  .mc-curriculum__lead:hover {
    transform: translateY(-6px);
    box-shadow:
      0 1px 0 rgba(8, 18, 28, 0.04),
      0 32px 60px -22px rgba(38, 154, 218, 0.38);
  }
  .mc-curriculum__lead:hover::before { opacity: 1; }

  .mc-curriculum__lead-figure {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(160deg, #102434 0%, #0c1a26 60%);
  }
  .mc-curriculum__lead-figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.02);
    transition: transform 1100ms cubic-bezier(0.16, 1, 0.3, 1), filter 700ms ease;
    filter: saturate(0.96);
  }
  .mc-curriculum__lead:hover .mc-curriculum__lead-figure img {
    transform: scale(1.08);
    filter: saturate(1.05);
  }
  .mc-curriculum__lead-figure::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg,
        rgba(8, 18, 28, 0) 30%,
        rgba(8, 18, 28, 0.42) 62%,
        rgba(8, 18, 28, 0.88) 100%),
      radial-gradient(60% 50% at 100% 0%,
        rgba(38, 154, 218, 0.3) 0%,
        rgba(38, 154, 218, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .mc-curriculum__lead-tag {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.85rem 0.3rem 0.35rem;
    background: rgba(255, 255, 255, 0.94);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-radius: 999px;
    color: var(--bbg-blue-dark);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 22px -10px rgba(8, 18, 28, 0.35);
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mc-curriculum__lead:hover .mc-curriculum__lead-tag { transform: translateY(-2px); }
  .mc-curriculum__lead-tag-icon {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
    color: var(--bbg-white);
    flex-shrink: 0;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  }
  .mc-curriculum__lead-tag-icon svg { width: 15px; height: 15px; }

  .mc-curriculum__lead-poster {
    position: absolute;
    left: var(--space-5);
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    color: var(--bbg-white);
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mc-curriculum__lead:hover .mc-curriculum__lead-poster { transform: translateY(-3px); }
  .mc-curriculum__lead-eyebrow {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9DDBF5;
    padding-bottom: 0.35rem;
    position: relative;
  }
  .mc-curriculum__lead-eyebrow::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 24px;
    height: 2px;
    background: #9DDBF5;
    border-radius: 1px;
  }
  .mc-curriculum__lead-title {
    margin: 0;
    font-size: clamp(1.35rem, 1.2vw + 0.85rem, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--bbg-white);
    font-weight: 700;
    text-shadow: 0 2px 18px rgba(8, 18, 28, 0.5);
  }

  .mc-curriculum__lead-body {
    position: relative;
    z-index: 1;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex-grow: 1;
  }
  .mc-curriculum__lead-desc {
    margin: 0;
    font-size: 0.975rem;
    line-height: 1.6;
    color: var(--bbg-text);
  }
  .mc-curriculum__lead-meta {
    display: flex;
    align-items: stretch;
    gap: 0;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--bbg-border);
    border-bottom: 1px solid var(--bbg-border);
  }
  .mc-curriculum__lead-meta-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    padding: 0 var(--space-2);
  }
  .mc-curriculum__lead-meta-stat:first-child { padding-left: 0; }
  .mc-curriculum__lead-meta-stat:last-of-type { padding-right: 0; }
  .mc-curriculum__lead-meta-num {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--bbg-blue);
    font-feature-settings: "tnum";
  }
  .mc-curriculum__lead-meta-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bbg-text-muted);
  }
  .mc-curriculum__lead-meta-divider {
    width: 1px;
    background: var(--bbg-border);
    margin: 0 var(--space-4);
  }

  .mc-curriculum__lead-cta {
    align-self: stretch;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin-top: auto;
  }
  .mc-curriculum__lead-cta-arrow {
    display: inline-block;
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mc-curriculum__lead-cta:hover .mc-curriculum__lead-cta-arrow { transform: translateX(4px); }

  .mc-curriculum__topics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5) var(--space-6);
  }
  .mc-curriculum__topic {
    position: relative;
    padding-top: var(--space-3);
  }
  .mc-curriculum__topic::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 28px;
    height: 3px;
    background: var(--bbg-blue);
    border-radius: 2px;
  }
  .mc-curriculum__topic-title {
    font-size: 1.0625rem;
    margin: 0 0 var(--space-3);
    color: var(--bbg-ink);
    letter-spacing: -0.005em;
  }
  .mc-curriculum__topic-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .mc-curriculum__topic-list li {
    position: relative;
    padding-left: 18px;
    font-size: 0.9rem;
    color: var(--bbg-text);
    line-height: 1.55;
  }
  .mc-curriculum__topic-list li::before {
    content: "";
    position: absolute;
    left: 0; top: 9px;
    width: 8px; height: 1px;
    background: var(--bbg-blue);
  }
  @media (max-width: 1024px) {
    .mc-curriculum__panel-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .mc-curriculum__nav { grid-template-columns: 1fr; }
    .mc-curriculum__tab {
      border-right: 0;
      border-bottom: 1px solid var(--bbg-border);
    }
    .mc-curriculum__tab:last-child { border-bottom: 0; }
    .mc-curriculum__indicator { display: none; }
    .mc-curriculum__topics { grid-template-columns: 1fr; }
    .mc-curriculum__lead-figure { aspect-ratio: 4 / 3; }
  }

  /* ---------- TRAINERS ---------- */
  .mc-trainers-section { position: relative; overflow: hidden; }
  .mc-trainers-section::before {
    content: "";
    position: absolute;
    top: -10%;
    right: -5%;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--bbg-blue-light), transparent);
    opacity: 0.5;
    pointer-events: none;
  }
  .mc-trainers {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }
  .mc-trainers__copy p { color: var(--bbg-text); line-height: 1.7; font-size: 1.0625rem; }
  .mc-trainers__copy p + p { margin-top: var(--space-4); }
  .mc-trainers__copy h2 {
    font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: var(--space-3) 0 var(--space-4);
  }
  .mc-trainers__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }
  .mc-trainers__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .mc-trainer {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-5) var(--space-6);
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .mc-trainer:hover {
    border-color: var(--bbg-blue);
    transform: translateX(4px);
    box-shadow: 0 18px 38px -22px rgba(38, 154, 218, 0.4);
  }
  .mc-trainer__avatar {
    width: 72px; height: 72px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bbg-blue-light);
    border: 2px solid var(--bbg-white);
    box-shadow: 0 0 0 1px var(--bbg-border);
    flex-shrink: 0;
  }
  .mc-trainer__avatar img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 20%;
    display: block;
  }
  .mc-trainer__body { display: flex; flex-direction: column; gap: 2px; }
  .mc-trainer__name { font-weight: 600; color: var(--bbg-ink); font-size: 1.125rem; }
  .mc-trainer__role { font-size: var(--fs-small); color: var(--bbg-blue); font-weight: 600; }
  .mc-trainer__meta { font-size: var(--fs-small); color: var(--bbg-text-muted); }
  .mc-trainer__langs {
    font-size: 0.75rem;
    color: var(--bbg-text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 4px;
  }
  @media (max-width: 1024px) {
    .mc-trainers { grid-template-columns: 1fr; }
  }

  /* ---------- FORMAT (programme spec sheet) ---------- */
  .mc-spec {
    max-width: 940px;
    margin: 0 auto;
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .mc-spec__header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: var(--space-4) var(--space-6);
    background: linear-gradient(90deg, var(--bbg-blue-light) 0%, rgba(232, 244, 252, 0.3) 100%);
    border-bottom: 1px solid var(--bbg-border);
  }
  .mc-spec__header-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bbg-blue-dark);
  }
  .mc-spec__header-eyebrow--muted { color: var(--bbg-text-muted); font-weight: 600; }
  .mc-spec__header-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--bbg-blue);
    opacity: 0.6;
  }
  .mc-spec__list {
    margin: 0;
    padding: 0;
  }
  .mc-spec__row {
    display: grid;
    grid-template-columns: minmax(220px, 280px) 1fr;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-5) var(--space-6);
    border-top: 1px solid var(--bbg-border);
    transition: background 220ms ease;
    position: relative;
  }
  .mc-spec__row:first-child { border-top: 0; }
  .mc-spec__row::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--bbg-blue);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mc-spec__row:hover {
    background: var(--bbg-surface);
  }
  .mc-spec__row:hover::before { transform: scaleY(1); }
  .mc-spec__row:hover .mc-spec__icon {
    background: var(--bbg-blue);
    color: var(--bbg-white);
    transform: scale(1.06);
  }
  .mc-spec__key {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
  }
  .mc-spec__icon {
    display: inline-flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: var(--bbg-blue-light);
    color: var(--bbg-blue);
    flex-shrink: 0;
    box-shadow: inset 0 0 0 1px rgba(38, 154, 218, 0.15);
    transition: background 280ms ease, color 280ms ease, transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mc-spec__icon svg { width: 22px; height: 22px; }
  .mc-spec__label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bbg-ink);
  }
  .mc-spec__value {
    margin: 0;
    font-size: 0.975rem;
    line-height: 1.65;
    color: var(--bbg-text);
  }
  .mc-spec__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    background: var(--bbg-surface);
    border-top: 1px solid var(--bbg-border);
  }
  .mc-spec__footer-text {
    font-size: 0.9rem;
    color: var(--bbg-text);
  }
  .mc-spec__footer-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--bbg-blue);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .mc-spec__footer-link:hover { color: var(--bbg-blue-dark); }
  .mc-spec__footer-link:hover span { display: inline-block; transform: translateX(3px); transition: transform var(--dur) var(--ease); }
  @media (max-width: 720px) {
    .mc-spec__header { padding: var(--space-3) var(--space-5); }
    .mc-spec__row {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-5);
      align-items: start;
    }
    .mc-spec__footer { padding: var(--space-4) var(--space-5); }
  }

  /* ---------- FAQ FILTER CHIPS ---------- */
  .mc-faq-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: var(--space-6);
  }
  .mc-faq-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--bbg-text);
    transition: all 220ms ease;
    font-family: inherit;
  }
  .mc-faq-chip:hover { border-color: var(--bbg-blue); color: var(--bbg-blue); }
  .mc-faq-chip.is-active {
    background: var(--bbg-blue);
    border-color: var(--bbg-blue);
    color: var(--bbg-white);
  }
  .mc-faq-chip__count {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15em 0.5em;
    border-radius: 999px;
    background: var(--bbg-surface);
    color: var(--bbg-text-muted);
    transition: all 220ms ease;
  }
  .mc-faq-chip:hover .mc-faq-chip__count { background: var(--bbg-blue-light); color: var(--bbg-blue); }
  .mc-faq-chip.is-active .mc-faq-chip__count {
    background: rgba(255, 255, 255, 0.2);
    color: var(--bbg-white);
  }

  /* ---------- FAQ ITEMS ---------- */
  .mc-faq {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .mc-faq__item {
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 240ms ease, box-shadow 240ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mc-faq__item:hover {
    transform: translateX(2px);
    border-color: rgba(38, 154, 218, 0.4);
  }
  .mc-faq__item[open] {
    border-color: var(--bbg-blue);
    box-shadow: 0 8px 22px -14px rgba(38, 154, 218, 0.4);
  }
  .mc-faq__item.is-hidden { display: none; }
  .mc-faq__q {
    cursor: pointer;
    padding: var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--bbg-ink);
    list-style: none;
    transition: color var(--dur) var(--ease);
  }
  .mc-faq__q::-webkit-details-marker { display: none; }
  .mc-faq__q::marker { display: none; }
  .mc-faq__item:hover .mc-faq__q { color: var(--bbg-blue); }
  .mc-faq__cat-tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bbg-blue);
    background: var(--bbg-blue-light);
    padding: 0.25em 0.6em;
    border-radius: 4px;
    flex-shrink: 0;
  }
  .mc-faq__q-text { flex-grow: 1; }
  .mc-faq__icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--bbg-surface);
    color: var(--bbg-text-muted);
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
                color var(--dur) var(--ease),
                background var(--dur) var(--ease);
  }
  .mc-faq__item[open] .mc-faq__icon {
    transform: rotate(180deg);
    color: var(--bbg-white);
    background: var(--bbg-blue);
  }
  .mc-faq__a {
    padding: 0 var(--space-5) var(--space-5);
    color: var(--bbg-text);
    line-height: 1.65;
    font-size: 1rem;
    animation: mc-faq-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes mc-faq-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .mc-faq__a p { margin: 0; max-width: 72ch; }
  @media (max-width: 560px) {
    .mc-faq__q { flex-wrap: wrap; }
    .mc-faq__q-text { flex-basis: 100%; }
  }

  /* ---------- FINAL CTA ---------- */
  .mc-cta {
    padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8)) var(--space-6);
    background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
    color: var(--bbg-white);
    border-radius: var(--radius-lg);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .mc-cta::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -10%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle at center, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 65%);
    pointer-events: none;
  }
  .mc-cta .eyebrow--on-dark {
    display: inline-block;
    margin-bottom: var(--space-4);
    color: rgba(255, 255, 255, 0.9);
  }
  .mc-cta__title {
    font-size: clamp(1.75rem, 1.5vw + 1rem, 2.5rem);
    line-height: 1.15;
    color: var(--bbg-white);
    margin: 0 0 var(--space-4);
    letter-spacing: -0.015em;
    position: relative;
  }
  .mc-cta__lead {
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.0625rem;
    max-width: 52ch;
    margin: 0 auto var(--space-5);
    line-height: 1.55;
    position: relative;
  }
  .mc-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    position: relative;
  }
  .mc-cta__btn-primary {
    background: var(--bbg-white);
    color: var(--bbg-blue-dark);
    border: 1px solid var(--bbg-white);
  }
  .mc-cta__btn-primary:hover {
    background: rgba(255, 255, 255, 0.92);
    color: var(--bbg-blue-dark);
  }
  .mc-cta__btn-ghost {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: var(--bbg-white);
  }
  .mc-cta__btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--bbg-white);
    color: var(--bbg-white);
  }
</style>

<script is:inline>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Reveal-on-scroll
    const revealEls = document.querySelectorAll('.mc-reveal');
    if (revealEls.length) {
      if (reduced || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        revealEls.forEach((el) => io.observe(el));
      }
    }

    // 2. Animated number counters
    const counters = document.querySelectorAll('[data-counter]');
    if (counters.length && !reduced && 'IntersectionObserver' in window) {
      const animate = (el) => {
        const target = parseFloat(el.dataset.counter || '0');
        const suffix = el.dataset.suffix || '';
        const duration = 1400;
        const start = performance.now();
        const tick = (now) => {
          const t = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - t, 3);
          const value = Math.round(target * eased);
          el.textContent = value + suffix;
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const counterIo = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target);
            counterIo.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });
      counters.forEach((el) => counterIo.observe(el));
    } else {
      counters.forEach((el) => {
        el.textContent = (el.dataset.counter || '0') + (el.dataset.suffix || '');
      });
    }

    // 3. Hero parallax + scroll progress bar
    const parallaxEl = document.querySelector('[data-parallax]');
    const progressEl = document.querySelector('.mc-progress__bar');
    const heroEl = document.querySelector('[data-hero]');
    let ticking = false;

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const scrollY = window.scrollY || window.pageYOffset;

        if (parallaxEl && heroEl && !reduced) {
          const heroH = heroEl.offsetHeight;
          if (scrollY < heroH) {
            parallaxEl.style.setProperty('--parallax-y', (scrollY * 0.18) + 'px');
          }
        }

        if (progressEl) {
          const docH = document.documentElement.scrollHeight - window.innerHeight;
          const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
          progressEl.style.setProperty('--progress', pct + '%');
        }

        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // 4. Smooth scroll for in-page anchors
    document.querySelectorAll('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        const id = link.getAttribute('href');
        if (!id || id === '#') return;
        const target = document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      });
    });

    // 5. Accordion behaviour: auto-close other FAQ items
    const faqItems = document.querySelectorAll('.mc-faq__item');
    faqItems.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (item.open) {
          faqItems.forEach((other) => {
            if (other !== item && other.open) other.open = false;
          });
        }
      });
    });

    // 6. Curriculum tabs
    const mcTabsRoot = document.querySelector('[data-mc-tabs]');
    if (mcTabsRoot) {
      const tabs = Array.from(mcTabsRoot.querySelectorAll('.mc-curriculum__tab'));
      const panels = Array.from(mcTabsRoot.querySelectorAll('.mc-curriculum__panel'));
      const indicator = mcTabsRoot.querySelector('.mc-curriculum__indicator');

      const setActive = (tab) => {
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        const targetId = tab.getAttribute('data-tab-target');
        panels.forEach((p) => {
          const active = p.id === targetId;
          p.classList.toggle('is-active', active);
          if (active) p.removeAttribute('hidden');
          else p.setAttribute('hidden', '');
        });
        if (indicator && tabs.length) {
          const idx = tabs.indexOf(tab);
          const w = 100 / tabs.length;
          indicator.style.width = w + '%';
          indicator.style.transform = `translateX(${idx * 100}%)`;
        }
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => setActive(tab));
        tab.addEventListener('keydown', (e) => {
          const idx = tabs.indexOf(tab);
          if (e.key === 'ArrowRight') {
            e.preventDefault();
            const next = tabs[(idx + 1) % tabs.length];
            next.focus();
            setActive(next);
          } else if (e.key === 'ArrowLeft') {
            e.preventDefault();
            const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
            prev.focus();
            setActive(prev);
          }
        });
      });

      const initialActive = tabs.find((t) => t.classList.contains('is-active')) || tabs[0];
      if (initialActive) setActive(initialActive);
    }

    // 7. FAQ category filter
    const faqFilter = document.querySelector('[data-faq-filter]');
    const faqList = document.querySelector('[data-faq-list]');
    if (faqFilter && faqList) {
      const chips = Array.from(faqFilter.querySelectorAll('.mc-faq-chip'));
      const items = Array.from(faqList.querySelectorAll('.mc-faq__item'));
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const cat = chip.dataset.faqCat;
          chips.forEach((c) => {
            const on = c === chip;
            c.classList.toggle('is-active', on);
            c.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          items.forEach((item) => {
            const matches = cat === 'Tous' || item.dataset.faqCat === cat;
            item.classList.toggle('is-hidden', !matches);
          });
        });
      });
    }
  })();
</script>
