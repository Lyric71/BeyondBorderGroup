---
import Layout from '../../../layouts/Layout.astro';

const heroBadges = [
  'HEC MBA', 'ESCP MBA', 'EU Chamber', 'AmCham', 'Business France', 'SJTU Executive MBA',
];

const heroStats = [
  { value: 15, suffix: '+', label: 'années passées à former des dirigeants' },
  { value: 6, suffix: '', label: 'institutions partenaires' },
  { value: 3, suffix: '', label: 'langues de travail' },
];

const audience = [
  'Dirigeants et country managers qui évaluent une implantation en Chine',
  'Directions marketing et digitales en quête des codes propres au marché chinois',
  'Équipes e-commerce sur le point d\'ouvrir leur présence sur Tmall, JD, Douyin ou RED',
  'Fondateurs et jeunes pousses qui jaugent le potentiel chinois',
  'Responsables marketing internationaux désireux d\'enrichir leur grille de lecture',
];

const takeaways = [
  {
    h: 'Des praticiens, pas des conférenciers',
    p: 'Des intervenants qui pilotent encore aujourd\'hui des boutiques, des budgets médias et des dispositifs de campagne. Ni anciens consultants recyclant leurs supports de l\'année passée, ni théoriciens. Des opérateurs joignables sur WeChat à vingt-trois heures, parce qu\'en Chine la journée ne s\'achève jamais vraiment.',
    feature: true,
  },
  {
    h: 'Études de cas réelles',
    p: 'Des marques qui se sont imposées en Chine, d\'autres qui s\'y sont fracassées. Les deux trajectoires nous intéressent, chiffres à l\'appui.',
  },
  {
    h: 'Chiffres à jour',
    p: 'Plateformes, comportements consommateurs, coûts médias. Données mises à jour à la veille de chaque session : sur ce marché, le trimestre précédent appartient déjà au passé.',
  },
  {
    h: 'Votre cahier des charges, pas le nôtre',
    p: 'Une session calibrée sur votre secteur, votre positionnement prix et la composition de vos équipes. Loin du support générique que l\'on retrouve en ligne.',
  },
  {
    h: 'Outils directement exploitables',
    p: 'Méthodologies, listes de contrôle et modèles activables par vos équipes dès le retour au bureau.',
  },
];

const moduleIcon: Record<string, string> = {
  compass: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>',
  grid: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>',
  target: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>',
};

const modules = [
  {
    icon: 'compass',
    tab: 'Écosystème',
    tabSub: 'Cartographie du marché',
    image: '/Images/learn-china/masterclass/ecosystem.png',
    imageAlt: 'Consommatrice chinoise tenant un smartphone affichant les interfaces Tmall et Douyin, paysage urbain de Shanghai en arrière-plan',
    title: "L'écosystème numérique et e-commerce chinois",
    lead: 'Cartographie du marché. Qui utilise quelle plateforme, comment celles-ci génèrent leurs revenus, et à quel endroit du paysage votre catégorie peut s\'inscrire.',
    topics: [
      {
        h: 'Vue d\'ensemble',
        items: [
          'Données actualisées : population internet, taux de pénétration du e-commerce, ventilation par catégorie',
          'Pratiques mobiles et logique de super-applications',
          'Profils de consommateurs chinois selon le tier urbain, l\'âge et le revenu',
          'Disparités régionales et limites d\'une stratégie uniforme à l\'échelle nationale',
        ],
      },
      {
        h: 'Comportement consommateur',
        items: [
          'Les parcours réels de découverte, de comparaison et d\'achat',
          'L\'articulation effective entre recherche, réseaux sociaux et e-commerce',
          'Les leviers de décision : prix, contenu, confiance, prescription',
          'Le poids relatif du mobile et du social, secteur par secteur',
        ],
      },
      {
        h: 'Tendances du moment',
        items: [
          'Livestream, vidéo courte et commerce social',
          'Intelligence artificielle, personnalisation et essor du GEO sur la recherche chinoise',
          'Ce qui émerge, ce qui plafonne, ce qui appartient déjà au passé',
        ],
      },
    ],
  },
  {
    icon: 'grid',
    tab: 'Plateformes',
    tabSub: 'Le mode d\'emploi, plateforme par plateforme',
    image: '/Images/learn-china/masterclass/platforms.png',
    imageAlt: 'Mise à plat de plusieurs smartphones affichant les interfaces Tmall, JD, Douyin, WeChat et Xiaohongshu',
    title: 'Plateformes',
    lead: 'Les règles propres à chaque plateforme, le profil de marque qu\'elle favorise, et le coût réel d\'une présence opérationnelle.',
    topics: [
      {
        h: 'WeChat',
        items: [
          'Comptes officiels : ouverture, formats éditoriaux et leviers de performance',
          'Mini-Programmes au service du commerce, de la relation client et du CRM',
          'WeChat Pay et fondamentaux de WeCom',
          'Stratégie éditoriale et dispositifs d\'amplification payante',
        ],
      },
      {
        h: 'Plateformes e-commerce',
        items: [
          'Tmall et Tmall Global : modèle économique, commissions, exigences opérationnelles',
          'JD et JD Worldwide : les segments rentables, ceux qui ne le sont pas',
          'Taobao et la strate C2C sous-jacente à Tmall',
          'Douyin e-commerce et commerce social en boucle fermée',
          'Politique de prix, opérations promotionnelles et calendrier commercial',
        ],
      },
      {
        h: 'Plateformes sociales',
        items: [
          'Weibo : encore pertinent pour les relations presse et le seeding',
          'Douyin : formats, logique algorithmique, mécaniques commerciales',
          'Xiaohongshu (RED) : terrain de découverte des catégories et marketing KOC',
          'Zhihu : B2B et catégories à fort enjeu de considération',
          'Bilibili : génération Z, format long et communautés engagées',
        ],
      },
    ],
  },
  {
    icon: 'target',
    tab: 'Bonnes pratiques',
    tabSub: 'Ce qui distingue les marques qui s\'imposent',
    image: '/Images/learn-china/masterclass/best-practice.png',
    imageAlt: 'Scène de studio livestream e-commerce chinois avec un animateur présentant un produit face caméra, courbe de ventes et compteur de spectateurs en surimpression',
    title: 'Bonnes pratiques et études de cas',
    lead: 'Ce que les marques performantes mettent réellement en œuvre. Ce que les lancements en échec ont manqué. Et un plan d\'action que vos équipes rapportent au bureau.',
    topics: [
      {
        h: 'Marketing en Chine',
        items: [
          'Dispositifs d\'influence et programmes KOL à impact commercial mesurable',
          'Stratégies éditoriales déployées sur plusieurs plateformes',
          'Le calendrier promotionnel chinois : 618, Double 11, Nouvel An chinois, 38',
          'Allocation budgétaire et repères de retour sur investissement',
        ],
      },
      {
        h: 'Études de cas',
        items: [
          'Les marques qui se sont installées, et pour quelles raisons',
          'Les erreurs onéreuses à anticiper',
          'Les adaptations locales qui ont fait basculer la trajectoire',
          'Des campagnes virales, disséquées étape par étape',
        ],
      },
      {
        h: 'Passer à l\'action',
        items: [
          'Structurer une équipe Chine, en interne ou en s\'appuyant sur une agence',
          'Sélectionner les partenaires et distributeurs locaux pertinents',
          'Fondamentaux du service client et de la logistique',
          'Essentiels réglementaires et de conformité',
        ],
      },
      {
        h: 'Votre plan d\'action',
        items: [
          'Atelier de stratégie d\'entrée calibré sur votre cahier des charges',
          'Cadrage budgétaire et séquencement des étapes',
          'Une feuille de route sur mesure remise à l\'issue de la session',
        ],
      },
    ],
  },
];

const formatIcon: Record<string, string> = {
  layers: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
  pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  package: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>',
  globe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
  life: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="14.83" y1="9.17" x2="18.36" y2="5.64"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/></svg>',
};

const format = [
  { icon: 'layers', label: 'Contenu', body: 'Personnalisé pour votre secteur : beauté, agroalimentaire, tourisme, automobile, luxe, services. Exemples et études de cas réécrits pour épouser la catégorie sur laquelle vos équipes opèrent.' },
  { icon: 'pin', label: 'Lieu', body: 'Nos consultants se déplacent : Shanghai, Hong Kong, Paris, vos bureaux ou votre séminaire annuel. En présentiel comme à distance.' },
  { icon: 'clock', label: 'Durée', body: 'Journée complète (huit heures), demi-journée (quatre heures), ou format scindé en plusieurs sessions sur quelques semaines.' },
  { icon: 'package', label: 'Livrables', body: 'Supports pédagogiques complets, présentation de la session, et accès direct aux formateurs pour toute question postérieure à l\'atelier.' },
  { icon: 'globe', label: 'Langues', body: 'Anglais, français et mandarin. Sessions bilingues proposées en standard, sans supplément tarifaire.' },
  { icon: 'life', label: 'Après la formation', body: 'Trente jours d\'accompagnement à l\'issue d\'une formation intra-entreprise : réponses par courriel, deux visioconférences et accès continu à nos notes de conjoncture marché.' },
];

const faqs = [
  { cat: 'Programme', q: 'Personnalisez-vous le programme ?', a: 'Oui. Le programme est construit à partir de vos objectifs, de votre secteur d\'activité et de votre degré actuel d\'exposition au marché chinois. Un bref entretien de cadrage en amont suffit à ajuster les modules, les exemples et les études de cas retenus.' },
  { cat: 'Engagement', q: 'Peut-on travailler avec vous comme consultants plutôt que comme formateurs ?', a: 'Oui. Notre cabinet intervient également en conseil stratégique et opérationnel : audits digitaux, stratégies d\'entrée, sélection de distributeurs, déploiement e-commerce. La formation constitue fréquemment l\'amorce d\'une collaboration de plus longue durée.' },
  { cat: 'Programme', q: 'Peut-on choisir des modules spécifiques ?', a: 'Oui. Le programme est conçu de manière modulaire. Nombre de clients optent pour des demi-journées thématiques consacrées à WeChat, aux plateformes e-commerce, au commerce social, ou au seul marketing d\'influence et à la gestion des KOL.' },
  { cat: 'Programme', q: 'Pouvez-vous creuser un sujet précis ?', a: 'Oui. Une session entière peut être consacrée à la stratégie Tmall Global, au livestream commerce, à la boucle fermée Douyin, à Xiaohongshu sur la beauté, ou à toute autre thématique sur laquelle vos équipes attendent un niveau d\'expertise approfondi.' },
  { cat: 'Engagement', q: 'Faites-vous de la formation en intra-entreprise ?', a: 'Oui. Nos formateurs se déplacent dans vos locaux, adaptent le contenu à votre contexte interne et animent la session devant l\'ensemble de vos équipes. Les formats intra-entreprise nourrissent les échanges les plus riches : tous les participants travaillent sur la même réalité commerciale.' },
  { cat: 'Format', q: 'Dans quelles langues formez-vous ?', a: 'Anglais, français et mandarin. Nos formateurs sont bilingues, voire trilingues, ce qui permet de restituer fidèlement les nuances culturelles et commerciales.' },
  { cat: 'Engagement', q: 'Quel accompagnement après la session ?', a: 'Pour les sessions intra-entreprise, trente jours de suivi à compter de la formation : réponses par courriel, deux visioconférences avec l\'équipe et accès à nos notes de mise à jour marché.' },
  { cat: 'Programme', q: 'À quoi ressemble une journée type de formation ?', a: 'Une alternance de modules thématiques, d\'études de cas en direct, de séquences de questions-réponses structurées, d\'exercices appliqués à votre activité et d\'un plan d\'action en clôture. Rythme soutenu, pauses régulières.' },
  { cat: 'Audience', q: 'Faut-il des prérequis ?', a: 'Aucun prérequis technique. Une familiarité minimale avec le marketing digital constitue un atout. L\'essentiel tient à la présence dans la salle d\'un projet concret ou d\'un intérêt avéré pour le marché chinois.' },
  { cat: 'Tarifs', q: 'Quel est le tarif ?', a: 'Les tarifs varient selon le format retenu, la durée, le lieu d\'animation et le nombre de participants. Contactez-nous pour obtenir un devis sur mesure.' },
  { cat: 'Format', q: 'Combien de personnes peuvent participer ?', a: 'De huit à trente participants par session de travail. En deçà de huit, la dynamique d\'échange perd en intensité. Au-delà de trente, les exercices en sous-groupes deviennent ingérables. Pour les journées d\'entreprise ou les conférences plénières rassemblant cinquante à trois cents personnes, nous proposons un format conférencier avec séquences de questions-réponses structurées, sans travail en ateliers.' },
  { cat: 'Format', q: 'Dans quels délais pouvez-vous animer une session ?', a: 'Deux semaines de préavis constituent la fenêtre confortable. Il nous est arrivé d\'animer en cinq jours ouvrés lorsque l\'agenda d\'un comité de direction s\'imposait. Les délais plus serrés se traduisent par moins de souplesse sur les dates et la composition du binôme de formateurs, jamais sur la qualité du contenu.' },
  { cat: 'Format', q: 'Les sessions sont-elles possibles à distance ou réservées au présentiel ?', a: 'Les deux modes sont disponibles. Près de la moitié des sessions intra-entreprise se déroulent désormais en distanciel ou en hybride. Le distanciel donne de meilleurs résultats par séquences de trois à quatre heures réparties sur deux journées, plutôt qu\'en un marathon de visioconférence d\'une journée entière. Le présentiel conserve l\'avantage dès que la session exige des travaux en sous-groupes ou la construction d\'une stratégie au tableau.' },
  { cat: 'Format', q: 'Peut-on enregistrer la session pour les collègues absents ?', a: 'Oui, pour un usage strictement interne. Nous demandons que l\'enregistrement demeure dans le périmètre de votre entreprise, en dehors de tout canal public, et qu\'il ne soit pas reconditionné en contenu commercial à destination de l\'extérieur. Supports et présentations sont fournis dans tous les cas.' },
  { cat: 'Programme', q: 'Que faut-il préparer en amont ?', a: 'Un bref mémo sur votre activité actuelle en Chine, sur les zones d\'ombre que vous identifiez et sur les trois ou quatre questions auxquelles vous attendez en priorité des réponses. À cela s\'ajoutent les données internes que vous acceptez de partager : mix canaux, dispositif agence en place, résultats des campagnes récentes, schéma de distribution. Plus la matière fournie est concrète, plus la session de travail gagne en précision.' },
  { cat: 'Audience', q: 'Quels secteurs avez-vous formés ?', a: 'Beauté, mode, luxe, agroalimentaire, tourisme, automobile, services aux entreprises, industriels B2B, grands acteurs de la tech et éditeurs SaaS. Les mécaniques des plateformes restent globalement comparables d\'une catégorie à l\'autre. Ce qui distingue chaque session, ce sont les études de cas, les références chiffrées et les tactiques que nous y déployons.' },
  { cat: 'Audience', q: 'Nous sommes novices sur le marché chinois. Le programme est-il trop avancé ?', a: 'Non. Le premier module est précisément pensé pour des équipes qui partent d\'une page blanche. La profondeur du contenu est calibrée lors de l\'entretien de cadrage. Un groupe de néophytes consacrera davantage de temps aux fondamentaux des plateformes et aux comportements consommateurs. Un groupe expérimenté avancera plus vite sur la cartographie et approfondira l\'opérationnel et l\'allocation budgétaire.' },
  { cat: 'Audience', q: 'Nous disposons déjà d\'un bureau en Chine. Quelle valeur en retirons-nous ?', a: 'Une valeur significative. Une part importante de nos clients intra-entreprise sont des équipes implantées sur le marché depuis plusieurs années. L\'apport se loge dans le benchmarking, dans des données catégorielles récentes et dans le regard extérieur porté sur les pans du dispositif qui sous-performent en silence. L\'ordre du jour bascule alors du registre introductif vers l\'audit et l\'opérationnel.' },
  { cat: 'Engagement', q: 'Signez-vous des accords de confidentialité ?', a: 'Oui. En amont de tout entretien de cadrage abordant des données chiffrées. Vos informations internes et votre stratégie demeurent dans le périmètre de la salle. Rien ne se retrouve dans une présentation destinée à un autre client, ni dans une étude de cas publique.' },
  { cat: 'Programme', q: 'À quel point le contenu est-il à jour ?', a: 'Mis à jour à la veille de chaque session. Toute donnée antérieure au dernier trimestre clos est signalée comme telle ou retirée du support. Les plateformes chinoises modifient leurs commissions, leurs formats et leurs algorithmes plusieurs fois par an : nous traitons les supports périmés comme un risque pédagogique réel et organisons la préparation en conséquence.' },
];

const faqCategories = ['Tous', 'Programme', 'Format', 'Audience', 'Engagement', 'Tarifs'];
---

<Layout
  title="Masterclass Chine numérique et e-commerce | Beyond Border Group"
  description="Masterclass animée par des praticiens du marché chinois : écosystème numérique, plateformes e-commerce, comportements de consommation et mécaniques de campagne. Conçue sur mesure pour votre secteur d'activité et vos équipes."
>
  <div class="mc-progress" aria-hidden="true"><div class="mc-progress__bar"></div></div>

  <article class="mc">

    {/* ---------- HERO (cinematic) ---------- */}
    <section class="mc-hero cbs-hero" data-hero>
      <div class="mc-hero__bg" aria-hidden="true" data-parallax>
        <img src="/Images/CyrilMasterclass.jpg" alt="Cyril Drouin sur la scène de la Shanghai International MCN Conference" />
      </div>
      <div class="mc-hero__overlay" aria-hidden="true"></div>
      <div class="mc-hero__grain" aria-hidden="true"></div>

      <div class="container mc-hero__inner">
        <nav class="mc-hero__crumbs" aria-label="Fil d'Ariane">
          <a href="/fr">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/fr/comprendre-la-chine">Comprendre la Chine</a>
        </nav>

        <span class="eyebrow eyebrow--on-dark mc-reveal">Comprendre la Chine · Masterclass</span>

        <h1 class="mc-hero__title mc-reveal" style="--reveal-delay: 80ms;">
          <span class="mc-hero__title-row">Une masterclass Chine</span>
          <span class="mc-hero__title-row mc-hero__title-row--accent">animée par des opérationnels,</span>
          <span class="mc-hero__title-row">non par d'anciens</span>
          <span class="mc-hero__title-row mc-hero__title-row--highlight">consultants.</span>
        </h1>

        <p class="mc-hero__lead mc-reveal" style="--reveal-delay: 200ms;">
          Une formation dense consacrée à l'écosystème numérique et au e-commerce chinois :
          plateformes, comportements consommateurs, mécaniques de campagne. Calibrée pour votre secteur,
          animée par des opérationnels forts de vingt années de pratique sur le terrain.
        </p>

        <div class="mc-hero__actions mc-reveal" style="--reveal-delay: 280ms;">
          <a href="/fr/nous-contacter" class="btn btn--primary mc-magnetic">Réserver une masterclass</a>
          <a href="#curriculum" class="btn btn--ghost-light mc-magnetic">Voir le programme</a>
        </div>

        <div class="mc-hero__meta mc-reveal" style="--reveal-delay: 360ms;">
          {heroStats.map((s) => (
            <div class="mc-hero__meta-item">
              <span class="mc-hero__meta-num" data-counter={s.value} data-suffix={s.suffix}>0</span>
              <span class="mc-hero__meta-label">{s.label}</span>
            </div>
          ))}
        </div>

        <ul class="mc-hero__badges mc-reveal" aria-label="Institutions et organisations où nous sommes intervenus" style="--reveal-delay: 440ms;">
          {heroBadges.map(b => <li>{b}</li>)}
        </ul>
      </div>

      <a href="#why" class="mc-hero__scroll" aria-label="Descendre vers la section suivante">
        <span class="mc-hero__scroll-line"></span>
        <span class="mc-hero__scroll-text">Défiler</span>
      </a>
    </section>

    {/* ---------- WHY / AUDIENCE ---------- */}
    <section id="why" class="section section--alt">
      <div class="container">
        <div class="mc-value">
          <div class="mc-value__copy mc-reveal">
            <span class="eyebrow">Pourquoi cette formation</span>
            <h2>Saisir le fonctionnement réel de la Chine, là où s'arrêtent les rapports d'études.</h2>
            <p>
              Une immersion dans le fonctionnement réel de l'écosystème numérique et du commerce en ligne en Chine.
              Vos équipes en ressortent avec une lecture précise des plateformes, des ressorts de consommation
              qui déplacent les ventes et de la mécanique d'une campagne qui convertit réellement.
            </p>
            <p>
              Aucun support recyclé sur les tendances de l'année. Aucun manuel d'opérations importé des États-Unis.
              Les chiffres sont mis à jour avant chaque session, parce que le marché évolue suffisamment vite
              pour rendre obsolète, dès le trimestre suivant, la présentation construite à l'instant.
            </p>
          </div>

          <aside class="mc-promise mc-reveal" style="--reveal-delay: 120ms;" aria-label="Public visé par cette formation">
            <span class="eyebrow">Public visé</span>
            <ul class="mc-promise__list">
              {audience.map((a) => (
                <li class="mc-promise__item">
                  <span class="mc-promise__check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8"/></svg>
                  </span>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {/* ---------- WHAT YOU TAKE AWAY (bento) ---------- */}
    <section class="section mc-take-section">
      <div class="container">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">Ce que vous emportez de la session</span>
          <h2>Une formation qui conserve son utilité bien après la fin de la session.</h2>
          <p class="section-header__lead">
            Cinq raisons qui font revenir les équipes vers nous. La première, peu de structures peuvent honnêtement la revendiquer.
          </p>
        </header>

        <div class="mc-bento">
          {takeaways.map((t, i) => t.feature ? (
            <article class="mc-bento__card mc-bento__card--feature mc-reveal">
              <img
                class="mc-bento__feature-img"
                src="/Images/work/pierre-fabre.png"
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <div class="mc-bento__feature-bg" aria-hidden="true"></div>
              <div class="mc-bento__feature-body">
                <span class="mc-bento__chip">Le signe distinctif</span>
                <h3>{t.h}</h3>
                <p>{t.p}</p>
                <ul class="mc-bento__feature-stats">
                  <li>
                    <span class="mc-bento__stat-num">20<span>+</span></span>
                    <span class="mc-bento__stat-label">années sur le terrain</span>
                  </li>
                  <li>
                    <span class="mc-bento__stat-num">100<span>%</span></span>
                    <span class="mc-bento__stat-label">de sessions animées par des opérationnels, sans exception</span>
                  </li>
                </ul>
              </div>
            </article>
          ) : (
            <article class="mc-bento__card mc-bento__card--small mc-reveal" style={`--reveal-delay: ${i * 70}ms;`}>
              <h3>{t.h}</h3>
              <p>{t.p}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- CURRICULUM (tabbed) ---------- */}
    <section class="section section--alt" id="curriculum">
      <div class="container">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">Programme</span>
          <h2>Trois modules. À vous d'en arbitrer la profondeur, à vous d'en choisir le format.</h2>
          <p class="section-header__lead">
            Une journée complète, des demi-journées indépendantes, ou un parcours déployé dans la durée.
            Approfondissement des sujets décisifs pour votre catégorie, traitement plus rapide de ceux qui le sont moins.
          </p>
        </header>

        <div class="mc-curriculum mc-reveal" data-mc-tabs>
          <div class="mc-curriculum__nav" role="tablist" aria-label="Modules du programme">
            {modules.map((m, i) => (
              <button
                type="button"
                class={`mc-curriculum__tab${i === 0 ? ' is-active' : ''}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`mc-module-panel-${i}`}
                id={`mc-module-tab-${i}`}
                data-tab-target={`mc-module-panel-${i}`}
              >
                <span class="mc-curriculum__tab-icon" aria-hidden="true" set:html={moduleIcon[m.icon]} />
                <span class="mc-curriculum__tab-body">
                  <span class="mc-curriculum__tab-label">{m.tab}</span>
                  <span class="mc-curriculum__tab-sub">{m.tabSub}</span>
                </span>
              </button>
            ))}
            <span class="mc-curriculum__indicator" aria-hidden="true"></span>
          </div>

          <div class="mc-curriculum__panels">
            {modules.map((m, i) => (
              <div
                class={`mc-curriculum__panel${i === 0 ? ' is-active' : ''}`}
                role="tabpanel"
                id={`mc-module-panel-${i}`}
                aria-labelledby={`mc-module-tab-${i}`}
                hidden={i !== 0}
              >
                <div class="mc-curriculum__panel-grid">
                  <aside class="mc-curriculum__lead" data-tilt>
                    <figure class="mc-curriculum__lead-figure">
                      <img src={m.image} alt={m.imageAlt} loading="lazy" decoding="async" width="640" height="800" />
                      <span class="mc-curriculum__lead-tag">
                        <span class="mc-curriculum__lead-tag-icon" aria-hidden="true" set:html={moduleIcon[m.icon]} />
                        <span class="mc-curriculum__lead-tag-text">{m.tab}</span>
                      </span>
                      <div class="mc-curriculum__lead-poster">
                        <span class="mc-curriculum__lead-eyebrow">Module</span>
                        <h3 class="mc-curriculum__lead-title">{m.title}</h3>
                      </div>
                    </figure>

                    <div class="mc-curriculum__lead-body">
                      <p class="mc-curriculum__lead-desc">{m.lead}</p>
                      <div class="mc-curriculum__lead-meta">
                        <span class="mc-curriculum__lead-meta-stat">
                          <span class="mc-curriculum__lead-meta-num">{m.topics.length}</span>
                          <span class="mc-curriculum__lead-meta-label">sujets</span>
                        </span>
                        <span class="mc-curriculum__lead-meta-divider" aria-hidden="true"></span>
                        <span class="mc-curriculum__lead-meta-stat">
                          <span class="mc-curriculum__lead-meta-num">½ &middot; 1</span>
                          <span class="mc-curriculum__lead-meta-label">formats journée</span>
                        </span>
                      </div>
                      <a href="/fr/nous-contacter" class="btn btn--primary btn--sm mc-magnetic mc-curriculum__lead-cta">
                        <span>Adapter ce module</span>
                        <span class="mc-curriculum__lead-cta-arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  </aside>

                  <div class="mc-curriculum__topics">
                    {m.topics.map((t) => (
                      <div class="mc-curriculum__topic">
                        <h4 class="mc-curriculum__topic-title">{t.h}</h4>
                        <ul class="mc-curriculum__topic-list">
                          {t.items.map((i) => <li>{i}</li>)}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ---------- TRAINERS ---------- */}
    <section class="section mc-trainers-section">
      <div class="container">
        <div class="mc-trainers">
          <div class="mc-trainers__copy mc-reveal">
            <span class="eyebrow">Qui anime</span>
            <h2>Des opérationnels, pas des universitaires.</h2>
            <p>
              Cyril forme des dirigeants au marché numérique chinois, en anglais comme en français,
              depuis plus d'une décennie. Liyan en assure la version sinophone, dans le même esprit.
              Ensemble, ils sont intervenus auprès des MBA d'HEC et de l'ESCP, de la Chambre de commerce
              européenne en Chine, de la Chambre américaine, de Business France et du MBA Exécutif de Shanghai Jiaotong.
            </p>
            <div class="mc-trainers__actions">
              <a href="/fr/qui-nous-sommes" class="btn btn--secondary">Rencontrer l'équipe</a>
              <a href="/fr/nous-contacter" class="btn btn--ghost">Échanger avec un formateur</a>
            </div>
          </div>

          <ul class="mc-trainers__list mc-reveal" style="--reveal-delay: 120ms;" aria-label="Formateurs principaux">
            <li class="mc-trainer">
              <span class="mc-trainer__avatar">
                <img
                  src="/Images/team/cyril-drouin.jpg"
                  alt="Portrait de Cyril Drouin"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <div class="mc-trainer__body">
                <span class="mc-trainer__name">Cyril Drouin</span>
                <span class="mc-trainer__role">Fondateur et CEO</span>
                <span class="mc-trainer__meta">Shanghai / Paris</span>
                <span class="mc-trainer__langs">Anglais · Français</span>
              </div>
            </li>
            <li class="mc-trainer">
              <span class="mc-trainer__avatar">
                <img
                  src="/Images/team/liyan-ye.jpg"
                  alt="Portrait de Liyan Ye"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <div class="mc-trainer__body">
                <span class="mc-trainer__name">Liyan Ye</span>
                <span class="mc-trainer__role">Directrice senior</span>
                <span class="mc-trainer__meta">Shanghai</span>
                <span class="mc-trainer__langs">Mandarin · Anglais</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    {/* ---------- FORMAT / LOGISTICS (spec sheet) ---------- */}
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">Format et logistique</span>
          <h2>Calibré sur l'agenda de vos équipes.</h2>
          <p class="section-header__lead">
            Six paramètres à arbitrer avant d'entrer en salle : contenu, lieu, durée,
            langues, livrables, et accompagnement post-session.
          </p>
        </header>

        <div class="mc-spec mc-reveal">
          <div class="mc-spec__header" aria-hidden="true">
            <span class="mc-spec__header-eyebrow">Fiche programme</span>
            <span class="mc-spec__header-dot"></span>
            <span class="mc-spec__header-eyebrow mc-spec__header-eyebrow--muted">Six variables, entièrement modulables</span>
          </div>
          <dl class="mc-spec__list">
            {format.map((f, i) => (
              <div class="mc-spec__row" style={`--row-delay: ${i * 40}ms;`}>
                <dt class="mc-spec__key">
                  <span class="mc-spec__icon" aria-hidden="true" set:html={formatIcon[f.icon]} />
                  <span class="mc-spec__label">{f.label}</span>
                </dt>
                <dd class="mc-spec__value">{f.body}</dd>
              </div>
            ))}
          </dl>
          <footer class="mc-spec__footer">
            <span class="mc-spec__footer-text">Un autre format à imaginer ? Nous construisons le cahier des charges avec vos équipes.</span>
            <a href="/fr/nous-contacter" class="mc-spec__footer-link">Nous écrire <span aria-hidden="true">→</span></a>
          </footer>
        </div>
      </div>
    </section>

    {/* ---------- FAQ (with category filter) ---------- */}
    <section class="section">
      <div class="container container--narrow">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">FAQ</span>
          <h2>Vingt questions qui reviennent chaque semaine.</h2>
          <p class="section-header__lead">
            Les interrogations concrètes des équipes qui étudient une masterclass. Filtrage par thématique.
          </p>
        </header>

        <div class="mc-faq-filter mc-reveal" data-faq-filter role="tablist" aria-label="Filtrer les FAQ par catégorie">
          {faqCategories.map((c, i) => (
            <button
              type="button"
              class={`mc-faq-chip${i === 0 ? ' is-active' : ''}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-faq-cat={c}
            >
              <span class="mc-faq-chip__label">{c}</span>
              <span class="mc-faq-chip__count">{c === 'Tous' ? faqs.length : faqs.filter((f) => f.cat === c).length}</span>
            </button>
          ))}
        </div>

        <div class="mc-faq" data-faq-list>
          {faqs.map((f, i) => (
            <details
              class="mc-faq__item mc-reveal"
              data-faq-cat={f.cat}
              open={i === 0}
              style={`--reveal-delay: ${Math.min(i, 6) * 40}ms;`}
            >
              <summary class="mc-faq__q">
                <span class="mc-faq__cat-tag">{f.cat}</span>
                <span class="mc-faq__q-text">{f.q}</span>
                <span class="mc-faq__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <div class="mc-faq__a">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- FINAL CTA ---------- */}
    <section class="section section--tight">
      <div class="container container--narrow">
        <div class="mc-cta">
          <span class="eyebrow eyebrow--on-dark">Échangeons</span>
          <h2 class="mc-cta__title">Vous étudiez une masterclass Chine pour vos équipes ?</h2>
          <p class="mc-cta__lead">
            Présentez-nous votre équipe, votre secteur et les enseignements que vous souhaitez rapporter.
            Une proposition sur mesure vous parvient sous un jour ouvré.
          </p>
          <div class="mc-cta__actions">
            <a href="/fr/nous-contacter" class="btn mc-cta__btn-primary">Réserver une masterclass</a>
            <a href="/fr/nos-realisations" class="btn mc-cta__btn-ghost">Voir nos réalisations</a>
          </div>
        </div>
      </div>
    </section>

  </article>

</Layout>

<style is:global>
  /* ---------- Container helper ---------- */
