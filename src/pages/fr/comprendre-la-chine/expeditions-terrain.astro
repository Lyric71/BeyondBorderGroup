          src="/Images/learn-china/hero-livestream-expedition.png"
          alt="Une délégation de dirigeants étrangers observe un plateau de livestream commerce à Shanghai, lors d’une expédition terrain"
        />
      </div>
      <div class="cbs-hero__overlay" aria-hidden="true"></div>
      <div class="cbs-hero__grain" aria-hidden="true"></div>

      <div class="container cbs-hero__inner">
        <nav class="cbs-hero__crumbs" aria-label="Fil d'Ariane">
          <a href="/fr">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/fr/comprendre-la-chine">Comprendre la Chine</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark cbs-reveal">Expéditions terrain</span>
