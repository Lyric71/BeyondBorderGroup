const faqs = [
  {
    cat: 'Programme',
    q: 'Dans quelle mesure le programme est-il personnalisé ?',
    a: 'Chaque expédition se construit autour du cahier des charges que vous transmettez. Un entretien de cadrage ouvre la séquence, suivi d’un agenda provisoire remis sous cinq jours ouvrés, puis de deux itérations avant validation définitive. Des canevas existent pour les équipes qui souhaitent avancer plus vite, mais la majorité de nos clients optent pour un programme entièrement sur mesure.',
  },
  {
    cat: 'Programme',
    q: 'Pouvez-vous calibrer le programme sur notre secteur ?',
    a: 'Oui. Nos expéditions ont couvert la beauté, la mode, l’agroalimentaire, l’automobile, le luxe, la maison, l’enfance, l’univers animalier et la santé. Visites, intervenants et études de cas sont sélectionnés pour votre catégorie, et non puisés dans un catalogue générique.',
  },
  {
    cat: 'Programme',
