      color: var(--bbg-white);
    }
  </style>

  <script>
    // Scroll progress bar
    const progressBar = document.querySelector('.lcp-progress__bar') as HTMLElement | null;
    const onScroll = () => {
      if (!progressBar) return;
      const h = document.documentElement;
      const scrolled = h.scrollTop;
      const max = h.scrollHeight - h.clientHeight;
      const pct = max > 0 ? (scrolled / max) * 100 : 0;
      progressBar.style.setProperty('--progress', `${pct}%`);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Reveal on intersect
    const reveals = document.querySelectorAll<HTMLElement>('.lcp-reveal');
    const revealObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            revealObs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    reveals.forEach((el) => revealObs.observe(el));

    // Hero parallax
    const parallax = document.querySelector<HTMLElement>('[data-parallax]');
    if (parallax) {
      const onParallax = () => {
        const y = window.scrollY * 0.18;
        parallax.style.setProperty('--parallax-y', `${y}px`);
      };
      window.addEventListener('scroll', onParallax, { passive: true });
      onParallax();
    }

    // Journey: dot activation + rail fill
    const journey = document.querySelector<HTMLElement>('[data-journey]');
    const journeyFill = document.querySelector<HTMLElement>('[data-journey-fill]');
    const journeyItems = document.querySelectorAll<HTMLElement>('[data-journey-item]');
    if (journey && journeyFill && journeyItems.length) {
      const updateJourney = () => {
        const rect = journey.getBoundingClientRect();
        const vh = window.innerHeight;
        const start = rect.top + window.scrollY - vh * 0.6;
        const end = rect.bottom + window.scrollY - vh * 0.5;
        const total = end - start;
        const current = Math.max(0, Math.min(1, (window.scrollY - start) / total));
        journeyFill.style.setProperty('--journey-progress', `${current * 100}%`);

        journeyItems.forEach((item, idx) => {
          const trigger = start + (total * idx) / journeyItems.length;
          if (window.scrollY > trigger) {
            item.classList.add('is-active');
          } else {
            item.classList.remove('is-active');
          }
        });
      };
      window.addEventListener('scroll', updateJourney, { passive: true });
      updateJourney();
    }

    // Sales mechanics: tabbed showcase
    const stage = document.querySelector<HTMLElement>('[data-mech-stage]');
    if (stage) {
      const tabs = stage.querySelectorAll<HTMLButtonElement>('[data-mech-tab]');
      const panels = stage.querySelectorAll<HTMLElement>('[data-mech-panel]');

      const switchTo = (id: string) => {
        tabs.forEach((tab) => {
          const active = tab.dataset.mechTab === id;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
          if (active) {
            const color = tab.dataset.mechColor;
            const soft = tab.dataset.mechSoft;
            const accent = tab.dataset.mechAccent;
            if (color) stage.style.setProperty('--brand', color);
            if (soft) stage.style.setProperty('--brand-soft', soft);
            if (accent) stage.style.setProperty('--brand-accent', accent);
          }
        });
        panels.forEach((panel) => {
          const active = panel.dataset.mechPanel === id;
          panel.classList.toggle('is-active', active);
          if (active) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const id = tab.dataset.mechTab;
          if (id) switchTo(id);
        });
      });

      // Keyboard navigation: ArrowLeft / ArrowRight to cycle through tabs
      stage.addEventListener('keydown', (e) => {
        const evt = e as KeyboardEvent;
        if (evt.key !== 'ArrowLeft' && evt.key !== 'ArrowRight') return;
        const activeTab = stage.querySelector<HTMLButtonElement>('[data-mech-tab].is-active');
        if (!activeTab) return;
        const list = Array.from(tabs);
        const idx = list.indexOf(activeTab);
        const next = evt.key === 'ArrowRight' ? (idx + 1) % list.length : (idx - 1 + list.length) % list.length;
        const nextTab = list[next];
        if (nextTab && nextTab.dataset.mechTab) {
          switchTo(nextTab.dataset.mechTab);
          nextTab.focus();
        }
      });
    }

    // TheRedScroll: live Shanghai clock in status pill
    const trsClock = document.querySelector<HTMLElement>('[data-trs-clock]');
    if (trsClock) {
      const tickClock = () => {
        const now = new Date();
        const sh = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Shanghai' }));
        const hh = String(sh.getHours()).padStart(2, '0');
        const mm = String(sh.getMinutes()).padStart(2, '0');
        trsClock.textContent = `${hh}:${mm} · Shanghai`;
      };
      tickClock();
      setInterval(tickClock, 1000 * 30);
    }

    // TheRedScroll: count-up stats on intersection
    const trsStats = document.querySelector<HTMLElement>('[data-trs-stats]');
    if (trsStats) {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const animateNumber = (el: HTMLElement, target: number, suffix: string) => {
        if (reducedMotion) {
          el.textContent = `${target}${suffix}`;
          return;
        }
        const duration = 1600;
        const start = performance.now();
        const ease = (t: number) => 1 - Math.pow(1 - t, 3);
        const step = (now: number) => {
          const elapsed = Math.min(1, (now - start) / duration);
          const value = Math.round(target * ease(elapsed));
          el.textContent = `${value}${suffix}`;
          if (elapsed < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const statsObs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const nums = entry.target.querySelectorAll<HTMLElement>('.lcp-trs__stat-num[data-count]');
            nums.forEach((num) => {
              const target = parseInt(num.dataset.count || '0', 10);
              const suffix = num.dataset.suffix || '';
              animateNumber(num, target, suffix);
            });
            statsObs.unobserve(entry.target);
          });
        },
        { threshold: 0.35 }
      );
      statsObs.observe(trsStats);
    }

    // Device tilt: 3D mouse-follow on phones and browser mockups
    const tiltTargets = document.querySelectorAll<HTMLElement>('[data-tilt-target]');
    const mediaQueryReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!mediaQueryReduced.matches) {
      tiltTargets.forEach((target) => {
        const parent = target.parentElement;
        if (!parent) return;

        let raf = 0;
        let baseTransform = '';

        const onMove = (e: MouseEvent) => {
          const rect = parent.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width;
          const y = (e.clientY - rect.top) / rect.height;
          const rotY = (x - 0.5) * 14;
          const rotX = (0.5 - y) * 10;

          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            target.style.transform = `${baseTransform} perspective(1200px) rotateX(${rotX}deg) rotateY(${rotY}deg)`;
          });
        };

        const onLeave = () => {
          cancelAnimationFrame(raf);
          target.style.transform = baseTransform;
        };

        // Preserve any inline base transform (e.g. rotate(-1.5deg) on the browser mockup)
        baseTransform = getComputedStyle(target).transform;
        if (baseTransform === 'none') baseTransform = '';

        parent.addEventListener('mousemove', onMove);
        parent.addEventListener('mouseleave', onLeave);
      });
    }

    // TheRedScroll: count-up stats + live Shanghai clock + radial hover on pillars
    const trs = document.querySelector<HTMLElement>('[data-trs]');
    if (trs) {
      // Count-up on stats when in view
      const statsGroup = trs.querySelector<HTMLElement>('[data-trs-stats]');
      if (statsGroup) {
        const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
        const animateNum = (el: HTMLElement) => {
          const target = parseInt(el.dataset.count || '0', 10);
          if (!target || el.dataset.done === '1') return;
          el.dataset.done = '1';
          const suffix = el.dataset.suffix || '';
          const duration = 1400;
          const start = performance.now();
          const tick = (now: number) => {
            const p = Math.min(1, (now - start) / duration);
            const value = Math.round(target * easeOut(p));
            el.textContent = `${value}${suffix}`;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const statsObs = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target
                .querySelectorAll<HTMLElement>('.lcp-trs__stat-num[data-count]')
                .forEach((n) => animateNum(n));
              statsObs.unobserve(entry.target);
            });
          },
          { threshold: 0.35 }
        );
        statsObs.observe(statsGroup);
      }

      // Live Shanghai clock (Asia/Shanghai, refresh every 30s)
      const clock = trs.querySelector<HTMLElement>('[data-trs-clock]');
      if (clock) {
        const fmt = new Intl.DateTimeFormat('en-GB', {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZone: 'Asia/Shanghai',
        });
        const tickClock = () => {
          clock.textContent = `${fmt.format(new Date())} · Shanghai`;
        };
        tickClock();
        setInterval(tickClock, 30000);
      }

      // Radial hover spotlight on pillars
      const pillars = trs.querySelectorAll<HTMLElement>('.lcp-trs__pillar');
      if (!mediaQueryReduced.matches) {
        pillars.forEach((p) => {
          p.addEventListener('mousemove', (e) => {
            const r = p.getBoundingClientRect();
            const mx = ((e.clientX - r.left) / r.width) * 100;
            const my = ((e.clientY - r.top) / r.height) * 100;
            p.style.setProperty('--mx', `${mx}%`);
            p.style.setProperty('--my', `${my}%`);
          });
        });
      }
    }
  </script>
</Layout>
