    /* Layout: sidebar + main */
    .lcp-mech-layout {
      display: grid;
      grid-template-columns: 300px 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }

    /* Vertical sidebar nav */
    .lcp-mech-nav {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      position: sticky;
      top: 96px;
    }
    .lcp-mech-nav__label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      padding: 0 0.5rem;
      margin-bottom: 0.35rem;
    }
    .lcp-mech-navitem {
      position: relative;
      display: grid;
      grid-template-columns: 44px 1fr 18px;
      gap: 0.85rem;
      align-items: center;
      width: 100%;
      padding: 0.85rem 0.9rem 0.85rem 1rem;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 14px;
      color: var(--bbg-text);
      cursor: pointer;
      text-align: left;
      font-family: inherit;
      transition: border-color 240ms ease, color 240ms ease, transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 240ms ease, background 240ms ease;
    }
    .lcp-mech-navitem::before {
      content: "";
      position: absolute;
      left: 0;
      top: 12px;
      bottom: 12px;
      width: 4px;
      border-radius: 0 4px 4px 0;
      background: var(--brand, var(--bbg-blue));
      transform: scaleY(0);
      transform-origin: center;
      transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .lcp-mech-navitem:hover {
      border-color: color-mix(in srgb, var(--brand, var(--bbg-blue)) 45%, var(--bbg-border));
      transform: translateX(2px);
      box-shadow: 0 8px 20px -14px color-mix(in srgb, var(--brand, var(--bbg-blue)) 55%, transparent);
    }
    .lcp-mech-navitem.is-active {
      border-color: var(--brand, var(--bbg-blue));
      background: color-mix(in srgb, var(--brand-soft, var(--bbg-blue-light)) 60%, var(--bbg-white));
      box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--brand, var(--bbg-blue)) 55%, transparent);
    }
    .lcp-mech-navitem.is-active::before { transform: scaleY(1); }
    .lcp-mech-navitem.is-active .lcp-mech-navitem__arrow {
      color: var(--brand, var(--bbg-blue));
      transform: translateX(2px);
    }
    .lcp-mech-navitem__logo {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--brand, var(--bbg-blue));
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      padding: 10px;
      box-shadow: 0 6px 14px -8px color-mix(in srgb, var(--brand, var(--bbg-blue)) 65%, transparent);
    }
    .lcp-mech-navitem__logo img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      filter: brightness(0) invert(1);
    }
    .lcp-mech-navitem__body {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      min-width: 0;
    }
    .lcp-mech-navitem__name {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      color: var(--bbg-ink);
      line-height: 1.2;
      display: inline-flex;
      align-items: baseline;
      gap: 0.45rem;
    }
    .lcp-mech-navitem__cn {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--brand, var(--bbg-text-muted));
      opacity: 0.85;
    }
    .lcp-mech-navitem__teaser {
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      line-height: 1.4;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .lcp-mech-navitem__arrow {
      width: 18px;
      height: 18px;
      color: var(--bbg-text-muted);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: color 200ms ease, transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .lcp-mech-navitem__arrow svg { width: 18px; height: 18px; }

    /* Panels */
    .lcp-mech-panels { position: relative; }
    .lcp-mech-panel[hidden] { display: none; }
    .lcp-mech-panel {
      animation: lcp-mech-fade-in 480ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes lcp-mech-fade-in {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .lcp-mech-panel__grid {
      display: grid;
      grid-template-columns: 0.85fr 1fr;
      gap: clamp(var(--space-5), 4vw, var(--space-8));
      align-items: center;
    }

    /* Phone */
    .lcp-mech-panel__phone-wrap {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-4);
    }
    .lcp-mech-panel__phone {
      position: relative;
      width: clamp(220px, 24vw, 300px);
      aspect-ratio: 9 / 18.5;
      padding: 10px 8px 12px;
      border-radius: 36px;
      background: linear-gradient(155deg, #2c2e33 0%, #1a1c20 45%, #0c0d10 100%);
      box-shadow:
        0 36px 70px -22px rgba(8, 18, 28, 0.55),
        0 14px 26px -14px rgba(8, 18, 28, 0.35),
        inset 0 0 0 1.5px rgba(255, 255, 255, 0.06),
        inset 0 0 0 4px #0a0b0e;
      transform-style: preserve-3d;
      will-change: transform;
      transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .lcp-mech-panel__phone-notch {
      position: absolute;
      top: 14px;
      left: 50%;
      transform: translateX(-50%);
      width: 30%;
      height: 20px;
      background: #050608;
      border-radius: 14px;
      z-index: 3;
      pointer-events: none;
    }
    .lcp-mech-panel__phone-home {
      position: absolute;
      bottom: 4px;
      left: 50%;
      transform: translateX(-50%);
      width: 36%;
      height: 4px;
      background: rgba(255, 255, 255, 0.92);
      border-radius: 2px;
      z-index: 3;
      pointer-events: none;
    }
    .lcp-mech-panel__phone-screen {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 26px;
      overflow: hidden;
      background: var(--bbg-white);
    }
    .lcp-mech-panel__phone-screen img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
    }

    /* Hotspots */
    .lcp-mech-hotspot {
      position: absolute;
      width: 22px;
      height: 22px;
      transform: translate(-50%, -50%);
      pointer-events: auto;
      z-index: 4;
      animation: lcp-hotspot-in 600ms cubic-bezier(0.16, 1, 0.3, 1) var(--hotspot-delay, 0ms) both;
    }
    @keyframes lcp-hotspot-in {
      from { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
      to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    }
    .lcp-mech-hotspot__pulse {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--brand, var(--bbg-blue));
      opacity: 0.45;
      animation: lcp-hotspot-pulse 1.8s ease-out infinite;
    }
    @keyframes lcp-hotspot-pulse {
      0% { transform: scale(0.6); opacity: 0.6; }
      100% { transform: scale(2.4); opacity: 0; }
    }
    .lcp-mech-hotspot__dot {
      position: absolute;
      inset: 5px;
      border-radius: 50%;
      background: var(--brand, var(--bbg-blue));
      box-shadow: 0 0 0 2px var(--bbg-white),
                  0 4px 8px -2px color-mix(in srgb, var(--brand, var(--bbg-blue)) 55%, transparent);
    }
    .lcp-mech-hotspot__tooltip {
      position: absolute;
      left: 50%;
      bottom: calc(100% + 8px);
      transform: translateX(-50%) translateY(4px);
      background: var(--bbg-ink);
      color: var(--bbg-white);
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      padding: 0.35rem 0.6rem;
      border-radius: 6px;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity 200ms ease, transform 200ms ease;
    }
    .lcp-mech-hotspot__tooltip::after {
      content: "";
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      border: 4px solid transparent;
      border-top-color: var(--bbg-ink);
    }
    .lcp-mech-hotspot:hover .lcp-mech-hotspot__tooltip {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* Panel content */
    .lcp-mech-panel__content {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .lcp-mech-panel__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--brand, var(--bbg-blue));
      align-self: flex-start;
      padding: 0.45rem 0.85rem;
      border-radius: 999px;
      background: var(--brand-soft, var(--bbg-blue-light));
    }
    .lcp-mech-panel__eyebrow-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--brand, var(--bbg-blue));
    }
    .lcp-mech-panel__eyebrow-cn {
      font-weight: 600;
      letter-spacing: 0.06em;
      opacity: 0.85;
    }
    .lcp-mech-panel__title {
      font-size: clamp(1.5rem, 1.6vw + 1rem, 2.125rem);
      line-height: 1.12;
      letter-spacing: -0.02em;
      margin: 0;
      color: var(--bbg-ink);
    }
    .lcp-mech-panel__body {
      font-size: 1rem;
      line-height: 1.65;
      color: var(--bbg-text);
      margin: 0;
      max-width: 56ch;
    }

    /* Chips */
    .lcp-mech-chips {
      list-style: none;
      padding: 0;
      margin: var(--space-2) 0 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .lcp-mech-chip {
      position: relative;
      display: grid;
      grid-template-columns: 32px 1fr 18px;
      gap: 0.85rem;
      align-items: center;
      padding: 0.85rem 1rem;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 14px;
      transition: border-color 240ms ease, transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 240ms ease, background 240ms ease;
      animation: lcp-chip-in 520ms cubic-bezier(0.16, 1, 0.3, 1) var(--chip-delay, 0ms) both;
    }
    @keyframes lcp-chip-in {
      from { opacity: 0; transform: translateX(-12px); }
      to { opacity: 1; transform: translateX(0); }
    }
    .lcp-mech-chip:hover {
      transform: translateX(4px);
      border-color: var(--brand, var(--bbg-blue));
      background: color-mix(in srgb, var(--brand-soft, var(--bbg-blue-light)) 40%, var(--bbg-white));
      box-shadow: 0 10px 22px -14px color-mix(in srgb, var(--brand, var(--bbg-blue)) 55%, transparent);
    }
    .lcp-mech-chip__icon {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--brand, var(--bbg-blue));
      color: var(--bbg-white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .lcp-mech-chip__icon svg { width: 16px; height: 16px; }
    .lcp-mech-chip__text { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
    .lcp-mech-chip__label {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .lcp-mech-chip__sub {
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      line-height: 1.4;
    }
    .lcp-mech-chip__arrow {
      font-size: 1rem;
      color: var(--bbg-text-muted);
      transition: color 200ms ease, transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .lcp-mech-chip:hover .lcp-mech-chip__arrow {
      color: var(--brand, var(--bbg-blue));
      transform: translateX(4px);
    }

    .lcp-mech-panel__cta {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      align-self: flex-start;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--brand, var(--bbg-blue));
      padding: 0.5rem 0.85rem;
      border-radius: 999px;
      background: transparent;
      border: 1px dashed color-mix(in srgb, var(--brand, var(--bbg-blue)) 40%, transparent);
      margin-top: var(--space-2);
      transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
    }
    .lcp-mech-panel__cta:hover {
      background: var(--brand-soft, var(--bbg-blue-light));
      border-color: var(--brand, var(--bbg-blue));
      color: var(--brand, var(--bbg-blue));
    }

    @media (max-width: 1024px) {
      .lcp-mech-layout {
        grid-template-columns: 1fr;
        gap: var(--space-5);
      }
      .lcp-mech-nav {
        position: relative;
        top: auto;
        flex-direction: row;
        overflow-x: auto;
        gap: 0.5rem;
        padding: 0.25rem 0.5rem 0.5rem;
        margin: 0 -0.5rem;
        scroll-snap-type: x mandatory;
      }
      .lcp-mech-nav__label { display: none; }
      .lcp-mech-navitem {
        flex-shrink: 0;
        scroll-snap-align: start;
        min-width: 240px;
        grid-template-columns: 38px 1fr 18px;
        padding: 0.7rem 0.85rem 0.7rem 0.95rem;
      }
      .lcp-mech-navitem__logo { width: 38px; height: 38px; padding: 8px; }
    }
    @media (max-width: 1024px) {
      .lcp-mech-panel__grid { grid-template-columns: 1fr; }
      .lcp-mech-panel__phone-wrap { padding: 0; }
      .lcp-mech-panel__phone { width: clamp(200px, 50vw, 260px); }
    }
    @media (max-width: 560px) {
      .lcp-mech-navitem { min-width: 220px; padding: 0.65rem 0.7rem 0.65rem 0.85rem; }
      .lcp-mech-navitem__teaser { font-size: 0.72rem; }
    }

    /* ---------- JOURNEY (vertical timeline) ---------- */
    .lcp-journey {
      position: relative;
      max-width: 880px;
      margin: 0 auto;
      padding-left: 56px;
    }
    .lcp-journey__rail {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 22px;
      width: 2px;
    }
    .lcp-journey__rail-track {
      position: absolute; inset: 0;
      background: var(--bbg-border);
      border-radius: 2px;
    }
    .lcp-journey__rail-fill {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: var(--journey-progress, 0%);
      background: linear-gradient(180deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      border-radius: 2px;
      transition: height 120ms linear;
      box-shadow: 0 0 8px rgba(38, 154, 218, 0.4);
    }
    .lcp-journey__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }
    .lcp-journey__item { position: relative; }
    .lcp-journey__dot {
      position: absolute;
      left: -56px;
      top: 0;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--bbg-white);
      border: 2px solid var(--bbg-border);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      transition: border-color 320ms ease;
    }
    .lcp-journey__dot-inner {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--bbg-border);
      transition: background 320ms ease, transform 320ms ease;
    }
    .lcp-journey__item.is-active .lcp-journey__dot { border-color: var(--bbg-blue); }
    .lcp-journey__item.is-active .lcp-journey__dot-inner {
      background: var(--bbg-blue);
      transform: scale(1.1);
      box-shadow: 0 0 0 4px var(--bbg-blue-light);
    }
    .lcp-journey__phase {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-2);
      transition: color 320ms ease;
    }
    .lcp-journey__item.is-active .lcp-journey__phase { color: var(--bbg-blue); }
    .lcp-journey__card {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5) var(--space-6);
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      transition: border-color 320ms ease, box-shadow 320ms ease, transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .lcp-journey__item:hover .lcp-journey__card,
    .lcp-journey__item.is-active .lcp-journey__card {
      border-color: var(--bbg-blue);
      box-shadow: 0 18px 38px -22px rgba(38, 154, 218, 0.4);
      transform: translateX(4px);
    }
    .lcp-journey__icon {
      display: inline-flex;
      width: 48px;
      height: 48px;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      flex-shrink: 0;
    }
    .lcp-journey__icon svg { width: 24px; height: 24px; }
    .lcp-journey__title {
      font-size: 1.25rem;
      line-height: 1.25;
      margin: 0 0 var(--space-2);
      letter-spacing: -0.005em;
    }
    .lcp-journey__desc {
      font-size: 0.975rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0 0 var(--space-3);
    }
    .lcp-journey__platforms {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      padding: 0.35rem 0.7rem;
      background: var(--bbg-blue-light);
      border-radius: 999px;
    }
    .lcp-journey__note {
      margin: var(--space-7) auto 0;
      max-width: 68ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.7;
      font-size: 1rem;
    }
    @media (max-width: 720px) {
      .lcp-journey { padding-left: 44px; }
      .lcp-journey__rail { left: 16px; }
      .lcp-journey__dot { left: -44px; width: 36px; height: 36px; }
    }

    /* ---------- THE RED SCROLL ---------- */
    .lcp-trs-section {
      padding-top: var(--space-7);
      padding-bottom: var(--space-7);
    }
    .lcp-trs {
      position: relative;
      padding: clamp(var(--space-5), 3vw + 1rem, var(--space-7));
      border-radius: 32px;
      color: var(--bbg-white);
      overflow: hidden;
      isolation: isolate;
      box-shadow:
        0 60px 120px -50px rgba(8, 18, 28, 0.75),
        0 24px 50px -24px rgba(216, 27, 51, 0.35);
    }
    /* Atmospheric background */
    .lcp-trs { background: #120508; }
    .lcp-trs__bg { position: absolute; inset: 0; z-index: -3; pointer-events: none; }
    .lcp-trs__bg img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center;
      filter: saturate(0.6) contrast(1.05) brightness(0.45);
      transform: scale(1.05);
      opacity: 0.55;
    }
    .lcp-trs__bg-veil {
      position: absolute; inset: 0; z-index: -2;
      background:
        radial-gradient(120% 80% at 100% 0%, rgba(255, 39, 65, 0.18) 0%, rgba(255, 39, 65, 0) 50%),
        radial-gradient(90% 70% at 0% 100%, rgba(216, 27, 51, 0.14) 0%, rgba(216, 27, 51, 0) 55%),
        linear-gradient(160deg, rgba(12, 4, 6, 0.92) 0%, rgba(22, 6, 12, 0.94) 50%, rgba(12, 4, 6, 0.96) 100%);
    }
    .lcp-trs__bg-grain {
      position: absolute; inset: 0; z-index: -1;
      background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
      background-size: 3px 3px;
      mix-blend-mode: overlay;
      opacity: 0.5;
    }

    /* Top row: badge + status pill */
    .lcp-trs__head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
    }
    .lcp-trs__badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.85);
      padding: 0.5rem 0.9rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.16);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .lcp-trs__badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #FF2741;
      box-shadow: 0 0 0 3px rgba(255, 39, 65, 0.3);
    }
    .lcp-trs__status {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.5rem 0.9rem 0.5rem 0.7rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(8px);
