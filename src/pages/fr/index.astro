                <span class="studio__frame-meta-sub">Studio · Shanghai</span>
              </figcaption>
            </figure>
            <figure class="studio__frame studio__frame--sub" aria-hidden="true">
              <img src="/Images/hub-studio/production.jpg" alt="" loading="lazy" decoding="async" />
            </figure>
            <div class="studio__brace studio__brace--tl" aria-hidden="true"></div>
            <div class="studio__brace studio__brace--br" aria-hidden="true"></div>
          </div>
        </div>

        {/* ----- Capability switcher ----- */}
        <div class="studio__switch" data-reveal>
          <div class="studio__tabs" role="tablist" aria-label="Capacités Hub Studio">
            <span class="studio__tabs-indicator" aria-hidden="true"></span>
            <button
              type="button"
              class="studio__tab is-active"
              role="tab"
              data-tab="creative"
              aria-selected="true"
              aria-controls="studio-panel-creative"
              id="studio-tab-creative"
            >
              <span class="studio__tab-mark" aria-hidden="true"></span>
              <span class="studio__tab-label">Création</span>
              <span class="studio__tab-sub">Concept · direction artistique</span>
            </button>
            <button
              type="button"
              class="studio__tab"
              role="tab"
              data-tab="production"
              aria-selected="false"
              aria-controls="studio-panel-production"
              id="studio-tab-production"
            >
              <span class="studio__tab-mark" aria-hidden="true"></span>
              <span class="studio__tab-label">Production</span>
              <span class="studio__tab-sub">Photo · film · live</span>
            </button>
            <button
              type="button"
              class="studio__tab"
              role="tab"
              data-tab="ai"
              aria-selected="false"
              aria-controls="studio-panel-ai"
              id="studio-tab-ai"
            >
              <span class="studio__tab-mark" aria-hidden="true"></span>
              <span class="studio__tab-label">Production IA</span>
              <span class="studio__tab-sub">Chaînes sur mesure</span>
            </button>
          </div>

          <div class="studio__panels">
            <article
              class="studio__panel is-active"
              data-panel="creative"
              id="studio-panel-creative"
              role="tabpanel"
              aria-labelledby="studio-tab-creative"
            >
              <div class="studio__panel-visual">
                <img src="/Images/hub-studio/creative.jpg" alt="" loading="lazy" decoding="async" />
                <div class="studio__tags">
                  <span>Concept</span>
                  <span>Direction artistique</span>
                  <span>Visuels clés</span>
                </div>
              </div>
              <div class="studio__panel-copy">
                <span class="studio__panel-kicker">
                  <span class="studio__panel-kicker-dot" aria-hidden="true"></span>
                  Création
                </span>
                <h3 class="studio__panel-title">Concept et direction artistique.</h3>
                <p class="studio__panel-body">
                  Visuels clés, idées de campagne, packaging, affichage. Pensés pour Xiaohongshu,
                  Douyin, WeChat, Tmall, là où votre acheteur passe vraiment.
                </p>
                <ul class="studio__list">
                  <li>Direction créative au service de la marque</li>
                  <li>Visuels clés pensés plateforme</li>
                  <li>Systèmes de packaging et d'affichage</li>
                </ul>
              </div>
            </article>

            <article
              class="studio__panel"
              data-panel="production"
              id="studio-panel-production"
              role="tabpanel"
              aria-labelledby="studio-tab-production"
              hidden
            >
              <div class="studio__panel-visual">
                <img
                  src="/Images/hub-studio/production.jpg"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <div class="studio__tags">
                  <span>Photo</span>
                  <span>Film</span>
                  <span>Livestream</span>
                </div>
              </div>
              <div class="studio__panel-copy">
                <span class="studio__panel-kicker">
                  <span class="studio__panel-kicker-dot" aria-hidden="true"></span>
                  Production
                </span>
                <h3 class="studio__panel-title">Photo, film, livestream.</h3>
                <p class="studio__panel-body">
                  Équipes basées à Shanghai. Tournages à Pékin, Shenzhen ou Canton quand le brief le
                  réclame. Journées studio, journées en extérieur, équipe et montage gardés en
                  interne.
                </p>
                <ul class="studio__list">
                  <li>Tournages studio et extérieur</li>
                  <li>Équipe complète, montage intégré</li>
                  <li>Plateaux livestream et exploitation live</li>
                </ul>
              </div>
            </article>

            <article
              class="studio__panel"
              data-panel="ai"
              id="studio-panel-ai"
              role="tabpanel"
              aria-labelledby="studio-tab-ai"
              hidden
            >
              <div class="studio__panel-visual">
                <img src="/Images/hub-studio/aigc.jpg" alt="" loading="lazy" decoding="async" />
                <div class="studio__tags">
                  <span>AIGC</span>
                  <span>Derniers modèles</span>
                  <span>Volume</span>
                </div>
              </div>
              <div class="studio__panel-copy">
                <span class="studio__panel-kicker">
                  <span class="studio__panel-kicker-dot" aria-hidden="true"></span>
                  Production IA
                </span>
                <h3 class="studio__panel-title">AIGC, sur les meilleurs modèles.</h3>
                <p class="studio__panel-body">
                  Du contenu généré par IA, adossé aux meilleurs modèles texte-image et vidéo du
                  marché. Produit, mode, lifestyle, social, e-commerce à fort volume. Chaque image
                  passe par l'œil d'un humain avant publication.
                </p>
                <ul class="studio__list">
                  <li>Derniers modèles texte-image et vidéo</li>
                  <li>Style et look propres à votre marque</li>
                  <li>Œil humain sur chaque image</li>
                </ul>
              </div>
            </article>
          </div>
        </div>

        {/* ----- Capability ribbon ----- */}
        <div class="studio__ribbon" aria-hidden="true">
          <div class="studio__ribbon-track">
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Photo</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Film</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Livestream</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Chaînes IA</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Packaging</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Affichage</span>
            <span class="studio__chip"
              ><span class="studio__chip-bullet"></span>Visuels de marque</span
            >
            <span class="studio__chip"
              ><span class="studio__chip-bullet"></span>Montages social-first</span
            >
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Photo</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Film</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Livestream</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Chaînes IA</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Packaging</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Affichage</span>
            <span class="studio__chip"
              ><span class="studio__chip-bullet"></span>Visuels de marque</span
            >
            <span class="studio__chip"
              ><span class="studio__chip-bullet"></span>Montages social-first</span
            >
          </div>
        </div>

        {/* ----- Footer CTA ----- */}
        <div class="studio__foot" data-reveal>
          <a class="studio__cta" href="/fr/se-developper-en-chine/studio-de-production">
            <span class="studio__cta-text">Voir les productions</span>
            <span class="studio__cta-arrow" aria-hidden="true">
              <svg
                width="22"
                height="14"
                viewBox="0 0 22 14"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M1 7H21M21 7L15 1M21 7L15 13"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
          <a
            class="studio__cta studio__cta--secondary"
            href="https://www.hubstudio.ai"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="studio__cta-text">Ou visiter hubstudio.ai</span>
            <span class="studio__cta-external" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- OUR WORK ---------- */}
  <section class="section section--alt">
    <div class="container">
      <header class="section-header section-header--split">
        <div>
          <span class="eyebrow">Nos réalisations</span>
          <h2>Des marques que nous avons bâties en Chine</h2>
        </div>
        <a href="/fr/nos-realisations" class="btn btn--secondary btn--sm"
          >Toutes les études de cas</a
        >
      </header>

      <div class="grid grid-3">
        {
          featuredCases.map((c) => (
            <a href={`/fr/nos-realisations/${c.id}`} class="work-card">
              <div class="work-card__image">
                <img
                  src={c.data.heroImage}
                  alt={c.data.heroImageAlt || `Étude de cas ${c.data.brand}`}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="400"
                />
              </div>
              <div class="work-card__body">
                <span class="work-card__tag">{c.data.category}</span>
                <h3 class="work-card__title">{c.data.brand}</h3>
                <p class="work-card__summary">{c.data.title}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- INSIGHTS ---------- */}
  <section class="section">
    <div class="container">
      <header class="insights-header">
        <span class="insights-header__rule" aria-hidden="true"></span>
        <span class="eyebrow">Décryptages</span>
        <h2>Notre lecture du marché chinois, à chaud.</h2>
      </header>

      <div class="grid grid-3">
        {
          latestInsights.map((post) => (
            <a href={`/fr/decryptages/${post.id}`} class="insight-card">
              <div class="insight-card__image">
                {post.data.heroImage && (
                  <img
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt}
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="400"
                  />
                )}
              </div>
              <div class="insight-card__body">
                <span class="insight-card__tag">
                  {insightCategoryFr[post.data.category] ?? post.data.category}
                </span>
                <h3 class="insight-card__title">{post.data.title}</h3>
                <div class="insight-card__meta">
                  <span>{readingTime(post.body)}</span>
                  {post.data.pubDate && (
                    <>
                      <span class="insight-card__meta-sep" aria-hidden="true">
                        |
                      </span>
                      <span>{formatInsightDate(post.data.pubDate)}</span>
                    </>
                  )}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- FINAL CTA CARD ---------- */}
  <section class="section section--tight">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__copy">
          <span class="eyebrow">Un café ?</span>
          <h2>Vous pensez Chine ? On en discute autour d'un café.</h2>
          <p class="cta-card__lead">
            Dites-nous où vous en êtes, où vous voulez aller. C'est un senior de l'équipe qui vous
            répond, pas un chatbot, pas un tunnel de vente.
          </p>
          <div class="cta-card__actions">
            <a href="/fr/nous-contacter" class="btn btn--primary">Démarrer la conversation</a>
          </div>
        </div>

        <div class="cta-card__visual" aria-hidden="true">
          <div class="hello-stack">
            <article class="hello-card hello-card--1">
              <header class="hello-card__head">
                <span class="hello-card__avatar">上</span>
                <div>
                  <span class="hello-card__city">Shanghai</span>
                  <span class="hello-card__role">Opérations</span>
                </div>
                <span class="hello-card__dot" title="en ligne"></span>
              </header>
              <p class="hello-card__hi">
                <span class="hello-card__zh">你好</span>
                <span class="hello-card__latin">Nǐ hǎo</span>
              </p>
            </article>

            <article class="hello-card hello-card--2">
              <header class="hello-card__head">
                <span class="hello-card__avatar">港</span>
                <div>
                  <span class="hello-card__city">Hong Kong</span>
                  <span class="hello-card__role">Cross-border</span>
                </div>
                <span class="hello-card__dot" title="en ligne"></span>
              </header>
              <p class="hello-card__hi">
                <span class="hello-card__zh">你好</span>
                <span class="hello-card__latin">Neih hóu</span>
              </p>
            </article>

            <article class="hello-card hello-card--3">
              <header class="hello-card__head">
                <span class="hello-card__avatar">P</span>
                <div>
                  <span class="hello-card__city">Paris</span>
                  <span class="hello-card__role">Entrée de marché</span>
                </div>
                <span class="hello-card__dot" title="en ligne"></span>
              </header>
              <p class="hello-card__hi"><span class="hello-card__zh">Bonjour</span></p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <HomeAssets />
</Layout>
