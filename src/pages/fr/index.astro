const allCases = await getCollection('cases', ({ data }) => !data.draft);
const featuredCases = allCases
  .slice()
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const allInsights = await getCollection('insightsFr', ({ data }) => !data.draft);

const insightCategoryFr: Record<string, string> = {
  Platforms: 'Plateformes',
  'E-Commerce': 'eCommerce',
  'KOLs & Livestream': 'KOL et livestream',
  'Brand & Localization': 'Marque et localisation',
  'AI & Innovation': 'IA et innovation',
  'Market Strategy': 'Stratégie de marché',
  'Compliance & Setup': 'Conformité et installation',
};

const latestInsights = allInsights
  .slice()
  .sort((a, b) => {
    const da = a.data.pubDate?.valueOf() ?? 0;
    const db = b.data.pubDate?.valueOf() ?? 0;
    return db - da;
  })
  .slice(0, 3);

function readingTime(body: string | undefined) {
  if (!body) return '';
  const words = body.trim().split(/\s+/).length;
  return `${Math.max(1, Math.round(words / 200))} min de lecture`;
}

function formatInsightDate(d?: Date) {
  if (!d) return '';
  return d.toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' });
}
---

<Layout
  title="Agence marketing et e-commerce en Chine | TheChinaPath"
  description="Agence marketing, e-commerce et distribution pour les marques internationales en Chine. Nous pilotons Tmall, JD, Douyin, WeChat et RED au quotidien. Shanghai, Hong Kong, Paris."
  preloadImage="/Images/hero-livestream.webp"
>
  {/* ---------- SCROLL PROGRESS ---------- */}
  <div class="home-progress" aria-hidden="true"><div class="home-progress__bar"></div></div>

  {/* ---------- HERO ---------- */}
  <section class="home-hero" data-home-hero>
    <div class="home-hero__bg" aria-hidden="true" data-home-parallax>
      <picture>
        <source srcset="/Images/hero-livestream.webp" type="image/webp" />
        <img
          src="/Images/hero-livestream.jpg"
          alt=""
          width="1376"
          height="768"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>
    <div class="home-hero__overlay" aria-hidden="true"></div>
    <div class="home-hero__grain" aria-hidden="true"></div>

    <div class="container home-hero__inner">
      <span class="eyebrow eyebrow--on-dark home-reveal">Marketing et e-commerce en Chine</span>
      <h1 class="home-hero__title home-reveal" style="--reveal-delay: 80ms;">
        <span class="home-hero__title-row">Vendre en Chine.</span>
        <span class="home-hero__title-row home-hero__title-row--accent">Y croître.</span>
        <span class="home-hero__title-row home-hero__title-row--highlight"
          >Comprendre la Chine.</span
        >
      </h1>
      <p class="home-hero__lead home-reveal" style="--reveal-delay: 200ms;">
        On met votre marque sur le marché chinois. Boutiques Tmall et JD, social commerce Douyin et
        RED, et le bon distributeur pour votre catégorie.
      </p>
      <div class="home-hero__actions home-reveal" style="--reveal-delay: 280ms;">
        <a class="btn btn--primary home-magnetic" href="/fr/nous-contacter">Parlons-en</a>
        <a class="btn btn--primary home-magnetic" href="/fr/outils">Budget Calculator</a>
        <a class="btn btn--ghost-light home-magnetic" href="/fr/nos-realisations"
          >Voir nos réalisations</a
        >
      </div>

      <div class="home-hero__meta home-reveal" style="--reveal-delay: 360ms;">
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num" data-home-counter="15" data-suffix="+">0</span>
          <span class="home-hero__meta-label">années sur le terrain</span>
        </div>
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num" data-home-counter="75" data-suffix="+">0</span>
          <span class="home-hero__meta-label">marques lancées</span>
        </div>
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num">Millions</span>
          <span class="home-hero__meta-label">de GMV pilotés</span>
        </div>
      </div>
    </div>

    <a href="#day-commerce" class="home-hero__scroll" aria-label="Descendre à la section suivante">
      <span class="home-hero__scroll-line"></span>
      <span class="home-hero__scroll-text">Défiler</span>
    </a>
  </section>

  {/* ---------- DAY IN CHINESE COMMERCE ---------- */}
  <section id="day-commerce" class="section day-timeline-section">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Une journée dans le commerce chinois</span>
        <h2>Votre marque, à chaque moment de la journée</h2>
        <p class="section-header__lead">
          Du matin au soir, le consommateur chinois saute d'une plateforme à l'autre. Chacune ses
          règles, ses formats, sa logique commerciale.
        </p>
      </header>

      <ol class="day-timeline" aria-label="Une journée sur les plateformes chinoises">
        {
          dayStops.map((s) => (
            <li class="day-stop">
              <figure class="day-stop__photo">
                <img src={s.photo} alt="" loading="lazy" decoding="async" />
              </figure>
              <div class="day-stop__info">
                <span class="day-stop__time">{s.time}</span>
                <span class="day-stop__moment">{s.moment}</span>
                <span class="day-stop__platform">
