---
import Layout from '../../../layouts/Layout.astro';

const outcomes = [
  "Les temps de chargement reculent de huit à quinze secondes à moins d'une seconde en Chine continentale",
  "Baidu engage l'indexation dans les semaines qui suivent la délivrance de l'ICP",
  "Les premières citations apparaissent dans les moteurs IA chinois à mesure que le crawl progresse sur les nouveaux contenus",
  "Le GMV du mini-programme WeChat fait l'objet d'un suivi dès le premier jour",
];

const aiEngines = [
  { name: 'Doubao', cn: '豆包', maker: 'ByteDance' },
  { name: 'DeepSeek', cn: '深度求索', maker: 'DeepSeek' },
  { name: 'Kimi', cn: 'Kimi', maker: 'Moonshot AI' },
  { name: 'Qwen', cn: '通义千问', maker: 'Alibaba' },
  { name: 'Baidu AI', cn: '文心一言', maker: 'Baidu' },
];

const geoBullets = [
  "Données structurées (schema.org, JSON-LD) pour que les modèles parcourent vos pages sans accroc",
  "Contenu dense et factuel : les moteurs IA citent ce qu'ils peuvent étayer, le langage marketing reste ignoré",
  "Pages rédigées en chinois et indexées par Baidu comme par Sogou",
  "Constitution de l'entité de marque sur Baidu Baike et sur les sources de référence équivalentes",
  "Suivi des moteurs qui citent la marque et de la manière dont ils la qualifient",
];

const wechatSurfaces = [
  {
    tag: "Compte officiel",
    cn: '公众号',
    title: "La rédaction de votre marque, hébergée dans WeChat",
    body: "Compte service ou abonnement qui diffuse les articles auprès des abonnés, assure le service client et abrite quelques pages essentielles. Maintient la relation entre deux achats.",
    bullet: "Articles diffusés, service client, pages essentielles",
  },
  {
    tag: "Mini-programme",
    cn: '小程序',
    title: "Une application complète au cœur de WeChat, accessible en deux gestes",
    body: "Catalogue, paiement par WeChat Pay, cartes de membre et systèmes de niveaux y trouvent leur place. C'est ici que se nouent véritablement eCommerce, fidélité et adhésion.",
    bullet: "eCommerce, fidélité et adhésion réunis",
    highlight: true,
  },
];

const techPaths = [
  {
    name: "WordPress",
    sub: "Orienté contenu, édité en local",
    when: "À retenir lorsque l'équipe locale doit conduire elle-même l'exploitation du site : campagnes, articles, lancements produit, mises à jour soutenues. Interface familière, socle technologique éprouvé. Votre responsable marketing à Shanghai publie un mardi sans solliciter de développeur.",
    bullets: [
      "Google Fonts remplacés par des CDN chinois équivalents",
      "Plugins bloqués substitués par des alternatives locales",
      "CDN local raccordé, ICP déposé, paramétrage SEO Baidu finalisé",
      "Pertinent pour les équipes qui revendiquent leur autonomie éditoriale",
    ],
    timeline: "6 à 10 semaines",
  },
  {
    name: "Astro",
    sub: "Site de marque, performances soutenues",
    when: "À privilégier lorsque le site tient lieu de vitrine de marque et de produit, sans rythme de mise à jour soutenu. Astro produit un HTML strictement statique : chargement sous la seconde y compris derrière le Firewall, coût d'hébergement quasi nul, surface d'attaque nettement réduite.",
    bullets: [
      "Chargement sous la seconde en Chine continentale",
      "Aucune base de données, aucun PHP, empreinte serveur minimale",
      "Aucun composant dynamique exploitable, aucun plugin à corriger",
      "Pertinent pour les sites marketing portés par la marque, hors transaction",
    ],
    timeline: "4 à 8 semaines",
    highlight: true,
  },
];

const hostingOptions = [
  {
    where: "Chine continentale",
    note: "ICP requis",
    load: "< 1 seconde",
    seo: "Très favorable",
    verdict: "La seule option réellement défendable",
    status: 'go',
  },
  {
    where: "Hong Kong",
    note: "Sans ICP",
    load: "2 à 4 secondes",
    seo: "Marginal",
    verdict: "Lent, pénalisé par Baidu",
    status: 'warn',
  },
  {
    where: "États-Unis ou Union européenne",
    note: "Sans ICP",
    load: "8 à 15 secondes, parfois davantage",
    seo: "Inexistant",
    verdict: "Inopérant de facto",
    status: 'stop',
  },
];

const deliverables = [
  {
    icon: 'design',
    title: "Un design pensé pour le lecteur chinois",
    desc: "Pages plus denses, arborescence ramassée, QR codes systématiques, primauté du mobile : 95 % du trafic y transite. Nous bâtissons pour cette réalité, et non pour les codes occidentaux du web, soignés à Stockholm et défaillants à Shanghai.",
  },
  {
    icon: 'code',
    title: "Un code qui compose avec le Grand Firewall",
    desc: "Aucune Google Fonts, aucune CDN bloquée, aucun appel à l'API Maps en délai d'attente, aucun embed YouTube. Chaque dépendance est remplacée par son équivalent local. Sans éclat apparent, mais c'est précisément ce qui sépare un site qui s'affiche d'un site qui se fige.",
  },
  {
    icon: 'server',
    title: "Un hébergement à la stabilité éprouvée",
    desc: "Disponibilité supérieure à 99 %, prise en charge des incidents sous deux heures, sept jours sur sept. Mise à jour de la pile technique, sauvegardes nocturnes, conformité PIPL assurée dès le premier jour. La supervision opère depuis l'intérieur du Firewall, là où les anomalies se manifestent réellement.",
  },
  {
    icon: 'phone',
    title: "Des mini-programmes calibrés pour convertir",
    desc: "Conçus sur la pile Tencent (WXML, WXSS, WeChat JS). Paiements natifs, intégration CRM, systèmes de niveaux, notifications poussées. Une décennie de mini-programmes pour des marques qui font de WeChat un canal de vente, jamais une simple plaquette.",
  },
  {
    icon: 'pen',
    title: "Un copywriting dans la langue requise",
    desc: "Contenu chinois rédigé directement par notre équipe interne, jamais traduit depuis l'anglais. Versions française et anglaise produites lorsque la communication corporate, les supports investisseurs ou la cohérence du groupe l'exigent.",
  },
];

const faqs = [
  {
    q: "Qu'entend-on par GEO, et pourquoi cette discipline pèse-t-elle ?",
    a: "Le GEO, pour Generative Engine Optimization, désigne le référencement appliqué à la recherche par intelligence artificielle. Les internautes chinois interrogent de plus en plus les assistants IA (Doubao, Kimi, DeepSeek, Qwen) à la place d'une requête classique. Ces modèles ont besoin de sites crédibles, indexés, qu'ils puissent citer. Sans hébergement en Chine, pas de visibilité dans cette nouvelle couche de recherche.",
  },
  {
    q: "WordPress ou Astro, quel choix retenir ?",
    a: "WordPress si l'équipe met à jour le site fréquemment et tient à son autonomie éditoriale. Astro si le site demeure relativement figé entre deux lancements et que les priorités portent sur la rapidité, la sécurité et la maîtrise du coût d'hébergement.",
  },
  {
    q: "Quel est le budget d'un site conçu pour la Chine ?",
    a: "Les enveloppes dépendent du périmètre, de l'échelle et du nombre d'intégrations. Les sites de marque sur Astro se positionnent en bas de la fourchette. Les projets WordPress dotés de fonctionnalités eCommerce ou d'une intégration WeChat se situent plus haut. Chaque projet fait l'objet d'un cadrage spécifique.",
  },
  {
    q: "Quelle est la durée totale du projet ?",
    a: "Quatre à dix semaines pour la conception et le développement, auxquelles s'ajoute le dépôt ICP. Bei'an : deux à quatre semaines. Licence commerciale : deux à trois mois, parfois davantage. Nous menons design et développement en parallèle des démarches ICP, afin de prévenir toute mise en attente.",
  },
  {
    q: "À qui reviennent le code et l'ICP ?",
    a: "À la marque, sans réserve. Le code lui appartient. L'ICP est enregistré au nom de son entité chinoise, ou de l'entité partenaire mise en place de concert. Aucun verrouillage opérationnel n'est appliqué.",
  },
  {
    q: "Pouvez-vous migrer un site existant ?",
    a: "Oui. Nous procédons à l'audit du site en place, signalons les composants défaillants en Chine, puis migrons proprement ou reconstruisons les pans inopérants. Dans la majorité des cas, cette approche se révèle plus rapide et moins coûteuse qu'une refonte intégrale.",
  },
  {
    q: "L'hébergement en Chine s'impose-t-il réellement ?",
    a: "Pour la vitesse d'affichage, le référencement sur Baidu, la citation par les moteurs IA et la fiabilité, oui. Hong Kong fait figure de passerelle imparfaite. Servir un site depuis l'Europe ou les États-Unis revient à offrir une expérience défaillante aux utilisateurs chinois.",
  },
  {
    q: "Qu'est-ce qu'une licence ICP ?",
    a: "Un dépôt obligatoire auprès du ministère chinois de l'Industrie et des Technologies de l'information. Deux régimes coexistent. Le Bei'an couvre les sites informationnels. La licence commerciale couvre l'eCommerce et les plateformes transactionnelles. Le dispositif est requis pour tout hébergement en Chine continentale.",
  },
  {
    q: "Un mini-programme WeChat peut-il remplacer un site ?",
    a: "Sur le terrain de l'eCommerce et de la fidélité, la réponse est souvent affirmative. Pour la découverte, le référencement naturel et la crédibilité de marque, le site demeure indispensable. La majorité des clients opèrent les deux dispositifs en parallèle.",
  },
  {
    q: "Comment la PIPL conditionne-t-elle le site ?",
    a: "La PIPL constitue l'équivalent chinois du RGPD. Le site doit indiquer clairement la collecte des données, recueillir un consentement explicite et conserver les données personnelles dans des conditions de sécurité adéquates. La conformité PIPL est intégrée dès le cadrage du projet.",
  },
  {
    q: "En quoi consiste l'audit gratuit ?",
    a: "Le site existant est testé depuis l'intérieur de la Chine : temps de chargement, ressources bloquées, visibilité sur Baidu, citations dans les moteurs IA. Une synthèse écrite est transmise à l'issue de la lecture. Aucun engagement n'est attendu en retour.",
  },
];

const icons: Record<string, string> = {
  design: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="14" rx="2"/><path d="M3 9h18"/><circle cx="6.5" cy="6" r="0.6" fill="currentColor"/><path d="M8 21h8M12 17v4"/></svg>`,
  code: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="8 6 2 12 8 18"/><polyline points="16 6 22 12 16 18"/><path d="m14 4-4 16"/></svg>`,
  server: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><circle cx="7" cy="7" r="0.6" fill="currentColor"/><circle cx="7" cy="17" r="0.6" fill="currentColor"/></svg>`,
  phone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/></svg>`,
  pen: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4l6 6L8 22H2v-6L14 4z"/><path d="m13 5 6 6"/></svg>`,
  check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8"/></svg>`,
};
---

<Layout
  title="Agence de sites web Chine : conception, hébergement, ranking | Beyond Border Group"
  description="Nous concevons et hébergeons des sites et mini-programmes WeChat qui chargent, se classent sur Baidu et se font citer par les moteurs IA chinois. Plus de vingt ans en Chine."
>
  <article class="web">

    {/* ---------- HERO ---------- */}
    <section class="web-hero">
      <div class="web-hero__bg" aria-hidden="true">
        <img src="/Images/insights/how-to-host-your-website-in-china-for-maximum-marketing-impact.jpg" alt="" />
      </div>
      <div class="web-hero__overlay" aria-hidden="true"></div>

      <div class="container web-hero__inner">
        <nav class="web-hero__crumbs" aria-label="Fil d'Ariane">
          <a href="/fr/">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/fr/#services">Se développer en Chine</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark">Sites web en Chine</span>
        <h1 class="web-hero__title">Des sites qui s'affichent, se classent et vendent vraiment en Chine.</h1>
        <p class="web-hero__lead">
          On conçoit, on développe et on héberge des sites et des mini-programmes WeChat pour le
          marché chinois. Chargement sous la seconde, conformité ICP, indexation Baidu, présence dans les
          moteurs IA que les consommateurs chinois utilisent désormais pour repérer les marques.
        </p>
        <p class="web-hero__support">
          Plus de vingt ans en Chine. Bureaux à Shanghai, Hong Kong et Paris. Une équipe qui a livré
          pour des grands groupes internationaux comme pour des challengers locaux.
        </p>
        <div class="web-hero__actions">
          <a href="/fr/nous-contacter" class="btn btn--primary">Audit gratuit de votre site en Chine</a>
          <a href="/fr/nos-realisations" class="btn btn--ghost-light">Consulter nos réalisations</a>
        </div>
      </div>
    </section>

    {/* ---------- INTRO + 90-DAY OUTCOMES ---------- */}
    <section class="section">
      <div class="container">
        <div class="web-intro">
          <div class="web-intro__copy">
            <span class="eyebrow">Conçu pour l'internet chinois, jamais transposé</span>
            <h2>La plupart des sites internationaux se fragilisent à leur arrivée en Chine.</h2>
            <p>
              Le chargement s'allonge, jusqu'à l'échec complet d'affichage. Les services Google demeurent
              bloqués. Baidu refuse l'indexation. Les moteurs IA poursuivent leur route sans s'arrêter.
            </p>
            <p>
              Nous concevons des sites et des mini-programmes WeChat qui prennent leur place au sein du web
              chinois. Le socle technologique épouse les contraintes du marché, l'hébergement se trouve à
              l'endroit qui convient, le référencement est calibré pour Baidu, et le contenu est repris par
              les moteurs IA sur lesquels les consommateurs chinois s'appuient désormais. Pour être trouvé,
              et pour vendre.
            </p>
          </div>

          <aside class="web-outcomes" aria-label="Résultats observés sur les quatre-vingt-dix premiers jours">
            <span class="web-outcomes__tag">Quatre-vingt-dix premiers jours</span>
            <h3>Ce qui évolue lorsque la mise en œuvre est rigoureuse</h3>
            <ul>
              {outcomes.map((o) => (
                <li>
                  <span class="web-outcomes__check" aria-hidden="true" set:html={icons.check} />
                  <span>{o}</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {/* ---------- GEO: AI ENGINES ---------- */}
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Un site en Chine, condition désormais non négociable en 2026</span>
          <h2>GEO : obtenir la citation par les IA, sans se limiter au classement Baidu</h2>
          <p class="section-header__lead">
            Le GEO, Generative Engine Optimization, désigne le référencement à l'ère de l'IA. Le consommateur
            chinois contourne la barre de recherche et interroge directement les modèles.
          </p>
        </header>

        <div class="web-geo">
          <div class="web-geo__copy">
            <p>
              Doubao, Kimi, DeepSeek, Qwen et une liste qui ne cesse de s'allonger répondent en puisant dans
              les sites qu'ils ont indexés et jugés crédibles. Sans site hébergé en Chine, ces moteurs n'ont
              aucune source à citer sur votre marque. La conséquence est mécanique : votre marque sort de la
              conversation.
            </p>
            <h3 class="web-geo__h3">Notre intervention concrète sur le terrain GEO</h3>
            <ul class="web-geo__list">
              {geoBullets.map((b) => (
                <li>
                  <span class="web-geo__bullet" aria-hidden="true" set:html={icons.check} />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="web-engines" aria-label="Moteurs IA chinois">
            <span class="web-engines__tag">Les moteurs qui décident désormais de la visibilité</span>
            <div class="web-engines__grid">
              {aiEngines.map((e) => (
                <div class="web-engine">
                  <span class="web-engine__cn" lang="zh-Hans">{e.cn}</span>
                  <span class="web-engine__name">{e.name}</span>
                  <span class="web-engine__maker">{e.maker}</span>
                </div>
              ))}
            </div>
            <p class="web-engines__note">
              Un site hébergé en Chine et rédigé en chinois constitue l'actif fondateur qui alimente Baidu et
              l'ensemble des moteurs IA qui façonnent désormais la manière dont les consommateurs chinois
              découvrent les produits.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- WECHAT SURFACES ---------- */}
    <section class="section">
      <div class="container">
        <header class="section-header section-header--split">
          <div>
            <span class="eyebrow">WeChat, l'autre versant du dispositif</span>
            <h2>Deux surfaces à tenir : le compte officiel et le mini-programme.</h2>
          </div>
          <div class="web-wechat-stat">
            <span class="web-wechat-stat__value">1,414 Md</span>
            <span class="web-wechat-stat__label">
              Utilisateurs actifs mensuels combinés de Weixin et WeChat au 30 septembre 2025
            </span>
            <span class="web-wechat-stat__source">Source : résultats Tencent T3 2025</span>
          </div>
        </header>

        <div class="web-surfaces">
          {wechatSurfaces.map((s) => (
            <article class={`web-surface${s.highlight ? ' web-surface--highlight' : ''}`}>
              {s.highlight && <span class="web-surface__badge">Le point de bascule de la conversion</span>}
              <div class="web-surface__head">
                <span class="web-surface__cn" lang="zh-Hans">{s.cn}</span>
                <span class="web-surface__tag">{s.tag}</span>
              </div>
              <h3 class="web-surface__title">{s.title}</h3>
              <p class="web-surface__body">{s.body}</p>
              <span class="web-surface__bullet">{s.bullet}</span>
            </article>
          ))}
        </div>

        <p class="web-surfaces__note">
          La majorité des marques que nous accompagnons mobilisent les deux surfaces. Le compte officiel
          entretient la relation. Le mini-programme constitue le terrain où s'opère la conversion. Ensemble,
          ils couvrent l'intégralité du parcours, de la découverte à l'achat.
        </p>
      </div>
    </section>

    {/* ---------- TWO TECH PATHS ---------- */}
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Deux voies techniques</span>
          <h2>WordPress ou Astro : l'arbitrage s'opère selon le fonctionnement de votre équipe.</h2>
          <p class="section-header__lead">
            Aucune querelle d'école. Le bon choix dépend de la fréquence de publication, de l'identité des
            personnes qui poussent les mises à jour, et de la nécessité de gérer des transactions.
          </p>
        </header>

        <div class="web-tech">
          {techPaths.map((t) => (
            <article class={`web-tech-card${t.highlight ? ' web-tech-card--highlight' : ''}`}>
              <div class="web-tech-card__head">
                <h3 class="web-tech-card__name">{t.name}</h3>
                <span class="web-tech-card__sub">{t.sub}</span>
              </div>
              <p class="web-tech-card__when">{t.when}</p>
              <ul class="web-tech-card__list">
                {t.bullets.map((b) => (
                  <li>
                    <span class="web-tech-card__check" aria-hidden="true" set:html={icons.check} />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              <div class="web-tech-card__footer">
                <span class="web-tech-card__timeline-label">Calendrier</span>
                <span class="web-tech-card__timeline-value">{t.timeline}, plus le dépôt ICP</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- HOSTING ---------- */}
    <section class="section">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Hébergement en Chine</span>
          <h2>L'hébergement constitue la décision la plus structurante du projet.</h2>
          <p class="section-header__lead">
            Et la réponse est, à dire vrai, unique : héberger à l'intérieur de la Chine. Toute autre option
            relève d'un compromis qui se paie. Chargement ralenti, classement Baidu affaibli, expérience
            utilisateur dégradée.
          </p>
        </header>

        <div class="web-hosting">
          {hostingOptions.map((h) => (
            <article class={`web-host web-host--${h.status}`}>
              <header class="web-host__head">
                <h3>{h.where}</h3>
                <span class="web-host__note">{h.note}</span>
              </header>
              <dl class="web-host__metrics">
                <div>
                  <dt>Temps de chargement en Chine</dt>
                  <dd>{h.load}</dd>
                </div>
                <div>
                  <dt>Impact SEO Baidu</dt>
                  <dd>{h.seo}</dd>
                </div>
              </dl>
              <p class={`web-host__verdict web-host__verdict--${h.status}`}>{h.verdict}</p>
            </article>
          ))}
        </div>

        <div class="web-icp">
          <div class="web-icp__copy">
            <span class="eyebrow">Dépôt ICP : le chapitre dont aucune agence ne parle vraiment</span>
            <h3>Bei'an : deux à quatre semaines. Licence commerciale : deux à trois mois.</h3>
            <p>
              Héberger en Chine continentale suppose la détention d'une licence ICP et la mise en place d'un
              serveur chez Alibaba Cloud, Tencent Cloud ou Huawei Cloud. Nous prenons en charge la totalité
              du dépôt ICP. Bei'an pour les sites informationnels, licence commerciale pour l'eCommerce et
              les plateformes transactionnelles.
            </p>
            <p>
              Nous assurons également la configuration du serveur, le CDN, la supervision depuis l'intérieur
              de la Chine (la plupart des outils contrôlent l'état du site depuis l'extérieur du Firewall et
              passent à côté des incidents réels) ainsi que les sauvegardes quotidiennes. En l'absence
              d'entité chinoise, plusieurs voies de contournement existent. Nous les exposerons en détail.
            </p>
          </div>
          <div class="web-icp__visual">
            <img src="/Images/insights/how-to-apply-for-an-icp-license-for-your-website.png" alt="Processus de licence ICP pour les sites web en Chine" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    {/* ---------- CHINAWEBFOUNDRY ---------- */}
    <section class="section section--alt">
      <div class="container">
        <article class="web-cwf">
          <div class="web-cwf__copy">
            <span class="eyebrow">Agence sœur</span>
            <h2 class="web-cwf__title">ChinaWebFoundry : une agence dédiée aux sites destinés au marché chinois.</h2>
            <p>
