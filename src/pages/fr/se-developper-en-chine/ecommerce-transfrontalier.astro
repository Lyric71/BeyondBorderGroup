    .cbs-compare__table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      min-width: 640px;
    }
    .cbs-compare__head {
      background: var(--bbg-surface);
      padding: var(--space-4);
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-compare__head--tp {
      border-bottom-color: var(--bbg-blue);
    }
    .cbs-compare__head--dist {
      border-bottom-color: var(--bbg-blue-dark);
    }
    .cbs-compare__head-label {
      display: block;
      font-size: 1rem;
      font-weight: 700;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-compare__head-sub {
      display: block;
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      margin-top: 0.25rem;
    }
    .cbs-compare__row-head-col {
      width: 38%;
      background: var(--bbg-surface);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-compare__row-label {
      text-align: left;
      padding: var(--space-4);
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--bbg-text-muted);
      letter-spacing: 0.01em;
      border-bottom: 1px solid var(--bbg-border);
      background: var(--bbg-white);
    }
    .cbs-compare__cell {
      padding: var(--space-4);
      font-size: 0.95rem;
      color: var(--bbg-ink);
      border-bottom: 1px solid var(--bbg-border);
      vertical-align: top;
    }
    .cbs-compare__cell--tp {
      background: rgba(200, 16, 46, 0.04);
    }
    .cbs-compare__cell--dist {
      background: var(--bbg-white);
    }
    .cbs-compare__table tbody tr:last-child .cbs-compare__row-label,
    .cbs-compare__table tbody tr:last-child .cbs-compare__cell {
      border-bottom: none;
    }
    .cbs-compare__note {
      margin: var(--space-5) auto 0;
      max-width: 70ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 0.975rem;
    }

    /* ---------- COST SECTION (ledger redesign) ---------- */
    .cbs-cost-section {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    .cbs-cost-section__bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      overflow: hidden;
    }
    .cbs-cost-section__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(200, 16, 46, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(200, 16, 46, 0.07) 1px, transparent 1px);
      background-size: 48px 48px;
      background-position: center;
      mask-image: radial-gradient(ellipse 70% 60% at center, #000 25%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at center, #000 25%, transparent 75%);
    }
    .cbs-cost-section__glow {
      position: absolute;
      width: 520px;
      height: 520px;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.55;
    }
    .cbs-cost-section__glow--a {
      top: -120px;
      left: -100px;
      background: radial-gradient(circle, rgba(200, 16, 46, 0.22) 0%, transparent 70%);
    }
    .cbs-cost-section__glow--b {
      bottom: -150px;
      right: -120px;
      background: radial-gradient(circle, rgba(91, 194, 240, 0.18) 0%, transparent 70%);
    }

    .cbs-cost {
      position: relative;
    }

    /* Model switcher */
    .cbs-cost__switcher {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      max-width: 720px;
      margin: 0 auto var(--space-6);
      padding: 6px;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(200, 16, 46, 0.16);
      border-radius: 999px;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 18px 40px -28px rgba(200, 16, 46, 0.35);
    }
    .cbs-cost__switcher-pill {
      position: absolute;
      top: 6px;
      left: 6px;
      width: calc(50% - 6px);
      height: calc(100% - 12px);
      border-radius: 999px;
      background: linear-gradient(135deg, var(--bbg-blue) 0%, #a50c26 100%);
      box-shadow:
        0 6px 18px -8px rgba(200, 16, 46, 0.6),
        0 1px 0 rgba(255, 255, 255, 0.3) inset;
      transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 0;
    }
    .cbs-cost__switcher[data-active='distributor'] .cbs-cost__switcher-pill {
      transform: translateX(100%);
    }
    .cbs-cost__switcher-tab {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 2px;
      align-items: center;
      justify-content: center;
      padding: 14px 18px;
      background: none;
      border: 0;
      cursor: pointer;
      color: var(--bbg-text);
      transition: color 280ms ease;
      font-family: inherit;
    }
    .cbs-cost__switcher-tab.is-active {
      color: #fff;
    }
    .cbs-cost__switcher-dot {
      display: none;
    }
    .cbs-cost__switcher-label {
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: -0.005em;
    }
    .cbs-cost__switcher-sub {
      font-size: 0.78rem;
      opacity: 0.78;
      font-weight: 500;
    }
    .cbs-cost__switcher-tab:focus-visible {
      outline: 2px solid var(--bbg-blue);
      outline-offset: 4px;
      border-radius: 999px;
    }

    /* Grid */
    .cbs-cost__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
      perspective: 1400px;
    }
    .cbs-cost__data {
      display: none;
    }

    /* Ledger card */
    .cbs-ledger {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      padding: 28px 28px 24px;
      background: linear-gradient(180deg, #ffffff 0%, #fafdff 100%);
      border: 1px solid rgba(200, 16, 46, 0.18);
      border-radius: 22px;
      overflow: hidden;
      isolation: isolate;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 24px 48px -34px rgba(15, 50, 85, 0.18),
        0 6px 16px -10px rgba(200, 16, 46, 0.1);
      transform-style: preserve-3d;
      transform: perspective(1200px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
        translateY(var(--lift, 0px));
      transition:
        transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 320ms ease;
    }
    .cbs-ledger::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 50%, var(--bbg-blue) 100%);
      background-size: 200% 100%;
      animation: cbs-stripe 6s linear infinite;
      transform-origin: left;
      transform: scaleX(0.45);
      transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-stripe {
      from {
        background-position: 0% 0;
      }
      to {
        background-position: 200% 0;
      }
    }
    .cbs-ledger:hover {
      --lift: -6px;
      border-color: rgba(200, 16, 46, 0.45);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 40px 64px -36px rgba(15, 50, 85, 0.28),
        0 10px 24px -12px rgba(200, 16, 46, 0.28);
    }
    .cbs-ledger:hover::before {
      transform: scaleX(1);
    }
    .cbs-ledger__sheen {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(
        240px circle at var(--mx, 50%) var(--my, 0%),
        rgba(200, 16, 46, 0.12) 0%,
        transparent 60%
      );
      opacity: 0;
      transition: opacity 320ms ease;
      z-index: 0;
    }
    .cbs-ledger[data-tilt-active] .cbs-ledger__sheen {
      opacity: 1;
    }
    .cbs-ledger__corner {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--bbg-blue);
      box-shadow:
        0 0 0 4px rgba(200, 16, 46, 0.14),
        0 0 14px rgba(200, 16, 46, 0.4);
    }
    .cbs-ledger > * {
      position: relative;
      z-index: 1;
    }

    .cbs-ledger__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 0.25rem;
    }
    .cbs-ledger__icon {
      display: inline-flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: linear-gradient(
        135deg,
        rgba(232, 244, 252, 0.95) 0%,
        rgba(200, 16, 46, 0.18) 100%
      );
      color: var(--bbg-blue);
      box-shadow: 0 4px 12px -6px rgba(200, 16, 46, 0.45);
    }
    .cbs-ledger__icon svg {
      width: 20px;
      height: 20px;
    }
    .cbs-ledger__tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 11px;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: rgba(232, 244, 252, 0.85);
      border: 1px solid rgba(200, 16, 46, 0.22);
      border-radius: 999px;
    }
    .cbs-ledger__tag--universal {
      color: #1f6f4a;
      background: rgba(220, 245, 232, 0.9);
      border-color: rgba(38, 165, 110, 0.25);
    }
    .cbs-ledger__tag-dot {
      display: inline-block;
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.65;
    }
    .cbs-ledger__title {
      font-size: 1.05rem;
      line-height: 1.25;
      letter-spacing: -0.01em;
      color: var(--bbg-text-muted);
      font-weight: 600;
      margin: 0;
    }
    .cbs-ledger__headline {
      display: flex;
      align-items: baseline;
      gap: 2px;
      font-size: clamp(2.4rem, 4.6vw, 3.2rem);
      line-height: 1;
      font-weight: 700;
      letter-spacing: -0.025em;
      color: var(--bbg-ink);
      font-variant-numeric: tabular-nums;
      margin: 2px 0 0;
    }
    .cbs-ledger__headline--text {
      letter-spacing: -0.015em;
    }
    .cbs-ledger__lead {
      display: inline-flex;
      align-items: center;
      font-size: 0.32em;
      font-weight: 700;
      color: var(--bbg-text-muted);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-right: 8px;
      padding: 4px 8px;
      background: rgba(200, 16, 46, 0.1);
      border-radius: 6px;
      align-self: center;
      transform: translateY(-4px);
    }
    .cbs-ledger__lead:empty {
      display: none;
    }
    .cbs-ledger__prefix,
    .cbs-ledger__suffix {
      font-size: 0.65em;
      font-weight: 700;
      color: var(--bbg-blue);
      letter-spacing: -0.01em;
    }
    .cbs-ledger__num {
      display: inline-block;
      transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-ledger__num.is-flashing {
      animation: cbs-num-flash 480ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-num-flash {
      0% {
        transform: translateY(8px);
        opacity: 0;
      }
      100% {
        transform: translateY(0);
        opacity: 1;
      }
    }
    .cbs-ledger__unit {
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--bbg-text-muted);
      margin: 4px 0 0;
    }
    .cbs-ledger__pill {
      display: inline-flex;
      align-self: flex-start;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--bbg-ink);
      background: linear-gradient(180deg, #fff 0%, #f1f7fc 100%);
      border: 1px solid rgba(200, 16, 46, 0.22);
      border-radius: 8px;
      margin-top: 6px;
      box-shadow: 0 2px 6px -4px rgba(200, 16, 46, 0.35);
    }
    .cbs-ledger__pill::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--bbg-blue);
      box-shadow: 0 0 8px rgba(200, 16, 46, 0.6);
    }
    .cbs-ledger__body {
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 6px 0 0;
    }

    /* Platform card buckets */
    .cbs-ledger__buckets {
      list-style: none;
      margin: 8px 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding-top: 14px;
      border-top: 1px dashed rgba(200, 16, 46, 0.22);
    }
    .cbs-bucket {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .cbs-bucket__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .cbs-bucket__title {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--bbg-ink);
    }
    .cbs-bucket__chip {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--bbg-blue);
      padding: 2px 8px;
      background: rgba(232, 244, 252, 0.7);
      border-radius: 6px;
    }
    .cbs-bucket__sub {
      font-size: 0.82rem;
      line-height: 1.5;
      color: var(--bbg-text-muted);
      margin: 0;
    }
    .cbs-bucket__meter {
      display: block;
      position: relative;
      height: 4px;
      background: rgba(200, 16, 46, 0.12);
      border-radius: 4px;
      overflow: hidden;
      margin-top: 4px;
    }
    .cbs-bucket__meter-fill {
      display: block;
      position: absolute;
      inset: 0;
      width: 0;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 100%);
      border-radius: 4px;
      transition: width 1100ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-ledger.is-in .cbs-bucket__meter-fill {
      width: var(--meter, 50%);
    }

    .cbs-ledger__foot {
      display: grid;
      grid-template-columns: 22px 1fr;
      gap: 10px;
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px dashed rgba(15, 50, 85, 0.08);
    }
    .cbs-ledger__foot-mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      color: var(--bbg-blue);
      opacity: 0.85;
    }
    .cbs-ledger__foot svg {
      width: 14px;
      height: 14px;
    }
    .cbs-ledger__foot p {
      margin: 0;
      font-size: 0.82rem;
      line-height: 1.55;
      color: var(--bbg-text-muted);
    }

    /* Variant accents */
    .cbs-ledger--platform {
      background: linear-gradient(180deg, #fbfffd 0%, #f3fbf7 100%);
      border-color: rgba(38, 165, 110, 0.22);
    }
    .cbs-ledger--platform::before {
      background: linear-gradient(90deg, #2ea56c 0%, #6fd7a6 50%, #2ea56c 100%);
      background-size: 200% 100%;
    }
    .cbs-ledger--platform .cbs-ledger__corner {
      background: #2ea56c;
      box-shadow:
        0 0 0 4px rgba(46, 165, 108, 0.14),
        0 0 14px rgba(46, 165, 108, 0.4);
    }
    .cbs-ledger--platform .cbs-ledger__icon {
      background: linear-gradient(
        135deg,
        rgba(220, 245, 232, 0.95) 0%,
        rgba(46, 165, 108, 0.2) 100%
      );
      color: #1f6f4a;
      box-shadow: 0 4px 12px -6px rgba(46, 165, 108, 0.45);
    }
    .cbs-ledger--platform .cbs-ledger__prefix,
    .cbs-ledger--platform .cbs-ledger__suffix {
      color: #1f6f4a;
    }
    .cbs-ledger--platform .cbs-bucket__chip {
      color: #1f6f4a;
      background: rgba(220, 245, 232, 0.75);
    }
    .cbs-ledger--platform .cbs-bucket__meter-fill {
      background: linear-gradient(90deg, #2ea56c 0%, #6fd7a6 100%);
    }
    .cbs-ledger--platform .cbs-ledger__pill {
      border-color: rgba(46, 165, 108, 0.28);
    }
    .cbs-ledger--platform .cbs-ledger__pill::before {
      background: #2ea56c;
      box-shadow: 0 0 8px rgba(46, 165, 108, 0.5);
    }
    .cbs-ledger--platform:hover {
      border-color: rgba(46, 165, 108, 0.5);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 40px 64px -36px rgba(20, 60, 40, 0.28),
        0 10px 24px -12px rgba(46, 165, 108, 0.25);
    }
    .cbs-ledger--platform .cbs-ledger__sheen {
      background: radial-gradient(
        240px circle at var(--mx, 50%) var(--my, 0%),
        rgba(46, 165, 108, 0.14) 0%,
        transparent 60%
      );
    }
    .cbs-ledger--platform .cbs-ledger__foot-mark {
      color: #1f6f4a;
    }

    .cbs-ledger--brand {
      background: linear-gradient(180deg, #fefbff 0%, #faf4ff 100%);
      border-color: rgba(200, 16, 46, 0.22);
    }
    .cbs-ledger--brand::before {
      background: linear-gradient(90deg, #c8102e 0%, #e84a60 50%, #c8102e 100%);
      background-size: 200% 100%;
    }
    .cbs-ledger--brand .cbs-ledger__corner {
      background: #c8102e;
      box-shadow:
        0 0 0 4px rgba(200, 16, 46, 0.14),
        0 0 14px rgba(200, 16, 46, 0.4);
    }
    .cbs-ledger--brand .cbs-ledger__icon {
      background: linear-gradient(
        135deg,
        rgba(251, 233, 236, 0.95) 0%,
        rgba(200, 16, 46, 0.2) 100%
      );
      color: #c8102e;
      box-shadow: 0 4px 12px -6px rgba(200, 16, 46, 0.45);
    }
    .cbs-ledger--brand .cbs-ledger__tag {
      color: #c8102e;
      background: rgba(251, 233, 236, 0.85);
      border-color: rgba(200, 16, 46, 0.25);
    }
    .cbs-ledger--brand .cbs-ledger__prefix,
    .cbs-ledger--brand .cbs-ledger__suffix {
      color: #c8102e;
    }
    .cbs-ledger--brand .cbs-ledger__pill {
      border-color: rgba(200, 16, 46, 0.28);
    }
    .cbs-ledger--brand .cbs-ledger__pill::before {
      background: #c8102e;
      box-shadow: 0 0 8px rgba(200, 16, 46, 0.5);
    }
    .cbs-ledger--brand:hover {
      border-color: rgba(200, 16, 46, 0.5);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 40px 64px -36px rgba(120, 10, 28, 0.28),
        0 10px 24px -12px rgba(200, 16, 46, 0.28);
    }
    .cbs-ledger--brand .cbs-ledger__sheen {
      background: radial-gradient(
        240px circle at var(--mx, 50%) var(--my, 0%),
        rgba(200, 16, 46, 0.13) 0%,
        transparent 60%
      );
    }
    .cbs-ledger--brand .cbs-ledger__foot-mark {
      color: #c8102e;
    }

    /* Pledge block */
    .cbs-pledge {
      position: relative;
      margin: calc(var(--space-6) + 12px) auto 0;
      max-width: 880px;
      padding: 32px 36px 28px;
      border-radius: 24px;
      background:
        radial-gradient(circle at 0% 0%, rgba(200, 16, 46, 0.22) 0%, transparent 55%),
        radial-gradient(circle at 100% 100%, rgba(91, 194, 240, 0.18) 0%, transparent 55%),
        linear-gradient(135deg, #0d2a3e 0%, #143955 60%, #1c4f74 100%);
      color: #fff;
      overflow: hidden;
      isolation: isolate;
      box-shadow:
        0 30px 70px -40px rgba(13, 42, 62, 0.7),
        0 1px 0 rgba(255, 255, 255, 0.06) inset;
    }
    .cbs-pledge::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
      background-size: 24px 24px;
      mask-image: radial-gradient(ellipse 80% 70% at 80% 30%, #000 30%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse 80% 70% at 80% 30%, #000 30%, transparent 80%);
      pointer-events: none;
      z-index: 0;
    }
    .cbs-pledge > * {
      position: relative;
      z-index: 1;
    }
    .cbs-pledge__mark {
      width: 38px;
      height: 28px;
      color: rgba(255, 255, 255, 0.32);
      margin-bottom: 10px;
    }
    .cbs-pledge__mark svg {
      width: 100%;
      height: 100%;
    }
    .cbs-pledge__line {
      margin: 0;
      font-size: clamp(1.15rem, 1.6vw, 1.5rem);
      line-height: 1.35;
      letter-spacing: -0.015em;
      font-weight: 600;
      color: #fff;
      max-width: 56ch;
    }
    .cbs-pledge__never {
      list-style: none;
      margin: 22px 0 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .cbs-pledge__never li {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      font-size: 0.85rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.95);
      background: rgba(255, 255, 255, 0.07);
