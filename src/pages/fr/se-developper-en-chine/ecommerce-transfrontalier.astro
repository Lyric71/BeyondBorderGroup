      z-index: -1;
    }
    @keyframes cbs-underline { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    .cbs-hero__lead {
      font-size: clamp(1rem, 0.5vw + 1rem, 1.1875rem);
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.86);
      max-width: 58ch;
      margin: 0 0 var(--space-5);
    }
    .cbs-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-6); }
    .cbs-magnetic:hover { transform: translateY(-2px); }

    .cbs-hero__meta {
      display: flex; flex-wrap: nowrap;
      gap: clamp(var(--space-3), 3vw, var(--space-6));
      padding-top: var(--space-5);
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      max-width: none;
    }
    .cbs-hero__meta-item {
      display: flex; flex-direction: column;
      gap: 0.2rem;
      min-width: 0;
      flex: 1 1 0;
    }
    @media (max-width: 720px) {
      .cbs-hero__meta { flex-wrap: wrap; }
      .cbs-hero__meta-item { flex: 1 1 auto; }
    }
    .cbs-hero__meta-num {
      font-size: clamp(1.625rem, 1.2vw + 1rem, 2.125rem);
      font-weight: 700; letter-spacing: -0.02em;
      line-height: 1; color: var(--bbg-white);
      font-feature-settings: "tnum";
    }
    .cbs-hero__meta-label {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.66);
      letter-spacing: 0.02em;
    }

    .cbs-hero__scroll {
      position: absolute;
      bottom: var(--space-5);
      right: clamp(var(--space-5), 4vw, var(--space-7));
      display: flex; flex-direction: column;
      align-items: center; gap: 0.5rem;
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.7rem; letter-spacing: 0.18em;
      text-transform: uppercase; font-weight: 600;
      transition: color 200ms ease;
    }
    .cbs-hero__scroll:hover { color: var(--bbg-white); }
    .cbs-hero__scroll-line {
      width: 1px; height: 40px;
      background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.6) 100%);
      position: relative; overflow: hidden;
    }
    .cbs-hero__scroll-line::after {
      content: ""; position: absolute;
      top: -100%; left: 0; right: 0;
      height: 50%;
      background: linear-gradient(180deg, transparent 0%, var(--bbg-white) 100%);
      animation: cbs-scroll-tick 1.8s ease-in-out infinite;
    }
    @keyframes cbs-scroll-tick { 0% { top: -50%; } 100% { top: 100%; } }
    @media (max-width: 720px) {
      .cbs-hero__scroll { display: none; }
      .cbs-hero__meta { gap: var(--space-4); }
    }


    /* ---------- VALUE + PROMISES ---------- */
    .cbs-value {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
    .cbs-value__copy h2 {
      font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
      line-height: 1.15; letter-spacing: -0.015em;
      margin: var(--space-3) 0 var(--space-4);
    }
    .cbs-value__copy p {
      color: var(--bbg-text); line-height: 1.7;
      font-size: 1.0625rem; margin: 0 0 var(--space-4);
    }
    .cbs-value__copy .btn { margin-top: var(--space-4); }
    .cbs-promise {
      list-style: none; padding: var(--space-6); margin: 0;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      display: flex; flex-direction: column;
      gap: var(--space-5);
    }
    .cbs-promise > li:first-child .eyebrow { margin-bottom: 0; }
    .cbs-promise__item {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: var(--space-4);
      align-items: start;
    }
    .cbs-promise__check {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .cbs-promise__check svg { width: 16px; height: 16px; }
    .cbs-promise__item h4 {
      font-size: 1.125rem; margin: 0 0 var(--space-2);
      letter-spacing: -0.005em; color: var(--bbg-ink);
    }
    .cbs-promise__item p {
      font-size: 0.975rem; line-height: 1.55;
      color: var(--bbg-text); margin: 0;
    }

    /* Category rows inside promise */
    .cbs-cat-row {
      display: grid;
      grid-template-columns: minmax(100px, auto) 1fr;
      gap: var(--space-4);
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--bbg-border);
      align-items: baseline;
    }
    .cbs-cat-row:last-child { border-bottom: none; }
    .cbs-cat-row__cat {
      font-weight: 700; color: var(--bbg-ink);
      font-size: 0.95rem;
    }
    .cbs-cat-row__home {
      font-size: 0.95rem;
      color: var(--bbg-text);
      line-height: 1.5;
    }

    @media (max-width: 1024px) {
      .cbs-value { grid-template-columns: 1fr; gap: var(--space-6); }
    }

    /* ---------- BUSINESS MODELS BG ---------- */
    .cbs-models-section { position: relative; isolation: isolate; overflow: hidden; }
    .cbs-models-section__bg {
      position: absolute;
      top: 0; right: -8%;
      width: 55%; height: 100%;
      z-index: -1;
      opacity: 0.18;
      mask-image: radial-gradient(ellipse at right center, black 0%, transparent 65%);
      -webkit-mask-image: radial-gradient(ellipse at right center, black 0%, transparent 65%);
      pointer-events: none;
    }
    .cbs-models-section__bg img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center;
      filter: saturate(0.6);
    }
    @media (max-width: 900px) { .cbs-models-section__bg { display: none; } }

    /* ---------- BUSINESS MODELS TABS ---------- */
    .cbs-tabs {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 16px 48px -28px rgba(8, 18, 28, 0.18);
    }
    .cbs-tabs__nav {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      background: linear-gradient(180deg, var(--bbg-surface) 0%, var(--bbg-white) 100%);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-tabs--two .cbs-tabs__nav { grid-template-columns: repeat(2, 1fr); }
    .cbs-tabs__tab {
      position: relative; background: transparent; border: none;
      padding: var(--space-5) var(--space-4);
      text-align: left; cursor: pointer;
      display: flex; flex-direction: column;
      gap: 0.35rem;
      color: var(--bbg-text-muted);
      transition: color 240ms ease, background 240ms ease;
      border-right: 1px solid var(--bbg-border);
    }
    .cbs-tabs__tab:last-child { border-right: none; }
    .cbs-tabs__tab:hover { color: var(--bbg-ink); background: rgba(38, 154, 218, 0.04); }
    .cbs-tabs__tab.is-active { color: var(--bbg-ink); background: var(--bbg-white); }
    .cbs-tabs__tab-label {
      font-size: 1.0625rem; font-weight: 700;
      letter-spacing: -0.005em; line-height: 1.2;
    }
    .cbs-tabs__tab-tag {
      font-size: 0.78rem; color: var(--bbg-text-muted);
      line-height: 1.35;
    }
    .cbs-tabs__tab.is-active .cbs-tabs__tab-tag { color: var(--bbg-blue); }
    .cbs-tabs__tab-pop {
      position: absolute;
      top: var(--space-3); right: var(--space-3);
      font-size: 0.65rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .cbs-tabs__indicator {
      position: absolute;
      bottom: -1px; left: 0;
      width: 25%; height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      border-radius: 2px 2px 0 0;
      transform: translateX(0);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }
    .cbs-tabs--two .cbs-tabs__indicator { width: 50%; }
    .cbs-tabs__panels { background: var(--bbg-white); }
    .cbs-tabs__panel {
      padding: clamp(var(--space-5), 4vw + 1rem, var(--space-7));
      animation: cbs-tab-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-tab-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .cbs-tabs__panel[hidden] { display: none; }
    .cbs-tabs__panel-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .cbs-tabs__lead { display: flex; flex-direction: column; gap: var(--space-4); }
    .cbs-tabs__pillset { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .cbs-tabs__pill {
      font-size: 0.78rem; font-weight: 600;
      padding: 0.35em 0.85em;
      border-radius: 999px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      letter-spacing: 0.01em;
    }
    .cbs-tabs__title {
      font-size: clamp(1.625rem, 1.8vw + 1rem, 2.25rem);
      line-height: 1.1; margin: 0;
      letter-spacing: -0.015em;
    }
    .cbs-tabs__desc {
      font-size: 1rem; line-height: 1.6;
      color: var(--bbg-text); margin: 0;
    }
    .cbs-tabs__when {
      padding: var(--space-4);
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--bbg-blue);
    }
    .cbs-tabs__when-label {
      display: block;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.35rem;
    }
    .cbs-tabs__when p { margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--bbg-text); }
    .cbs-tabs__body { display: flex; flex-direction: column; gap: var(--space-4); }
    .cbs-tabs__image {
      margin: 0;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: var(--radius-md);
      background: var(--bbg-border);
    }
    .cbs-tabs__image img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
    .cbs-tabs__list-wrap {
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .cbs-tabs__list-wrap--alt {
      background: var(--bbg-blue-light);
    }
    .cbs-tabs__list-label {
      display: block;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .cbs-tabs__list-wrap--alt .cbs-tabs__list-label { color: var(--bbg-blue-dark); }
    .cbs-tabs__list {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-tabs__list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 0.95rem; line-height: 1.5;
      color: var(--bbg-text);
    }
    .cbs-tabs__check {
      width: 22px; height: 22px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0; margin-top: 1px;
    }
    .cbs-tabs__check--alt {
      background: var(--bbg-white);
      color: var(--bbg-blue);
      box-shadow: inset 0 0 0 1.5px var(--bbg-blue);
    }
    .cbs-tabs__check svg { width: 12px; height: 12px; }

    .cbs-owns {
      padding: var(--space-4);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      background: var(--bbg-white);
    }
    .cbs-owns__label {
      display: block;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .cbs-owns__list {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column;
      gap: 0.6rem;
    }
    .cbs-owns__list li {
      display: grid;
      grid-template-columns: minmax(150px, auto) 1fr;
      gap: var(--space-4);
      align-items: baseline;
      padding-bottom: 0.6rem;
      border-bottom: 1px dashed var(--bbg-border);
      font-size: 0.9rem;
      line-height: 1.45;
    }
    .cbs-owns__list li:last-child { border-bottom: none; padding-bottom: 0; }
    .cbs-owns__key { color: var(--bbg-text-muted); font-weight: 600; }
    .cbs-owns__val { color: var(--bbg-ink); }

    @media (max-width: 1024px) {
      .cbs-tabs--two .cbs-tabs__nav { grid-template-columns: 1fr; }
      .cbs-tabs__tab { border-right: none; border-bottom: 1px solid var(--bbg-border); }
      .cbs-tabs--two .cbs-tabs__indicator { display: none; }
      .cbs-tabs__panel-grid { grid-template-columns: 1fr; }
    }

    /* ---------- COMPARISON TABLE ---------- */
    .cbs-compare {
      margin-top: var(--space-8);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: clamp(var(--space-5), 3vw + 1rem, var(--space-7));
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    }
    .cbs-compare__intro { text-align: center; margin-bottom: var(--space-6); }
    .cbs-compare__intro h3 {
      font-size: clamp(1.375rem, 1.2vw + 1rem, 1.75rem);
      margin: var(--space-2) 0 var(--space-3);
      letter-spacing: -0.01em;
    }
    .cbs-compare__intro p {
      color: var(--bbg-text);
      max-width: 60ch; margin: 0 auto;
      line-height: 1.6; font-size: 1rem;
    }
    .cbs-compare__table-wrap { overflow-x: auto; }
    .cbs-compare__table {
      width: 100%; border-collapse: separate;
      border-spacing: 0;
      min-width: 640px;
    }
    .cbs-compare__head {
      background: var(--bbg-surface);
      padding: var(--space-4);
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-compare__head--tp { border-bottom-color: var(--bbg-blue); }
    .cbs-compare__head--dist { border-bottom-color: var(--bbg-blue-dark); }
    .cbs-compare__head-label {
      display: block;
      font-size: 1rem; font-weight: 700;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-compare__head-sub {
      display: block;
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      margin-top: 0.25rem;
    }
    .cbs-compare__row-head-col {
      width: 38%;
      background: var(--bbg-surface);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-compare__row-label {
      text-align: left;
      padding: var(--space-4);
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--bbg-text-muted);
      letter-spacing: 0.01em;
      border-bottom: 1px solid var(--bbg-border);
      background: var(--bbg-white);
    }
    .cbs-compare__cell {
      padding: var(--space-4);
      font-size: 0.95rem;
      color: var(--bbg-ink);
      border-bottom: 1px solid var(--bbg-border);
      vertical-align: top;
    }
    .cbs-compare__cell--tp {
      background: rgba(38, 154, 218, 0.04);
    }
    .cbs-compare__cell--dist {
      background: var(--bbg-white);
    }
    .cbs-compare__table tbody tr:last-child .cbs-compare__row-label,
    .cbs-compare__table tbody tr:last-child .cbs-compare__cell {
      border-bottom: none;
    }
    .cbs-compare__note {
      margin: var(--space-5) auto 0;
      max-width: 70ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 0.975rem;
    }

    /* ---------- COST SECTION (ledger redesign) ---------- */
    .cbs-cost-section {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    .cbs-cost-section__bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      overflow: hidden;
    }
    .cbs-cost-section__grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(38, 154, 218, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(38, 154, 218, 0.07) 1px, transparent 1px);
      background-size: 48px 48px;
      background-position: center;
      mask-image: radial-gradient(ellipse 70% 60% at center, #000 25%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at center, #000 25%, transparent 75%);
    }
    .cbs-cost-section__glow {
      position: absolute;
      width: 520px; height: 520px;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.55;
    }
    .cbs-cost-section__glow--a {
      top: -120px; left: -100px;
      background: radial-gradient(circle, rgba(38, 154, 218, 0.22) 0%, transparent 70%);
    }
    .cbs-cost-section__glow--b {
      bottom: -150px; right: -120px;
      background: radial-gradient(circle, rgba(91, 194, 240, 0.18) 0%, transparent 70%);
    }

    .cbs-cost {
      position: relative;
    }

    /* Model switcher */
    .cbs-cost__switcher {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      max-width: 720px;
      margin: 0 auto var(--space-6);
      padding: 6px;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(38, 154, 218, 0.16);
      border-radius: 999px;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 18px 40px -28px rgba(38, 154, 218, 0.35);
    }
    .cbs-cost__switcher-pill {
      position: absolute;
      top: 6px; left: 6px;
      width: calc(50% - 6px);
      height: calc(100% - 12px);
      border-radius: 999px;
      background: linear-gradient(135deg, var(--bbg-blue) 0%, #1E7DB0 100%);
      box-shadow:
        0 6px 18px -8px rgba(38, 154, 218, 0.6),
        0 1px 0 rgba(255, 255, 255, 0.3) inset;
      transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 0;
    }
    .cbs-cost__switcher[data-active="distributor"] .cbs-cost__switcher-pill {
      transform: translateX(100%);
    }
    .cbs-cost__switcher-tab {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 2px;
      align-items: center;
      justify-content: center;
      padding: 14px 18px;
      background: none;
      border: 0;
      cursor: pointer;
      color: var(--bbg-text);
      transition: color 280ms ease;
      font-family: inherit;
    }
    .cbs-cost__switcher-tab.is-active {
      color: #fff;
    }
    .cbs-cost__switcher-dot {
      display: none;
    }
    .cbs-cost__switcher-label {
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: -0.005em;
    }
    .cbs-cost__switcher-sub {
      font-size: 0.78rem;
      opacity: 0.78;
      font-weight: 500;
    }
    .cbs-cost__switcher-tab:focus-visible {
      outline: 2px solid var(--bbg-blue);
      outline-offset: 4px;
      border-radius: 999px;
    }

    /* Grid */
    .cbs-cost__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
      perspective: 1400px;
    }
    .cbs-cost__data { display: none; }

    /* Ledger card */
    .cbs-ledger {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      padding: 28px 28px 24px;
      background:
        linear-gradient(180deg, #ffffff 0%, #fafdff 100%);
      border: 1px solid rgba(38, 154, 218, 0.18);
      border-radius: 22px;
      overflow: hidden;
      isolation: isolate;
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 24px 48px -34px rgba(15, 50, 85, 0.18),
        0 6px 16px -10px rgba(38, 154, 218, 0.10);
      transform-style: preserve-3d;
      transform:
        perspective(1200px)
        rotateX(var(--rx, 0deg))
        rotateY(var(--ry, 0deg))
        translateY(var(--lift, 0px));
      transition:
        transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 320ms ease;
    }
    .cbs-ledger::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 50%, var(--bbg-blue) 100%);
      background-size: 200% 100%;
      animation: cbs-stripe 6s linear infinite;
      transform-origin: left;
      transform: scaleX(0.45);
      transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-stripe {
      from { background-position: 0% 0; }
      to { background-position: 200% 0; }
    }
    .cbs-ledger:hover {
      --lift: -6px;
      border-color: rgba(38, 154, 218, 0.45);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 40px 64px -36px rgba(15, 50, 85, 0.28),
        0 10px 24px -12px rgba(38, 154, 218, 0.28);
    }
    .cbs-ledger:hover::before {
      transform: scaleX(1);
    }
    .cbs-ledger__sheen {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(
          240px circle at var(--mx, 50%) var(--my, 0%),
          rgba(38, 154, 218, 0.12) 0%,
          transparent 60%
        );
      opacity: 0;
      transition: opacity 320ms ease;
      z-index: 0;
    }
    .cbs-ledger[data-tilt-active] .cbs-ledger__sheen {
      opacity: 1;
    }
    .cbs-ledger__corner {
      position: absolute;
      top: 14px; right: 14px;
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--bbg-blue);
      box-shadow:
        0 0 0 4px rgba(38, 154, 218, 0.14),
        0 0 14px rgba(38, 154, 218, 0.4);
    }
    .cbs-ledger > * { position: relative; z-index: 1; }

    .cbs-ledger__top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-bottom: 0.25rem;
    }
    .cbs-ledger__icon {
      display: inline-flex;
      width: 44px; height: 44px;
      align-items: center; justify-content: center;
      border-radius: 14px;
      background:
        linear-gradient(135deg, rgba(232, 244, 252, 0.95) 0%, rgba(38, 154, 218, 0.18) 100%);
      color: var(--bbg-blue);
      box-shadow: 0 4px 12px -6px rgba(38, 154, 218, 0.45);
    }
    .cbs-ledger__icon svg { width: 20px; height: 20px; }
    .cbs-ledger__tag {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 5px 11px;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: rgba(232, 244, 252, 0.85);
      border: 1px solid rgba(38, 154, 218, 0.22);
      border-radius: 999px;
    }
    .cbs-ledger__tag--universal {
      color: #1f6f4a;
      background: rgba(220, 245, 232, 0.9);
      border-color: rgba(38, 165, 110, 0.25);
    }
    .cbs-ledger__tag-dot {
      display: inline-block;
      width: 4px; height: 4px; border-radius: 50%;
      background: currentColor;
      opacity: 0.65;
    }
    .cbs-ledger__title {
      font-size: 1.05rem;
      line-height: 1.25;
      letter-spacing: -0.01em;
      color: var(--bbg-text-muted);
      font-weight: 600;
      margin: 0;
    }
    .cbs-ledger__headline {
      display: flex;
      align-items: baseline;
      gap: 2px;
      font-size: clamp(2.4rem, 4.6vw, 3.2rem);
      line-height: 1;
      font-weight: 700;
      letter-spacing: -0.025em;
      color: var(--bbg-ink);
      font-variant-numeric: tabular-nums;
      margin: 2px 0 0;
    }
    .cbs-ledger__headline--text {
      letter-spacing: -0.015em;
    }
    .cbs-ledger__lead {
      display: inline-flex;
      align-items: center;
      font-size: 0.32em;
      font-weight: 700;
      color: var(--bbg-text-muted);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-right: 8px;
      padding: 4px 8px;
      background: rgba(38, 154, 218, 0.10);
      border-radius: 6px;
      align-self: center;
      transform: translateY(-4px);
    }
    .cbs-ledger__lead:empty { display: none; }
    .cbs-ledger__prefix,
    .cbs-ledger__suffix {
      font-size: 0.65em;
      font-weight: 700;
      color: var(--bbg-blue);
      letter-spacing: -0.01em;
    }
    .cbs-ledger__num {
      display: inline-block;
      transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-ledger__num.is-flashing {
      animation: cbs-num-flash 480ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-num-flash {
      0% { transform: translateY(8px); opacity: 0; }
      100% { transform: translateY(0); opacity: 1; }
    }
    .cbs-ledger__unit {
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--bbg-text-muted);
      margin: 4px 0 0;
    }
    .cbs-ledger__pill {
      display: inline-flex;
      align-self: flex-start;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--bbg-ink);
      background: linear-gradient(180deg, #fff 0%, #f1f7fc 100%);
      border: 1px solid rgba(38, 154, 218, 0.22);
      border-radius: 8px;
      margin-top: 6px;
      box-shadow: 0 2px 6px -4px rgba(38, 154, 218, 0.35);
    }
    .cbs-ledger__pill::before {
      content: "";
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--bbg-blue);
      box-shadow: 0 0 8px rgba(38, 154, 218, 0.6);
    }
    .cbs-ledger__body {
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 6px 0 0;
    }

    /* Platform card buckets */
    .cbs-ledger__buckets {
      list-style: none; margin: 8px 0 0; padding: 0;
      display: flex; flex-direction: column;
      gap: 12px;
      padding-top: 14px;
      border-top: 1px dashed rgba(38, 154, 218, 0.22);
    }
    .cbs-bucket {
      display: flex; flex-direction: column;
      gap: 4px;
    }
    .cbs-bucket__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .cbs-bucket__title {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--bbg-ink);
    }
    .cbs-bucket__chip {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--bbg-blue);
      padding: 2px 8px;
      background: rgba(232, 244, 252, 0.7);
      border-radius: 6px;
    }
    .cbs-bucket__sub {
      font-size: 0.82rem;
      line-height: 1.5;
      color: var(--bbg-text-muted);
      margin: 0;
    }
    .cbs-bucket__meter {
      display: block;
      position: relative;
      height: 4px;
      background: rgba(38, 154, 218, 0.12);
      border-radius: 4px;
      overflow: hidden;
      margin-top: 4px;
    }
    .cbs-bucket__meter-fill {
      display: block;
      position: absolute;
      inset: 0;
      width: 0;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      border-radius: 4px;
      transition: width 1100ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-ledger.is-in .cbs-bucket__meter-fill {
      width: var(--meter, 50%);
    }

    .cbs-ledger__foot {
      display: grid;
      grid-template-columns: 22px 1fr;
      gap: 10px;
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px dashed rgba(15, 50, 85, 0.08);
    }
    .cbs-ledger__foot-mark {
      display: inline-flex;
      align-items: center; justify-content: center;
      width: 22px; height: 22px;
      color: var(--bbg-blue);
      opacity: 0.85;
    }
    .cbs-ledger__foot svg { width: 14px; height: 14px; }
    .cbs-ledger__foot p {
      margin: 0;
      font-size: 0.82rem;
      line-height: 1.55;
      color: var(--bbg-text-muted);
    }

    /* Variant accents */
    .cbs-ledger--platform {
      background:
        linear-gradient(180deg, #fbfffd 0%, #f3fbf7 100%);
      border-color: rgba(38, 165, 110, 0.22);
    }
    .cbs-ledger--platform::before {
      background: linear-gradient(90deg, #2EA56C 0%, #6FD7A6 50%, #2EA56C 100%);
      background-size: 200% 100%;
    }
    .cbs-ledger--platform .cbs-ledger__corner {
      background: #2EA56C;
      box-shadow:
        0 0 0 4px rgba(46, 165, 108, 0.14),
        0 0 14px rgba(46, 165, 108, 0.4);
    }
    .cbs-ledger--platform .cbs-ledger__icon {
      background: linear-gradient(135deg, rgba(220, 245, 232, 0.95) 0%, rgba(46, 165, 108, 0.2) 100%);
      color: #1f6f4a;
      box-shadow: 0 4px 12px -6px rgba(46, 165, 108, 0.45);
    }
    .cbs-ledger--platform .cbs-ledger__prefix,
    .cbs-ledger--platform .cbs-ledger__suffix {
      color: #1f6f4a;
    }
    .cbs-ledger--platform .cbs-bucket__chip {
      color: #1f6f4a;
      background: rgba(220, 245, 232, 0.75);
    }
    .cbs-ledger--platform .cbs-bucket__meter-fill {
      background: linear-gradient(90deg, #2EA56C 0%, #6FD7A6 100%);
    }
    .cbs-ledger--platform .cbs-ledger__pill {
      border-color: rgba(46, 165, 108, 0.28);
    }
    .cbs-ledger--platform .cbs-ledger__pill::before {
      background: #2EA56C;
      box-shadow: 0 0 8px rgba(46, 165, 108, 0.5);
    }
    .cbs-ledger--platform:hover {
      border-color: rgba(46, 165, 108, 0.5);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 40px 64px -36px rgba(20, 60, 40, 0.28),
        0 10px 24px -12px rgba(46, 165, 108, 0.25);
    }
    .cbs-ledger--platform .cbs-ledger__sheen {
      background:
        radial-gradient(
          240px circle at var(--mx, 50%) var(--my, 0%),
          rgba(46, 165, 108, 0.14) 0%,
          transparent 60%
        );
    }
    .cbs-ledger--platform .cbs-ledger__foot-mark { color: #1f6f4a; }

    .cbs-ledger--brand {
      background:
        linear-gradient(180deg, #fefbff 0%, #faf4ff 100%);
      border-color: rgba(124, 86, 200, 0.22);
    }
    .cbs-ledger--brand::before {
      background: linear-gradient(90deg, #7C56C8 0%, #B89BE8 50%, #7C56C8 100%);
      background-size: 200% 100%;
    }
    .cbs-ledger--brand .cbs-ledger__corner {
      background: #7C56C8;
      box-shadow:
        0 0 0 4px rgba(124, 86, 200, 0.14),
        0 0 14px rgba(124, 86, 200, 0.4);
    }
    .cbs-ledger--brand .cbs-ledger__icon {
      background: linear-gradient(135deg, rgba(238, 230, 255, 0.95) 0%, rgba(124, 86, 200, 0.2) 100%);
      color: #5C3CA2;
      box-shadow: 0 4px 12px -6px rgba(124, 86, 200, 0.45);
    }
    .cbs-ledger--brand .cbs-ledger__tag {
      color: #5C3CA2;
      background: rgba(238, 230, 255, 0.85);
      border-color: rgba(124, 86, 200, 0.25);
    }
    .cbs-ledger--brand .cbs-ledger__prefix,
    .cbs-ledger--brand .cbs-ledger__suffix {
      color: #5C3CA2;
    }
    .cbs-ledger--brand .cbs-ledger__pill {
      border-color: rgba(124, 86, 200, 0.28);
    }
    .cbs-ledger--brand .cbs-ledger__pill::before {
      background: #7C56C8;
      box-shadow: 0 0 8px rgba(124, 86, 200, 0.5);
    }
    .cbs-ledger--brand:hover {
      border-color: rgba(124, 86, 200, 0.5);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.9) inset,
        0 40px 64px -36px rgba(60, 30, 100, 0.28),
        0 10px 24px -12px rgba(124, 86, 200, 0.28);
    }
    .cbs-ledger--brand .cbs-ledger__sheen {
      background:
        radial-gradient(
          240px circle at var(--mx, 50%) var(--my, 0%),
          rgba(124, 86, 200, 0.13) 0%,
          transparent 60%
        );
    }
    .cbs-ledger--brand .cbs-ledger__foot-mark { color: #5C3CA2; }

    /* Pledge block */
    .cbs-pledge {
      position: relative;
      margin: calc(var(--space-6) + 12px) auto 0;
      max-width: 880px;
      padding: 32px 36px 28px;
      border-radius: 24px;
      background:
        radial-gradient(circle at 0% 0%, rgba(38, 154, 218, 0.22) 0%, transparent 55%),
        radial-gradient(circle at 100% 100%, rgba(91, 194, 240, 0.18) 0%, transparent 55%),
        linear-gradient(135deg, #0d2a3e 0%, #143955 60%, #1c4f74 100%);
      color: #fff;
      overflow: hidden;
      isolation: isolate;
      box-shadow:
        0 30px 70px -40px rgba(13, 42, 62, 0.7),
        0 1px 0 rgba(255, 255, 255, 0.06) inset;
    }
    .cbs-pledge::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
      background-size: 24px 24px;
      mask-image: radial-gradient(ellipse 80% 70% at 80% 30%, #000 30%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse 80% 70% at 80% 30%, #000 30%, transparent 80%);
      pointer-events: none;
      z-index: 0;
    }
    .cbs-pledge > * { position: relative; z-index: 1; }
    .cbs-pledge__mark {
      width: 38px; height: 28px;
      color: rgba(255, 255, 255, 0.32);
      margin-bottom: 10px;
    }
    .cbs-pledge__mark svg { width: 100%; height: 100%; }
    .cbs-pledge__line {
      margin: 0;
      font-size: clamp(1.15rem, 1.6vw, 1.5rem);
      line-height: 1.35;
      letter-spacing: -0.015em;
      font-weight: 600;
      color: #fff;
      max-width: 56ch;
    }
    .cbs-pledge__never {
      list-style: none;
      margin: 22px 0 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }
    .cbs-pledge__never li {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      font-size: 0.85rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.95);
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 999px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .cbs-pledge__x {
      display: inline-flex;
      align-items: center; justify-content: center;
      width: 16px; height: 16px;
      color: #FF8B7A;
    }
    .cbs-pledge__x svg { width: 100%; height: 100%; }

    .cbs-cost-note {
      margin: var(--space-5) auto 0;
      max-width: 60ch;
      text-align: center;
      font-size: 0.95rem;
      color: var(--bbg-text-muted);
      line-height: 1.6;
    }

    /* Field-swap animation */
    .cbs-cost__grid.is-swapping [data-cost-field],
    .cbs-cost__grid.is-swapping .cbs-ledger__num {
      animation: cbs-field-swap 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-field-swap {
      0% { opacity: 0; transform: translateY(6px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 1024px) {
      .cbs-cost__grid { grid-template-columns: 1fr; gap: var(--space-4); }
      .cbs-cost__switcher { max-width: 100%; }
    }
    @media (max-width: 640px) {
      .cbs-cost__switcher-sub { display: none; }
      .cbs-pledge { padding: 26px 22px 22px; }
      .cbs-ledger { padding: 22px 22px 20px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .cbs-ledger { transform: none !important; transition: none; }
      .cbs-ledger__sheen { display: none; }
      .cbs-bucket__meter-fill { transition: none; }
      .cbs-cost__switcher-pill { transition: none; }
    }

    /* ---------- JOURNEY (vertical timeline) ---------- */
    .cbs-journey-section { position: relative; isolation: isolate; overflow: hidden; }
    .cbs-journey-section__bg {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: -2;
      opacity: 0.10;
      pointer-events: none;
    }
    .cbs-journey-section__bg::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, var(--bbg-white) 0%, rgba(255, 255, 255, 0.4) 40%, rgba(255, 255, 255, 0.7) 100%);
    }
    .cbs-journey-section__bg img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center;
      filter: saturate(0.55);
    }
    .cbs-journey {
      position: relative;
      max-width: 880px;
      margin: 0 auto;
      padding-left: 56px;
    }
    .cbs-journey__rail {
      position: absolute;
      top: 0; bottom: 0;
      left: 22px; width: 2px;
    }
    .cbs-journey__rail-track {
      position: absolute; inset: 0;
      background: var(--bbg-border);
      border-radius: 2px;
    }
    .cbs-journey__rail-fill {
      position: absolute;
      top: 0; left: 0; width: 100%;
      height: var(--journey-progress, 0%);
      background: linear-gradient(180deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      border-radius: 2px;
      transition: height 120ms linear;
      box-shadow: 0 0 8px rgba(38, 154, 218, 0.4);
    }
    .cbs-journey__list {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column;
      gap: var(--space-7);
    }
    .cbs-journey__item { position: relative; }
    .cbs-journey__dot {
      position: absolute;
      left: -56px; top: 0;
      width: 44px; height: 44px;
      border-radius: 50%;
      background: var(--bbg-white);
      border: 2px solid var(--bbg-border);
      display: flex; align-items: center; justify-content: center;
      z-index: 2;
      transition: border-color 320ms ease;
    }
    .cbs-journey__dot-inner {
      width: 14px; height: 14px;
      border-radius: 50%;
      background: var(--bbg-border);
      transition: background 320ms ease, transform 320ms ease;
    }
    .cbs-journey__item.is-active .cbs-journey__dot { border-color: var(--bbg-blue); }
    .cbs-journey__item.is-active .cbs-journey__dot-inner {
      background: var(--bbg-blue);
      transform: scale(1.1);
      box-shadow: 0 0 0 4px var(--bbg-blue-light);
    }
    .cbs-journey__phase {
      display: inline-block;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-2);
      transition: color 320ms ease;
    }
    .cbs-journey__duration {
      font-weight: 500;
      color: var(--bbg-text-muted);
      letter-spacing: 0.04em;
      text-transform: none;
    }
    .cbs-journey__item.is-active .cbs-journey__phase { color: var(--bbg-blue); }
    .cbs-journey__card {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5) var(--space-6);
      display: flex; align-items: flex-start;
      gap: var(--space-4);
      transition: border-color 320ms ease, box-shadow 320ms ease, transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-journey__item:hover .cbs-journey__card,
    .cbs-journey__item.is-active .cbs-journey__card {
      border-color: var(--bbg-blue);
      box-shadow: 0 18px 38px -22px rgba(38, 154, 218, 0.4);
      transform: translateX(4px);
    }
    .cbs-journey__icon {
      display: inline-flex;
      width: 48px; height: 48px;
      align-items: center; justify-content: center;
      border-radius: 14px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      flex-shrink: 0;
    }
    .cbs-journey__icon svg { width: 24px; height: 24px; }
    .cbs-journey__title {
      font-size: 1.25rem; line-height: 1.25;
      margin: 0 0 0.4rem;
      letter-spacing: -0.005em;
    }
    .cbs-journey__desc {
      font-size: 0.95rem; line-height: 1.55;
      color: var(--bbg-text); margin: 0;
    }
    @media (max-width: 600px) {
      .cbs-journey { padding-left: 40px; }
      .cbs-journey__rail { left: 16px; }
      .cbs-journey__dot { left: -40px; width: 32px; height: 32px; }
      .cbs-journey__dot-inner { width: 10px; height: 10px; }
      .cbs-journey__card { flex-direction: column; gap: var(--space-3); }
    }

    /* ---------- SISTER PRODUCT ---------- */
    .cbs-sister {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-6);
      align-items: stretch;
    }
    .cbs-sister__hero {
      position: relative;
      padding: clamp(var(--space-6), 4vw, var(--space-8));
      background: linear-gradient(160deg, #1a0f1f 0%, #2a1530 60%, #401a45 100%);
      color: var(--bbg-white);
      border-radius: 24px;
      overflow: hidden;
      isolation: isolate;
      display: flex; flex-direction: column;
      gap: var(--space-4);
    }
    .cbs-sister__hero::before {
      content: "";
      position: absolute; inset: 0; z-index: -1;
      background:
        radial-gradient(60% 80% at 100% 0%, rgba(255, 90, 130, 0.25) 0%, transparent 60%),
        radial-gradient(40% 60% at 0% 100%, rgba(255, 60, 100, 0.18) 0%, transparent 60%);
    }
    .cbs-sister__chip {
      display: inline-block;
      align-self: flex-start;
      font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: #FFC2D1;
      background: rgba(255, 90, 130, 0.18);
      padding: 0.4em 0.85em;
      border-radius: 999px;
      border: 1px solid rgba(255, 194, 209, 0.3);
    }
    .cbs-sister__title {
      font-size: clamp(1.5rem, 1.6vw + 1rem, 2.125rem);
      line-height: 1.15;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-white);
    }
    .cbs-sister__desc {
