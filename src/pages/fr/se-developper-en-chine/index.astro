---
import Layout from '../../../layouts/Layout.astro';

const services = [
  {
    eyebrow: 'Boutiques',
    title: 'Cross-Border eCommerce',
    tagline:
      "Tmall Global, JD Worldwide. Pilotage opérationnel des flagships, de la logistique entrepôt jusqu'à l'encaissement.",
    href: '/fr/se-developper-en-chine/ecommerce-transfrontalier',
    cta: 'Découvrir le pôle boutique',
    image: '/Images/grow-in-china/hero-livestream-shopper.png',
    alt: 'Une consommatrice chinoise valide son panier Tmall Global pendant un livestream, depuis son téléphone',
    accent: '#C8102E',
    accentSoft: '#FBE9EC',
    span: 'wide',
  },
  {
    eyebrow: 'Canaux',
    title: 'Social Commerce',
    tagline:
      'Douyin, WeChat, Xiaohongshu. Studios livestream intégrés et production quotidienne de contenus.',
    href: '/fr/se-developper-en-chine/commerce-social',
    cta: 'Découvrir le pôle social',
    image: '/Images/grow-in-china/social-commerce/hero-douyin-livestream.png',
    alt: "Un plateau livestream Douyin, animatrice à l'image et opérateur au pupitre",
    accent: '#E54B6E',
    accentSoft: '#FCEAEF',
    span: 'narrow',
  },
  {
    eyebrow: 'Moments forts',
    title: 'Campagnes',
    tagline:
      '618, Singles Day, Nouvel An chinois : les rendez-vous structurants du calendrier commercial, conduits de bout en bout.',
    href: '/fr/se-developper-en-chine/campagnes',
    cta: 'Découvrir le pôle campagne',
    image: '/Images/grow-in-china/campaigns/hero-campaign-warroom.png',
    alt: 'Une salle de pilotage de campagne pendant un festival commercial chinois, des opérateurs suivent un tableau GMV en direct',
    accent: '#DC2626',
    accentSoft: '#FEE2E2',
    span: 'third',
  },
  {
    eyebrow: 'Audience',
    title: 'Médias',
    tagline:
      "Achat performance et achat marque sur les plateformes chinoises, accompagné d'un reporting que vos équipes peuvent réellement exploiter.",
    href: '/fr/se-developper-en-chine/medias',
    cta: 'Découvrir le pôle médias',
    image: '/Images/grow-in-china/media/hero-media-buying.png',
    alt: 'Un acheteur média passe en revue les tableaux de bord Tencent et ByteDance dans un bureau de Shanghai',
    accent: '#C8102E',
    accentSoft: '#FCEAEF',
    span: 'third',
  },
  {
    eyebrow: 'Voix',
    title: 'Influence et KOL',
    tagline:
      "Sélection de KOL et opérations sponsorisées sur les plateformes qui convertissent véritablement à l'achat.",
    href: '/fr/se-developper-en-chine/influence-et-kol',
    cta: 'Découvrir le pôle KOL',
    image: '/Images/grow-in-china/influencers-kols/hero-kol-livestream.png',
    alt: 'Une KOL Douyin présente une marque étrangère à sa communauté pendant un livestream sponsorisé',
    accent: '#F59E0B',
    accentSoft: '#FFF4E0',
    span: 'third',
  },
];

const studios = [
  {
    label: 'ChinaWebFoundry',
    desc: 'Votre site conçu à Shanghai, pensé pour le marché chinois. Dépôt ICP, hébergement local, performances assurées en aval du Grand Firewall.',
    href: 'https://chinawebfoundry.com',
    logo: '/Images/AgencyLogos/Logo-ChinaWebFoundry-transparent.webp',
  },
  {
    label: 'hubStudio',
    desc: 'Notre maison de production intégrée. Tournage, montage, post-production, motion design. Des formats calibrés pour les plateformes chinoises.',
    href: 'https://hubstudio.ai',
    logo: '/Images/AgencyLogos/hubStudio%20(2).webp',
  },
];
---

<Layout
  title="Se développer en Chine | Agence marketing et e-commerce | TheChinaPath"
  description="Notre agence marketing et e-commerce à Shanghai pilote votre activité chinoise au quotidien : cross-border, social commerce, campagnes, médias, influence et KOL."
>
  {/* ---------- HERO ---------- */}
  <section class="hero-fullbleed">
    <picture>
      <img
        src="/Images/grow-in-china/hero-livestream-shopper.png"
        alt=""
        class="hero-fullbleed__image"
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-fullbleed__overlay" aria-hidden="true"></div>

    <div class="container hero-fullbleed__inner">
      <div class="hero-fullbleed__copy">
        <span class="eyebrow eyebrow--on-dark">Se développer en Chine</span>
        <h1 class="hero-fullbleed__title">L'opération chinoise, tenue au jour le jour.</h1>
        <p class="hero-fullbleed__lead">
          Une équipe basée à Shanghai prend en charge vos boutiques, vos canaux et la voix de votre
          marque. Vous choisissez le périmètre que vous nous confiez, et à quelle cadence.
        </p>
        <div class="hero-fullbleed__actions">
          <a class="btn btn--primary" href="/fr/nous-contacter">Entrer en relation</a>
          <a class="btn btn--ghost-light" href="#services">Consulter les services</a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- SERVICES GRID ---------- */}
  <section class="section" id="services">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Cinq services, une équipe</span>
        <h2>Dites-nous par où ça doit commencer.</h2>
        <p class="section-header__lead">
          Certaines marques cherchent un opérateur pour tenir leur boutique phare. D'autres veulent
          caler une cadence régulière sur le livestream. D'autres encore ont arrêté un plan 618 sans
          avoir l'équipe pour l'exécuter. Démarrez par le point le plus tendu.
        </p>
      </header>

      <div class="grow-grid">
        {
          services.map((s) => (
            <a
              href={s.href}
              class={`grow-tile grow-tile--${s.span}`}
              style={`--accent: ${s.accent}; --accent-soft: ${s.accentSoft};`}
            >
              <div class="grow-tile__media">
                <img src={s.image} alt={s.alt} loading="lazy" decoding="async" />
                <div class="grow-tile__scrim" aria-hidden="true" />
              </div>

              <div class="grow-tile__body">
                <span class="grow-tile__eyebrow">{s.eyebrow}</span>
                <h3 class="grow-tile__title">{s.title}</h3>
                <p class="grow-tile__tagline">{s.tagline}</p>
                <span class="grow-tile__cta">
                  {s.cta}
                  <span class="grow-tile__arrow" aria-hidden="true">
                    →
                  </span>
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- STUDIOS ---------- */}
  <section class="section section--tight section--alt" id="studios">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Studios du groupe</span>
        <h2>Deux studios maison, mobilisables sans couture.</h2>
        <p class="section-header__lead">
          Quand la mission exige un site hébergé derrière le Grand Firewall, ou un dispositif de
          production complet, ces deux studios prennent le relais sur leur périmètre.
        </p>
      </header>

      <div class="studio-grid">
        {
          studios.map((st) => (
            <a
              href={st.href}
              target="_blank"
              rel="noopener noreferrer"
              class="studio-card"
              aria-label={`${st.label} (s'ouvre dans un nouvel onglet) : ${st.desc}`}
            >
              <span class="studio-card__logobox">
                <img src={st.logo} alt={st.label} loading="lazy" width="320" height="80" />
              </span>
              <span class="studio-card__desc">{st.desc}</span>
              <span class="studio-card__cta">
                Consulter le site
                <span aria-hidden="true">↗</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- FINAL CTA ---------- */}
  <section class="section section--tight">
    <div class="container">
      <div class="grow-cta">
        <div class="grow-cta__copy">
          <span class="eyebrow">Pas sûr du point de départ ?</span>
          <h2>Envoyez-nous votre dernier bilan de campagne. On vous dit ce qui manque.</h2>
          <p class="grow-cta__lead">
            Un opérateur senior vous répond, pas un chatbot. Vingt minutes d'échange suffisent
            souvent à éviter un trimestre de tâtonnements.
          </p>
        </div>
        <div class="grow-cta__actions">
          <a class="btn btn--primary" href="/fr/nous-contacter">Engager la conversation</a>
          <a class="btn btn--ghost" href="/fr/nos-realisations">Consulter nos réalisations</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Bento services grid ---------- */
  .grow-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.5rem;
  }

  .grow-tile--wide {
    grid-column: span 4;
  }
  .grow-tile--narrow {
    grid-column: span 2;
  }
  .grow-tile--third {
    grid-column: span 2;
  }

  .grow-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 380px;
    padding: 2rem;
    border-radius: 16px;
    overflow: hidden;
    color: #fff;
    background: var(--bbg-ink);
    isolation: isolate;
    transition:
      transform 300ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .grow-tile--wide {
    min-height: 440px;
  }
  .grow-tile--narrow {
    min-height: 440px;
  }

  .grow-tile::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--accent);
    z-index: 3;
  }

  .grow-tile__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .grow-tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .grow-tile__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.3) 45%,
      rgba(0, 0, 0, 0.85) 100%
    );
    z-index: 1;
    transition: opacity 300ms ease;
  }

  .grow-tile__body {
    position: relative;
    z-index: 2;
    max-width: 36rem;
  }

  .grow-tile__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    margin-bottom: 1rem;
  }

  .grow-tile__title {
    font-size: clamp(1.4rem, 1.6vw + 0.9rem, 1.85rem);
    line-height: 1.15;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.55rem;
    letter-spacing: -0.01em;
  }

  .grow-tile--wide .grow-tile__title {
    font-size: clamp(1.6rem, 2.2vw + 1rem, 2.25rem);
  }

  .grow-tile__tagline {
    font-size: 1rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
    margin: 0 0 1.15rem;
    max-width: 28rem;
  }

  .grow-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    width: fit-content;
    transition:
      border-color 200ms ease,
      color 200ms ease;
  }

  .grow-tile__arrow {
    display: inline-block;
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .grow-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
    color: #fff;
  }
  .grow-tile:hover .grow-tile__media img {
    transform: scale(1.05);
  }
  .grow-tile:hover .grow-tile__scrim {
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.15) 0%,
      rgba(0, 0, 0, 0.5) 45%,
      rgba(0, 0, 0, 0.9) 100%
    );
  }
  .grow-tile:hover .grow-tile__cta {
    border-color: #fff;
  }
  .grow-tile:hover .grow-tile__arrow {
    transform: translateX(6px);
  }

  .grow-tile:focus-visible {
    outline: 3px solid var(--bbg-blue);
    outline-offset: 4px;
  }

  /* ---------- Studios row ---------- */
  .studio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .studio-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--bbg-border);
    color: var(--bbg-text);
    text-decoration: none;
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .studio-card__logobox {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 56px;
  }
  .studio-card__logobox img {
    max-height: 100%;
    width: auto;
    object-fit: contain;
  }

  .studio-card__desc {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--bbg-text);
    margin: 0;
  }

  .studio-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--bbg-blue);
    font-size: 0.95rem;
  }

  .studio-card:hover {
    transform: translateY(-3px);
    border-color: var(--bbg-blue);
    box-shadow: 0 16px 32px rgba(200, 16, 46, 0.1);
  }
  .studio-card:focus-visible {
    outline: 3px solid var(--bbg-blue);
    outline-offset: 3px;
  }

  /* ---------- Final CTA ---------- */
  .grow-cta {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: center;
  }
  .grow-cta__copy h2 {
    margin: 0 0 0.75rem;
  }
  .grow-cta__lead {
    font-size: 1.0625rem;
    color: var(--bbg-text);
    margin: 0;
    max-width: 38rem;
  }
  .grow-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 1024px) {
    .grow-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .grow-tile--wide,
    .grow-tile--narrow,
    .grow-tile--third {
      grid-column: span 1;
    }
    .grow-tile--wide {
      grid-column: span 2;
    }
  }

  @media (max-width: 720px) {
    .grow-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .grow-tile--wide,
    .grow-tile--narrow,
    .grow-tile--third {
      grid-column: span 1;
      min-height: 360px;
    }
    .studio-grid {
      grid-template-columns: 1fr;
    }
    .grow-cta {
      grid-template-columns: 1fr;
    }
    .grow-cta__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 480px) {
    .grow-tile {
      min-height: 340px;
      padding: 1.5rem;
    }
    .grow-tile__tagline {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .grow-tile,
    .grow-tile__media img,
    .grow-tile__scrim,
    .grow-tile__cta,
    .grow-tile__arrow,
    .studio-card {
      transition: none !important;
    }
  }
</style>
