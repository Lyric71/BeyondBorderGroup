  wechat: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 4C5.4 4 2 6.7 2 10c0 1.9 1.1 3.6 2.9 4.7L4 18l3.4-1.7c.7.2 1.4.3 2.1.3"/><path d="M22 14c0-2.9-3-5.3-6.7-5.3S8.6 11.1 8.6 14s3 5.3 6.7 5.3c.6 0 1.2-.1 1.8-.2L20 20.5l-.7-2.5c1.7-1 2.7-2.5 2.7-4z"/><circle cx="6.5" cy="9.5" r=".8" fill="currentColor"/><circle cx="10.5" cy="9.5" r=".8" fill="currentColor"/><circle cx="13" cy="13.5" r=".8" fill="currentColor"/><circle cx="17" cy="13.5" r=".8" fill="currentColor"/></svg>`,
  video: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="14" height="12" rx="2"/><polygon points="17 9 22 6 22 18 17 15"/><circle cx="8" cy="11" r="1.2" fill="currentColor"/></svg>`,
  heart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.4-9.3-9C1.4 9 3 5 6.5 5c2 0 3.5 1.2 4.5 2.5C12 6.2 13.5 5 15.5 5 19 5 20.6 9 21.3 12 19 16.6 12 21 12 21z"/></svg>`,
  search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.2" y1="16.2" x2="21" y2="21"/></svg>`,
  film: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="7" y1="4" x2="7" y2="20"/><line x1="17" y1="4" x2="17" y2="20"/><line x1="3" y1="9" x2="7" y2="9"/><line x1="3" y1="15" x2="7" y2="15"/><line x1="17" y1="9" x2="21" y2="9"/><line x1="17" y1="15" x2="21" y2="15"/></svg>`,
  target: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>`,
  store: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1.5-5h15L21 9"/><path d="M3 9v10a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9"/><path d="M3 9h18"/><path d="M9 13h6"/></svg>`,
  cart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M3 4h2l2.7 11.5a1 1 0 0 0 1 .8h9.6a1 1 0 0 0 1-.78L21 8H6.2"/></svg>`,
  live: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="14" height="11" rx="2"/><polygon points="17 8 22 5.5 22 15.5 17 13"/><circle cx="20" cy="19" r="2" fill="#E24B4B" stroke="none"/></svg>`,
  note: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>`,
  doc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>`,
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Paid media buying in China',
  provider: {
    '@type': 'Organization',
    name: 'Beyond Border Group',
    url: 'https://beyondbordergroup.com',
  },
  areaServed: { '@type': 'Country', name: 'China' },
};
---

<Layout
  title="Achat média en Chine : WeChat, Douyin, RED et Baidu"
  description="Achat média en Chine sur WeChat, Douyin, RED et Baidu, opéré par une équipe senior qui assume les chiffres. Démarrez par un audit média."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} is:inline />

  <div class="cbs-progress" aria-hidden="true"><div class="cbs-progress__bar"></div></div>
  <article class="cbs">

    {/* ---------- HERO ---------- */}
    <section class="cbs-hero" data-hero>
      <div class="cbs-hero__bg" aria-hidden="true" data-parallax>
        <img src="/Images/grow-in-china/media/hero-media-buying.png" alt="Un acheteur média à son bureau dans des locaux de Shanghai en fin d'après-midi, deux moniteurs affichent les tableaux de bord des plateformes publicitaires chinoises" />
      </div>
      <div class="cbs-hero__overlay" aria-hidden="true"></div>
      <div class="cbs-hero__grain" aria-hidden="true"></div>

      <div class="container cbs-hero__inner">
        <nav class="cbs-hero__crumbs" aria-label="Fil d'Ariane">
          <a href="/fr/">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/fr/#services">Se développer en Chine</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark cbs-reveal">Médias</span>
        <h1 class="cbs-hero__title cbs-reveal" style="--reveal-delay: 80ms;">
          <span class="cbs-hero__title-row">Votre budget média Chine</span>
          <span class="cbs-hero__title-row cbs-hero__title-row--accent">mérite une équipe senior.</span>
          <span class="cbs-hero__title-row cbs-hero__title-row--highlight">Nous le planifions, l'achetons, l'opérons.</span>
        </h1>
        <p class="cbs-hero__lead cbs-reveal" style="--reveal-delay: 200ms;">
          Les personnes qui montent votre compte sont celles qui le tiennent encore à la revue mensuelle.
          Aucune strate, aucun passage de relais, aucun account manager junior qui apprend les plateformes
          à vos frais.
        </p>
        <div class="cbs-hero__actions cbs-reveal" style="--reveal-delay: 280ms;">
          <a href="/fr/nous-contacter" class="btn btn--primary cbs-magnetic">Réserver un audit média</a>
          <a href="#how-we-work" class="btn btn--ghost-light cbs-magnetic">Voir notre méthode</a>
        </div>

        <div class="cbs-hero__meta cbs-reveal" style="--reveal-delay: 360ms;">
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num" data-counter="15" data-suffix="+">0</span>
            <span class="cbs-hero__meta-label">ans à tenir l'achat média pour des marques étrangères</span>
          </div>
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num" data-counter="40" data-suffix="+">0</span>
            <span class="cbs-hero__meta-label">comptes publicitaires actifs sur les plateformes chinoises</span>
          </div>
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num">Une équipe</span>
            <span class="cbs-hero__meta-label">Stratégie, créatif, achat et reporting, de bout en bout</span>
          </div>
        </div>
      </div>

      <a href="#who-we-work-with" class="cbs-hero__scroll" aria-label="Aller à la section suivante">
        <span class="cbs-hero__scroll-line"></span>
        <span class="cbs-hero__scroll-text">Faire défiler</span>
      </a>
    </section>

    {/* ---------- WHO WE WORK WITH ---------- */}
    <section id="who-we-work-with" class="section cbs-truths-section">
      <div class="cbs-truths-bg" aria-hidden="true">
        <div class="cbs-truths-bg__blob cbs-truths-bg__blob--a"></div>
        <div class="cbs-truths-bg__blob cbs-truths-bg__blob--b"></div>
        <div class="cbs-truths-bg__grid"></div>
      </div>

      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Votre point de départ</span>
          <h2>La plupart des marques nous rejoignent dans l'une de ces trois situations.</h2>
          <p class="section-header__lead">
            Une de ces situations est probablement la vôtre. Le plan diffère selon le cas, l'équipe
            qui le pilote reste la même.
          </p>
        </header>

        <div class="cbs-truths cbs-truths--three">
          {whereYouAre.map((c, i) => (
            <article
              class={`cbs-truth cbs-truth--text${i === 1 ? ' cbs-truth--alt' : ''} cbs-reveal`}
              style={`--reveal-delay: ${i * 100}ms;`}
              data-truth-tilt
            >
              <div class="cbs-truth__inner">
                <div class="cbs-truth__icon" aria-hidden="true" set:html={c.icon} />
                <div class="cbs-truth__kicker">
                  <span class="cbs-truth__kicker-dot"></span>
                  {c.kicker}
                </div>
                <div class="cbs-truth__content">
                  <h3 class="cbs-truth__title">{c.title}</h3>
                  <p class="cbs-truth__body">{c.body}</p>
                </div>
              </div>
            </article>
          ))}
        </div>

        <p class="cbs-cards__note cbs-reveal">Nous opérons les trois cas. Le plan diffère pour chacun.</p>
      </div>
    </section>

    {/* ---------- WHAT WE DO ---------- */}
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Ce que nous faisons</span>
          <h2>Deux périmètres, une équipe.</h2>
          <p class="section-header__lead">
            Nous opérons l'achat média sur les plateformes qui comptent en Chine. Chacune fonctionne
            différemment. Chacune réclame son propre plan, son propre créatif, sa propre logique
            d'enchères. Nous les maîtrisons parce que nous y sommes tous les jours, pas parce que nous
            avons lu une étude de cas à leur sujet.
          </p>
        </header>

        <div class="cbs-sub">
          <span class="eyebrow">Plateformes marque et audience</span>
        </div>

        <div class="cbs-services cbs-reveal">
          {brandReach.map((s, i) => (
            <article class="cbs-service cbs-service--static" style={`--reveal-delay: ${i * 60}ms;`}>
              <span class="cbs-service__icon" aria-hidden="true" set:html={icons[s.icon]} />
              <h3 class="cbs-service__title">{s.title}</h3>
              <p class="cbs-service__body">{s.body}</p>
            </article>
          ))}
        </div>

        <figure class="cbs-band cbs-reveal">
          <img
            src="/Images/grow-in-china/media/ecommerce-media-band.png"
            alt="Un téléphone affiche une page boutique Douyin tenu dans un cadre logistique, l'entrepôt en flou doux à l'arrière-plan"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="cbs-sub cbs-sub--ec">
          <span class="eyebrow">Médias eCommerce</span>
          <p class="cbs-sub__lead">
            C'est là que le trafic payant se transforme en ventes. Si vous vendez en Chine, c'est en général là que
            le budget doit aller en premier, avant les lignes de notoriété de marque.
            
          </p>
        </div>

        <div class="cbs-services cbs-services--two cbs-reveal">
          {ecommerceMedia.map((s, i) => (
            <article class="cbs-service cbs-service--static" style={`--reveal-delay: ${i * 60}ms;`}>
              <span class="cbs-service__icon" aria-hidden="true" set:html={icons[s.icon]} />
              <h3 class="cbs-service__title">{s.title}</h3>
              <p class="cbs-service__body">{s.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- WHY BRANDS STAY WITH US ---------- */}
    <section class="section">
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Pourquoi les marques restent</span>
          <h2>La plupart des agences média staffent votre compte de juniors. Pas nous.</h2>
          <p class="section-header__lead">
            L'équipe qui signe le contrat est celle qui opère la mission. Mêmes noms au
            kickoff, mêmes noms à la revue mensuelle.
          </p>
        </header>

        <div class="cbs-cards cbs-cards--4 cbs-reveal">
          {whyStay.map((c, i) => (
            <article class="cbs-card cbs-card--accent" style={`--reveal-delay: ${i * 70}ms;`}>
              <h3 class="cbs-card__title">{c.title}</h3>
              <p class="cbs-card__body">{c.body}</p>
            </article>
          ))}
        </div>

        <blockquote class="cbs-quote cbs-reveal">
          <p>
            L'équipe qui monte votre compte est celle qui le tient encore à la revue mensuelle.
            En Chine, cette continuité fait la différence entre dépense et gaspillage.
          </p>
        </blockquote>
      </div>
    </section>

    {/* ---------- HOW WE WORK ---------- */}
    <section id="how-we-work" class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Notre méthode</span>
          <h2>Quatre semaines avant la mise en ligne, puis une cadence hebdomadaire.</h2>
          <p class="section-header__lead">
            Une équipe. Stratégie, planning média, créatif, achat, optimisation, reporting,
            tout en interne et tout au niveau senior.
          </p>
        </header>

        <div class="cbs-tabs cbs-reveal" data-tabs>
          <div class="cbs-tabs__nav" role="tablist">
            {weeks.map((w, i) => (
              <button
                type="button"
                class={`cbs-tabs__tab${i === 0 ? ' is-active' : ''}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`week-panel-${i}`}
                id={`week-tab-${i}`}
                data-tab-target={`week-panel-${i}`}
                data-tab-id={w.tabId}
              >
                <span class="cbs-tabs__tab-label">{w.name}</span>
                <span class="cbs-tabs__tab-tag">{w.tag}</span>
              </button>
            ))}
            <span class="cbs-tabs__indicator" aria-hidden="true"></span>
          </div>

          <div class="cbs-tabs__panels">
            {weeks.map((w, i) => (
              <div
                class={`cbs-tabs__panel${i === 0 ? ' is-active' : ''}`}
                role="tabpanel"
                id={`week-panel-${i}`}
                aria-labelledby={`week-tab-${i}`}
                hidden={i !== 0}
              >
                <div class="cbs-tabs__panel-grid">
                  <div class="cbs-tabs__lead">
                    <span class="cbs-tabs__pillset">
                      <span class="cbs-tabs__pill">{w.pill}</span>
                    </span>
                    <h3 class="cbs-tabs__title">{w.title}</h3>
                    <p class="cbs-tabs__desc">{w.desc}</p>

                    <div class="cbs-tabs__when">
                      <span class="cbs-tabs__when-label">Résultat</span>
                      <p>{w.outcome}</p>
                    </div>

                    <figure class="cbs-tabs__image">
                      <img src={w.image} alt={w.imageAlt} loading="lazy" decoding="async" />
                    </figure>
                  </div>

                  <div class="cbs-tabs__body">
                    <div class="cbs-tabs__list-wrap">
                      <span class="cbs-tabs__list-label">Ce que nous faisons</span>
                      <ul class="cbs-tabs__list">
                        {w.does.map((b) => (
                          <li>
                            <span class="cbs-tabs__check" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8"/></svg>
                            </span>
                            <span>{b}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <div class="cbs-tabs__list-wrap cbs-tabs__list-wrap--alt">
                      <span class="cbs-tabs__list-label">Livrables</span>
                      <ul class="cbs-tabs__list">
                        {w.deliverables.map((d) => (
                          <li>
                            <span class="cbs-tabs__check cbs-tabs__check--alt" aria-hidden="true" set:html={icons.doc} />
                            <span>{d}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <p class="cbs-tabs__note cbs-reveal">
          Vous avez aussi le tableau de bord. Mêmes chiffres que nous, au même moment
          que nous.
        </p>
      </div>
    </section>

    {/* ---------- COMPLIANCE ---------- */}
    <section class="section">
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Conformité</span>
          <h2>En Chine, la loi décide de ce que votre annonce peut dire.</h2>
          <p class="section-header__lead">
            Trois règles piègent les marques étrangères plus que les autres. La FAQ plus bas
            approfondit chacune.
          </p>
        </header>

        <figure class="cbs-band cbs-band--narrow cbs-reveal">
          <img
            src="/Images/grow-in-china/media/compliance-adlaw-band.png"
            alt="Une feuille imprimée de copywriting marketing chinois, un stylo rouge posé dessus, quelques mots entourés, lumière naturelle sur le bureau"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="cbs-cards cbs-cards--3 cbs-reveal">
          {compliance.map((c, i) => (
            <article class="cbs-card" style={`--reveal-delay: ${i * 80}ms;`}>
              <h3 class="cbs-card__title">{c.title}</h3>
              <p class="cbs-card__body">{c.body}</p>
              <a href="#faq" class="cbs-card__link">Plus de détails en FAQ
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- FAQ ---------- */}
    <section id="faq" class="section section--alt">
      <div class="container container--narrow">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">FAQ</span>
          <h2>Vingt-cinq questions, réponses directes.</h2>
          <p class="section-header__lead">
            Les questions que les marques étrangères nous posent au premier rendez-vous. À filtrer par sujet.
          </p>
        </header>

        <div class="cbs-faq-filter cbs-reveal" data-faq-filter role="tablist" aria-label="Filtrer la FAQ par catégorie">
          {faqCategories.map((c, i) => (
            <button
              type="button"
              class={`cbs-faq-chip${i === 0 ? ' is-active' : ''}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-faq-cat={c}
            >
              <span class="cbs-faq-chip__label">{c}</span>
              <span class="cbs-faq-chip__count">{c === "Toutes" ? faqs.length : faqs.filter((f) => f.cat === c).length}</span>
            </button>
          ))}
        </div>

        <div class="cbs-faq" data-faq-list>
          {faqs.map((f, i) => (
            <details
              class="cbs-faq__item cbs-reveal"
              data-faq-cat={f.cat}
              open={i === 0}
              style={`--reveal-delay: ${Math.min(i, 6) * 40}ms;`}
            >
              <summary class="cbs-faq__q">
                <span class="cbs-faq__cat-tag">{f.cat}</span>
                <span class="cbs-faq__q-text">{f.q}</span>
                <span class="cbs-faq__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <div class="cbs-faq__a">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- FINAL CTA ---------- */}
    <section class="section section--tight">
      <div class="container container--narrow">
        <div class="cbs-cta">
          <span class="eyebrow eyebrow--on-dark">Parlons-en</span>
          <h2 class="cbs-cta__title">Prêts à confier votre budget média Chine à des mains seniors ?</h2>
          <p class="cbs-cta__lead">
            Démarrez par un audit média. Nous regarderons ce que vous opérez aujourd'hui, ou ce qu'il
            vous faudrait pour démarrer, et nous reviendrons avec une lecture franche : ce qui fonctionne, ce qui
            ne fonctionne pas, ce que nous ferions différemment. Pas de deck rempli de jargon, juste l'image
            réelle. Vous avez déjà un brief ? Envoyez-le.
          </p>
          <div class="cbs-cta__actions">
            <a href="/fr/nous-contacter" class="btn cbs-cta__btn-primary">Réserver un audit média</a>
            <a href="/fr/nos-realisations" class="btn cbs-cta__btn-ghost">Voir nos réalisations</a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <style is:global>
    /* ---------- Container narrow helper ---------- */
    .cbs .container--narrow { max-width: 880px; }

    /* ---------- REVEAL + MOTION ---------- */
    @media (prefers-reduced-motion: no-preference) {
      .cbs-reveal {
        opacity: 0;
        transform: translateY(16px);
        transition:
          opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
          transform 700ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms);
      }
      .cbs-reveal.is-in { opacity: 1; transform: translateY(0); }
      .cbs-magnetic {
        will-change: transform;
        transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
                    box-shadow 220ms ease, background-color 200ms ease, color 200ms ease;
      }
    }

    /* ---------- SCROLL PROGRESS BAR ---------- */
    .cbs-progress {
      position: fixed; top: 0; left: 0; right: 0;
      height: 3px; z-index: 1000;
      background: transparent; pointer-events: none;
    }
    .cbs-progress__bar {
      height: 100%; width: var(--progress, 0%);
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 60%, #9DDBF5 100%);
      box-shadow: 0 0 12px rgba(38, 154, 218, 0.55);
      transition: width 80ms linear;
    }

    /* ---------- HERO ---------- */
    .cbs-hero {
      position: relative;
      min-height: clamp(360px, 48vh, 500px);
      display: flex; align-items: flex-start;
      padding: clamp(8px, 1.25vh, 16px) 0 clamp(48px, 7vh, 80px);
      color: var(--bbg-white);
      overflow: hidden; isolation: isolate;
    }
    body:has(.cbs-hero) .cbs-hero { padding-top: clamp(112px, 10vh, 144px); }
    @media (max-width: 1024px) {
      body:has(.cbs-hero) .cbs-hero { padding-top: clamp(96px, 9vh, 116px); }
    }
    .cbs-hero__bg { position: absolute; inset: -10% 0 0; z-index: -3; }
    .cbs-hero__bg img {
      width: 100%; height: 110%;
      object-fit: cover; object-position: center;
      transform: translate3d(0, var(--parallax-y, 0px), 0) scale(1.04);
      transition: transform 80ms linear;
      filter: saturate(0.95);
    }
    .cbs-hero__overlay {
      position: absolute; inset: 0; z-index: -2;
      background:
        linear-gradient(110deg,
          rgba(8, 18, 28, 0.92) 0%,
          rgba(8, 18, 28, 0.72) 42%,
          rgba(8, 18, 28, 0.32) 100%),
        radial-gradient(120% 80% at 0% 100%,
          rgba(38, 154, 218, 0.28) 0%,
          rgba(38, 154, 218, 0) 60%);
    }
    .cbs-hero__grain {
      position: absolute; inset: 0; z-index: -1;
      background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
      background-size: 3px 3px;
      mix-blend-mode: overlay; opacity: 0.45;
      pointer-events: none;
    }
    .cbs-hero__inner { max-width: 980px; position: relative; }
    .cbs-hero__crumbs {
      margin-bottom: var(--space-4);
      font-size: var(--fs-small);
      display: flex; gap: 0.5rem; align-items: center;
      color: rgba(255, 255, 255, 0.7);
    }
    .cbs-hero__crumbs a { color: rgba(255, 255, 255, 0.85); font-weight: 500; }
    .cbs-hero__crumbs a:hover { color: var(--bbg-white); }
    .cbs-hero__inner .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-3);
      color: #9DDBF5;
    }
    .cbs-hero__title {
      font-size: clamp(2rem, 3.4vw + 1rem, 3.75rem);
      line-height: 1.06;
      letter-spacing: -0.025em;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      max-width: 22ch;
      font-weight: 700;
      display: flex; flex-direction: column;
      gap: 0.05em;
    }
    .cbs-hero__title-row { display: block; }
    .cbs-hero__title-row--accent {
      color: #9DDBF5; font-weight: 500;
      font-style: italic; letter-spacing: -0.018em;
    }
    .cbs-hero__title-row--highlight {
      position: relative; display: inline-block;
      align-self: flex-start; padding: 0 0.15em;
    }
    .cbs-hero__title-row--highlight::before {
      content: ""; position: absolute;
      left: 0; right: 0; bottom: 0.04em;
      height: 0.18em;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      border-radius: 2px;
      transform-origin: left center;
      animation: cbs-underline 900ms cubic-bezier(0.16, 1, 0.3, 1) 600ms both;
      z-index: -1;
    }
    @keyframes cbs-underline { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    .cbs-hero__lead {
      font-size: clamp(1rem, 0.5vw + 1rem, 1.1875rem);
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.86);
      max-width: 58ch;
      margin: 0 0 var(--space-5);
    }
    .cbs-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-6); }
    .cbs-magnetic:hover { transform: translateY(-2px); }

    .cbs-hero__meta {
      display: flex; flex-wrap: nowrap;
      gap: clamp(var(--space-3), 3vw, var(--space-6));
      padding-top: var(--space-5);
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      max-width: none;
    }
    .cbs-hero__meta-item {
      display: flex; flex-direction: column;
      gap: 0.2rem;
      min-width: 0;
      flex: 1 1 0;
    }
    @media (max-width: 720px) {
      .cbs-hero__meta { flex-wrap: wrap; }
      .cbs-hero__meta-item { flex: 1 1 auto; }
    }
    .cbs-hero__meta-num {
      font-size: clamp(1.625rem, 1.2vw + 1rem, 2.125rem);
      font-weight: 700; letter-spacing: -0.02em;
      line-height: 1; color: var(--bbg-white);
      font-feature-settings: "tnum";
    }
    .cbs-hero__meta-label {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.66);
      letter-spacing: 0.02em;
    }

    .cbs-hero__scroll {
      position: absolute;
      bottom: var(--space-5);
      right: clamp(var(--space-5), 4vw, var(--space-7));
      display: flex; flex-direction: column;
      align-items: center; gap: 0.5rem;
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.7rem; letter-spacing: 0.18em;
      text-transform: uppercase; font-weight: 600;
      transition: color 200ms ease;
    }
    .cbs-hero__scroll:hover { color: var(--bbg-white); }
    .cbs-hero__scroll-line {
      width: 1px; height: 40px;
      background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.6) 100%);
      position: relative; overflow: hidden;
    }
    .cbs-hero__scroll-line::after {
      content: ""; position: absolute;
      top: -100%; left: 0; right: 0;
      height: 50%;
      background: linear-gradient(180deg, transparent 0%, var(--bbg-white) 100%);
      animation: cbs-scroll-tick 1.8s ease-in-out infinite;
    }
    @keyframes cbs-scroll-tick { 0% { top: -50%; } 100% { top: 100%; } }
    @media (max-width: 720px) {
      .cbs-hero__scroll { display: none; }
      .cbs-hero__meta { gap: var(--space-4); }
    }

    /* ---------- TEXT CARDS GRID ---------- */
    .cbs-cards {
      display: grid;
      gap: var(--space-5);
      margin-top: var(--space-6);
    }
    .cbs-cards--3 { grid-template-columns: repeat(3, 1fr); }
    .cbs-cards--4 { grid-template-columns: repeat(4, 1fr); }
    .cbs-card {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      display: flex; flex-direction: column;
      gap: var(--space-3);
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 260ms ease,
        box-shadow 260ms ease;
      overflow: hidden;
    }
    .cbs-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-card:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: 0 16px 32px -20px rgba(38, 154, 218, 0.4);
    }
    .cbs-card:hover::before { transform: scaleX(1); }
    .cbs-card--accent::before { transform: scaleX(1); opacity: 0.4; }
    .cbs-card--accent:hover::before { opacity: 1; }
    .cbs-card__title {
      font-size: 1.125rem;
      line-height: 1.3;
      margin: 0;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-card__body {
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-card__link {
      margin-top: auto;
      align-self: flex-start;
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding-top: var(--space-3);
      font-size: 0.85rem; font-weight: 600;
      color: var(--bbg-blue);
    }
    .cbs-card__link span { transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1); }
    .cbs-card__link:hover span { transform: translateX(3px); }
    .cbs-cards__note {
      margin-top: var(--space-5);
      text-align: center;
      color: var(--bbg-text);
      font-size: 1rem;
      line-height: 1.6;
    }
    @media (max-width: 1024px) {
      .cbs-cards--3,
      .cbs-cards--4 { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .cbs-cards--3,
      .cbs-cards--4 { grid-template-columns: 1fr; }
    }

    /* ---------- SUBHEADING ROW ---------- */
    .cbs-sub {
      margin-top: var(--space-7);
      margin-bottom: var(--space-4);
      display: flex; flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-sub__lead {
      max-width: 70ch;
      color: var(--bbg-text);
      font-size: 1.0625rem;
      line-height: 1.6;
      margin: 0;
    }

    /* ---------- SERVICES (six- / four-card grid) ---------- */
    .cbs-services {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
    .cbs-services--two { grid-template-columns: repeat(2, 1fr); }
    .cbs-service {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      display: flex; flex-direction: column;
      gap: var(--space-3);
      text-decoration: none;
      color: inherit;
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 260ms ease,
        box-shadow 260ms ease;
      overflow: hidden;
    }
    .cbs-service::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-service:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: 0 16px 32px -20px rgba(38, 154, 218, 0.4);
    }
    .cbs-service:hover::before { transform: scaleX(1); }
    .cbs-service__icon {
      display: inline-flex;
      width: 44px; height: 44px;
      align-items: center; justify-content: center;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(38, 154, 218, 0.18) 100%);
      color: var(--bbg-blue);
      margin-bottom: var(--space-2);
    }
    .cbs-service__icon svg { width: 22px; height: 22px; }
    .cbs-service__title {
      font-size: 1.125rem;
      line-height: 1.25;
      margin: 0;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-service__body {
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .cbs-services,
      .cbs-services--two { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .cbs-services,
      .cbs-services--two { grid-template-columns: 1fr; }
    }

    /* ---------- BAND IMAGE ---------- */
    .cbs-band {
      margin: var(--space-7) 0 var(--space-5);
      border-radius: var(--radius-lg);
      overflow: hidden;
      aspect-ratio: 21 / 8;
      background: var(--bbg-border);
    }
    .cbs-band--narrow { aspect-ratio: 21 / 6; margin: var(--space-5) 0 var(--space-6); }
    .cbs-band img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
    @media (max-width: 720px) {
      .cbs-band { aspect-ratio: 4 / 3; }
      .cbs-band--narrow { aspect-ratio: 16 / 9; }
    }

    /* ---------- TABS ---------- */
    .cbs-tabs {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 16px 48px -28px rgba(8, 18, 28, 0.18);
    }
    .cbs-tabs__nav {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      background: linear-gradient(180deg, var(--bbg-surface) 0%, var(--bbg-white) 100%);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-tabs__tab {
      position: relative; background: transparent; border: none;
      padding: var(--space-5) var(--space-4);
      text-align: left; cursor: pointer;
      display: flex; flex-direction: column;
      gap: 0.35rem;
      color: var(--bbg-text-muted);
      transition: color 240ms ease, background 240ms ease;
      border-right: 1px solid var(--bbg-border);
      font-family: inherit;
    }
    .cbs-tabs__tab:last-child { border-right: none; }
    .cbs-tabs__tab:hover { color: var(--bbg-ink); background: rgba(38, 154, 218, 0.04); }
    .cbs-tabs__tab.is-active { color: var(--bbg-ink); background: var(--bbg-white); }
    .cbs-tabs__tab-label {
      font-size: 1.0625rem; font-weight: 700;
      letter-spacing: -0.005em; line-height: 1.2;
    }
    .cbs-tabs__tab-tag {
      font-size: 0.78rem; color: var(--bbg-text-muted);
      line-height: 1.35;
    }
    .cbs-tabs__tab.is-active .cbs-tabs__tab-tag { color: var(--bbg-blue); }
    .cbs-tabs__indicator {
      position: absolute;
      bottom: -1px; left: 0;
      width: 25%; height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      border-radius: 2px 2px 0 0;
      transform: translateX(0);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }
    .cbs-tabs__panels { background: var(--bbg-white); }
    .cbs-tabs__panel {
      padding: clamp(var(--space-5), 4vw + 1rem, var(--space-7));
      animation: cbs-tab-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-tab-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .cbs-tabs__panel[hidden] { display: none; }
    .cbs-tabs__panel-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .cbs-tabs__lead { display: flex; flex-direction: column; gap: var(--space-4); }
    .cbs-tabs__pillset { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .cbs-tabs__pill {
      font-size: 0.78rem; font-weight: 600;
      padding: 0.35em 0.85em;
      border-radius: 999px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      letter-spacing: 0.01em;
    }
    .cbs-tabs__title {
      font-size: clamp(1.625rem, 1.8vw + 1rem, 2.25rem);
      line-height: 1.1; margin: 0;
      letter-spacing: -0.015em;
    }
    .cbs-tabs__desc {
      font-size: 1rem; line-height: 1.6;
      color: var(--bbg-text); margin: 0;
    }
    .cbs-tabs__when {
      padding: var(--space-4);
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--bbg-blue);
    }
    .cbs-tabs__when-label {
      display: block;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.35rem;
    }
    .cbs-tabs__when p { margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--bbg-text); }
    .cbs-tabs__body { display: flex; flex-direction: column; gap: var(--space-4); }
    .cbs-tabs__image {
      margin: 0;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: var(--radius-md);
      background: var(--bbg-border);
    }
    .cbs-tabs__image img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
    }
    .cbs-tabs__list-wrap {
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .cbs-tabs__list-wrap--alt { background: var(--bbg-blue-light); }
    .cbs-tabs__list-label {
      display: block;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .cbs-tabs__list-wrap--alt .cbs-tabs__list-label { color: var(--bbg-blue-dark); }
    .cbs-tabs__list {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-tabs__list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 0.95rem; line-height: 1.5;
      color: var(--bbg-text);
    }
    .cbs-tabs__check {
      width: 22px; height: 22px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0; margin-top: 1px;
    }
    .cbs-tabs__check--alt {
      background: var(--bbg-white);
      color: var(--bbg-blue);
      box-shadow: inset 0 0 0 1.5px var(--bbg-blue);
    }
    .cbs-tabs__check svg { width: 12px; height: 12px; }
    .cbs-tabs__note {
      margin: var(--space-5) auto 0;
      max-width: 60ch;
      text-align: center;
      color: var(--bbg-text);
      font-size: 1rem;
      line-height: 1.6;
    }
    @media (max-width: 1024px) {
      .cbs-tabs__nav { grid-template-columns: 1fr; }
      .cbs-tabs__tab { border-right: none; border-bottom: 1px solid var(--bbg-border); }
      .cbs-tabs__indicator { display: none; }
      .cbs-tabs__panel-grid { grid-template-columns: 1fr; }
    }

    /* ---------- QUOTE ---------- */
    .cbs-quote {
      margin: var(--space-7) auto 0;
      max-width: 760px;
      padding: var(--space-5) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(38, 154, 218, 0.10) 100%);
      border-left: 4px solid var(--bbg-blue);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
    }
    .cbs-quote p {
      margin: 0;
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--bbg-ink);
      font-weight: 500;
      font-style: italic;
    }

    /* ---------- FAQ ---------- */
    .cbs-faq {
      display: flex; flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-faq__item {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition: border-color 240ms ease, box-shadow 240ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-faq__item:hover {
      transform: translateX(2px);
      border-color: rgba(38, 154, 218, 0.4);
    }
    .cbs-faq__item[open] {
      border-color: var(--bbg-blue);
      box-shadow: 0 8px 22px -14px rgba(38, 154, 218, 0.4);
    }
    .cbs-faq__q {
      cursor: pointer;
      padding: var(--space-5);
      display: flex; align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      font-weight: 600;
      font-size: 1.0625rem; line-height: 1.3;
      color: var(--bbg-ink);
      list-style: none;
      transition: color var(--dur) var(--ease);
    }
    .cbs-faq__q::-webkit-details-marker { display: none; }
    .cbs-faq__q::marker { display: none; }
    .cbs-faq__item:hover .cbs-faq__q { color: var(--bbg-blue); }
    .cbs-faq__icon {
      flex-shrink: 0;
      width: 28px; height: 28px;
      display: inline-flex;
      align-items: center; justify-content: center;
      border-radius: 50%;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
                  color var(--dur) var(--ease),
                  background var(--dur) var(--ease);
    }
    .cbs-faq__item[open] .cbs-faq__icon {
      transform: rotate(180deg);
      color: var(--bbg-white);
      background: var(--bbg-blue);
    }
    .cbs-faq__a {
      padding: 0 var(--space-5) var(--space-5);
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
      animation: cbs-faq-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-faq-in {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .cbs-faq__a p { margin: 0; }

    /* ---------- FAQ FILTER ---------- */
    .cbs-faq-filter {
      display: flex; flex-wrap: wrap;
      gap: 0.5rem; justify-content: center;
      margin-bottom: var(--space-6);
      overflow-x: auto;
    }
    .cbs-faq-chip {
      display: inline-flex; align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.95rem;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 999px;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--bbg-text);
      transition: all 220ms ease;
      font-family: inherit;
      white-space: nowrap;
    }
    .cbs-faq-chip:hover { border-color: var(--bbg-blue); color: var(--bbg-blue); }
    .cbs-faq-chip.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }
    .cbs-faq-chip__count {
      font-size: 0.72rem; font-weight: 700;
      padding: 0.15em 0.5em;
      border-radius: 999px;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition: all 220ms ease;
    }
    .cbs-faq-chip:hover .cbs-faq-chip__count { background: var(--bbg-blue-light); color: var(--bbg-blue); }
    .cbs-faq-chip.is-active .cbs-faq-chip__count {
      background: rgba(255, 255, 255, 0.2);
      color: var(--bbg-white);
    }
    .cbs-faq__cat-tag {
      display: inline-block;
      font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 0.25em 0.6em;
      border-radius: 4px;
      margin-right: var(--space-3);
      flex-shrink: 0;
    }
    .cbs-faq__q-text { flex-grow: 1; }
    .cbs-faq__item.is-hidden { display: none; }

    /* ---------- FINAL CTA ---------- */
    .cbs-cta {
      padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8)) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
      color: var(--bbg-white);
      border-radius: var(--radius-lg);
      text-align: center;
      position: relative; overflow: hidden;
    }
    .cbs-cta::before {
      content: ""; position: absolute;
      top: -40%; right: -10%;
      width: 420px; height: 420px;
      background: radial-gradient(circle at center, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 65%);
      pointer-events: none;
    }
    .cbs-cta .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-4);
      color: rgba(255, 255, 255, 0.9);
    }
    .cbs-cta__title {
      font-size: clamp(1.75rem, 1.5vw + 1rem, 2.5rem);
      line-height: 1.15;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      letter-spacing: -0.015em;
    }
    .cbs-cta__lead {
      color: rgba(255, 255, 255, 0.92);
      font-size: 1.0625rem;
      max-width: 60ch;
      margin: 0 auto var(--space-5);
      line-height: 1.55;
    }
    .cbs-cta__actions {
      display: flex; flex-wrap: wrap;
      gap: var(--space-3);
      justify-content: center;
      position: relative;
    }
    .cbs-cta__btn-primary {
      background: var(--bbg-white);
      color: var(--bbg-blue-dark);
      border: 1px solid var(--bbg-white);
    }
    .cbs-cta__btn-primary:hover {
      background: rgba(255, 255, 255, 0.92);
      color: var(--bbg-blue-dark);
    }
    .cbs-cta__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: var(--bbg-white);
    }
    .cbs-cta__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }
  </style>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Reveal-on-scroll
      const revealEls = document.querySelectorAll('.cbs-reveal');
      if (revealEls.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          revealEls.forEach((el) => io.observe(el));
        }
      }

      // 2. Animated counters
      const counters = document.querySelectorAll('[data-counter]');
      if (counters.length && !reduced && 'IntersectionObserver' in window) {
        const animate = (el) => {
          const target = parseFloat(el.dataset.counter || '0');
          const suffix = el.dataset.suffix || '';
          const duration = 1400;
          const start = performance.now();
          const tick = (now) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = Math.round(target * eased);
            el.textContent = value + suffix;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const counterIo = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animate(entry.target);
              counterIo.unobserve(entry.target);
            }
          });
        }, { threshold: 0.5 });
        counters.forEach((el) => counterIo.observe(el));
      } else {
        counters.forEach((el) => {
          el.textContent = (el.dataset.counter || '0') + (el.dataset.suffix || '');
        });
      }

      // 3. Hero parallax + scroll progress bar
      const parallaxEl = document.querySelector('[data-parallax]');
      const progressEl = document.querySelector('.cbs-progress__bar');
      const heroEl = document.querySelector('[data-hero]');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;
          if (parallaxEl && heroEl && !reduced) {
            const heroH = heroEl.offsetHeight;
            if (scrollY < heroH) {
              parallaxEl.style.setProperty('--parallax-y', (scrollY * 0.18) + 'px');
            }
          }
          if (progressEl) {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
            progressEl.style.setProperty('--progress', pct + '%');
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // 4. Tabs
      const openTabByHash = () => {
        const hash = window.location.hash.slice(1);
        if (!hash) return;
        document.querySelectorAll('[data-tabs]').forEach((root) => {
          const matchingTab = root.querySelector(`[data-tab-id="${hash}"]`);
          if (matchingTab) matchingTab.click();
        });
      };

      document.querySelectorAll('[data-tabs]').forEach((tabsRoot) => {
        const tabs = Array.from(tabsRoot.querySelectorAll('.cbs-tabs__tab'));
        const panels = Array.from(tabsRoot.querySelectorAll('.cbs-tabs__panel'));
        const indicator = tabsRoot.querySelector('.cbs-tabs__indicator');

        const setActive = (tab) => {
          tabs.forEach((t) => {
            const active = t === tab;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          const targetId = tab.getAttribute('data-tab-target');
          panels.forEach((p) => {
            const active = p.id === targetId;
            p.classList.toggle('is-active', active);
            if (active) p.removeAttribute('hidden');
            else p.setAttribute('hidden', '');
          });
          if (indicator) {
            const idx = tabs.indexOf(tab);
            const w = 100 / tabs.length;
            indicator.style.width = w + '%';
            indicator.style.transform = `translateX(${idx * 100}%)`;
          }
        };

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => setActive(tab));
          tab.addEventListener('keydown', (e) => {
            const idx = tabs.indexOf(tab);
            if (e.key === 'ArrowRight') {
              e.preventDefault();
              const next = tabs[(idx + 1) % tabs.length];
              next.focus(); setActive(next);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
              prev.focus(); setActive(prev);
            }
          });
        });

        const initialActive = tabs.find((t) => t.classList.contains('is-active')) || tabs[0];
        if (initialActive) setActive(initialActive);
      });

      openTabByHash();
      window.addEventListener('hashchange', openTabByHash);

      // 5. Smooth scroll for anchors
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = link.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
          const tabId = id.slice(1);
          document.querySelectorAll('[data-tabs]').forEach((root) => {
            const matchingTab = root.querySelector(`[data-tab-id="${tabId}"]`);
            if (matchingTab) matchingTab.click();
          });
          history.replaceState(null, '', id);
        });
      });

      // 6. FAQ accordion - close others on open
      const faqItems = document.querySelectorAll('.cbs-faq__item');
      faqItems.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (item.open) {
            faqItems.forEach((other) => {
              if (other !== item && other.open) other.open = false;
            });
          }
        });
      });

      // 7. FAQ category filter
      const faqFilter = document.querySelector('[data-faq-filter]');
      const faqList = document.querySelector('[data-faq-list]');
      if (faqFilter && faqList) {
        const chips = Array.from(faqFilter.querySelectorAll('.cbs-faq-chip'));
        const items = Array.from(faqList.querySelectorAll('.cbs-faq__item'));
        chips.forEach((chip) => {
          chip.addEventListener('click', () => {
            const cat = chip.dataset.faqCat;
            chips.forEach((c) => {
              const on = c === chip;
              c.classList.toggle('is-active', on);
              c.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            items.forEach((item) => {
              const matches = cat === 'All' || item.dataset.faqCat === cat;
              item.classList.toggle('is-hidden', !matches);
            });
          });
        });
      }

      // Truth cards: cursor tilt + scroll-driven image parallax
      const truths = document.querySelectorAll('[data-truth-tilt]');
      if (truths.length && !reduced) {
        truths.forEach((card) => {
          const onMove = (e) => {
            const rect = card.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width;
            const y = (e.clientY - rect.top) / rect.height;
            const ry = (x - 0.5) * 5;
            const rx = (0.5 - y) * 4;
            card.style.setProperty('--ry', ry.toFixed(2) + 'deg');
            card.style.setProperty('--rx', rx.toFixed(2) + 'deg');
            card.setAttribute('data-tilt-active', '');
          };
          const onLeave = () => {
            card.style.setProperty('--ry', '0deg');
            card.style.setProperty('--rx', '0deg');
            card.removeAttribute('data-tilt-active');
          };
          card.addEventListener('mousemove', onMove);
          card.addEventListener('mouseleave', onLeave);
        });

        const parallaxImgs = document.querySelectorAll('[data-truth-parallax]');
        let truthsTicking = false;
        const updateTruthParallax = () => {
          parallaxImgs.forEach((img) => {
            const frame = img.parentElement;
            if (!frame) return;
            const rect = frame.getBoundingClientRect();
            const vh = window.innerHeight;
            if (rect.bottom < 0 || rect.top > vh) return;
            const center = rect.top + rect.height / 2;
            const offset = (center - vh / 2) / vh;
            const shift = Math.max(-16, Math.min(16, -offset * 22));
            img.style.setProperty('--img-y', shift.toFixed(1) + 'px');
          });
        };
        const onTruthsScroll = () => {
          if (truthsTicking) return;
          truthsTicking = true;
          requestAnimationFrame(() => {
            updateTruthParallax();
            truthsTicking = false;
          });
        };
        window.addEventListener('scroll', onTruthsScroll, { passive: true });
        window.addEventListener('resize', onTruthsScroll, { passive: true });
        updateTruthParallax();
      }
    })();
  </script>
</Layout>
