      overflow: hidden;
    }
    .cbs-hero__scroll-line::after {
      content: '';
      position: absolute;
      top: -100%;
      left: 0;
      right: 0;
      height: 50%;
      background: linear-gradient(180deg, transparent 0%, var(--bbg-white) 100%);
      animation: cbs-scroll-tick 1.8s ease-in-out infinite;
    }
    @keyframes cbs-scroll-tick {
      0% {
        top: -50%;
      }
      100% {
        top: 100%;
      }
    }
    @media (max-width: 720px) {
      .cbs-hero__scroll {
        display: none;
      }
      .cbs-hero__meta {
        gap: var(--space-4);
      }
    }

    /* ---------- VALUE + PROMISES ---------- */
    .cbs-value {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
    .cbs-value__copy h2 {
      font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
      line-height: 1.15;
      letter-spacing: -0.015em;
      margin: var(--space-3) 0 var(--space-4);
    }
    .cbs-value__copy p {
      color: var(--bbg-text);
      line-height: 1.7;
      font-size: 1.0625rem;
      margin: 0 0 var(--space-4);
    }
    .cbs-value__copy .btn {
      margin-top: var(--space-4);
    }
    .cbs-promise {
      list-style: none;
      padding: var(--space-6);
      margin: 0;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }
    .cbs-promise > li:first-child .eyebrow {
      margin-bottom: 0;
    }
    .cbs-promise__item {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: var(--space-4);
      align-items: start;
    }
    .cbs-promise__check {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .cbs-promise__check svg {
      width: 16px;
      height: 16px;
    }
    .cbs-promise__item h4 {
      font-size: 1.125rem;
      margin: 0 0 var(--space-2);
      letter-spacing: -0.005em;
      color: var(--bbg-ink);
    }
    .cbs-promise__item p {
      font-size: 0.975rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }

    @media (max-width: 1024px) {
      .cbs-value {
        grid-template-columns: 1fr;
        gap: var(--space-6);
      }
    }

    /* ---------- SERVICES (six-card grid) ---------- */
    .cbs-services {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
    .cbs-service {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      text-decoration: none;
      color: inherit;
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 260ms ease,
        box-shadow 260ms ease;
      overflow: hidden;
    }
    .cbs-service::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 100%);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-service:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: 0 16px 32px -20px rgba(200, 16, 46, 0.4);
    }
    .cbs-service:hover::before {
      transform: scaleX(1);
    }
    .cbs-service__icon {
      display: inline-flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.18) 100%);
      color: var(--bbg-blue);
      margin-bottom: var(--space-2);
    }
    .cbs-service__icon svg {
      width: 22px;
      height: 22px;
    }
    .cbs-service__title {
      font-size: 1.125rem;
      line-height: 1.25;
      margin: 0;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-service__body {
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-service__arrow {
      margin-top: auto;
      align-self: flex-start;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--bbg-blue);
      letter-spacing: 0.01em;
      padding-top: var(--space-2);
    }
    .cbs-service__arrow-icon {
      display: inline-block;
      transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .cbs-service:hover .cbs-service__arrow-icon {
      transform: translateX(3px);
    }
    @media (max-width: 1024px) {
      .cbs-services {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 640px) {
      .cbs-services {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- MODELS / TABS BG ---------- */
    .cbs-models-section {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }

    /* ---------- TABS ---------- */
    .cbs-tabs {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 16px 48px -28px rgba(8, 18, 28, 0.18);
    }
    .cbs-tabs__nav {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      background: linear-gradient(180deg, var(--bbg-surface) 0%, var(--bbg-white) 100%);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-tabs--two .cbs-tabs__nav {
      grid-template-columns: repeat(2, 1fr);
    }
    .cbs-tabs__tab {
      position: relative;
      background: transparent;
      border: none;
      padding: var(--space-5) var(--space-4);
      text-align: left;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      color: var(--bbg-text-muted);
      transition:
        color 240ms ease,
        background 240ms ease;
      border-right: 1px solid var(--bbg-border);
      font-family: inherit;
    }
    .cbs-tabs__tab:last-child {
      border-right: none;
    }
    .cbs-tabs__tab:hover {
      color: var(--bbg-ink);
      background: rgba(200, 16, 46, 0.04);
    }
    .cbs-tabs__tab.is-active {
      color: var(--bbg-ink);
      background: var(--bbg-white);
    }
    .cbs-tabs__tab-label {
      font-size: 1.0625rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      line-height: 1.2;
    }
    .cbs-tabs__tab-tag {
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      line-height: 1.35;
    }
    .cbs-tabs__tab.is-active .cbs-tabs__tab-tag {
      color: var(--bbg-blue);
    }
    .cbs-tabs__tab-pop {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .cbs-tabs__indicator {
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 25%;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 100%);
      border-radius: 2px 2px 0 0;
      transform: translateX(0);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }
    .cbs-tabs--two .cbs-tabs__indicator {
      width: 50%;
    }
    .cbs-tabs__panels {
      background: var(--bbg-white);
    }
    .cbs-tabs__panel {
      padding: clamp(var(--space-5), 4vw + 1rem, var(--space-7));
      animation: cbs-tab-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-tab-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .cbs-tabs__panel[hidden] {
      display: none;
    }
    .cbs-tabs__panel-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .cbs-tabs__lead {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .cbs-tabs__pillset {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .cbs-tabs__pill {
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.35em 0.85em;
      border-radius: 999px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      letter-spacing: 0.01em;
    }
    .cbs-tabs__title {
      font-size: clamp(1.625rem, 1.8vw + 1rem, 2.25rem);
      line-height: 1.1;
      margin: 0;
      letter-spacing: -0.015em;
    }
    .cbs-tabs__desc {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-tabs__when {
      padding: var(--space-4);
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--bbg-blue);
    }
    .cbs-tabs__when-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.35rem;
    }
    .cbs-tabs__when p {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--bbg-text);
    }
    .cbs-tabs__body {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .cbs-tabs__image {
      margin: 0;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border-radius: var(--radius-md);
      background: var(--bbg-border);
    }
    .cbs-tabs__image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .cbs-tabs__list-wrap {
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .cbs-tabs__list-wrap--alt {
      background: var(--bbg-blue-light);
    }
    .cbs-tabs__list-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .cbs-tabs__list-wrap--alt .cbs-tabs__list-label {
      color: var(--bbg-blue-dark);
    }
    .cbs-tabs__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-tabs__list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--bbg-text);
    }
    .cbs-tabs__check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .cbs-tabs__check--alt {
      background: var(--bbg-white);
      color: var(--bbg-blue);
      box-shadow: inset 0 0 0 1.5px var(--bbg-blue);
    }
    .cbs-tabs__check svg {
      width: 12px;
      height: 12px;
    }

    .cbs-owns {
      padding: var(--space-4);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      background: var(--bbg-white);
    }
    .cbs-owns__label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .cbs-owns__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .cbs-owns__list li {
      display: grid;
      grid-template-columns: minmax(150px, auto) 1fr;
      gap: var(--space-4);
      align-items: baseline;
      padding-bottom: 0.6rem;
      border-bottom: 1px dashed var(--bbg-border);
      font-size: 0.9rem;
      line-height: 1.45;
    }
    .cbs-owns__list li:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
    .cbs-owns__key {
      color: var(--bbg-text-muted);
      font-weight: 600;
    }
    .cbs-owns__val {
      color: var(--bbg-ink);
    }

    @media (max-width: 1024px) {
      .cbs-tabs__nav {
        grid-template-columns: 1fr;
      }
      .cbs-tabs__tab {
        border-right: none;
        border-bottom: 1px solid var(--bbg-border);
      }
      .cbs-tabs__indicator {
        display: none;
      }
      .cbs-tabs__panel-grid {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- COMPARISON TABLE ---------- */
    .cbs-compare {
      margin-top: var(--space-8);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: clamp(var(--space-5), 3vw + 1rem, var(--space-7));
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    }
    .cbs-compare__intro {
      text-align: center;
      margin-bottom: var(--space-6);
    }
    .cbs-compare__intro h3 {
      font-size: clamp(1.375rem, 1.2vw + 1rem, 1.75rem);
      margin: var(--space-2) 0 var(--space-3);
      letter-spacing: -0.01em;
    }
    .cbs-compare__intro p {
      color: var(--bbg-text);
      max-width: 60ch;
      margin: 0 auto;
      line-height: 1.6;
      font-size: 1rem;
    }
    .cbs-compare__table-wrap {
      overflow-x: auto;
    }
    .cbs-compare__table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      min-width: 640px;
    }
    .cbs-compare__head {
      background: var(--bbg-surface);
      padding: var(--space-4);
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-compare__head--tp {
      border-bottom-color: var(--bbg-blue);
    }
    .cbs-compare__head--dist {
      border-bottom-color: var(--bbg-blue-dark);
    }
    .cbs-compare__head-label {
      display: block;
      font-size: 1rem;
      font-weight: 700;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-compare__head-sub {
      display: block;
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      margin-top: 0.25rem;
    }
    .cbs-compare__row-head-col {
      width: 38%;
      background: var(--bbg-surface);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-compare__row-label {
      text-align: left;
      padding: var(--space-4);
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--bbg-text-muted);
      letter-spacing: 0.01em;
      border-bottom: 1px solid var(--bbg-border);
      background: var(--bbg-white);
    }
    .cbs-compare__cell {
      padding: var(--space-4);
      font-size: 0.95rem;
      color: var(--bbg-ink);
      border-bottom: 1px solid var(--bbg-border);
      vertical-align: top;
    }
    .cbs-compare__cell--tp {
      background: rgba(200, 16, 46, 0.04);
    }
    .cbs-compare__cell--dist {
      background: var(--bbg-white);
    }
    .cbs-compare__table tbody tr:last-child .cbs-compare__row-label,
    .cbs-compare__table tbody tr:last-child .cbs-compare__cell {
      border-bottom: none;
    }
    .cbs-compare__note {
      margin: var(--space-5) auto 0;
      max-width: 70ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 0.975rem;
    }

    /* ---------- QUOTE ---------- */
    .cbs-quote {
      margin: var(--space-6) auto 0;
      max-width: 760px;
      padding: var(--space-5) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.1) 100%);
      border-left: 4px solid var(--bbg-blue);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
    }
    .cbs-quote p {
      margin: 0;
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--bbg-ink);
      font-weight: 500;
      font-style: italic;
    }
    .cbs-quote--inline {
      margin: var(--space-2) 0;
      max-width: none;
      padding: var(--space-4) var(--space-5);
    }

    /* ---------- SISTER PRODUCT (TheRedScroll) ---------- */
    .cbs-sister {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-6);
      align-items: stretch;
    }
    .cbs-sister__hero {
      position: relative;
      padding: clamp(var(--space-6), 4vw, var(--space-8));
      background: linear-gradient(160deg, #1a0f1f 0%, #2a1530 60%, #401a45 100%);
      color: var(--bbg-white);
      border-radius: 24px;
      overflow: hidden;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .cbs-sister__hero::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(60% 80% at 100% 0%, rgba(255, 90, 130, 0.25) 0%, transparent 60%),
        radial-gradient(40% 60% at 0% 100%, rgba(255, 60, 100, 0.18) 0%, transparent 60%);
    }
    .cbs-sister__logo {
      align-self: flex-start;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 10px;
      padding: 0.55rem 0.9rem;
      max-width: 180px;
    }
    .cbs-sister__logo img {
      display: block;
      width: 100%;
      height: auto;
    }
    .cbs-sister__chip {
      display: inline-block;
      align-self: flex-start;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #ffc2d1;
      background: rgba(255, 90, 130, 0.18);
      padding: 0.4em 0.85em;
      border-radius: 999px;
      border: 1px solid rgba(255, 194, 209, 0.3);
    }
    .cbs-sister__title {
      font-size: clamp(1.5rem, 1.6vw + 1rem, 2.125rem);
      line-height: 1.15;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-white);
    }
    .cbs-sister__desc {
      font-size: 1rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.82);
      margin: 0;
    }
    .cbs-sister__stats {
      list-style: none;
      padding: var(--space-4) 0 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }
    .cbs-sister__stats li {
      display: grid;
      grid-template-columns: minmax(96px, auto) 1fr;
      gap: var(--space-4);
      align-items: baseline;
    }
    .cbs-sister__stat-num {
      font-size: 1.25rem;
      font-weight: 700;
      color: #ffc2d1;
      letter-spacing: -0.01em;
      font-feature-settings: 'tnum';
    }
    .cbs-sister__stat-label {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.5;
    }
    .cbs-sister__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-top: var(--space-3);
    }
    .cbs-sister__btn-primary {
      background: var(--bbg-white);
      color: #2a1530;
      border: 1px solid var(--bbg-white);
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .cbs-sister__btn-primary:hover {
      background: #ffc2d1;
      color: #2a1530;
    }
    .cbs-sister__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: var(--bbg-white);
    }
    .cbs-sister__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }
    .cbs-sister__packs {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .cbs-sister__pack {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      transition:
        border-color 280ms ease,
        box-shadow 280ms ease,
        transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-sister__pack:hover {
      transform: translateY(-3px);
      border-color: var(--bbg-blue);
      box-shadow: 0 14px 28px -18px rgba(200, 16, 46, 0.35);
    }
    .cbs-sister__pack-icon {
      display: inline-flex;
      width: 36px;
      height: 36px;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      margin-bottom: 0.4rem;
    }
    .cbs-sister__pack-icon svg {
      width: 18px;
      height: 18px;
    }
    .cbs-sister__pack h4 {
      font-size: 1.0625rem;
      margin: 0;
      letter-spacing: -0.005em;
      color: var(--bbg-ink);
    }
    .cbs-sister__pack p {
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .cbs-sister {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- FAQ ---------- */
    .cbs-faq {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-faq__item {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition:
        border-color 240ms ease,
        box-shadow 240ms ease,
        transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-faq__item:hover {
      transform: translateX(2px);
      border-color: rgba(200, 16, 46, 0.4);
    }
    .cbs-faq__item[open] {
      border-color: var(--bbg-blue);
      box-shadow: 0 8px 22px -14px rgba(200, 16, 46, 0.4);
    }
    .cbs-faq__q {
      cursor: pointer;
      padding: var(--space-5);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      font-weight: 600;
      font-size: 1.0625rem;
      line-height: 1.3;
      color: var(--bbg-ink);
      list-style: none;
      transition: color var(--dur) var(--ease);
    }
    .cbs-faq__q::-webkit-details-marker {
      display: none;
    }
    .cbs-faq__q::marker {
      display: none;
    }
    .cbs-faq__item:hover .cbs-faq__q {
      color: var(--bbg-blue);
    }
    .cbs-faq__icon {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        color var(--dur) var(--ease),
        background var(--dur) var(--ease);
    }
    .cbs-faq__item[open] .cbs-faq__icon {
      transform: rotate(180deg);
      color: var(--bbg-white);
      background: var(--bbg-blue);
    }
    .cbs-faq__a {
      padding: 0 var(--space-5) var(--space-5);
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
      animation: cbs-faq-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-faq-in {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .cbs-faq__a p {
      margin: 0;
    }

    /* ---------- FAQ FILTER ---------- */
    .cbs-faq-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-bottom: var(--space-6);
      overflow-x: auto;
    }
    .cbs-faq-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.95rem;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 999px;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--bbg-text);
      transition: all 220ms ease;
      font-family: inherit;
      white-space: nowrap;
    }
    .cbs-faq-chip:hover {
      border-color: var(--bbg-blue);
      color: var(--bbg-blue);
    }
    .cbs-faq-chip.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }
    .cbs-faq-chip__count {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.15em 0.5em;
      border-radius: 999px;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition: all 220ms ease;
    }
    .cbs-faq-chip:hover .cbs-faq-chip__count {
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
    }
    .cbs-faq-chip.is-active .cbs-faq-chip__count {
      background: rgba(255, 255, 255, 0.2);
      color: var(--bbg-white);
    }
    .cbs-faq__cat-tag {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 0.25em 0.6em;
      border-radius: 4px;
      margin-right: var(--space-3);
      flex-shrink: 0;
    }
    .cbs-faq__q-text {
      flex-grow: 1;
    }
    .cbs-faq__item.is-hidden {
      display: none;
    }

    /* ---------- PROOF: Camper mini-case ---------- */
    .cbs-proof {
      padding: clamp(var(--space-6), 3vw + 1rem, var(--space-8));
      background: var(--bbg-surface);
      border: 1px solid var(--bbg-border);
      border-left: 6px solid var(--bbg-blue);
      border-radius: var(--radius-md);
    }
    .cbs-proof__head .eyebrow {
      color: var(--bbg-blue-dark);
    }
    .cbs-proof__head h2 {
      font-size: clamp(1.5rem, 1.5vw + 1rem, 2rem);
      line-height: 1.2;
      margin: var(--space-3) 0 var(--space-3);
      color: var(--bbg-ink);
    }
    .cbs-proof__lead {
      font-size: 1.05rem;
      line-height: 1.55;
      color: var(--bbg-text);
      max-width: 60ch;
    }
    .cbs-proof__stats {
      list-style: none;
      padding: 0;
      margin: var(--space-6) 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
    .cbs-proof__stats li {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: var(--space-4) var(--space-4);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-sm);
    }
    .cbs-proof__num {
      font-size: clamp(1.25rem, 1vw + 1rem, 1.625rem);
      font-weight: 700;
      color: var(--bbg-blue-dark);
      line-height: 1.1;
      letter-spacing: -0.01em;
    }
    .cbs-proof__label {
      font-size: 0.85rem;
      color: var(--bbg-text-muted);
      line-height: 1.4;
    }
    .cbs-proof__cta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      align-items: center;
    }
    @media (max-width: 720px) {
      .cbs-proof__stats {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- FINAL CTA ---------- */
    .cbs-cta {
      padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8)) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
      color: var(--bbg-white);
      border-radius: var(--radius-lg);
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .cbs-cta::before {
      content: '';
      position: absolute;
      top: -40%;
      right: -10%;
      width: 420px;
      height: 420px;
      background: radial-gradient(
        circle at center,
        rgba(255, 255, 255, 0.18) 0%,
        rgba(255, 255, 255, 0) 65%
      );
      pointer-events: none;
    }
    .cbs-cta .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-4);
      color: rgba(255, 255, 255, 0.9);
    }
    .cbs-cta__title {
      font-size: clamp(1.75rem, 1.5vw + 1rem, 2.5rem);
      line-height: 1.15;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      letter-spacing: -0.015em;
    }
    .cbs-cta__lead {
      color: rgba(255, 255, 255, 0.92);
      font-size: 1.0625rem;
      max-width: 52ch;
      margin: 0 auto var(--space-5);
      line-height: 1.55;
    }
    .cbs-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      justify-content: center;
      position: relative;
    }
    .cbs-cta__btn-primary {
      background: var(--bbg-white);
      color: var(--bbg-blue-dark);
      border: 1px solid var(--bbg-white);
    }
    .cbs-cta__btn-primary:hover {
      background: rgba(255, 255, 255, 0.92);
      color: var(--bbg-blue-dark);
    }
    .cbs-cta__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: var(--bbg-white);
    }
    .cbs-cta__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }
  </style>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Reveal-on-scroll
      const revealEls = document.querySelectorAll('.cbs-reveal');
      if (revealEls.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-in');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
          );
          revealEls.forEach((el) => io.observe(el));
        }
      }

      // 2. Animated counters
      const counters = document.querySelectorAll('[data-counter]');
      if (counters.length && !reduced && 'IntersectionObserver' in window) {
        const animate = (el) => {
          const target = parseFloat(el.dataset.counter || '0');
          const suffix = el.dataset.suffix || '';
          const duration = 1400;
          const start = performance.now();
          const tick = (now) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = Math.round(target * eased);
            el.textContent = value + suffix;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const counterIo = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animate(entry.target);
                counterIo.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.5 },
        );
        counters.forEach((el) => counterIo.observe(el));
      } else {
        counters.forEach((el) => {
          el.textContent = (el.dataset.counter || '0') + (el.dataset.suffix || '');
        });
      }

      // 3. Hero parallax + scroll progress bar
      const parallaxEl = document.querySelector('[data-parallax]');
      const progressEl = document.querySelector('.cbs-progress__bar');
      const heroEl = document.querySelector('[data-hero]');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;
          if (parallaxEl && heroEl && !reduced) {
            const heroH = heroEl.offsetHeight;
            if (scrollY < heroH) {
              parallaxEl.style.setProperty('--parallax-y', scrollY * 0.18 + 'px');
            }
          }
          if (progressEl) {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
            progressEl.style.setProperty('--progress', pct + '%');
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // 4. Tabs (handles both 2-tab models and 4-tab cadence)
      const openTabByHash = () => {
        const hash = window.location.hash.slice(1);
        if (!hash) return;
        document.querySelectorAll('[data-tabs]').forEach((root) => {
          const matchingTab = root.querySelector(`[data-tab-id="${hash}"]`);
          if (matchingTab) matchingTab.click();
        });
      };

      document.querySelectorAll('[data-tabs]').forEach((tabsRoot) => {
        const tabs = Array.from(tabsRoot.querySelectorAll('.cbs-tabs__tab'));
        const panels = Array.from(tabsRoot.querySelectorAll('.cbs-tabs__panel'));
        const indicator = tabsRoot.querySelector('.cbs-tabs__indicator');

        const setActive = (tab) => {
          tabs.forEach((t) => {
            const active = t === tab;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          const targetId = tab.getAttribute('data-tab-target');
          panels.forEach((p) => {
            const active = p.id === targetId;
            p.classList.toggle('is-active', active);
            if (active) p.removeAttribute('hidden');
            else p.setAttribute('hidden', '');
          });
          if (indicator) {
            const idx = tabs.indexOf(tab);
            const w = 100 / tabs.length;
            indicator.style.width = w + '%';
            indicator.style.transform = `translateX(${idx * 100}%)`;
          }
        };

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => setActive(tab));
          tab.addEventListener('keydown', (e) => {
            const idx = tabs.indexOf(tab);
            if (e.key === 'ArrowRight') {
              e.preventDefault();
              const next = tabs[(idx + 1) % tabs.length];
              next.focus();
              setActive(next);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
              prev.focus();
              setActive(prev);
            }
          });
        });

        const initialActive = tabs.find((t) => t.classList.contains('is-active')) || tabs[0];
        if (initialActive) setActive(initialActive);
      });

      // Open tab from URL hash on load and on hash change
      openTabByHash();
      window.addEventListener('hashchange', openTabByHash);

      // 5. Smooth scroll for anchors (also triggers tab open via hashchange)
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = link.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
          const tabId = id.slice(1);
          document.querySelectorAll('[data-tabs]').forEach((root) => {
            const matchingTab = root.querySelector(`[data-tab-id="${tabId}"]`);
            if (matchingTab) matchingTab.click();
          });
          history.replaceState(null, '', id);
        });
      });

      // 6. Two-truths: cursor tilt + scroll-driven image parallax
      const truths = document.querySelectorAll('[data-truth-tilt]');
      if (truths.length && !reduced) {
        truths.forEach((card) => {
          const onMove = (e) => {
            const rect = card.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width;
            const y = (e.clientY - rect.top) / rect.height;
            const ry = (x - 0.5) * 5;
            const rx = (0.5 - y) * 4;
            card.style.setProperty('--ry', ry.toFixed(2) + 'deg');
            card.style.setProperty('--rx', rx.toFixed(2) + 'deg');
            card.setAttribute('data-tilt-active', '');
          };
          const onLeave = () => {
            card.style.setProperty('--ry', '0deg');
            card.style.setProperty('--rx', '0deg');
            card.removeAttribute('data-tilt-active');
          };
          card.addEventListener('mousemove', onMove);
          card.addEventListener('mouseleave', onLeave);
        });

        const parallaxImgs = document.querySelectorAll('[data-truth-parallax]');
        let truthsTicking = false;
        const updateTruthParallax = () => {
          parallaxImgs.forEach((img) => {
            const frame = img.parentElement;
            if (!frame) return;
            const rect = frame.getBoundingClientRect();
            const vh = window.innerHeight;
            if (rect.bottom < 0 || rect.top > vh) return;
            const center = rect.top + rect.height / 2;
            const offset = (center - vh / 2) / vh;
            const shift = Math.max(-16, Math.min(16, -offset * 22));
            img.style.setProperty('--img-y', shift.toFixed(1) + 'px');
          });
        };
        const onTruthsScroll = () => {
          if (truthsTicking) return;
          truthsTicking = true;
          requestAnimationFrame(() => {
            updateTruthParallax();
            truthsTicking = false;
          });
        };
        window.addEventListener('scroll', onTruthsScroll, { passive: true });
        window.addEventListener('resize', onTruthsScroll, { passive: true });
        updateTruthParallax();
      }

      // 7. FAQ accordion - close others on open
      const faqItems = document.querySelectorAll('.cbs-faq__item');
      faqItems.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (item.open) {
            faqItems.forEach((other) => {
              if (other !== item && other.open) other.open = false;
            });
          }
        });
      });

      // 7. FAQ category filter
      const faqFilter = document.querySelector('[data-faq-filter]');
      const faqList = document.querySelector('[data-faq-list]');
      if (faqFilter && faqList) {
        const chips = Array.from(faqFilter.querySelectorAll('.cbs-faq-chip'));
        const items = Array.from(faqList.querySelectorAll('.cbs-faq__item'));
        chips.forEach((chip) => {
          chip.addEventListener('click', () => {
            const cat = chip.dataset.faqCat;
            chips.forEach((c) => {
              const on = c === chip;
              c.classList.toggle('is-active', on);
              c.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            items.forEach((item) => {
              const matches = cat === 'All' || item.dataset.faqCat === cat;
              item.classList.toggle('is-hidden', !matches);
            });
          });
        });
      }
    })();
  </script>
</Layout>
