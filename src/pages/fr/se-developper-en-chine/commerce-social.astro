    cat: 'Stratégie',
    q: 'Comment mesurer le retour sur investissement ?',
    a: "Trois indicateurs suivis chaque semaine : coût par acquisition, GMV par heure de livestream, taux d'engagement sur le contenu. Trois autres tenus chaque mois : taux de réachat, ROAS média global, progression des requêtes de marque. Le reste relève du détail d'analyse.",
  },
  {
    cat: 'Coût',
    q: 'Quelles sont les erreurs les plus fréquentes ?',
    a: "Trois écueils reviennent, presque toujours dans cet ordre. Un sous-investissement chronique dans la production de contenu. La signature d'un créateur unique, peu coûteux, dont on attend qu'il porte à lui seul une campagne entière. Et la coupe budgétaire au deuxième mois, faute de résultats immédiats, qui casse l'élan au moment précis où il commence à prendre. Ce scénario s'est rejoué sous nos yeux une dizaine de fois en deux ans.",
  },
  {
    cat: 'Plateformes',
    q: "Faut-il être présent sur WeChat lorsque l'on opère déjà sur Douyin et RedNote ?",
    a: "En B2C, il reste possible de différer WeChat la première année si le budget est tendu, à une réserve près : WeChat Channels s'est imposé en dix-huit mois comme une véritable surface de social commerce, et l'écart avec Douyin se resserre de trimestre en trimestre. En B2B, dans le premium et pour toute catégorie reposant sur un achat réfléchi, WeChat cesse d'être optionnel. C'est là que les clients à forte valeur restent suffisamment longtemps pour acheter une deuxième, puis une troisième fois.",
  },
  {
    cat: 'Plateformes',
    q: 'Comment démarrer avec vous ?',
    a: "Un échange de trente minutes avec un membre senior de l'équipe, sans intermédiaire junior. La marque expose sa catégorie, sa fourchette budgétaire et son calendrier. Nous indiquons en retour ce qui relève du réalisable, par quelles plateformes commencer, et l'allure que prendront les quatre-vingt-dix premiers jours. Aucune proposition n'est rédigée tant que les deux parties ne s'accordent pas sur la pertinence du projet.",
  },
];

const faqCategories = ['Toutes', 'Stratégie', 'Coût', 'Plateformes', 'Opérations', 'Créateurs'];

const icons: Record<string, string> = {
  store: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1.5-5h15L21 9"/><path d="M3 9v10a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V9"/><path d="M3 9h18"/><path d="M9 13h6"/></svg>`,
  creator: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/><path d="M18 3l0.8 1.7 1.8 0.3-1.3 1.3 0.3 1.8L18 7.3 16.4 8.1l0.3-1.8L15.4 5l1.8-0.3z"/></svg>`,
  video: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="14" height="12" rx="2"/><polygon points="17 9 22 6 22 18 17 15"/><circle cx="8" cy="11" r="1.2" fill="currentColor"/></svg>`,
  film: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="7" y1="4" x2="7" y2="20"/><line x1="17" y1="4" x2="17" y2="20"/><line x1="3" y1="9" x2="7" y2="9"/><line x1="3" y1="15" x2="7" y2="15"/><line x1="17" y1="9" x2="21" y2="9"/><line x1="17" y1="15" x2="21" y2="15"/></svg>`,
  chart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><rect x="5" y="13" width="3" height="7"/><rect x="11" y="8" width="3" height="12"/><rect x="17" y="4" width="3" height="16"/></svg>`,
  clipboard: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1"/><line x1="9" y1="10" x2="15" y2="10"/><line x1="9" y1="14" x2="15" y2="14"/><line x1="9" y1="18" x2="13" y2="18"/></svg>`,
  scroll: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M8 7h7M8 11h7M8 15h4"/></svg>`,
  outcome: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  doc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>`,
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Social commerce management',
  provider: {
    '@type': 'Organization',
    name: 'TheChinaPath',
    url: 'https://www.thechinapath.com',
  },
  areaServed: { '@type': 'Country', name: 'China' },
};
---

<Layout
  title="Social commerce en Chine pour les marques internationales"
  description="Pilotage du social commerce chinois pour les marques internationales. Boutiques Douyin, RedNote, WeChat et Weibo, programmes KOL et livestreams hebdomadaires, opérés par une équipe senior."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} is:inline />

  <div class="cbs-progress" aria-hidden="true"><div class="cbs-progress__bar"></div></div>
  <article class="cbs">
    {/* ---------- HERO ---------- */}
    <section class="cbs-hero" data-hero>
      <div class="cbs-hero__bg" aria-hidden="true" data-parallax>
        <img
          src="/Images/grow-in-china/social-commerce/hero-douyin-livestream.png"
          alt="Une jeune animatrice de livestream chinoise sur un plateau Douyin, ring light allumée, présente un flacon de skincare en plein argumentaire"
        />
      </div>
      <div class="cbs-hero__overlay" aria-hidden="true"></div>
      <div class="cbs-hero__grain" aria-hidden="true"></div>

      <div class="container cbs-hero__inner">
        <nav class="cbs-hero__crumbs" aria-label="Fil d'Ariane">
          <a href="/fr">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/fr/#services">Se développer en Chine</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark cbs-reveal">Social commerce</span>
        <h1 class="cbs-hero__title cbs-reveal" style="--reveal-delay: 80ms;">
          <span class="cbs-hero__title-row"
            >En Chine, l'acheteur ne se rend plus jusqu'à la boutique.</span
          >
          <span class="cbs-hero__title-row cbs-hero__title-row--accent"
            >C'est la boutique qui s'invite dans son fil.</span
          >
          <span class="cbs-hero__title-row cbs-hero__title-row--highlight"
            >Cette mécanique, nous l'orchestrons au quotidien.</span
          >
        </h1>
        <p class="cbs-hero__lead cbs-reveal" style="--reveal-delay: 200ms;">
          En Chine, le social commerce n'est plus une greffe sur l'e-commerce. Il est devenu la tête
          de pont des ventes pour la plupart des marques de consommation. TheChinaPath en pilote la
          totalité, du cadrage stratégique à l'exécution quotidienne sur plateforme.
        </p>
        <div class="cbs-hero__actions cbs-reveal" style="--reveal-delay: 280ms;">
          <a href="/fr/nous-contacter" class="btn btn--primary cbs-magnetic">Entrer en relation</a>
          <a href="#how-we-work" class="btn btn--ghost-light cbs-magnetic">Consulter la méthode</a>
        </div>

        <div class="cbs-hero__meta cbs-reveal" style="--reveal-delay: 360ms;">
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num" data-counter="15" data-suffix="+">0</span>
            <span class="cbs-hero__meta-label"
              >années à opérer Douyin et RedNote pour des marques étrangères</span
            >
          </div>
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num" data-counter="40" data-suffix="+">0</span>
            <span class="cbs-hero__meta-label"
              >boutiques et comptes de social commerce en activité</span
            >
          </div>
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num">Une équipe unique</span>
            <span class="cbs-hero__meta-label"
              >Stratégie, contenu, livestream et achat média rassemblés sous un même toit</span
            >
          </div>
        </div>
      </div>

      <a href="#two-truths" class="cbs-hero__scroll" aria-label="Aller à la section suivante">
        <span class="cbs-hero__scroll-line"></span>
        <span class="cbs-hero__scroll-text">Faire défiler</span>
      </a>
    </section>

    {/* ---------- TWO TRUTHS ---------- */}
    <section id="two-truths" class="section cbs-truths-section">
      <div class="cbs-truths-bg" aria-hidden="true">
        <div class="cbs-truths-bg__blob cbs-truths-bg__blob--a"></div>
        <div class="cbs-truths-bg__blob cbs-truths-bg__blob--b"></div>
        <div class="cbs-truths-bg__grid"></div>
      </div>

      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Notre approche</span>
          <h2>Deux constats avant toute intervention sur votre social commerce</h2>
          <p class="section-header__lead">
            La plupart des marques abordent Douyin et RedNote comme un marché de plus à conquérir.
            Aucune des deux plateformes ne récompense ce réflexe. Deux principes guident, en amont,
            notre méthode.
          </p>
        </header>

        <div class="cbs-truths" data-truths>
          {
            contextCards.map((c, i) => (
              <article
                class={`cbs-truth${i === 1 ? ' cbs-truth--alt' : ''} cbs-reveal`}
                style={`--reveal-delay: ${i * 140}ms;`}
                data-truth-tilt
              >
                <div class="cbs-truth__inner">
                  <div class="cbs-truth__stage">
                    <div class="cbs-truth__frame">
                      <img
                        src={c.image}
                        alt={c.alt}
                        loading="lazy"
                        decoding="async"
                        data-truth-parallax
                      />
                      <div class="cbs-truth__shade" aria-hidden="true" />
                      <div class="cbs-truth__sheen" aria-hidden="true" />
                    </div>

                    <div class="cbs-truth__kicker" aria-hidden="true">
                      <span class="cbs-truth__kicker-dot" />
                      {c.kicker}
                    </div>

                    {i === 0 && (
                      <div class="cbs-truth__chip cbs-truth__chip--bl" data-float="1">
                        <div class="cbs-truth__chip-row">
                          <span class="cbs-truth__pulse" aria-hidden="true" />
                          <span class="cbs-truth__chip-label">{c.chipLabel}</span>
                        </div>
                        <p class="cbs-truth__chip-sub">{c.chipSub}</p>
                        <div class="cbs-truth__avatars">
                          {c.avatars &&
                            c.avatars.map((a) => (
                              <span class={`cbs-truth__avatar cbs-truth__avatar--${a.tone}`}>
                                {a.letter}
                              </span>
                            ))}
                          <span class="cbs-truth__avatar cbs-truth__avatar--more">
                            {c.extraAvatars}
                          </span>
                        </div>
                      </div>
                    )}

                    {i === 0 && (
                      <div class="cbs-truth__pin" data-float="2">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <rect x="3" y="6" width="14" height="12" rx="2" />
                          <polygon points="17 9 22 6 22 18 17 15" />
                        </svg>
                        <div class="cbs-truth__pin-text">
                          <span class="cbs-truth__pin-label">{c.pinLabel}</span>
                          <span class="cbs-truth__pin-value">{c.pinValue}</span>
                        </div>
                      </div>
                    )}

                    {i === 1 && (
                      <div class="cbs-truth__chip cbs-truth__chip--tr" data-float="1">
                        <div class="cbs-truth__chip-row">
                          <span class="cbs-truth__pulse" aria-hidden="true" />
                          <span class="cbs-truth__chip-label">{c.chipLabel}</span>
                        </div>
                        <p class="cbs-truth__chip-sub">{c.chipSub}</p>
                      </div>
                    )}

                    {i === 1 && (
                      <div class="cbs-truth__badge" data-float="2">
                        <span class="cbs-truth__badge-eyebrow">Pourquoi cela compte</span>
                        <span class="cbs-truth__badge-title">{c.badge}</span>
                        <span class="cbs-truth__badge-sub">{c.badgeSub}</span>
                      </div>
                    )}
                  </div>

                  <div class="cbs-truth__content">
                    <h3 class="cbs-truth__title">{c.title}</h3>
                    <p class="cbs-truth__body">{c.body}</p>

                    {i === 0 && c.flow && (
                      <ol
                        class="cbs-truth__flow"
                        aria-label="Flux de production de contenu quotidien"
                      >
                        {c.flow.map((step, idx) => (
                          <>
                            <li class="cbs-truth__flow-step" style={`--flow-delay: ${idx * 90}ms`}>
                              <span class="cbs-truth__flow-bubble">
                                {idx === 0 && (
                                  <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                  >
                                    <rect x="3" y="6" width="14" height="12" rx="2" />
                                    <polygon points="17 9 22 6 22 18 17 15" />
                                  </svg>
                                )}
                                {idx === 1 && (
                                  <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                  >
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                    <path d="M18.5 2.5a2.1 2.1 0 1 1 3 3L12 15l-4 1 1-4z" />
                                  </svg>
                                )}
                                {idx === 2 && (
                                  <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                  >
                                    <path d="M22 2L11 13" />
                                    <path d="M22 2L15 22 11 13 2 9z" />
                                  </svg>
                                )}
                              </span>
                              <span class="cbs-truth__flow-label">{step}</span>
                            </li>
                            {idx < c.flow.length - 1 && (
                              <li class="cbs-truth__flow-arrow" aria-hidden="true">
                                <svg
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                >
                                  <path d="M5 12h14M13 6l6 6-6 6" />
                                </svg>
                              </li>
                            )}
                          </>
                        ))}
                      </ol>
                    )}

                    {i === 1 && c.credentials && (
                      <ul class="cbs-truth__tags" aria-label="Ce que nous opérons, au quotidien">
                        {c.credentials.map((tag) => (
                          <li class="cbs-truth__tag">{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- WHY BRANDS CHOOSE US ---------- */}
    <section class="section section--alt">
      <div class="container">
        <div class="cbs-value">
          <div class="cbs-value__copy">
            <span class="eyebrow">Pourquoi les marques nous choisissent</span>
            <h2>
              Peu d'agences de social commerce ont véritablement opéré une boutique. TheChinaPath le
              fait depuis quinze ans.
            </h2>
            <p>
              L'équipe vient de Publicis Commerce China. Elle a conçu et fait tourner des boutiques
              Douyin et RedNote pour des marques internationales. Si nous identifions les créateurs
              qui convertissent, c'est que nous les avons briefés. Si nous lisons les arbitrages de
              Qianchuan, c'est que nous y dépensons chaque jour.
            </p>
            <blockquote class="cbs-quote cbs-quote--inline">
              <p>
                Les consultants qui parlent de Douyin et de RedNote ont rarement opéré une boutique
                sur ces plateformes. Nous l'avons fait, et cela change radicalement la nature des
                recommandations que nous formulons.
              </p>
            </blockquote>
            <p>
              Nous avons manqué un 11.11 avant de remporter le suivant. Si nous indiquons en mars ce
              qui fonctionne sur Douyin, c'est que nous étions à l'intérieur de la plateforme dès
              février.
            </p>
            <a href="/fr/qui-nous-sommes#team" class="btn btn--secondary cbs-magnetic"
              >Rencontrer l'équipe</a
            >
          </div>

          <ul class="cbs-promise">
            <li>
              <span class="eyebrow">Ce que vous pouvez attendre</span>
            </li>
            {
              promises.map((p) => (
                <li class="cbs-promise__item">
                  <span class="cbs-promise__check" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="5 12 10 17 19 8" />
                    </svg>
                  </span>
                  <div>
                    <h4>{p.title}</h4>
                    <p>{p.desc}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ---------- WHAT WE DO ---------- */}
    <section class="section">
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Ce que nous faisons</span>
          <h2>Six terrains, une équipe unique</h2>
          <p class="section-header__lead">
            Plutôt que de multiplier agences, briefs et factures, un même opérateur prend en main le
            contenu, le commerce, les créateurs et le média. La stratégie inscrite dans la
            présentation tourne sur la plateforme dès le lundi suivant.
          </p>
        </header>

        <div class="cbs-services cbs-reveal">
          {
            services.map((s, i) => (
              <a href={s.href} class="cbs-service" style={`--reveal-delay: ${i * 60}ms;`}>
                <span class="cbs-service__icon" aria-hidden="true" set:html={icons[s.icon]} />
                <h3 class="cbs-service__title">{s.title}</h3>
                <p class="cbs-service__body">{s.body}</p>
                <span class="cbs-service__arrow">
                  En savoir plus
                  <span class="cbs-service__arrow-icon" aria-hidden="true">
                    →
                  </span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- DECISION POINT (Two models) ---------- */}
    <section id="decision-point" class="section section--alt cbs-models-section">
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Point de décision</span>
          <h2>Qui détient le stock ? Deux manières de structurer votre boutique sociale.</h2>
          <p class="section-header__lead">
            Toute boutique Douyin ou RedNote se bâtit autour d'une première question commerciale : à
            qui revient la propriété du stock ? La réponse oriente la rédaction du contrat, le
            niveau de marge et le mode de comptabilisation du chiffre d'affaires chinois. Deux
            modèles structurent l'offre ; le bon choix dépend de la place que la Chine doit occuper
            dans les comptes.
          </p>
        </header>

        <div class="cbs-tabs cbs-tabs--two cbs-reveal" data-tabs>
          <div class="cbs-tabs__nav" role="tablist">
            {
              models.map((m, i) => (
                <button
                  type="button"
                  class={`cbs-tabs__tab${i === 0 ? ' is-active' : ''}`}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls={`model-panel-${i}`}
                  id={`model-tab-${i}`}
                  data-tab-target={`model-panel-${i}`}
                >
                  <span class="cbs-tabs__tab-label">{m.name}</span>
                  <span class="cbs-tabs__tab-tag">{m.tag}</span>
                  {m.highlight && <span class="cbs-tabs__tab-pop">Le plus retenu</span>}
                </button>
              ))
            }
            <span class="cbs-tabs__indicator" aria-hidden="true"></span>
          </div>

          <div class="cbs-tabs__panels">
            {
              models.map((m, i) => (
                <div
                  class={`cbs-tabs__panel${i === 0 ? ' is-active' : ''}`}
                  role="tabpanel"
                  id={`model-panel-${i}`}
                  aria-labelledby={`model-tab-${i}`}
                  hidden={i !== 0}
                >
                  <div class="cbs-tabs__panel-grid">
                    <div class="cbs-tabs__lead">
                      <span class="cbs-tabs__pillset">
                        <span class="cbs-tabs__pill">{m.tag}</span>
                      </span>
                      <h3 class="cbs-tabs__title">{m.name}</h3>
                      <p class="cbs-tabs__desc">{m.desc}</p>
                      <div class="cbs-tabs__when">
                        <span class="cbs-tabs__when-label">À privilégier lorsque</span>
                        <p>{m.when}</p>
                      </div>

                      <div class="cbs-owns">
                        <span class="cbs-owns__label">Qui détient quoi</span>
                        <ul class="cbs-owns__list">
                          {m.owns.map((o) => (
                            <li>
                              <span class="cbs-owns__key">{o.label}</span>
                              <span class="cbs-owns__val">{o.value}</span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <a href="/fr/nous-contacter" class="btn btn--primary cbs-magnetic">
                        Discuter du {m.name}
                      </a>
                    </div>

