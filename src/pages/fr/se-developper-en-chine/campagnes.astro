---
import Layout from '../../../layouts/Layout.astro';

const heroStats = [
  { num: '20', suffix: '+', label: "années à piloter des campagnes festivals pour des marques étrangères" },
  { num: '10', suffix: '', label: "fenêtres festival sur le calendrier chinois chaque année" },
  { num: "Une équipe", suffix: '', label: "Stratégie, contenu, livestream, achat média et offline, de bout en bout" },
];

const channels = [
  {
    kicker: "Plateforme",
    title: "La plateforme eCommerce",
    body: "Habillage de la boutique, prix, coupons, mécaniques officielles du festival, trafic payant (Zhitongche, Wanxiangtai).",
    image: '/Images/grow-in-china/campaigns/channel-platform-storefront.png',
    alt: "Un téléphone affiche la vitrine festival Tmall d'une marque en pleine campagne, tenu d'une main dans un bureau chinois",
  },
  {
    kicker: "Contenu",
    title: "Contenu et social",
    body: "Xiaohongshu, Douyin et WeChat sèment l'intérêt dans les semaines qui précèdent la date. Plus la production photo et vidéo qui les alimente.",
    image: '/Images/grow-in-china/campaigns/channel-content-shoot.png',
    alt: "Un petit studio tourne une vidéo courte festival, produit sur une table éclairée, téléphone sur stabilisateur, plan de tournage en mandarin scotché au mur",
  },
  {
    kicker: "Créateurs",
    title: "KOL et KOC",
    body: "Les créateurs et les consommateurs experts bâtissent la preuve sociale et la demande avant le pic.",
    image: '/Images/grow-in-china/campaigns/channel-kol-review.png',
    alt: "Une créatrice chinoise de mid-tier filme un avis produit pour un pic festival, chez elle près d'une fenêtre, ring light et lumière d'après-midi mêlées",
  },
  {
    kicker: "Live",
    title: "Livestream",
    body: "Votre propre studio de marque, ou celui d'un animateur. Souvent le premier moteur de ventes le jour même.",
    image: '/Images/grow-in-china/campaigns/channel-livestream-room.png',
    alt: "Un plateau livestream Douyin en pleine session festival, l'animatrice s'adresse à la caméra, le compte à rebours s'affiche sur un moniteur latéral",
  },
  {
    kicker: "Privé",
    title: "Trafic privé",
    body: "Les groupes WeChat et votre base de membres. Des audiences que vous touchez directement, sans coût média.",
    image: '/Images/grow-in-china/campaigns/channel-wechat-groups.png',
    alt: "L'écran d'une community manager affiche des groupes WeChat actifs avec un bon festival épinglé, téléphone et ordinateur portable côte à côte",
  },
  {
    kicker: "Offline",
    title: "Offline, quand cela s'impose",
    body: "Un pop-up, un partenariat retail, un événement. Pour certaines catégories, le rendez-vous physique rend toute la campagne en ligne crédible.",
    image: '/Images/grow-in-china/campaigns/channel-offline-popup.png',
    alt: "Un pop-up de marque dans un centre commercial chinois adossé à un festival, des visiteurs s'arrêtent au stand, un kakémono QR renvoie vers la boutique en ligne",
  },
];

const steps = [
  {
    title: "Choisir le moment",
    body: "Toutes les marques ne devraient pas courir tous les festivals, et nous le disons tôt si une date ne vaut pas la peine pour vous. Nous retenons celles qui valent qu'on s'y batte, selon votre catégorie, votre stock et vos marges.",
  },
  {
    title: "Bâtir l'angle créatif",
    body: "Une grande campagne chinoise est une campagne de marque, pas un simple rabais. Il lui faut une idée, un produit héros, une signature visuelle. C'est l'étape que les marques sautent le plus souvent, et celle qui gagne l'attention avant que la campagne ne décroche la moindre vente.",
  },
  {
    title: "Tenir la montée",
    body: "Quatre à six semaines avant, le contenu et le seeding KOL démarrent. Les paniers se remplissent. La recherche s'intensifie. C'est le travail que personne ne voit, et c'est en général lui qui décide du résultat.",
  },
  {
    title: "Tenir le pic",
    body: "La fenêtre événement elle-même. Livestream, trafic et prix en direct, service client à plein régime. Nous y sommes heure par heure, parce que la journée bouge vite et que les ajustements fins comptent.",
  },
  {
    title: "Clôturer et lire",
    body: "Offres de fin, puis bilan honnête de ce que la campagne a réellement rapporté et de ce que nous changerions la prochaine fois.",
  },
];

const calendar = [
  { date: "Janv. / févr.", event: "Nouvel An chinois", prep: "8 à 10 semaines à l'avance", what: "Le plus grand rendez-vous culturel de l'année. Cadeaux, emballages rouges, famille. Les ventes ralentissent pendant la fête elle-même, mais la montée est forte.", who: "Catégories cadeaux, alimentaire, beauté, premium" },
  { date: "8 mars", event: "Journée des femmes / Queen's Day", prep: "6 semaines à l'avance", what: "Un moment shopping centré sur le féminin, fort en beauté et en mode.", who: "Beauté, mode, joaillerie, wellness" },
  { date: "Avril / mai", event: "Fête du travail (1er mai)", prep: "6 semaines à l'avance", what: "Un pic voyage et lifestyle, et un relais utile en milieu de printemps.", who: "Voyage, outdoor, lifestyle, grande consommation" },
  { date: "Mai au 18 juin", event: "Festival 618", prep: "10 à 12 semaines à l'avance", what: "Le deuxième festival de l'année. Lancé par JD, il s'étend désormais à toutes les plateformes. Les préventes ouvrent à la mi-mai.", who: "Toute marque vendant en Chine" },
  { date: "19 juin (2026)", event: "Fête des bateaux-dragons", prep: "5 semaines à l'avance", what: "Un rendez-vous culturel autour du cadeau et de la cuisine traditionnelle.", who: "Alimentaire, cadeau, marques d'héritage" },
  { date: "8 août", event: "8.8 / Festival 88VIP", prep: "6 semaines à l'avance", what: "Un rendez-vous Tmall Global centré sur les marques internationales et la fidélité des membres.", who: "Marques cross-border, marques avec base de membres" },
  { date: "19 août (2026)", event: "Festival Qixi", prep: "5 à 6 semaines à l'avance", what: "La Saint-Valentin chinoise. Cadeau romantique.", who: "Beauté, joaillerie, mode, cadeau" },
  { date: "Sept. / oct.", event: "Mi-automne et Golden Week", prep: "6 à 8 semaines à l'avance", what: "Cadeau, doublé d'une longue fête nationale, avec un pic voyage et dépense.", who: "Alimentaire, cadeau, voyage, lifestyle" },
  { date: "Fin oct. au 11 nov.", event: "Singles Day (Double 11)", prep: "12 à 14 semaines à l'avance", what: "Le plus grand événement de shopping en ligne au monde. Désormais étalé sur plusieurs semaines depuis fin octobre. La campagne de l'année.", who: "Toute marque vendant en Chine" },
  { date: "12 décembre", event: "Double 12 / fin d'année", prep: "5 semaines à l'avance", what: "Le pic final de l'année. Fort pour les marques plus modestes et pour la liquidation de stock.", who: "Petites marques, déstockage, retardataires" },
];

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'China eCommerce campaign management',
  provider: {
    '@type': 'Organization',
    name: 'Beyond Border Group',
    url: 'https://beyondbordergroup.com',
  },
  areaServed: { '@type': 'Country', name: 'China' },
};
---

<Layout
  title="Campagnes eCommerce en Chine : 618, Singles Day et plus"
  description="Les festivals chinois décident de votre année. Nous concevons et tenons des campagnes eCommerce multicanal sur Tmall, JD, Douyin et offline, de la montée au pic."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} is:inline />

  <div class="cbs-progress" aria-hidden="true"><div class="cbs-progress__bar"></div></div>
  <article class="cbs">

    {/* ---------- HERO ---------- */}
    <section class="cbs-hero" data-hero>
      <div class="cbs-hero__bg" aria-hidden="true" data-parallax>
        <img src="/Images/grow-in-china/campaigns/hero-campaign-warroom.png" alt="Une salle de pilotage de campagne Singles Day en Chine, des opérateurs suivent un tableau GMV en direct, les chiffres festival grimpent en rouge" />
      </div>
      <div class="cbs-hero__overlay" aria-hidden="true"></div>
      <div class="cbs-hero__grain" aria-hidden="true"></div>

      <div class="container cbs-hero__inner">
        <nav class="cbs-hero__crumbs" aria-label="Fil d'Ariane">
          <a href="/fr/">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/fr/#services">Se développer en Chine</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark cbs-reveal">Campagnes</span>
        <h1 class="cbs-hero__title cbs-reveal" style="--reveal-delay: 80ms;">
          <span class="cbs-hero__title-row">Vendre en Chine tourne autour des campagnes.</span>
          <span class="cbs-hero__title-row cbs-hero__title-row--accent">Les manquer, c'est manquer l'année.</span>
        </h1>
        <p class="cbs-hero__lead cbs-reveal" style="--reveal-delay: 200ms;">
          En Chine, les ventes arrivent par vagues, calées sur des dates où le pays entier fait ses achats.
          Les marques qui anticipent ces vagues croissent. Les autres stagnent.
          Nous bâtissons la campagne, l'opérons sur chaque canal nécessaire, et restons sur le
          terrain à vos côtés quand elle part en direct.
        </p>
        <div class="cbs-hero__actions cbs-reveal" style="--reveal-delay: 280ms;">
          <a href="/fr/nous-contacter" class="btn btn--primary cbs-magnetic">Échanger sur une campagne</a>
          <a href="#calendar" class="btn btn--ghost-light cbs-magnetic">Voir le calendrier</a>
        </div>

        <div class="cbs-hero__meta cbs-reveal" style="--reveal-delay: 360ms;">
          {heroStats.map((s) => (
            <div class="cbs-hero__meta-item">
              <span class="cbs-hero__meta-num">{s.num}{s.suffix}</span>
              <span class="cbs-hero__meta-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>

      <a href="#basics" class="cbs-hero__scroll" aria-label="Aller à la section suivante">
        <span class="cbs-hero__scroll-line"></span>
        <span class="cbs-hero__scroll-text">Faire défiler</span>
      </a>
    </section>

    {/* ---------- BASICS ---------- */}
    <section id="basics" class="section">
      <div class="container">
        <div class="cbs-basics">
          <header class="cbs-basics__head cbs-reveal">
            <span class="eyebrow">Les fondamentaux</span>
            <h2>Ce qu'est une campagne, et pourquoi cela compte</h2>
          </header>

          <div class="cbs-basics__cols cbs-reveal">
            <div class="cbs-basics__col">
              <p>
                Une campagne, c'est un effort coordonné autour d'un seul moment. Le plus souvent un
                festival commercial comme 618 ou Singles Day, parfois un lancement produit
                ou un anniversaire de marque.
              </p>
              <p>
                Ce qu'elle n'est pas : une bannière sur la page de votre boutique. C'est une séquence
                qui tient sur des semaines. Une montée avant la date, l'événement au pic, une
                clôture après, avec des prix, du contenu, du livestream, du seeding KOL,
                du service client et du stock, tous orientés vers les mêmes quelques jours.
              </p>
              <p>
                Et une grande campagne chinoise est une campagne de marque à part entière. Le
                budget atteint souvent celui d'une campagne de marque, et le retour
                ne se limite pas au chiffre du trimestre ; il se joue aussi
                sur la construction de marque.
              </p>
            </div>

            <div class="cbs-basics__col">
              <p>
                Voici ce que les marques ratent. Les acheteurs chinois attendent les festivals.
                Ils remplissent leur panier pendant des semaines, puis achètent tout d'un coup quand les
                remises s'ouvrent. Les plateformes alimentent ce comportement : pendant les
                fenêtres festival, Tmall, JD et Douyin orientent le trafic et le ranking de recherche vers
                les marques qui activent les mécaniques officielles. Manquer 618 et
                Singles Day, c'est céder les deux plus grandes fenêtres de ventes de
                l'année, ainsi que votre ranking, à ceux qui se sont présentés.
              </p>
              <p>
                Il y a un prix plus grand encore. Lorsque la plateforme retient votre
                campagne parmi les temps forts du festival, elle place son propre poids publicitaire
                derrière vous. Mise en avant, trafic home page, le type de
                portée qu'on ne peut tout simplement pas acheter en direct.
              </p>
              <p>
                Pour la plupart des marques que nous opérons, les fenêtres festival concentrent une part
                importante du chiffre annuel. Les mois calmes paient le loyer.
                Les campagnes font l'année.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- REALITY ---------- */}
    <section class="section section--alt cbs-truths-section">
      <div class="cbs-truths-bg" aria-hidden="true">
        <div class="cbs-truths-bg__blob cbs-truths-bg__blob--a"></div>
        <div class="cbs-truths-bg__blob cbs-truths-bg__blob--b"></div>
        <div class="cbs-truths-bg__grid"></div>
      </div>

      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">La réalité</span>
          <h2>Une campagne ne se limite jamais à la plateforme eCommerce</h2>
          <p class="section-header__lead">
            C'est la partie que la plupart des marques sous-estiment. Oui, la vente se conclut sur Tmall,
            JD ou Douyin. Mais la campagne qui la déclenche vit presque partout ailleurs,
            et elle est presque toujours multicanal. Une campagne type travaille sur
            plusieurs fronts en même temps.
          </p>
        </header>

        <div class="cbs-truths cbs-truths--three">
          {channels.map((c, i) => (
            <article
              class={`cbs-truth cbs-truth--compact${i % 2 === 1 ? ' cbs-truth--alt' : ''} cbs-reveal`}
              style={`--reveal-delay: ${(i % 3) * 100}ms;`}
              data-truth-tilt
            >
              <div class="cbs-truth__inner">
                <div class="cbs-truth__stage">
                  <div class="cbs-truth__frame">
                    <img
                      src={c.image}
                      alt={c.alt}
                      loading="lazy"
                      decoding="async"
                      data-truth-parallax
                    />
                    <div class="cbs-truth__shade" aria-hidden="true"></div>
                    <div class="cbs-truth__sheen" aria-hidden="true"></div>
                  </div>
                  <div class="cbs-truth__kicker" aria-hidden="true">
                    <span class="cbs-truth__kicker-dot"></span>
                    {c.kicker}
                  </div>
                </div>

                <div class="cbs-truth__content">
                  <h3 class="cbs-truth__title">{c.title}</h3>
                  <p class="cbs-truth__body">{c.body}</p>
                </div>
              </div>
            </article>
          ))}
        </div>

        <p class="cbs-reality__note cbs-reveal">
          Aucun de ces leviers n'est difficile à activer isolément. La difficulté, et le point qui
          décide du résultat, c'est de les faire partir dans le bon ordre, tous orientés vers
          la même date.
        </p>
      </div>
    </section>

    {/* ---------- APPROACH ---------- */}
    <section class="section">
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Notre approche</span>
          <h2>Comment nous tenons une campagne</h2>
          <p class="section-header__lead">
            L'ossature reste la même à chaque fois. Les détails varient, la colonne vertébrale
            non.
          </p>
        </header>

        <ol class="cbs-steps">
          {steps.map((s, i) => (
            <li class="cbs-steps__item cbs-reveal" style={`--reveal-delay: ${i * 80}ms;`}>
              <span class="cbs-steps__check" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8"/></svg>
              </span>
              <h3 class="cbs-steps__title">{s.title}</h3>
              <p class="cbs-steps__body">{s.body}</p>
            </li>
          ))}
        </ol>

        <blockquote class="cbs-quote cbs-reveal">
          <p>Nous ne vous remettons pas une présentation pour disparaître ensuite. Nous l'opérons avec vous.
          Voilà la différence.</p>
        </blockquote>

        <div class="cbs-approach__cta cbs-reveal">
          <a href="/fr/nous-contacter" class="btn btn--ghost">Voir comment nous planifierions votre prochain festival</a>
        </div>
      </div>
    </section>

    {/* ---------- BUDGET ---------- */}
    <section class="section section--alt">
      <div class="container container--narrow">
        <header class="section-header cbs-reveal">
          <span class="eyebrow">Le budget</span>
          <h2>Ce que cela coûte, et ce qu'il faut savoir avant de signer</h2>
        </header>

        <div class="cbs-prose cbs-reveal">
          <p>
            Il n'existe pas de chiffre unique pour une campagne chinoise, et quiconque vous en propose
            un avant d'avoir interrogé votre catégorie devine. Le budget se ventile en
            plusieurs postes : les honoraires de conception et de pilotage, le média (souvent la plus grosse ligne, trafic payant
            et amplification sur Xiaohongshu et Douyin), les frais KOL et livestream,
            la production de contenu, ainsi que la marge stock et remise qui décide
            si l'ensemble est rentable.
          </p>
        </div>

        <blockquote class="cbs-quote cbs-quote--warning cbs-reveal">
          <p>
            Un mot d'avertissement honnête. Les festivals tirent sur la marge, et toutes les marques
            ne devraient pas viser chaque date. Une campagne qui gagne en GMV mais perd de l'argent n'est pas
            une victoire. Mieux vaut vous dire de sauter un festival que d'en tenir un qui
            vous abîme. Ce jugement fait partie de ce que vous payez.
          </p>
        </blockquote>

        <div class="cbs-prose cbs-reveal">
          <p>
            Dites-nous la date que vous visez. Nous reviendrons avec un chiffre réel,
            pas une fourchette vague.
          </p>
        </div>
      </div>
    </section>

    {/* ---------- CALENDAR ---------- */}
    <section id="calendar" class="section">
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Le calendrier</span>
          <h2>Le calendrier des campagnes eCommerce chinoises</h2>
          <p class="section-header__lead">
            Quelles dates faut-il réellement planifier ? Voici celles autour desquelles le marché chinois
            fait ses achats. Toutes ne sont pas à viser. Mais toute marque
            qui vend en Chine devrait s'aligner sur ce calendrier un an à l'avance, parce que la
            préparation démarre bien avant la date.
          </p>
        </header>

        <div class="cbs-compare cbs-reveal">
          <div class="cbs-compare__table-wrap">
            <table class="cbs-calendar">
              <thead>
                <tr>
                  <th scope="col">Date</th>
                  <th scope="col">Événement</th>
                  <th scope="col" class="cbs-calendar__th--accent">Démarrer la préparation</th>
                  <th scope="col">De quoi il s'agit</th>
                  <th scope="col">À qui cela convient</th>
                </tr>
              </thead>
              <tbody>
                {calendar.map((row) => (
                  <tr>
                    <td class="cbs-calendar__date">{row.date}</td>
                    <td class="cbs-calendar__event">{row.event}</td>
                    <td class="cbs-calendar__prep">{row.prep}</td>
                    <td class="cbs-calendar__what">{row.what}</td>
                    <td class="cbs-calendar__who">{row.who}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="cbs-compare__note">
            Comment lire ce calendrier. Vous ne tenez pas les dix. Une marque focalisée en retient
            deux ou trois à remporter sérieusement et traite les autres en mode léger. 618 et
            Singles Day sont les non-négociables. Le reste dépend de votre catégorie. Et
            regardez la colonne préparation : si un festival approche en moins que son délai d'antériorité,
            vous êtes déjà en retard ; visez le suivant.
          </p>
        </div>
      </div>
    </section>

    {/* ---------- FIT ---------- */}
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Le profil</span>
          <h2>Est-ce votre cas ?</h2>
        </header>

        <div class="cbs-fit">
          <article class="cbs-fit__card cbs-fit__card--yes cbs-reveal">
            <span class="cbs-fit__tag">C'est pour vous</span>
            <p>
              Un programme de campagne a du sens si vous vendez déjà en Chine,
              sur Tmall, Tmall Global, JD ou Douyin, et que vos fenêtres festival
              ne pèsent pas autant qu'elles le devraient. Il a tout autant de sens si
              vous vous apprêtez à lancer et que vous voulez voir votre premier festival
              marquer, plutôt que passer.
            </p>
          </article>

          <article class="cbs-fit__card cbs-fit__card--not cbs-reveal" style="--reveal-delay: 120ms;">
            <span class="cbs-fit__tag">Pas encore</span>
            <p>
              Ce n'est sans doute pas encore pour vous si votre boutique est toute neuve sans
              historique de trafic, ou si vos marges ne supportent simplement pas une
              remise festival. Aucune honte. Cela signifie simplement que le travail de fond passe
              d'abord, et la campagne après. Parlons-en plutôt côté fondations,
              nous préférons vous démarrer au bon endroit.
            </p>
          </article>
        </div>
      </div>
    </section>

    {/* ---------- CLOSING ---------- */}
    <section class="section section--tight">
      <div class="container container--narrow">
        <div class="cbs-cta">
          <span class="eyebrow eyebrow--on-dark">Parlons-en</span>
          <h2 class="cbs-cta__title">Prêts à remporter les festivals chinois ?</h2>
          <p class="cbs-cta__lead">
            Nous avons piloté des campagnes festival pour des marques internationales en beauté,
            skincare, alimentaire et grande consommation. Nous savons quelles dates valent votre
            budget, et lesquelles laisser passer. Nous savons bâtir la montée qui
            déplace réellement le résultat, et nous connaissons la sensation du pic quand
            il est en direct et que les chiffres arrivent heure par heure.
          </p>
          <p class="cbs-cta__pull">
            Nous conseillons sur le plan, et nous opérons ce que nous recommandons.
          </p>
          <div class="cbs-cta__actions">
            <a href="/fr/nous-contacter" class="btn cbs-cta__btn-primary">Planifier votre calendrier de campagnes avec nous</a>
            <a href="/fr/nos-realisations" class="btn cbs-cta__btn-ghost">Voir nos études de cas</a>
          </div>
        </div>
      </div>
    </section>
  </article>

  <style is:global>
    /* ---------- Container narrow helper ---------- */
    .cbs .container--narrow { max-width: 880px; }

    /* ---------- REVEAL + MOTION ---------- */
    @media (prefers-reduced-motion: no-preference) {
      .cbs-reveal {
        opacity: 0;
        transform: translateY(16px);
        transition:
          opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
          transform 700ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms);
      }
      .cbs-reveal.is-in { opacity: 1; transform: translateY(0); }
      .cbs-magnetic {
        will-change: transform;
        transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
                    box-shadow 220ms ease, background-color 200ms ease, color 200ms ease;
      }
    }

    /* ---------- SCROLL PROGRESS BAR ---------- */
    .cbs-progress {
      position: fixed; top: 0; left: 0; right: 0;
      height: 3px; z-index: 1000;
      background: transparent; pointer-events: none;
    }
    .cbs-progress__bar {
      height: 100%; width: var(--progress, 0%);
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 60%, #9DDBF5 100%);
      box-shadow: 0 0 12px rgba(38, 154, 218, 0.55);
      transition: width 80ms linear;
    }

    /* ---------- HERO ---------- */
    .cbs-hero {
      position: relative;
      min-height: clamp(360px, 48vh, 500px);
      display: flex; align-items: flex-start;
      padding: clamp(8px, 1.25vh, 16px) 0 clamp(48px, 7vh, 80px);
      color: var(--bbg-white);
      overflow: hidden; isolation: isolate;
    }
    body:has(.cbs-hero) .cbs-hero { padding-top: clamp(112px, 10vh, 144px); }
    @media (max-width: 1024px) {
      body:has(.cbs-hero) .cbs-hero { padding-top: clamp(96px, 9vh, 116px); }
    }
    .cbs-hero__bg { position: absolute; inset: -10% 0 0; z-index: -3; }
    .cbs-hero__bg img {
      width: 100%; height: 110%;
      object-fit: cover; object-position: center;
      transform: translate3d(0, var(--parallax-y, 0px), 0) scale(1.04);
      transition: transform 80ms linear;
      filter: saturate(0.95);
    }
    .cbs-hero__overlay {
      position: absolute; inset: 0; z-index: -2;
      background:
        linear-gradient(110deg,
          rgba(8, 18, 28, 0.92) 0%,
          rgba(8, 18, 28, 0.72) 42%,
          rgba(8, 18, 28, 0.32) 100%),
        radial-gradient(120% 80% at 0% 100%,
          rgba(38, 154, 218, 0.28) 0%,
          rgba(38, 154, 218, 0) 60%);
    }
    .cbs-hero__grain {
      position: absolute; inset: 0; z-index: -1;
      background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
      background-size: 3px 3px;
      mix-blend-mode: overlay; opacity: 0.45;
      pointer-events: none;
    }
    .cbs-hero__inner { max-width: 980px; position: relative; }
    .cbs-hero__crumbs {
      margin-bottom: var(--space-4);
      font-size: var(--fs-small);
      display: flex; gap: 0.5rem; align-items: center;
      color: rgba(255, 255, 255, 0.7);
    }
    .cbs-hero__crumbs a { color: rgba(255, 255, 255, 0.85); font-weight: 500; }
    .cbs-hero__crumbs a:hover { color: var(--bbg-white); }
    .cbs-hero__inner .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-3);
      color: #9DDBF5;
    }
    .cbs-hero__title {
      font-size: clamp(2rem, 3.4vw + 1rem, 3.75rem);
      line-height: 1.06;
      letter-spacing: -0.025em;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      max-width: 22ch;
      font-weight: 700;
      display: flex; flex-direction: column;
      gap: 0.05em;
    }
    .cbs-hero__title-row { display: block; }
    .cbs-hero__title-row--accent {
      color: #9DDBF5; font-weight: 500;
      font-style: italic; letter-spacing: -0.018em;
    }
    .cbs-hero__lead {
      font-size: clamp(1rem, 0.5vw + 1rem, 1.1875rem);
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.86);
      max-width: 58ch;
      margin: 0 0 var(--space-5);
    }
    .cbs-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-6); }
    .cbs-magnetic:hover { transform: translateY(-2px); }

    .cbs-hero__meta {
      display: flex; flex-wrap: nowrap;
      gap: clamp(var(--space-3), 3vw, var(--space-6));
      padding-top: var(--space-5);
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      max-width: none;
    }
    .cbs-hero__meta-item {
      display: flex; flex-direction: column;
      gap: 0.2rem;
      min-width: 0;
      flex: 1 1 0;
    }
    @media (max-width: 720px) {
      .cbs-hero__meta { flex-wrap: wrap; }
      .cbs-hero__meta-item { flex: 1 1 auto; }
    }
    .cbs-hero__meta-num {
      font-size: clamp(1.625rem, 1.2vw + 1rem, 2.125rem);
      font-weight: 700; letter-spacing: -0.02em;
      line-height: 1; color: var(--bbg-white);
      font-feature-settings: "tnum";
    }
    .cbs-hero__meta-label {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.66);
      letter-spacing: 0.02em;
    }

    .cbs-hero__scroll {
      position: absolute;
      bottom: var(--space-5);
      right: clamp(var(--space-5), 4vw, var(--space-7));
      display: flex; flex-direction: column;
      align-items: center; gap: 0.5rem;
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.7rem; letter-spacing: 0.18em;
      text-transform: uppercase; font-weight: 600;
      transition: color 200ms ease;
    }
    .cbs-hero__scroll:hover { color: var(--bbg-white); }
    .cbs-hero__scroll-line {
      width: 1px; height: 40px;
      background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.6) 100%);
      position: relative; overflow: hidden;
    }
    .cbs-hero__scroll-line::after {
      content: ""; position: absolute;
      top: -100%; left: 0; right: 0;
      height: 50%;
      background: linear-gradient(180deg, transparent 0%, var(--bbg-white) 100%);
      animation: cbs-scroll-tick 1.8s ease-in-out infinite;
    }
    @keyframes cbs-scroll-tick { 0% { top: -50%; } 100% { top: 100%; } }
    @media (max-width: 720px) {
      .cbs-hero__scroll { display: none; }
      .cbs-hero__meta { gap: var(--space-4); }
    }

    /* ---------- PROSE BLOCK ---------- */
    .cbs-prose p {
      color: var(--bbg-text);
      line-height: 1.75;
      font-size: 1.0625rem;
      margin: 0 0 var(--space-4);
    }
    .cbs-prose p:last-child { margin-bottom: 0; }
    .cbs-prose + .cbs-quote { margin-top: var(--space-5); }
    .cbs-quote + .cbs-prose { margin-top: var(--space-5); }

    /* ---------- BASICS (two-column read) ---------- */
    .cbs-basics {
      max-width: 1080px;
      margin: 0 auto;
    }
    .cbs-basics__head {
      max-width: 720px;
      margin: 0 auto var(--space-6);
      text-align: center;
    }
    .cbs-basics__head h2 {
      font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
      line-height: 1.15;
      letter-spacing: -0.015em;
      margin: var(--space-3) 0 0;
    }
    .cbs-basics__cols {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .cbs-basics__col p {
      color: var(--bbg-text);
      font-size: 1.0625rem;
      line-height: 1.75;
      margin: 0 0 var(--space-4);
    }
    .cbs-basics__col p:last-child { margin-bottom: 0; }
    @media (max-width: 820px) {
      .cbs-basics__cols { grid-template-columns: 1fr; gap: var(--space-4); }
    }

    .cbs-reality__note {
      margin: var(--space-6) auto 0;
      max-width: 70ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
    }

    /* ---------- STEPS (no number badges, check-icon led) ---------- */
    .cbs-steps {
      list-style: none; padding: 0; margin: 0;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-5);
      counter-reset: none;
    }
    .cbs-steps__item {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      display: flex; flex-direction: column;
      gap: var(--space-3);
      position: relative;
      transition: border-color 260ms ease, box-shadow 260ms ease, transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-steps__item::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }
    .cbs-steps__item:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: 0 16px 32px -20px rgba(38, 154, 218, 0.4);
    }
    .cbs-steps__item:hover::before { transform: scaleX(1); }
    .cbs-steps__check {
      width: 36px; height: 36px;
      border-radius: 50%;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .cbs-steps__check svg { width: 18px; height: 18px; }
    .cbs-steps__title {
      font-size: 1.0625rem;
      line-height: 1.25;
      margin: 0;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-steps__body {
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .cbs-steps { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .cbs-steps { grid-template-columns: 1fr; }
    }

    .cbs-approach__cta {
      margin-top: var(--space-6);
      text-align: center;
    }

    /* ---------- QUOTE / CALLOUT ---------- */
    .cbs-quote {
      margin: var(--space-6) auto 0;
      max-width: 760px;
      padding: var(--space-5) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(38, 154, 218, 0.10) 100%);
      border-left: 4px solid var(--bbg-blue);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
    }
    .cbs-quote p {
      margin: 0;
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--bbg-ink);
      font-weight: 500;
      font-style: italic;
    }
    .cbs-quote--warning {
      background: linear-gradient(135deg, #FFF6E5 0%, #FFEDC9 100%);
      border-left-color: #D89B2A;
    }
    .cbs-quote--warning p { color: #5B3E0A; font-style: normal; font-weight: 500; }

    /* ---------- CALENDAR TABLE ---------- */
    .cbs-compare {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: clamp(var(--space-4), 2vw + 1rem, var(--space-6));
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    }
    .cbs-compare__table-wrap { overflow-x: auto; }
    .cbs-calendar {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      min-width: 880px;
      font-size: 0.95rem;
    }
    .cbs-calendar thead th {
      text-align: left;
      vertical-align: top;
      padding: var(--space-4);
      background: var(--bbg-surface);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-calendar__th--accent {
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
    }
    .cbs-calendar tbody td {
      padding: var(--space-4);
      border-bottom: 1px solid var(--bbg-border);
      vertical-align: top;
      color: var(--bbg-ink);
      line-height: 1.55;
    }
    .cbs-calendar tbody tr:last-child td { border-bottom: none; }
    .cbs-calendar tbody tr:hover td { background: rgba(38, 154, 218, 0.03); }
    .cbs-calendar__date {
      font-weight: 700;
      color: var(--bbg-ink);
      white-space: nowrap;
    }
    .cbs-calendar__event {
      font-weight: 600;
      color: var(--bbg-ink);
    }
    .cbs-calendar__prep {
      font-weight: 700;
      color: var(--bbg-blue);
      white-space: nowrap;
      background: rgba(38, 154, 218, 0.04);
    }
    .cbs-calendar__what {
      color: var(--bbg-text);
      max-width: 36ch;
    }
    .cbs-calendar__who {
      color: var(--bbg-text-muted);
      font-size: 0.9rem;
    }
    .cbs-compare__note {
      margin: var(--space-5) auto 0;
      max-width: 70ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 0.975rem;
    }

    /* ---------- FIT (two cards) ---------- */
    .cbs-fit {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
    .cbs-fit__card {
      padding: clamp(var(--space-5), 2vw + 1rem, var(--space-7));
      border-radius: var(--radius-lg);
      border: 1px solid var(--bbg-border);
      background: var(--bbg-white);
      display: flex; flex-direction: column;
      gap: var(--space-3);
      position: relative;
      transition: border-color 260ms ease, box-shadow 260ms ease, transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-fit__card:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 28px -18px rgba(8, 18, 28, 0.18);
    }
    .cbs-fit__card--yes {
      background: linear-gradient(160deg, var(--bbg-blue-light) 0%, rgba(38, 154, 218, 0.08) 100%);
      border-color: rgba(38, 154, 218, 0.35);
    }
    .cbs-fit__card--yes:hover { border-color: var(--bbg-blue); }
    .cbs-fit__tag {
      align-self: flex-start;
      font-size: 0.72rem; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase;
      padding: 0.35em 0.85em;
      border-radius: 999px;
    }
    .cbs-fit__card--yes .cbs-fit__tag {
      color: var(--bbg-white);
      background: var(--bbg-blue);
    }
    .cbs-fit__card--not .cbs-fit__tag {
      color: var(--bbg-text-muted);
      background: var(--bbg-surface);
      border: 1px solid var(--bbg-border);
    }
    .cbs-fit__card p {
      color: var(--bbg-ink);
      font-size: 1.0625rem;
      line-height: 1.65;
      margin: 0;
    }
    .cbs-fit__card--not p { color: var(--bbg-text); }
    @media (max-width: 1024px) {
      .cbs-fit { grid-template-columns: 1fr; }
    }

    /* ---------- FINAL CTA ---------- */
    .cbs-cta {
      padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8)) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
      color: var(--bbg-white);
      border-radius: var(--radius-lg);
      text-align: center;
      position: relative; overflow: hidden;
    }
    .cbs-cta::before {
      content: ""; position: absolute;
      top: -40%; right: -10%;
      width: 420px; height: 420px;
      background: radial-gradient(circle at center, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 65%);
      pointer-events: none;
    }
    .cbs-cta .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-4);
      color: rgba(255, 255, 255, 0.9);
    }
    .cbs-cta__title {
      font-size: clamp(1.75rem, 1.5vw + 1rem, 2.5rem);
      line-height: 1.15;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      letter-spacing: -0.015em;
    }
    .cbs-cta__lead {
      color: rgba(255, 255, 255, 0.92);
      font-size: 1.0625rem;
      max-width: 58ch;
      margin: 0 auto var(--space-4);
      line-height: 1.6;
    }
    .cbs-cta__pull {
      font-size: 1.125rem;
      font-style: italic;
      font-weight: 500;
      color: var(--bbg-white);
      max-width: 50ch;
      margin: 0 auto var(--space-5);
      padding-top: var(--space-4);
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      line-height: 1.45;
      position: relative;
    }
    .cbs-cta__actions {
      display: flex; flex-wrap: wrap;
      gap: var(--space-3);
      justify-content: center;
      position: relative;
    }
    .cbs-cta__btn-primary {
      background: var(--bbg-white);
      color: var(--bbg-blue-dark);
      border: 1px solid var(--bbg-white);
    }
    .cbs-cta__btn-primary:hover {
      background: rgba(255, 255, 255, 0.92);
      color: var(--bbg-blue-dark);
    }
    .cbs-cta__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: var(--bbg-white);
    }
    .cbs-cta__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }
  </style>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const revealEls = document.querySelectorAll('.cbs-reveal');
      if (revealEls.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          revealEls.forEach((el) => io.observe(el));
        }
      }

      const parallaxEl = document.querySelector('[data-parallax]');
      const progressEl = document.querySelector('.cbs-progress__bar');
      const heroEl = document.querySelector('[data-hero]');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;
          if (parallaxEl && heroEl && !reduced) {
            const heroH = heroEl.offsetHeight;
            if (scrollY < heroH) {
              parallaxEl.style.setProperty('--parallax-y', (scrollY * 0.18) + 'px');
            }
          }
          if (progressEl) {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
            progressEl.style.setProperty('--progress', pct + '%');
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = link.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
          history.replaceState(null, '', id);
        });
      });

      // Truth cards: cursor tilt + scroll-driven image parallax
      const truths = document.querySelectorAll('[data-truth-tilt]');
      if (truths.length && !reduced) {
        truths.forEach((card) => {
          const onMove = (e) => {
            const rect = card.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width;
            const y = (e.clientY - rect.top) / rect.height;
            const ry = (x - 0.5) * 5;
            const rx = (0.5 - y) * 4;
            card.style.setProperty('--ry', ry.toFixed(2) + 'deg');
            card.style.setProperty('--rx', rx.toFixed(2) + 'deg');
            card.setAttribute('data-tilt-active', '');
          };
          const onLeave = () => {
            card.style.setProperty('--ry', '0deg');
            card.style.setProperty('--rx', '0deg');
            card.removeAttribute('data-tilt-active');
          };
          card.addEventListener('mousemove', onMove);
          card.addEventListener('mouseleave', onLeave);
        });

        const parallaxImgs = document.querySelectorAll('[data-truth-parallax]');
        let truthsTicking = false;
        const updateTruthParallax = () => {
          parallaxImgs.forEach((img) => {
            const frame = img.parentElement;
            if (!frame) return;
            const rect = frame.getBoundingClientRect();
            const vh = window.innerHeight;
            if (rect.bottom < 0 || rect.top > vh) return;
            const center = rect.top + rect.height / 2;
            const offset = (center - vh / 2) / vh;
            const shift = Math.max(-16, Math.min(16, -offset * 22));
            img.style.setProperty('--img-y', shift.toFixed(1) + 'px');
          });
        };
        const onTruthsScroll = () => {
          if (truthsTicking) return;
          truthsTicking = true;
          requestAnimationFrame(() => {
            updateTruthParallax();
            truthsTicking = false;
          });
        };
        window.addEventListener('scroll', onTruthsScroll, { passive: true });
        window.addEventListener('resize', onTruthsScroll, { passive: true });
        updateTruthParallax();
      }
    })();
  </script>
</Layout>
