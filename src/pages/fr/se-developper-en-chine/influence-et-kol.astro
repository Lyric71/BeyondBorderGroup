    desc: "Vidéo courte et livestream commerce, portés par un algorithme d'intérêt. TheChinaPath y figure parmi les partenaires marketing officiels.",
  },
  {
    name: "WeChat",
    cn: '微信',
    desc: "Articles, trafic privé, relation au long cours, CRM intégré. Plus de dix ans d'antériorité opérationnelle.",
  },
  {
    name: "Weibo",
    cn: '微博',
    desc: "Audience large, conversation publique. La plateforme garde toute son efficacité au moment d'un lancement ou d'un emballement viral.",
  },
