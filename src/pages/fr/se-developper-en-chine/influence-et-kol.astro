---
import Layout from '../../../layouts/Layout.astro';

const heroStats = [
  { num: '10,000', suffix: '+', label: "créateurs dans notre propre base KOC" },
  { num: '7', suffix: '', label: "plateformes opérées de bout en bout" },
  { num: "Une équipe", suffix: '', label: "Casting, brief, production et reporting" },
];

const whyPoints = [
  {
    lead: "Le tunnel tient sur un écran, pas en cinq étapes.",
    body: "Les acheteurs chinois ne quittent pas l'application pour décider. Ils défilent, cherchent, regardent un livestream et achètent, tout au même endroit. Traiter l'influenceur comme un panneau d'affichage, c'est brûler le budget avant la première publication.",
  },
  {
    lead: "Les ordres de grandeur dépassent ce qu'on imagine.",
    body: "Le livestream commerce seul atteint des centaines de milliards de dollars par an, et le canal continue de croître à un rythme à deux chiffres.",
  },
  {
    lead: "Et les marques y sous-investissent encore.",
    body: "L'investissement influence en Asie reste un ordre de grandeur sous celui des États-Unis, alors que le canal y porte une plus large part des ventes. L'opportunité est là, à portée de main.",
  },
];

const whyQuotes = [
  {
    image: '/Images/grow-in-china/influencers-kols/why-funnel-onescreen.png',
    alt: "Une Chinoise fait défiler son téléphone sur un canapé, un colis tout juste ouvert à ses côtés, le tunnel en un écran pris au pied de la lettre",
    quote: "Le marché du livestream e-commerce chinois a atteint environ 807 milliards de dollars en 2024, et devrait croître à près de 18 % par an jusqu'en 2026.",
    cite: "U.S. Department of Agriculture, Shanghai ATO",
    citeMeta: "Selling in China: The Rise of Livestreaming E-commerce, 2025",
  },
  {
    image: '/Images/grow-in-china/influencers-kols/why-koc-mentions.png',
    alt: "Un écran de téléphone affiche une grille de publications de petits créateurs pour une catégorie produit, un vrai moment de recherche dans un cadre domestique",
    quote: "À l'échelle de l'Asie, la dépense influence ne représente que 0,75 % du GMV social commerce, contre 6,8 % aux États-Unis.",
    cite: "Totem et Rakuten Insight",
    citeMeta: "Influencer Marketing in Asia, 2025",
  },
];

const howSteps = [
  {
    icon: 'compass',
    title: "Trouver les bonnes personnes",
    body: "Nous partons de votre objectif et de votre marge, pas d'un nom sur une liste. Puis nous lisons la donnée : qui regarde, et ce qu'ils achètent ensuite. Nous tenons notre propre base de KOC déjà éprouvés.",
  },
  {
    icon: 'pen',
    title: "Rédiger un brief qui passe la rampe",
    body: "Le brief, c'est tout le jeu. Nous arrêtons le message et les essentiels avec vous, puis nous laissons l'exécution au créateur. Ceux qui sonnent comme un script sont précisément ceux que personne ne regarde.",
  },
  {
    icon: 'gear',
    title: "Opérer de bout en bout",
    body: "Contrats, contenu, calendrier de publication, coordination livestream. Vous validez le plan. Nous redéployons le budget dès qu'un levier sous-performe, pas trois semaines plus tard en post-mortem.",
  },
  {
    icon: 'link',
    title: "Relier le contenu au commerce",
    body: "Une publication d'où l'on ne peut pas acheter, c'est une demi-campagne. Nous relions le contenu directement à votre boutique sur Douyin, Tmall ou JD et traçons ce que chaque créateur a généré. Sur Xiaohongshu, la vente se referme souvent ailleurs, alors nous la suivons d'une plateforme à l'autre.",
  },
];

const benefits = [
  {
    icon: 'handshake',
    lead: "Des relations directes, des tarifs meilleurs.",
    body: "Nous travaillons avec des KOL et des MCN que nous connaissons personnellement, pas une marketplace. Accès prioritaire à des créateurs très demandés, à des tarifs en dessous du marché ouvert.",
  },
  {
    icon: 'creator',
    lead: "Un réseau KOC bâti sur des années.",
    body: "Notre propre base, plus de 10 000 créateurs. Elle place votre produit devant les bonnes communautés de niche à une échelle qu'une marque ne peut pas atteindre seule.",
  },
  {
    icon: 'chart',
    lead: "Une sélection appuyée sur la donnée, pas sur l'instinct.",
    body: "Chaque créateur d'une shortlist est filtré au préalable : composition d'audience, engagement réel, contrôle des faux abonnés.",
  },
  {
    icon: 'clipboard',
    lead: "Un reporting qui relie la dépense aux ventes.",
    body: "Créateur par créateur, d'une plateforme à l'autre. Vous savez lesquels ont vendu pendant que la campagne tourne encore, quand il est encore temps d'agir.",
  },
];

const platforms = [
  {
    name: "Xiaohongshu",
    cn: '小红书',
    desc: "Là où la recherche et l'achat se font dans le même scroll. Une note forte renvoie l'acheteur droit vers votre boutique. Notre base maison KOC et KOL vit ici.",
  },
  {
    name: "Douyin",
    cn: '抖音',
    desc: "Vidéo courte et livestream commerce, sur un algorithme d'intérêt. Nous sommes partenaire marketing officiel Douyin.",
  },
  {
    name: "WeChat",
    cn: '微信',
    desc: "Articles, trafic privé, confiance longue et CRM. Plus de dix ans sur la plateforme.",
  },
  {
    name: "Weibo",
    cn: '微博',
    desc: "Audience et conversation. Toujours puissant pour les lancements et le buzz.",
  },
  {
    name: "Bilibili",
    cn: '',
    desc: "Format long, audience plus jeune, fortement engagée. Sous-utilisé par les marques étrangères.",
  },
  {
    name: "Kuaishou",
    cn: '快手',
    desc: "Livestream commerce qui mord pour de bon dans les villes de rang inférieur.",
  },
  {
    name: "Tmall et JD",
    cn: '天猫 / 京东',
    desc: "Les plateformes où la vente se conclut. Nous relions le contenu KOL directement à votre boutique et tenons des campagnes d'influence à l'intérieur des deux.",
  },
];

const faqs = [
  { cat: "Stratégie", q: "En quoi est-ce différent du marketing d'influence chez nous ?", a: "À l'Ouest, les influenceurs créent surtout de la notoriété, et l'achat se conclut plus tard, ailleurs. En Chine, tout se passe dans la même application, souvent dans la même session. Les créateurs sont reliés directement aux ventes, pas seulement à l'audience. Et parce que les marques sous-investissent encore le canal par rapport aux États-Unis, c'est davantage une porte ouverte qu'une salle pleine." },
  { cat: "Créateurs", q: "Comment trouver le bon influenceur ?", a: "Partez de votre audience, pas de l'influenceur. Identifiez qui vous devez toucher, puis comparez ce profil à la vraie base d'abonnés du créateur, pas à son chiffre de façade. Douyin tourne sur un algorithme d'intérêt, l'adéquation du contenu l'emporte donc en général sur le nombre d'abonnés. Une agence qui dispose de vraies données et de relations directes rend ce travail plus rapide et moins cher que de tâtonner seul." },
  { cat: "Coût", q: "Combien coûte réellement un KOL ?", a: "Très large amplitude. Sur Xiaohongshu, une publication de nano KOC vaut quelques centaines de RMB ; une publication de KOL de mid-tier se situe dans les dizaines de milliers ; un nom de premier rang peut dépasser 100 000 RMB pour une seule publication. La vidéo Douyin sort généralement 20 à 30 % en dessous, pour une portée comparable. Et les KOL livestream de premier rang touchent une commission sur les ventes en plus, souvent 40 à 50 %. Quel que soit le chiffre annoncé, traitez-le comme un point de départ, pas une grille tarifaire." },
  { cat: "Coût", q: "Quel budget faut-il pour tester sérieusement ?", a: "Pour réellement tester une plateforme, comptez 100 000 à 300 000 RMB sur deux à trois mois. Cela couvre un socle de seeding KOC, quelques KOL de mid-tier, la production de contenu et un peu d'amplification payante. Vous pouvez tenir un pilote de seeding sous 50 000 RMB, mais vous n'aurez pas de lecture nette sur la capacité du canal à vendre pour vous." },
  { cat: "Créateurs", q: "KOL ou KOC ?", a: "Le plus souvent les deux. Les KOL vous donnent de la portée et un signal de crédibilité. Les KOC, ces créateurs du quotidien à audience restreinte et fidèle, bâtissent la traction de recherche qui compte quand un acheteur cherche votre produit. Une dizaine de mentions honnêtes, et il achète. Une seule publication payée, il poursuit son défilement. Nous calibrons le mix en fonction de votre objectif et de votre budget, et ce mix est rarement le même deux fois." },
  { cat: "Stratégie", q: "Quelle plateforme est la meilleure ?", a: "Celle où vos acheteurs se trouvent déjà. Xiaohongshu convient aux achats réfléchis en beauté, lifestyle et wellness. Douyin est conçu pour la vente en vidéo et livestream à grande échelle. Weibo fonctionne encore pour les lancements. WeChat est pour la profondeur et la rétention. La plupart des marques ont besoin de deux ou trois, pas d'une seule, et surtout pas de toutes en même temps." },
  { cat: "Travailler avec nous", q: "Comment faire en sorte qu'un KOL vende réellement, et pas seulement génère des vues ?", a: "Intégrez le produit au contenu pour qu'il ne se lise pas comme une publicité, puis rendez-le achetable sur place. Livestreams, avis honnêtes, déballages, codes de réduction réservés aux abonnés. Et le lien de la publication vers la page produit doit exister. Une campagne sans chemin vers l'achat n'est qu'une notoriété facturée plus cher." },
  { cat: "Opérations", q: "Faut-il une entité enregistrée en Chine ?", a: "Pour les systèmes officiels de collaboration, en général oui. Le Pugongying de Xiaohongshu et les outils officiels de Weibo demandent généralement une entité enregistrée en Chine. Vous pouvez toutefois tenir des campagnes via une agence qui détient les relations, voie que la plupart des marques étrangères empruntent avant d'avoir leur propre entité." },
  { cat: "Opérations", q: "Combien de temps avant la mise en ligne ?", a: "Du brief aux premières publications, trois à cinq semaines. La shortlist et la négociation prennent une à deux semaines, le contrat quelques jours, le contenu et sa relecture une à deux de plus. Les créneaux livestream avec des animateurs très demandés se réservent souvent plus à l'avance. Bâcler le brief, c'est précisément là que les campagnes perdent silencieusement en qualité." },
  { cat: "Créateurs", q: "Comment savoir si les abonnés d'un influenceur sont réels ?", a: "Regardez au-delà du chiffre, observez la forme de l'engagement. Qualité des commentaires, taux de sauvegarde et de partage, adéquation du profil ville et âge de l'audience avec le contenu. Pics soudains d'abonnés, commentaires génériques d'un seul mot, engagement décorrélé des vues : ce sont les drapeaux rouges. Nous filtrons cela avant qu'un nom n'atteigne une shortlist, parce que les comptes gonflés sont courants." },
  { cat: "Opérations", q: "Que doit préciser le contrat ?", a: "Soyez précis. Nombre et type de publications, plateforme, fenêtre de diffusion, durée de maintien du contenu en ligne, droits d'usage si vous voulez le réemployer, KPI et structure de commission lorsqu'elle s'applique. Les contrats vagues sont la source des litiges. Et inscrivez la preuve de performance avant paiement final." },
  { cat: "Coût", q: "Puis-je réutiliser le contenu dans mes propres campagnes ?", a: "Uniquement si le contrat accorde des droits d'usage, et cela coûte généralement en plus. Beaucoup de marques oublient de le négocier, puis découvrent qu'elles ne peuvent pas amplifier légalement une publication qui a bien marché. Décidez en amont si vous voulez les droits d'amplification. Les ajouter après coup est plus lent et plus cher." },
  { cat: "Stratégie", q: "Quels résultats peut-on raisonnablement attendre ?", a: "Cela dépend de la catégorie, du budget et de la plateforme, méfiez-vous donc de quiconque promet un chiffre fixe. Une campagne de seeding saine bâtit la visibilité en recherche et un socle de mentions authentiques. Un livestream génère des ventes dans une fenêtre. Calez le KPI sur le format : portée et sauvegardes pour le seeding, conversion et GMV pour le livestream. Et jugez le programme sur un trimestre, pas sur une publication." },
  { cat: "Stratégie", q: "Comment mesurer le ROI quand la vente se conclut ailleurs ?", a: "C'est le problème Xiaohongshu. Une note bâtit l'intention, puis l'acheteur règle sur Tmall ou JD quelques jours plus tard. Nous le suivons à travers le lift de recherche de marque, le trafic et l'ajout au panier sur votre boutique, et des codes de réduction propres à chaque créateur. L'intention apparaît d'abord, les ventes ensuite. Nous mesurons donc d'une plateforme à l'autre, pas à l'intérieur d'une seule." },
  { cat: "Opérations", q: "Que faire si une campagne sous-performe à mi-parcours ?", a: "Nous déplaçons le budget. Si un créateur ne convertit pas, la dépense bascule vers ceux qui convertissent. Ou nous ajustons l'angle. Ou nous changeons de format. Rien de cela ne fonctionne sans reporting en direct, et c'est précisément pour cette raison que nous le mettons en place dès le premier jour. La souplesse doit figurer dans le plan et dans les contrats, avant d'en avoir besoin." },
  { cat: "Créateurs", q: "Le livestream en vaut-il la peine pour nous ?", a: "Cela dépend de la catégorie et de la marge. Le livestream tire l'engagement le plus élevé et la conversion la plus directe, mais les animateurs de premier rang prennent cette commission de 40 à 50 %, et le format récompense les produits qui se démontrent bien. Pour beaucoup de marques, un livestream tenu depuis la boutique l'emporte sur la location d'une vedette : vous gardez la main sur le message et la marge. Si cela ne colle pas à votre cas, nous le dirons." },
  { cat: "Opérations", q: "Comment éviter que cela ne ressemble à une publicité évidente ?", a: "Briefez le créateur sur le message et les essentiels, puis laissez l'exécution tranquille. Les scripts sont précisément ce que personne ne regarde, et sur Xiaohongshu la vente forcée se retourne vite. Un contenu natif, basé sur l'expérience, qui cite le produit honnêtement, l'emporte presque toujours sur un texte publicitaire poli." },
  { cat: "Opérations", q: "Quels risques de conformité connaître ?", a: "La loi publicitaire chinoise est stricte sur les superlatifs et les allégations non vérifiées. « Meilleur », « numéro un », promesses santé ou efficacité non prouvées peuvent déclencher de vraies sanctions. Et les collaborations d'influence doivent de plus en plus passer par les plateformes officielles pour la déclaration. Nous briefons les créateurs sur ce qu'ils ne peuvent pas dire, et nous validons le contenu avant la mise en ligne." },
  { cat: "Stratégie", q: "Une petite marque peut-elle réussir ici, ou est-ce réservé aux grands noms ?", a: "Une petite marque peut absolument réussir ici, et fait souvent mieux par les KOC que par les KOL. Parce que Douyin et Xiaohongshu récompensent l'adéquation du contenu plutôt que le nombre d'abonnés, un produit pertinent et un bon contenu peuvent bâtir de la traction sans budget vedette. Démarrez par un socle resserré de seeding KOC, prouvez que le produit prend, puis montez en charge." },
  { cat: "Travailler avec nous", q: "Faut-il travailler avec les créateurs en direct, via une MCN, ou via une agence ?", a: "Le direct fonctionne si vous avez l'équipe Chine, la langue, les contrats et le temps de qualifier les comptes. Une MCN vous donne son roster, mais souvenez-vous qu'elle représente ses créateurs, pas vous. Une agence travaille de votre côté de la table. Elle sélectionne sur l'ensemble du marché contre vos objectifs, gère les contrats et la conformité, et relie le reporting à vos ventes. Cette dernière partie, c'est notre métier." },
];

const faqCategories = ["Toutes", "Stratégie", "Coût", "Créateurs", "Opérations", "Travailler avec nous"];

const icons: Record<string, string> = {
  compass: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="15 9 13 13 9 15 11 11 15 9"/></svg>`,
  pen: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l3.5-1 11-11-2.5-2.5-11 11z"/><path d="M14 5l2.5-2.5a1.4 1.4 0 0 1 2 0l1 1a1.4 1.4 0 0 1 0 2L17 8"/></svg>`,
  gear: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
  link: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07L11.17 5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07L12.83 19"/></svg>`,
  handshake: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12l4-4 5 5-1 1-3-3-4 4z"/><path d="M22 12l-4-4-5 5 1 1 3-3 4 4z"/><path d="M9 14l3-3 3 3-3 3z"/></svg>`,
  creator: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>`,
  chart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><rect x="5" y="13" width="3" height="7"/><rect x="11" y="8" width="3" height="12"/><rect x="17" y="4" width="3" height="16"/></svg>`,
  clipboard: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1"/><line x1="9" y1="10" x2="15" y2="10"/><line x1="9" y1="14" x2="15" y2="14"/><line x1="9" y1="18" x2="13" y2="18"/></svg>`,
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'KOL and influencer marketing in China',
  provider: {
    '@type': 'Organization',
    name: 'Beyond Border Group',
    url: 'https://beyondbordergroup.com',
  },
  areaServed: { '@type': 'Country', name: 'China' },
};
---

<Layout
  title="Agence KOL Chine : marketing d'influence et ventes"
  description="Nous opérons des campagnes KOL et KOC en Chine qui vendent, pas seulement qui font des vues. Sélection de créateurs pilotée par la donnée sur Douyin, Xiaohongshu, Tmall et JD."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} is:inline />

  <div class="kol-progress" aria-hidden="true"><div class="kol-progress__bar"></div></div>
  <article class="kol">

    {/* ---------- HERO ---------- */}
    <section class="kol-hero" data-hero>
      <div class="kol-hero__bg" aria-hidden="true" data-parallax>
        <img src="/Images/grow-in-china/influencers-kols/hero-kol-livestream.png" alt="Une jeune animatrice livestream chinoise sur un petit plateau à domicile, ring light allumée, présente un flacon de skincare en plein argumentaire" />
      </div>
      <div class="kol-hero__overlay" aria-hidden="true"></div>
      <div class="kol-hero__grain" aria-hidden="true"></div>

      <div class="container kol-hero__inner">
        <nav class="kol-hero__crumbs" aria-label="Fil d'Ariane">
          <a href="/fr/">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/fr/#services">Se développer en Chine</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark kol-reveal">Influence et KOL</span>
        <h1 class="kol-hero__title kol-reveal" style="--reveal-delay: 80ms;">
          <span class="kol-hero__title-row">À l'Ouest, un influenceur attire l'attention.</span>
          <span class="kol-hero__title-row kol-hero__title-row--accent">En Chine, il referme la vente.</span>
        </h1>
        <p class="kol-hero__lead kol-reveal" style="--reveal-delay: 200ms;">
          Sur Instagram, le créateur se loge en haut du tunnel. En Chine, découverte,
          recherche et paiement tiennent sur un seul écran, dans la même minute. Le KOL n'est pas
          votre couche de notoriété. Il se tient à la caisse. Nous choisissons donc les créateurs sur
          données, nous les briefons sérieusement, et notre rémunération est liée à ce qui s'est réellement vendu.
        </p>
        <div class="kol-hero__actions kol-reveal" style="--reveal-delay: 280ms;">
          <a href="/fr/nous-contacter" class="btn btn--primary kol-magnetic">Échanger sur votre campagne</a>
          <a href="/fr/decryptages" class="btn btn--ghost-light kol-magnetic">Lire nos décryptages Chine</a>
        </div>

        <div class="kol-hero__meta kol-reveal" style="--reveal-delay: 360ms;">
          {heroStats.map((s) => (
            <div class="kol-hero__meta-item">
              <span class="kol-hero__meta-num">{s.num}{s.suffix}</span>
              <span class="kol-hero__meta-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>

      <a href="#why" class="kol-hero__scroll" aria-label="Aller à la section suivante">
        <span class="kol-hero__scroll-line"></span>
        <span class="kol-hero__scroll-text">Faire défiler</span>
      </a>
    </section>

    {/* ---------- WHY CHINA IS A DIFFERENT GAME ---------- */}
    <section id="why" class="section">
      <div class="container">
        <header class="section-header section-header--center kol-reveal">
          <span class="eyebrow">Why it&rsquo;s different</span>
          <h2>Pourquoi la Chine est un autre jeu</h2>
          <p class="section-header__lead">
            La plupart des marques débarquent avec le playbook occidental et perdent de l'argent pendant un trimestre
            avant d'en comprendre la cause. Trois erreurs qu'il fait.
          </p>
        </header>

        <ul class="kol-points kol-reveal">
          {whyPoints.map((p, i) => (
            <li class="kol-point" style={`--reveal-delay: ${i * 80}ms;`}>
              <span class="kol-point__mark" aria-hidden="true"></span>
              <div>
                <h3>{p.lead}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))}
        </ul>

