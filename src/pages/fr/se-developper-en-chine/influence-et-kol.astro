    citeMeta: "Selling in China: The Rise of Livestreaming E-commerce, 2025",
  },
  {
    image: '/Images/grow-in-china/influencers-kols/why-koc-mentions.png',
    alt: "Un écran de téléphone affiche une grille de publications de petits créateurs autour d'une catégorie de produits, scène de recherche en environnement domestique",
    quote: "Sur l'ensemble du marché asiatique, la dépense en influence ne pèse que 0,75 % du GMV social commerce, contre 6,8 % aux États-Unis.",
    cite: "Totem et Rakuten Insight",
    citeMeta: "Influencer Marketing in Asia, 2025",
  },
];

const howSteps = [
  {
    icon: 'compass',
    title: "Identifier les bons profils",
    body: "Tout part de votre objectif et de votre marge, jamais d'une liste de noms. Vient ensuite la donnée : qui regarde, et plus important encore, qui achète après avoir regardé. Notre base interne de KOC, déjà éprouvée sur le terrain, prend le relais.",
  },
  {
    icon: 'pen',
    title: "Bâtir un brief qui passe la rampe",
    body: "Le brief décide de tout. Avec vous, nous arrêtons le message et les éléments non négociables, puis nous remettons l'exécution entre les mains du créateur. Les contenus qui sentent le script restent précisément ceux que personne ne regarde.",
  },
  {
    icon: 'gear',
    title: "Piloter de bout en bout",
    body: "Contrats, contenus, calendrier de publication, coordination des livestreams. Vous validez le cadre. Nous redéployons le budget dès qu'un levier marque le pas, sans attendre le post-mortem trois semaines plus tard.",
  },
  {
    icon: 'link',
    title: "Relier le contenu au commerce",
    body: "Une publication sans bouton d'achat reste à mi-parcours. Nous branchons le contenu directement sur votre boutique Douyin, Tmall ou JD, et nous traçons chaque vente jusqu'au créateur qui l'a déclenchée. Sur Xiaohongshu, la conversion se referme souvent sur une autre plateforme : nous la suivons d'un écosystème à l'autre.",
