const platforms = [
  {
    name: "Xiaohongshu",
    cn: '小红书',
    desc: "La recherche et l'achat partagent le même fil. Une note bien notée ramène l'acheteur jusqu'à votre boutique. Notre base interne de KOC et de KOL y vit au quotidien.",
