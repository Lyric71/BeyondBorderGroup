---
import Layout from '../../../layouts/Layout.astro';
import kolsData from '../../../data/kols.json';
import kolsFr from '../../../data/kols-fr.json';

type Tier = 'top' | 'mid' | 'rising';
interface KOL {
  id: string;
  rank: number;
  name_zh: string;
  name_en: string;
  tier: Tier;
  tier_label: string;
  platforms: string[];
  primary_platform: string | null;
  primary_platform_label: string;
  followers_text: string;
  specialty: string;
  profile_url: string;
  notable_brands: string[];
  source_note: string;
  avatar_initials: string;
}
interface Industry {
  id: string;
  name_en: string;
  name_zh: string;
  tagline: string;
  color: string;
  kols: KOL[];
}
interface KolsRoot {
  meta: {
    title: string;
    subtitle: string;
    prepared_for: string;
    tier_definitions: { top: string; mid: string; rising: string };
    platforms_covered: string[];
    sources: string[];
    follower_data_note: string;
    healthcare_note: string;
  };
  industries: Industry[];
}
interface KolsFr {
  meta: {
    healthcare_note: string;
    follower_data_note: string;
    tier_definitions: { top: string; mid: string; rising: string };
  };
  industries: Record<string, { name: string; tagline: string }>;
  tier_label: Record<string, string>;
  kols: Record<string, string>;
}

const kolsRoot = kolsData as unknown as KolsRoot;
const kolsFrData = kolsFr as unknown as KolsFr;

const tierMetaFr: Record<Tier, { short: string; sr: string }> = {
  top:    { short: "Top, 1M+",                  sr: "Palier : Top, un million d'abonnés ou plus" },
  mid:    { short: "Intermédiaire, 100K à 1M",  sr: "Palier : Intermédiaire, entre cent mille et un million d'abonnés" },
  rising: { short: "En ascension, vers 1M",     sr: "Palier : En ascension, au seuil du million d'abonnés" },
};

const localiseTierLabel = (label: string) => kolsFrData.tier_label[label] || label;
const specialtyFr = (id: string, fallback: string) => kolsFrData.kols[id] || fallback;
const industryFr = (id: string) =>
  kolsFrData.industries[id] || { name: id, tagline: '' };

const directoryItemListJsonLdFr = (industry: Industry) => {
  const fr = industryFr(industry.id);
  return {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `KOL ${fr.name} en Chine`,
    itemListElement: industry.kols.map((k, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Person',
        name: k.name_zh,
        alternateName: k.name_en,
        url: k.profile_url,
        knowsAbout: specialtyFr(k.id, k.specialty),
      },
    })),
  };
};

const heroStats = [
  { num: '10 000', suffix: '+', label: "créateurs référencés dans notre propre base KOC" },
  { num: '7', suffix: '', label: "plateformes pilotées de bout en bout" },
  { num: "Une équipe", suffix: '', label: "du casting au reporting, sans relais externe" },
];

const whyPoints = [
  {
    lead: "Le tunnel d'achat tient sur un écran, plus sur cinq étapes.",
    body: "L'acheteur chinois ne ferme jamais l'application pour décider. Il fait défiler, il cherche, il regarde un livestream, il achète, sans changer de fenêtre. Ramener le créateur au rang de simple panneau publicitaire, c'est consommer son budget avant même la première publication.",
  },
  {
    lead: "Les ordres de grandeur dépassent les repères occidentaux.",
