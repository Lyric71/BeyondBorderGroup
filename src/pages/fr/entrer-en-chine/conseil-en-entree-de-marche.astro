<Layout
  title="Conseil en entrée de marché Chine | Cross-Border eCommerce | Beyond Border Group"
  description="Conseil en entrée de marché pour les marques qui vont en Chine. Faisabilité Cross-Border eCommerce, stratégie de canal, plongée concurrents, modélisation financière, sourcing de distributeurs."
>
  <div class="mec-progress" aria-hidden="true"><div class="mec-progress__bar"></div></div>
  <article class="mec">

    {/* ---------- HERO (dark, parallax) ---------- */}
    <section class="mec-hero" data-hero>
      <div class="mec-hero__bg" aria-hidden="true" data-parallax>
