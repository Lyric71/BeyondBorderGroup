      100% { top: 100%; }
    }
    @media (max-width: 720px) {
      .bl-hero__scroll { display: none; }
      .bl-hero__meta { gap: var(--space-4); }
    }

    /* ---------- THREE THINGS ---------- */
    .bl-pillars {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
    .bl-pillar {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
    }
    .bl-pillar:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: var(--shadow-md);
    }
    .bl-pillar__media {
      margin: 0;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: var(--bbg-surface);
    }
    .bl-pillar__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 600ms var(--ease);
    }
    .bl-pillar:hover .bl-pillar__media img { transform: scale(1.04); }
    .bl-pillar__body { padding: var(--space-5) var(--space-6) var(--space-6); }
    .bl-pillar__body h3 {
      font-size: clamp(1.125rem, 0.5vw + 0.9rem, 1.375rem);
      line-height: 1.25;
      margin: 0 0 var(--space-3);
      letter-spacing: -0.005em;
      color: var(--bbg-ink);
    }
    .bl-pillar__body p {
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
      margin: 0;
    }
    @media (max-width: 1024px) {
      .bl-pillars { grid-template-columns: 1fr; }
    }

    /* ---------- VALUE + PROMISES ---------- */
    .bl-value {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
    .bl-value__copy h2 {
      font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
      line-height: 1.15;
      letter-spacing: -0.015em;
      margin: var(--space-3) 0 var(--space-4);
    }
    .bl-value__copy p {
      color: var(--bbg-text);
      line-height: 1.7;
      font-size: 1.0625rem;
      margin: 0 0 var(--space-4);
    }
    .bl-promise {
      list-style: none;
      padding: var(--space-6);
      margin: 0;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }
    .bl-promise > li:first-child .eyebrow { margin-bottom: 0; }
    .bl-promise__item {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: var(--space-4);
      align-items: start;
    }
    .bl-promise__check {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .bl-promise__check svg { width: 16px; height: 16px; }
    .bl-promise__item h4 {
      font-size: 1.125rem;
      margin: 0 0 var(--space-2);
      letter-spacing: -0.005em;
      color: var(--bbg-ink);
    }
    .bl-promise__item p {
      font-size: 0.975rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .bl-value { grid-template-columns: 1fr; gap: var(--space-6); }
    }

    /* ---------- SERVICES BENTO ---------- */
    .bl-svc-section .section-header--split { align-items: end; gap: var(--space-6); margin-bottom: var(--space-6); }
    .bl-svc-lead {
      max-width: 44ch;
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .bl-svc-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
    .bl-svc-card {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 20px;
      padding: var(--space-6);
      overflow: hidden;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      min-height: 320px;
      transition:
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .bl-svc-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, var(--svc-color, #269ADA) 0%, var(--svc-color, #269ADA) 50%, transparent 100%);
      transform: scaleX(0.3);
      transform-origin: left center;
      transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1;
    }
    .bl-svc-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(140% 90% at 100% 0%,
        color-mix(in srgb, var(--svc-color, #269ADA) 14%, transparent) 0%,
        transparent 55%);
      opacity: 0;
      transition: opacity 360ms ease;
      z-index: -1;
      pointer-events: none;
    }
    .bl-svc-card:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--svc-color, #269ADA) 55%, var(--bbg-border));
      box-shadow: 0 22px 50px -26px color-mix(in srgb, var(--svc-color, #269ADA) 50%, transparent),
                  0 6px 14px -8px rgba(0, 0, 0, 0.08);
    }
    .bl-svc-card:hover::before { transform: scaleX(1); }
    .bl-svc-card:hover::after { opacity: 1; }
    .bl-svc-card:hover .bl-svc-card__icon {
      transform: scale(1.06) rotate(-4deg);
      background: var(--svc-color, var(--bbg-blue));
      color: var(--bbg-white);
      box-shadow: 0 12px 24px -14px color-mix(in srgb, var(--svc-color, #269ADA) 70%, transparent),
                  inset 0 0 0 1px color-mix(in srgb, var(--svc-color, #269ADA) 30%, transparent);
    }
    .bl-svc-card:hover .bl-svc-card__arrow { transform: translateX(4px); color: var(--svc-color, var(--bbg-blue)); }
    .bl-svc-card__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }
    .bl-svc-card__icon {
      display: inline-flex;
      width: 56px;
      height: 56px;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      background: var(--svc-soft, var(--bbg-blue-light));
      color: var(--svc-color, var(--bbg-blue));
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--svc-color, #269ADA) 18%, transparent);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
                  background 320ms ease, color 320ms ease, box-shadow 320ms ease;
      flex-shrink: 0;
    }
    .bl-svc-card__icon svg { width: 28px; height: 28px; }
    .bl-svc-card__short {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--svc-color, var(--bbg-blue));
      text-align: right;
      line-height: 1.4;
    }
    .bl-svc-card__title {
      font-size: 1.5rem;
      line-height: 1.18;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-ink);
    }
    .bl-svc-card__desc {
      font-size: 0.975rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .bl-svc-card__points {
      list-style: none;
      padding: var(--space-4) 0 0;
      margin: 0;
      border-top: 1px solid var(--bbg-border);
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      margin-top: auto;
    }
    .bl-svc-card__points li {
      display: grid;
      grid-template-columns: 14px 1fr;
      gap: 0.6rem;
      align-items: center;
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--bbg-text);
    }
    .bl-svc-card__bullet {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--svc-color, var(--bbg-blue));
      box-shadow: 0 0 0 3px var(--svc-soft, var(--bbg-blue-light));
      margin-left: 4px;
    }
    .bl-svc-card__arrow {
      position: absolute;
      bottom: var(--space-6);
      right: var(--space-6);
      color: var(--bbg-text-muted);
      transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1), color 200ms ease;
      pointer-events: none;
    }
    .bl-svc-card__arrow svg { width: 22px; height: 22px; }
    @media (max-width: 720px) {
      .bl-svc-grid { grid-template-columns: 1fr; }
      .bl-svc-card { min-height: 0; }
      .bl-svc-section .section-header--split { flex-direction: column; align-items: flex-start; }
    }

    /* ---------- STARTING POINTS TABS ---------- */
    .bl-tabs {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 16px 48px -28px rgba(8, 18, 28, 0.18);
    }
    .bl-tabs__nav {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      background: linear-gradient(180deg, var(--bbg-surface) 0%, var(--bbg-white) 100%);
      border-bottom: 1px solid var(--bbg-border);
    }
    .bl-tabs__tab {
      position: relative;
      background: transparent;
      border: none;
      padding: var(--space-5) var(--space-4);
      text-align: left;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      color: var(--bbg-text-muted);
      transition: color 240ms ease, background 240ms ease;
      border-right: 1px solid var(--bbg-border);
      font-family: inherit;
    }
    .bl-tabs__tab:last-child { border-right: none; }
    .bl-tabs__tab:hover { color: var(--bbg-ink); background: rgba(38, 154, 218, 0.04); }
    .bl-tabs__tab.is-active { color: var(--bbg-ink); background: var(--bbg-white); }
    .bl-tabs__tab-label {
      font-size: 1.0625rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      line-height: 1.2;
    }
    .bl-tabs__tab-tag {
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      line-height: 1.35;
    }
    .bl-tabs__tab.is-active .bl-tabs__tab-tag { color: var(--bbg-blue); }
    .bl-tabs__tab-pop {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .bl-tabs__indicator {
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 25%;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      border-radius: 2px 2px 0 0;
      transform: translateX(0);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }
    .bl-tabs__panels { background: var(--bbg-white); }
    .bl-tabs__panel {
      padding: clamp(var(--space-5), 4vw + 1rem, var(--space-7));
      animation: bl-tab-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes bl-tab-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .bl-tabs__panel[hidden] { display: none; }
    .bl-tabs__panel-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .bl-tabs__lead { display: flex; flex-direction: column; gap: var(--space-4); }
    .bl-tabs__pillset { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .bl-tabs__pill {
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.35em 0.85em;
      border-radius: 999px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      letter-spacing: 0.01em;
    }
    .bl-tabs__title {
      font-size: clamp(1.625rem, 1.8vw + 1rem, 2.25rem);
      line-height: 1.1;
      margin: 0;
      letter-spacing: -0.015em;
    }
    .bl-tabs__desc {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .bl-tabs__when {
      padding: var(--space-4);
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--bbg-blue);
    }
    .bl-tabs__when-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.35rem;
    }
    .bl-tabs__when p { margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--bbg-text); }
    .bl-tabs__body {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .bl-tabs__list-wrap {
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .bl-tabs__list-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .bl-tabs__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .bl-tabs__list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--bbg-text);
    }
    .bl-tabs__check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .bl-tabs__check svg { width: 12px; height: 12px; }
    .bl-tabs__pricing {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      padding: var(--space-4);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(38, 154, 218, 0.12) 100%);
      border-radius: var(--radius-md);
      border: 1px solid rgba(38, 154, 218, 0.2);
    }
    .bl-tabs__pricing-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue-dark);
      flex-shrink: 0;
    }
    .bl-tabs__pricing-value {
      font-size: 1rem;
      font-weight: 600;
      color: var(--bbg-ink);
      line-height: 1.4;
    }
    @media (max-width: 1024px) {
      .bl-tabs__nav { grid-template-columns: repeat(2, 1fr); }
      .bl-tabs__tab { border-bottom: 1px solid var(--bbg-border); }
      .bl-tabs__tab:nth-child(2) { border-right: none; }
      .bl-tabs__indicator { display: none; }
      .bl-tabs__panel-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 560px) {
      .bl-tabs__nav { grid-template-columns: 1fr; }
      .bl-tabs__tab { border-right: none; }
    }

    /* ---------- CASES CTA ---------- */
    .bl-cases-cta { display: flex; justify-content: center; }

    /* ---------- CONTENT PRODUCTION (TheRedScroll editorial) ---------- */
    .bl-trs-section { position: relative; isolation: isolate; overflow: hidden; }
    .bl-trs {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(var(--space-6), 4vw, var(--space-8));
      align-items: center;
    }
    .bl-trs__text { max-width: 60ch; }
    .bl-trs__text .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: var(--space-3);
    }
    .bl-trs__bar {
      display: inline-block;
      width: 28px;
      height: 2px;
      background: var(--bbg-blue);
      border-radius: 2px;
    }
    .bl-trs__title {
      font-size: clamp(2rem, 2.6vw + 1rem, 3rem);
      line-height: 1.1;
      letter-spacing: -0.018em;
      margin: 0 0 var(--space-4);
      color: var(--bbg-ink);
    }
    .bl-trs__title-emph {
      display: block;
      color: var(--bbg-blue);
      font-style: italic;
      font-weight: 500;
    }
    .bl-trs__lead {
      font-size: 1.0625rem;
      line-height: 1.7;
      color: var(--bbg-text);
      margin: 0 0 var(--space-4);
    }
    .bl-trs__list {
      list-style: none;
      padding: var(--space-4) 0 0;
      margin: 0 0 var(--space-5);
      border-top: 1px solid var(--bbg-border);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .bl-trs__list li {
      display: grid;
      grid-template-columns: 22px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 1rem;
      line-height: 1.5;
      color: var(--bbg-text);
    }
    .bl-trs__list svg {
      width: 20px;
      height: 20px;
      color: var(--bbg-blue);
      margin-top: 2px;
    }
    .bl-trs__actions {
      display: flex;
      align-items: center;
      gap: var(--space-5);
      flex-wrap: wrap;
    }
    .bl-trs__cta {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.85em 1.4em;
      background: var(--bbg-ink);
      color: var(--bbg-white);
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.95rem;
      letter-spacing: 0.01em;
      transition: background 200ms ease, transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .bl-trs__cta:hover {
      background: var(--bbg-blue);
      color: var(--bbg-white);
      transform: translateY(-2px);
    }
    .bl-trs__cta svg { width: 18px; height: 18px; }
    .bl-trs__cta:hover svg { transform: translateX(2px); transition: transform 200ms ease; }
    .bl-trs__meta {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
    }

    .bl-trs__aside {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }
    .bl-trs__frame {
      display: block;
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      box-shadow: 0 24px 60px -28px rgba(8, 18, 28, 0.28),
                  0 6px 18px -10px rgba(8, 18, 28, 0.12);
      transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 320ms ease,
                  border-color 240ms ease;
    }
    .bl-trs__frame:hover {
      transform: translateY(-4px);
      border-color: rgba(38, 154, 218, 0.4);
      box-shadow: 0 32px 70px -28px rgba(38, 154, 218, 0.32),
                  0 8px 22px -10px rgba(8, 18, 28, 0.14);
    }
    .bl-trs__chrome {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.55rem 0.8rem;
      background: linear-gradient(180deg, #F2F4F7 0%, #E9ECF1 100%);
      border-bottom: 1px solid var(--bbg-border);
    }
    .bl-trs__dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #D6D9DE;
    }
    .bl-trs__dot:nth-child(1) { background: #FF5F57; }
    .bl-trs__dot:nth-child(2) { background: #FEBC2E; }
    .bl-trs__dot:nth-child(3) { background: #28C840; }
    .bl-trs__url {
      margin-left: auto;
      margin-right: auto;
      font-size: 0.72rem;
      font-weight: 500;
      color: var(--bbg-text-muted);
      letter-spacing: 0.01em;
      padding: 0.1em 0.7em;
      background: var(--bbg-white);
      border-radius: 999px;
      border: 1px solid rgba(0,0,0,0.04);
      transform: translateX(-1.5rem);
    }
    .bl-trs__frame img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      object-position: top center;
      background: var(--bbg-surface);
    }

    .bl-trs__rule {
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, var(--bbg-border) 30%, var(--bbg-border) 70%, transparent 100%);
    }
    .bl-trs__stat { display: flex; flex-direction: column; gap: 0.35rem; }
    .bl-trs__stat-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
    }
    .bl-trs__stat-value {
      display: inline-flex;
      align-items: baseline;
      gap: 0.15rem;
      color: var(--bbg-blue);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .bl-trs__stat-num {
      font-size: clamp(2.5rem, 2.4vw + 1rem, 3.25rem);
      font-feature-settings: "tnum";
    }
    .bl-trs__stat-unit {
      font-size: clamp(1.5rem, 1.4vw + 0.6rem, 2rem);
      font-weight: 600;
    }
    .bl-trs__stat-note {
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
      max-width: 38ch;
    }

    @media (max-width: 1024px) {
      .bl-trs { grid-template-columns: 1fr; }
      .bl-trs__aside { order: -1; }
    }
    @media (max-width: 540px) {
      .bl-trs__url { transform: none; margin: 0 auto; }
    }

    /* ---------- JOURNEY ---------- */
    .bl-journey-section { position: relative; isolation: isolate; overflow: hidden; }
    .bl-journey {
      position: relative;
      max-width: 880px;
      margin: 0 auto;
      padding-left: 56px;
    }
    .bl-journey__rail {
      position: absolute;
      top: 0; bottom: 0;
      left: 22px;
      width: 2px;
    }
    .bl-journey__rail-track {
      position: absolute; inset: 0;
      background: var(--bbg-border);
      border-radius: 2px;
    }
    .bl-journey__rail-fill {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: var(--journey-progress, 0%);
      background: linear-gradient(180deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      border-radius: 2px;
      transition: height 120ms linear;
      box-shadow: 0 0 8px rgba(38, 154, 218, 0.4);
    }
    .bl-journey__list {
      list-style: none;
      padding: 0; margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }
    .bl-journey__item { position: relative; }
    .bl-journey__dot {
      position: absolute;
      left: -56px;
      top: 0;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--bbg-white);
      border: 2px solid var(--bbg-border);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      transition: border-color 320ms ease;
    }
    .bl-journey__dot-inner {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--bbg-border);
      transition: background 320ms ease, transform 320ms ease;
    }
    .bl-journey__item.is-active .bl-journey__dot { border-color: var(--bbg-blue); }
    .bl-journey__item.is-active .bl-journey__dot-inner {
      background: var(--bbg-blue);
      transform: scale(1.1);
      box-shadow: 0 0 0 4px var(--bbg-blue-light);
    }
    .bl-journey__phase {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-2);
      transition: color 320ms ease;
    }
    .bl-journey__item.is-active .bl-journey__phase { color: var(--bbg-blue); }
    .bl-journey__card {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5) var(--space-6);
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      transition: border-color 320ms ease, box-shadow 320ms ease, transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .bl-journey__item:hover .bl-journey__card,
    .bl-journey__item.is-active .bl-journey__card {
      border-color: var(--bbg-blue);
      box-shadow: 0 18px 38px -22px rgba(38, 154, 218, 0.4);
      transform: translateX(4px);
    }
    .bl-journey__icon {
      display: inline-flex;
      width: 48px;
      height: 48px;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      flex-shrink: 0;
    }
    .bl-journey__icon svg { width: 24px; height: 24px; }
    .bl-journey__title {
      font-size: 1.25rem;
      line-height: 1.25;
      margin: 0 0 0.4rem;
      letter-spacing: -0.005em;
    }
    .bl-journey__desc {
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 600px) {
      .bl-journey { padding-left: 40px; }
      .bl-journey__rail { left: 16px; }
      .bl-journey__dot { left: -40px; width: 32px; height: 32px; }
      .bl-journey__dot-inner { width: 10px; height: 10px; }
      .bl-journey__card { flex-direction: column; gap: var(--space-3); }
    }

    /* ---------- FAQ FILTER ---------- */
    .bl-faq-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-bottom: var(--space-6);
    }
    .bl-faq-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.95rem;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 999px;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--bbg-text);
      transition: all 220ms ease;
      font-family: inherit;
    }
    .bl-faq-chip:hover { border-color: var(--bbg-blue); color: var(--bbg-blue); }
    .bl-faq-chip.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }
    .bl-faq-chip__count {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.15em 0.5em;
      border-radius: 999px;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition: all 220ms ease;
    }
    .bl-faq-chip:hover .bl-faq-chip__count { background: var(--bbg-blue-light); color: var(--bbg-blue); }
    .bl-faq-chip.is-active .bl-faq-chip__count {
      background: rgba(255, 255, 255, 0.2);
      color: var(--bbg-white);
    }

    .bl-faq {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .bl-faq__item {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition: border-color 240ms ease, box-shadow 240ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .bl-faq__item:hover {
      transform: translateX(2px);
      border-color: rgba(38, 154, 218, 0.4);
    }
    .bl-faq__item[open] {
      border-color: var(--bbg-blue);
      box-shadow: 0 8px 22px -14px rgba(38, 154, 218, 0.4);
    }
    .bl-faq__q {
      cursor: pointer;
      padding: var(--space-5);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      font-weight: 600;
      font-size: 1.0625rem;
      line-height: 1.3;
      color: var(--bbg-ink);
      list-style: none;
      transition: color var(--dur) var(--ease);
    }
    .bl-faq__q::-webkit-details-marker { display: none; }
    .bl-faq__q::marker { display: none; }
    .bl-faq__item:hover .bl-faq__q { color: var(--bbg-blue); }
    .bl-faq__cat-tag {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 0.25em 0.6em;
      border-radius: 4px;
      margin-right: var(--space-3);
      flex-shrink: 0;
    }
    .bl-faq__q-text { flex-grow: 1; }
    .bl-faq__icon {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
                  color var(--dur) var(--ease),
                  background var(--dur) var(--ease);
    }
    .bl-faq__item[open] .bl-faq__icon {
      transform: rotate(180deg);
      color: var(--bbg-white);
      background: var(--bbg-blue);
    }
    .bl-faq__a {
      padding: 0 var(--space-5) var(--space-5);
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
      animation: bl-faq-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes bl-faq-in {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .bl-faq__a p { margin: 0; }
    .bl-faq__item.is-hidden { display: none; }

    /* ---------- FINAL CTA ---------- */
    .bl-cta {
      padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8)) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
      color: var(--bbg-white);
      border-radius: var(--radius-lg);
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .bl-cta::before {
      content: "";
      position: absolute;
      top: -40%;
      right: -10%;
      width: 420px;
      height: 420px;
      background: radial-gradient(circle at center, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 65%);
      pointer-events: none;
    }
    .bl-cta .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-4);
      color: rgba(255, 255, 255, 0.9);
    }
    .bl-cta__title {
      font-size: clamp(1.75rem, 1.5vw + 1rem, 2.5rem);
      line-height: 1.15;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      letter-spacing: -0.015em;
    }
    .bl-cta__lead {
      color: rgba(255, 255, 255, 0.92);
      font-size: 1.0625rem;
      max-width: 52ch;
      margin: 0 auto var(--space-5);
      line-height: 1.55;
    }
    .bl-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      justify-content: center;
      position: relative;
    }
    .bl-cta__btn-primary {
      background: var(--bbg-white);
      color: var(--bbg-blue-dark);
      border: 1px solid var(--bbg-white);
    }
    .bl-cta__btn-primary:hover {
      background: rgba(255, 255, 255, 0.92);
      color: var(--bbg-blue-dark);
    }
    .bl-cta__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: var(--bbg-white);
    }
    .bl-cta__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }
  </style>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Reveal-on-scroll
      const revealEls = document.querySelectorAll('.bl-reveal');
      if (revealEls.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          revealEls.forEach((el) => io.observe(el));
        }
      }

      // 2. Animated number counters
      const counters = document.querySelectorAll('[data-counter]');
      if (counters.length && !reduced && 'IntersectionObserver' in window) {
        const animate = (el) => {
          const target = parseFloat(el.dataset.counter || '0');
          const suffix = el.dataset.suffix || '';
          const duration = 1400;
          const start = performance.now();
          const tick = (now) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = Math.round(target * eased);
            el.textContent = value + suffix;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const counterIo = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animate(entry.target);
              counterIo.unobserve(entry.target);
            }
          });
        }, { threshold: 0.5 });
        counters.forEach((el) => counterIo.observe(el));
      } else {
        counters.forEach((el) => {
          el.textContent = (el.dataset.counter || '0') + (el.dataset.suffix || '');
        });
      }

      // 3. Hero parallax + scroll progress bar
      const parallaxEl = document.querySelector('[data-parallax]');
      const progressEl = document.querySelector('.bl-progress__bar');
      const heroEl = document.querySelector('[data-hero]');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;
          if (parallaxEl && heroEl && !reduced) {
            const heroH = heroEl.offsetHeight;
            if (scrollY < heroH) {
              parallaxEl.style.setProperty('--parallax-y', (scrollY * 0.18) + 'px');
            }
          }
          if (progressEl) {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
            progressEl.style.setProperty('--progress', pct + '%');
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // 4. Smooth scroll for in-page anchors
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = link.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        });
      });

      // 5. Accordion behaviour for FAQ
      const faqItems = document.querySelectorAll('.bl-faq__item');
      faqItems.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (item.open) {
            faqItems.forEach((other) => {
              if (other !== item && other.open) other.open = false;
            });
          }
        });
      });

      // 6. Starting-point tabs
      const tabsRoot = document.querySelector('[data-tabs]');
      if (tabsRoot) {
        const tabs = Array.from(tabsRoot.querySelectorAll('.bl-tabs__tab'));
        const panels = Array.from(tabsRoot.querySelectorAll('.bl-tabs__panel'));
        const indicator = tabsRoot.querySelector('.bl-tabs__indicator');
        const setActive = (tab) => {
          tabs.forEach((t) => {
            const active = t === tab;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          const targetId = tab.getAttribute('data-tab-target');
          panels.forEach((p) => {
            const active = p.id === targetId;
            p.classList.toggle('is-active', active);
            if (active) p.removeAttribute('hidden');
            else p.setAttribute('hidden', '');
          });
          if (indicator) {
            const idx = tabs.indexOf(tab);
            const w = 100 / tabs.length;
            indicator.style.width = w + '%';
            indicator.style.transform = `translateX(${idx * 100}%)`;
          }
        };
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => setActive(tab));
          tab.addEventListener('keydown', (e) => {
            const idx = tabs.indexOf(tab);
            if (e.key === 'ArrowRight') {
              e.preventDefault();
              const next = tabs[(idx + 1) % tabs.length];
              next.focus();
              setActive(next);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
              prev.focus();
              setActive(prev);
            }
          });
        });
        const initialActive = tabs.find((t) => t.classList.contains('is-active')) || tabs[0];
        if (initialActive) setActive(initialActive);
      }

      // 7. Journey vertical timeline
      const journey = document.querySelector('[data-journey]');
      if (journey) {
        const fill = journey.querySelector('[data-journey-fill]');
        const items = Array.from(journey.querySelectorAll('[data-journey-item]'));
        const updateJourney = () => {
          const rect = journey.getBoundingClientRect();
          const vh = window.innerHeight;
          const total = rect.height;
          const visible = Math.max(0, Math.min(total, vh * 0.55 - rect.top));
          const pct = Math.max(0, Math.min(100, (visible / total) * 100));
          if (fill) fill.style.setProperty('--journey-progress', pct + '%');
          items.forEach((item) => {
            const r = item.getBoundingClientRect();
            const center = r.top + r.height / 2;
            const inActive = center < vh * 0.6 && center > 0;
            item.classList.toggle('is-active', inActive);
          });
        };
        let journeyTicking = false;
        const onJourneyScroll = () => {
          if (journeyTicking) return;
          journeyTicking = true;
          requestAnimationFrame(() => {
            updateJourney();
            journeyTicking = false;
          });
        };
        window.addEventListener('scroll', onJourneyScroll, { passive: true });
        window.addEventListener('resize', onJourneyScroll, { passive: true });
        updateJourney();
      }

      // 8. FAQ category filter
      const faqFilter = document.querySelector('[data-faq-filter]');
      const faqList = document.querySelector('[data-faq-list]');
      if (faqFilter && faqList) {
        const chips = Array.from(faqFilter.querySelectorAll('.bl-faq-chip'));
        const items = Array.from(faqList.querySelectorAll('.bl-faq__item'));
        chips.forEach((chip) => {
          chip.addEventListener('click', () => {
            const cat = chip.dataset.faqCat;
            chips.forEach((c) => {
              const on = c === chip;
              c.classList.toggle('is-active', on);
              c.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            items.forEach((item) => {
              const matches = cat === 'All' || item.dataset.faqCat === cat;
              item.classList.toggle('is-hidden', !matches);
            });
          });
        });
      }
    })();
  </script>
</Layout>
