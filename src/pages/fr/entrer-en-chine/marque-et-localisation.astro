---
import Layout from '../../../layouts/Layout.astro';

const pillars = [
  {
    h: 'Comprendre le consommateur chinois',
    body:
      "Les consommateurs chinois ne forment pas un seul public. Les goûts changent selon la ville, l'âge, la plateforme. On étudie ces nuances d'abord, et on construit la marque par-dessus.",
    image: '/Images/branding/positioning.png',
    alt: "Documents de recherche, planification et insights consommateurs pour une marque en Chine",
  },
  {
    h: 'Trouver le bon nom chinois',
    body:
      "La plupart des consommateurs chinois ne lisent pas les langues étrangères. Un bon nom se prononce sans effort et porte un sens favorable. Un mauvais nom plafonne la croissance, pour toujours.",
    image: '/Images/branding/naming.png',
    alt: "Recherche de naming chinois, caractères et notes de travail",
  },
  {
    h: 'Transcréer plutôt que traduire',
    body:
      "Adapter une marque en Chine va bien au-delà du langage. Le récit, l'image, l'expérience, tout doit coller au goût local. Le résultat paraît natif, jamais importé.",
    image: '/Images/branding/visual-identity.png',
    alt: "Planches d'identité visuelle adaptées aux plateformes et au packaging chinois",
  },
];

const promises = [
  {
    title: "Une recherche qui façonne la marque",
    desc: "Données catégorie, études consommateurs et réalité des plateformes nourrissent la stratégie. Rien sur la page n'est laissé au hasard.",
  },
  {
    title: "Un nom chinois que les acheteurs sauront dire",
    desc: "Listes courtes phonétiques, sémantiques et culturelles, vérifiées au registre des marques et testées auprès de votre cible avant que le reste avance.",
  },
  {
    title: "Des supports prêts pour chaque point de contact",
    desc: "Packaging, photo, vidéo, social et retail. Conçus en Chine pour Tmall, Douyin, RED, le retail et la PR, pas adaptés à la dernière minute.",
  },
];

const services = [
  {
    icon: 'target',
    title: 'Positionnement',
    short: 'Stratégie · Territoire · Discours',
    desc: "On cartographie votre catégorie en Chine, on identifie le terrain laissé libre par vos concurrents, et on positionne votre marque pour l'occuper. La décision qui conditionne toutes les autres.",
    points: [
      "Cartographie concurrentielle dans votre catégorie",
      "Analyse des espaces et segments à prendre",
      "Un positionnement clair, pensé pour la Chine",
      "Une architecture de messages utilisable par vos équipes au quotidien",
    ],
    color: '#269ADA',
    colorSoft: '#E8F4FC',
  },
  {
    icon: 'character',
    title: 'Naming',
    short: 'Phonétique · Sémantique · Marque déposée',
    desc: "Le bon nom chinois ouvre la reconnaissance, la mémorisation et le bouche-à-oreille. Le mauvais crée des frictions à chaque fois qu'un consommateur tente de le prononcer. On compose des noms qui tiennent sur le plan linguistique, culturel et commercial.",
    points: [
      "Listes courtes phonétiques, sémantiques et culturelles",
      "Vérification de disponibilité au registre des marques, par catégorie",
      "Tests consommateurs dans les villes de votre cible",
      "Un nom final qui voyage du packaging à la recherche, jusqu'à la voix",
    ],
    color: '#E54B6E',
    colorSoft: '#FCEAEF',
  },
  {
    icon: 'palette',
    title: 'Identité visuelle',
    short: 'Logo · Couleur · Typographie · Mise en page',
    desc: "Logo, couleur, typographie, mise en page. On construit une identité visuelle cohérente pour la Chine et on la documente dans une charte que vos équipes et partenaires appliquent partout, sans interpréter.",
    points: [
      "Système de logo pensé pour les plateformes et le packaging chinois",
      "Palettes couleur et typographiques adaptées au contexte local",
      "Charte de marque et standards de design pour partenaires et agences",
      "Templates social, eCommerce et offline",
    ],
    color: '#7C5DFA',
    colorSoft: '#F0EDFE',
  },
  {
    icon: 'cube',
    title: 'Supports de marque',
    short: 'Packaging · Photo · Vidéo · Espace',
    desc: "Packaging, vidéo, photographie, design d'espace. Les supports dont votre marque a besoin pour exister en Chine, conçus en Chine pour le marché chinois, prêts pour Tmall, Douyin, RED, le retail et la PR.",
    points: [
      "Packaging adapté au retail et à l'eCommerce chinois",
      "Photo et vidéo de marque tournées en Chine",
      "Design de stand, pop-up et points de vente",
      "Kits créatifs prêts pour le social et les KOL",
    ],
    color: '#0EA46C',
    colorSoft: '#E6F5EE',
  },
];

const starts = [
  {
    name: 'Nouveau lancement',
    tag: "Aucune présence en Chine pour l'instant",
    desc: "Vous entrez en Chine pour la première fois. La marque a du capital ailleurs, mais aucun nom chinois, aucun support local, aucune notoriété sur le terrain.",
    when: "Vous avez un produit défini, un budget arrêté et 6 à 12 mois devant vous avant le lancement. On construit la marque depuis la stratégie, taillée pour la Chine dès le premier jour.",
    bullets: [
      "Études catégorie et consommateurs dans vos villes cibles",
      "Positionnement et messages écrits pour le marché chinois",
      "Liste courte de noms chinois, marque vérifiée et testée consommateurs",
      "Identité visuelle complète et charte de marque, prête pour la Chine au lancement",
      "Kit de supports pour packaging, social, Tmall, Douyin et RED",
    ],
    pricing: "Forfait projet, calibré par catégorie et nombre de SKU.",
    highlight: false,
  },
  {
    name: 'Refonte',
    tag: 'Vous êtes déjà sur le marché',
    desc: "Vous êtes en Chine depuis des années. La marque a ses acheteurs, sa distribution et un nom chinois qui fonctionne. Le système visuel a vieilli, les supports ne collent plus aux plateformes.",
    when: "Vous voulez accélérer sur Douyin et RED, votre packaging fait dépassé à côté des concurrents locaux, ou votre boutique Tmall ne reflète plus ce que vous êtes. On met l'identité à jour sans casser l'équité acquise.",
    bullets: [
      "Audit de la marque actuelle face à votre catégorie en Chine aujourd'hui",
      "Système visuel rafraîchi, aligné avec la marque globale",
      "Packaging et supports de boutique remis aux standards des plateformes",
      "Charte et templates rafraîchis pour les équipes en marché",
      "Plan de déploiement online et offline",
    ],
    pricing: "Forfait projet, plus léger qu'une refonte totale.",
    highlight: true,
  },
  {
    name: 'Rebranding',
    tag: 'Repartir après un faux pas',
    desc: "Quelque chose s'est cassé. Mauvais nom chinois, mauvaise référence culturelle, lancement timide qui n'a jamais accroché. La marque doit repartir sans perdre les SKU et les partenariats qui tiennent encore.",
    when: "Vous voulez un vrai reset, pas un pansement cosmétique. On reconstruit la marque autour de ce qui survit et on remplace le reste, puis on gère la transition côté partenaires, plateformes et consommateurs.",
    bullets: [
      "Diagnostic des causes profondes du blocage",
      "Nouveau positionnement et nouveau nom chinois si nécessaire, avec recherche d'antériorité",
      "Identité visuelle reconstruite pour effacer les associations héritées",
      "Supports de transition pour que les acheteurs existants suivent la nouvelle marque",
      "Plan de communication pour plateformes, distributeurs et PR",
    ],
    pricing: "Forfait projet, calibré après l'audit.",
    highlight: false,
  },
  {
    name: 'Marque fille',
    tag: 'Nouvelle ligne sous une marque mère',
    desc: "Vous avez déjà une marque qui fonctionne en Chine et vous lancez une nouvelle ligne en dessous. Autre catégorie, autre public, autre prix, même maison-mère.",
    when: "Il vous faut une marque fille qui tient debout seule tout en profitant du capital de la marque mère. On définit l'architecture, on nomme la nouvelle ligne et on produit les supports nécessaires pour qu'elle joue dans la cour.",
    bullets: [
      "Audit d'architecture de marque et stratégie de marque fille",
      "Naming de la nouvelle ligne, en cohérence avec la marque mère",
      "Système visuel qui signale la famille sans la dupliquer",
      "Packaging et supports de lancement pour la nouvelle gamme de SKU",
      "Plan go-to-market avec l'équipe de la marque mère",
    ],
    pricing: "Forfait projet, calibré sur l'ambition de la marque fille.",
    highlight: false,
  },
];

const steps = [
  {
    icon: 'compass',
    title: 'Découvrir',
    desc: "On commence par écouter. Études consommateurs, cartographie de catégorie, démontage concurrentiel et lecture honnête de la place que votre marque occupe en Chine aujourd'hui, comparée à celle qu'elle pourrait prendre.",
  },
  {
    icon: 'hammer',
    title: 'Construire',
    desc: "Positionnement, nom chinois, identité visuelle et charte de marque. Le cœur stratégique de la marque, écrit et dessiné pour le marché chinois, et marque vérifiée au registre avant livraison.",
  },
  {
    icon: 'rocket',
    title: 'Activer',
    desc: "Packaging, photographie, vidéo et kits créatifs prêts pour les plateformes. Tout ce dont vos équipes et partenaires ont besoin pour lancer sur Tmall, Douyin, RED, le retail et la PR d'une seule voix.",
  },
];

const hubPoints = [
  "Produire. Image, vidéo, prise de vue réelle, 3D et motion à grande échelle.",
  "Plateforme. Modèles entraînés sur la marque, sur serveurs GPU dédiés.",
  "Conseiller. Stratégie, transcréation et formation des équipes aux outils IA.",
];

const faqs = [
  {
    cat: 'Strategy',
    q: "Pourquoi localiser la marque, on ne peut pas se contenter de traduire ?",
    a: "La traduction déplace les mots. La localisation déplace la marque. Le consommateur chinois arrive avec ses propres références, ses propres codes visuels et ses propres plateformes. Une marque qui débarque sans ces signaux passe pour étrangère au mauvais sens du terme : polie mais hors-sujet. Le travail consiste à garder ce qui fait votre singularité, et à reconstruire ce qu'il faut pour qu'un acheteur chinois la reconnaisse comme sienne.",
  },
  {
    cat: 'Strategy',
    q: "En quoi la perception d'une marque diffère vraiment en Chine ?",
    a: "Assez pour que vous l'anticipiez dès le premier jour. La preuve sociale pèse plus lourd que la communication descendante. Avis, recommandations de KOL et ce qu'un ami a acheté la semaine passée battent souvent tout ce que vous direz de vous-même. L'héritage compte, l'innovation compte, et la capacité à montrer qu'on comprend la culture locale compte énormément.",
  },
  {
    cat: 'Strategy',
    q: "Marque étrangère ou marque locale, vers quel côté pencher ?",
    a: "Ni l'un ni l'autre, franchement. Les marques étrangères apportent un signal de qualité et de prestige. Les marques locales apportent la fluidité culturelle et le rapport prix-valeur. Les gagnantes empruntent aux deux. Vous gardez l'histoire de qualité et d'héritage, et vous construisez la fluidité culturelle par-dessus, pour que la marque sonne locale même si le logo ne l'est pas.",
  },
  {
    cat: 'Strategy',
    q: "À quoi ressemble une transcréation en pratique ?",
    a: "C'est l'écart entre une traduction littérale et une histoire qu'un acheteur chinois raconterait sur vous. Même vérité de marque, réécrite dans un registre qui parle au public. Nouvelles métaphores. Nouveaux exemples. Parfois un bénéfice principal différent, parce que celui qui marche à Paris n'est pas celui qui gagne à Shanghai. Bien fait, ça ne ressemble pas du tout à une adaptation.",
  },
  {
    cat: 'Naming',
    q: "Qu'est-ce qui fait qu'un nom de marque chinois fonctionne vraiment ?",
    a: "Facile à dire. Facile à retenir. Un sens qui flatte le produit, ou au minimum qui ne lui fait pas honte. Si un consommateur peut lire le nom à voix haute après l'avoir vu une fois, vous avez une chance. Sinon, vous passerez votre vie à vous expliquer.",
  },
  {
    cat: 'Naming',
    q: "Et si mon nom de marque ne se traduit tout simplement pas ?",
    a: "C'est le point de départ normal, pas l'exception. La plupart des noms étrangers sonnent maladroits ou portent un sens fâcheux quand on les force en mandarin. La solution consiste à créer un nom chinois qui vit à côté du nom latin, avec sa propre logique, son propre son, sa propre histoire. Apple a 苹果. BMW a 宝马. Vous pouvez aussi.",
  },
  {
    cat: 'Naming',
    q: "Garder le nom latin, le nom chinois, ou les deux ?",
    a: "Les deux, presque toujours. Le nom latin protège la marque globale. Le nom chinois fait le travail quotidien sur le marché. Sur le packaging, la signalétique et la recherche, le nom chinois prend la tête. Sur la communication globale et les signaux de positionnement premium, le nom latin reprend la main.",
  },
  {
    cat: 'Naming',
    q: "Comment tester un nom avant de s'engager ?",
    a: "On le lit à voix haute dans 3 villes. On récolte les réactions de jeunes, d'adultes et de seniors dans la cible visée. On le teste sur un écran de téléphone mal éclairé, pas seulement sur une slide. On lance une recherche d'antériorité dans les catégories où vous vendez vraiment, plus les adjacentes évidentes. Au moindre accroc, on refait la salve plutôt que de rapiécer.",
  },
  {
    cat: 'Identity',
    q: "Qu'est-ce qui fait qu'un logo fonctionne en Chine, au-delà de l'esthétique ?",
    a: "Il doit se lire en vignette, sur un avatar WeChat de 1,5 cm, sur un packaging coincé en rayon dans une ville de rang 3, et sur un sticker Douyin. Il doit survivre à une impression médiocre. Il doit porter un sens même sans couleur. La plupart des logos étrangers passent le premier test et échouent aux 3 suivants.",
  },
  {
    cat: 'Identity',
    q: "Où les marques étrangères ratent-elles le plus souvent leur identité visuelle ?",
    a: "Elles livrent la charte globale telle quelle. La palette pensée pour le retail européen paraît délavée sous l'éclairage d'un supermarché chinois. La typographie qui respire en imprimé étouffe à l'écran. La photo héros faite pour l'affichage urbain ne se recadre pas en vertical. L'adaptation du système n'est pas optionnelle.",
  },
  {
    cat: 'Identity',
    q: "Comment éviter le cliché des couleurs porte-bonheur ?",
    a: "On les utilise avec intention, pas par défaut. Le rouge fonctionne quand il y a une raison. L'or fonctionne quand il gagne sa place. La version paresseuse, c'est tout en rouge et or pour le Nouvel An. La version forte, c'est une marque qui utilise un seul code culturel avec finesse et laisse le reste de l'identité faire son propre travail.",
  },
  {
    cat: 'Assets',
    q: "Mon packaging global peut-il simplement débarquer en Chine ?",
    a: "Parfois le flacon, oui. Le graphisme, rarement. Le packaging chinois suit ses propres conventions : claims de face, codes ingrédients, pictogrammes réglementaires, hiérarchie des langues, formats de rayon différents des vôtres. On adapte les graphismes pour la Chine avant le lancement. C'est la pièce de marque la plus visible qu'un consommateur chinois aura jamais en main.",
  },
  {
    cat: 'Assets',
    q: "Comment tenir la cohérence de marque entre Tmall, Douyin, RED et le offline ?",
    a: "Une charte de marque chinoise, pas la charte globale. Elle cartographie la marque dans les formats que les plateformes chinoises utilisent réellement, avec templates, contre-exemples et notes de ton. Vous la donnez ensuite à chaque partenaire qui touche à votre marque : TP, agence KOL, designer retail, agence PR. La cohérence est un problème de logistique déguisé en problème créatif.",
  },
  {
    cat: 'Assets',
    q: "Puis-je réutiliser mes photos de marque globales ?",
    a: "Une partie, avec retouche. Les photos d'ambiance et lifestyle voyagent mal parce que le casting, les intérieurs, les gestes sonnent étrangers. La photo produit voyage bien si l'éclairage et les surfaces respectent les standards des plateformes. Prévoyez un shooting à Shanghai ou Shenzhen pour au moins la campagne héros chaque année.",
  },
  {
    cat: 'Process',
    q: "Combien de temps prend une construction de marque complète en Chine ?",
    a: "Stratégie et naming, 4 à 6 semaines. Identité visuelle, 6 à 8. Supports incluant packaging et création clé, 8 à 12. Comptez encore un mois de buffer pour les recherches d'antériorité, les tests consommateurs et les révisions. 3 à 5 mois de bout en bout, ça reste honnête. Quiconque vous promet 6 semaines vous vend un template.",
  },
  {
    cat: 'Process',
    q: "À quelle fréquence faut-il refondre la marque ?",
    a: "Refonte majeure tous les 4 à 6 ans, rafraîchissement léger tous les 2. Le marché chinois bouge vite. Tendances visuelles, UI des plateformes et références consommateurs se déplacent sur des cycles plus courts qu'en Europe ou aux États-Unis. Prévoyez un point annuel, pas seulement un grand reset tous les 5 ans.",
  },
  {
    cat: 'Process',
    q: "À qui appartient la charte, mon équipe ou l'agence ?",
    a: "Vous. Toujours vous. L'agence la construit, votre équipe en est propriétaire. Mettez-le au contrat dès le premier jour, avec la propriété des fichiers, les fichiers de travail et les licences de polices. On a vu des marques verrouillées hors de leurs propres supports parce que le contrat restait flou. Ne soyez pas cette marque-là.",
  },
  {
    cat: 'Cost',
    q: "Combien coûte vraiment une construction de marque complète en Chine ?",
    a: "Une fourchette, pas un chiffre. Une construction ciblée (stratégie, nom chinois, identité rafraîchie, packaging pour une gamme de SKU) tombe en général entre 30 000 et 80 000 USD. Un programme multi-SKU complet avec photo et vidéo originales double souvent ce montant. En dessous de 20 000, c'est du template déguisé.",
  },
  {
    cat: 'Cost',
    q: "Quelle répartition de budget entre stratégie, identité et supports ?",
    a: "Environ 25 % stratégie et naming, 30 % identité, 45 % supports. La plupart des marques étrangères sous-pondèrent les supports et se retrouvent avec un beau logo sans rien à mettre dessus. Pensez d'abord aux supports : l'identité s'installe ensuite autour de ce que vous allez réellement produire.",
  },
  {
    cat: 'Pitfalls',
    q: "Faut-il déposer mon nom chinois tôt ?",
    a: "Oui, le jour où vous l'arrêtez. La Chine fonctionne en premier-déposant. Des squatteurs surveillent les communiqués de presse et déposent les noms dans la semaine. Racheter votre propre nom coûte plus cher que la construction elle-même. Déposez en mandarin, en alphabet latin, en pinyin, sur les catégories où vous vendez et les adjacentes évidentes.",
  },
];

const faqCategories = [
  { key: 'All', label: 'Toutes' },
  { key: 'Strategy', label: 'Stratégie' },
  { key: 'Naming', label: 'Naming' },
  { key: 'Identity', label: 'Identité' },
  { key: 'Assets', label: 'Supports' },
  { key: 'Process', label: 'Processus' },
  { key: 'Cost', label: 'Budget' },
  { key: 'Pitfalls', label: 'Pièges' },
];

const faqCatLabels: Record<string, string> = {
  Strategy: 'Stratégie',
  Naming: 'Naming',
  Identity: 'Identité',
  Assets: 'Supports',
  Process: 'Processus',
  Cost: 'Budget',
  Pitfalls: 'Pièges',
};

const icons: Record<string, string> = {
  target: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>`,
  character: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M12 7v10M7 12h10M9 9l6 6M15 9l-6 6"/></svg>`,
  palette: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 9 9c0-1.5-1-2-2.5-2H17a2 2 0 0 1-2-2V7a2 2 0 0 0-3-1.7A9 9 0 0 0 12 3z"/><circle cx="7" cy="11" r="1" fill="currentColor"/><circle cx="9.5" cy="7.5" r="1" fill="currentColor"/><circle cx="14.5" cy="7" r="1" fill="currentColor"/></svg>`,
  cube: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 7v10l8 4 8-4V7l-8-4z"/><path d="M4 7l8 4 8-4M12 11v10"/></svg>`,
  compass: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="16 8 13 13 8 16 11 11 16 8"/></svg>`,
  hammer: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3l7 7-3 3-7-7z"/><path d="M11 6 4 13l3 3 7-7"/><path d="M8 16l-4 4"/></svg>`,
  rocket: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4c4 0 6 2 6 6-4 0-6 2-6 6-4 0-6-2-6-6 4 0 6-2 6-6z"/><circle cx="14" cy="10" r="1.5"/><path d="M8 16l-3 3M11 19l-2 2M5 13l-2 2"/></svg>`,
};

const phaseLabels = ['Phase un', 'Phase deux', 'Phase trois'];
---

<Layout
  title="Marque et localisation en Chine | Beyond Border Group"
  description="Agence de branding pour la Chine : positionnement, naming, identité visuelle et supports de marque. On construit des marques que le consommateur chinois reconnaît, qu'il préfère et qu'il choisit en rayon."
>
  <div class="bl-progress" aria-hidden="true"><div class="bl-progress__bar"></div></div>
  <article class="bl">

    {/* ---------- HERO ---------- */}
    <section class="bl-hero" data-hero>
      <div class="bl-hero__bg" aria-hidden="true" data-parallax>
        <img src="/Images/branding/hero.png" alt="Supports de marque en marché, packaging et identité visuelle exposés" />
      </div>
      <div class="bl-hero__overlay" aria-hidden="true"></div>
      <div class="bl-hero__grain" aria-hidden="true"></div>

      <div class="container bl-hero__inner">
        <nav class="bl-hero__crumbs" aria-label="Fil d'Ariane">
          <a href="/fr/">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/fr/#services">Entrer en Chine</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark bl-reveal">Marque et localisation</span>
        <h1 class="bl-hero__title bl-reveal" style="--reveal-delay: 80ms;">
          <span class="bl-hero__title-row">Une marque taillée pour la Chine,</span>
          <span class="bl-hero__title-row bl-hero__title-row--accent">sur chaque point de contact.</span>
          <span class="bl-hero__title-row">Conçue en Chine, pour le</span>
          <span class="bl-hero__title-row bl-hero__title-row--highlight">consommateur chinois.</span>
        </h1>
        <p class="bl-hero__lead bl-reveal" style="--reveal-delay: 200ms;">
          Positionnement, naming, identité visuelle et supports de marque, pensés pour les plateformes
          que les acheteurs chinois utilisent vraiment. On transforme des marques internationales en
          marques que le public chinois reconnaît, préfère, choisit en rayon.
        </p>
        <div class="bl-hero__actions bl-reveal" style="--reveal-delay: 280ms;">
          <a href="/fr/nous-contacter" class="btn btn--primary bl-magnetic">Nous parler</a>
          <a href="#services" class="btn btn--ghost-light bl-magnetic">Voir comment on travaille</a>
        </div>

        <div class="bl-hero__meta bl-reveal" style="--reveal-delay: 360ms;">
          <div class="bl-hero__meta-item">
            <span class="bl-hero__meta-num" data-counter="15" data-suffix="+">0</span>
