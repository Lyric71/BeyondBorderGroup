const faqCatLabels: Record<string, string> = {
  Strategy: 'Stratégie',
  Naming: 'Naming',
  Identity: 'Identité',
  Assets: 'Supports',
  Process: 'Processus',
  Cost: 'Budget',
  Pitfalls: 'Pièges',
