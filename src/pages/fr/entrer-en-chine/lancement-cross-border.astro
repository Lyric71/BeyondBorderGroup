const faqs = [
  {
    cat: 'Lancement',
    q: 'Combien de temps faut-il pour ouvrir sur Tmall ou JD ?',
    a: "Comptez 8 à 12 semaines en cross-border, 12 à 16 semaines en domestique. L'essentiel du calendrier se concentre sur la production de contenus, la conception de la boutique et l'audit de marque. Le dossier plateforme ne représente qu'une fraction du chantier.",
  },
  {
    cat: 'Stratégie',
    q: 'Tmall, JD ou Douyin en premier ?',
