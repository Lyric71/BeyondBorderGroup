      .cbs-models {
        grid-template-columns: 1fr;
      }
      .cbs-model {
        padding: var(--space-6);
      }
    }

    /* ---------- MATRIX (How to pick) ---------- */
    .cbs-matrix {
      margin-top: var(--space-8);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: clamp(var(--space-5), 3vw + 1rem, var(--space-7));
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    }
    .cbs-matrix__intro {
      text-align: center;
      margin-bottom: var(--space-6);
    }
    .cbs-matrix__intro h3 {
      font-size: clamp(1.375rem, 1.2vw + 1rem, 1.75rem);
      margin: var(--space-2) 0 var(--space-3);
      letter-spacing: -0.01em;
    }
    .cbs-matrix__intro p {
      color: var(--bbg-text);
      max-width: 56ch;
      margin: 0 auto;
      line-height: 1.6;
      font-size: 1rem;
    }
    .cbs-matrix__grid {
      display: grid;
      grid-template-columns: minmax(140px, 0.8fr) 1fr 1fr;
      gap: 1px;
      background: var(--bbg-border);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .cbs-matrix__corner,
    .cbs-matrix__head,
    .cbs-matrix__row-head,
    .cbs-matrix__cell {
      background: var(--bbg-white);
      padding: var(--space-4);
    }
    .cbs-matrix__corner {
      background: var(--bbg-surface);
    }
    .cbs-matrix__head {
      background: var(--bbg-surface);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .cbs-matrix__row-head {
      background: var(--bbg-surface);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      display: flex;
      align-items: center;
    }
    .cbs-matrix__cell {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      transition: background var(--dur) var(--ease);
      cursor: default;
    }
    .cbs-matrix__cell:hover {
      background: var(--bbg-blue-light);
    }
    .cbs-matrix__cell-label {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-matrix__cell-sub {
      font-size: 0.9rem;
      color: var(--bbg-text);
      line-height: 1.45;
    }
    .cbs-matrix__note {
      margin: var(--space-5) auto 0;
      max-width: 68ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 0.975rem;
    }
    @media (max-width: 720px) {
      .cbs-matrix__grid {
        grid-template-columns: 1fr 1fr;
      }
      .cbs-matrix__corner {
        display: none;
      }
      .cbs-matrix__head {
        font-size: 0.75rem;
        padding: var(--space-3);
      }
      .cbs-matrix__row-head {
        grid-column: 1 / -1;
        background: var(--bbg-blue-light);
        color: var(--bbg-blue-dark);
        justify-content: center;
        padding: var(--space-3);
      }
    }

    /* ---------- CASE STUDIES ---------- */
    .cbs-case {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      transition:
        transform var(--dur) var(--ease),
        border-color var(--dur) var(--ease),
        box-shadow var(--dur) var(--ease);
      color: var(--bbg-ink);
    }
    .cbs-case:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: var(--shadow-md);
      color: var(--bbg-ink);
    }
    .cbs-case__tag {
      font-size: var(--fs-label);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
    }
    .cbs-case__title {
      font-size: 1.5rem;
      line-height: 1.2;
      margin: 0;
      color: var(--bbg-ink);
      letter-spacing: -0.01em;
    }
    .cbs-case__desc {
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
      flex-grow: 1;
    }
    .cbs-case__cta {
      font-size: var(--fs-small);
      color: var(--bbg-blue);
      font-weight: 600;
      margin-top: var(--space-2);
    }
    .cbs-case:hover .cbs-case__cta span {
      display: inline-block;
      transform: translateX(4px);
      transition: transform var(--dur) var(--ease);
    }

    /* ---------- CASES CTA ---------- */
    .cbs-cases-cta {
      display: flex;
      justify-content: center;
    }

    /* ---------- PLATFORMS ---------- */
    .cbs-platforms {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
    .cbs-platform {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      color: var(--bbg-ink);
      overflow: hidden;
      isolation: isolate;
      transition:
        transform var(--dur) var(--ease),
        border-color var(--dur) var(--ease),
        box-shadow var(--dur) var(--ease);
    }
    .cbs-platform::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(
        90deg,
        var(--platform-color, var(--bbg-blue)) 0%,
        var(--platform-accent, var(--bbg-blue-dark)) 100%
      );
      transform: scaleX(0.4);
      transform-origin: left center;
      transition: transform var(--dur) var(--ease);
    }
    .cbs-platform::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--platform-color, #c8102e) 12%, transparent) 0%,
        transparent 55%
      );
      opacity: 0;
      transition: opacity var(--dur) var(--ease);
      z-index: -1;
      pointer-events: none;
    }
    .cbs-platform:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--platform-color, #c8102e) 60%, var(--bbg-border));
      box-shadow:
        0 18px 40px -22px color-mix(in srgb, var(--platform-color, #c8102e) 55%, transparent),
        0 4px 12px -6px rgba(0, 0, 0, 0.08);
      color: var(--bbg-ink);
    }
    .cbs-platform:hover::before {
      transform: scaleX(1);
    }
    .cbs-platform:hover::after {
      opacity: 1;
    }
    .cbs-platform__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }
    .cbs-platform__logo {
      width: 76px;
      height: 76px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-md);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      padding: 14px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transition:
        border-color var(--dur) var(--ease),
        transform var(--dur) var(--ease);
    }
    .cbs-platform:hover .cbs-platform__logo {
      border-color: color-mix(in srgb, var(--platform-color, #c8102e) 35%, var(--bbg-border));
      transform: scale(1.04);
    }
    .cbs-platform__logo img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
    .cbs-platform__cn {
      font-size: 1.5rem;
      font-weight: 700;
      color: color-mix(in srgb, var(--platform-color, #c8102e) 75%, var(--bbg-ink));
      line-height: 1;
      letter-spacing: 0.02em;
      opacity: 0.85;
    }
    .cbs-platform__body {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      flex-grow: 1;
    }
    .cbs-platform__title {
      font-size: 1.375rem;
      line-height: 1.2;
      margin: 0;
      color: var(--bbg-ink);
      letter-spacing: -0.01em;
      font-weight: 700;
    }
    .cbs-platform__sub {
      font-size: 0.9375rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-platform__cta {
      font-size: var(--fs-small);
      color: var(--platform-color, var(--bbg-blue));
      font-weight: 700;
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
    }
    .cbs-platform:hover .cbs-platform__cta span {
      display: inline-block;
      transform: translateX(4px);
      transition: transform var(--dur) var(--ease);
    }
    @media (max-width: 1024px) {
      .cbs-platforms {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .cbs-platforms {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- HOW WE WORK / STEPS ---------- */
    .cbs-steps {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
      counter-reset: step;
      position: relative;
    }
    .cbs-steps__line {
      display: none;
    }
    @media (min-width: 901px) {
      .cbs-steps__line {
        display: block;
        position: absolute;
        top: 56px;
        left: 12%;
        right: 12%;
        height: 2px;
        background: linear-gradient(
          90deg,
          rgba(200, 16, 46, 0) 0%,
          rgba(200, 16, 46, 0.35) 12%,
          rgba(200, 16, 46, 0.55) 50%,
          rgba(200, 16, 46, 0.35) 88%,
          rgba(200, 16, 46, 0) 100%
        );
        z-index: 0;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 1200ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .cbs-steps.is-in .cbs-steps__line {
        transform: scaleX(1);
      }
    }
    .cbs-step {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      position: relative;
      z-index: 1;
      transition:
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .cbs-step:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow:
        0 16px 32px -20px rgba(200, 16, 46, 0.4),
        0 4px 10px -6px rgba(0, 0, 0, 0.06);
    }
    .cbs-step__icon {
      display: inline-flex;
      width: 56px;
      height: 56px;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--bbg-white);
      color: var(--bbg-blue);
      margin-bottom: var(--space-4);
      box-shadow:
        0 0 0 3px var(--bbg-blue-light),
        inset 0 0 0 1px rgba(200, 16, 46, 0.18);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-step:hover .cbs-step__icon {
      transform: scale(1.06) rotate(4deg);
    }
    .cbs-step__icon svg {
      width: 26px;
      height: 26px;
    }
    .cbs-step__title {
      font-size: 1.375rem;
      line-height: 1.25;
      margin: 0 0 var(--space-3);
      letter-spacing: -0.01em;
    }
    .cbs-step__desc {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .cbs-steps {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- AI ---------- */
    .cbs-ai {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-4);
    }
    .cbs-ai__card {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      overflow: hidden;
      isolation: isolate;
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .cbs-ai__card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 50%, var(--bbg-blue) 100%);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-ai__card:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow:
        0 14px 30px -18px rgba(200, 16, 46, 0.42),
        0 4px 10px -6px rgba(0, 0, 0, 0.06);
    }
    .cbs-ai__card:hover::before {
      transform: scaleX(1);
    }
    .cbs-ai__icon {
      display: inline-flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.18) 100%);
      color: var(--bbg-blue);
      margin-bottom: var(--space-3);
      box-shadow: inset 0 0 0 1px rgba(200, 16, 46, 0.12);
      transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-ai__card:hover .cbs-ai__icon {
      transform: scale(1.08) rotate(-4deg);
    }
    .cbs-ai__icon svg {
      width: 20px;
      height: 20px;
    }
    .cbs-ai__card h3 {
      font-size: 1.0625rem;
      line-height: 1.3;
      margin: 0 0 var(--space-2);
      letter-spacing: -0.005em;
    }
    .cbs-ai__card p {
      font-size: 0.9375rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .cbs-ai {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .cbs-ai {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- FAQ ---------- */
    .cbs-faq {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-faq__item {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition:
        border-color 240ms ease,
        box-shadow 240ms ease,
        transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-faq__item:hover {
      transform: translateX(2px);
      border-color: rgba(200, 16, 46, 0.4);
    }
    .cbs-faq__item[open] {
      border-color: var(--bbg-blue);
      box-shadow: 0 8px 22px -14px rgba(200, 16, 46, 0.4);
    }
    .cbs-faq__q {
      cursor: pointer;
      padding: var(--space-5);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      font-weight: 600;
      font-size: 1.0625rem;
      line-height: 1.3;
      color: var(--bbg-ink);
      list-style: none;
      transition: color var(--dur) var(--ease);
    }
    .cbs-faq__q::-webkit-details-marker {
      display: none;
    }
    .cbs-faq__q::marker {
      display: none;
    }
    .cbs-faq__item:hover .cbs-faq__q {
      color: var(--bbg-blue);
    }
    .cbs-faq__icon {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        color var(--dur) var(--ease),
        background var(--dur) var(--ease);
    }
    .cbs-faq__item[open] .cbs-faq__icon {
      transform: rotate(180deg);
      color: var(--bbg-white);
      background: var(--bbg-blue);
    }
    .cbs-faq__a {
      padding: 0 var(--space-5) var(--space-5);
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
      animation: cbs-faq-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-faq-in {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .cbs-faq__a p {
      margin: 0;
    }

    /* ---------- FINAL CTA ---------- */
    .cbs-cta {
      padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8)) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
      color: var(--bbg-white);
      border-radius: var(--radius-lg);
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .cbs-cta::before {
      content: '';
      position: absolute;
      top: -40%;
      right: -10%;
      width: 420px;
      height: 420px;
      background: radial-gradient(
        circle at center,
        rgba(255, 255, 255, 0.18) 0%,
        rgba(255, 255, 255, 0) 65%
      );
      pointer-events: none;
    }
    .cbs-cta .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-4);
      color: rgba(255, 255, 255, 0.9);
    }
    .cbs-cta__title {
      font-size: clamp(1.75rem, 1.5vw + 1rem, 2.5rem);
      line-height: 1.15;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      letter-spacing: -0.015em;
    }
    .cbs-cta__lead {
      color: rgba(255, 255, 255, 0.92);
      font-size: 1.0625rem;
      max-width: 52ch;
      margin: 0 auto var(--space-5);
      line-height: 1.55;
    }
    .cbs-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      justify-content: center;
      position: relative;
    }
    .cbs-cta__btn-primary {
      background: var(--bbg-white);
      color: var(--bbg-blue-dark);
      border: 1px solid var(--bbg-white);
    }
    .cbs-cta__btn-primary:hover {
      background: rgba(255, 255, 255, 0.92);
      color: var(--bbg-blue-dark);
    }
    .cbs-cta__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: var(--bbg-white);
    }
    .cbs-cta__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }

    /* ================================================== */
    /* ============ V2 SECTION REBUILDS ================= */
    /* ================================================== */

    /* ---------- SERVICES (balanced 2x2) ---------- */
    .cbs-svc-section .section-header--split {
      align-items: end;
      gap: var(--space-6);
      margin-bottom: var(--space-6);
    }
    .cbs-svc-lead {
      max-width: 44ch;
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-svc-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
    .cbs-svc-card {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 20px;
      padding: var(--space-6);
      overflow: hidden;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      min-height: 320px;
      transition:
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .cbs-svc-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(
        90deg,
        var(--svc-color, #c8102e) 0%,
        var(--svc-color, #c8102e) 50%,
        transparent 100%
      );
      transform: scaleX(0.3);
      transform-origin: left center;
      transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1;
    }
    .cbs-svc-card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(
        140% 90% at 100% 0%,
        color-mix(in srgb, var(--svc-color, #c8102e) 14%, transparent) 0%,
        transparent 55%
      );
      opacity: 0;
      transition: opacity 360ms ease;
      z-index: -1;
      pointer-events: none;
    }
    .cbs-svc-card:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--svc-color, #c8102e) 55%, var(--bbg-border));
      box-shadow:
        0 22px 50px -26px color-mix(in srgb, var(--svc-color, #c8102e) 50%, transparent),
        0 6px 14px -8px rgba(0, 0, 0, 0.08);
    }
    .cbs-svc-card:hover::before {
      transform: scaleX(1);
    }
    .cbs-svc-card:hover::after {
      opacity: 1;
    }
    .cbs-svc-card:hover .cbs-svc-card__icon {
      transform: scale(1.06) rotate(-4deg);
      background: var(--svc-color, var(--bbg-blue));
      color: var(--bbg-white);
      box-shadow:
        0 12px 24px -14px color-mix(in srgb, var(--svc-color, #c8102e) 70%, transparent),
        inset 0 0 0 1px color-mix(in srgb, var(--svc-color, #c8102e) 30%, transparent);
    }
    .cbs-svc-card:hover .cbs-svc-card__arrow {
      transform: translateX(4px);
      color: var(--svc-color, var(--bbg-blue));
    }

    .cbs-svc-card__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }
    .cbs-svc-card__icon {
      display: inline-flex;
      width: 56px;
      height: 56px;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      background: var(--svc-soft, var(--bbg-blue-light));
      color: var(--svc-color, var(--bbg-blue));
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--svc-color, #c8102e) 18%, transparent);
      transition:
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
        background 320ms ease,
        color 320ms ease,
        box-shadow 320ms ease;
      flex-shrink: 0;
    }
    .cbs-svc-card__icon svg {
      width: 28px;
      height: 28px;
    }
    .cbs-svc-card__short {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--svc-color, var(--bbg-blue));
      text-align: right;
      line-height: 1.4;
    }
    .cbs-svc-card__title {
      font-size: 1.5rem;
      line-height: 1.18;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-ink);
    }
    .cbs-svc-card__desc {
      font-size: 0.975rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-svc-card__points {
      list-style: none;
      padding: var(--space-4) 0 0;
      margin: 0;
      border-top: 1px solid var(--bbg-border);
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      margin-top: auto;
    }
    .cbs-svc-card__points li {
      display: grid;
      grid-template-columns: 14px 1fr;
      gap: 0.6rem;
      align-items: center;
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--bbg-text);
    }
    .cbs-svc-card__bullet {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--svc-color, var(--bbg-blue));
      box-shadow: 0 0 0 3px var(--svc-soft, var(--bbg-blue-light));
      margin-left: 4px;
    }
    .cbs-svc-card__arrow {
      position: absolute;
      bottom: var(--space-6);
      right: var(--space-6);
      color: var(--bbg-text-muted);
      transition:
        transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
        color 200ms ease;
      pointer-events: none;
    }
    .cbs-svc-card__arrow svg {
      width: 22px;
      height: 22px;
    }
    @media (max-width: 720px) {
      .cbs-svc-grid {
        grid-template-columns: 1fr;
      }
      .cbs-svc-card {
        min-height: 0;
      }
      .cbs-svc-section .section-header--split {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    /* ---------- BUSINESS MODELS TABS ---------- */
    .cbs-tabs {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 16px 48px -28px rgba(8, 18, 28, 0.18);
    }
    .cbs-tabs__nav {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      background: linear-gradient(180deg, var(--bbg-surface) 0%, var(--bbg-white) 100%);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-tabs__tab {
      position: relative;
      background: transparent;
      border: none;
      padding: var(--space-5) var(--space-4);
      text-align: left;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      color: var(--bbg-text-muted);
      transition:
        color 240ms ease,
        background 240ms ease;
      border-right: 1px solid var(--bbg-border);
    }
    .cbs-tabs__tab:last-child {
      border-right: none;
    }
    .cbs-tabs__tab:hover {
      color: var(--bbg-ink);
      background: rgba(200, 16, 46, 0.04);
    }
    .cbs-tabs__tab.is-active {
      color: var(--bbg-ink);
      background: var(--bbg-white);
    }
    .cbs-tabs__tab-label {
      font-size: 1.0625rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      line-height: 1.2;
    }
    .cbs-tabs__tab-tag {
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      line-height: 1.35;
    }
    .cbs-tabs__tab.is-active .cbs-tabs__tab-tag {
      color: var(--bbg-blue);
    }
    .cbs-tabs__tab-pop {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .cbs-tabs__indicator {
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 25%;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 100%);
      border-radius: 2px 2px 0 0;
      transform: translateX(0);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }
    .cbs-tabs__panels {
      background: var(--bbg-white);
    }
    .cbs-tabs__panel {
      padding: clamp(var(--space-5), 4vw + 1rem, var(--space-7));
      animation: cbs-tab-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-tab-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .cbs-tabs__panel[hidden] {
      display: none;
    }
    .cbs-tabs__panel-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .cbs-tabs__lead {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .cbs-tabs__pillset {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .cbs-tabs__pill {
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.35em 0.85em;
      border-radius: 999px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      letter-spacing: 0.01em;
    }
    .cbs-tabs__title {
      font-size: clamp(1.625rem, 1.8vw + 1rem, 2.25rem);
      line-height: 1.1;
      margin: 0;
      letter-spacing: -0.015em;
    }
    .cbs-tabs__desc {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-tabs__when {
      padding: var(--space-4);
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--bbg-blue);
    }
    .cbs-tabs__when-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.35rem;
    }
    .cbs-tabs__when p {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--bbg-text);
    }
    .cbs-tabs__body {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .cbs-tabs__list-wrap {
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .cbs-tabs__list-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .cbs-tabs__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-tabs__list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--bbg-text);
    }
    .cbs-tabs__check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .cbs-tabs__check svg {
      width: 12px;
      height: 12px;
    }
    .cbs-tabs__pricing {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      padding: var(--space-4);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.12) 100%);
      border-radius: var(--radius-md);
      border: 1px solid rgba(200, 16, 46, 0.2);
    }
    .cbs-tabs__pricing-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue-dark);
      flex-shrink: 0;
    }
    .cbs-tabs__pricing-value {
      font-size: 1rem;
      font-weight: 600;
      color: var(--bbg-ink);
      line-height: 1.4;
    }
    @media (max-width: 1024px) {
      .cbs-tabs__nav {
        grid-template-columns: repeat(2, 1fr);
      }
      .cbs-tabs__tab {
        border-bottom: 1px solid var(--bbg-border);
      }
      .cbs-tabs__tab:nth-child(2) {
        border-right: none;
      }
      .cbs-tabs__indicator {
        display: none;
      }
      .cbs-tabs__panel-grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 560px) {
      .cbs-tabs__nav {
        grid-template-columns: 1fr;
      }
      .cbs-tabs__tab {
        border-right: none;
      }
    }

    /* Matrix interactive cells */
    .cbs-matrix__cell {
      border: none;
      text-align: left;
      font-family: inherit;
      cursor: pointer;
    }
    .cbs-matrix__cell:focus-visible {
      outline: 3px solid var(--bbg-blue);
      outline-offset: -3px;
    }
    .cbs-matrix__grid.is-hover-row .cbs-matrix__cell {
      opacity: 0.4;
    }
    .cbs-matrix__grid.is-hover-row .cbs-matrix__cell.is-row-active,
    .cbs-matrix__grid.is-hover-row .cbs-matrix__cell.is-col-active {
      opacity: 1;
      background: var(--bbg-blue-light);
    }
    .cbs-matrix__grid.is-hover-row .cbs-matrix__row-head,
    .cbs-matrix__grid.is-hover-row .cbs-matrix__head {
      opacity: 0.4;
    }
    .cbs-matrix__grid.is-hover-row .cbs-matrix__row-head.is-active,
    .cbs-matrix__grid.is-hover-row .cbs-matrix__head.is-active {
      opacity: 1;
      background: var(--bbg-blue);
      color: var(--bbg-white);
    }

    /* ---------- HOW WE WORK / JOURNEY (vertical timeline) ---------- */
    .cbs-journey-section {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    .cbs-journey-section__bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
      opacity: 0.1;
      pointer-events: none;
    }
    .cbs-journey-section__bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        var(--bbg-white) 0%,
        rgba(255, 255, 255, 0.4) 40%,
        rgba(255, 255, 255, 0.7) 100%
      );
    }
    .cbs-journey-section__bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: saturate(0.55);
    }

    .cbs-journey {
      position: relative;
      max-width: 880px;
      margin: 0 auto;
      padding-left: 56px;
    }
    .cbs-journey__rail {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 22px;
      width: 2px;
    }
    .cbs-journey__rail-track {
      position: absolute;
      inset: 0;
      background: var(--bbg-border);
      border-radius: 2px;
    }
    .cbs-journey__rail-fill {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: var(--journey-progress, 0%);
      background: linear-gradient(180deg, var(--bbg-blue) 0%, #e84a60 100%);
      border-radius: 2px;
      transition: height 120ms linear;
      box-shadow: 0 0 8px rgba(200, 16, 46, 0.4);
    }
    .cbs-journey__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }
    .cbs-journey__item {
      position: relative;
    }
    .cbs-journey__dot {
      position: absolute;
      left: -56px;
      top: 0;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--bbg-white);
      border: 2px solid var(--bbg-border);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      transition: border-color 320ms ease;
    }
    .cbs-journey__dot-inner {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--bbg-border);
      transition:
        background 320ms ease,
        transform 320ms ease;
    }
    .cbs-journey__item.is-active .cbs-journey__dot {
      border-color: var(--bbg-blue);
    }
    .cbs-journey__item.is-active .cbs-journey__dot-inner {
      background: var(--bbg-blue);
      transform: scale(1.1);
      box-shadow: 0 0 0 4px var(--bbg-blue-light);
    }
    .cbs-journey__phase {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-2);
      transition: color 320ms ease;
    }
    .cbs-journey__item.is-active .cbs-journey__phase {
      color: var(--bbg-blue);
    }
    .cbs-journey__card {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5) var(--space-6);
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      transition:
        border-color 320ms ease,
        box-shadow 320ms ease,
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-journey__item:hover .cbs-journey__card,
    .cbs-journey__item.is-active .cbs-journey__card {
      border-color: var(--bbg-blue);
      box-shadow: 0 18px 38px -22px rgba(200, 16, 46, 0.4);
      transform: translateX(4px);
    }
    .cbs-journey__icon {
      display: inline-flex;
      width: 48px;
      height: 48px;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      flex-shrink: 0;
    }
    .cbs-journey__icon svg {
      width: 24px;
      height: 24px;
    }
    .cbs-journey__title {
      font-size: 1.25rem;
      line-height: 1.25;
      margin: 0 0 0.4rem;
      letter-spacing: -0.005em;
    }
    .cbs-journey__desc {
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 600px) {
      .cbs-journey {
        padding-left: 40px;
      }
      .cbs-journey__rail {
        left: 16px;
      }
      .cbs-journey__dot {
        left: -40px;
        width: 32px;
        height: 32px;
      }
      .cbs-journey__dot-inner {
        width: 10px;
        height: 10px;
      }
      .cbs-journey__card {
        flex-direction: column;
        gap: var(--space-3);
      }
    }

    /* ---------- AI BENTO ---------- */
    .cbs-ai-bento {
      display: grid;
      grid-template-columns: 1.2fr 1fr 1fr;
      grid-template-rows: auto auto;
      gap: var(--space-4);
    }
    .cbs-ai-bento__card {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      overflow: hidden;
      isolation: isolate;
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .cbs-ai-bento__card:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: 0 16px 32px -20px rgba(200, 16, 46, 0.4);
    }
    .cbs-ai-bento__card--small h3 {
      font-size: 1.05rem;
      line-height: 1.3;
      margin: 0 0 0.5rem;
    }
    .cbs-ai-bento__card--small p {
      font-size: 0.92rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-ai-bento__card--feature {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
      padding: var(--space-7);
      background: linear-gradient(160deg, #102434 0%, #0c1a26 60%);
      color: var(--bbg-white);
      border-color: rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-5);
    }
    .cbs-ai-bento__card--feature:hover {
      border-color: rgba(155, 217, 245, 0.4);
    }
    .cbs-ai-bento__feature-bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(80% 60% at 100% 0%, rgba(200, 16, 46, 0.32) 0%, rgba(200, 16, 46, 0) 60%),
        radial-gradient(60% 50% at 0% 100%, rgba(200, 16, 46, 0.18) 0%, rgba(200, 16, 46, 0) 60%);
    }
    .cbs-ai-bento__feature-body {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-ai-bento__chip {
      display: inline-block;
      align-self: flex-start;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #c8102e;
      background: rgba(200, 16, 46, 0.18);
      padding: 0.4em 0.85em;
      border-radius: 999px;
      border: 1px solid rgba(155, 217, 245, 0.25);
    }
    .cbs-ai-bento__card--feature h3 {
      font-size: clamp(1.5rem, 1.4vw + 1rem, 2rem);
      line-height: 1.1;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-white);
    }
    .cbs-ai-bento__card--feature p {
      font-size: 1rem;
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.78);
      margin: 0;
    }
    .cbs-ai-bento__feature-stats {
      list-style: none;
      padding: var(--space-4) 0 0;
      margin: 0;
      display: flex;
      gap: var(--space-6);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
    .cbs-ai-bento__feature-stats li {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .cbs-ai-bento__stat-num {
      font-size: clamp(1.625rem, 1.4vw + 1rem, 2.125rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1;
      color: #c8102e;
      font-feature-settings: 'tnum';
    }
    .cbs-ai-bento__stat-label {
      font-size: 0.78rem;
      color: rgba(255, 255, 255, 0.65);
      letter-spacing: 0.02em;
    }
    .cbs-ai-bento__icon-large {
      position: absolute;
      bottom: -28px;
      right: -28px;
      width: 200px;
      height: 200px;
      color: rgba(200, 16, 46, 0.18);
      opacity: 0.7;
      pointer-events: none;
    }
    .cbs-ai-bento__icon-large svg {
      width: 100%;
      height: 100%;
    }
    .cbs-ai-bento__icon {
      display: inline-flex;
      width: 40px;
      height: 40px;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.18) 100%);
      color: var(--bbg-blue);
      margin-bottom: var(--space-3);
    }
    .cbs-ai-bento__icon svg {
      width: 20px;
      height: 20px;
    }
    @media (max-width: 1024px) {
      .cbs-ai-bento {
        grid-template-columns: 1fr 1fr;
      }
      .cbs-ai-bento__card--feature {
        grid-column: 1 / -1;
        grid-row: auto;
      }
    }
    @media (max-width: 560px) {
      .cbs-ai-bento {
        grid-template-columns: 1fr;
      }
      .cbs-ai-bento__feature-stats {
        gap: var(--space-4);
        flex-wrap: wrap;
      }
    }

    /* ---------- FAQ FILTER CHIPS ---------- */
    .cbs-faq-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-bottom: var(--space-6);
    }
    .cbs-faq-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.95rem;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 999px;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--bbg-text);
      transition: all 220ms ease;
      font-family: inherit;
    }
    .cbs-faq-chip:hover {
      border-color: var(--bbg-blue);
      color: var(--bbg-blue);
    }
    .cbs-faq-chip.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }
    .cbs-faq-chip__count {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.15em 0.5em;
      border-radius: 999px;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition: all 220ms ease;
    }
    .cbs-faq-chip:hover .cbs-faq-chip__count {
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
    }
    .cbs-faq-chip.is-active .cbs-faq-chip__count {
      background: rgba(255, 255, 255, 0.2);
      color: var(--bbg-white);
    }
    .cbs-faq__cat-tag {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 0.25em 0.6em;
      border-radius: 4px;
      margin-right: var(--space-3);
      flex-shrink: 0;
    }
    .cbs-faq__q-text {
      flex-grow: 1;
    }
    .cbs-faq__item.is-hidden {
      display: none;
    }
  </style>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Reveal-on-scroll for elements with .cbs-reveal
      const revealEls = document.querySelectorAll('.cbs-reveal');
      if (revealEls.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-in');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
          );
          revealEls.forEach((el) => io.observe(el));
        }
      }

      // 2. Reveal the steps connecting line when the steps list enters view
      const stepsList = document.querySelector('.cbs-steps');
      if (stepsList && !reduced && 'IntersectionObserver' in window) {
        const stepsIo = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                stepsIo.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2 },
        );
        stepsIo.observe(stepsList);
      } else if (stepsList) {
        stepsList.classList.add('is-in');
      }

      // 3. Animated number counters in the hero meta strip
      const counters = document.querySelectorAll('[data-counter]');
      if (counters.length && !reduced && 'IntersectionObserver' in window) {
        const animate = (el) => {
          const target = parseFloat(el.dataset.counter || '0');
          const suffix = el.dataset.suffix || '';
          const duration = 1400;
          const start = performance.now();
          const tick = (now) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = Math.round(target * eased);
            el.textContent = value + suffix;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const counterIo = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animate(entry.target);
                counterIo.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.5 },
        );
        counters.forEach((el) => counterIo.observe(el));
      } else {
        counters.forEach((el) => {
          el.textContent = (el.dataset.counter || '0') + (el.dataset.suffix || '');
        });
      }

      // 4. Hero parallax + scroll progress bar (single rAF loop, throttled)
      const parallaxEl = document.querySelector('[data-parallax]');
      const progressEl = document.querySelector('.cbs-progress__bar');
      const heroEl = document.querySelector('[data-hero]');
      let ticking = false;

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;

          // Parallax
          if (parallaxEl && heroEl && !reduced) {
            const heroH = heroEl.offsetHeight;
            if (scrollY < heroH) {
              parallaxEl.style.setProperty('--parallax-y', scrollY * 0.18 + 'px');
            }
          }

          // Progress
          if (progressEl) {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
            progressEl.style.setProperty('--progress', pct + '%');
          }

          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // 5. Smooth scroll for in-page anchors (the hero scroll arrow)
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = link.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        });
      });

      // 6. Auto-close other FAQ items when one opens (accordion behaviour)
      const faqItems = document.querySelectorAll('.cbs-faq__item');
      faqItems.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (item.open) {
            faqItems.forEach((other) => {
              if (other !== item && other.open) other.open = false;
            });
          }
        });
      });

      // 7. Business model tabs
      const tabsRoot = document.querySelector('[data-tabs]');
      if (tabsRoot) {
        const tabs = Array.from(tabsRoot.querySelectorAll('.cbs-tabs__tab'));
        const panels = Array.from(tabsRoot.querySelectorAll('.cbs-tabs__panel'));
        const indicator = tabsRoot.querySelector('.cbs-tabs__indicator');

        const setActive = (tab) => {
          tabs.forEach((t) => {
            const active = t === tab;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          const targetId = tab.getAttribute('data-tab-target');
          panels.forEach((p) => {
            const active = p.id === targetId;
            p.classList.toggle('is-active', active);
            if (active) p.removeAttribute('hidden');
            else p.setAttribute('hidden', '');
          });
          if (indicator) {
            const idx = tabs.indexOf(tab);
            const w = 100 / tabs.length;
            indicator.style.width = w + '%';
            indicator.style.transform = `translateX(${idx * 100}%)`;
          }
        };

        tabs.forEach((tab) => {
          tab.addEventListener('click', () => setActive(tab));
          tab.addEventListener('keydown', (e) => {
            const idx = tabs.indexOf(tab);
            if (e.key === 'ArrowRight') {
              e.preventDefault();
              const next = tabs[(idx + 1) % tabs.length];
              next.focus();
              setActive(next);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
              prev.focus();
              setActive(prev);
            }
          });
        });

        // Initialise indicator on the active tab
        const initialActive = tabs.find((t) => t.classList.contains('is-active')) || tabs[0];
        if (initialActive) setActive(initialActive);
      }

      // 8. Matrix cell hover highlights row + column, click jumps to a tab
      const matrix = document.querySelector('[data-matrix] .cbs-matrix__grid');
      if (matrix) {
        const cells = Array.from(matrix.querySelectorAll('.cbs-matrix__cell'));
        const heads = Array.from(matrix.querySelectorAll('.cbs-matrix__head'));
        const rowHeads = Array.from(matrix.querySelectorAll('.cbs-matrix__row-head'));

        const clearHighlight = () => {
          matrix.classList.remove('is-hover-row');
          cells.forEach((c) => c.classList.remove('is-row-active', 'is-col-active'));
          heads.forEach((h) => h.classList.remove('is-active'));
          rowHeads.forEach((h) => h.classList.remove('is-active'));
        };

        cells.forEach((cell) => {
          const row = cell.dataset.row;
          const col = cell.dataset.col;
          cell.addEventListener('mouseenter', () => {
            matrix.classList.add('is-hover-row');
            cells.forEach((c) => {
              c.classList.toggle('is-row-active', c.dataset.row === row);
              c.classList.toggle('is-col-active', c.dataset.col === col);
            });
            heads.forEach((h) => h.classList.toggle('is-active', h.dataset.col === col));
            rowHeads.forEach((h) => h.classList.toggle('is-active', h.dataset.row === row));
          });
          cell.addEventListener('mouseleave', clearHighlight);
          cell.addEventListener('click', () => {
            const targetTabId = cell.dataset.tabJump;
            const tab = targetTabId && document.getElementById(targetTabId);
            if (tab) {
              tab.click();
              tab.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
              tab.focus();
            }
          });
        });
      }

      // 9. Journey vertical timeline scroll progress + active state
      const journey = document.querySelector('[data-journey]');
      if (journey) {
        const fill = journey.querySelector('[data-journey-fill]');
        const items = Array.from(journey.querySelectorAll('[data-journey-item]'));

        const updateJourney = () => {
          const rect = journey.getBoundingClientRect();
          const vh = window.innerHeight;
          const total = rect.height;
          const visible = Math.max(0, Math.min(total, vh * 0.55 - rect.top));
          const pct = Math.max(0, Math.min(100, (visible / total) * 100));
          if (fill) fill.style.setProperty('--journey-progress', pct + '%');

          items.forEach((item) => {
            const r = item.getBoundingClientRect();
            const center = r.top + r.height / 2;
            const inActive = center < vh * 0.6 && center > 0;
            item.classList.toggle('is-active', inActive);
          });
        };

        let journeyTicking = false;
        const onJourneyScroll = () => {
          if (journeyTicking) return;
          journeyTicking = true;
          requestAnimationFrame(() => {
            updateJourney();
            journeyTicking = false;
          });
        };
        window.addEventListener('scroll', onJourneyScroll, { passive: true });
        window.addEventListener('resize', onJourneyScroll, { passive: true });
        updateJourney();
      }

      // 10. FAQ category filter
      const faqFilter = document.querySelector('[data-faq-filter]');
      const faqList = document.querySelector('[data-faq-list]');
      if (faqFilter && faqList) {
        const chips = Array.from(faqFilter.querySelectorAll('.cbs-faq-chip'));
        const items = Array.from(faqList.querySelectorAll('.cbs-faq__item'));
        chips.forEach((chip) => {
          chip.addEventListener('click', () => {
            const cat = chip.dataset.faqCat;
            chips.forEach((c) => {
              const on = c === chip;
              c.classList.toggle('is-active', on);
              c.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            items.forEach((item) => {
              const matches = cat === 'Tout' || item.dataset.faqCat === cat;
              item.classList.toggle('is-hidden', !matches);
            });
          });
        });
      }
    })();
  </script>
</Layout>
