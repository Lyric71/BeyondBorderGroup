      transform-origin: left center;
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      border-radius: 0 0 2px 2px;
    }
    .dis-compass-tier:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: 0 16px 32px -20px rgba(200, 16, 46, 0.4);
    }
    .dis-compass-tier:hover::before {
      transform: scaleX(1);
    }
    .dis-compass-tier__label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-blue);
    }
    .dis-compass-tier__lead {
      font-size: 1.0625rem;
      line-height: 1.5;
      color: var(--bbg-ink);
      font-weight: 600;
      margin: 0;
      letter-spacing: -0.005em;
    }
    .dis-compass-tier__when {
      font-size: 0.9rem;
      line-height: 1.55;
      color: var(--bbg-text-muted);
      margin-top: auto;
    }
    @media (max-width: 1024px) {
      .dis-compass-tiers {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- FAQ FILTER ---------- */
    .dis-faq-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-bottom: var(--space-6);
    }
    .dis-faq-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.95rem;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 999px;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--bbg-text);
      transition: all 220ms ease;
      font-family: inherit;
    }
    .dis-faq-chip:hover {
      border-color: var(--bbg-blue);
      color: var(--bbg-blue);
    }
    .dis-faq-chip.is-active {
      background: var(--bbg-blue);
