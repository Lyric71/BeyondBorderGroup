      transition: all 220ms ease;
    }
    .dis-faq-chip:hover .dis-faq-chip__count {
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
    }
    .dis-faq-chip.is-active .dis-faq-chip__count {
      background: rgba(255, 255, 255, 0.2);
      color: var(--bbg-white);
    }

    /* ---------- FAQ ITEMS ---------- */
    .dis-faq {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .dis-faq__item {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition:
        border-color 240ms ease,
        box-shadow 240ms ease,
