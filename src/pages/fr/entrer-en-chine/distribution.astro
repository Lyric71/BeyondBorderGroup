];

const contextCards = [
  {
    image: '/Images/enter-china/dist-context-shelf.png',
    alt: "Un acheteur chinois inspecte la mise en linéaire d'une marque importée premium dans un supermarché de ville tier-1",
    title: "Le bon distributeur n'est jamais le plus tapageur",
    body: 'Les mêmes douze noms vous abordent dans chaque salon. Le bon partenaire est le plus souvent un opérateur discret, identifié par son nom dans notre fichier, jamais un démarcheur en porte-à-porte.',
  },
  {
    image: '/Images/enter-china/dist-context-meeting.png',
    alt: 'Un contrat signé sur un bureau métallique dans un entrepôt de distribution chinois en activité, cartons de marque sur palettes en arrière-plan',
    title: 'Signer un distributeur ouvre la collaboration, sans la conclure',
    body: 'Les marques qui se taisent une fois le contrat signé reculent au fond du linéaire en deux trimestres. Le travail qui défend la position commence précisément après la signature.',
  },
];
---

<Layout
  title="Distribution produit en Chine | TheChinaPath"
  description="Sourcer le bon distributeur en Chine, en ligne comme en magasin. Fichier partenaires Compass, négociation bilingue, suivi mensuel en gardien de marque. Quinze années de terrain."
>
  <div class="dis-progress" aria-hidden="true"><div class="dis-progress__bar"></div></div>
  <article class="dis">
    {/* ---------- HERO (dark, parallax) ---------- */}
    <section class="dis-hero" data-hero>
      <div class="dis-hero__bg" aria-hidden="true" data-parallax>
        <img
          src="/Images/enter-china/dist-hero-warehouse.webp"
          alt="Vue intérieure d'un entrepôt de distribution chinois moderne au crépuscule, cartons de marque sur convoyeurs et rayonnages"
        />
      </div>
      <div class="dis-hero__overlay" aria-hidden="true"></div>
      <div class="dis-hero__grain" aria-hidden="true"></div>

      <div class="container dis-hero__inner">
        <nav class="dis-hero__crumbs" aria-label="Fil d'Ariane">
          <a href="/fr">Accueil</a>
          <span aria-hidden="true">/</span>
          <a href="/fr/#services">Entrer en Chine</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark dis-reveal">Distribution en Chine</span>
        <h1 class="dis-hero__title dis-reveal" style="--reveal-delay: 80ms;">
          <span class="dis-hero__title-row">Le bon distributeur,</span>
          <span class="dis-hero__title-row dis-hero__title-row--accent"
            >en ligne et en magasin.</span
          >
          <span class="dis-hero__title-row">Et l'équipe qui</span>
          <span class="dis-hero__title-row dis-hero__title-row--highlight">sait le tenir.</span>
        </h1>
        <p class="dis-hero__lead dis-reveal" style="--reveal-delay: 200ms;">
          On puise vos distributeurs dans Compass, notre fichier de relations bâti sur quinze
          ans. On négocie dans les deux langues. Contrat signé, on reste gardiens de la marque. La
          plupart des cabinets en maîtrisent un sur trois. Nous, les trois.
        </p>
        <div class="dis-hero__actions dis-reveal" style="--reveal-delay: 280ms;">
          <a href="/fr/nous-contacter" class="btn btn--primary dis-magnetic">Nous parler</a>
          <a href="#how-we-work" class="btn btn--ghost-light dis-magnetic"
            >Voir notre façon de travailler</a
          >
        </div>

        <div class="dis-hero__meta dis-reveal" style="--reveal-delay: 360ms;">
          <div class="dis-hero__meta-item">
            <span class="dis-hero__meta-num" data-counter="15" data-suffix="+">0</span>
            <span class="dis-hero__meta-label">années de relations vérifiées</span>
          </div>
          <div class="dis-hero__meta-item">
            <span class="dis-hero__meta-num">Toutes</span>
            <span class="dis-hero__meta-label"
              >les grandes catégories de la consommation, en ligne comme en magasin</span
            >
          </div>
          <div class="dis-hero__meta-item">
            <span class="dis-hero__meta-num">Zéro</span>
            <span class="dis-hero__meta-label">commission auprès du distributeur. Jamais.</span>
          </div>
        </div>
      </div>

      <a href="#two-truths" class="dis-hero__scroll" aria-label="Aller à la section suivante">
        <span class="dis-hero__scroll-line"></span>
        <span class="dis-hero__scroll-text">Scroll</span>
      </a>
    </section>

    {/* ---------- TWO TRUTHS / CONTEXT ---------- */}
    <section id="two-truths" class="section">
      <div class="container">
        <header class="section-header section-header--center dis-reveal">
          <span class="eyebrow">Deux vérités d'abord</span>
          <h2>Deux constats préalables à toute signature</h2>
          <p class="section-header__lead">
            La plupart des marques étrangères croisent les mêmes douze distributeurs au fil des
            salons. La plupart des contrats signés tombent dans le silence dès le deuxième
            trimestre. Voilà, après quinze ans à voir tourner le marché, ce qui pèse vraiment dans
            la balance.
          </p>
        </header>

        <div class="dis-context">
          {
            contextCards.map((c, i) => (
              <article
                class={`dis-context__card${i === 1 ? ' dis-context__card--alt' : ''} dis-reveal`}
                style={`--reveal-delay: ${i * 120}ms;`}
              >
                <figure class="dis-context__media">
                  <img src={c.image} alt={c.alt} loading="lazy" decoding="async" />
                </figure>
                <div class="dis-context__body">
                  <h3>{c.title}</h3>
                  <p>{c.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- BEYONDCOMPASS ---------- */}
    <section class="section section--alt dis-compass-section">
      <div class="container">
        <header class="section-header section-header--center dis-reveal">
          <span class="eyebrow">Notre différence</span>
          <h2>Chaque liste restreinte sort de Compass</h2>
          <p class="section-header__lead">
            Le sourcing de distributeurs en Chine se résume trop souvent à une liste ratissée sur
            1688 ou Alibaba, revendue avec une marge. Notre méthode diverge. Compass est le
            fichier de relations bâti sur quinze ans, depuis nos bureaux et nos relais :
            distributeurs, TP Tmall, partenaires Douyin, importateurs. Chaque contact a été qualifié
            à la main, rencontré en personne, tenu à jour.
          </p>
        </header>

        <article class="dis-compass dis-reveal">
          <div class="dis-compass__bg" aria-hidden="true"></div>
          <div class="dis-compass__grid">
            <div class="dis-compass__copy">
              <div class="dis-compass__head">
                <div class="dis-compass__logo">
                  <img
                    src="/Images/AgencyLogos/Compass%20-%20Horizontal.svg"
                    alt="Logo Compass"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <span class="dis-compass__chip">Notre fichier de partenaires</span>
              </div>

              <p class="dis-compass__pitch">
                Épargnez-vous trois mois de présentations stériles. Démarrez à partir d'un vivier de
                partenaires que nous connaissons déjà.
              </p>

              <p class="dis-compass__body">
                Les cabinets génériques ratissent 1688 et Alibaba, ajoutent une marge sur le fichier
                et présentent l'ensemble comme une liste restreinte triée sur le volet. Mille noms avant midi, à peine
                un pour votre catégorie. Notre méthode est ailleurs. Compass, ce sont quinze
                années de rencontres physiques, rafraîchies chaque trimestre, organisées par grande
                catégorie de consommation. Quand nos quatre filtres tombent sur la liste restreinte, ils
                s'appliquent à des partenaires que l'équipe connaît déjà par leur nom.
              </p>

              <ul class="dis-compass__stats">
                <li>
                  <span class="dis-compass__stat-num" data-counter="15" data-suffix="+">0</span>
                  <span class="dis-compass__stat-label">années de relations vérifiées</span>
                </li>
                <li>
                  <span class="dis-compass__stat-num">Toutes</span>
                  <span class="dis-compass__stat-label"
                    >les grandes catégories de consommation que nous opérons</span
                  >
                </li>
                <li>
                  <span class="dis-compass__stat-num">Zéro</span>
                  <span class="dis-compass__stat-label"
                    >commission auprès du distributeur. Jamais.</span
                  >
                </li>
              </ul>

              <div class="dis-compass__actions">
                <a
                  href="/compass"
                  class="btn dis-compass__btn-primary"
                >
                  Voir comment fonctionne Compass
                </a>
                <a href="/fr/nous-contacter" class="btn dis-compass__btn-ghost">
                  Nous confier votre brief
                </a>
              </div>
            </div>

            <div class="dis-compass__art" aria-hidden="true">
              <svg
                viewBox="0 0 440 480"
                xmlns="http://www.w3.org/2000/svg"
                role="img"
                aria-label="Pile de fiches partenaires validées avec badges de vérification et sceau 100% vetted"
              >
                <defs>
                  <pattern id="cmp-grid" width="22" height="22" patternUnits="userSpaceOnUse">
                    <circle cx="1" cy="1" r="1" fill="#C8102E" fill-opacity="0.10"></circle>
                  </pattern>
                  <linearGradient id="cmp-card-soft" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#13283b"></stop>
                    <stop offset="100%" stop-color="#0c1c2b"></stop>
                  </linearGradient>
                  <linearGradient id="cmp-card-active" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#C8102E"></stop>
                    <stop offset="100%" stop-color="#A50C26"></stop>
                  </linearGradient>
                  <linearGradient id="cmp-fade" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0e2030" stop-opacity="0"></stop>
                    <stop offset="100%" stop-color="#0e2030" stop-opacity="0.85"></stop>
                  </linearGradient>
                  <filter id="cmp-glow" x="-30%" y="-30%" width="160%" height="160%">
                    <feGaussianBlur stdDeviation="6"></feGaussianBlur>
                    <feMerge
                      ><feMergeNode></feMergeNode><feMergeNode in="SourceGraphic"
                      ></feMergeNode></feMerge
                    >
                  </filter>
                </defs>

                {/* Grid background */}
                <rect width="440" height="480" fill="url(#cmp-grid)"></rect>

                {/* Scraped pile (faded reject stack at the bottom) */}
                <g class="cmp-scraped" opacity="0.35">
                  <rect x="40" y="380" width="280" height="14" rx="4" fill="#3a4a5c"></rect>
                  <rect x="60" y="402" width="240" height="12" rx="4" fill="#33424f"></rect>
                  <rect x="48" y="422" width="270" height="11" rx="4" fill="#2b3946"></rect>
                  <rect x="70" y="441" width="200" height="10" rx="4" fill="#243140"></rect>
                  <line
                    x1="40"
                    y1="368"
                    x2="370"
                    y2="368"
                    stroke="#E84A60"
                    stroke-opacity="0.25"
                    stroke-dasharray="2 4"
                    stroke-width="1"></line>
                  <text
                    x="40"
                    y="362"
                    font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
                    font-size="10"
                    letter-spacing="0.12em"
                    font-weight="700"
                    fill="#E84A60"
                    fill-opacity="0.55">RATISSÉ, NON RETENU</text
                  >
                </g>
                <rect
                  x="0"
                  y="340"
                  width="440"
                  height="140"
                  fill="url(#cmp-fade)"
                  pointer-events="none"></rect>

                {/* Database label */}
                <text
                  x="40"
                  y="48"
                  font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
                  font-size="10"
                  letter-spacing="0.18em"
                  font-weight="700"
                  fill="#C8102E">FICHIER BEYONDCOMPASS</text
                >
                <line
                  x1="40"
                  y1="58"
                  x2="200"
                  y2="58"
                  stroke="#C8102E"
                  stroke-opacity="0.4"
                  stroke-width="1"></line>

                {/* Card 4 (back) */}
                <g class="cmp-card cmp-card--4" transform="translate(50 78)">
                  <rect
                    width="320"
                    height="56"
                    rx="10"
                    fill="url(#cmp-card-soft)"
                    stroke="#E84A60"
                    stroke-opacity="0.18"></rect>
                  <circle cx="30" cy="28" r="12" fill="#E84A60" fill-opacity="0.35"></circle>
                  <text
                    x="30"
                    y="32"
                    font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
                    font-size="11"
                    font-weight="700"
                    fill="#fff"
                    fill-opacity="0.55"
                    text-anchor="middle">M</text
                  >
                  <rect x="54" y="16" width="160" height="9" rx="2" fill="#fff" fill-opacity="0.45"
                  ></rect>
                  <rect x="54" y="32" width="100" height="7" rx="2" fill="#fff" fill-opacity="0.22"
                  ></rect>
                  <g class="cmp-check">
                    <circle cx="290" cy="28" r="11" fill="#C8102E"></circle>
                    <path
                      d="M284 28 l4 4 l8 -8"
                      stroke="#fff"
                      stroke-width="2.2"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </g>
                </g>

                {/* Card 3 */}
                <g class="cmp-card cmp-card--3" transform="translate(35 142)">
                  <rect
                    width="340"
                    height="58"
                    rx="10"
                    fill="url(#cmp-card-soft)"
                    stroke="#E84A60"
                    stroke-opacity="0.22"></rect>
                  <circle cx="32" cy="29" r="13" fill="#E84A60" fill-opacity="0.45"></circle>
                  <text
                    x="32"
                    y="33"
                    font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
                    font-size="12"
                    font-weight="700"
                    fill="#fff"
                    fill-opacity="0.7"
                    text-anchor="middle">J</text
                  >
                  <rect x="58" y="16" width="180" height="9" rx="2" fill="#fff" fill-opacity="0.6"
                  ></rect>
                  <rect x="58" y="33" width="120" height="7" rx="2" fill="#fff" fill-opacity="0.3"
                  ></rect>
                  <g class="cmp-check">
                    <circle cx="310" cy="29" r="12" fill="#C8102E"></circle>
                    <path
                      d="M304 29 l4 4 l8 -8"
                      stroke="#fff"
                      stroke-width="2.2"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </g>
                </g>

                {/* Card 2 */}
                <g class="cmp-card cmp-card--2" transform="translate(50 210)">
                  <rect
                    width="320"
                    height="58"
                    rx="10"
                    fill="url(#cmp-card-soft)"
                    stroke="#E84A60"
                    stroke-opacity="0.3"></rect>
                  <circle cx="32" cy="29" r="13" fill="#E84A60" fill-opacity="0.6"></circle>
                  <text
                    x="32"
                    y="33"
                    font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
                    font-size="12"
                    font-weight="700"
                    fill="#fff"
                    fill-opacity="0.85"
                    text-anchor="middle">Z</text
                  >
                  <rect x="58" y="16" width="170" height="9" rx="2" fill="#fff" fill-opacity="0.75"
                  ></rect>
                  <rect x="58" y="33" width="110" height="7" rx="2" fill="#fff" fill-opacity="0.38"
                  ></rect>
                  <g class="cmp-check">
                    <circle cx="290" cy="29" r="12" fill="#C8102E"></circle>
                    <path
                      d="M284 29 l4 4 l8 -8"
                      stroke="#fff"
                      stroke-width="2.2"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </g>
                </g>

                {/* Card 1 (front, highlighted) */}
                <g
                  class="cmp-card cmp-card--1"
                  transform="translate(28 278)"
                  filter="url(#cmp-glow)"
                >
                  <rect width="360" height="68" rx="12" fill="url(#cmp-card-active)"></rect>
                  <circle cx="36" cy="34" r="16" fill="#fff" fill-opacity="0.95"></circle>
                  <text
                    x="36"
                    y="39"
                    font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
                    font-size="14"
                    font-weight="700"
                    fill="#A50C26"
                    text-anchor="middle">å¤©</text
                  >
                  <rect x="64" y="19" width="200" height="11" rx="2" fill="#fff" fill-opacity="0.96"
                  ></rect>
                  <rect x="64" y="38" width="140" height="9" rx="2" fill="#fff" fill-opacity="0.65"
                  ></rect>
                  <g class="cmp-check cmp-check--big">
                    <circle cx="328" cy="34" r="15" fill="#fff"></circle>
                    <path
                      d="M320 34 l5 5 l11 -10"
                      stroke="#C8102E"
                      stroke-width="3"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </g>
                  {/* "live / kept current" pulse dot */}
                  <circle class="cmp-live" cx="349" cy="13" r="4" fill="#E84A60"></circle>
                </g>

                {/* 100% VETTED seal, outside the cards, top-right */}
                <g class="cmp-seal" transform="translate(322 24)">
                  <circle
                    cx="46"
                    cy="46"
                    r="46"
                    fill="none"
                    stroke="#E84A60"
                    stroke-opacity="0.5"
                    stroke-width="1"
                    stroke-dasharray="3 5"></circle>
                  <circle
                    cx="46"
                    cy="46"
                    r="36"
                    fill="#0a1a28"
                    stroke="#E84A60"
                    stroke-opacity="0.6"
                    stroke-width="1.5"></circle>
                  <text
                    x="46"
                    y="40"
                    font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
                    font-size="14"
                    font-weight="800"
                    fill="#fff"
                    text-anchor="middle"
                    letter-spacing="0.04em">100%</text
                  >
                  <line
                    x1="22"
                    y1="46"
                    x2="70"
                    y2="46"
                    stroke="#E84A60"
                    stroke-opacity="0.5"
                    stroke-width="1"></line>
                  <text
                    x="46"
                    y="60"
                    font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
                    font-size="9"
                    font-weight="700"
                    fill="#C8102E"
                    text-anchor="middle"
                    letter-spacing="0.22em">VÉRIFIÉS</text
                  >
                </g>
              </svg>

              <ul class="dis-compass__art-key">
                <li>
                  <span class="dis-compass__art-dot dis-compass__art-dot--vetted"></span>Vérifiés à
                  la main, rencontrés en personne
                </li>
                <li>
                  <span class="dis-compass__art-dot dis-compass__art-dot--live"></span>Relations
                  tenues à jour
                </li>
                <li>
                  <span class="dis-compass__art-dot dis-compass__art-dot--reject"></span>Listes
                  ratissées, hors de notre fichier
                </li>
              </ul>
            </div>
          </div>
        </article>

        <div class="dis-compass-tiers">
          <article class="dis-compass-tier dis-reveal">
            <span class="dis-compass-tier__label">Shortlist</span>
            <p class="dis-compass-tier__lead">
              Trois à cinq noms vérifiés, calibrés sur votre catégorie et votre maturité. Livraison
              en deux à trois semaines.
            </p>
            <span class="dis-compass-tier__when"
              >Lorsque le brief est arrêté et que les introductions doivent suivre, vite.</span
            >
          </article>
          <article class="dis-compass-tier dis-reveal" style="--reveal-delay: 80ms;">
            <span class="dis-compass-tier__label">Cartographie marché</span>
            <p class="dis-compass-tier__lead">
              Quinze à vingt options comparables sur le paysage concurrentiel. Livraison en trois à
              six semaines.
            </p>
            <span class="dis-compass-tier__when"
              >Lorsque la vue d'ensemble s'impose avant tout engagement.</span
            >
          </article>
          <article class="dis-compass-tier dis-reveal" style="--reveal-delay: 160ms;">
            <span class="dis-compass-tier__label">Remplacement</span>
            <p class="dis-compass-tier__lead">
              Sortir d'un partenaire en sous-performance. Sourcer son successeur. Piloter la
              bascule.
            </p>
            <span class="dis-compass-tier__when"
              >Lorsque la relation s'enlise et qu'une sortie propre s'impose.</span
            >
          </article>
        </div>
      </div>
    </section>

    {/* ---------- BUSINESS MODELS (tabbed showcase) ---------- */}
    <section class="section dis-models-section">
      <div class="dis-models-section__bg" aria-hidden="true">
        <img src="/Images/enter-china/four-ways-tiles.png" alt="" loading="lazy" decoding="async" />
      </div>
      <div class="container">
        <header class="section-header section-header--center dis-reveal">
          <span class="eyebrow">Deux façons de travailler avec nous</span>
          <h2>Le bon partenaire trouvé, calibrez la part que nous prenons</h2>
          <p class="section-header__lead">
            Les deux missions empruntent le même cheminement de sourcing : brief, longue liste
            extraite de Compass, liste restreinte, due diligence, négociation. C'est
            l'après-signature qui les distingue.
          </p>
        </header>

        <div class="dis-routes dis-reveal">
          {
            models.map((m, i) => (
              <article
                class={`dis-route${m.highlight ? ' dis-route--featured' : ''}`}
                style={`--reveal-delay: ${i * 100}ms;`}
              >
                <div class="dis-route__media">
                  <img src={m.image} alt={m.imageAlt} loading="lazy" decoding="async" />
                  <span class="dis-route__pill">{m.name}</span>
                </div>

                <div class="dis-route__body">
                  <header class="dis-route__head">
                    <h3 class="dis-route__title">{m.tag}</h3>
                    <p class="dis-route__tagline">{m.tagline}</p>
                  </header>

                  <p class="dis-route__desc">{m.desc}</p>

                  <div
                    class="dis-route__split"
                    aria-label={`Répartition opérationnelle : vous ${m.split.you}%, ${m.split.themLabel.toLowerCase()} ${m.split.them}%`}
                  >
                    <div class="dis-route__split-labels">
                      <span>
                        <strong>Vous</strong> {m.split.you}%
                      </span>
                      <span class="dis-route__split-label-end">
                        {m.split.themLabel} <strong>{m.split.them}%</strong>
                      </span>
                    </div>
                    <div class="dis-route__split-bar">
                      <span class="dis-route__split-bar-you" style={`--w: ${m.split.you}%;`} />
                      <span class="dis-route__split-bar-them" style={`--w: ${m.split.them}%;`} />
                    </div>
                    <span class="dis-route__split-caption">Qui pilote l'opération Chine</span>
                  </div>

                  <ul class="dis-route__dims">
                    {m.dims.map((d) => (
                      <li class="dis-route__dim">
                        <span class="dis-route__dim-label">{d.label}</span>
                        <span
                          class="dis-route__dim-dots"
                          aria-label={`${d.value}, ${d.level} sur 5`}
                        >
                          {[1, 2, 3, 4, 5].map((n) => (
                            <span class={`dis-route__dim-dot${n <= d.level ? ' is-on' : ''}`} />
                          ))}
                        </span>
                        <span class="dis-route__dim-value">{d.value}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="dis-route__lists">
                    <div class="dis-route__list">
                      <span class="dis-route__list-label">Vous recevez</span>
                      <ul>
                        {m.youGet.map((b) => (
                          <li>
                            <span class="dis-route__check" aria-hidden="true">
                              <svg
