    .dis-compass__btn-primary:hover .dis-compass__btn-arrow {
      transform: translate(2px, -2px);
    }
    .dis-compass__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.4);
      color: var(--bbg-white);
    }
    .dis-compass__btn-ghost:hover {
