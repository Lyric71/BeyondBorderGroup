    }
    .dis-faq__item:hover {
      transform: translateX(2px);
      border-color: rgba(200, 16, 46, 0.4);
    }
    .dis-faq__item[open] {
      border-color: var(--bbg-blue);
      box-shadow: 0 8px 22px -14px rgba(200, 16, 46, 0.4);
    }
    .dis-faq__item.is-hidden {
      display: none;
    }
    .dis-faq__q {
      cursor: pointer;
      padding: var(--space-5);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      font-weight: 600;
      font-size: 1.0625rem;
      line-height: 1.3;
      color: var(--bbg-ink);
      list-style: none;
      transition: color var(--dur) var(--ease);
    }
    .dis-faq__q::-webkit-details-marker {
      display: none;
    }
    .dis-faq__q::marker {
      display: none;
    }
    .dis-faq__item:hover .dis-faq__q {
      color: var(--bbg-blue);
    }
    .dis-faq__cat-tag {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 0.25em 0.6em;
      border-radius: 4px;
      margin-right: var(--space-3);
      flex-shrink: 0;
    }
    .dis-faq__q-text {
      flex-grow: 1;
    }
    .dis-faq__icon {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        color var(--dur) var(--ease),
        background var(--dur) var(--ease);
    }
    .dis-faq__item[open] .dis-faq__icon {
      transform: rotate(180deg);
      color: var(--bbg-white);
      background: var(--bbg-blue);
    }
    .dis-faq__a {
      padding: 0 var(--space-5) var(--space-5);
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
      animation: dis-faq-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes dis-faq-in {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
