---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allCases = await getCollection('casesFr', ({ data }) => !data.draft);

const sorted = allCases.sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return a.data.brand.localeCompare(b.data.brand);
});

const categoryOrder = [
  'Brand & Design',
  'Social & Content',
  'eCommerce',
  'Website',
  'Distribution',
  'Training',
] as const;

const categoryLabelsFr: Record<(typeof categoryOrder)[number], string> = {
  'Brand & Design': 'Marque et design',
  'Social & Content': 'Social et contenus',
  eCommerce: 'eCommerce',
  Website: 'Sites web',
  Distribution: 'Distribution',
  Training: 'Formation',
};

const counts = categoryOrder
  .map((c) => ({ name: c, count: sorted.filter((x) => x.data.category === c).length }))
  .filter((c) => c.count > 0);

// WO-P5. Second filter axis: the client sector, stored as the English key on
// every locale and labelled here.
const industryOrder = [
  "Automotive",
  "Beauty & Personal Care",
  "Food & Beverage",
  "Hospitality & Travel",
  "Home & Design",
  "Financial Services",
  "Healthcare",
  "Fashion & Footwear",
  "Digital Services",
] as const;
const industryLabels: Record<(typeof industryOrder)[number], string> = {
  "Automotive": "Automobile",
  "Beauty & Personal Care": "Beauté et cosmétiques",
  "Food & Beverage": "Agroalimentaire",
  "Hospitality & Travel": "Hôtellerie et voyage",
  "Home & Design": "Maison et design",
  "Financial Services": "Services financiers",
  "Healthcare": "Santé",
  "Fashion & Footwear": "Mode et chaussure",
  "Digital Services": "Services numériques",
};
const industryCounts = industryOrder
  .map((i) => ({ name: i, count: sorted.filter((x) => x.data.industry === i).length }))
  .filter((c) => c.count > 0);
---

<Layout
  title="Études de cas de notre agence en Chine | TheChinaPath"
  description="Études de cas marketing, e-commerce et distribution conduites en Chine par notre agence pour des marques internationales. Tmall, JD, Douyin, WeChat et RED."
>
  <section class="work-intro">
    <div class="container">
      <span class="eyebrow">Nos réalisations</span>
      <h1>Installer les marques internationales sur le marché chinois</h1>
      <p class="lead">
        Sélection de missions menées pour nos clients en marketing, eCommerce et distribution.
        Lancements de marque, opérations sur Tmall et JD, social commerce sur Douyin, WeChat et
        Xiaohongshu, distribution retail, sites web pensés pour l'internet chinois, formation des
        équipes qui découvrent le marché.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        counts.length > 1 && (
          <div class="work-filter" role="tablist" aria-label="Filtrer par expertise">
            <button
              type="button"
              class="work-filter__btn is-active"
              data-category="all"
              role="tab"
              aria-selected="true"
            >
              Tout <span class="work-filter__count">{sorted.length}</span>
            </button>
            {counts.map((c) => (
              <button
                type="button"
                class="work-filter__btn"
                data-category={c.name}
                role="tab"
                aria-selected="false"
              >
                {categoryLabelsFr[c.name]} <span class="work-filter__count">{c.count}</span>
              </button>
            ))}
          </div>
        )
      }

      {
        industryCounts.length > 1 && (
          <div class="work-filter work-filter--industry" role="tablist" aria-label="Filtrer par secteur">
            <button
              type="button"
              class="work-filter__btn is-active"
              data-industry="all"
              role="tab"
              aria-selected="true"
            >
              Tous les secteurs
            </button>
            {industryCounts.map((c) => (
              <button
                type="button"
                class="work-filter__btn"
                data-industry={c.name}
                role="tab"
                aria-selected="false"
              >
                {industryLabels[c.name]} <span class="work-filter__count">{c.count}</span>
              </button>
            ))}
          </div>
        )
      }

      <div class="grid grid-3 work-grid">
        {
          sorted.map((c) => (
            <a
              href={`/fr/nos-realisations/${c.id}`}
              class="work-card"
              data-category={c.data.category}
              data-industry={c.data.industry ?? ''}
            >
              <div class="work-card__image">
                <img
                  src={c.data.heroImage}
                  alt={c.data.heroImageAlt || `Étude de cas ${c.data.brand}`}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="400"
                />
              </div>
              <div class="work-card__body">
                <span class="work-card__tag">{categoryLabelsFr[c.data.category]}</span>
                <h3 class="work-card__title">{c.data.brand}</h3>
                <p class="work-card__summary">{c.data.title}</p>
                {c.data.services.length > 0 && (
                  <ul class="work-card__services" aria-label="Services">
                    {c.data.services.slice(0, 4).map((s) => (
                      <li>{s}</li>
                    ))}
                    {c.data.services.length > 4 && (
                      <li class="work-card__services-more">+{c.data.services.length - 4}</li>
                    )}
                  </ul>
                )}
              </div>
            </a>
          ))
        }
      </div>

      {
        sorted.length === 0 && (
          <p class="work-empty">
            La reprise de nos archives est en cours. De nouvelles études de cas seront mises en
            ligne dans les prochains jours.
          </p>
        )
      }
    </div>
  </section>

  <section class="section section--alt section--tight">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__copy">
          <span class="eyebrow">Nous écrire</span>
          <h2>Inscrivez la prochaine étape de votre marque sur cette page.</h2>
          <p class="cta-card__lead">
            Décrivez votre situation actuelle et le terrain que vous souhaitez couvrir. Un associé
            du cabinet vous répondra personnellement, sans formulaire automatisé.
          </p>
          <div class="cta-card__actions">
            <a href="/fr/nous-contacter" class="btn btn--primary">Engager l'échange</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const grid = document.querySelector('.work-grid');
      if (!grid) return;
      const cards = Array.from(grid.children);
      for (let i = cards.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [cards[i], cards[j]] = [cards[j], cards[i]];
      }
      const frag = document.createDocumentFragment();
      cards.forEach((c) => frag.appendChild(c));
      grid.appendChild(frag);
    })();

    // WO-P5. Two axes, service and industry, combined with AND. Every card is
// in the HTML before this runs, so the unfiltered list is crawlable.
const state = { category: 'all', industry: 'all' };
    const applyFilters = () => {
      document.querySelectorAll('.work-card').forEach((card) => {
        const okCategory = state.category === 'all' || card.dataset.category === state.category;
        const okIndustry = state.industry === 'all' || card.dataset.industry === state.industry;
        card.style.display = okCategory && okIndustry ? '' : 'none';
      });
    };
    document.querySelectorAll('.work-filter__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const axis = btn.dataset.industry !== undefined ? 'industry' : 'category';
        state[axis] = axis === 'industry' ? btn.dataset.industry : btn.dataset.category;
        const row = btn.closest('.work-filter');
        (row ? row.querySelectorAll('.work-filter__btn') : []).forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        applyFilters();
      });
    });
  </script>

  <style>
    .work-intro {
      padding: var(--space-8) 0 var(--space-6);
      text-align: center;
    }
    .work-intro .eyebrow {
      display: inline-block;
      margin-bottom: var(--space-4);
    }
    .work-intro h1 {
      max-width: 22ch;
      margin-inline: auto;
      margin-bottom: var(--space-4);
    }
    .work-intro .lead {
      max-width: 66ch;
      margin-inline: auto;
      color: var(--bbg-text);
    }

    .work-filter {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      justify-content: center;
      margin-bottom: var(--space-7);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--bbg-border);
    }
    .work-filter--industry {
      margin-top: var(--space-3);
    }
    .work-filter__btn {
      appearance: none;
      border: 1px solid var(--bbg-border);
      background: transparent;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--bbg-text-muted);
      cursor: pointer;
      transition: all var(--dur) var(--ease);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .work-filter__btn:hover {
      border-color: var(--bbg-blue);
      color: var(--bbg-blue);
    }
    .work-filter__btn.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }
    .work-filter__count {
      font-size: 0.75rem;
      font-weight: 600;
      opacity: 0.7;
    }
    .work-filter__btn.is-active .work-filter__count {
      opacity: 0.9;
    }

    .work-grid {
      gap: var(--space-6) var(--space-5);
    }

    .work-empty {
      text-align: center;
      color: var(--bbg-text-muted);
      padding: var(--space-8) 0;
    }
  </style>
</Layout>
