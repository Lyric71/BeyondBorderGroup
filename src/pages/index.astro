      flex-wrap: wrap;
      gap: var(--space-3);
      margin-bottom: var(--space-6);
    }

    .home-hero__meta {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(var(--space-4), 4vw, var(--space-7));
      padding-top: var(--space-5);
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      max-width: 760px;
    }
    .home-hero__meta-item { display: flex; flex-direction: column; gap: 0.2rem; }
    .home-hero__meta-num {
      font-size: clamp(1.625rem, 1.2vw + 1rem, 2.125rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1;
      color: var(--bbg-white);
      font-feature-settings: "tnum";
    }
    .home-hero__meta-label {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.66);
      letter-spacing: 0.02em;
    }

    .home-hero__scroll {
      position: absolute;
      bottom: var(--space-5);
      right: clamp(var(--space-5), 4vw, var(--space-7));
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      transition: color 200ms ease;
    }
    .home-hero__scroll:hover { color: var(--bbg-white); }
    .home-hero__scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.6) 100%);
      position: relative;
      overflow: hidden;
    }
    .home-hero__scroll-line::after {
      content: "";
      position: absolute;
      top: -100%;
      left: 0;
      right: 0;
      height: 50%;
      background: linear-gradient(180deg, transparent 0%, var(--bbg-white) 100%);
      animation: home-scroll-tick 1.8s ease-in-out infinite;
    }
    @keyframes home-scroll-tick {
      0% { top: -50%; }
      100% { top: 100%; }
    }
    @media (max-width: 720px) {
      .home-hero__scroll { display: none; }
      .home-hero__meta { gap: var(--space-4); }
    }
  </style>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Reveal on scroll
      const revealEls = document.querySelectorAll('.home-reveal');
      if (revealEls.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          revealEls.forEach((el) => io.observe(el));
        }
      }

      // Animated counters in the hero meta strip
      const counters = document.querySelectorAll('[data-home-counter]');
      if (counters.length && !reduced && 'IntersectionObserver' in window) {
        const animate = (el) => {
          const target = parseFloat(el.dataset.homeCounter || '0');
          const suffix = el.dataset.suffix || '';
          const duration = 1400;
          const start = performance.now();
          const tick = (now) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = Math.round(target * eased);
            el.textContent = value + suffix;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const counterIo = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              animate(entry.target);
              counterIo.unobserve(entry.target);
            }
          });
        }, { threshold: 0.5 });
        counters.forEach((el) => counterIo.observe(el));
      } else {
        counters.forEach((el) => {
          el.textContent = (el.dataset.homeCounter || '0') + (el.dataset.suffix || '');
        });
      }

      // Hero parallax + scroll progress bar (single rAF loop)
      const parallaxImg = document.querySelector('[data-home-parallax] img');
      const progressEl = document.querySelector('.home-progress__bar');
      const heroEl = document.querySelector('[data-home-hero]');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;
          if (parallaxImg && heroEl && !reduced) {
            const heroH = heroEl.offsetHeight;
            if (scrollY < heroH) {
              parallaxImg.style.setProperty('--parallax-y', (scrollY * 0.18) + 'px');
            }
          }
          if (progressEl) {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
            progressEl.style.setProperty('--progress', pct + '%');
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Smooth-scroll the hero anchor
      const scrollLink = document.querySelector('.home-hero__scroll');
      if (scrollLink) {
        scrollLink.addEventListener('click', (e) => {
          const id = scrollLink.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        });
      }
    })();
  </script>

  <script is:inline>
    document.querySelectorAll('.pillar-item__head').forEach((head) => {
      head.addEventListener('click', () => {
        const item = head.closest('.pillar-item');
        const parent = item.parentElement;
        parent.querySelectorAll('.pillar-item.is-open').forEach((open) => {
          if (open !== item) open.classList.remove('is-open');
        });
        item.classList.toggle('is-open');

        const key = item.dataset.pillar;
        const isOpen = item.classList.contains('is-open');
        if (key && isOpen) {
          document.querySelectorAll('[data-pillar-media]').forEach((frame) => {
            frame.classList.toggle('is-active', frame.dataset.pillarMedia === key);
          });
        }
      });
    });

    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const tabs = Array.from(document.querySelectorAll('.svc-tab'));
      const indicator = document.querySelector('.svc-tabs__indicator');

      const moveIndicator = (tab) => {
        if (!indicator || !tab) return;
        const parent = tab.parentElement;
        const pRect = parent.getBoundingClientRect();
        const tRect = tab.getBoundingClientRect();
        indicator.style.setProperty('--x', (tRect.left - pRect.left) + 'px');
        indicator.style.setProperty('--w', tRect.width + 'px');
      };

      const setActive = (tab) => {
        const stage = tab.dataset.stage;
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        document.querySelectorAll('.svc-panel').forEach((p) => {
          const on = p.dataset.stage === stage;
          p.classList.toggle('is-active', on);
          if (on) {
            const tiles = p.querySelectorAll('[data-svc-tile]');
            tiles.forEach((tile) => {
              tile.classList.remove('is-in');
              void tile.offsetWidth;
              tile.classList.add('is-in');
            });
          }
        });
        moveIndicator(tab);
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => setActive(tab));
      });

      const active = document.querySelector('.svc-tab.is-active');
      if (active) requestAnimationFrame(() => moveIndicator(active));
      window.addEventListener('resize', () => {
        const a = document.querySelector('.svc-tab.is-active');
        if (a) moveIndicator(a);
      });

      // Tiles: scroll reveal + mouse spotlight + 3D tilt + image parallax
      const tiles = document.querySelectorAll('[data-svc-tile]');
      if (tiles.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          tiles.forEach((t) => t.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
          tiles.forEach((tile) => io.observe(tile));
        }

        tiles.forEach((tile) => {
          if (reduced) return;
          const img = tile.querySelector('[data-svc-parallax] img');

          tile.addEventListener('pointermove', (e) => {
            const r = tile.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width;
            const y = (e.clientY - r.top) / r.height;
            tile.style.setProperty('--mx', (x * 100) + '%');
            tile.style.setProperty('--my', (y * 100) + '%');
            const rx = (0.5 - y) * 6;
            const ry = (x - 0.5) * 8;
            tile.style.setProperty('--rx', rx + 'deg');
            tile.style.setProperty('--ry', ry + 'deg');
            if (img) {
              const px = (x - 0.5) * -10;
              const py = (y - 0.5) * -10;
              img.style.setProperty('--px', px + 'px');
              img.style.setProperty('--py', py + 'px');
            }
          });
          tile.addEventListener('pointerleave', () => {
            tile.style.setProperty('--mx', '50%');
            tile.style.setProperty('--my', '50%');
            tile.style.setProperty('--rx', '0deg');
            tile.style.setProperty('--ry', '0deg');
            if (img) {
              img.style.setProperty('--px', '0px');
              img.style.setProperty('--py', '0px');
            }
          });
        });

        // Image scroll-parallax inside each tile (subtle)
        if (!reduced) {
          const parallaxImgs = document.querySelectorAll('[data-svc-parallax] img');
          let parallaxTicking = false;
          const updateParallax = () => {
            parallaxImgs.forEach((img) => {
              const frame = img.parentElement;
              const r = frame.getBoundingClientRect();
              const vh = window.innerHeight;
              if (r.bottom < 0 || r.top > vh) return;
              const center = r.top + r.height / 2;
              const ratio = (center - vh / 2) / vh;
              const shift = Math.max(-14, Math.min(14, ratio * -22));
              img.style.setProperty('--sy', shift + 'px');
            });
            parallaxTicking = false;
          };
          window.addEventListener('scroll', () => {
            if (parallaxTicking) return;
            parallaxTicking = true;
            requestAnimationFrame(updateParallax);
          }, { passive: true });
          updateParallax();
        }
      }
    })();

    // BeyondCompass: trigger stagger animation when section enters viewport
    (() => {
      const bc = document.querySelector('[data-bc-section]');
      if (!bc) return;
      if (!('IntersectionObserver' in window)) {
        bc.classList.add('is-in');
        return;
      }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            bc.classList.add('is-in');
            io.unobserve(bc);
          }
        });
      }, { threshold: 0.2, rootMargin: '0px 0px -10% 0px' });
      io.observe(bc);
    })();
  </script>

</Layout>
