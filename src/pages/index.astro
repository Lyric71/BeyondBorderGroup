};

const allCases = await getCollection('cases', ({ data }) => !data.draft);
const featuredCases = allCases
  .slice()
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const allInsights = await getCollection('insights', ({ data }) => !data.draft);
const latestInsights = allInsights
  .slice()
  .sort((a, b) => {
    const da = a.data.pubDate?.valueOf() ?? 0;
    const db = b.data.pubDate?.valueOf() ?? 0;
    return db - da;
  })
  .slice(0, 3);

function readingTime(body: string | undefined) {
  if (!body) return '';
  const words = body.trim().split(/\s+/).length;
  return `${Math.max(1, Math.round(words / 200))} min read`;
}

function formatInsightDate(d?: Date) {
  if (!d) return '';
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}

---

<Layout
  title="China Marketing & eCommerce Agency | TheChinaPath"
  description="Marketing, eCommerce and distribution agency for foreign brands in China. We run Tmall, JD, Douyin, WeChat and RED day to day. Shanghai, Hong Kong, Paris."
  preloadImage="/Images/hero-livestream.webp"
>

  {/* ---------- SCROLL PROGRESS ---------- */}
  <div class="home-progress" aria-hidden="true"><div class="home-progress__bar"></div></div>

  {/* ---------- HERO ---------- */}
  <section class="home-hero" data-home-hero>
    <div class="home-hero__bg" aria-hidden="true" data-home-parallax>
      <picture>
        <source srcset="/Images/hero-livestream.webp" type="image/webp" />
        <img
          src="/Images/hero-livestream.jpg"
          alt="Chinese livestream commerce host on set, demonstrating products to a connected studio audience"
          width="1376"
          height="768"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>
    <div class="home-hero__overlay" aria-hidden="true"></div>
    <div class="home-hero__grain" aria-hidden="true"></div>

    <div class="container home-hero__inner">
      <span class="eyebrow eyebrow--on-dark home-reveal">Marketing and eCommerce in China</span>
      <h1 class="home-hero__title home-reveal" style="--reveal-delay: 80ms;">
        <span class="home-hero__title-row">Sell in China.</span>
        <span class="home-hero__title-row home-hero__title-row--accent">Grow in China.</span>
        <span class="home-hero__title-row home-hero__title-row--highlight">Understand China.</span>
      </h1>
      <p class="home-hero__lead home-reveal" style="--reveal-delay: 200ms;">
        We get brands and companies earning revenue in China. Stores on Tmall and JD,
        social commerce on Douyin and RED, the right distributor for your category.
      </p>
      <div class="home-hero__actions home-reveal" style="--reveal-delay: 280ms;">
        <a class="btn btn--primary home-magnetic" href="/contact">Talk to us</a>
        <a class="btn btn--ghost-light home-magnetic" href="/work">See our work</a>
      </div>

      <div class="home-hero__meta home-reveal" style="--reveal-delay: 360ms;">
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num" data-home-counter="20" data-suffix="+">20+</span>
          <span class="home-hero__meta-label">years in China</span>
        </div>
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num" data-home-counter="75" data-suffix="+">75+</span>
          <span class="home-hero__meta-label">brand launches</span>
        </div>
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num">Millions</span>
          <span class="home-hero__meta-label">of GMV under management</span>
        </div>
      </div>
    </div>

    <a href="#day-commerce" class="home-hero__scroll" aria-label="Scroll to next section">
      <span class="home-hero__scroll-line"></span>
      <span class="home-hero__scroll-text">Scroll</span>
    </a>
  </section>

  {/* ---------- DAY IN CHINESE COMMERCE ---------- */}
  <section id="day-commerce" class="section day-timeline-section">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">A day in Chinese commerce</span>
        <h2>Your brand, every moment of the day</h2>
        <p class="section-header__lead">
          Chinese consumers jump between half a dozen apps before lunch. Each one has its own audience and its own rules for selling.
        </p>
      </header>

      <ol class="day-timeline" aria-label="A day with Chinese consumer platforms">
        {dayStops.map((s) => (
          <li class="day-stop">
            <figure class="day-stop__photo">
              <img src={s.photo} alt="" width="800" height="600" loading="lazy" decoding="async" />
            </figure>
            <div class="day-stop__info">
              <span class="day-stop__time">{s.time}</span>
              <span class="day-stop__moment">{s.moment}</span>
              <span class="day-stop__platform">
                <img class="day-stop__logo" src={s.logo} alt="" width="48" height="48" loading="lazy" decoding="async" />
                <span class="day-stop__platform-text">
                  <span class="day-stop__name">{s.name}</span>
                  <span class="day-stop__zh">{s.zh}</span>
                </span>
              </span>
            </div>
          </li>
        ))}
      </ol>

      <div class="day-timeline__cta">
        <a href="#services" class="btn btn--primary">Discover our services</a>
        <p class="day-timeline__cta-note">
          The playbook changes by platform. See how we help brands show up on each one.
        </p>
      </div>
    </div>
  </section>

  {/* ---------- PILLARS: CINEMATIC EXPANDING PANELS ---------- */}
  <section id="pillars" class="section section--alt pillars-section">
    <div class="pillars-bg" aria-hidden="true">
      <div class="pillars-bg__grid"></div>
      <div class="pillars-bg__glow"></div>
    </div>
    <div class="container">
      <header class="pillars-header">
        <span class="eyebrow">Where to start</span>
        <h2 class="pillars-header__title">China is not one problem to solve</h2>
        <p class="pillars-header__lead">
          Three ways in. Pick the one that matches where you actually are, not where you wish you were.
        </p>
      </header>

      <div class="stage-panels" data-active="enter" data-stage-panels>
        {pillars.map((p, i) => (
          <article class={`stage-panel${i === 0 ? ' is-active' : ''}`} data-stage={p.key} style={`--stage-index: ${i};`}>
            <button
              class="stage-panel__hit"
              type="button"
              data-stage-trigger={p.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-label={`Show ${p.title}`}
            ></button>
            <img class="stage-panel__img" src={p.image} alt={p.imageAlt} width="800" height="1000" loading="lazy" decoding="async" />
            <div class="stage-panel__scrim" aria-hidden="true"></div>
            <span class="stage-panel__rail" aria-hidden="true"></span>

            <div class="stage-panel__top">
              <span class="stage-panel__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={pillarIcons[p.key]} />
              </span>
              <span class="stage-panel__plus" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </span>
            </div>

            <span class="stage-panel__hint" aria-hidden="true">
              <span class="stage-panel__hint-text">Open</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>

            <div class="stage-panel__body">
              <span class="stage-panel__eyebrow">{p.stage}</span>
              <h3 class="stage-panel__title">{p.title}</h3>
              <div class="stage-panel__reveal">
                <p class="stage-panel__lead">{p.lead}</p>
                <ul class="stage-panel__tactics" aria-label="What this includes">
