          </div>
        </div>

        {/* ----- Capability ribbon ----- */}
        <div class="studio__ribbon" aria-hidden="true">
          <div class="studio__ribbon-track">
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Photo</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Film</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Livestream</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>AI pipelines</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Packaging</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>OOH</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Brand visuals</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Social-first edits</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Photo</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Film</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Livestream</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>AI pipelines</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Packaging</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>OOH</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Brand visuals</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Social-first edits</span>
          </div>
        </div>

        {/* ----- Footer CTA ----- */}
        <div class="studio__foot" data-reveal>
          <a
            class="studio__cta"
            href="/grow-in-china/production-studio"
          >
            <span class="studio__cta-text">See the production work</span>
            <span class="studio__cta-arrow" aria-hidden="true">
              <svg width="22" height="14" viewBox="0 0 22 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 7H21M21 7L15 1M21 7L15 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
          <a
            class="studio__cta studio__cta--secondary"
            href="https://hubstudio.ai"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="studio__cta-text">Or visit hubstudio.ai</span>
            <span class="studio__cta-external" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- OUR WORK ---------- */}
  <section class="section section--alt">
    <div class="container">
      <header class="section-header section-header--split">
        <div>
          <span class="eyebrow">Our work</span>
          <h2>Brands we've built in China</h2>
        </div>
        <a href="/work" class="btn btn--secondary btn--sm">See all case studies</a>
      </header>

      <div class="grid grid-3">
        {featuredCases.map((c) => (
          <a href={`/work/${c.id}`} class="work-card">
            <div class="work-card__image">
              <img
                src={c.data.heroImage}
                alt={c.data.heroImageAlt || `${c.data.brand} case study`}
                loading="lazy"
                decoding="async"
                width="600"
                height="400"
              />
            </div>
            <div class="work-card__body">
              <span class="work-card__tag">{c.data.category}</span>
              <h3 class="work-card__title">{c.data.brand}</h3>
              <p class="work-card__summary">{c.data.title}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- INSIGHTS ---------- */}
  <section class="section">
    <div class="container">
      <header class="insights-header">
        <span class="insights-header__rule" aria-hidden="true"></span>
        <span class="eyebrow">Insights</span>
        <h2>What our team is reading the market on right now</h2>
      </header>

      <div class="grid grid-3">
        {latestInsights.map((post) => (
          <a href={`/insights/${post.id}`} class="insight-card">
            <div class="insight-card__image">
              {post.data.heroImage && (
                <img
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="400"
                />
              )}
            </div>
            <div class="insight-card__body">
              <span class="insight-card__tag">{post.data.category}</span>
              <h3 class="insight-card__title">{post.data.title}</h3>
              <div class="insight-card__meta">
                <span>{readingTime(post.body)}</span>
                {post.data.pubDate && (
                  <>
                    <span class="insight-card__meta-sep" aria-hidden="true">|</span>
                    <span>{formatInsightDate(post.data.pubDate)}</span>
                  </>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- FINAL CTA CARD ---------- */}
  <section class="section section--tight">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__copy">
          <span class="eyebrow">Say hi</span>
          <h2>Thinking about China? Let's have a coffee.</h2>
          <p class="cta-card__lead">
            Tell us where you are today and where you would like to be. You will hear back
            from a senior member of the team, not a chatbot or a sales funnel.
          </p>
          <div class="cta-card__actions">
            <a href="/contact" class="btn btn--primary">Start the conversation</a>
          </div>
        </div>

        <div class="cta-card__visual" aria-hidden="true">
          <div class="hello-stack">
            <article class="hello-card hello-card--1">
              <header class="hello-card__head">
                <span class="hello-card__avatar">上</span>
                <div>
                  <span class="hello-card__city">Shanghai</span>
                  <span class="hello-card__role">Operations</span>
                </div>
                <span class="hello-card__dot" title="online"></span>
              </header>
              <p class="hello-card__hi"><span class="hello-card__zh">你好</span> <span class="hello-card__latin">Nǐ hǎo</span></p>
            </article>

            <article class="hello-card hello-card--2">
              <header class="hello-card__head">
                <span class="hello-card__avatar">港</span>
                <div>
                  <span class="hello-card__city">Hong Kong</span>
                  <span class="hello-card__role">Cross-border</span>
                </div>
                <span class="hello-card__dot" title="online"></span>
              </header>
              <p class="hello-card__hi"><span class="hello-card__zh">你好</span> <span class="hello-card__latin">Neih hóu</span></p>
            </article>

            <article class="hello-card hello-card--3">
              <header class="hello-card__head">
                <span class="hello-card__avatar">P</span>
                <div>
                  <span class="hello-card__city">Paris</span>
                  <span class="hello-card__role">Market entry</span>
                </div>
                <span class="hello-card__dot" title="online"></span>
              </header>
              <p class="hello-card__hi"><span class="hello-card__zh">Bonjour</span></p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>


  <HomeAssets />
</Layout>
