---
import Layout from '../../../layouts/Layout.astro';
import kolsData from '../../../data/kols.json';

type Tier = 'top' | 'mid' | 'rising';
interface KOL {
  id: string;
  rank: number;
  name_zh: string;
  name_en: string;
  tier: Tier;
  tier_label: string;
  platforms: string[];
  primary_platform: string | null;
  primary_platform_label: string;
  followers_text: string;
  specialty: string;
  profile_url: string;
  notable_brands: string[];
  source_note: string;
  avatar_initials: string;
}
interface Industry {
  id: string;
  name_en: string;
  name_zh: string;
  tagline: string;
  color: string;
  kols: KOL[];
}
interface KolsRoot {
  meta: {
    title: string;
    subtitle: string;
    prepared_for: string;
    tier_definitions: { top: string; mid: string; rising: string };
    platforms_covered: string[];
    sources: string[];
    follower_data_note: string;
    healthcare_note: string;
  };
  industries: Industry[];
}

const kolsRoot = kolsData as unknown as KolsRoot;

const tierMeta: Record<Tier, { short: string; sr: string }> = {
  top:    { short: 'Top, 1M+',           sr: 'Nivel: Top, un millón de seguidores o más' },
  mid:    { short: 'Mid, 100K a 1M',     sr: 'Nivel: Mid, entre cien mil y un millón de seguidores' },
  rising: { short: 'Emergente, en torno a 1M', sr: 'Nivel: Emergente, cruzando la línea del millón de seguidores' },
};

const directoryItemListJsonLd = (industry: Industry) => ({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `KOL de ${industry.name_en} en China`,
  itemListElement: industry.kols.map((k, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Person',
      name: k.name_zh,
      alternateName: k.name_en,
      url: k.profile_url,
      knowsAbout: k.specialty,
    },
  })),
});

const heroStats = [
  { num: '10.000', suffix: '+', label: 'creadores en nuestra propia base de datos de KOC' },
  { num: '7', suffix: '', label: 'plataformas llevadas de principio a fin' },
  { num: 'Un equipo', suffix: '', label: 'Casting, briefing, producción y reporting' },
];

const whyPoints = [
  {
    lead: 'El funnel es una pantalla, no cinco pasos.',
    body: 'El comprador chino no sale de la app para decidir. Hace scroll, busca, ve un livestream y compra, todo en el mismo sitio. Si trata al influencer como una valla publicitaria, el presupuesto se le va antes incluso del primer post.',
  },
  {
    lead: 'Los números son más grandes de lo que parece.',
    body: 'Solo el livestream comercial mueve cientos de miles de millones de dólares al año y sigue creciendo a doble dígito.',
  },
  {
    lead: 'Y las marcas siguen invirtiendo poco.',
    body: 'La inversión en influencia en Asia va por detrás de la estadounidense en un orden de magnitud, aun cuando el canal vende más. La oportunidad está ahí, encima de la mesa.',
  },
];

const whyQuotes = [
  {
    image: '/Images/grow-in-china/influencers-kols/why-funnel-onescreen.png',
    alt: 'Una mujer china haciendo scroll en el móvil en el sofá, junto a ella un paquete recién abierto, el funnel de una sola pantalla hecho literal',
    quote: 'El mercado chino de livestream eCommerce alcanzó unos 807.000 millones de dólares en 2024 y se proyecta crecer en torno al 18 por ciento anual hasta 2026.',
    cite: 'Departamento de Agricultura de EE. UU., ATO Shanghái',
    citeMeta: 'Selling in China: The Rise of Livestreaming E-commerce, 2025',
  },
  {
    image: '/Images/grow-in-china/influencers-kols/why-koc-mentions.png',
    alt: 'Una pantalla de móvil con una rejilla de publicaciones pequeñas de creadores para una categoría de producto, un momento real de investigación en un entorno doméstico',
    quote: 'En Asia, la inversión en influencia es solo el 0,75 por ciento del GMV del social commerce, frente al 6,8 por ciento en EE. UU.',
    cite: 'Totem y Rakuten Insight',
    citeMeta: 'Influencer Marketing in Asia, 2025',
  },
];

const howSteps = [
  {
    icon: 'compass',
    title: 'Encontrar a la gente adecuada',
    body: 'Empezamos por su objetivo y su margen, no por un nombre de lista. Después leemos los datos: quién mira y qué acaba comprando. Tenemos nuestra propia base de KOC que ya hemos usado y en los que confiamos.',
  },
  {
    icon: 'pen',
    title: 'Escribir un brief que viaje',
    body: 'El brief es el partido entero. Acordamos con usted el mensaje y los imprescindibles, y dejamos la ejecución al creador. Los que suenan a guion son los que nadie mira.',
  },
  {
    icon: 'gear',
    title: 'Ejecutar de principio a fin',
    body: 'Contratos, contenido, calendario de publicación, coordinación de livestream. Usted aprueba el plan. Movemos presupuesto en cuanto algo rinde por debajo, no semanas después en un post-mortem.',
  },
  {
    icon: 'link',
    title: 'Conectar contenido y venta',
    body: 'Un post desde el que no se puede comprar es media campaña. Enlazamos el contenido directo con su tienda en Douyin, Tmall o JD y medimos lo que aportó cada creador. En Xiaohongshu la venta suele cerrarse en otro sitio, así que la seguimos entre plataformas.',
  },
];

const benefits = [
  {
    icon: 'handshake',
    lead: 'Relaciones directas, mejores tarifas.',
    body: 'Trabajamos con KOL y MCN a los que conocemos personalmente, no con un marketplace. Acceso prioritario a creadores muy solicitados, a tarifas por debajo del mercado abierto.',
  },
  {
    icon: 'creator',
    lead: 'Una red de KOC construida durante años.',
    body: 'Nuestra propia base, con más de 10.000 creadores. Pone su producto delante de las comunidades de nicho adecuadas a una escala que una marca, por su cuenta, no alcanza.',
  },
  {
    icon: 'chart',
    lead: 'Selección con datos, no con olfato.',
    body: 'A cada creador que llega a una shortlist lo pasamos antes por el cribado: composición de audiencia, engagement real, chequeo de seguidores falsos.',
  },
  {
    icon: 'clipboard',
    lead: 'Reporting que une gasto y ventas.',
    body: 'Creador a creador, entre plataformas. Sabe cuáles vendieron mientras la campaña sigue viva, mientras aún se puede arreglar.',
  },
];

const platforms = [
  {
    name: 'Xiaohongshu',
    cn: '小红书',
    desc: 'Donde la investigación y la compra ocurren en el mismo scroll. Una buena nota manda al comprador derecho a su tienda. Aquí vive nuestra base propia de KOC y KOL.',
  },
  {
    name: 'Douyin',
    cn: '抖音',
    desc: 'Vídeo corto y livestream commerce, sobre un algoritmo de intereses. Somos socio oficial de marketing de Douyin.',
  },
  {
    name: 'WeChat',
    cn: '微信',
    desc: 'Artículos, tráfico privado, confianza en formato largo y CRM. Más de diez años en la plataforma.',
  },
  {
    name: 'Weibo',
    cn: '微博',
    desc: 'Alcance y conversación. Sigue siendo fuerte para lanzamientos y ruido.',
  },
  {
    name: 'Bilibili',
    cn: '',
    desc: 'Formato largo, audiencia joven, muy comprometida. Las marcas extranjeras la usan poco.',
  },
  {
    name: 'Kuaishou',
    cn: '快手',
    desc: 'Livestream commerce con tirón real en ciudades de menor escalafón.',
  },
  {
    name: 'Tmall y JD',
    cn: '天猫 / 京东',
    desc: 'Las plataformas donde se cierra la venta. Conectamos el contenido de KOL directo con su tienda y hacemos campañas de influencia dentro de ambas.',
  },
];

const faqs = [
  { cat: 'Estrategia', q: '¿En qué se diferencia esto del marketing de influencia en mi mercado?', a: 'En Occidente, los influencers crean notoriedad y la compra cierra después, en otro lado. En China todo pasa en la misma app, a menudo en la misma sesión. Los creadores están atados directamente a la venta, no solo al alcance. Y como las marcas todavía invierten poco aquí en comparación con EE. UU., el canal está más abierto que saturado.' },
  { cat: 'Creadores', q: '¿Cómo encuentro al influencer adecuado?', a: 'Empiece por su audiencia, no por el influencer. Defina a quién necesita llegar y contraste eso con la base real del creador, no con su cifra de portada. Douyin va sobre un algoritmo de intereses, así que el encaje del contenido suele ganar al número de seguidores. Una agencia con datos reales y relaciones directas lo hace más rápido y más barato que andar a tientas.' },
  { cat: 'Coste', q: '¿Cuánto cuesta un KOL en la práctica?', a: 'Varía bastante. En Xiaohongshu, un post de nano-KOC puede ir por unos cientos de RMB; un post de KOL medio se mueve en la decena baja de miles; un nombre top puede pasar de 100.000 RMB por un único post. El vídeo en Douyin suele entrar un 20-30 por ciento más bajo para alcances comparables. Y los grandes KOL de livestream se llevan, además, una comisión sobre ventas, a menudo del 40-50 por ciento. La cifra que le coticen, trátela como punto de partida y no como tarifario.' },
  { cat: 'Coste', q: '¿Qué presupuesto necesito para probar algo serio?', a: 'Para testear de verdad una plataforma, prevea entre 100.000 y 300.000 RMB en dos o tres meses. Cubre una base de siembra con KOC, unos pocos KOL medios, producción de contenido y algo de amplificación pagada. Puede hacer una prueba de siembra por debajo de 50.000 RMB, pero no le dará una lectura limpia de si el canal vende para su marca.' },
  { cat: 'Creadores', q: '¿KOL o KOC?', a: 'Normalmente, los dos. Los KOL aportan alcance y señal de credibilidad. Los KOC, esos creadores cotidianos con audiencias pequeñas y confiables, construyen la tracción en búsqueda que pesa cuando un comprador busca su producto. Encuentre una docena de menciones honestas y compra. Encuentre un único post pagado y sigue scrolleando. Ajustamos la mezcla a su objetivo y a su presupuesto, y esa mezcla rara vez se repite igual dos veces.' },
  { cat: 'Estrategia', q: '¿Cuál es la mejor plataforma?', a: 'Aquella donde ya están sus compradores. Xiaohongshu encaja con compras meditadas en belleza, lifestyle y wellness. Douyin está hecho para vídeo y livestream a escala. Weibo sigue funcionando para lanzamientos. WeChat es para profundidad y retención. La mayoría de las marcas necesita dos o tres, no una, y desde luego no todas a la vez.' },
  { cat: 'Trabajo conjunto', q: '¿Cómo consigo que un KOL venda y no solo acumule visualizaciones?', a: 'Meta el producto dentro del contenido para que no se lea como anuncio y haga que se pueda comprar al instante. Livestreams, reseñas honestas, unboxings, códigos de descuento solo para seguidores. Y el enlace del post a la ficha de producto tiene que estar. Una campaña sin camino de compra es notoriedad con una factura mayor.' },
  { cat: 'Operación', q: '¿Necesito una entidad registrada en China?', a: 'Para los sistemas oficiales de colaboración, normalmente sí. Pugongying (Xiaohongshu) y las herramientas oficiales de Weibo suelen pedir un negocio registrado en China. Aun así, puede correr campañas a través de una agencia que tenga las relaciones, que es como arrancan la mayoría de las marcas extranjeras antes de montar su propia entidad.' },
  { cat: 'Operación', q: '¿Cuánto tardamos en estar a directo?', a: 'Del brief a las primeras publicaciones, entre tres y cinco semanas. La shortlist y la negociación se llevan una o dos semanas, contratar unos días, contenido y revisión otra semana o dos. Las franjas de livestream con hosts muy demandados a veces hay que reservarlas con más antelación. Apurar el brief es donde las campañas pierden calidad sin que nadie lo note.' },
  { cat: 'Creadores', q: '¿Cómo sé si los seguidores de un influencer son reales?', a: 'Mire más allá del número. Forma del engagement. Calidad de los comentarios, tasas de guardado y compartido, si la ciudad y la edad de la audiencia encajan con el contenido. Saltos súbitos de seguidores, comentarios genéricos de una palabra, engagement que no acompaña a las visualizaciones, son banderas rojas. Lo filtramos antes de que nadie llegue a una shortlist, porque las cuentas infladas abundan.' },
  { cat: 'Operación', q: '¿Qué tiene que dejar claro el contrato?', a: 'Concreto. Número y tipo de publicaciones, plataforma, ventana de publicación, si el contenido se queda colgado y por cuánto tiempo, derechos de uso si quiere reaprovecharlo, KPI y la estructura de comisiones donde aplique. Los contratos vagos son donde nacen las disputas. Y exija prueba de rendimiento por escrito antes del pago final.' },
  { cat: 'Coste', q: '¿Puedo reutilizar el contenido en mis propios anuncios?', a: 'Solo si el contrato concede derechos de uso, y eso suele costar aparte. Muchas marcas olvidan negociarlo y luego no pueden, legalmente, impulsar un post que funcionó. Decida desde el principio si quiere derechos de amplificación. Añadirlos después es más lento y más caro.' },
  { cat: 'Estrategia', q: '¿Qué resultados puedo esperar de verdad?', a: 'Depende de categoría, presupuesto y plataforma, así que desconfíe de quien le prometa una cifra fija. Una campaña de siembra sana construye visibilidad en búsqueda y una base de menciones genuinas. Un livestream empuja ventas en una ventana. Adapte el KPI al formato: alcance y guardados para siembra, conversión y GMV para livestream. Y juzgue el programa por trimestre, no por un único post.' },
  { cat: 'Estrategia', q: '¿Cómo miden el ROI cuando la venta cae en otro sitio?', a: 'Es el caso típico de Xiaohongshu. Una nota construye intención y, días después, el comprador cierra la compra en Tmall o JD. Lo seguimos por el lift de búsquedas de marca, por el tráfico y los add-to-cart en su tienda, y por códigos de descuento únicos por creador. La intención aparece primero, las ventas después. Por eso medimos entre plataformas, no dentro de una.' },
  { cat: 'Operación', q: '¿Y si una campaña va por debajo a mitad de camino?', a: 'Movemos presupuesto. Si un creador no convierte, el gasto se reasigna a los que sí. O ajustamos el ángulo. O cambiamos el formato entero. Nada de eso funciona sin reporting en vivo, y por eso lo montamos así desde el primer día. La flexibilidad tiene que estar en el plan, y en los contratos, antes de necesitarla.' },
  { cat: 'Creadores', q: '¿Nos compensa el livestreaming?', a: 'Depende de su categoría y de su margen. El livestream genera el engagement más alto y la conversión más directa, pero los hosts top se llevan ese 40-50 por ciento de comisión, y el formato premia productos que se muestran bien en cámara. Para muchas marcas, un livestream desde su propia tienda gana a alquilar una celebridad: conserva el control del mensaje y del margen. Si no encaja, se lo decimos.' },
  { cat: 'Operación', q: '¿Cómo evito que parezca un anuncio cantado?', a: 'Pase al creador el mensaje y los imprescindibles, y deje la ejecución en sus manos. Los guionizados son los que nadie ve, y en Xiaohongshu la venta dura se vuelve en contra rápido. El contenido nativo, basado en experiencia, que nombra el producto con honestidad, gana a una lectura publicitaria pulida casi siempre.' },
  { cat: 'Operación', q: '¿Qué riesgos de cumplimiento conviene conocer?', a: 'La ley de publicidad china es estricta con superlativos y claims sin verificar. "El mejor", "número uno", afirmaciones de salud o eficacia sin respaldo, pueden activar sanciones reales. Y las colaboraciones con influencers tienen que pasar cada vez más por las plataformas oficiales para la divulgación. Informamos al creador de lo que no puede decir y revisamos el contenido antes de que se publique.' },
  { cat: 'Estrategia', q: '¿Puede una marca pequeña triunfar aquí o esto es solo para los grandes?', a: 'Una marca pequeña puede absolutamente trabajar aquí, y a menudo le va mejor con KOC que con KOL. Como Douyin y Xiaohongshu premian el encaje del contenido por encima del número de seguidores, un producto relevante con buen contenido puede tirar sin un presupuesto de celebridad. Empiece con una base de siembra de KOC bien enfocada, demuestre que el producto aterriza y, después, escale.' },
  { cat: 'Trabajo conjunto', q: '¿Debería trabajar con creadores directamente, a través de una MCN o con una agencia?', a: 'Directo funciona si tiene equipo en China, idioma, contratos y tiempo para verificar cuentas. Una MCN le abre su roster, pero recuerde que representa a sus creadores, no a usted. Una agencia trabaja para su lado de la mesa. Selecciona en todo el mercado contra sus objetivos, gestiona contratos y cumplimiento, y une el reporting con sus ventas. Esa última parte es la que hacemos.' },
];

const faqCategories = ['Todas', 'Estrategia', 'Coste', 'Creadores', 'Operación', 'Trabajo conjunto'];

const icons: Record<string, string> = {
  compass: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="15 9 13 13 9 15 11 11 15 9"/></svg>`,
  pen: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l3.5-1 11-11-2.5-2.5-11 11z"/><path d="M14 5l2.5-2.5a1.4 1.4 0 0 1 2 0l1 1a1.4 1.4 0 0 1 0 2L17 8"/></svg>`,
  gear: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
  link: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07L11.17 5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07L12.83 19"/></svg>`,
  handshake: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12l4-4 5 5-1 1-3-3-4 4z"/><path d="M22 12l-4-4-5 5 1 1 3-3 4 4z"/><path d="M9 14l3-3 3 3-3 3z"/></svg>`,
  creator: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>`,
  chart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><rect x="5" y="13" width="3" height="7"/><rect x="11" y="8" width="3" height="12"/><rect x="17" y="4" width="3" height="16"/></svg>`,
  clipboard: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1"/><line x1="9" y1="10" x2="15" y2="10"/><line x1="9" y1="14" x2="15" y2="14"/><line x1="9" y1="18" x2="13" y2="18"/></svg>`,
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Marketing de KOL e influencia en China',
  provider: {
    '@type': 'Organization',
    name: 'TheChinaPath',
    url: 'https://www.thechinapath.com',
  },
  areaServed: { '@type': 'Country', name: 'China' },
};
---

<Layout
  title="Agencia KOL en China: marketing de influencia que vende"
  description="Ejecutamos campañas de KOL y KOC en China que venden, no solo acumulan visualizaciones. Selección de creadores con datos en Douyin, Xiaohongshu, Tmall y JD."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} is:inline />

  <div class="kol-progress" aria-hidden="true"><div class="kol-progress__bar"></div></div>
  <article class="kol">

    {/* ---------- HERO ---------- */}
    <section class="kol-hero" data-hero>
      <div class="kol-hero__bg" aria-hidden="true" data-parallax>
        <img src="/Images/grow-in-china/influencers-kols/hero-kol-livestream.png" alt="Una joven host china de livestream en un pequeño set casero, aro de luz encendido, sosteniendo un frasco de skincare a media presentación" />
      </div>
      <div class="kol-hero__overlay" aria-hidden="true"></div>
      <div class="kol-hero__grain" aria-hidden="true"></div>

      <div class="container kol-hero__inner">
        <nav class="kol-hero__crumbs" aria-label="Migas de pan">
          <a href="/es">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href="/es#services">Crecer en China</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark kol-reveal">Influencia y KOL</span>
        <h1 class="kol-hero__title kol-reveal" style="--reveal-delay: 80ms;">
          <span class="kol-hero__title-row">En Occidente, un influencer le pone en el mapa.</span>
          <span class="kol-hero__title-row kol-hero__title-row--accent">En China, le cierra la venta.</span>
        </h1>
        <p class="kol-hero__lead kol-reveal" style="--reveal-delay: 200ms;">
          En Instagram, el creador está arriba del funnel. En China, descubrimiento,
          investigación y checkout ocurren en una sola pantalla, en el mismo minuto. El
          KOL no es su capa de notoriedad. Está en la caja. Por eso elegimos creadores con
          datos, les damos un briefing serio, y lo que cobramos depende de lo que
          realmente vendió.
        </p>
        <div class="kol-hero__actions kol-reveal" style="--reveal-delay: 280ms;">
          <a href="/es/contacto" class="btn btn--primary kol-magnetic">Hablemos de su campaña</a>
          <a href="/es/analisis" class="btn btn--ghost-light kol-magnetic">Leer nuestros análisis sobre China</a>
        </div>

        <div class="kol-hero__meta kol-reveal" style="--reveal-delay: 360ms;">
          {heroStats.map((s) => (
