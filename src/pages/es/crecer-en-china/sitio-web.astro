---
import Layout from '../../../layouts/Layout.astro';

const outcomes = [
  "El tiempo de carga baja de ocho o quince segundos a menos de uno en China continental",
  "Baidu arranca a indexar en las semanas siguientes a la concesión del ICP",
  "Asoman las primeras citas en los motores de IA chinos a medida que rastrean el contenido nuevo",
  "El GMV del mini-programa de WeChat se sigue desde el día uno",
];

const aiEngines = [
  { name: 'Doubao', cn: '豆包', maker: 'ByteDance' },
  { name: 'DeepSeek', cn: '深度求索', maker: 'DeepSeek' },
  { name: 'Kimi', cn: 'Kimi', maker: 'Moonshot AI' },
  { name: 'Qwen', cn: '通义千问', maker: 'Alibaba' },
  { name: 'Baidu AI', cn: '文心一言', maker: 'Baidu' },
];

const geoBullets = [
  "Datos estructurados (schema.org, JSON-LD) para que los modelos recorran sus páginas sin tropiezos",
  "Contenido denso y factual: los motores de IA citan lo que pueden respaldar; el lenguaje de folleto se lo saltan",
  "Páginas redactadas en chino e indexadas por Baidu y por Sogou",
  "Construcción de la entidad de marca en Baidu Baike y fuentes de referencia equivalentes",
  "Seguimiento de qué motores citan la marca y de cómo la describen",
];

const wechatSurfaces = [
  {
    tag: "Cuenta oficial",
    cn: '公众号',
    title: "La redacción de su marca, dentro de WeChat",
    body: "Cuenta de servicio o de suscripción que envía artículos a los suscriptores, lleva la atención al cliente y aloja un puñado de páginas clave. Mantiene viva la relación entre compras.",
    bullet: "Artículos publicados, atención al cliente, páginas clave",
  },
  {
    tag: "Mini-programa",
    cn: '小程序',
    title: "Una aplicación completa dentro de WeChat, a dos toques",
    body: "Catálogo, pago con WeChat Pay, tarjetas de socio y programas por niveles caben aquí. Es donde de verdad se anudan eCommerce, fidelización y membresía.",
    bullet: "eCommerce, fidelización y membresía en uno",
    highlight: true,
  },
];

const techPaths = [
  {
    name: "WordPress",
    sub: "Orientado a contenido, editado en local",
    when: "Encaja cuando el equipo local quiere llevar el sitio por su cuenta: campañas, artículos, lanzamientos de producto, cambios frecuentes. Interfaz familiar, base tecnológica probada. Su responsable de marketing en Shanghái publica un martes sin pedirle nada al equipo de desarrollo.",
    bullets: [
      "Google Fonts sustituidas por CDN chinas equivalentes",
      "Plugins bloqueados reemplazados por alternativas locales",
      "CDN local conectada, ICP tramitado, SEO Baidu cerrado",
      "Indicado para equipos que reivindican su autonomía editorial",
    ],
    timeline: "6 a 10 semanas",
  },
  {
    name: "Astro",
    sub: "Sitio de marca, rendimiento sostenido",
    when: "Encaja cuando el sitio es escaparate de marca y producto, sin un ritmo intenso de cambios. Astro produce HTML estrictamente estático: carga por debajo de un segundo incluso detrás del Firewall, coste de alojamiento casi nulo y superficie de ataque mucho menor.",
    bullets: [
      "Carga por debajo de un segundo en China continental",
      "Sin base de datos ni PHP, huella mínima en servidor",
      "Sin componentes dinámicos explotables ni plugins que parchear",
      "Indicado para sitios de marketing de marca, sin transacción",
    ],
    timeline: "4 a 8 semanas",
    highlight: true,
  },
];

const hostingOptions = [
  {
    where: "China continental",
    note: "ICP obligatorio",
    load: "< 1 segundo",
    seo: "Muy favorable",
    verdict: "La única opción defendible de verdad",
    status: 'go',
  },
  {
    where: "Hong Kong",
    note: "Sin ICP",
    load: "De 2 a 4 segundos",
    seo: "Marginal",
    verdict: "Lento y penalizado por Baidu",
    status: 'warn',
  },
  {
    where: "Estados Unidos o Unión Europea",
    note: "Sin ICP",
    load: "De 8 a 15 segundos, a veces más",
    seo: "Inexistente",
    verdict: "Inviable en la práctica",
    status: 'stop',
  },
];

const deliverables = [
  {
    icon: 'design',
    title: "Un diseño pensado para el lector chino",
    desc: "Páginas más densas, arquitectura recogida, códigos QR sistemáticos, primacía móvil: el 95 % del tráfico pasa por ahí. Construimos para esa realidad, no para los códigos occidentales de la web, pulidos en Estocolmo y rotos en Shanghái.",
  },
  {
    icon: 'code',
    title: "Un código que convive con el Gran Firewall",
    desc: "Nada de Google Fonts, ni CDN bloqueadas, ni llamadas a la API de Maps que se quedan colgadas, ni embeds de YouTube. Cada dependencia se sustituye por su equivalente local. Sin brillo aparente, pero esa es la diferencia entre un sitio que aparece y un sitio que se queda congelado.",
  },
  {
    icon: 'server',
    title: "Un alojamiento estable y probado",
    desc: "Disponibilidad superior al 99 %, atención a incidencias en menos de dos horas, siete días a la semana. Actualización del stack, copias nocturnas, cumplimiento PIPL desde el primer día. La monitorización corre desde dentro del Firewall, que es donde las anomalías aparecen de verdad.",
  },
  {
    icon: 'phone',
    title: "Mini-programas calibrados para convertir",
    desc: "Diseñados sobre el stack de Tencent (WXML, WXSS, WeChat JS). Pagos nativos, integración con CRM, programas de niveles, notificaciones push. Una década de mini-programas para marcas que tratan WeChat como canal de venta, no como un folleto.",
  },
  {
    icon: 'pen',
    title: "Copywriting en el idioma que toca",
    desc: "Contenido en chino escrito directamente por nuestro equipo interno, nunca traducido del inglés. Versiones en español e inglés cuando la comunicación corporativa, los materiales de inversores o la coherencia del grupo lo exigen.",
  },
];

const faqs = [
  {
    q: "¿Qué es GEO y por qué importa?",
    a: "GEO, Generative Engine Optimization, es el SEO aplicado a la búsqueda por IA. Los internautas chinos consultan cada vez más a los asistentes de IA (Doubao, Kimi, DeepSeek, Qwen) en lugar de hacer una búsqueda clásica. Esos modelos necesitan sitios creíbles, indexados, que puedan citar. Sin alojamiento en China, no hay visibilidad en esa nueva capa de búsqueda.",
  },
  {
    q: "¿WordPress o Astro?",
    a: "WordPress si el equipo actualiza el sitio con frecuencia y quiere mantener su autonomía editorial. Astro si el sitio permanece relativamente estable entre lanzamientos y las prioridades son velocidad, seguridad y control del coste de alojamiento.",
  },
  {
    q: "¿Cuál es el presupuesto de un sitio diseñado para China?",
    a: "Depende del alcance, la escala y el número de integraciones. Los sitios de marca en Astro están en la parte baja del rango. Los proyectos WordPress con funcionalidades de eCommerce o integración con WeChat están más arriba. Cada proyecto se presupuesta a medida.",
  },
  {
    q: "¿Cuánto dura el proyecto?",
    a: "De cuatro a diez semanas para diseño y desarrollo, más el trámite del ICP. Bei'an: dos a cuatro semanas. Licencia comercial: dos a tres meses, a veces más. Diseño y desarrollo corren en paralelo a los trámites de ICP para evitar parones.",
  },
  {
    q: "¿De quién es el código y el ICP?",
    a: "De la marca, sin reservas. El código es suyo. El ICP queda a nombre de su entidad china, o de la entidad partner montada conjuntamente. Sin bloqueos operativos.",
  },
  {
    q: "¿Pueden migrar un sitio existente?",
    a: "Sí. Auditamos el sitio actual, señalamos los componentes que fallan en China y migramos limpio o reconstruimos las partes que no funcionan. En la mayoría de casos sale más rápido y más barato que rehacerlo entero.",
  },
  {
    q: "¿De verdad hace falta alojar en China?",
    a: "Para velocidad de carga, posicionamiento en Baidu, citas de los motores de IA y fiabilidad, sí. Hong Kong funciona como una pasarela imperfecta. Servir el sitio desde Europa o Estados Unidos equivale a ofrecer una experiencia rota a los usuarios chinos.",
  },
  {
    q: "¿Qué es una licencia ICP?",
    a: "Un trámite obligatorio ante el Ministerio chino de Industria y Tecnologías de la Información. Conviven dos regímenes. El Bei'an cubre los sitios informativos. La licencia comercial cubre eCommerce y plataformas transaccionales. Se exige para cualquier alojamiento en China continental.",
  },
  {
    q: "¿Puede un mini-programa de WeChat sustituir al sitio?",
    a: "En eCommerce y fidelización, a menudo sí. Para descubrimiento, SEO y credibilidad de marca, el sitio sigue siendo indispensable. La mayoría de los clientes opera los dos en paralelo.",
  },
  {
    q: "¿Cómo condiciona la PIPL el sitio?",
    a: "La PIPL es el equivalente chino del RGPD. El sitio debe indicar con claridad qué datos recoge, obtener consentimiento explícito y conservar los datos personales con seguridad. Integramos el cumplimiento PIPL desde el arranque del proyecto.",
  },
  {
    q: "¿En qué consiste la auditoría gratuita?",
    a: "Probamos el sitio actual desde dentro de China: tiempos de carga, recursos bloqueados, visibilidad en Baidu, citas en los motores de IA. Le mandamos un resumen escrito al terminar. Sin compromiso.",
  },
];

const icons: Record<string, string> = {
  design: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="14" rx="2"/><path d="M3 9h18"/><circle cx="6.5" cy="6" r="0.6" fill="currentColor"/><path d="M8 21h8M12 17v4"/></svg>`,
  code: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="8 6 2 12 8 18"/><polyline points="16 6 22 12 16 18"/><path d="m14 4-4 16"/></svg>`,
  server: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><circle cx="7" cy="7" r="0.6" fill="currentColor"/><circle cx="7" cy="17" r="0.6" fill="currentColor"/></svg>`,
  phone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/></svg>`,
  pen: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4l6 6L8 22H2v-6L14 4z"/><path d="m13 5 6 6"/></svg>`,
  check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8"/></svg>`,
};
---

<Layout
  title="Agencia de sitios web para China: diseño, alojamiento y ranking | Beyond Border Group"
  description="Diseñamos y alojamos sitios y mini-programas de WeChat que cargan, posicionan en Baidu y son citados por los motores de IA chinos. Más de veinte años en China."
>
  <article class="web">

    {/* ---------- HERO ---------- */}
    <section class="web-hero">
      <div class="web-hero__bg" aria-hidden="true">
        <img src="/Images/insights/how-to-host-your-website-in-china-for-maximum-marketing-impact.jpg" alt="" />
      </div>
      <div class="web-hero__overlay" aria-hidden="true"></div>

      <div class="container web-hero__inner">
        <nav class="web-hero__crumbs" aria-label="Migas de pan">
          <a href="/es">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href="/es#services">Crecer en China</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark">Sitios web en China</span>
        <h1 class="web-hero__title">Sitios que cargan, posicionan y venden de verdad en China.</h1>
        <p class="web-hero__lead">
          Diseñamos, desarrollamos y alojamos sitios y mini-programas de WeChat para el mercado chino.
          Carga por debajo del segundo, cumplimiento ICP, indexación en Baidu y presencia en los motores de
          IA que los consumidores chinos usan ya para descubrir marcas.
        </p>
        <p class="web-hero__support">
          Más de veinte años en China. Oficinas en Shanghái, Hong Kong y París. Un equipo que ha trabajado
          para grupos internacionales y para retadores locales.
        </p>
        <div class="web-hero__actions">
          <a href="/es/contacto" class="btn btn--primary">Auditoría gratuita de su sitio en China</a>
          <a href="/es/proyectos" class="btn btn--ghost-light">Ver nuestros casos</a>
        </div>
      </div>
    </section>

    {/* ---------- INTRO + 90-DAY OUTCOMES ---------- */}
    <section class="section">
      <div class="container">
        <div class="web-intro">
          <div class="web-intro__copy">
            <span class="eyebrow">Diseñado para la internet china, no traspuesto</span>
            <h2>Casi todos los sitios internacionales se rompen al llegar a China.</h2>
            <p>
              La carga se alarga, hasta no mostrar nada. Los servicios de Google siguen bloqueados. Baidu
              no indexa. Los motores de IA siguen su camino sin pararse.
            </p>
            <p>
              Diseñamos sitios y mini-programas de WeChat que encuentran su sitio dentro de la web china.
              El stack tecnológico encaja con las limitaciones del mercado, el alojamiento está donde tiene
              que estar, el SEO está calibrado para Baidu y los motores de IA en los que se apoyan ahora
              los consumidores chinos recogen el contenido. Para que le encuentren, y para vender.
            </p>
          </div>

          <aside class="web-outcomes" aria-label="Resultados observados en los primeros noventa días">
            <span class="web-outcomes__tag">Primeros noventa días</span>
            <h3>Lo que cambia cuando la ejecución es rigurosa</h3>
            <ul>
              {outcomes.map((o) => (
                <li>
                  <span class="web-outcomes__check" aria-hidden="true" set:html={icons.check} />
                  <span>{o}</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {/* ---------- GEO: AI ENGINES ---------- */}
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Un sitio en China, condición innegociable en 2026</span>
          <h2>GEO: que la IA le cite, no solo posicionar en Baidu</h2>
          <p class="section-header__lead">
            GEO, Generative Engine Optimization, es el SEO en la era de la IA. El consumidor chino se salta
            la barra de búsqueda y pregunta directamente a los modelos.
          </p>
        </header>

        <div class="web-geo">
          <div class="web-geo__copy">
            <p>
              Doubao, Kimi, DeepSeek, Qwen y una lista que no para de crecer responden tirando de los sitios
              que han indexado y considerado creíbles. Sin sitio alojado en China, esos motores no tienen
              ninguna fuente que citar sobre su marca. La consecuencia es mecánica: su marca queda fuera de
              la conversación.
            </p>
            <h3 class="web-geo__h3">Lo que hacemos en GEO, en concreto</h3>
            <ul class="web-geo__list">
              {geoBullets.map((b) => (
                <li>
                  <span class="web-geo__bullet" aria-hidden="true" set:html={icons.check} />
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="web-engines" aria-label="Motores de IA chinos">
            <span class="web-engines__tag">Los motores que ahora deciden la visibilidad</span>
            <div class="web-engines__grid">
              {aiEngines.map((e) => (
                <div class="web-engine">
                  <span class="web-engine__cn" lang="zh-Hans">{e.cn}</span>
                  <span class="web-engine__name">{e.name}</span>
                  <span class="web-engine__maker">{e.maker}</span>
                </div>
              ))}
            </div>
            <p class="web-engines__note">
              Un sitio alojado en China y redactado en chino es el activo de base que alimenta a Baidu y al
              conjunto de motores de IA que hoy moldean cómo descubren productos los consumidores chinos.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- WECHAT SURFACES ---------- */}
    <section class="section">
      <div class="container">
        <header class="section-header section-header--split">
          <div>
            <span class="eyebrow">WeChat, la otra cara del dispositivo</span>
            <h2>Dos superficies que cubrir: la cuenta oficial y el mini-programa.</h2>
          </div>
          <div class="web-wechat-stat">
            <span class="web-wechat-stat__value">1.414 M</span>
            <span class="web-wechat-stat__label">
              Usuarios activos mensuales combinados de Weixin y WeChat a 30 de septiembre de 2025
            </span>
            <span class="web-wechat-stat__source">Fuente: resultados Tencent T3 2025</span>
          </div>
        </header>

        <div class="web-surfaces">
          {wechatSurfaces.map((s) => (
            <article class={`web-surface${s.highlight ? ' web-surface--highlight' : ''}`}>
              {s.highlight && <span class="web-surface__badge">El punto de inflexión de la conversión</span>}
              <div class="web-surface__head">
                <span class="web-surface__cn" lang="zh-Hans">{s.cn}</span>
                <span class="web-surface__tag">{s.tag}</span>
              </div>
              <h3 class="web-surface__title">{s.title}</h3>
              <p class="web-surface__body">{s.body}</p>
              <span class="web-surface__bullet">{s.bullet}</span>
            </article>
          ))}
        </div>

        <p class="web-surfaces__note">
          La mayoría de las marcas con las que trabajamos usan las dos superficies. La cuenta oficial
          sostiene la relación. El mini-programa es donde se cierra la conversión. Juntas cubren el
          recorrido entero, del descubrimiento a la compra.
        </p>
      </div>
    </section>

    {/* ---------- TWO TECH PATHS ---------- */}
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Dos vías técnicas</span>
          <h2>WordPress o Astro: la decisión depende de cómo trabaja su equipo.</h2>
          <p class="section-header__lead">
            Sin guerras de capilla. La elección correcta depende de la frecuencia de publicación, de quién
            empuja las actualizaciones y de si hay que gestionar transacciones.
          </p>
        </header>

        <div class="web-tech">
          {techPaths.map((t) => (
            <article class={`web-tech-card${t.highlight ? ' web-tech-card--highlight' : ''}`}>
              <div class="web-tech-card__head">
                <h3 class="web-tech-card__name">{t.name}</h3>
                <span class="web-tech-card__sub">{t.sub}</span>
              </div>
              <p class="web-tech-card__when">{t.when}</p>
              <ul class="web-tech-card__list">
                {t.bullets.map((b) => (
                  <li>
                    <span class="web-tech-card__check" aria-hidden="true" set:html={icons.check} />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              <div class="web-tech-card__footer">
                <span class="web-tech-card__timeline-label">Calendario</span>
                <span class="web-tech-card__timeline-value">{t.timeline}, más el trámite del ICP</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- HOSTING ---------- */}
    <section class="section">
      <div class="container">
        <header class="section-header section-header--center">
          <span class="eyebrow">Alojamiento en China</span>
          <h2>El alojamiento es la decisión más estructural del proyecto.</h2>
          <p class="section-header__lead">
            Y la respuesta, a decir verdad, es una: alojar dentro de China. Cualquier otra opción es un
            compromiso que se paga. Carga lenta, peor posicionamiento en Baidu, experiencia de usuario rota.
          </p>
        </header>

        <div class="web-hosting">
          {hostingOptions.map((h) => (
            <article class={`web-host web-host--${h.status}`}>
              <header class="web-host__head">
                <h3>{h.where}</h3>
                <span class="web-host__note">{h.note}</span>
              </header>
              <dl class="web-host__metrics">
                <div>
                  <dt>Tiempo de carga en China</dt>
                  <dd>{h.load}</dd>
                </div>
                <div>
                  <dt>Impacto en SEO Baidu</dt>
                  <dd>{h.seo}</dd>
                </div>
              </dl>
              <p class={`web-host__verdict web-host__verdict--${h.status}`}>{h.verdict}</p>
            </article>
          ))}
        </div>

        <div class="web-icp">
          <div class="web-icp__copy">
            <span class="eyebrow">El trámite ICP, el capítulo del que nadie habla</span>
            <h3>Bei'an: dos a cuatro semanas. Licencia comercial: dos a tres meses.</h3>
            <p>
              Alojar en China continental supone tener una licencia ICP y montar el servidor en Alibaba
              Cloud, Tencent Cloud o Huawei Cloud. Nos hacemos cargo del trámite completo del ICP. Bei'an
              para sitios informativos, licencia comercial para eCommerce y plataformas transaccionales.
            </p>
            <p>
              También configuramos el servidor, la CDN, la monitorización desde dentro de China (la mayoría
              de las herramientas vigilan el estado del sitio desde fuera del Firewall y se pierden los
              incidentes reales) y las copias diarias. Si no hay entidad china, existen varias vías. Las
              explicamos en detalle.
            </p>
          </div>
          <div class="web-icp__visual">
            <img src="/Images/insights/how-to-apply-for-an-icp-license-for-your-website.png" alt="Proceso de licencia ICP para sitios web en China" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    {/* ---------- CHINAWEBFOUNDRY ---------- */}
    <section class="section section--alt">
      <div class="container">
        <article class="web-cwf">
          <div class="web-cwf__copy">
            <span class="eyebrow">Agencia hermana</span>
            <h2 class="web-cwf__title">ChinaWebFoundry: una agencia dedicada a sitios para el mercado chino.</h2>
            <p>
              Cuando el sitio en sí es el entregable principal, operamos una agencia hermana pensada
              específicamente para el mercado chino. Cubrimos todas las bases técnicas: WordPress, Astro,
              estático, desarrollo a medida.
            </p>
            <ul class="web-cwf__list">
              <li>Estrategia, auditoría y migración detrás del Firewall</li>
              <li>Alojamiento con licencia ICP en Alibaba, Tencent o Huawei Cloud</li>
              <li>Rediseño UX y UI calibrado para el internauta chino</li>
              <li>Sustitución de plugins e integraciones bloqueados por equivalentes locales</li>
              <li>Posicionamiento en Baidu, redacción en chino y mantenimiento continuo</li>
            </ul>
            <p class="web-cwf__same">
              El mismo equipo. Más de veinte años de experiencia acumulada en China. Una puerta de entrada
              concreta cuando la prioridad es un sitio que funcione de verdad en China continental.
            </p>
            <a href="https://www.chinawebfoundry.com/" target="_blank" rel="noopener noreferrer" class="btn btn--primary">
              Visitar ChinaWebFoundry <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="web-cwf__visual" aria-hidden="true">
            <div class="web-cwf__browser">
              <div class="web-cwf__browser-bar">
