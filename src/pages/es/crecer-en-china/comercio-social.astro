  creator: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/><path d="M18 3l0.8 1.7 1.8 0.3-1.3 1.3 0.3 1.8L18 7.3 16.4 8.1l0.3-1.8L15.4 5l1.8-0.3z"/></svg>`,
  video: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="14" height="12" rx="2"/><polygon points="17 9 22 6 22 18 17 15"/><circle cx="8" cy="11" r="1.2" fill="currentColor"/></svg>`,
  film: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="7" y1="4" x2="7" y2="20"/><line x1="17" y1="4" x2="17" y2="20"/><line x1="3" y1="9" x2="7" y2="9"/><line x1="3" y1="15" x2="7" y2="15"/><line x1="17" y1="9" x2="21" y2="9"/><line x1="17" y1="15" x2="21" y2="15"/></svg>`,
  chart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><rect x="5" y="13" width="3" height="7"/><rect x="11" y="8" width="3" height="12"/><rect x="17" y="4" width="3" height="16"/></svg>`,
  clipboard: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1"/><line x1="9" y1="10" x2="15" y2="10"/><line x1="9" y1="14" x2="15" y2="14"/><line x1="9" y1="18" x2="13" y2="18"/></svg>`,
  scroll: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M8 7h7M8 11h7M8 15h4"/></svg>`,
  outcome: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  doc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>`,
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Social commerce management',
  provider: {
    '@type': 'Organization',
    name: 'TheChinaPath',
    url: 'https://www.thechinapath.com',
  },
  areaServed: { '@type': 'Country', name: 'China' },
};
---

<Layout
  title="Social commerce en China para marcas extranjeras"
  description="Social commerce en China para marcas extranjeras. Tiendas en Douyin, RedNote, WeChat y Weibo, programas de KOL, livestreams semanales, llevados por operadores sénior."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} is:inline />

  <div class="cbs-progress" aria-hidden="true"><div class="cbs-progress__bar"></div></div>
  <article class="cbs">
    {/* ---------- HERO ---------- */}
    <section class="cbs-hero" data-hero>
      <div class="cbs-hero__bg" aria-hidden="true" data-parallax>
        <img
          src="/Images/grow-in-china/social-commerce/hero-douyin-livestream.png"
          alt="Una joven host china en un plató de livestream de Douyin, con el aro de luz encendido, sostiene un frasco de skincare en pleno discurso"
        />
      </div>
      <div class="cbs-hero__overlay" aria-hidden="true"></div>
      <div class="cbs-hero__grain" aria-hidden="true"></div>

      <div class="container cbs-hero__inner">
        <nav class="cbs-hero__crumbs" aria-label="Migas de pan">
          <a href="/es">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href="/es#services">Crecer en China</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark cbs-reveal">Social commerce</span>
        <h1 class="cbs-hero__title cbs-reveal" style="--reveal-delay: 80ms;">
          <span class="cbs-hero__title-row">En China, la gente no va a la tienda.</span>
          <span class="cbs-hero__title-row cbs-hero__title-row--accent"
            >La tienda entra en su feed.</span
          >
          <span class="cbs-hero__title-row cbs-hero__title-row--highlight"
            >Nosotros operamos eso.</span
          >
        </h1>
        <p class="cbs-hero__lead cbs-reveal" style="--reveal-delay: 200ms;">
          El social commerce en China no es una capa encima del eCommerce. Es la forma principal en
          la que venden hoy las marcas de consumo. Lo llevamos para marcas globales de consumo. La
          operación entera, no el deck.
        </p>
        <div class="cbs-hero__actions cbs-reveal" style="--reveal-delay: 280ms;">
          <a href="/es/contacto" class="btn btn--primary cbs-magnetic">Hablemos</a>
          <a href="#how-we-work" class="btn btn--ghost-light cbs-magnetic">Ver cómo trabajamos</a>
        </div>

        <div class="cbs-hero__meta cbs-reveal" style="--reveal-delay: 360ms;">
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num" data-counter="15" data-suffix="+">0</span>
            <span class="cbs-hero__meta-label"
              >años operando Douyin y RedNote para marcas extranjeras</span
            >
          </div>
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num" data-counter="40" data-suffix="+">0</span>
            <span class="cbs-hero__meta-label">tiendas y cuentas de social commerce activas</span>
          </div>
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num">Un equipo</span>
            <span class="cbs-hero__meta-label"
              >Estrategia, contenido, livestream y anuncios de principio a fin</span
            >
          </div>
        </div>
      </div>

      <a href="#two-truths" class="cbs-hero__scroll" aria-label="Pasar a la siguiente sección">
        <span class="cbs-hero__scroll-line"></span>
        <span class="cbs-hero__scroll-text">Seguir</span>
      </a>
    </section>

    {/* ---------- TWO TRUTHS ---------- */}
    <section id="two-truths" class="section cbs-truths-section">
      <div class="cbs-truths-bg" aria-hidden="true">
        <div class="cbs-truths-bg__blob cbs-truths-bg__blob--a"></div>
        <div class="cbs-truths-bg__blob cbs-truths-bg__blob--b"></div>
        <div class="cbs-truths-bg__grid"></div>
      </div>

      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Nuestro enfoque</span>
          <h2>Dos cosas que conviene saber antes de tocar su social commerce</h2>
          <p class="section-header__lead">
            La mayoría de las marcas entra en Douyin y RedNote como entraría en un mercado nuevo
            cualquiera. Ninguna de las dos plataformas premia ese reflejo. Hay dos principios que
            marcan cómo trabajamos.
          </p>
        </header>

        <div class="cbs-truths" data-truths>
          {
            contextCards.map((c, i) => (
              <article
                class={`cbs-truth${i === 1 ? ' cbs-truth--alt' : ''} cbs-reveal`}
                style={`--reveal-delay: ${i * 140}ms;`}
                data-truth-tilt
              >
                <div class="cbs-truth__inner">
                  <div class="cbs-truth__stage">
                    <div class="cbs-truth__frame">
                      <img
                        src={c.image}
                        alt={c.alt}
                        loading="lazy"
                        decoding="async"
                        data-truth-parallax
                      />
                      <div class="cbs-truth__shade" aria-hidden="true" />
                      <div class="cbs-truth__sheen" aria-hidden="true" />
                    </div>

                    <div class="cbs-truth__kicker" aria-hidden="true">
                      <span class="cbs-truth__kicker-dot" />
                      {c.kicker}
                    </div>

                    {i === 0 && (
                      <div class="cbs-truth__chip cbs-truth__chip--bl" data-float="1">
                        <div class="cbs-truth__chip-row">
                          <span class="cbs-truth__pulse" aria-hidden="true" />
                          <span class="cbs-truth__chip-label">{c.chipLabel}</span>
                        </div>
                        <p class="cbs-truth__chip-sub">{c.chipSub}</p>
                        <div class="cbs-truth__avatars">
                          {c.avatars &&
                            c.avatars.map((a) => (
                              <span class={`cbs-truth__avatar cbs-truth__avatar--${a.tone}`}>
                                {a.letter}
                              </span>
                            ))}
                          <span class="cbs-truth__avatar cbs-truth__avatar--more">
                            {c.extraAvatars}
                          </span>
                        </div>
                      </div>
                    )}

                    {i === 0 && (
                      <div class="cbs-truth__pin" data-float="2">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <rect x="3" y="6" width="14" height="12" rx="2" />
                          <polygon points="17 9 22 6 22 18 17 15" />
                        </svg>
                        <div class="cbs-truth__pin-text">
                          <span class="cbs-truth__pin-label">{c.pinLabel}</span>
                          <span class="cbs-truth__pin-value">{c.pinValue}</span>
                        </div>
                      </div>
                    )}

                    {i === 1 && (
                      <div class="cbs-truth__chip cbs-truth__chip--tr" data-float="1">
                        <div class="cbs-truth__chip-row">
                          <span class="cbs-truth__pulse" aria-hidden="true" />
                          <span class="cbs-truth__chip-label">{c.chipLabel}</span>
                        </div>
                        <p class="cbs-truth__chip-sub">{c.chipSub}</p>
                      </div>
                    )}

                    {i === 1 && (
                      <div class="cbs-truth__badge" data-float="2">
                        <span class="cbs-truth__badge-eyebrow">Por qué importa</span>
                        <span class="cbs-truth__badge-title">{c.badge}</span>
                        <span class="cbs-truth__badge-sub">{c.badgeSub}</span>
                      </div>
                    )}
                  </div>

                  <div class="cbs-truth__content">
                    <h3 class="cbs-truth__title">{c.title}</h3>
                    <p class="cbs-truth__body">{c.body}</p>

                    {i === 0 && c.flow && (
                      <ol class="cbs-truth__flow" aria-label="Flujo diario de contenido">
                        {c.flow.map((step, idx) => (
                          <>
                            <li class="cbs-truth__flow-step" style={`--flow-delay: ${idx * 90}ms`}>
                              <span class="cbs-truth__flow-bubble">
                                {idx === 0 && (
                                  <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                  >
                                    <rect x="3" y="6" width="14" height="12" rx="2" />
                                    <polygon points="17 9 22 6 22 18 17 15" />
                                  </svg>
                                )}
                                {idx === 1 && (
                                  <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                  >
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                    <path d="M18.5 2.5a2.1 2.1 0 1 1 3 3L12 15l-4 1 1-4z" />
                                  </svg>
                                )}
                                {idx === 2 && (
                                  <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                  >
                                    <path d="M22 2L11 13" />
                                    <path d="M22 2L15 22 11 13 2 9z" />
                                  </svg>
                                )}
                              </span>
                              <span class="cbs-truth__flow-label">{step}</span>
                            </li>
                            {idx < c.flow.length - 1 && (
                              <li class="cbs-truth__flow-arrow" aria-hidden="true">
                                <svg
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                >
                                  <path d="M5 12h14M13 6l6 6-6 6" />
                                </svg>
                              </li>
                            )}
                          </>
                        ))}
                      </ol>
                    )}

                    {i === 1 && c.credentials && (
                      <ul class="cbs-truth__tags" aria-label="Lo que operamos, a diario">
                        {c.credentials.map((tag) => (
                          <li class="cbs-truth__tag">{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- WHY BRANDS CHOOSE US ---------- */}
    <section class="section section--alt">
      <div class="container">
        <div class="cbs-value">
          <div class="cbs-value__copy">
            <span class="eyebrow">Por qué nos eligen las marcas</span>
            <h2>
              La mayoría de las agencias de social commerce nunca ha operado una tienda. Nosotros
              sí.
            </h2>
            <p>
              Nuestro equipo viene de Publicis Commerce China. Hemos construido y operado tiendas en
              Douyin y RedNote para marcas globales de consumo. Sabemos qué creadores convierten
              porque los hemos briefado. Sabemos qué premia Qianchuan porque hemos invertido contra
              él cada día.
            </p>
            <blockquote class="cbs-quote cbs-quote--inline">
              <p>
                La mayoría de los consultores que hablan de Douyin y RedNote no ha operado nunca una
                tienda en ninguna de las dos. Nosotros sí, y eso cambia lo que le contamos.
              </p>
            </blockquote>
            <p>
              Hemos perdido un 11.11 y ganado el siguiente. Cuando le contamos en marzo lo que
              funciona, es porque estábamos dentro de la plataforma en febrero.
            </p>
            <a href="/es/quienes-somos#team" class="btn btn--secondary cbs-magnetic"
              >Conocer al equipo</a
            >
          </div>

          <ul class="cbs-promise">
            <li>
              <span class="eyebrow">Lo que puede esperar</span>
            </li>
            {
              promises.map((p) => (
                <li class="cbs-promise__item">
                  <span class="cbs-promise__check" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="5 12 10 17 19 8" />
                    </svg>
                  </span>
                  <div>
                    <h4>{p.title}</h4>
                    <p>{p.desc}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ---------- WHAT WE DO ---------- */}
    <section class="section">
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Lo que hacemos</span>
          <h2>Seis cosas, las lleva un solo equipo</h2>
          <p class="section-header__lead">
            Ni cuatro agencias, ni cuatro briefs, ni cuatro facturas. Un operador para contenido,
            comercio, creadores y medios. La estrategia que entra en el deck es la que el lunes
            corre en plataforma.
          </p>
        </header>

        <div class="cbs-services cbs-reveal">
          {
            services.map((s, i) => (
              <a href={s.href} class="cbs-service" style={`--reveal-delay: ${i * 60}ms;`}>
                <span class="cbs-service__icon" aria-hidden="true" set:html={icons[s.icon]} />
                <h3 class="cbs-service__title">{s.title}</h3>
                <p class="cbs-service__body">{s.body}</p>
                <span class="cbs-service__arrow">
                  Saber más
                  <span class="cbs-service__arrow-icon" aria-hidden="true">
                    →
                  </span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- DECISION POINT (Two models) ---------- */}
    <section id="decision-point" class="section section--alt cbs-models-section">
      <div class="container">
        <header class="section-header section-header--center cbs-reveal">
          <span class="eyebrow">Punto de decisión</span>
          <h2>¿Quién asume el stock? Dos formas de operar su tienda social.</h2>
          <p class="section-header__lead">
            La primera pregunta comercial en cualquier tienda de Douyin o RedNote es quién asume el
            inventario. Esa respuesta determina el contrato, el margen y cómo registra los ingresos
            chinos. Trabajamos con dos modelos. Elija el que encaje con la forma en que quiere ver
            China en sus libros.
          </p>
        </header>

        <div class="cbs-tabs cbs-tabs--two cbs-reveal" data-tabs>
          <div class="cbs-tabs__nav" role="tablist">
            {
              models.map((m, i) => (
                <button
                  type="button"
                  class={`cbs-tabs__tab${i === 0 ? ' is-active' : ''}`}
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-controls={`model-panel-${i}`}
                  id={`model-tab-${i}`}
                  data-tab-target={`model-panel-${i}`}
                >
                  <span class="cbs-tabs__tab-label">{m.name}</span>
                  <span class="cbs-tabs__tab-tag">{m.tag}</span>
                  {m.highlight && <span class="cbs-tabs__tab-pop">El más habitual</span>}
                </button>
              ))
            }
            <span class="cbs-tabs__indicator" aria-hidden="true"></span>
          </div>

          <div class="cbs-tabs__panels">
            {
              models.map((m, i) => (
                <div
                  class={`cbs-tabs__panel${i === 0 ? ' is-active' : ''}`}
                  role="tabpanel"
                  id={`model-panel-${i}`}
                  aria-labelledby={`model-tab-${i}`}
                  hidden={i !== 0}
                >
                  <div class="cbs-tabs__panel-grid">
                    <div class="cbs-tabs__lead">
                      <span class="cbs-tabs__pillset">
                        <span class="cbs-tabs__pill">{m.tag}</span>
                      </span>
                      <h3 class="cbs-tabs__title">{m.name}</h3>
                      <p class="cbs-tabs__desc">{m.desc}</p>
                      <div class="cbs-tabs__when">
                        <span class="cbs-tabs__when-label">Encaja cuando</span>
                        <p>{m.when}</p>
                      </div>

                      <div class="cbs-owns">
                        <span class="cbs-owns__label">Quién asume qué</span>
                        <ul class="cbs-owns__list">
                          {m.owns.map((o) => (
                            <li>
                              <span class="cbs-owns__key">{o.label}</span>
                              <span class="cbs-owns__val">{o.value}</span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <a href="/es/contacto" class="btn btn--primary cbs-magnetic">
                        Hablar del {m.name}
                      </a>
                    </div>

                    <div class="cbs-tabs__body">
                      <figure class="cbs-tabs__image">
                        <img src={m.image} alt={m.imageAlt} loading="lazy" decoding="async" />
                      </figure>

                      <div class="cbs-tabs__list-wrap">
                        <span class="cbs-tabs__list-label">Lo que recibe</span>
                        <ul class="cbs-tabs__list">
                          {m.yourSide.map((b) => (
                            <li>
                              <span class="cbs-tabs__check" aria-hidden="true">
                                <svg
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2.4"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                >
                                  <polyline points="5 12 10 17 19 8" />
                                </svg>
                              </span>
                              <span>{b}</span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <div class="cbs-tabs__list-wrap cbs-tabs__list-wrap--alt">
                        <span class="cbs-tabs__list-label">Lo que llevamos</span>
                        <ul class="cbs-tabs__list">
                          {m.ourSide.map((b) => (
                            <li>
                              <span class="cbs-tabs__check cbs-tabs__check--alt" aria-hidden="true">
                                <svg
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2.4"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                >
                                  <polyline points="5 12 10 17 19 8" />
                                </svg>
                              </span>
                              <span>{b}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        {/* ---------- HOW TO PICK: Comparison Table ---------- */}
        <div class="cbs-compare cbs-reveal">
          <div class="cbs-compare__intro">
            <span class="eyebrow">Cómo elegir</span>
            <h3>Una pregunta, dos respuestas</h3>
            <p>
              ¿Quiere ser dueño de la relación con el cliente en Douyin y RedNote o prefiere una
              salida mayorista limpia? Eso decide el modelo.
            </p>
          </div>
          <div class="cbs-compare__table-wrap">
            <table class="cbs-compare__table">
              <thead>
                <tr>
                  <th scope="col" class="cbs-compare__row-head-col"></th>
                  <th scope="col" class="cbs-compare__head cbs-compare__head--tp">
                    <span class="cbs-compare__head-label">Modelo DP</span>
                    <span class="cbs-compare__head-sub">Usted asume el stock</span>
                  </th>
                  <th scope="col" class="cbs-compare__head cbs-compare__head--dist">
