    /* ---------- FAQ FILTER ---------- */
    .dis-faq-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-bottom: var(--space-6);
    }
    .dis-faq-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
