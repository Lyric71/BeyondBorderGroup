      font-size: clamp(1.25rem, 1vw + 0.75rem, 1.625rem);
      line-height: 1.25;
      margin: 0 0 var(--space-4);
      letter-spacing: -0.01em;
    }
    .mec-context__card p {
      color: var(--bbg-text);
      line-height: 1.7;
      font-size: 1.0625rem;
      margin: 0;
    }
    @media (max-width: 1024px) {
      .mec-context {
        grid-template-columns: 1fr;
      }
      .mec-context__body {
        padding: var(--space-5) var(--space-6) var(--space-6);
      }
    }

    /* ---------- VALUE + PROMISES ---------- */
    .mec-value {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
    .mec-value__copy h2 {
      font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
      line-height: 1.15;
      letter-spacing: -0.015em;
      margin: var(--space-3) 0 var(--space-4);
    }
    .mec-value__copy p {
      color: var(--bbg-text);
      line-height: 1.7;
      font-size: 1.0625rem;
      margin: 0 0 var(--space-5);
    }
    .mec-value__quote {
      margin: var(--space-5) 0;
      padding: var(--space-4) var(--space-5);
      border-left: 3px solid var(--bbg-blue);
      background: var(--bbg-white);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      font-size: 1.1875rem;
      line-height: 1.4;
      color: var(--bbg-ink);
      font-weight: 500;
      font-style: normal;
      letter-spacing: -0.01em;
    }
    .mec-promise {
      list-style: none;
      padding: var(--space-6);
      margin: 0;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }
    .mec-promise > li:first-child .eyebrow {
      margin-bottom: 0;
    }
    .mec-promise__item {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: var(--space-4);
      align-items: start;
    }
    .mec-promise__check {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .mec-promise__check svg {
      width: 16px;
      height: 16px;
    }
    .mec-promise__item h4 {
      font-size: 1.125rem;
      margin: 0 0 var(--space-2);
      letter-spacing: -0.005em;
      color: var(--bbg-ink);
    }
    .mec-promise__item p {
      font-size: 0.975rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .mec-value {
        grid-template-columns: 1fr;
        gap: var(--space-6);
      }
    }

    /* ---------- MODELS SECTION BACKGROUND ---------- */
    .mec-models-section {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    .mec-models-section__bg {
      position: absolute;
      top: 0;
      right: -8%;
      width: 55%;
      height: 100%;
      z-index: -1;
      opacity: 0.18;
      mask-image: radial-gradient(ellipse at right center, black 0%, transparent 65%);
      -webkit-mask-image: radial-gradient(ellipse at right center, black 0%, transparent 65%);
      pointer-events: none;
    }
    .mec-models-section__bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: saturate(0.6);
    }
    @media (max-width: 900px) {
      .mec-models-section__bg {
        display: none;
      }
    }

    /* ---------- SELL IN / SELL OUT ROUTES ---------- */
    .mec-routes {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
      align-items: stretch;
    }
    .mec-route {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 24px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition:
        transform 380ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    }
    .mec-route:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow:
        0 24px 50px -28px rgba(200, 16, 46, 0.45),
        0 6px 14px -8px rgba(0, 0, 0, 0.08);
    }
    /* Dim the other route on hover */
    .mec-routes:hover .mec-route {
      opacity: 0.7;
      transition: opacity 280ms ease;
    }
    .mec-routes .mec-route:hover {
      opacity: 1;
    }
    .mec-route--featured {
      border-color: rgba(200, 16, 46, 0.35);
    }
    .mec-route--featured::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(180deg, rgba(200, 16, 46, 0.04) 0%, rgba(200, 16, 46, 0) 40%);
      z-index: 1;
    }

    .mec-route__media {
      position: relative;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: var(--bbg-surface);
    }
    .mec-route__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .mec-route:hover .mec-route__media img {
      transform: scale(1.04);
    }
    .mec-route__pill {
      position: absolute;
      top: var(--space-4);
      left: var(--space-4);
      display: inline-flex;
      align-items: center;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bbg-white);
      background: rgba(8, 18, 28, 0.7);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      padding: 0.45em 0.9em;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .mec-route__badge {
      position: absolute;
      top: var(--space-4);
      right: var(--space-4);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-blue-dark);
      background: var(--bbg-white);
      padding: 0.4em 0.85em;
      border-radius: 999px;
      box-shadow: 0 4px 12px -4px rgba(8, 18, 28, 0.3);
    }

    .mec-route__body {
      position: relative;
      padding: var(--space-6) var(--space-6) var(--space-6);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      flex-grow: 1;
      z-index: 2;
    }
    .mec-route__head {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .mec-route__title {
      font-size: clamp(1.5rem, 1.4vw + 1rem, 1.875rem);
      line-height: 1.15;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-ink);
      font-weight: 700;
    }
    .mec-route__tagline {
      font-size: 1.0625rem;
      line-height: 1.4;
      color: var(--bbg-blue);
      margin: 0;
      font-weight: 600;
    }
    .mec-route__desc {
      font-size: 0.975rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }

    /* Control split visualisation */
    .mec-route__split {
      padding: var(--space-4);
      background: var(--bbg-surface);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .mec-route__split-labels {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      color: var(--bbg-text);
      line-height: 1.2;
    }
    .mec-route__split-labels strong {
      color: var(--bbg-ink);
      font-weight: 700;
    }
    .mec-route__split-label-end {
      color: var(--bbg-text-muted);
    }
    .mec-route__split-bar {
      display: flex;
      height: 12px;
      border-radius: 6px;
      overflow: hidden;
      background: var(--bbg-border);
      gap: 2px;
    }
    .mec-route__split-bar-you {
      width: var(--w, 0%);
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 100%);
      border-radius: 6px 0 0 6px;
      animation: route-grow 800ms cubic-bezier(0.16, 1, 0.3, 1) 200ms both;
    }
    .mec-route__split-bar-them {
      width: var(--w, 0%);
      background: repeating-linear-gradient(
        45deg,
        var(--bbg-text-muted) 0 4px,
        rgba(107, 107, 107, 0.6) 4px 8px
      );
      border-radius: 0 6px 6px 0;
      animation: route-grow 800ms cubic-bezier(0.16, 1, 0.3, 1) 300ms both;
    }
    .mec-route__split-bar-you:only-child,
    .mec-route__split-bar-them:only-child {
      border-radius: 6px;
    }
    @keyframes route-grow {
      from {
        transform: scaleX(0);
        transform-origin: left center;
      }
      to {
        transform: scaleX(1);
        transform-origin: left center;
      }
    }
    .mec-route__split-caption {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-top: 0.2rem;
    }

    /* Dimensions grid */
    .mec-route__dims {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .mec-route__dim {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: var(--space-3);
      font-size: 0.875rem;
      padding: 0.55rem 0;
      border-bottom: 1px solid var(--bbg-border);
    }
    .mec-route__dim:last-child {
      border-bottom: none;
    }
    .mec-route__dim-label {
      color: var(--bbg-text);
      font-weight: 500;
    }
    .mec-route__dim-dots {
      display: inline-flex;
      gap: 4px;
      align-items: center;
    }
    .mec-route__dim-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--bbg-border);
      transition: background 240ms ease;
    }
    .mec-route__dim-dot.is-on {
      background: var(--bbg-blue);
    }
    .mec-route__dim-value {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--bbg-ink);
      min-width: 56px;
      text-align: right;
      letter-spacing: -0.005em;
      flex-shrink: 0;
    }
    @media (max-width: 640px) {
      .mec-route__dim-value {
        min-width: 0;
        font-size: 0.8rem;
      }
    }

    /* Lists block */
    .mec-route__lists {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid var(--bbg-border);
    }
    .mec-route__list-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: var(--space-3);
    }
    .mec-route__list--muted .mec-route__list-label {
      color: var(--bbg-text-muted);
    }
    .mec-route__list ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }
    .mec-route__list li {
      display: grid;
      grid-template-columns: 18px 1fr;
      gap: 0.5rem;
      align-items: start;
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--bbg-text);
    }
    .mec-route__check {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 1px;
    }
    .mec-route__check svg {
      width: 11px;
      height: 11px;
    }
    .mec-route__dash {
      display: inline-block;
      width: 12px;
      height: 2px;
      background: var(--bbg-text-muted);
      border-radius: 2px;
      margin-top: 0.6em;
      justify-self: center;
    }

    /* Best when callout */
    .mec-route__when {
      padding: var(--space-4);
      background: var(--bbg-blue-light);
      border-radius: 12px;
      border-left: 3px solid var(--bbg-blue);
    }
    .mec-route__when-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.4rem;
    }
    .mec-route__when p {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--bbg-ink);
    }

    /* CTA */
    .mec-route__cta {
      align-self: flex-start;
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .mec-route__cta-arrow {
      display: inline-block;
      transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .mec-route__cta:hover .mec-route__cta-arrow {
      transform: translateX(4px);
    }

    @media (max-width: 1024px) {
      .mec-routes {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 560px) {
      .mec-route__lists {
        grid-template-columns: 1fr;
      }
      .mec-route__body {
        padding: var(--space-5);
      }
    }

    /* ---------- BUSINESS MODELS TABS ---------- */
    .mec-tabs {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 16px 48px -28px rgba(8, 18, 28, 0.18);
    }
    .mec-tabs__nav {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
      background: linear-gradient(180deg, var(--bbg-surface) 0%, var(--bbg-white) 100%);
      border-bottom: 1px solid var(--bbg-border);
    }
    .mec-tabs__tab {
      position: relative;
      background: transparent;
      border: none;
      padding: var(--space-5) var(--space-5);
      text-align: left;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      color: var(--bbg-text-muted);
      transition:
        color 240ms ease,
        background 240ms ease;
      border-right: 1px solid var(--bbg-border);
      font-family: inherit;
    }
    .mec-tabs__tab:last-child {
      border-right: none;
    }
    .mec-tabs__tab:hover {
      color: var(--bbg-ink);
      background: rgba(200, 16, 46, 0.04);
    }
    .mec-tabs__tab.is-active {
      color: var(--bbg-ink);
      background: var(--bbg-white);
    }
    .mec-tabs__tab-label {
      font-size: 1.0625rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      line-height: 1.2;
    }
    .mec-tabs__tab-tag {
      font-size: 0.85rem;
      color: var(--bbg-text-muted);
      line-height: 1.35;
    }
    .mec-tabs__tab.is-active .mec-tabs__tab-tag {
      color: var(--bbg-blue);
    }
    .mec-tabs__tab-pop {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .mec-tabs__indicator {
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 50%;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 100%);
      border-radius: 2px 2px 0 0;
      transform: translateX(0);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }
    .mec-tabs__panels {
      background: var(--bbg-white);
    }
    .mec-tabs__panel {
      padding: clamp(var(--space-5), 4vw + 1rem, var(--space-7));
      animation: mec-tab-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes mec-tab-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .mec-tabs__panel[hidden] {
      display: none;
    }
    .mec-tabs__panel-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .mec-tabs__lead {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .mec-tabs__pillset {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .mec-tabs__pill {
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.35em 0.85em;
      border-radius: 999px;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      letter-spacing: 0.01em;
    }
    .mec-tabs__pill--soft {
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
    }
    .mec-tabs__title {
      font-size: clamp(1.625rem, 1.8vw + 1rem, 2.25rem);
      line-height: 1.1;
      margin: 0;
      letter-spacing: -0.015em;
    }
    .mec-tabs__desc {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .mec-tabs__when {
      padding: var(--space-4);
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--bbg-blue);
    }
    .mec-tabs__when-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.35rem;
    }
    .mec-tabs__when p {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--bbg-text);
    }
    .mec-tabs__body {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .mec-tabs__list-wrap {
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .mec-tabs__list-wrap--muted {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
    }
    .mec-tabs__list-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .mec-tabs__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .mec-tabs__list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--bbg-text);
    }
    .mec-tabs__check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .mec-tabs__check svg {
      width: 12px;
      height: 12px;
    }
    .mec-tabs__list--muted li {
      grid-template-columns: 14px 1fr;
    }
    .mec-tabs__dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--bbg-text-muted);
      margin-top: 0.55em;
      margin-left: 3px;
    }
    .mec-tabs__pricing {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      padding: var(--space-4);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.12) 100%);
      border-radius: var(--radius-md);
      border: 1px solid rgba(200, 16, 46, 0.2);
    }
    .mec-tabs__pricing-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue-dark);
      flex-shrink: 0;
    }
    .mec-tabs__pricing-value {
      font-size: 1rem;
      font-weight: 600;
      color: var(--bbg-ink);
      line-height: 1.4;
    }
    @media (max-width: 1024px) {
      .mec-tabs__nav {
        grid-template-columns: repeat(2, 1fr);
      }
      .mec-tabs__panel-grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 560px) {
      .mec-tabs__nav {
        grid-template-columns: 1fr;
      }
      .mec-tabs__tab {
        border-right: none;
        border-bottom: 1px solid var(--bbg-border);
      }
      .mec-tabs__indicator {
        display: none;
      }
    }

    /* ---------- PHASE PANEL (new visual layout) ---------- */
    .mec-phase-panel {
      padding: 0 !important;
    }
    .mec-phase {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 0;
      align-items: stretch;
    }
    .mec-phase__media {
      position: relative;
      margin: 0;
      min-height: 100%;
      overflow: hidden;
      background: var(--bbg-surface);
    }
    .mec-phase__media img {
      width: 100%;
      height: 100%;
      min-height: 360px;
      object-fit: cover;
      display: block;
    }
    .mec-phase__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(8, 18, 28, 0) 50%, rgba(8, 18, 28, 0.75) 100%);
      pointer-events: none;
    }
    .mec-phase__media-overlay {
      position: absolute;
      left: var(--space-5);
      bottom: var(--space-5);
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      align-items: center;
      z-index: 2;
    }
    .mec-phase__media-phase {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bbg-white);
      background: rgba(8, 18, 28, 0.75);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      padding: 0.45em 0.85em;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .mec-phase__media-duration {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--bbg-blue-dark);
      background: var(--bbg-white);
      padding: 0.4em 0.85em;
      border-radius: 999px;
      box-shadow: 0 4px 12px -4px rgba(8, 18, 28, 0.35);
    }
    .mec-phase__media-duration svg {
      width: 14px;
      height: 14px;
    }

    .mec-phase__content {
      padding: clamp(var(--space-5), 2.4vw + 1rem, var(--space-7));
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .mec-phase__head {
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .mec-phase__icon {
      flex-shrink: 0;
      width: 52px;
      height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.18) 100%);
      color: var(--bbg-blue);
      box-shadow: inset 0 0 0 1px rgba(200, 16, 46, 0.15);
    }
    .mec-phase__icon svg {
      width: 26px;
      height: 26px;
    }
    .mec-phase__phase-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.3rem;
    }
    .mec-phase__title {
      font-size: clamp(1.375rem, 1.4vw + 1rem, 1.875rem);
      line-height: 1.15;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-ink);
      font-weight: 700;
    }
    .mec-phase__intro {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }

    /* Outcome callout */
    .mec-phase__outcome {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-4);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.12) 100%);
      border-radius: 14px;
      border-left: 3px solid var(--bbg-blue);
    }
    .mec-phase__outcome-label {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-blue-dark);
    }
    .mec-phase__outcome-label svg {
      width: 16px;
      height: 16px;
      fill: var(--bbg-blue);
      stroke: var(--bbg-blue);
    }
    .mec-phase__outcome p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.45;
      color: var(--bbg-ink);
      font-weight: 600;
      letter-spacing: -0.005em;
    }

    /* Two columns: checks + docs */
    .mec-phase__columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
      padding-top: var(--space-4);
      border-top: 1px solid var(--bbg-border);
    }
    .mec-phase__col-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .mec-phase__checks {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .mec-phase__checks li {
      display: grid;
      grid-template-columns: 20px 1fr;
      gap: 0.55rem;
      align-items: start;
      font-size: 0.92rem;
      line-height: 1.45;
      color: var(--bbg-text);
      animation: phase-fade-in 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--seq, 0) * 90ms + 80ms);
    }
    .mec-phase__check {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 1px;
    }
    .mec-phase__check svg {
      width: 11px;
      height: 11px;
    }

    /* Document tiles */
    .mec-phase__docs {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }
    .mec-phase__doc {
      display: grid;
      grid-template-columns: 36px 1fr;
      gap: 0.7rem;
      align-items: center;
      padding: 0.7rem 0.9rem;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 10px;
      transition:
        border-color 220ms ease,
        transform 220ms ease,
        box-shadow 220ms ease;
      animation: phase-fade-in 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--seq, 0) * 90ms + 200ms);
    }
    .mec-phase__doc:hover {
      border-color: var(--bbg-blue);
      transform: translateX(2px);
      box-shadow: 0 8px 20px -12px rgba(200, 16, 46, 0.4);
    }
    .mec-phase__doc-icon {
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      flex-shrink: 0;
    }
    .mec-phase__doc-icon svg {
      width: 18px;
      height: 18px;
    }
    .mec-phase__doc-name {
      font-size: 0.9rem;
      line-height: 1.35;
      color: var(--bbg-ink);
      font-weight: 600;
      letter-spacing: -0.005em;
    }

    @keyframes phase-fade-in {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .mec-phase__checks li,
      .mec-phase__doc {
        animation: none;
      }
    }

    @media (max-width: 1024px) {
      .mec-phase {
        grid-template-columns: 1fr;
      }
      .mec-phase__media img {
        min-height: 0;
        aspect-ratio: 16 / 9;
      }
    }
    @media (max-width: 600px) {
      .mec-phase__columns {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- TABS - PHASES VARIANT (4 columns, eyebrow above label) ---------- */
    .mec-tabs__nav--phases {
      grid-template-columns: repeat(4, 1fr);
    }
    .mec-tabs__nav--phases + .mec-tabs__panels {
      /* keep panel layout shared */
    }
    .mec-tabs--phases .mec-tabs__tab {
      gap: 0.5rem;
    }
    .mec-tabs__tab-eyebrow {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      line-height: 1;
    }
    .mec-tabs__tab:not(.is-active) .mec-tabs__tab-eyebrow {
      color: var(--bbg-text-muted);
    }
    .mec-tabs--phases .mec-tabs__tab-label {
      font-size: 1rem;
      line-height: 1.25;
    }
    .mec-phase-head {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }
    .mec-phase-head__icon {
      display: inline-flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      flex-shrink: 0;
      box-shadow: inset 0 0 0 1px rgba(200, 16, 46, 0.15);
    }
    .mec-phase-head__icon svg {
      width: 22px;
      height: 22px;
    }
    .mec-phase-head .mec-tabs__title {
      margin: 0;
    }

    @media (max-width: 1024px) {
      .mec-tabs__nav--phases {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .mec-tabs__nav--phases {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- MATRIX ---------- */
    .mec-matrix {
      margin-top: var(--space-8);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: clamp(var(--space-5), 3vw + 1rem, var(--space-7));
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    }
    .mec-matrix__intro {
      text-align: center;
      margin-bottom: var(--space-6);
    }
    .mec-matrix__intro h3 {
      font-size: clamp(1.375rem, 1.2vw + 1rem, 1.75rem);
      margin: var(--space-2) 0 var(--space-3);
      letter-spacing: -0.01em;
    }
    .mec-matrix__intro p {
      color: var(--bbg-text);
      max-width: 56ch;
      margin: 0 auto;
      line-height: 1.6;
      font-size: 1rem;
    }
    .mec-matrix__grid {
      display: grid;
      grid-template-columns: minmax(140px, 0.8fr) 1fr 1fr;
      gap: 1px;
      background: var(--bbg-border);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .mec-matrix__corner,
    .mec-matrix__head,
    .mec-matrix__row-head,
    .mec-matrix__cell {
      background: var(--bbg-white);
      padding: var(--space-4);
    }
    .mec-matrix__corner {
      background: var(--bbg-surface);
    }
    .mec-matrix__head {
      background: var(--bbg-surface);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mec-matrix__row-head {
      background: var(--bbg-surface);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      display: flex;
      align-items: center;
    }
    .mec-matrix__cell {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      transition: background var(--dur) var(--ease);
      cursor: pointer;
      border: none;
      text-align: left;
      font-family: inherit;
    }
    .mec-matrix__cell:hover {
      background: var(--bbg-blue-light);
    }
    .mec-matrix__cell:focus-visible {
      outline: 3px solid var(--bbg-blue);
      outline-offset: -3px;
    }
    .mec-matrix__cell-label {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .mec-matrix__cell-sub {
      font-size: 0.9rem;
      color: var(--bbg-text);
      line-height: 1.45;
    }
    .mec-matrix__note {
      margin: var(--space-5) auto 0;
      max-width: 68ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 0.975rem;
    }
    .mec-matrix__grid.is-hover-row .mec-matrix__cell {
      opacity: 0.4;
    }
    .mec-matrix__grid.is-hover-row .mec-matrix__cell.is-row-active,
    .mec-matrix__grid.is-hover-row .mec-matrix__cell.is-col-active {
      opacity: 1;
      background: var(--bbg-blue-light);
    }
    .mec-matrix__grid.is-hover-row .mec-matrix__row-head,
    .mec-matrix__grid.is-hover-row .mec-matrix__head {
      opacity: 0.4;
    }
    .mec-matrix__grid.is-hover-row .mec-matrix__row-head.is-active,
    .mec-matrix__grid.is-hover-row .mec-matrix__head.is-active {
      opacity: 1;
      background: var(--bbg-blue);
      color: var(--bbg-white);
    }
    @media (max-width: 720px) {
      .mec-matrix__grid {
        grid-template-columns: 1fr 1fr;
      }
      .mec-matrix__corner {
        display: none;
      }
      .mec-matrix__head {
        font-size: 0.75rem;
        padding: var(--space-3);
      }
      .mec-matrix__row-head {
        grid-column: 1 / -1;
        background: var(--bbg-blue-light);
        color: var(--bbg-blue-dark);
        justify-content: center;
        padding: var(--space-3);
      }
    }

    /* ---------- JOURNEY (vertical timeline) ---------- */
    .mec-journey-section {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    .mec-journey-section__bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
      opacity: 0.1;
      pointer-events: none;
    }
    .mec-journey-section__bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        var(--bbg-surface) 0%,
        rgba(247, 249, 251, 0.6) 40%,
        rgba(247, 249, 251, 0.9) 100%
      );
    }
    .mec-journey-section__bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: saturate(0.55);
    }

    .mec-journey {
      position: relative;
      max-width: 920px;
      margin: 0 auto;
      padding-left: 64px;
    }
    .mec-journey__rail {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 26px;
      width: 2px;
    }
    .mec-journey__rail-track {
      position: absolute;
      inset: 0;
      background: var(--bbg-border);
      border-radius: 2px;
    }
    .mec-journey__rail-fill {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: var(--journey-progress, 0%);
      background: linear-gradient(180deg, var(--bbg-blue) 0%, #e84a60 100%);
      border-radius: 2px;
      transition: height 120ms linear;
      box-shadow: 0 0 8px rgba(200, 16, 46, 0.4);
    }
    .mec-journey__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }
    .mec-journey__item {
      position: relative;
    }
    .mec-journey__dot {
      position: absolute;
      left: -64px;
      top: 8px;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--bbg-white);
      border: 2px solid var(--bbg-border);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      transition: border-color 320ms ease;
    }
    .mec-journey__dot-inner {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--bbg-border);
      transition:
        background 320ms ease,
        transform 320ms ease;
    }
    .mec-journey__item.is-active .mec-journey__dot {
      border-color: var(--bbg-blue);
    }
    .mec-journey__item.is-active .mec-journey__dot-inner {
      background: var(--bbg-blue);
      transform: scale(1.1);
      box-shadow: 0 0 0 4px var(--bbg-blue-light);
    }
    .mec-journey__phase {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
      transition: color 320ms ease;
    }
    .mec-journey__item.is-active .mec-journey__phase {
      color: var(--bbg-blue);
    }
    .mec-journey__card {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6) var(--space-7);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      transition:
        border-color 320ms ease,
        box-shadow 320ms ease,
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .mec-journey__item:hover .mec-journey__card,
    .mec-journey__item.is-active .mec-journey__card {
      border-color: var(--bbg-blue);
      box-shadow: 0 18px 38px -22px rgba(200, 16, 46, 0.4);
      transform: translateX(4px);
    }
    .mec-journey__card-head {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }
    .mec-journey__icon {
      display: inline-flex;
      width: 48px;
      height: 48px;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      flex-shrink: 0;
    }
    .mec-journey__icon svg {
      width: 24px;
      height: 24px;
    }
    .mec-journey__title {
      font-size: clamp(1.25rem, 1vw + 0.875rem, 1.625rem);
      line-height: 1.2;
      margin: 0;
      letter-spacing: -0.01em;
      font-weight: 700;
      color: var(--bbg-ink);
    }
    .mec-journey__desc {
      font-size: 1.0625rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .mec-journey__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
      padding-top: var(--space-4);
      border-top: 1px solid var(--bbg-border);
    }
    .mec-journey__label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .mec-journey__label--blue {
      color: var(--bbg-blue);
    }
    .mec-journey__bullets {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .mec-journey__bullets li {
      position: relative;
      padding-left: 1.25rem;
      color: var(--bbg-text);
      line-height: 1.5;
      font-size: 0.95rem;
    }
    .mec-journey__bullets li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.55em;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--bbg-border);
    }
    .mec-journey__bullets--blue li::before {
      background: var(--bbg-blue);
    }

    @media (max-width: 720px) {
      .mec-journey {
        padding-left: 40px;
      }
      .mec-journey__rail {
        left: 16px;
      }
      .mec-journey__dot {
        left: -40px;
        width: 36px;
        height: 36px;
        top: 4px;
      }
      .mec-journey__dot-inner {
        width: 12px;
        height: 12px;
      }
      .mec-journey__card {
        padding: var(--space-5);
      }
      .mec-journey__grid {
        grid-template-columns: 1fr;
        gap: var(--space-4);
      }
    }

    /* ---------- BEYONDCOMPASS ---------- */
    .mec-compass {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      border-radius: 24px;
      color: var(--bbg-white);
      padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8));
      box-shadow: 0 24px 60px -30px rgba(8, 18, 28, 0.55);
    }
    .mec-compass__bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(80% 60% at 100% 0%, rgba(200, 16, 46, 0.42) 0%, rgba(200, 16, 46, 0) 60%),
        radial-gradient(60% 50% at 0% 100%, rgba(200, 16, 46, 0.22) 0%, rgba(200, 16, 46, 0) 60%),
        linear-gradient(160deg, #0e2030 0%, #08141f 60%);
    }
    .mec-compass__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: center;
    }
    .mec-compass__copy {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      min-width: 0;
    }
    .mec-compass__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
