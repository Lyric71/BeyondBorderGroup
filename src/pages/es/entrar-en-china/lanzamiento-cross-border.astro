      position: absolute; inset: 0; z-index: -1;
      background-image:
        radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
      background-size: 3px 3px;
      mix-blend-mode: overlay;
      opacity: 0.45;
      pointer-events: none;
    }
    .cbs-hero__inner { max-width: 980px; position: relative; }
    .cbs-hero__crumbs {
      margin-bottom: var(--space-4);
      font-size: var(--fs-small);
      display: flex;
      gap: 0.5rem;
      align-items: center;
      color: rgba(255, 255, 255, 0.7);
    }
    .cbs-hero__crumbs a { color: rgba(255, 255, 255, 0.85); font-weight: 500; }
    .cbs-hero__crumbs a:hover { color: var(--bbg-white); }
    .cbs-hero__inner .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-3);
      color: #9DDBF5;
    }
    .cbs-hero__title {
      font-size: clamp(2rem, 3.4vw + 1rem, 3.75rem);
      line-height: 1.06;
      letter-spacing: -0.025em;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      max-width: 22ch;
      font-weight: 700;
      display: flex;
      flex-direction: column;
      gap: 0.05em;
    }
    .cbs-hero__title-row { display: block; }
    .cbs-hero__title-row--accent {
      color: #9DDBF5;
      font-weight: 500;
      font-style: italic;
      letter-spacing: -0.018em;
    }
    .cbs-hero__title-row--highlight {
      position: relative;
      display: inline-block;
      align-self: flex-start;
      padding: 0 0.15em;
    }
    .cbs-hero__title-row--highlight::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.04em;
      height: 0.18em;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      border-radius: 2px;
      transform-origin: left center;
      animation: cbs-underline 900ms cubic-bezier(0.16, 1, 0.3, 1) 600ms both;
      z-index: -1;
    }
    @keyframes cbs-underline {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
    .cbs-hero__lead {
      font-size: clamp(1rem, 0.5vw + 1rem, 1.1875rem);
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.86);
      max-width: 58ch;
      margin: 0 0 var(--space-5);
    }
    .cbs-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-6); }
    .cbs-magnetic:hover { transform: translateY(-2px); }

    .cbs-hero__meta {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(var(--space-4), 4vw, var(--space-7));
      padding-top: var(--space-5);
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      max-width: 720px;
    }
    .cbs-hero__meta-item { display: flex; flex-direction: column; gap: 0.2rem; }
    .cbs-hero__meta-num {
      font-size: clamp(1.625rem, 1.2vw + 1rem, 2.125rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1;
      color: var(--bbg-white);
      font-feature-settings: "tnum";
    }
    .cbs-hero__meta-label {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.66);
      letter-spacing: 0.02em;
    }

    .cbs-hero__scroll {
      position: absolute;
      bottom: var(--space-5);
      right: clamp(var(--space-5), 4vw, var(--space-7));
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      transition: color 200ms ease;
    }
    .cbs-hero__scroll:hover { color: var(--bbg-white); }
    .cbs-hero__scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.6) 100%);
      position: relative;
      overflow: hidden;
    }
    .cbs-hero__scroll-line::after {
      content: "";
      position: absolute;
      top: -100%;
      left: 0;
      right: 0;
      height: 50%;
      background: linear-gradient(180deg, transparent 0%, var(--bbg-white) 100%);
      animation: cbs-scroll-tick 1.8s ease-in-out infinite;
    }
    @keyframes cbs-scroll-tick {
      0% { top: -50%; }
      100% { top: 100%; }
    }
    @media (max-width: 720px) {
      .cbs-hero__scroll { display: none; }
      .cbs-hero__meta { gap: var(--space-4); }
    }

    /* ---------- CONTEXT (two truths) ---------- */
    .cbs-context {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
    .cbs-context__card {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
    }
    .cbs-context__card:hover {
      border-color: var(--bbg-blue);
      box-shadow: var(--shadow-md);
    }
    .cbs-context__card--alt {
      background: var(--bbg-blue-light);
      border-color: transparent;
    }
    .cbs-context__media {
      margin: 0;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: var(--bbg-border);
    }
    .cbs-context__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 600ms var(--ease);
    }
    .cbs-context__card:hover .cbs-context__media img {
      transform: scale(1.03);
    }
    .cbs-context__body {
      padding: var(--space-6) var(--space-7) var(--space-7);
    }
    .cbs-context__card h3 {
      font-size: clamp(1.25rem, 1vw + 0.75rem, 1.625rem);
      line-height: 1.25;
      margin: 0 0 var(--space-4);
      letter-spacing: -0.01em;
    }
    .cbs-context__card p {
      color: var(--bbg-text);
      line-height: 1.7;
      font-size: 1.0625rem;
      margin: 0;
    }
    @media (max-width: 1024px) {
      .cbs-context { grid-template-columns: 1fr; }
      .cbs-context__body { padding: var(--space-5) var(--space-6) var(--space-6); }
    }

    /* ---------- VALUE + PROMISES ---------- */
    .cbs-value {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
    .cbs-value__copy h2 {
      font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
      line-height: 1.15;
      letter-spacing: -0.015em;
      margin: var(--space-3) 0 var(--space-4);
    }
    .cbs-value__copy p {
      color: var(--bbg-text);
      line-height: 1.7;
      font-size: 1.0625rem;
      margin: 0 0 var(--space-6);
    }
    .cbs-value__stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
      padding-top: var(--space-5);
      border-top: 1px solid var(--bbg-border);
    }
    .cbs-value__stat-value {
      display: block;
      font-size: clamp(1.875rem, 1.6vw + 1rem, 2.5rem);
      font-weight: 700;
      color: var(--bbg-blue);
      line-height: 1;
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
      font-feature-settings: "tnum";
    }
    .cbs-value__stat-label {
      display: block;
      font-size: var(--fs-small);
      color: var(--bbg-text-muted);
      line-height: 1.35;
    }
    .cbs-promise {
      list-style: none;
      padding: var(--space-6);
      margin: 0;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }
    .cbs-promise > li:first-child .eyebrow { margin-bottom: 0; }
    .cbs-promise__item {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: var(--space-4);
      align-items: start;
    }
    .cbs-promise__check {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .cbs-promise__check svg { width: 16px; height: 16px; }
    .cbs-promise__item h4 {
      font-size: 1.125rem;
      margin: 0 0 var(--space-2);
      letter-spacing: -0.005em;
      color: var(--bbg-ink);
    }
    .cbs-promise__item p {
      font-size: 0.975rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .cbs-value { grid-template-columns: 1fr; gap: var(--space-6); }
      .cbs-value__stats { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 640px) {
      .cbs-value__stats { grid-template-columns: 1fr; }
    }

    /* ---------- SERVICES ---------- */
    .cbs-services {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
    .cbs-service {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      overflow: hidden;
      isolation: isolate;
      transition:
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .cbs-service::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(120% 80% at 100% 0%,
        rgba(38, 154, 218, 0.10) 0%,
        rgba(38, 154, 218, 0) 55%);
      opacity: 0;
      transition: opacity 320ms ease;
      z-index: -1;
    }
    .cbs-service:hover {
      transform: translateY(-6px);
      border-color: var(--bbg-blue);
      box-shadow: 0 18px 38px -22px rgba(38, 154, 218, 0.45),
                  0 4px 10px -6px rgba(0, 0, 0, 0.08);
    }
    .cbs-service:hover::before { opacity: 1; }
    .cbs-service:hover .cbs-service__icon { transform: scale(1.08) rotate(-3deg); }
    .cbs-service__icon {
      display: inline-flex;
      width: 52px;
      height: 52px;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(38, 154, 218, 0.16) 100%);
      color: var(--bbg-blue);
      margin-bottom: var(--space-4);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: inset 0 0 0 1px rgba(38, 154, 218, 0.15);
    }
    .cbs-service__icon svg { width: 26px; height: 26px; }
    .cbs-service h3 {
      font-size: 1.1875rem;
      line-height: 1.25;
      margin: 0 0 var(--space-3);
      letter-spacing: -0.005em;
    }
    .cbs-service p {
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) { .cbs-services { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .cbs-services { grid-template-columns: 1fr; } }

    /* ---------- BUSINESS MODELS SECTION BACKGROUND ---------- */
    .cbs-models-section { position: relative; isolation: isolate; overflow: hidden; }
    .cbs-models-section__bg {
      position: absolute;
      top: 0;
      right: -8%;
      width: 55%;
      height: 100%;
      z-index: -1;
      opacity: 0.18;
      mask-image: radial-gradient(ellipse at right center, black 0%, transparent 65%);
      -webkit-mask-image: radial-gradient(ellipse at right center, black 0%, transparent 65%);
      pointer-events: none;
    }
    .cbs-models-section__bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: saturate(0.6);
    }
    @media (max-width: 900px) { .cbs-models-section__bg { display: none; } }

    /* ---------- HOW WE WORK SECTION BACKGROUND ---------- */
    .cbs-steps-section { position: relative; isolation: isolate; overflow: hidden; }
    .cbs-steps-section__bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
      opacity: 0.10;
      pointer-events: none;
    }
    .cbs-steps-section__bg::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg,
        var(--bbg-white) 0%,
        rgba(255, 255, 255, 0.4) 40%,
        rgba(255, 255, 255, 0.7) 100%);
      pointer-events: none;
    }
    .cbs-steps-section__bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: saturate(0.55);
    }

    /* ---------- BUSINESS MODELS ---------- */
    .cbs-models {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
      align-items: stretch;
    }
    .cbs-model {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-7);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
    }
    .cbs-model:hover {
      border-color: var(--bbg-blue);
      box-shadow: var(--shadow-md);
    }
    .cbs-model--highlight {
      background: linear-gradient(180deg, var(--bbg-blue-light) 0%, var(--bbg-white) 60%);
      border-color: var(--bbg-blue);
      box-shadow: var(--shadow-md);
    }
    .cbs-model__badge {
      position: absolute;
      top: -12px;
      left: var(--space-7);
      background: var(--bbg-blue);
      color: var(--bbg-white);
      font-size: var(--fs-label);
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.4em 0.9em;
      border-radius: 999px;
    }
    .cbs-model__tag {
      display: inline-flex;
      align-self: flex-start;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      padding: 0.4em 0.85em;
      border-radius: 999px;
      border: 1px solid var(--bbg-border);
    }
    .cbs-model--highlight .cbs-model__tag {
      background: var(--bbg-white);
      color: var(--bbg-blue);
      border-color: rgba(38, 154, 218, 0.25);
    }
    .cbs-model__title {
      font-size: 1.5rem;
      line-height: 1.2;
      margin: 0;
      letter-spacing: -0.01em;
    }
    .cbs-model__desc {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-model__when {
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
      padding: var(--space-3) var(--space-4);
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--bbg-blue);
    }
    .cbs-model__when strong {
      color: var(--bbg-ink);
      font-weight: 600;
    }
    .cbs-model__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      border-top: 1px solid var(--bbg-border);
      border-bottom: 1px solid var(--bbg-border);
      padding: var(--space-4) 0;
    }
    .cbs-model__list li {
      position: relative;
      padding-left: 1.5rem;
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--bbg-text);
    }
    .cbs-model__list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.55em;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--bbg-blue);
    }
    .cbs-model__pricing { display: flex; flex-direction: column; gap: 0.25rem; }
    .cbs-model__pricing-label {
      font-size: var(--fs-label);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
    }
    .cbs-model__pricing-value {
      font-size: 1rem;
      color: var(--bbg-ink);
      font-weight: 600;
      line-height: 1.4;
    }
    .cbs-model__cta { align-self: flex-start; margin-top: auto; }
    @media (max-width: 1024px) {
      .cbs-models { grid-template-columns: 1fr; }
      .cbs-model { padding: var(--space-6); }
    }

    /* ---------- MATRIX (How to pick) ---------- */
    .cbs-matrix {
      margin-top: var(--space-8);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: clamp(var(--space-5), 3vw + 1rem, var(--space-7));
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    }
    .cbs-matrix__intro { text-align: center; margin-bottom: var(--space-6); }
    .cbs-matrix__intro h3 {
      font-size: clamp(1.375rem, 1.2vw + 1rem, 1.75rem);
      margin: var(--space-2) 0 var(--space-3);
      letter-spacing: -0.01em;
    }
    .cbs-matrix__intro p {
      color: var(--bbg-text);
      max-width: 56ch;
      margin: 0 auto;
      line-height: 1.6;
      font-size: 1rem;
    }
    .cbs-matrix__grid {
      display: grid;
      grid-template-columns: minmax(140px, 0.8fr) 1fr 1fr;
      gap: 1px;
      background: var(--bbg-border);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .cbs-matrix__corner,
    .cbs-matrix__head,
    .cbs-matrix__row-head,
    .cbs-matrix__cell {
      background: var(--bbg-white);
      padding: var(--space-4);
    }
    .cbs-matrix__corner { background: var(--bbg-surface); }
    .cbs-matrix__head {
      background: var(--bbg-surface);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .cbs-matrix__row-head {
      background: var(--bbg-surface);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      display: flex;
      align-items: center;
    }
    .cbs-matrix__cell {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      transition: background var(--dur) var(--ease);
      cursor: default;
    }
    .cbs-matrix__cell:hover { background: var(--bbg-blue-light); }
    .cbs-matrix__cell-label {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-matrix__cell-sub {
      font-size: 0.9rem;
      color: var(--bbg-text);
      line-height: 1.45;
    }
    .cbs-matrix__note {
      margin: var(--space-5) auto 0;
      max-width: 68ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 0.975rem;
    }
    @media (max-width: 720px) {
      .cbs-matrix__grid {
        grid-template-columns: 1fr 1fr;
      }
      .cbs-matrix__corner { display: none; }
      .cbs-matrix__head { font-size: 0.75rem; padding: var(--space-3); }
      .cbs-matrix__row-head {
        grid-column: 1 / -1;
        background: var(--bbg-blue-light);
        color: var(--bbg-blue-dark);
        justify-content: center;
        padding: var(--space-3);
      }
    }

    /* ---------- CASE STUDIES ---------- */
    .cbs-case {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
      color: var(--bbg-ink);
    }
    .cbs-case:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: var(--shadow-md);
      color: var(--bbg-ink);
    }
    .cbs-case__tag {
      font-size: var(--fs-label);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
    }
    .cbs-case__title {
      font-size: 1.5rem;
      line-height: 1.2;
      margin: 0;
      color: var(--bbg-ink);
      letter-spacing: -0.01em;
    }
    .cbs-case__desc {
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
      flex-grow: 1;
    }
    .cbs-case__cta {
      font-size: var(--fs-small);
      color: var(--bbg-blue);
      font-weight: 600;
      margin-top: var(--space-2);
    }
    .cbs-case:hover .cbs-case__cta span { display: inline-block; transform: translateX(4px); transition: transform var(--dur) var(--ease); }

    /* ---------- CASES CTA ---------- */
    .cbs-cases-cta { display: flex; justify-content: center; }

    /* ---------- PLATFORMS ---------- */
    .cbs-platforms {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
    .cbs-platform {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      color: var(--bbg-ink);
      overflow: hidden;
      isolation: isolate;
      transition: transform var(--dur) var(--ease),
                  border-color var(--dur) var(--ease),
                  box-shadow var(--dur) var(--ease);
    }
    .cbs-platform::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg,
        var(--platform-color, var(--bbg-blue)) 0%,
        var(--platform-accent, var(--bbg-blue-dark)) 100%);
      transform: scaleX(0.4);
      transform-origin: left center;
      transition: transform var(--dur) var(--ease);
    }
    .cbs-platform::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 100% 0%,
        color-mix(in srgb, var(--platform-color, #269ADA) 12%, transparent) 0%,
        transparent 55%);
      opacity: 0;
      transition: opacity var(--dur) var(--ease);
      z-index: -1;
      pointer-events: none;
    }
    .cbs-platform:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--platform-color, #269ADA) 60%, var(--bbg-border));
      box-shadow: 0 18px 40px -22px color-mix(in srgb, var(--platform-color, #269ADA) 55%, transparent),
                  0 4px 12px -6px rgba(0, 0, 0, 0.08);
      color: var(--bbg-ink);
    }
    .cbs-platform:hover::before { transform: scaleX(1); }
    .cbs-platform:hover::after { opacity: 1; }
    .cbs-platform__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }
    .cbs-platform__logo {
      width: 76px;
      height: 76px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-md);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      padding: 14px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
    }
    .cbs-platform:hover .cbs-platform__logo {
      border-color: color-mix(in srgb, var(--platform-color, #269ADA) 35%, var(--bbg-border));
      transform: scale(1.04);
    }
    .cbs-platform__logo img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
    .cbs-platform__cn {
      font-size: 1.5rem;
      font-weight: 700;
      color: color-mix(in srgb, var(--platform-color, #269ADA) 75%, var(--bbg-ink));
      line-height: 1;
      letter-spacing: 0.02em;
      opacity: 0.85;
    }
    .cbs-platform__body { display: flex; flex-direction: column; gap: var(--space-2); flex-grow: 1; }
    .cbs-platform__title {
      font-size: 1.375rem;
      line-height: 1.2;
      margin: 0;
      color: var(--bbg-ink);
      letter-spacing: -0.01em;
      font-weight: 700;
    }
    .cbs-platform__sub {
      font-size: 0.9375rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-platform__cta {
      font-size: var(--fs-small);
      color: var(--platform-color, var(--bbg-blue));
      font-weight: 700;
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
    }
    .cbs-platform:hover .cbs-platform__cta span { display: inline-block; transform: translateX(4px); transition: transform var(--dur) var(--ease); }
    @media (max-width: 1024px) { .cbs-platforms { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .cbs-platforms { grid-template-columns: 1fr; } }

    /* ---------- HOW WE WORK / STEPS ---------- */
    .cbs-steps {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
      counter-reset: step;
      position: relative;
    }
    .cbs-steps__line {
      display: none;
    }
    @media (min-width: 901px) {
      .cbs-steps__line {
        display: block;
        position: absolute;
        top: 56px;
        left: 12%;
        right: 12%;
        height: 2px;
        background: linear-gradient(90deg,
          rgba(38, 154, 218, 0) 0%,
          rgba(38, 154, 218, 0.35) 12%,
          rgba(38, 154, 218, 0.55) 50%,
          rgba(38, 154, 218, 0.35) 88%,
          rgba(38, 154, 218, 0) 100%);
        z-index: 0;
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 1200ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .cbs-steps.is-in .cbs-steps__line { transform: scaleX(1); }
    }
    .cbs-step {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      position: relative;
      z-index: 1;
      transition:
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .cbs-step:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: 0 16px 32px -20px rgba(38, 154, 218, 0.4),
                  0 4px 10px -6px rgba(0, 0, 0, 0.06);
    }
    .cbs-step__icon {
      display: inline-flex;
      width: 56px;
      height: 56px;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--bbg-white);
      color: var(--bbg-blue);
      margin-bottom: var(--space-4);
      box-shadow: 0 0 0 3px var(--bbg-blue-light), inset 0 0 0 1px rgba(38, 154, 218, 0.18);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-step:hover .cbs-step__icon { transform: scale(1.06) rotate(4deg); }
    .cbs-step__icon svg { width: 26px; height: 26px; }
    .cbs-step__title {
      font-size: 1.375rem;
      line-height: 1.25;
      margin: 0 0 var(--space-3);
      letter-spacing: -0.01em;
    }
    .cbs-step__desc {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) { .cbs-steps { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .cbs-steps { grid-template-columns: 1fr; } }

    /* ---------- AI ---------- */
    .cbs-ai {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: var(--space-4);
    }
    .cbs-ai__card {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      overflow: hidden;
      isolation: isolate;
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .cbs-ai__card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 50%, var(--bbg-blue) 100%);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-ai__card:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: 0 14px 30px -18px rgba(38, 154, 218, 0.42),
                  0 4px 10px -6px rgba(0, 0, 0, 0.06);
    }
    .cbs-ai__card:hover::before { transform: scaleX(1); }
    .cbs-ai__icon {
      display: inline-flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-md);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(38, 154, 218, 0.18) 100%);
      color: var(--bbg-blue);
      margin-bottom: var(--space-3);
      box-shadow: inset 0 0 0 1px rgba(38, 154, 218, 0.12);
      transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-ai__card:hover .cbs-ai__icon { transform: scale(1.08) rotate(-4deg); }
    .cbs-ai__icon svg { width: 20px; height: 20px; }
    .cbs-ai__card h3 {
      font-size: 1.0625rem;
      line-height: 1.3;
      margin: 0 0 var(--space-2);
      letter-spacing: -0.005em;
    }
    .cbs-ai__card p {
      font-size: 0.9375rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .cbs-ai { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 560px) {
      .cbs-ai { grid-template-columns: 1fr; }
    }

    /* ---------- FAQ ---------- */
    .cbs-faq {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-faq__item {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition: border-color 240ms ease, box-shadow 240ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cbs-faq__item:hover {
      transform: translateX(2px);
      border-color: rgba(38, 154, 218, 0.4);
    }
    .cbs-faq__item[open] {
      border-color: var(--bbg-blue);
      box-shadow: 0 8px 22px -14px rgba(38, 154, 218, 0.4);
    }
    .cbs-faq__q {
      cursor: pointer;
      padding: var(--space-5);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      font-weight: 600;
      font-size: 1.0625rem;
      line-height: 1.3;
      color: var(--bbg-ink);
      list-style: none;
      transition: color var(--dur) var(--ease);
    }
    .cbs-faq__q::-webkit-details-marker { display: none; }
    .cbs-faq__q::marker { display: none; }
    .cbs-faq__item:hover .cbs-faq__q { color: var(--bbg-blue); }
    .cbs-faq__icon {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
                  color var(--dur) var(--ease),
                  background var(--dur) var(--ease);
    }
    .cbs-faq__item[open] .cbs-faq__icon {
      transform: rotate(180deg);
      color: var(--bbg-white);
      background: var(--bbg-blue);
    }
    .cbs-faq__a {
      padding: 0 var(--space-5) var(--space-5);
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
      animation: cbs-faq-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-faq-in {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .cbs-faq__a p { margin: 0; }

    /* ---------- FINAL CTA ---------- */
    .cbs-cta {
      padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8)) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
      color: var(--bbg-white);
      border-radius: var(--radius-lg);
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .cbs-cta::before {
      content: "";
      position: absolute;
      top: -40%;
      right: -10%;
      width: 420px;
      height: 420px;
      background: radial-gradient(circle at center, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 65%);
      pointer-events: none;
    }
    .cbs-cta .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-4);
      color: rgba(255, 255, 255, 0.9);
    }
    .cbs-cta__title {
      font-size: clamp(1.75rem, 1.5vw + 1rem, 2.5rem);
      line-height: 1.15;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      letter-spacing: -0.015em;
    }
    .cbs-cta__lead {
      color: rgba(255, 255, 255, 0.92);
      font-size: 1.0625rem;
      max-width: 52ch;
      margin: 0 auto var(--space-5);
      line-height: 1.55;
    }
    .cbs-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      justify-content: center;
      position: relative;
    }
    .cbs-cta__btn-primary {
      background: var(--bbg-white);
      color: var(--bbg-blue-dark);
      border: 1px solid var(--bbg-white);
    }
    .cbs-cta__btn-primary:hover {
      background: rgba(255, 255, 255, 0.92);
      color: var(--bbg-blue-dark);
    }
    .cbs-cta__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: var(--bbg-white);
    }
    .cbs-cta__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }

    /* ================================================== */
    /* ============ V2 SECTION REBUILDS ================= */
    /* ================================================== */

    /* ---------- SERVICES (balanced 2x2) ---------- */
    .cbs-svc-section .section-header--split { align-items: end; gap: var(--space-6); margin-bottom: var(--space-6); }
    .cbs-svc-lead {
      max-width: 44ch;
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-svc-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
    .cbs-svc-card {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 20px;
      padding: var(--space-6);
      overflow: hidden;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      min-height: 320px;
      transition:
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .cbs-svc-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, var(--svc-color, #269ADA) 0%, var(--svc-color, #269ADA) 50%, transparent 100%);
      transform: scaleX(0.3);
      transform-origin: left center;
      transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1;
    }
    .cbs-svc-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(140% 90% at 100% 0%,
        color-mix(in srgb, var(--svc-color, #269ADA) 14%, transparent) 0%,
        transparent 55%);
      opacity: 0;
      transition: opacity 360ms ease;
      z-index: -1;
      pointer-events: none;
    }
    .cbs-svc-card:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--svc-color, #269ADA) 55%, var(--bbg-border));
      box-shadow: 0 22px 50px -26px color-mix(in srgb, var(--svc-color, #269ADA) 50%, transparent),
                  0 6px 14px -8px rgba(0, 0, 0, 0.08);
    }
    .cbs-svc-card:hover::before { transform: scaleX(1); }
    .cbs-svc-card:hover::after { opacity: 1; }
    .cbs-svc-card:hover .cbs-svc-card__icon {
      transform: scale(1.06) rotate(-4deg);
      background: var(--svc-color, var(--bbg-blue));
      color: var(--bbg-white);
      box-shadow: 0 12px 24px -14px color-mix(in srgb, var(--svc-color, #269ADA) 70%, transparent),
                  inset 0 0 0 1px color-mix(in srgb, var(--svc-color, #269ADA) 30%, transparent);
    }
    .cbs-svc-card:hover .cbs-svc-card__arrow { transform: translateX(4px); color: var(--svc-color, var(--bbg-blue)); }

    .cbs-svc-card__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }
    .cbs-svc-card__icon {
      display: inline-flex;
      width: 56px;
      height: 56px;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      background: var(--svc-soft, var(--bbg-blue-light));
      color: var(--svc-color, var(--bbg-blue));
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--svc-color, #269ADA) 18%, transparent);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
                  background 320ms ease, color 320ms ease, box-shadow 320ms ease;
      flex-shrink: 0;
    }
    .cbs-svc-card__icon svg { width: 28px; height: 28px; }
    .cbs-svc-card__short {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--svc-color, var(--bbg-blue));
      text-align: right;
      line-height: 1.4;
    }
    .cbs-svc-card__title {
      font-size: 1.5rem;
      line-height: 1.18;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-ink);
    }
    .cbs-svc-card__desc {
      font-size: 0.975rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-svc-card__points {
      list-style: none;
      padding: var(--space-4) 0 0;
      margin: 0;
      border-top: 1px solid var(--bbg-border);
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      margin-top: auto;
    }
    .cbs-svc-card__points li {
      display: grid;
      grid-template-columns: 14px 1fr;
      gap: 0.6rem;
      align-items: center;
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--bbg-text);
    }
    .cbs-svc-card__bullet {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--svc-color, var(--bbg-blue));
      box-shadow: 0 0 0 3px var(--svc-soft, var(--bbg-blue-light));
      margin-left: 4px;
    }
    .cbs-svc-card__arrow {
      position: absolute;
      bottom: var(--space-6);
      right: var(--space-6);
      color: var(--bbg-text-muted);
      transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1), color 200ms ease;
      pointer-events: none;
    }
    .cbs-svc-card__arrow svg { width: 22px; height: 22px; }
    @media (max-width: 720px) {
      .cbs-svc-grid { grid-template-columns: 1fr; }
      .cbs-svc-card { min-height: 0; }
      .cbs-svc-section .section-header--split { flex-direction: column; align-items: flex-start; }
    }

    /* ---------- BUSINESS MODELS TABS ---------- */
    .cbs-tabs {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 16px 48px -28px rgba(8, 18, 28, 0.18);
    }
    .cbs-tabs__nav {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      background: linear-gradient(180deg, var(--bbg-surface) 0%, var(--bbg-white) 100%);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-tabs__tab {
      position: relative;
      background: transparent;
      border: none;
      padding: var(--space-5) var(--space-4);
      text-align: left;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      color: var(--bbg-text-muted);
      transition: color 240ms ease, background 240ms ease;
      border-right: 1px solid var(--bbg-border);
    }
    .cbs-tabs__tab:last-child { border-right: none; }
    .cbs-tabs__tab:hover { color: var(--bbg-ink); background: rgba(38, 154, 218, 0.04); }
    .cbs-tabs__tab.is-active { color: var(--bbg-ink); background: var(--bbg-white); }
    .cbs-tabs__tab-label {
      font-size: 1.0625rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      line-height: 1.2;
    }
    .cbs-tabs__tab-tag {
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      line-height: 1.35;
    }
    .cbs-tabs__tab.is-active .cbs-tabs__tab-tag { color: var(--bbg-blue); }
    .cbs-tabs__tab-pop {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .cbs-tabs__indicator {
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 25%;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #5BC2F0 100%);
      border-radius: 2px 2px 0 0;
      transform: translateX(0);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }
    .cbs-tabs__panels { background: var(--bbg-white); }
    .cbs-tabs__panel {
      padding: clamp(var(--space-5), 4vw + 1rem, var(--space-7));
      animation: cbs-tab-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
