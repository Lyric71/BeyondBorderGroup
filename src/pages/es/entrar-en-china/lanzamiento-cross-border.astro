              e.preventDefault();
              const next = tabs[(idx + 1) % tabs.length];
              next.focus();
              setActive(next);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
              prev.focus();
              setActive(prev);
            }
          });
        });

        // Initialise indicator on the active tab
        const initialActive = tabs.find((t) => t.classList.contains('is-active')) || tabs[0];
        if (initialActive) setActive(initialActive);
      }

      // 8. Matrix cell hover highlights row + column, click jumps to a tab
      const matrix = document.querySelector('[data-matrix] .cbs-matrix__grid');
      if (matrix) {
        const cells = Array.from(matrix.querySelectorAll('.cbs-matrix__cell'));
        const heads = Array.from(matrix.querySelectorAll('.cbs-matrix__head'));
        const rowHeads = Array.from(matrix.querySelectorAll('.cbs-matrix__row-head'));

        const clearHighlight = () => {
          matrix.classList.remove('is-hover-row');
          cells.forEach((c) => c.classList.remove('is-row-active', 'is-col-active'));
          heads.forEach((h) => h.classList.remove('is-active'));
          rowHeads.forEach((h) => h.classList.remove('is-active'));
        };

        cells.forEach((cell) => {
          const row = cell.dataset.row;
          const col = cell.dataset.col;
          cell.addEventListener('mouseenter', () => {
            matrix.classList.add('is-hover-row');
            cells.forEach((c) => {
              c.classList.toggle('is-row-active', c.dataset.row === row);
              c.classList.toggle('is-col-active', c.dataset.col === col);
            });
            heads.forEach((h) => h.classList.toggle('is-active', h.dataset.col === col));
            rowHeads.forEach((h) => h.classList.toggle('is-active', h.dataset.row === row));
          });
          cell.addEventListener('mouseleave', clearHighlight);
          cell.addEventListener('click', () => {
            const targetTabId = cell.dataset.tabJump;
            const tab = targetTabId && document.getElementById(targetTabId);
            if (tab) {
              tab.click();
              tab.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
              tab.focus();
            }
          });
        });
      }

      // 9. Journey vertical timeline scroll progress + active state
      const journey = document.querySelector('[data-journey]');
      if (journey) {
        const fill = journey.querySelector('[data-journey-fill]');
        const items = Array.from(journey.querySelectorAll('[data-journey-item]'));

        const updateJourney = () => {
          const rect = journey.getBoundingClientRect();
          const vh = window.innerHeight;
          const total = rect.height;
          const visible = Math.max(0, Math.min(total, vh * 0.55 - rect.top));
          const pct = Math.max(0, Math.min(100, (visible / total) * 100));
          if (fill) fill.style.setProperty('--journey-progress', pct + '%');

          items.forEach((item) => {
            const r = item.getBoundingClientRect();
            const center = r.top + r.height / 2;
            const inActive = center < vh * 0.6 && center > 0;
            item.classList.toggle('is-active', inActive);
          });
        };

        let journeyTicking = false;
        const onJourneyScroll = () => {
          if (journeyTicking) return;
          journeyTicking = true;
          requestAnimationFrame(() => {
            updateJourney();
            journeyTicking = false;
          });
        };
        window.addEventListener('scroll', onJourneyScroll, { passive: true });
        window.addEventListener('resize', onJourneyScroll, { passive: true });
        updateJourney();
      }

      // 10. FAQ category filter
      const faqFilter = document.querySelector('[data-faq-filter]');
      const faqList = document.querySelector('[data-faq-list]');
      if (faqFilter && faqList) {
        const chips = Array.from(faqFilter.querySelectorAll('.cbs-faq-chip'));
        const items = Array.from(faqList.querySelectorAll('.cbs-faq__item'));
        chips.forEach((chip) => {
          chip.addEventListener('click', () => {
            const cat = chip.dataset.faqCat;
            chips.forEach((c) => {
              const on = c === chip;
              c.classList.toggle('is-active', on);
              c.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            items.forEach((item) => {
              const matches = cat === 'Todo' || item.dataset.faqCat === cat;
              item.classList.toggle('is-hidden', !matches);
            });
          });
        });
      }
    })();
  </script>
</Layout>
