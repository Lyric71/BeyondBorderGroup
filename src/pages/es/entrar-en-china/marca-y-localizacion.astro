    .bl-faq__icon {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        color var(--dur) var(--ease),
