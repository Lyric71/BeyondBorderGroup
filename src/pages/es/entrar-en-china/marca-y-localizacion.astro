      color: rgba(255, 255, 255, 0.7);
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      transition: color 200ms ease;
    }
    .bl-hero__scroll:hover {
      color: var(--bbg-white);
    }
    .bl-hero__scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.6) 100%);
      position: relative;
      overflow: hidden;
    }
    .bl-hero__scroll-line::after {
      content: '';
      position: absolute;
      top: -100%;
      left: 0;
      right: 0;
      height: 50%;
      background: linear-gradient(180deg, transparent 0%, var(--bbg-white) 100%);
      animation: bl-scroll-tick 1.8s ease-in-out infinite;
    }
    @keyframes bl-scroll-tick {
      0% {
        top: -50%;
      }
      100% {
        top: 100%;
      }
    }
    @media (max-width: 720px) {
      .bl-hero__scroll {
        display: none;
      }
      .bl-hero__meta {
        gap: var(--space-4);
      }
    }

    /* ---------- THREE THINGS ---------- */
    .bl-pillars {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
    .bl-pillar {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition:
        border-color var(--dur) var(--ease),
        box-shadow var(--dur) var(--ease),
        transform var(--dur) var(--ease);
    }
    .bl-pillar:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: var(--shadow-md);
    }
    .bl-pillar__media {
      margin: 0;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: var(--bbg-surface);
    }
    .bl-pillar__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 600ms var(--ease);
    }
    .bl-pillar:hover .bl-pillar__media img {
      transform: scale(1.04);
    }
    .bl-pillar__body {
      padding: var(--space-5) var(--space-6) var(--space-6);
    }
    .bl-pillar__body h3 {
      font-size: clamp(1.125rem, 0.5vw + 0.9rem, 1.375rem);
      line-height: 1.25;
      margin: 0 0 var(--space-3);
      letter-spacing: -0.005em;
      color: var(--bbg-ink);
    }
    .bl-pillar__body p {
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
      margin: 0;
    }
    @media (max-width: 1024px) {
      .bl-pillars {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 640px) {
      .bl-pillars {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- VALUE + PROMISES ---------- */
    .bl-value {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
    .bl-value__copy h2 {
      font-size: clamp(1.75rem, 2vw + 1rem, 2.5rem);
      line-height: 1.15;
      letter-spacing: -0.015em;
      margin: var(--space-3) 0 var(--space-4);
    }
    .bl-value__copy p {
      color: var(--bbg-text);
      line-height: 1.7;
      font-size: 1.0625rem;
      margin: 0 0 var(--space-4);
    }
    .bl-promise {
      list-style: none;
      padding: var(--space-6);
      margin: 0;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }
    .bl-promise > li:first-child .eyebrow {
      margin-bottom: 0;
    }
    .bl-promise__item {
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: var(--space-4);
      align-items: start;
    }
    .bl-promise__check {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .bl-promise__check svg {
      width: 16px;
      height: 16px;
    }
    .bl-promise__item h4 {
      font-size: 1.125rem;
      margin: 0 0 var(--space-2);
      letter-spacing: -0.005em;
      color: var(--bbg-ink);
    }
    .bl-promise__item p {
      font-size: 0.975rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) {
      .bl-value {
        grid-template-columns: 1fr;
        gap: var(--space-6);
      }
    }

    /* ---------- SERVICES BENTO ---------- */
    .bl-svc-section .section-header--split {
      align-items: end;
      gap: var(--space-6);
      margin-bottom: var(--space-6);
    }
    .bl-svc-lead {
      max-width: 44ch;
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .bl-svc-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
    .bl-svc-card {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 20px;
      padding: var(--space-6);
      overflow: hidden;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      min-height: 320px;
      transition:
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .bl-svc-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(
        90deg,
        var(--svc-color, #c8102e) 0%,
        var(--svc-color, #c8102e) 50%,
        transparent 100%
      );
      transform: scaleX(0.3);
      transform-origin: left center;
      transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1;
    }
    .bl-svc-card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(
        140% 90% at 100% 0%,
        color-mix(in srgb, var(--svc-color, #c8102e) 14%, transparent) 0%,
        transparent 55%
      );
      opacity: 0;
      transition: opacity 360ms ease;
      z-index: -1;
      pointer-events: none;
    }
    .bl-svc-card:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--svc-color, #c8102e) 55%, var(--bbg-border));
      box-shadow:
        0 22px 50px -26px color-mix(in srgb, var(--svc-color, #c8102e) 50%, transparent),
        0 6px 14px -8px rgba(0, 0, 0, 0.08);
    }
    .bl-svc-card:hover::before {
      transform: scaleX(1);
    }
    .bl-svc-card:hover::after {
      opacity: 1;
    }
    .bl-svc-card:hover .bl-svc-card__icon {
      transform: scale(1.06) rotate(-4deg);
      background: var(--svc-color, var(--bbg-blue));
      color: var(--bbg-white);
      box-shadow:
        0 12px 24px -14px color-mix(in srgb, var(--svc-color, #c8102e) 70%, transparent),
        inset 0 0 0 1px color-mix(in srgb, var(--svc-color, #c8102e) 30%, transparent);
    }
    .bl-svc-card:hover .bl-svc-card__arrow {
      transform: translateX(4px);
      color: var(--svc-color, var(--bbg-blue));
    }
    .bl-svc-card__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }
    .bl-svc-card__icon {
      display: inline-flex;
      width: 56px;
      height: 56px;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      background: var(--svc-soft, var(--bbg-blue-light));
      color: var(--svc-color, var(--bbg-blue));
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--svc-color, #c8102e) 18%, transparent);
      transition:
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
        background 320ms ease,
        color 320ms ease,
        box-shadow 320ms ease;
      flex-shrink: 0;
    }
    .bl-svc-card__icon svg {
      width: 28px;
      height: 28px;
    }
    .bl-svc-card__short {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--svc-color, var(--bbg-blue));
      text-align: right;
      line-height: 1.4;
    }
    .bl-svc-card__title {
      font-size: 1.5rem;
      line-height: 1.18;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-ink);
    }
    .bl-svc-card__desc {
      font-size: 0.975rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .bl-svc-card__points {
      list-style: none;
      padding: var(--space-4) 0 0;
      margin: 0;
      border-top: 1px solid var(--bbg-border);
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      margin-top: auto;
    }
    .bl-svc-card__points li {
      display: grid;
      grid-template-columns: 14px 1fr;
      gap: 0.6rem;
      align-items: center;
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--bbg-text);
    }
    .bl-svc-card__bullet {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--svc-color, var(--bbg-blue));
      box-shadow: 0 0 0 3px var(--svc-soft, var(--bbg-blue-light));
      margin-left: 4px;
    }
    .bl-svc-card__arrow {
      position: absolute;
      bottom: var(--space-6);
      right: var(--space-6);
      color: var(--bbg-text-muted);
      transition:
        transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
        color 200ms ease;
      pointer-events: none;
    }
    .bl-svc-card__arrow svg {
      width: 22px;
      height: 22px;
    }
    @media (max-width: 720px) {
      .bl-svc-grid {
        grid-template-columns: 1fr;
      }
      .bl-svc-card {
        min-height: 0;
      }
      .bl-svc-section .section-header--split {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    /* ---------- STARTING POINTS TABS ---------- */
    .bl-tabs {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 16px 48px -28px rgba(8, 18, 28, 0.18);
    }
    .bl-tabs__nav {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      background: linear-gradient(180deg, var(--bbg-surface) 0%, var(--bbg-white) 100%);
      border-bottom: 1px solid var(--bbg-border);
    }
    .bl-tabs__tab {
      position: relative;
      background: transparent;
      border: none;
      padding: var(--space-5) var(--space-4);
      text-align: left;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      color: var(--bbg-text-muted);
      transition:
        color 240ms ease,
        background 240ms ease;
      border-right: 1px solid var(--bbg-border);
      font-family: inherit;
    }
    .bl-tabs__tab:last-child {
      border-right: none;
    }
    .bl-tabs__tab:hover {
      color: var(--bbg-ink);
      background: rgba(200, 16, 46, 0.04);
    }
    .bl-tabs__tab.is-active {
      color: var(--bbg-ink);
      background: var(--bbg-white);
    }
    .bl-tabs__tab-label {
      font-size: 1.0625rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      line-height: 1.2;
    }
    .bl-tabs__tab-tag {
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      line-height: 1.35;
    }
    .bl-tabs__tab.is-active .bl-tabs__tab-tag {
      color: var(--bbg-blue);
    }
    .bl-tabs__tab-pop {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .bl-tabs__indicator {
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 25%;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 100%);
      border-radius: 2px 2px 0 0;
      transform: translateX(0);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }
    .bl-tabs__panels {
      background: var(--bbg-white);
    }
    .bl-tabs__panel {
      padding: clamp(var(--space-5), 4vw + 1rem, var(--space-7));
      animation: bl-tab-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes bl-tab-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .bl-tabs__panel[hidden] {
      display: none;
    }
    .bl-tabs__panel-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .bl-tabs__lead {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .bl-tabs__pillset {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .bl-tabs__pill {
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.35em 0.85em;
      border-radius: 999px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      letter-spacing: 0.01em;
    }
    .bl-tabs__title {
      font-size: clamp(1.625rem, 1.8vw + 1rem, 2.25rem);
      line-height: 1.1;
      margin: 0;
      letter-spacing: -0.015em;
    }
    .bl-tabs__desc {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .bl-tabs__when {
      padding: var(--space-4);
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--bbg-blue);
    }
    .bl-tabs__when-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.35rem;
    }
    .bl-tabs__when p {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--bbg-text);
    }
    .bl-tabs__body {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .bl-tabs__list-wrap {
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .bl-tabs__list-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .bl-tabs__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .bl-tabs__list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--bbg-text);
    }
    .bl-tabs__check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .bl-tabs__check svg {
      width: 12px;
      height: 12px;
    }
    .bl-tabs__pricing {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      padding: var(--space-4);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.12) 100%);
      border-radius: var(--radius-md);
      border: 1px solid rgba(200, 16, 46, 0.2);
    }
    .bl-tabs__pricing-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue-dark);
      flex-shrink: 0;
    }
    .bl-tabs__pricing-value {
      font-size: 1rem;
      font-weight: 600;
      color: var(--bbg-ink);
      line-height: 1.4;
    }
    @media (max-width: 1024px) {
      .bl-tabs__nav {
        grid-template-columns: repeat(2, 1fr);
      }
      .bl-tabs__tab {
        border-bottom: 1px solid var(--bbg-border);
      }
      .bl-tabs__tab:nth-child(2) {
        border-right: none;
      }
      .bl-tabs__indicator {
        display: none;
      }
      .bl-tabs__panel-grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 560px) {
      .bl-tabs__nav {
        grid-template-columns: 1fr;
      }
      .bl-tabs__tab {
        border-right: none;
      }
    }

    /* ---------- CASES CTA ---------- */
    .bl-cases-cta {
      display: flex;
      justify-content: center;
    }

    /* ---------- CONTENT PRODUCTION (TheRedScroll editorial) ---------- */
    .bl-trs-section {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    .bl-trs {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(var(--space-6), 4vw, var(--space-8));
      align-items: center;
    }
    .bl-trs__text {
      max-width: 60ch;
    }
    .bl-trs__text .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: var(--space-3);
    }
    .bl-trs__bar {
      display: inline-block;
      width: 28px;
      height: 2px;
      background: var(--bbg-blue);
      border-radius: 2px;
    }
    .bl-trs__title {
      font-size: clamp(2rem, 2.6vw + 1rem, 3rem);
      line-height: 1.1;
      letter-spacing: -0.018em;
      margin: 0 0 var(--space-4);
      color: var(--bbg-ink);
    }
    .bl-trs__title-emph {
      display: block;
      color: var(--bbg-blue);
      font-style: italic;
      font-weight: 500;
    }
    .bl-trs__lead {
      font-size: 1.0625rem;
      line-height: 1.7;
      color: var(--bbg-text);
      margin: 0 0 var(--space-4);
    }
    .bl-trs__list {
      list-style: none;
      padding: var(--space-4) 0 0;
      margin: 0 0 var(--space-5);
      border-top: 1px solid var(--bbg-border);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .bl-trs__list li {
      display: grid;
      grid-template-columns: 22px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 1rem;
      line-height: 1.5;
      color: var(--bbg-text);
    }
    .bl-trs__list svg {
      width: 20px;
      height: 20px;
      color: var(--bbg-blue);
      margin-top: 2px;
    }
    .bl-trs__actions {
      display: flex;
      align-items: center;
      gap: var(--space-5);
      flex-wrap: wrap;
    }
    .bl-trs__cta {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.85em 1.4em;
      background: var(--bbg-ink);
      color: var(--bbg-white);
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.95rem;
      letter-spacing: 0.01em;
      transition:
        background 200ms ease,
        transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .bl-trs__cta:hover {
      background: var(--bbg-blue);
      color: var(--bbg-white);
      transform: translateY(-2px);
    }
    .bl-trs__cta svg {
      width: 18px;
      height: 18px;
    }
    .bl-trs__cta:hover svg {
      transform: translateX(2px);
      transition: transform 200ms ease;
    }
    .bl-trs__meta {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
    }

    .bl-trs__aside {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }
    .bl-trs__frame {
      display: block;
      position: relative;
      border-radius: 14px;
      overflow: hidden;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      box-shadow:
        0 24px 60px -28px rgba(8, 18, 28, 0.28),
        0 6px 18px -10px rgba(8, 18, 28, 0.12);
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 320ms ease,
        border-color 240ms ease;
    }
    .bl-trs__frame:hover {
      transform: translateY(-4px);
      border-color: rgba(200, 16, 46, 0.4);
      box-shadow:
        0 32px 70px -28px rgba(200, 16, 46, 0.32),
