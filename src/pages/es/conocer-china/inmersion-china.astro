---
import Layout from '../../../layouts/Layout.astro';

const promises = [
  {
    title: 'Operadores al frente, no guías turísticos',
    desc: 'Quienes dirigen las sesiones llevan cuentas en esas mismas plataformas. Usted pregunta qué tira y le contestan con la campaña de la semana pasada.',
  },
  {
    title: 'Acceso de trabajo, no visitas de escaparate',
    desc: 'Responsables de plataforma, directivos de MCN, operadores de marca. La mayoría se suman porque ya trabajan con nosotros. Verá paneles internos y números en directo allí donde la empresa lo permita.',
  },
  {
    title: 'Un plan hecho a medida, no un dossier',
    desc: 'Un taller el día tres o cuatro convierte lo que ha visto en acciones para su categoría, su presupuesto y su equipo. Se lo cerramos por escrito cuando vuelve a casa.',
  },
];

const formats = [
  {
    icon: 'talk',
    title: 'Diálogos con expertos',
    short: 'Plataformas · Operadores · MCN',
    desc: 'Sesiones con quienes operan las plataformas, las cuentas de marca y las agencias de creadores. La sala está en la sala.',
    points: ['Responsables de cuenta de plataforma', 'Operadores de marca de su categoría', 'Directivos de MCN y mánagers de creadores'],
    color: '#C8102E',
    colorSoft: '#FBE9EC',
  },
  {
    icon: 'building',
    title: 'Visitas a empresas',
    short: 'Sedes · Estudios · Labs de IA',
    desc: 'Recorrido por operaciones en funcionamiento. Las visitas de prensa no son el objetivo. Sistemas internos, allí donde el acceso lo permita.',
    points: ['Centros de operación de plataformas', 'Estudios de producción de contenido y de livestream', 'Empresas de IA, retail tech y logística'],
    color: '#0EA46C',
    colorSoft: '#E6F5EE',
  },
  {
    icon: 'store',
    title: 'Recorridos por tienda',
    short: 'Flagship · Smart retail · Nivel 3',
    desc: 'Comportamiento del consumidor, flujos de pago y tecnología minorista observados en vivo, no contados.',
    points: ['Flagships y tiendas de new retail', 'Formatos de smart retail y O2O', 'Distritos de nivel 3 donde el mainstream falla'],
    color: '#7C5DFA',
    colorSoft: '#F0EDFE',
  },
  {
    icon: 'tools',
    title: 'Talleres',
    short: 'Aplicar · Decidir · Planificar',
    desc: 'Convertir lo que ha visto en un plan operativo para su categoría, su presupuesto y el equipo que tiene que ejecutarlo.',
    points: ['Evaluación de plataformas y canales', 'Diagnóstico de contenido e IA', 'Presupuesto, KPI y hoja de ruta a doce meses'],
    color: '#E54B6E',
    colorSoft: '#FCEAEF',
  },
];

const tracks = [
  {
    name: 'eCommerce y digital',
    tag: '4 días, Tmall + Douyin + JD + RED',
    desc: 'Las plataformas que se llevan el 80 % de las transacciones de consumo. Cómo funcionan, cuánto cuestan y qué hace de verdad un operador en su día a día.',
    when: 'Está entre seis y dieciocho meses del lanzamiento, o ya opera en plataformas y busca una lectura más afinada. Quiere ver a los operadores, los estudios y los paneles que hay detrás de los casos públicos.',
    bullets: [
      'Centros de operaciones de Tmall Global y JD Worldwide',
      'Una marca que opera flagship Cross-Border y doméstico',
      'Producción de contenido y plató de livestream en Douyin',
      'MCN gestionando un porfolio de creadores de su categoría',
      'Responsables de cuenta sobre mecánica y economía de plataforma',
      'Un media buyer digital sobre CAC y conversión por categoría',
    ],
    pricing: 'De seis a diez participantes. Ocho semanas de antelación. Shanghái, con día opcional en Hangzhou.',
    highlight: false,
  },
  {
    name: 'IA y tecnología',
    tag: '4 días, IA que opera en comercio',
    desc: 'Dentro de los sistemas de IA que mueven contenido, comercio, retail y logística en China. Operadores, no vendedores.',
    when: 'Lidera una iniciativa de transformación o tiene un P&L digital. Quiere ver qué entrega la IA en producción de verdad, con cifras de coste y resultados a la vista.',
    bullets: [
      'Empresa de producción de contenido con IA a escala',
      'Sistemas de recomendación dentro de un operador eCommerce activo',
      'Centro de atención al cliente con agentes de IA en mandarín',
      'Tiendas smart retail con visión por ordenador',
      'Almacén con robótica y visión artificial en producción',
      'Asesor de privacidad y cumplimiento sobre PIPL y flujos de datos',
    ],
    pricing: 'De seis a diez participantes. Diez semanas de antelación. Shanghái y Shenzhen.',
    highlight: true,
  },
  {
    name: 'Retail y consumidor',
    tag: '3 o 4 días, tiendas y comportamiento',
    desc: 'Por detrás de las plataformas, las tiendas y los compradores reales. New retail, formatos smart y dinámicas de las ciudades de nivel 3.',
    when: 'Su categoría se apoya en lo físico, o quiere entender al consumidor que ya decidió antes de aparecer en Tmall.',
    bullets: [
      'Flagships de marca y conceptos de new retail',
      'Formatos smart retail con pago sin caja y visión artificial',
      'Distritos comerciales y tráfico en hora punta',
      'Visita a una ciudad de nivel 3 para estudiar la demanda mainstream',
      'Responsable de innovación retail sobre integración O2O',
      'Equipo de investigación de consumidor sobre segmentación por nivel de ciudad',
    ],
    pricing: 'De seis a diez participantes. Ocho semanas de antelación. Shanghái y una ciudad de segundo nivel.',
    highlight: false,
  },
  {
    name: 'Contenido y creadores',
    tag: '4 días, livestream + KOL + MCN',
    desc: 'El motor del content commerce. Estudios, agencias y los creadores que hoy lo hacen funcionar de verdad.',
    when: 'Sus campañas dependen de creadores, o su categoría está pasando de la búsqueda al content commerce. Necesita saber con quién trabajar y cómo se redactan los acuerdos.',
    bullets: [
      'Dos sesiones de livestream en directo en Douyin y RED',
      'MCN con cartera de creadores y rate cards',
      'Productora de contenido sobre el pipeline creativo',
      'Entrevista con un creador top sobre estrategia por niveles y dinámicas de categoría',
      'Mánager de plataforma sobre mecánica de distribución de contenido',
      'Operador de marca sobre KOL frente a KOC frente a contenido propio',
    ],
    pricing: 'De seis a diez participantes. Ocho semanas de antelación. Shanghái y Hangzhou.',
    highlight: false,
  },
];

const cities = [
  {
    name: 'Shanghái',
    cn: '上海',
    mono: 'SH',
    sub: 'Sede comercial de casi todas las marcas en China. Tmall, Pinduoduo, las agencias, los estudios. Casi todas las expediciones arrancan aquí.',
    brandColor: '#C8102E',
    accent: '#A50C26',
  },
  {
    name: 'Hangzhou',
    cn: '杭州',
    mono: 'HZ',
    sub: 'La casa de Alibaba. Operaciones de Tmall y Taobao, polos de livestream commerce y todo el ecosistema MCN del delta del Yangtsé.',
    brandColor: '#E54B6E',
    accent: '#C73E5C',
  },
  {
    name: 'Shenzhen',
    cn: '深圳',
    mono: 'SZ',
    sub: 'Tencent y el cinturón tech. WeChat, hardware, labs de IA y la innovación retail que un año después viaja a Shanghái.',
    brandColor: '#7C5DFA',
    accent: '#5E45D6',
  },
  {
    name: 'Pekín',
    cn: '北京',
    mono: 'BJ',
    sub: 'Lujo, retail tradicional y sedes de marca. Útil cuando la categoría tira a premium o roza lo institucional.',
    brandColor: '#0EA46C',
    accent: '#088955',
  },
];

const takeaways = [
  {
    icon: 'eye',
    title: 'Dossier de briefing',
    desc: 'Lectura previa, lista de contactos y contexto de categoría. Se envía catorce días antes de su vuelo.',
  },
  {
    icon: 'document',
    title: 'Transcripciones en vivo',
    desc: 'Notas de trabajo de cada sesión con expertos, traducidas y enviadas la misma tarde.',
  },
  {
    icon: 'avatar',
    title: 'Directorio de contactos',
    desc: 'Operadores, responsables de plataforma y creadores que conoció, con las presentaciones mantenidas calientes.',
  },
  {
    icon: 'phone',
    title: 'Llamada de seguimiento',
    desc: 'Una hora de Q&A con el operador que dirigió el viaje, cuatro semanas después de aterrizar.',
  },
];

const faqs = [
  { cat: 'Programa', q: '¿Hasta qué punto se personaliza el programa?', a: 'Cada expedición se construye sobre el brief que nos envía. Llamada inicial, agenda preliminar en cinco días hábiles y dos rondas de iteración antes de cerrarla. Hay plantillas de track fijo para equipos que quieran un arranque rápido, pero la mayoría de los clientes hace un programa totalmente a medida.' },
  { cat: 'Programa', q: '¿Pueden centrarse en nuestro sector concreto?', a: 'Sí. Hemos llevado expediciones para belleza, moda, alimentación y bebidas, automoción, lujo, hogar, infantil, mascotas y salud. Las visitas, los operadores y los casos se eligen para su categoría, no se sacan de un estante genérico.' },
  { cat: 'Programa', q: '¿Cómo es un día tipo?', a: 'De nueve a siete. Una sesión con experto y una visita a empresa por la mañana. Recorrido por tienda o segunda visita por la tarde. El día cuatro o cinco hay taller. Las noches están libres salvo que reserve una cena de networking.' },
  { cat: 'Programa', q: '¿Podemos traer a nuestra agencia o socios?', a: 'Sí. Cerca de un tercio de los grupos viene con su agencia principal, su socio tecnológico o su distribuidor. Ayuda a alinear a todo el equipo de trabajo en lo que es realista y lo que no, que es la mitad del valor del viaje.' },
  { cat: 'Logística', q: '¿Cuánto duran los programas?', a: 'De tres a cinco días es lo habitual. Hacemos programas focalizados de dos días sobre un solo tema, como Douyin commerce, o extendemos a siete u ocho días para briefs multi-track que abarcan dos ciudades.' },
  { cat: 'Logística', q: '¿Cuál es la mejor época para venir?', a: 'De marzo a mayo y de septiembre a noviembre. Evite el Año Nuevo Chino a finales de enero o en febrero, la Golden Week del 1 al 7 de octubre y los días alrededor del 618 en junio y del Double 11 en noviembre. Las operaciones se estiran durante los festivales y el acceso baja.' },
  { cat: 'Logística', q: '¿Qué ciudades cubren?', a: 'La mayoría de los programas se ancla en Shanghái con días opcionales en Hangzhou para el ecosistema Alibaba o en Shenzhen para tecnología e IA. Pekín para lujo y retail tradicional. Visitas a ciudades de nivel 3 con dos días extra de planificación.' },
  { cat: 'Logística', q: '¿Necesito hablar mandarín?', a: 'No. La interpretación profesional acompaña todas las sesiones con expertos, las visitas a empresas y los recorridos por tienda. Los intérpretes vienen informados sobre su categoría para que el vocabulario técnico aterrice limpio.' },
  { cat: 'Logística', q: '¿Cuál es el tamaño del grupo?', a: 'De seis a diez personas. Ocho es el punto dulce. Los grupos más pequeños consiguen mejor acceso en las visitas y más espacio en las sesiones con expertos. No hacemos programas para grupos más grandes.' },
  { cat: 'Coste', q: '¿Cuánto cuesta?', a: 'El precio por persona escala con el tamaño del grupo, la profundidad y el número de ciudades. Los programas de media semana en una sola ciudad suelen arrancar en cifras altas de cuatro dígitos por persona en euros. Los multiciudad con acceso a IA suben más. Cotizamos contra el brief real, no contra una lista de precios.' },
  { cat: 'Coste', q: '¿Qué está incluido?', a: 'El programa completo: visitas a empresas, sesiones con expertos, recorridos por tienda, talleres, interpretación profesional, todo el transporte terrestre dentro de China entre puntos, materiales de trabajo y el informe posterior al viaje. Los vuelos y los hoteles no entran por defecto.' },
  { cat: 'Coste', q: '¿Pueden encargarse de vuelos y hoteles?', a: 'Sí, como añadido. Trabajamos con hoteles aliados en Shanghái, Hangzhou y Shenzhen, sobre todo en el Bund o en el corredor de Jing\'an para Shanghái. Algunos clientes prefieren a su equipo corporativo de viajes. Ambas opciones funcionan.' },
  { cat: 'Coste', q: '¿Cuáles son las condiciones de pago?', a: 'Cincuenta por ciento a la firma para confirmar fechas y reservar las visitas. El saldo, treinta días antes de la salida. Transferencia en USD o EUR para clientes extranjeros, RMB para los nacionales.' },
  { cat: 'Acceso', q: '¿Qué empresas y plataformas traen?', a: 'Responsables de cuenta y líderes de categoría de Douyin, Xiaohongshu, Tmall, JD, WeChat y Pinduoduo, según el brief. Operadores de marca de su categoría. MCN. Empresas de IA y retail tech. La lista cambia con la agenda.' },
  { cat: 'Acceso', q: '¿Podemos visitar empresas concretas que tengamos en mente?', a: 'Dígalo en la llamada inicial. Donde tenemos relación de trabajo, organizamos la visita. Donde no, lo decimos. Algunas empresas no abren sus puertas por confidencialidad. Le diremos cuáles.' },
  { cat: 'Acceso', q: '¿Qué nivel de acceso real tenemos?', a: 'Paneles internos, sistemas de back office y datos de campaña en vivo allí donde la empresa lo permita, que suele ser la mayoría de las veces porque ya operamos con ellos. Va a ver cifras que no aparecen en ningún dossier público.' },
  { cat: 'Acceso', q: '¿Podemos grabar sesiones o sacar fotos?', a: 'Fotos en espacios públicos y en casi todas las visitas, sí. La grabación se decide sesión por sesión. Algunos expertos hablan más abiertamente fuera de cámara y lo respetamos. El informe posterior al viaje recoge lo que se dijo.' },
  { cat: 'Audiencia', q: '¿Quién suele venir?', a: 'Directivos C-level, directores de eCommerce y marketing, líderes de transformación digital, brand managers, socios de agencia. La mayoría de los grupos mezcla a quienes deciden con quienes ejecutan. Esa mezcla es parte de lo que hace que el taller funcione.' },
  { cat: 'Después', q: '¿Qué pasa después de la expedición?', a: 'Un informe escrito en treinta días con lo que vimos y lo que recomendamos para su categoría. Dossier, directorio de contactos de toda la gente que conoció y una llamada de una hora con el operador principal cuatro semanas después de aterrizar.' },
  { cat: 'Después', q: '¿Podemos contratar a TheChinaPath para el seguimiento?', a: 'Sí, pero no es lo habitual. Cerca de un tercio de los clientes trabaja con nosotros después en entrada de mercado, operativa de tienda o asesoramiento. La expedición se vende por sí misma, sin pitch incorporado.' },
];

const faqCategories = ['Todas', 'Programa', 'Logística', 'Coste', 'Acceso', 'Audiencia', 'Después'];

const icons: Record<string, string> = {
  talk: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-12 7l-5 1 1-4a8 8 0 1 1 16-4z"/><line x1="8" y1="11" x2="16" y2="11"/><line x1="8" y1="14" x2="13" y2="14"/></svg>`,
  building: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="1"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="9" x2="9" y2="21"/><line x1="15" y1="9" x2="15" y2="21"/></svg>`,
  store: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9 5 4h14l1 5"/><path d="M5 9v11h14V9"/><path d="M9 20v-6h6v6"/><path d="M4 9h16"/></svg>`,
  tools: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a5 5 0 1 1-7.1 7.1L3 18v3h3l4.6-4.6a5 5 0 0 1 7.1-7.1z"/><line x1="17" y1="7" x2="21" y2="3"/></svg>`,
  compass: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polygon points="16 8 13 13 8 16 11 11 16 8"/></svg>`,
  rocket: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4c4 0 6 2 6 6-4 0-6 2-6 6-4 0-6-2-6-6 4 0 6-2 6-6z"/><circle cx="14" cy="10" r="1.5"/><path d="M8 16l-3 3M11 19l-2 2M5 13l-2 2"/></svg>`,
  trend: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="15 7 21 7 21 13"/></svg>`,
  eye: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>`,
  document: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="1.5"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/></svg>`,
  avatar: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="4"/><path d="M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>`,
  phone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.1 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.8.6 2.8.7A2 2 0 0 1 22 16.9z"/></svg>`,
  spark: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l3 3M15 15l3 3M18 6l-3 3M9 15l-3 3"/></svg>`,
};
---

<Layout
  title="Inmersión China | Programas dirigidos por operadores sobre eCommerce, IA, retail y contenido | TheChinaPath"
  description="Programas inmersivos de tres a cinco días en China. Operadores al frente. eCommerce, IA, retail, contenido y distribución. Diseñados a medida sobre su brief. Shanghái, Hangzhou, Shenzhen."
>
  <div class="cbs-progress" aria-hidden="true"><div class="cbs-progress__bar"></div></div>
  <article class="cbs">

    {/* ---------- HERO ---------- */}
    <section class="cbs-hero" data-hero>
      <div class="cbs-hero__bg" aria-hidden="true" data-parallax>
        <img src="/Images/learn-china/hero-livestream-expedition.png" alt="Pequeño grupo de directivos extranjeros observando un estudio chino de livestream eCommerce en Shanghái durante una inmersión" />
      </div>
      <div class="cbs-hero__overlay" aria-hidden="true"></div>
      <div class="cbs-hero__grain" aria-hidden="true"></div>

      <div class="container cbs-hero__inner">
        <nav class="cbs-hero__crumbs" aria-label="Breadcrumb">
          <a href="/es">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href="/es/#services">Conocer China</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark cbs-reveal">Inmersión China</span>
        <h1 class="cbs-hero__title cbs-reveal" style="--reveal-delay: 80ms;">
          <span class="cbs-hero__title-row">China va más rápido que</span>
          <span class="cbs-hero__title-row cbs-hero__title-row--accent">el dossier en su pantalla.</span>
          <span class="cbs-hero__title-row">Aterrice aquí y véalo</span>
          <span class="cbs-hero__title-row cbs-hero__title-row--highlight">funcionar por usted mismo.</span>
        </h1>
        <p class="cbs-hero__lead cbs-reveal" style="--reveal-delay: 200ms;">
          Programas dirigidos por operadores para directivos que quieren una visión de
          trabajo del mercado chino. eCommerce, IA, retail, contenido, distribución.
          De tres a cinco días dentro del sistema que lo hace funcionar.
        </p>
        <div class="cbs-hero__actions cbs-reveal" style="--reveal-delay: 280ms;">
          <a href="/es/contacto" class="btn btn--primary cbs-magnetic">Planificar una inmersión</a>
          <a href="#tracks" class="btn btn--ghost-light cbs-magnetic">Ver tracks de ejemplo</a>
        </div>

        <div class="cbs-hero__meta cbs-reveal" style="--reveal-delay: 360ms;">
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num" data-counter="20" data-suffix="+">0</span>
            <span class="cbs-hero__meta-label">años guiando equipos en China</span>
          </div>
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num" data-counter="60" data-suffix="+">0</span>
            <span class="cbs-hero__meta-label">operadores en nuestra red</span>
          </div>
          <div class="cbs-hero__meta-item">
            <span class="cbs-hero__meta-num cbs-hero__meta-num--text">Varias</span>
            <span class="cbs-hero__meta-label">ciudades por toda China</span>
          </div>
        </div>
      </div>

      <a href="#tracks" class="cbs-hero__scroll" aria-label="Bajar a la siguiente sección">
        <span class="cbs-hero__scroll-line"></span>
        <span class="cbs-hero__scroll-text">Scroll</span>
      </a>
    </section>

    {/* ---------- VALUE PROPOSITION ---------- */}
    <section class="section section--alt">
      <div class="container">
        <div class="cbs-value">
          <div class="cbs-value__copy">
            <span class="eyebrow">Lo que hacemos</span>
            <h2>Diseñamos el programa, lo dirigimos y seguimos con usted después.</h2>
            <p>
              Veinte años operando flagships, campañas de contenido y acuerdos con
              plataformas en China. El equipo que opera el mercado diseña el viaje y le
              acompaña dentro. No hay un tour operador subcontratado por medio.
            </p>
          </div>

          <ul class="cbs-promise">
            <li>
              <span class="eyebrow">Lo que puede esperar</span>
            </li>
            {promises.map((p) => (
              <li class="cbs-promise__item">
                <span class="cbs-promise__check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8"/></svg>
                </span>
                <div>
                  <h4>{p.title}</h4>
                  <p>{p.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* ---------- FORMATS (bento) ---------- */}
    <section class="section cbs-svc-section">
      <div class="container">
        <header class="section-header section-header--split cbs-reveal">
          <div>
            <span class="eyebrow">Cómo funciona</span>
            <h2>Cuatro formatos, un solo programa</h2>
