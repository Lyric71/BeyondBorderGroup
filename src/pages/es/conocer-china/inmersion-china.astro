      margin: 0;
    }
    @media (max-width: 1024px) {
      .cbs-value { grid-template-columns: 1fr; gap: var(--space-6); }
    }

    /* ---------- FORMATS BENTO ---------- */
    .cbs-svc-section .section-header--split { align-items: end; gap: var(--space-6); margin-bottom: var(--space-6); }
    .cbs-svc-lead {
      max-width: 44ch;
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-svc-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
    .cbs-svc-card {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 20px;
      padding: var(--space-6);
      overflow: hidden;
      isolation: isolate;
      display: flex; flex-direction: column;
      gap: var(--space-4);
      min-height: 320px;
      transition:
        transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .cbs-svc-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 4px;
      background: linear-gradient(90deg, var(--svc-color, #C8102E) 0%, var(--svc-color, #C8102E) 50%, transparent 100%);
      transform: scaleX(0.3);
      transform-origin: left center;
      transition: transform 480ms cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1;
    }
    .cbs-svc-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(140% 90% at 100% 0%,
        color-mix(in srgb, var(--svc-color, #C8102E) 14%, transparent) 0%,
        transparent 55%);
      opacity: 0;
      transition: opacity 360ms ease;
      z-index: -1;
      pointer-events: none;
    }
    .cbs-svc-card:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--svc-color, #C8102E) 55%, var(--bbg-border));
      box-shadow: 0 22px 50px -26px color-mix(in srgb, var(--svc-color, #C8102E) 50%, transparent),
                  0 6px 14px -8px rgba(0, 0, 0, 0.08);
    }
    .cbs-svc-card:hover::before { transform: scaleX(1); }
    .cbs-svc-card:hover::after { opacity: 1; }
    .cbs-svc-card:hover .cbs-svc-card__icon {
      transform: scale(1.06) rotate(-4deg);
      background: var(--svc-color, var(--bbg-blue));
      color: var(--bbg-white);
      box-shadow: 0 12px 24px -14px color-mix(in srgb, var(--svc-color, #C8102E) 70%, transparent),
                  inset 0 0 0 1px color-mix(in srgb, var(--svc-color, #C8102E) 30%, transparent);
    }
    .cbs-svc-card:hover .cbs-svc-card__arrow { transform: translateX(4px); color: var(--svc-color, var(--bbg-blue)); }

    .cbs-svc-card__head {
      display: flex; align-items: center; justify-content: space-between;
      gap: var(--space-3);
    }
    .cbs-svc-card__icon {
      display: inline-flex;
      width: 56px; height: 56px;
      align-items: center; justify-content: center;
      border-radius: 16px;
      background: var(--svc-soft, var(--bbg-blue-light));
      color: var(--svc-color, var(--bbg-blue));
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--svc-color, #C8102E) 18%, transparent);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
                  background 320ms ease, color 320ms ease, box-shadow 320ms ease;
      flex-shrink: 0;
    }
    .cbs-svc-card__icon svg { width: 28px; height: 28px; }
    .cbs-svc-card__short {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--svc-color, var(--bbg-blue));
      text-align: right;
      line-height: 1.4;
    }
    .cbs-svc-card__title {
      font-size: 1.5rem;
      line-height: 1.18;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-ink);
    }
    .cbs-svc-card__desc {
      font-size: 0.975rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-svc-card__points {
      list-style: none;
      padding: var(--space-4) 0 0;
      margin: 0;
      border-top: 1px solid var(--bbg-border);
      display: flex; flex-direction: column;
      gap: 0.55rem;
      margin-top: auto;
    }
    .cbs-svc-card__points li {
      display: grid;
      grid-template-columns: 14px 1fr;
      gap: 0.6rem;
      align-items: center;
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--bbg-text);
    }
    .cbs-svc-card__bullet {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--svc-color, var(--bbg-blue));
      box-shadow: 0 0 0 3px var(--svc-soft, var(--bbg-blue-light));
      margin-left: 4px;
    }
    .cbs-svc-card__arrow {
      position: absolute;
      bottom: var(--space-6);
      right: var(--space-6);
      color: var(--bbg-text-muted);
      transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1), color 200ms ease;
      pointer-events: none;
    }
    .cbs-svc-card__arrow svg { width: 22px; height: 22px; }
    @media (max-width: 720px) {
      .cbs-svc-grid { grid-template-columns: 1fr; }
      .cbs-svc-card { min-height: 0; }
      .cbs-svc-section .section-header--split { flex-direction: column; align-items: flex-start; }
    }

    /* ---------- TRACKS / MODELS SECTION BG ---------- */
    .cbs-models-section { position: relative; isolation: isolate; overflow: hidden; }
    .cbs-models-section__bg {
      position: absolute;
      top: 0; right: -8%;
      width: 55%; height: 100%;
      z-index: -1;
      opacity: 0.18;
      mask-image: radial-gradient(ellipse at right center, black 0%, transparent 65%);
      -webkit-mask-image: radial-gradient(ellipse at right center, black 0%, transparent 65%);
      pointer-events: none;
    }
    .cbs-models-section__bg img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center;
      filter: saturate(0.6);
    }
    @media (max-width: 900px) { .cbs-models-section__bg { display: none; } }

    /* ---------- TABS ---------- */
    .cbs-tabs {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 16px 48px -28px rgba(8, 18, 28, 0.18);
    }
    .cbs-tabs__nav {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      background: linear-gradient(180deg, var(--bbg-surface) 0%, var(--bbg-white) 100%);
      border-bottom: 1px solid var(--bbg-border);
    }
    .cbs-tabs__tab {
      position: relative;
      background: transparent;
      border: none;
      padding: var(--space-5) var(--space-4);
      text-align: left;
      cursor: pointer;
      display: flex; flex-direction: column;
      gap: 0.35rem;
      color: var(--bbg-text-muted);
      transition: color 240ms ease, background 240ms ease;
      border-right: 1px solid var(--bbg-border);
    }
    .cbs-tabs__tab:last-child { border-right: none; }
    .cbs-tabs__tab:hover { color: var(--bbg-ink); background: rgba(200, 16, 46, 0.04); }
    .cbs-tabs__tab.is-active { color: var(--bbg-ink); background: var(--bbg-white); }
    .cbs-tabs__tab-label {
      font-size: 1.0625rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      line-height: 1.2;
    }
    .cbs-tabs__tab-tag {
      font-size: 0.78rem;
      color: var(--bbg-text-muted);
      line-height: 1.35;
    }
    .cbs-tabs__tab.is-active .cbs-tabs__tab-tag { color: var(--bbg-blue); }
    .cbs-tabs__tab-pop {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .cbs-tabs__indicator {
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 25%;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #E84A60 100%);
      border-radius: 2px 2px 0 0;
      transform: translateX(0);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }
    .cbs-tabs__panels { background: var(--bbg-white); }
    .cbs-tabs__panel {
      padding: clamp(var(--space-5), 4vw + 1rem, var(--space-7));
      animation: cbs-tab-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes cbs-tab-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .cbs-tabs__panel[hidden] { display: none; }
    .cbs-tabs__panel-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .cbs-tabs__lead { display: flex; flex-direction: column; gap: var(--space-4); }
    .cbs-tabs__pillset { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .cbs-tabs__pill {
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.35em 0.85em;
      border-radius: 999px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      letter-spacing: 0.01em;
    }
    .cbs-tabs__title {
      font-size: clamp(1.625rem, 1.8vw + 1rem, 2.25rem);
      line-height: 1.1;
      margin: 0;
      letter-spacing: -0.015em;
    }
    .cbs-tabs__desc {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .cbs-tabs__when {
      padding: var(--space-4);
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--bbg-blue);
    }
    .cbs-tabs__when-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.35rem;
    }
    .cbs-tabs__when p { margin: 0; font-size: 0.95rem; line-height: 1.55; color: var(--bbg-text); }
    .cbs-tabs__body { display: flex; flex-direction: column; gap: var(--space-4); }
    .cbs-tabs__list-wrap {
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .cbs-tabs__list-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .cbs-tabs__list {
      list-style: none;
      padding: 0; margin: 0;
      display: flex; flex-direction: column;
      gap: var(--space-3);
    }
    .cbs-tabs__list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--bbg-text);
    }
    .cbs-tabs__check {
      width: 22px; height: 22px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .cbs-tabs__check svg { width: 12px; height: 12px; }
    .cbs-tabs__pricing {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      padding: var(--space-4);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.12) 100%);
      border-radius: var(--radius-md);
      border: 1px solid rgba(200, 16, 46, 0.2);
    }
    .cbs-tabs__pricing-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue-dark);
      flex-shrink: 0;
    }
    .cbs-tabs__pricing-value {
      font-size: 1rem;
      font-weight: 600;
      color: var(--bbg-ink);
      line-height: 1.4;
    }
    @media (max-width: 1024px) {
      .cbs-tabs__nav { grid-template-columns: repeat(2, 1fr); }
      .cbs-tabs__tab { border-bottom: 1px solid var(--bbg-border); }
      .cbs-tabs__tab:nth-child(2) { border-right: none; }
      .cbs-tabs__indicator { display: none; }
      .cbs-tabs__panel-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .cbs-tabs__nav { grid-template-columns: 1fr; }
      .cbs-tabs__tab { border-right: none; }
    }

    /* ---------- MATRIX ---------- */
    .cbs-matrix {
      margin-top: var(--space-8);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: clamp(var(--space-5), 3vw + 1rem, var(--space-7));
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    }
    .cbs-matrix__intro { text-align: center; margin-bottom: var(--space-6); }
    .cbs-matrix__intro h3 {
      font-size: clamp(1.375rem, 1.2vw + 1rem, 1.75rem);
      margin: var(--space-2) 0 var(--space-3);
      letter-spacing: -0.01em;
    }
    .cbs-matrix__intro p {
      color: var(--bbg-text);
      max-width: 60ch;
      margin: 0 auto;
      line-height: 1.6;
      font-size: 1rem;
    }
    .cbs-matrix__grid {
      display: grid;
      grid-template-columns: minmax(180px, 0.9fr) 1fr 1fr;
      gap: 1px;
      background: var(--bbg-border);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .cbs-matrix__corner,
    .cbs-matrix__head,
    .cbs-matrix__row-head,
    .cbs-matrix__cell {
      background: var(--bbg-white);
      padding: var(--space-4);
    }
    .cbs-matrix__corner { background: var(--bbg-surface); }
    .cbs-matrix__head {
      background: var(--bbg-surface);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      text-align: center;
      display: flex; align-items: center; justify-content: center;
    }
    .cbs-matrix__row-head {
      background: var(--bbg-surface);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      display: flex; align-items: center;
    }
    .cbs-matrix__cell {
      border: none;
      text-align: left;
      font-family: inherit;
      cursor: pointer;
      display: flex; flex-direction: column;
      gap: 0.35rem;
      transition: background var(--dur) var(--ease);
    }
    .cbs-matrix__cell:hover { background: var(--bbg-blue-light); }
    .cbs-matrix__cell:focus-visible {
      outline: 3px solid var(--bbg-blue);
      outline-offset: -3px;
    }
    .cbs-matrix__cell-label {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .cbs-matrix__cell-sub {
      font-size: 0.9rem;
      color: var(--bbg-text);
      line-height: 1.45;
    }
    .cbs-matrix__note {
      margin: var(--space-5) auto 0;
      max-width: 68ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 0.975rem;
    }
    .cbs-matrix__grid.is-hover-row .cbs-matrix__cell { opacity: 0.4; }
    .cbs-matrix__grid.is-hover-row .cbs-matrix__cell.is-row-active,
    .cbs-matrix__grid.is-hover-row .cbs-matrix__cell.is-col-active { opacity: 1; background: var(--bbg-blue-light); }
    .cbs-matrix__grid.is-hover-row .cbs-matrix__row-head,
    .cbs-matrix__grid.is-hover-row .cbs-matrix__head { opacity: 0.4; }
    .cbs-matrix__grid.is-hover-row .cbs-matrix__row-head.is-active,
    .cbs-matrix__grid.is-hover-row .cbs-matrix__head.is-active {
      opacity: 1;
      background: var(--bbg-blue);
      color: var(--bbg-white);
    }
    @media (max-width: 720px) {
      .cbs-matrix__grid { grid-template-columns: 1fr 1fr; }
      .cbs-matrix__corner { display: none; }
      .cbs-matrix__head { font-size: 0.75rem; padding: var(--space-3); }
      .cbs-matrix__row-head {
        grid-column: 1 / -1;
        background: var(--bbg-blue-light);
        color: var(--bbg-blue-dark);
        justify-content: center;
        padding: var(--space-3);
      }
    }

    /* ---------- CASES CTA ---------- */
    .cbs-cases-cta { display: flex; justify-content: center; }

    /* ---------- CITIES (platform-style cards) ---------- */
    .cbs-platforms {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
    .cbs-platform {
      position: relative;
      display: flex; flex-direction: column;
      gap: var(--space-4);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      color: var(--bbg-ink);
      overflow: hidden;
      isolation: isolate;
      transition: transform var(--dur) var(--ease),
                  border-color var(--dur) var(--ease),
                  box-shadow var(--dur) var(--ease);
    }
    .cbs-platform::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: linear-gradient(90deg,
        var(--platform-color, var(--bbg-blue)) 0%,
        var(--platform-accent, var(--bbg-blue-dark)) 100%);
      transform: scaleX(0.4);
      transform-origin: left center;
      transition: transform var(--dur) var(--ease);
    }
    .cbs-platform::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 100% 0%,
        color-mix(in srgb, var(--platform-color, #C8102E) 12%, transparent) 0%,
        transparent 55%);
      opacity: 0;
      transition: opacity var(--dur) var(--ease);
      z-index: -1;
      pointer-events: none;
    }
    .cbs-platform:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--platform-color, #C8102E) 60%, var(--bbg-border));
      box-shadow: 0 18px 40px -22px color-mix(in srgb, var(--platform-color, #C8102E) 55%, transparent),
                  0 4px 12px -6px rgba(0, 0, 0, 0.08);
      color: var(--bbg-ink);
    }
    .cbs-platform:hover::before { transform: scaleX(1); }
    .cbs-platform:hover::after { opacity: 1; }
    .cbs-platform__head {
      display: flex; align-items: center; justify-content: space-between;
      gap: var(--space-3);
    }
    .cbs-platform__logo {
      width: 76px; height: 76px;
      display: inline-flex; align-items: center; justify-content: center;
      border-radius: var(--radius-md);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      padding: 14px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
    }
    .cbs-platform:hover .cbs-platform__logo {
      border-color: color-mix(in srgb, var(--platform-color, #C8102E) 35%, var(--bbg-border));
      transform: scale(1.04);
    }
    .cbs-city__mark {
      background: linear-gradient(140deg,
        color-mix(in srgb, var(--platform-color, #C8102E) 10%, var(--bbg-white)) 0%,
        var(--bbg-white) 100%);
    }
    .cbs-city__mono {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--platform-color, var(--bbg-blue));
      line-height: 1;
    }
    .cbs-platform__cn {
      font-size: 1.5rem;
      font-weight: 700;
      color: color-mix(in srgb, var(--platform-color, #C8102E) 75%, var(--bbg-ink));
      line-height: 1;
      letter-spacing: 0.02em;
      opacity: 0.85;
    }
    .cbs-platform__body { display: flex; flex-direction: column; gap: var(--space-2); flex-grow: 1; }
    .cbs-platform__title {
      font-size: 1.375rem;
      line-height: 1.2;
      margin: 0;
      color: var(--bbg-ink);
      letter-spacing: -0.01em;
      font-weight: 700;
    }
    .cbs-platform__sub {
      font-size: 0.9375rem;
      line-height: 1.55;
      color: var(--bbg-text);
      margin: 0;
    }
    @media (max-width: 1024px) { .cbs-platforms { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .cbs-platforms { grid-template-columns: 1fr; } }

    /* ---------- JOURNEY ---------- */
    .cbs-journey-section { position: relative; isolation: isolate; overflow: hidden; }
    .cbs-journey-section__bg {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: -2;
      opacity: 0.10;
      pointer-events: none;
    }
    .cbs-journey-section__bg::after {
      content: "";
      position: absolute; inset: 0;
      background: linear-gradient(180deg, var(--bbg-white) 0%, rgba(255, 255, 255, 0.4) 40%, rgba(255, 255, 255, 0.7) 100%);
    }
