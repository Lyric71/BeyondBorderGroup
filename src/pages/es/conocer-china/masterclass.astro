---
import Layout from '../../../layouts/Layout.astro';

const heroBadges = [
  'HEC MBA', 'ESCP MBA', 'EU Chamber', 'AmCham', 'Business France', 'SJTU Executive MBA',
];

const heroStats = [
  { value: 15, suffix: '+', label: 'años formando a directivos' },
  { value: 6, suffix: '', label: 'instituciones aliadas' },
  { value: 3, suffix: '', label: 'idiomas de trabajo' },
];

const audience = [
  'Propietarios y country managers que están mirando China',
  'Equipos de marketing y digital que necesitan entender por qué China es distinta',
  'Equipos de eCommerce que preparan su salida en Tmall, JD, Douyin o RED',
  'Emprendedores y startups midiendo el tamaño de la oportunidad',
  'Responsables internacionales de marketing que quieren ampliar su caja de herramientas',
];

const takeaways = [
  {
    h: 'Formadores que operan',
    p: 'Formadores que hoy gestionan tiendas, presupuestos de medios y campañas. No exconsultores leyendo láminas del año pasado. Aprende usted de quien sigue recibiendo notificaciones de WeChat a las once de la noche.',
    feature: true,
  },
  {
    h: 'Casos reales',
    p: 'Marcas que crecieron en China, marcas que quemaron dinero. Ambas importan, y vienen con los números encima de la mesa.',
  },
  {
    h: 'Cifras al día',
    p: 'Plataformas, comportamiento del consumidor, coste de los medios. Se refrescan antes de cada sesión porque el trimestre anterior ya queda viejo.',
  },
  {
    h: 'Su brief, no el nuestro',
    p: 'Una sesión de trabajo atada a su categoría, su precio y su equipo. No un dossier que cualquiera encuentra en internet.',
  },
  {
    h: 'Herramientas listas para usar',
    p: 'Marcos, listas de control y plantillas que su equipo puede poner a trabajar el lunes por la mañana.',
  },
];

const moduleIcon: Record<string, string> = {
  compass: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>',
  grid: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>',
  target: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>',
};

const modules = [
  {
    icon: 'compass',
    tab: 'Ecosistema',
    tabSub: 'Mapa del mercado',
    image: '/Images/learn-china/masterclass/ecosystem.png',
    imageAlt: 'Compradora china de eCommerce con un móvil que muestra Tmall y Douyin, con el horizonte de Shanghái al fondo',
    title: 'El ecosistema digital y de eCommerce de China',
    lead: 'El mapa del mercado. Quién usa qué, cómo ganan dinero las plataformas y dónde encaja su categoría.',
    topics: [
      {
        h: 'Panorama del mercado',
        items: [
          'Cifras actuales: usuarios de internet, penetración del eCommerce, reparto por categoría',
          'Comportamiento en móvil y en super-apps',
          'Perfiles de consumidor chino por nivel de ciudad, edad e ingresos',
          'Diferencias regionales y por qué un único plan nacional rara vez funciona',
        ],
      },
      {
        h: 'Comportamiento del consumidor',
        items: [
          'Cómo descubre, compara y compra de verdad el consumidor chino',
          'El recorrido de compra real entre búsqueda, social y eCommerce',
          'Qué pesa al decidir: precio, contenido, confianza, recomendación',
          'El peso del móvil y de las redes en cada categoría',
        ],
      },
      {
        h: 'Tendencias actuales',
        items: [
          'Livestreaming, vídeo corto y social commerce',
          'IA, personalización y el auge del GEO en las búsquedas chinas',
          'Lo que crece, lo que toca techo y lo que ya pasó',
        ],
      },
    ],
  },
  {
    icon: 'grid',
    tab: 'Plataformas',
    tabSub: 'Cómo funciona cada una',
    image: '/Images/learn-china/masterclass/platforms.png',
    imageAlt: 'Varios móviles vistos desde arriba con las interfaces de Tmall, JD, Douyin, WeChat y Xiaohongshu',
    title: 'Plataformas',
    lead: 'Las reglas de cada plataforma, el tipo de marca que premia y lo que cuesta de verdad operar en ella.',
    topics: [
      {
        h: 'WeChat',
        items: [
          'Cuentas Oficiales: alta, formatos de contenido y lo que funciona',
          'Mini Programas para comercio, servicio y CRM',
          'WeChat Pay y los fundamentos de WeCom',
          'Estrategia de contenido y amplificación pagada',
        ],
      },
      {
        h: 'Plataformas de eCommerce',
        items: [
          'Tmall y Tmall Global: modelo, comisiones y operativa',
          'JD y JD Worldwide: dónde gana y dónde no',
          'Taobao y la capa C2C que vive bajo Tmall',
          'Douyin eCommerce y el social commerce de bucle cerrado',
          'Precios, promociones y calendario comercial',
        ],
      },
      {
        h: 'Plataformas sociales',
        items: [
          'Weibo: sigue valiendo para PR y seeding',
          'Douyin: formatos, algoritmo y mecánica comercial',
          'Xiaohongshu (RED): descubrimiento por categoría y marketing con KOC',
          'Zhihu: B2B y categorías de alta consideración',
          'Bilibili: generación Z, vídeo largo y fandom',
        ],
      },
    ],
  },
  {
    icon: 'target',
    tab: 'Buenas prácticas',
    tabSub: 'Lo que hacen las buenas marcas',
    image: '/Images/learn-china/masterclass/best-practice.png',
    imageAlt: 'Plató chino de livestream eCommerce con un presentador mostrando un producto a cámara, gráfica de ventas y contador de espectadores sobreimpresos',
    title: 'Buenas prácticas y casos',
    lead: 'Lo que hacen las buenas marcas. Lo que erraron los lanzamientos fallidos. Un plan que se lleva a su oficina.',
    topics: [
      {
        h: 'Marketing en China',
        items: [
          'Programas de KOL e influencers que mueven la aguja',
          'Estrategia de contenido multiplataforma',
          'El calendario promocional chino: 618, Double 11, Año Nuevo Chino, 38',
          'Reparto de presupuesto y benchmarks de ROI',
        ],
      },
      {
        h: 'Casos',
        items: [
          'Marcas que crecieron y por qué',
          'Errores caros que conviene evitar',
          'Adaptaciones locales que cambiaron el desenlace',
          'Campañas que se volvieron virales, desmontadas paso a paso',
        ],
      },
      {
        h: 'Cómo ejecutar',
        items: [
          'Cómo estructurar un equipo en China, interno o con agencia',
          'Elegir los socios locales y los distribuidores correctos',
          'Fundamentos de atención al cliente y logística',
          'Lo esencial en materia regulatoria y de cumplimiento',
        ],
      },
      {
        h: 'Su plan de acción',
        items: [
          'Taller de estrategia de entrada atado a su brief',
          'Planificación y fases del presupuesto',
          'Una hoja de ruta a medida con la que sale de la sala',
        ],
      },
    ],
  },
];

const formatIcon: Record<string, string> = {
  layers: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
  pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
  clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  package: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>',
  globe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
  life: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="14.83" y1="9.17" x2="18.36" y2="5.64"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/></svg>',
};

const format = [
  { icon: 'layers', label: 'Contenido', body: 'Personalizado para su sector. Belleza, alimentación y bebidas, turismo, automoción, lujo, servicios. Reescribimos ejemplos y casos para que encajen en la categoría en la que usted vende.' },
  { icon: 'pin', label: 'Lugar', body: 'Nuestros consultores se desplazan. Shanghái, Hong Kong, París, su oficina, su offsite. Presencial o remoto.' },
  { icon: 'clock', label: 'Duración', body: 'Jornada completa (8 horas), media jornada (4 horas) o un formato repartido en varias sesiones a lo largo de varias semanas.' },
  { icon: 'package', label: 'Entregables', body: 'Material completo del curso, el dossier de la sesión y acceso a los formadores para resolver dudas después del taller.' },
  { icon: 'globe', label: 'Idiomas', body: 'Inglés, francés y mandarín. Las sesiones bilingües son lo habitual, no un coste añadido.' },
  { icon: 'life', label: 'Posformación', body: '30 días de seguimiento para la formación interna: dudas por correo, dos llamadas por vídeo y acceso continuo a nuestras actualizaciones de mercado.' },
];

const faqs = [
  { cat: 'Programa', q: '¿Personalizan el programa?', a: 'Sí. Partimos de sus objetivos, su sector y su nivel actual de exposición a China, y construimos el programa alrededor de eso. Una llamada de briefing breve antes de la sesión basta para adaptar los módulos, los ejemplos y los casos.' },
  { cat: 'Compromiso', q: '¿Podemos trabajar con ustedes como consultores y no solo como formadores?', a: 'Sí. También hacemos consultoría estratégica y operativa: auditorías digitales, estrategia de entrada en mercado, selección de distribuidores, lanzamiento eCommerce. La formación suele ser el punto de partida de un trabajo más largo.' },
  { cat: 'Programa', q: '¿Podemos elegir módulos concretos?', a: 'Sí. El programa es modular. Muchos clientes hacen sesiones de media jornada centradas solo en WeChat, en plataformas de eCommerce, en social commerce o en marketing con KOL e influencers.' },
  { cat: 'Programa', q: '¿Pueden profundizar en un tema específico?', a: 'Sí. Podemos dedicar una sesión completa a estrategia de Tmall Global, a livestream commerce, al bucle cerrado de Douyin, a Xiaohongshu para belleza o a cualquier otro tema en el que su equipo necesite entrar a fondo.' },
  { cat: 'Compromiso', q: '¿Hacen formación corporativa interna?', a: 'Sí. Vamos a sus oficinas, adaptamos el contenido a su contexto interno y trabajamos con todo el equipo. El formato interno saca las mejores conversaciones porque todo el mundo está en el mismo negocio.' },
  { cat: 'Formato', q: '¿En qué idiomas forman?', a: 'Inglés, francés y mandarín. Los formadores son bilingües o trilingües, lo que ayuda con los matices culturales y comerciales.' },
  { cat: 'Compromiso', q: '¿Qué apoyo dan tras la sesión?', a: 'En la formación interna, 30 días de seguimiento posterior: dudas por correo, dos llamadas por vídeo con el equipo y acceso a nuestras actualizaciones de mercado.' },
  { cat: 'Programa', q: '¿Cómo es un día tipo de formación?', a: 'Una mezcla de módulos de contenido, casos en vivo, Q&A estructurado, ejercicios de trabajo atados a su negocio y un plan de acción de cierre. Mantenemos el ritmo alto y descansamos a menudo.' },
  { cat: 'Audiencia', q: '¿Hay requisitos previos?', a: 'No hay requisitos técnicos. Ayuda tener una base en marketing digital. Lo único que de verdad necesitamos en la sala es un proyecto real o un interés genuino por el mercado chino.' },
  { cat: 'Precio', q: '¿Cuánto cuesta?', a: 'Las tarifas dependen del formato, la duración, la ubicación y el número de participantes. Contacte con nosotros para un presupuesto a medida.' },
  { cat: 'Formato', q: '¿Cuántas personas pueden asistir?', a: 'Entre 8 y 30 en una sesión de trabajo. Con menos de 8, la sala pierde energía en los debates. Con más de 30, los ejercicios y los grupos de trabajo dejan de funcionar bien. Para jornadas de empresa o ponencias de congreso (50 a 300 personas) hacemos una versión en formato magistral con Q&A estructurado en lugar de trabajo en grupo.' },
  { cat: 'Formato', q: '¿Con cuánta antelación pueden hacer una sesión?', a: 'Dos semanas de margen es lo cómodo. Hemos hecho sesiones con cinco días hábiles de aviso cuando se movió una reunión de consejo. Plazos más cortos cuestan flexibilidad en fechas y en parejas de formadores, no en calidad de contenido.' },
  { cat: 'Formato', q: '¿Funciona en remoto o solo presencial?', a: 'Las dos. Cerca de la mitad de las sesiones internas hoy son remotas o híbridas. El remoto funciona mejor en bloques de 3 a 4 horas repartidos en dos días que en un Zoom maratoniano. La presencial sigue ganando cuando el equipo tiene que romperse en grupos de trabajo o pizarrear una estrategia.' },
  { cat: 'Formato', q: '¿Podemos grabar la sesión para compañeros que no puedan asistir?', a: 'Sí, para uso interno. Pedimos que la grabación se quede dentro de la empresa, fuera de canales públicos, y que no se reempaquete como contenido comercial externo. Las láminas y los materiales se los lleva de cualquier modo.' },
  { cat: 'Programa', q: '¿Qué deberíamos preparar antes?', a: 'Un breve documento sobre su actividad actual en China, lo que aún no saben y las tres o cuatro preguntas que más quieren contestar. Y los datos internos que estén dispuestos a compartir: mix de canales, agencias con las que trabajan, resultados de campañas recientes, estructura de distribución. Cuanto más concreto sea el input, más afilada será la sesión.' },
  { cat: 'Audiencia', q: '¿En qué sectores han formado?', a: 'Belleza, moda, lujo, alimentación y bebidas, turismo, automoción, servicios profesionales, industrial B2B, grandes tecnológicas y SaaS. La mecánica de las plataformas es bastante parecida entre categorías. Lo que cambia son los casos, los benchmarks y las tácticas que metemos en juego.' },
  { cat: 'Audiencia', q: 'Empezamos de cero en China. ¿No será demasiado avanzado?', a: 'No. El módulo 1 está pensado para equipos que arrancan de cero. Ajustamos la profundidad en la llamada de briefing. Una sala de iniciados dedica más tiempo a las plataformas y al comportamiento del consumidor. Una sala sénior corre más por el mapa y entra en operativa y reparto de presupuesto.' },
  { cat: 'Audiencia', q: 'Ya tenemos oficina en China. ¿Tiene algo que aportarnos?', a: 'Sí. Una parte importante de nuestros clientes internos son equipos que llevan años operando en mercado. Para ellos el valor está en el benchmarking, en los datos frescos por categoría y en un diagnóstico externo sobre las partes de su operativa que llevan tiempo rindiendo por debajo. La agenda se inclina hacia auditoría y operaciones, alejándose de la introducción.' },
  { cat: 'Compromiso', q: '¿Firman acuerdos de confidencialidad?', a: 'Sí. Antes de cualquier llamada de briefing en la que se toquen sus cifras. Sus datos internos y su estrategia se quedan en la sala. Nada aflora en otro dossier ni en un caso público.' },
  { cat: 'Programa', q: '¿Cómo de reciente es el material?', a: 'Se refresca antes de cada sesión. Cualquier cosa más antigua que el último trimestre completo se marca o se retira. Las plataformas chinas cambian comisiones, formatos y algoritmos varias veces al año, así que tratamos las láminas viejas como un riesgo real y la preparación se planifica con eso en mente.' },
];

const faqCategories = ['Todas', 'Programa', 'Formato', 'Audiencia', 'Compromiso', 'Precio'];
---

<Layout
  title="Masterclass de eCommerce y digital en China | Beyond Border Group"
  description="Una masterclass dirigida por operadores sobre el ecosistema digital chino, las plataformas de eCommerce, el comportamiento del consumidor y la mecánica de campaña. Personalizada para su categoría y su equipo."
>
  <div class="mc-progress" aria-hidden="true"><div class="mc-progress__bar"></div></div>

  <article class="mc">

    {/* ---------- HERO (cinematic) ---------- */}
    <section class="mc-hero cbs-hero" data-hero>
      <div class="mc-hero__bg" aria-hidden="true" data-parallax>
        <img src="/Images/CyrilMasterclass.jpg" alt="Cyril Drouin en el escenario de la Shanghai International MCN Conference" />
      </div>
      <div class="mc-hero__overlay" aria-hidden="true"></div>
      <div class="mc-hero__grain" aria-hidden="true"></div>

      <div class="container mc-hero__inner">
        <nav class="mc-hero__crumbs" aria-label="Breadcrumb">
          <a href="/es">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href="/es/conocer-china">Conocer China</a>
        </nav>

        <span class="eyebrow eyebrow--on-dark mc-reveal">Conocer China · Masterclass</span>

        <h1 class="mc-hero__title mc-reveal" style="--reveal-delay: 80ms;">
          <span class="mc-hero__title-row">Una masterclass sobre China</span>
          <span class="mc-hero__title-row mc-hero__title-row--accent">impartida por operadores,</span>
          <span class="mc-hero__title-row">no por</span>
          <span class="mc-hero__title-row mc-hero__title-row--highlight">exconsultores.</span>
        </h1>

        <p class="mc-hero__lead mc-reveal" style="--reveal-delay: 200ms;">
          Un programa de formación concentrado sobre el ecosistema digital y de
          eCommerce de China. Plataformas, comportamiento del consumidor, mecánica de
          campaña. Personalizado para su sector y dirigido por operadores con veinte
          años sobre el terreno.
        </p>

        <div class="mc-hero__actions mc-reveal" style="--reveal-delay: 280ms;">
          <a href="/es/contacto" class="btn btn--primary mc-magnetic">Reservar una masterclass</a>
          <a href="#curriculum" class="btn btn--ghost-light mc-magnetic">Ver el temario</a>
        </div>

        <div class="mc-hero__meta mc-reveal" style="--reveal-delay: 360ms;">
          {heroStats.map((s) => (
            <div class="mc-hero__meta-item">
              <span class="mc-hero__meta-num" data-counter={s.value} data-suffix={s.suffix}>0</span>
              <span class="mc-hero__meta-label">{s.label}</span>
            </div>
          ))}
        </div>

        <ul class="mc-hero__badges mc-reveal" aria-label="Dónde hemos formado" style="--reveal-delay: 440ms;">
          {heroBadges.map(b => <li>{b}</li>)}
        </ul>
      </div>

      <a href="#why" class="mc-hero__scroll" aria-label="Bajar a la siguiente sección">
        <span class="mc-hero__scroll-line"></span>
        <span class="mc-hero__scroll-text">Scroll</span>
      </a>
    </section>

    {/* ---------- WHY / AUDIENCE ---------- */}
    <section id="why" class="section section--alt">
      <div class="container">
        <div class="mc-value">
          <div class="mc-value__copy mc-reveal">
            <span class="eyebrow">Por qué esta formación</span>
            <h2>Entender cómo funciona China de verdad, no como dice un informe que funciona.</h2>
            <p>
              Una inmersión en cómo opera, en la práctica, el ecosistema digital y de
              compras online de China. Sale de la sala con una idea clara de las
              plataformas, del comportamiento del consumidor que mueve la venta y de la
              mecánica de una campaña que convierte de verdad.
            </p>
            <p>
              Nada de láminas recicladas sobre tendencias. Nada de manuales traducidos
              desde Estados Unidos. Las cifras se refrescan antes de cada sesión, porque
              el mercado corre lo bastante deprisa como para que el dossier del trimestre
              pasado ya esté equivocado.
            </p>
          </div>

          <aside class="mc-promise mc-reveal" style="--reveal-delay: 120ms;" aria-label="Para quién es esta formación">
            <span class="eyebrow">Para quién es</span>
            <ul class="mc-promise__list">
              {audience.map((a) => (
                <li class="mc-promise__item">
                  <span class="mc-promise__check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8"/></svg>
                  </span>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>
      </div>
    </section>

    {/* ---------- WHAT YOU TAKE AWAY (bento) ---------- */}
    <section class="section mc-take-section">
      <div class="container">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">Qué se lleva</span>
          <h2>Una formación que sigue siendo útil cuando sale de la sala.</h2>
          <p class="section-header__lead">
            Cinco razones por las que los equipos repiten. La primera es lo que casi
            ninguna otra formación puede ofrecer.
          </p>
        </header>

        <div class="mc-bento">
          {takeaways.map((t, i) => t.feature ? (
            <article class="mc-bento__card mc-bento__card--feature mc-reveal">
              <img
                class="mc-bento__feature-img"
                src="/Images/work/pierre-fabre.png"
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <div class="mc-bento__feature-bg" aria-hidden="true"></div>
              <div class="mc-bento__feature-body">
                <span class="mc-bento__chip">La diferencia</span>
                <h3>{t.h}</h3>
                <p>{t.p}</p>
                <ul class="mc-bento__feature-stats">
                  <li>
                    <span class="mc-bento__stat-num">20<span>+</span></span>
                    <span class="mc-bento__stat-label">años sobre el terreno</span>
                  </li>
                  <li>
                    <span class="mc-bento__stat-num">100<span>%</span></span>
                    <span class="mc-bento__stat-label">operadores al frente, cada sesión</span>
                  </li>
                </ul>
              </div>
            </article>
          ) : (
            <article class="mc-bento__card mc-bento__card--small mc-reveal" style={`--reveal-delay: ${i * 70}ms;`}>
              <h3>{t.h}</h3>
              <p>{t.p}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- CURRICULUM (tabbed) ---------- */}
    <section class="section section--alt" id="curriculum">
      <div class="container">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">Temario</span>
          <h2>Tres módulos. Usted elige profundidad y formato.</h2>
          <p class="section-header__lead">
            Se entrega en jornada completa, repartido en sesiones de media jornada o
            configurado como un programa largo. Profundidad en los temas que importan a
            su categoría, repaso rápido en los que no.
          </p>
        </header>

        <div class="mc-curriculum mc-reveal" data-mc-tabs>
          <div class="mc-curriculum__nav" role="tablist" aria-label="Módulos del temario">
            {modules.map((m, i) => (
              <button
                type="button"
                class={`mc-curriculum__tab${i === 0 ? ' is-active' : ''}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`mc-module-panel-${i}`}
                id={`mc-module-tab-${i}`}
                data-tab-target={`mc-module-panel-${i}`}
              >
                <span class="mc-curriculum__tab-icon" aria-hidden="true" set:html={moduleIcon[m.icon]} />
                <span class="mc-curriculum__tab-body">
                  <span class="mc-curriculum__tab-label">{m.tab}</span>
                  <span class="mc-curriculum__tab-sub">{m.tabSub}</span>
                </span>
              </button>
            ))}
            <span class="mc-curriculum__indicator" aria-hidden="true"></span>
          </div>

          <div class="mc-curriculum__panels">
            {modules.map((m, i) => (
              <div
                class={`mc-curriculum__panel${i === 0 ? ' is-active' : ''}`}
                role="tabpanel"
                id={`mc-module-panel-${i}`}
                aria-labelledby={`mc-module-tab-${i}`}
                hidden={i !== 0}
              >
                <div class="mc-curriculum__panel-grid">
                  <aside class="mc-curriculum__lead" data-tilt>
                    <figure class="mc-curriculum__lead-figure">
                      <img src={m.image} alt={m.imageAlt} loading="lazy" decoding="async" width="640" height="800" />
                      <span class="mc-curriculum__lead-tag">
                        <span class="mc-curriculum__lead-tag-icon" aria-hidden="true" set:html={moduleIcon[m.icon]} />
                        <span class="mc-curriculum__lead-tag-text">{m.tab}</span>
                      </span>
                      <div class="mc-curriculum__lead-poster">
                        <span class="mc-curriculum__lead-eyebrow">Módulo</span>
                        <h3 class="mc-curriculum__lead-title">{m.title}</h3>
                      </div>
                    </figure>

                    <div class="mc-curriculum__lead-body">
                      <p class="mc-curriculum__lead-desc">{m.lead}</p>
                      <div class="mc-curriculum__lead-meta">
                        <span class="mc-curriculum__lead-meta-stat">
                          <span class="mc-curriculum__lead-meta-num">{m.topics.length}</span>
                          <span class="mc-curriculum__lead-meta-label">temas</span>
                        </span>
                        <span class="mc-curriculum__lead-meta-divider" aria-hidden="true"></span>
                        <span class="mc-curriculum__lead-meta-stat">
                          <span class="mc-curriculum__lead-meta-num">½ &middot; 1</span>
                          <span class="mc-curriculum__lead-meta-label">jornadas</span>
                        </span>
                      </div>
                      <a href="/es/contacto" class="btn btn--primary btn--sm mc-magnetic mc-curriculum__lead-cta">
                        <span>Adaptar este módulo</span>
                        <span class="mc-curriculum__lead-cta-arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  </aside>

                  <div class="mc-curriculum__topics">
                    {m.topics.map((t) => (
                      <div class="mc-curriculum__topic">
                        <h4 class="mc-curriculum__topic-title">{t.h}</h4>
                        <ul class="mc-curriculum__topic-list">
                          {t.items.map((i) => <li>{i}</li>)}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ---------- TRAINERS ---------- */}
    <section class="section mc-trainers-section">
      <div class="container">
        <div class="mc-trainers">
          <div class="mc-trainers__copy mc-reveal">
            <span class="eyebrow">Quién la imparte</span>
            <h2>Operadores, no académicos.</h2>
            <p>
              Cyril lleva más de una década formando a directivos sobre el mercado
              digital chino en inglés y en francés. Liyan dirige el mismo programa para
              audiencias en mandarín. Juntos han formado en HEC MBA, ESCP MBA, la
              Cámara Europea de Comercio en China, la Cámara Americana, Business France
              y el Executive MBA de Shanghai Jiaotong.
            </p>
            <div class="mc-trainers__actions">
              <a href="/es/quienes-somos" class="btn btn--secondary">Conocer al equipo</a>
              <a href="/es/contacto" class="btn btn--ghost">Hablar con un formador</a>
            </div>
          </div>

          <ul class="mc-trainers__list mc-reveal" style="--reveal-delay: 120ms;" aria-label="Formadores principales">
            <li class="mc-trainer">
              <span class="mc-trainer__avatar">
                <img
                  src="/Images/team/cyril-drouin.jpg"
                  alt="Retrato de Cyril Drouin"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <div class="mc-trainer__body">
                <span class="mc-trainer__name">Cyril Drouin</span>
                <span class="mc-trainer__role">Fundador y CEO</span>
                <span class="mc-trainer__meta">Shanghái / París</span>
                <span class="mc-trainer__langs">Inglés · Francés</span>
              </div>
            </li>
            <li class="mc-trainer">
              <span class="mc-trainer__avatar">
                <img
                  src="/Images/team/liyan-ye.jpg"
                  alt="Retrato de Liyan Ye"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <div class="mc-trainer__body">
                <span class="mc-trainer__name">Liyan Ye</span>
                <span class="mc-trainer__role">Directora sénior</span>
                <span class="mc-trainer__meta">Shanghái</span>
                <span class="mc-trainer__langs">Mandarín · Inglés</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    {/* ---------- FORMAT / LOGISTICS (spec sheet) ---------- */}
    <section class="section section--alt">
      <div class="container">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">Formato y logística</span>
          <h2>Pensado al ritmo de su equipo.</h2>
          <p class="section-header__lead">
            Seis palancas que afina antes de que entremos en la sala. Contenido, lugar,
            tiempos, idioma, entregables y lo que seguimos haciendo cuando termina la
            sesión.
          </p>
        </header>

        <div class="mc-spec mc-reveal">
          <div class="mc-spec__header" aria-hidden="true">
            <span class="mc-spec__header-eyebrow">Ficha del programa</span>
            <span class="mc-spec__header-dot"></span>
            <span class="mc-spec__header-eyebrow mc-spec__header-eyebrow--muted">Seis variables, totalmente flexibles</span>
          </div>
          <dl class="mc-spec__list">
            {format.map((f, i) => (
              <div class="mc-spec__row" style={`--row-delay: ${i * 40}ms;`}>
                <dt class="mc-spec__key">
                  <span class="mc-spec__icon" aria-hidden="true" set:html={formatIcon[f.icon]} />
                  <span class="mc-spec__label">{f.label}</span>
                </dt>
                <dd class="mc-spec__value">{f.body}</dd>
              </div>
            ))}
          </dl>
          <footer class="mc-spec__footer">
            <span class="mc-spec__footer-text">¿Necesita otra forma? La construimos a su alrededor.</span>
            <a href="/es/contacto" class="mc-spec__footer-link">Hablemos <span aria-hidden="true">→</span></a>
          </footer>
        </div>
      </div>
    </section>

    {/* ---------- FAQ (with category filter) ---------- */}
    <section class="section">
      <div class="container container--narrow">
        <header class="section-header section-header--center mc-reveal">
          <span class="eyebrow">Preguntas frecuentes</span>
          <h2>Veinte preguntas que nos llegan cada semana.</h2>
          <p class="section-header__lead">
            Las dudas prácticas de los equipos que están valorando una masterclass.
            Filtre por tema.
          </p>
        </header>

        <div class="mc-faq-filter mc-reveal" data-faq-filter role="tablist" aria-label="Filtrar preguntas por categoría">
          {faqCategories.map((c, i) => (
            <button
              type="button"
              class={`mc-faq-chip${i === 0 ? ' is-active' : ''}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-faq-cat={c}
            >
              <span class="mc-faq-chip__label">{c}</span>
              <span class="mc-faq-chip__count">{c === 'Todas' ? faqs.length : faqs.filter((f) => f.cat === c).length}</span>
            </button>
          ))}
        </div>

        <div class="mc-faq" data-faq-list>
          {faqs.map((f, i) => (
            <details
              class="mc-faq__item mc-reveal"
              data-faq-cat={f.cat}
              open={i === 0}
              style={`--reveal-delay: ${Math.min(i, 6) * 40}ms;`}
            >
              <summary class="mc-faq__q">
                <span class="mc-faq__cat-tag">{f.cat}</span>
                <span class="mc-faq__q-text">{f.q}</span>
                <span class="mc-faq__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <div class="mc-faq__a">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- FINAL CTA ---------- */}
    <section class="section section--tight">
      <div class="container container--narrow">
        <div class="mc-cta">
          <span class="eyebrow eyebrow--on-dark">Hablemos</span>
          <h2 class="mc-cta__title">¿Pensando en una masterclass sobre China para su equipo?</h2>
          <p class="mc-cta__lead">
            Cuéntenos quién es el equipo, su categoría y con qué quiere salir de la
            sala. Le respondemos en menos de un día hábil con un programa hecho a
            medida.
          </p>
          <div class="mc-cta__actions">
            <a href="/es/contacto" class="btn mc-cta__btn-primary">Reservar una masterclass</a>
            <a href="/es/proyectos" class="btn mc-cta__btn-ghost">Ver nuestros casos</a>
          </div>
        </div>
      </div>
    </section>

  </article>

</Layout>

