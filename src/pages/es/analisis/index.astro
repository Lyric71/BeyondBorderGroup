---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { INSIGHT_CATEGORIES, INSIGHT_PLATFORMS } from '../../../content.config';

const allInsights = await getCollection('insightsEs', ({ data }) => !data.draft);

const sorted = allInsights.sort((a, b) => {
  const da = a.data.pubDate?.valueOf() ?? 0;
  const db = b.data.pubDate?.valueOf() ?? 0;
  if (db !== da) return db - da;
  return a.data.title.localeCompare(b.data.title, 'es');
});

const categoryLabelsEs: Record<string, string> = {
  'Platforms': 'Plataformas',
  'E-Commerce': 'eCommerce',
  'KOLs & Livestream': 'KOL y livestream',
  'Brand & Localization': 'Marca y localización',
  'AI & Innovation': 'IA e innovación',
  'Market Strategy': 'Estrategia de mercado',
  'Compliance & Setup': 'Cumplimiento e implantación',
};

function readingTime(body: string | undefined) {
  if (!body) return '';
  const words = body.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.round(words / 200));
  return `${minutes} min de lectura`;
}

function formatDate(d?: Date) {
  if (!d) return '';
  return d.toLocaleDateString('es-ES', { month: 'short', year: 'numeric' });
}

const categoryCounts = new Map<string, number>();
const platformCounts = new Map<string, number>();
for (const post of sorted) {
  categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
  for (const p of post.data.platforms ?? []) {
    platformCounts.set(p, (platformCounts.get(p) ?? 0) + 1);
  }
}

const categories = INSIGHT_CATEGORIES.filter((c) => (categoryCounts.get(c) ?? 0) > 0).map((c) => ({
  value: c,
  label: categoryLabelsEs[c] ?? c,
  count: categoryCounts.get(c) ?? 0,
}));

const PLATFORM_MIN = 2;
const platforms = INSIGHT_PLATFORMS.filter((p) => (platformCounts.get(p) ?? 0) >= PLATFORM_MIN)
  .map((p) => ({ value: p, count: platformCounts.get(p) ?? 0 }))
  .sort((a, b) => b.count - a.count);
---

<Layout
  title="Análisis | TheChinaPath"
  description="Análisis del eCommerce chino, las plataformas digitales y la estrategia de marca. Firmados por el equipo que pilota marcas en Tmall, JD, Douyin, WeChat y RED desde Shanghái, Hong Kong y París."
>
  <section class="insights-intro">
    <div class="container">
      <span class="eyebrow">Análisis</span>
      <h1>China, vista desde el terreno.</h1>
      <p class="lead">
        Toma la palabra el equipo que lleva marcas en Tmall, JD, Douyin, WeChat y RED.
        Desde Shanghái, Hong Kong y París. Nunca desde un despacho lejos del mercado.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="insights-controls">
        {categories.length > 1 && (
          <div class="insights-filter" role="tablist" aria-label="Filtrar por categoría">
            <button type="button" class="insights-filter__btn is-active" data-category="all" role="tab" aria-selected="true">
              <span class="insights-filter__label">Todo</span>
              <span class="insights-filter__count" aria-hidden="true">{sorted.length}</span>
            </button>
            {categories.map((c) => (
              <button type="button" class="insights-filter__btn" data-category={c.value} role="tab" aria-selected="false">
                <span class="insights-filter__label">{c.label}</span>
                <span class="insights-filter__count" aria-hidden="true">{c.count}</span>
              </button>
            ))}
          </div>
        )}

        {platforms.length > 1 && (
          <div class="insights-platforms" role="group" aria-label="Filtrar por plataforma">
            <span class="insights-platforms__label">Plataforma</span>
            <button type="button" class="insights-platforms__btn is-active" data-platform="all">Todas</button>
            {platforms.map((p) => (
              <button type="button" class="insights-platforms__btn" data-platform={p.value}>
                {p.value}
                <span class="insights-platforms__count" aria-hidden="true">{p.count}</span>
              </button>
            ))}
          </div>
        )}

        <div class="insights-sort">
          <label for="insights-sort-select" class="insights-sort__label">Ordenar</label>
          <select id="insights-sort-select" class="insights-sort__select" data-sort>
            <option value="newest">Más recientes</option>
            <option value="oldest">Más antiguos</option>
          </select>
        </div>
      </div>

      <div class="grid grid-3 insights-grid">
        {sorted.map((post) => (
          <a
            href={`/es/analisis/${post.id}`}
            class="insight-card"
            data-category={post.data.category}
            data-platforms={(post.data.platforms ?? []).join('|')}
            data-pubdate={post.data.pubDate ? post.data.pubDate.valueOf() : 0}
            data-title={post.data.title}
          >
            <div class="insight-card__image">
              {post.data.heroImage && (
                <img
                  src={post.data.heroImage}
                  alt={post.data.heroImageAlt}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="400"
                />
              )}
            </div>
            <div class="insight-card__body">
              <span class="insight-card__tag">{categoryLabelsEs[post.data.category] ?? post.data.category}</span>
              <h3 class="insight-card__title">{post.data.title}</h3>
              <div class="insight-card__meta">
                <span class="insight-card__author">{post.data.author}</span>
                <span class="insight-card__meta-sep" aria-hidden="true">|</span>
                <span>{readingTime(post.body)}</span>
                {post.data.pubDate && (
                  <>
                    <span class="insight-card__meta-sep" aria-hidden="true">|</span>
                    <span>{formatDate(post.data.pubDate)}</span>
                  </>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>

      <p class="insights-empty" hidden={sorted.length !== 0}>
        {sorted.length === 0
          ? "Estamos recuperando los artículos antiguos. Vuelva en unos días."
          : 'Nada bajo esta combinación de filtros. Pruebe con otra.'}
      </p>

      <nav class="insights-pagination" aria-label="Paginación de análisis" hidden>
        <button type="button" class="insights-pagination__btn" data-page-prev aria-label="Página anterior">
          <span aria-hidden="true">&larr;</span> Anterior
        </button>
        <ol class="insights-pagination__pages" data-page-list></ol>
        <button type="button" class="insights-pagination__btn" data-page-next aria-label="Página siguiente">
          Siguiente <span aria-hidden="true">&rarr;</span>
        </button>
      </nav>
    </div>
  </section>

  <script is:inline>
    (function () {
      const PER_PAGE = 12;
      const grid = document.querySelector('.insights-grid');
      const cards = Array.from(document.querySelectorAll('.insight-card'));
      const pagination = document.querySelector('.insights-pagination');
      const pageList = document.querySelector('[data-page-list]');
      const prevBtn = document.querySelector('[data-page-prev]');
      const nextBtn = document.querySelector('[data-page-next]');
      const sortSelect = document.querySelector('[data-sort]');
      let currentCategory = 'all';
      let currentPlatform = 'all';
      let currentSort = 'newest';
      let currentPage = 1;

      function readUrl() {
        const params = new URLSearchParams(window.location.search);
        const page = parseInt(params.get('page') || '1', 10);
        currentPage = Number.isFinite(page) && page > 0 ? page : 1;
        currentCategory = params.get('category') || 'all';
        currentPlatform = params.get('platform') || 'all';
        currentSort = params.get('sort') === 'oldest' ? 'oldest' : 'newest';
      }

      function writeUrl(push) {
        const params = new URLSearchParams(window.location.search);
        if (currentPage > 1) params.set('page', String(currentPage));
        else params.delete('page');
        if (currentCategory && currentCategory !== 'all') params.set('category', currentCategory);
        else params.delete('category');
        if (currentPlatform && currentPlatform !== 'all') params.set('platform', currentPlatform);
        else params.delete('platform');
        if (currentSort === 'oldest') params.set('sort', 'oldest');
        else params.delete('sort');
        const qs = params.toString();
        const url = window.location.pathname + (qs ? '?' + qs : '') + window.location.hash;
        const state = { page: currentPage, category: currentCategory, platform: currentPlatform, sort: currentSort };
        if (push) history.pushState(state, '', url);
        else history.replaceState(state, '', url);
      }

      function syncUi() {
        document.querySelectorAll('.insights-filter__btn').forEach((b) => {
          const on = b.dataset.category === currentCategory;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        document.querySelectorAll('.insights-platforms__btn').forEach((b) => {
          b.classList.toggle('is-active', b.dataset.platform === currentPlatform);
        });
        if (sortSelect) sortSelect.value = currentSort;
      }

      function cardMatchesPlatform(card) {
        if (currentPlatform === 'all') return true;
        const list = (card.dataset.platforms || '').split('|').filter(Boolean);
        return list.includes(currentPlatform);
      }

      function getFiltered() {
        const filtered = cards.filter(
          (c) => (currentCategory === 'all' || c.dataset.category === currentCategory) && cardMatchesPlatform(c)
        );
        filtered.sort((a, b) => {
          const da = parseInt(a.dataset.pubdate || '0', 10);
          const db = parseInt(b.dataset.pubdate || '0', 10);
          if (currentSort === 'oldest') {
            if (da !== db) return da - db;
            return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'es');
          }
          if (db !== da) return db - da;
          return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'es');
        });
        return filtered;
      }

      function pageNumbers(total, current) {
        if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
        const set = new Set([1, total, current - 1, current, current + 1]);
        const out = [];
        let prev = 0;
        Array.from(set)
          .filter((n) => n >= 1 && n <= total)
          .sort((a, b) => a - b)
          .forEach((n) => {
            if (prev && n - prev > 1) out.push('...');
            out.push(n);
            prev = n;
          });
        return out;
      }

      function render() {
        const filtered = getFiltered();
        const totalPages = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
        if (currentPage > totalPages) currentPage = totalPages;

        cards.forEach((card) => {
          card.style.display = 'none';
          card.style.order = '';
        });
        const start = (currentPage - 1) * PER_PAGE;
        filtered.slice(start, start + PER_PAGE).forEach((card, i) => {
          card.style.display = '';
          card.style.order = String(i);
        });

        const empty = document.querySelector('.insights-empty');
        if (empty) empty.hidden = filtered.length !== 0;

        if (totalPages <= 1) {
          pagination.hidden = true;
          return;
        }
        pagination.hidden = false;
        prevBtn.disabled = currentPage === 1;
        nextBtn.disabled = currentPage === totalPages;

        pageList.innerHTML = '';
        pageNumbers(totalPages, currentPage).forEach((n) => {
          const li = document.createElement('li');
          if (n === '...') {
            li.className = 'insights-pagination__ellipsis';
            li.setAttribute('aria-hidden', 'true');
            li.textContent = '...';
          } else {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'insights-pagination__page';
            btn.textContent = String(n);
            btn.setAttribute('aria-label', `Página ${n}`);
            if (n === currentPage) {
              btn.classList.add('is-active');
              btn.setAttribute('aria-current', 'page');
            }
            btn.addEventListener('click', () => goTo(n));
            li.appendChild(btn);
          }
          pageList.appendChild(li);
        });
      }

      function goTo(page) {
        currentPage = page;
        writeUrl(true);
        render();
        const top = grid.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top, behavior: 'smooth' });
      }

      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) goTo(currentPage - 1);
      });
      nextBtn.addEventListener('click', () => {
        const total = Math.max(1, Math.ceil(getFiltered().length / PER_PAGE));
        if (currentPage < total) goTo(currentPage + 1);
      });

      document.querySelectorAll('.insights-filter__btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCategory = btn.dataset.category;
          currentPage = 1;
          syncUi();
          writeUrl(true);
          render();
        });
      });

      document.querySelectorAll('.insights-platforms__btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          currentPlatform = btn.dataset.platform;
          currentPage = 1;
          syncUi();
          writeUrl(true);
          render();
        });
      });

      if (sortSelect) {
        sortSelect.addEventListener('change', () => {
          currentSort = sortSelect.value === 'oldest' ? 'oldest' : 'newest';
          currentPage = 1;
          writeUrl(true);
          render();
        });
      }

      window.addEventListener('popstate', () => {
        readUrl();
        syncUi();
        render();
      });

      readUrl();
      syncUi();
      writeUrl(false);
      render();
    })();
  </script>

  <style>
    .insights-intro {
      padding: var(--space-8) 0 var(--space-6);
      text-align: center;
    }
    .insights-intro .eyebrow { display: inline-block; margin-bottom: var(--space-4); }
    .insights-intro h1 { max-width: 20ch; margin-inline: auto; margin-bottom: var(--space-4); }
    .insights-intro .lead { max-width: 62ch; margin-inline: auto; color: var(--bbg-text); }

    .insights-controls {
      margin-bottom: var(--space-7);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--bbg-border);
    }

    .insights-filter {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      justify-content: center;
      margin-bottom: var(--space-3);
    }
    .insights-filter__btn {
      appearance: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid var(--bbg-border);
      background: transparent;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--bbg-text-muted);
      cursor: pointer;
      transition: all var(--dur) var(--ease);
    }
    .insights-filter__btn:hover {
      border-color: var(--bbg-blue);
      color: var(--bbg-blue);
    }
    .insights-filter__btn.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }
    .insights-filter__count {
      font-variant-numeric: tabular-nums;
      font-size: 0.75rem;
      font-weight: 500;
      opacity: 0.6;
    }
    .insights-filter__btn.is-active .insights-filter__count {
      opacity: 0.85;
    }

    .insights-platforms {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
      justify-content: center;
      margin-top: var(--space-3);
    }
    .insights-platforms__label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-right: 0.25rem;
    }
    .insights-platforms__btn {
      appearance: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: transparent;
      border: 1px solid transparent;
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--bbg-text-muted);
      cursor: pointer;
      transition: all var(--dur) var(--ease);
    }
    .insights-platforms__btn:hover {
      color: var(--bbg-blue);
    }
    .insights-platforms__btn.is-active {
      background: var(--bbg-blue-light);
      color: var(--bbg-blue-dark);
      border-color: var(--bbg-blue-light);
    }
    .insights-platforms__count {
      font-variant-numeric: tabular-nums;
      font-size: 0.7rem;
      opacity: 0.7;
    }

    .insights-sort {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: var(--space-3);
    }
    .insights-sort__label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
    }
    .insights-sort__select {
      appearance: none;
      border: 1px solid var(--bbg-border);
      background: transparent;
      padding: 0.4rem 2rem 0.4rem 0.75rem;
      border-radius: 999px;
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--bbg-ink);
      cursor: pointer;
      background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
      background-position: calc(100% - 14px) 50%, calc(100% - 9px) 50%;
      background-size: 5px 5px;
      background-repeat: no-repeat;
      transition: border-color var(--dur) var(--ease);
    }
    .insights-sort__select:hover,
    .insights-sort__select:focus {
      border-color: var(--bbg-blue);
      outline: none;
    }

    .insights-grid {
      gap: var(--space-6) var(--space-5);
    }
    .insights-empty {
      text-align: center;
      color: var(--bbg-text-muted);
      padding: var(--space-8) 0;
    }

  </style>

  <style is:global>
    .insights-pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-3);
      flex-wrap: wrap;
      margin-top: var(--space-7);
      padding-top: var(--space-6);
      border-top: 1px solid var(--bbg-border);
    }
    .insights-pagination[hidden] { display: none; }
    .insights-pagination__btn {
      appearance: none;
      border: 1px solid var(--bbg-border);
      background: transparent;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--bbg-ink);
      cursor: pointer;
      transition: all var(--dur) var(--ease);
    }
    .insights-pagination__btn:hover:not(:disabled) {
      border-color: var(--bbg-blue);
      color: var(--bbg-blue);
    }
    .insights-pagination__btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .insights-pagination__pages {
      display: flex;
      align-items: center;
      gap: 4px;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .insights-pagination__page {
      appearance: none;
      border: 1px solid transparent;
      background: transparent;
      min-width: 2.25rem;
      height: 2.25rem;
      padding: 0 0.5rem;
      border-radius: 8px;
      font-size: var(--fs-small);
      font-weight: 500;
      color: var(--bbg-text-muted);
      cursor: pointer;
      transition: all var(--dur) var(--ease);
    }
    .insights-pagination__page:hover {
      color: var(--bbg-blue);
      border-color: var(--bbg-blue);
    }
    .insights-pagination__page.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }
    .insights-pagination__ellipsis {
      padding: 0 0.25rem;
      color: var(--bbg-text-muted);
      user-select: none;
    }
  </style>
</Layout>
