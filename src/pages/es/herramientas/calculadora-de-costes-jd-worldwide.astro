---
import Layout from '../../../layouts/Layout.astro';
import { webApplicationSchema } from '../../../lib/seo';

// ---- Key drivers, shown as sliders at the top of the calculator ----
type Driver = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number';
  min: string;
  max: string;
  step: string;
  hint?: string;
};

const drivers: Driver[] = [
  { id: 'gmv', label: 'GMV objetivo del año 1', value: '3500000', kind: 'money', min: '200000', max: '10000000', step: '100000' },
  { id: 'aov', label: 'Ticket medio', value: '250', kind: 'money', min: '20', max: '2000', step: '5' },
  { id: 'gmvGrowth', label: 'Crecimiento del GMV en el año 2', value: '50', kind: 'percent', min: '0', max: '200', step: '5' },
  { id: 'dpRetainer', label: 'Retainer mensual del TP', value: '35000', kind: 'money', min: '0', max: '200000', step: '5000' },
  { id: 'coFund', label: 'Cofinanciación de campañas', value: '0', kind: 'money', min: '0', max: '500000', step: '10000' },
  { id: 'dpCommission', label: 'Comisión del TP sobre el GMV', value: '10', kind: 'percent', min: '0', max: '20', step: '0.5' },
  { id: 'paidShare', label: 'Medios pagados', value: '60', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolShare', label: 'KOL y livestream', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'organicShare', label: 'Orgánico', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolCommission', label: 'Comisión del KOL', value: '20', kind: 'percent', min: '0', max: '40', step: '1' },
  { id: 'roas', label: 'ROAS (retorno de la inversión publicitaria)', value: '2', kind: 'number', min: '0.5', max: '8', step: '0.1' },
];

// The three channel shares are grouped together and must always total 100%.
const shareIds = ['paidShare', 'kolShare', 'organicShare'];
const mainDrivers = drivers.filter((d) => !shareIds.includes(d.id));
const shareDrivers = drivers.filter((d) => shareIds.includes(d.id));

// Year 2 carries its own mix: organic normally climbs once the store has
// reviews and repeat buyers, which is what makes the second year cheaper to run.
const shareDrivers2: Driver[] = [
  { id: 'paidShare2', label: 'Medios pagados', value: '50', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolShare2', label: 'KOL y livestream', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'organicShare2', label: 'Orgánico', value: '30', kind: 'percent', min: '0', max: '100', step: '1' },
];
const mixRows = [
  { year: '1', title: 'Año 1', drivers: shareDrivers, noteId: 'mix-note' },
  { year: '2', title: 'Año 2', drivers: shareDrivers2, noteId: 'mix-note-2' },
];

// ---- Advanced inputs, grouped in the collapsible section ----
type Field = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number' | 'select';
  step?: string;
  hint?: string;
  fx?: boolean;
  readonly?: boolean;
  suffix?: string;
  options?: { value: string; label: string; deposit?: string; fee?: string; annual?: string }[];
};

// JD Worldwide (京东全球购) categories. Each one sets the security deposit and the
// platform commission (运营支持服务费, 2%-6% band) that move with the product
// category. JD quotes the deposit in a TIERED USD ladder that steps up with
// cumulative sales; the RMB figures here seed the entry tier at about 7.1 to the
// dollar (US$5,000 for most categories, US$2,000 for fresh, US$15,000 for
// high-value electronics, US$40,000 for pharma). The annual platform usage fee
// is a flat US$1,000. Directional 2025 bands; confirm the exact rate at onboarding.
const categories: { value: string; label: string; deposit: string; fee: string; annual: string }[] = [
  { value: 'fresh', label: 'Alimentación fresca (生鲜)', deposit: '14200', fee: '4', annual: '7100' },
  { value: 'food', label: 'Alimentación envasada, cereales, aceite y snacks', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'tea', label: 'Té y bebidas en polvo', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'alcohol', label: 'Bebidas alcohólicas', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'supplements', label: 'Complementos alimenticios', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'baby', label: 'Maternidad, bebé y leche infantil', deposit: '35500', fee: '3', annual: '7100' },
  { value: 'skincare', label: 'Cuidado de la piel', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'makeup', label: 'Maquillaje y perfumería', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'personal-care', label: 'Higiene y cuidado personal', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'apparel', label: 'Ropa', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'footwear', label: 'Calzado', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'bags', label: 'Bolsos y maletas', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'jewellery', label: 'Bisutería', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'watches', label: 'Relojería (tramo de depósito alto)', deposit: '106500', fee: '5', annual: '7100' },
  { value: '3c', label: 'Electrónica 3C y accesorios', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'phones', label: 'Móviles y ordenadores (tramo de depósito alto)', deposit: '106500', fee: '3', annual: '7100' },
  { value: 'home', label: 'Hogar, cocina y menaje', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'appliances', label: 'Pequeño electrodoméstico', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'sports', label: 'Deporte y aire libre', deposit: '35500', fee: '5', annual: '7100' },
  { value: 'pet', label: 'Alimentación y accesorios para mascotas', deposit: '35500', fee: '4', annual: '7100' },
  { value: 'pharma', label: 'Farmacia (医药, tramo de depósito máximo)', deposit: '284000', fee: '5', annual: '7100' },
  { value: 'custom', label: 'Personalizado (depósito y comisión a mano)', deposit: '', fee: '', annual: '' },
];

const gicon = {
  tax: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  platform: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 18v3"/></svg>`,
  kol: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 15z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
  logistics: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h12v9H2z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>`,
  media: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4a1 1 0 0 0 1 1h2l9 5V4L6 9H4a1 1 0 0 0-1 1z"/><path d="M18 9a4 4 0 0 1 0 6"/></svg>`,
  margin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l3-4 3 2 4-6"/></svg>`,
};

const groups: { title: string; icon: string; note?: string; fields: Field[] }[] = [
  {
    title: 'Categoría',
    icon: gicon.platform,
    note: 'Elija su categoría de producto. En JD Worldwide, el depósito y la comisión de plataforma se mueven con la categoría, así que esta elección fija esos dos números más abajo. El depósito va por tramos y se cotiza en dólares: la cifra en RMB corresponde al tramo de entrada. Si su TP le pasa otro número, sobrescríbalo a mano.',
    fields: [
      {
        id: 'category',
        label: 'Categoría de producto (京东全球购)',
        value: 'food',
        kind: 'select',
        options: categories,
      },
    ],
  },
  {
    title: 'Divisa e impuestos',
    icon: gicon.tax,
    fields: [
      { id: 'fx', label: 'Tipo de cambio USD / RMB', value: '7.1', kind: 'number', step: '0.01', fx: true },
      { id: 'cbecTax', label: 'IVA cross-border (综合税)', value: '9.1', kind: 'percent', step: '0.1', hint: 'Un 13 % de IVA sobre el 70 % del precio de venta, es decir, un 9,1 % para la mercancía general. La cosmética, la perfumería y el alcohol pagan además impuesto especial y suben.' },
      { id: 'cbecTaxPayer', label: 'Quién asume el IVA', value: 'consumer', kind: 'select', options: [ { value: 'consumer', label: 'Lo paga el consumidor, sobre el precio' }, { value: 'brand', label: 'Lo absorbe la marca' } ] },
    ],
  },
  {
    title: 'Plataforma y TP',
    icon: gicon.platform,
    fields: [
      { id: 'period', label: 'Duración del contrato', value: '12', kind: 'number', readonly: true, suffix: 'meses', hint: 'Fijo. El modelo calcula doce meses completos y todas las cifras anuales siguen esa ventana.' },
      { id: 'platformDeposit', label: 'Depósito de garantía de JD Worldwide', value: '35500', kind: 'money', hint: 'Recuperable, por tramos según las ventas acumuladas y cotizado en dólares. El tramo de entrada ronda los 5.000 USD en la mayoría de categorías, 2.000 USD en fresco y más en producto de alto valor. Lo fija la categoría de arriba.' },
      { id: 'techFee', label: 'Comisión de plataforma (运营支持服务费)', value: '4', kind: 'percent', step: '0.1', hint: 'Se cobra en cada venta, en una horquilla del 2 % al 6 % según la categoría. Lo fija la categoría de arriba.' },
      { id: 'paymentFee', label: 'Tasa por transacción (交易服务费)', value: '0.9', kind: 'percent', step: '0.1', hint: 'Un 0,9 % fijo por pedido en JD Worldwide, en todas las categorías.' },
      { id: 'annualFee', label: 'Cuota de uso de la plataforma (平台使用费)', value: '7100', kind: 'money', hint: 'Unos 1.000 USD al año, importe fijo. Algunas categorías tienen un periodo de prueba sin cuota, así que confírmelo al darse de alta.' },
      { id: 'agentFee', label: 'Agente de aduanas, coste anual', value: '0', kind: 'money', hint: 'Opcional. Muchas marcas dejan el despacho en manos del TP o del almacén, así que déjelo a cero salvo que contrate un 境内代理人 aparte.' },
      { id: 'trademark', label: 'Registro de marca en China', value: '0', kind: 'money' },
      { id: 'brandSetup', label: 'Montaje de la tienda y contenidos de lanzamiento', value: '25000', kind: 'money' },
    ],
  },
  {
    title: 'Logística',
    icon: gicon.logistics,
    fields: [
      { id: 'whDeposit', label: 'Depósito del almacén en zona franca', value: '100000', kind: 'money' },
      { id: 'whTaxPrepay', label: 'Anticipo de impuestos al almacén en zona franca', value: '300000', kind: 'money' },
      { id: 'storage', label: 'Almacenaje por unidad y mes', value: '0.8', kind: 'number', step: '0.1' },
      { id: 'fulfillment', label: 'Preparación por pedido (picking y empaquetado)', value: '4', kind: 'money', step: '0.5' },
      { id: 'shipping', label: 'Entrega de última milla por paquete', value: '11', kind: 'money' },
      { id: 'returnRate', label: 'Tasa de devoluciones', value: '5', kind: 'percent', step: '0.1' },
      { id: 'returnHandling', label: 'Gestión de cada devolución', value: '15', kind: 'money' },
    ],
  },
  {
    title: 'Su rentabilidad',
    icon: gicon.margin,
    note: 'Introduzca su margen bruto por pedido y el modelo abre el resultado de explotación de los dos años y su GMV de equilibrio. El montaje de la tienda y la marca registrada se amortizan a lo largo del periodo que fije abajo; los depósitos recuperables no pasan nunca por la cuenta de resultados.',
    fields: [
      { id: 'grossMargin', label: 'Margen bruto por pedido', value: '75', kind: 'percent' },
      { id: 'amortYears', label: 'Periodo de amortización del alta', value: '3', kind: 'number', step: '1', suffix: 'años', hint: 'El montaje de la tienda y el registro de marca se amortizan en partes iguales durante estos años. Tres es lo habitual.' },
    ],
  },
];

const steps = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 11h18M7 15h4"/></svg>`,
    title: 'Usted financia',
    body: 'Depósitos de plataforma y de almacén, registro de marca, contenidos de lanzamiento. El dinero de una sola vez que pone la tienda en pie.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>`,
    title: 'El TP opera',
    body: 'Un socio operador (TP) aporta el equipo y lleva la tienda de JD Worldwide en el día a día, con un retainer mensual fijo más una comisión sobre las ventas.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 15z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
    title: 'El tráfico vende',
    body: 'La búsqueda de pago y el display (JD 快车) llenan la tienda. Encima, el livestream y los KOL mueven volumen a comisión.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 2 5-6"/></svg>`,
    title: 'Usted mide',
    body: 'La calculadora suma todas las partidas, separa el alta del coste corriente y señala lo que recupera al salir.',
  },
];

const perks = [
  'El año 1 y el año 2, cara a cara',
  'La factura completa, en RMB y en USD',
  'Depósito y comisión según categoría',
  'Depósitos recuperables frente al gasto real',
  'El GMV de equilibrio a partir de su margen',
];

// Plain-English explanation for every field, shown in the overlay bubble.
const help: Record<string, string> = {
  gmv: 'El GMV (Gross Merchandise Value) es la venta total que espera facturar la tienda de JD Worldwide en sus doce primeros meses, antes de descontar coste alguno. Es la cifra de arriba de la que cuelga todo el modelo. Si no lo tiene claro, empiece por un objetivo prudente y súbalo cuando la tienda demuestre que aguanta.',
  aov: 'Lo que gasta de media un comprador en un solo pedido. Divida la venta prevista del primer año entre el número de pedidos y ahí lo tiene. De este número dependen los paquetes que envía y, con ellos, la preparación, el transporte y las devoluciones.',
  paidShare:
    'La parte de sus ventas que empuja la publicidad de pago, las herramientas de búsqueda y display de JD (JD 快车), y no el alcance orgánico ni un creador. Si sube el porcentaje, gasta más en anuncios para llegar a la misma cifra de venta.',
  dpRetainer:
    'La cuota mensual fija que le cobra el socio operador (TP) por llevar la tienda: el escaparate, el calendario de campañas, la operativa publicitaria, la atención al cliente. Suele ser la mayor partida fija de todas. Una marca internacional seria paga en torno a 35.000 RMB al mes, más si el montaje es pesado.',
  dpCommission:
    'Un porcentaje que el socio se lleva sobre la venta que genera, además del retainer. El diez por ciento es lo corriente. Va aparte de los medios pagados, que financia usted directamente en la cuenta publicitaria.',
  category:
    'Su categoría de producto en JD Worldwide (京东全球购). Fija dos números que cambian con la categoría: el depósito de garantía y la comisión de plataforma (运营支持服务费). Elija la que más se acerque y los campos de abajo se rellenan solos. Con Personalizado escribe usted los suyos.',
  kolCommission:
    'Lo que se queda un presentador de livestream o un creador de vídeo corto en cada venta que trae. Es comisión pura: solo cobra si vende. La alimentación y el producto de consumo diario se mueven entre el 8 % y el 20 %; la belleza y el lujo pagan más.',
  roas:
    'El ROAS es la venta dividida entre la inversión publicitaria. Un ROAS de 2 significa que cada RMB de anuncios devuelve 2 RMB de venta. La regla que maneja todo el sector en China es 1 dividido entre su margen bruto: con un margen del 50 % necesita un 2 solo para cubrir la economía del producto, y con márgenes finos hace falta más. La búsqueda de pago de JD madura antes que una cuenta social en frío, porque el comprador ya llega con intención. Ponga la cifra que espera promediar durante el primer año.',
  fx: 'Cuántos RMB compra un dólar. Solo afecta a la cifra en USD que aparece al final; todo el cálculo corre en RMB. Pulse el botón de actualizar para traer el tipo de hoy.',
  cbecTax:
    'El impuesto integral cross-border, que en la práctica es un IVA de importación, sobre la mercancía vendida por el modelo de zona franca. Son 13 puntos de IVA aplicados sobre el 70 % del precio de venta, lo que deja un 9,1 % de la venta en mercancía general sin impuesto especial. La cosmética, la perfumería y el alcohol sí lo pagan y suben.',
  cbecTaxPayer:
    'Quién carga con el IVA cross-border. En casi todas las tiendas lo paga el consumidor al pasar por caja, encima del precio de venta, de modo que a usted no le cuesta nada y el modelo lo deja fuera. Si cambia a que lo absorbe la marca, la calculadora se lo descuenta directamente.',
  platformDeposit:
    'Un depósito de garantía recuperable que JD Worldwide retiene mientras la tienda está abierta y devuelve cuando la cierra sin incidencias. Va por tramos, se cotiza en dólares y sube con las ventas acumuladas. El tramo de entrada ronda los 5.000 USD en la mayoría de categorías, 2.000 USD en fresco y más en producto de alto valor o farmacia. El selector de categoría fija la cifra de entrada en RMB.',
  techFee:
    'La comisión de plataforma (运营支持服务费) que JD Worldwide se lleva en cada venta, como porcentaje del GMV. Se mueve entre el 2 % y el 6 % según la categoría. No tiene nada que ver con la tasa del 0,9 % por transacción. El selector de categoría la fija por usted.',
  paymentFee:
    'La tasa de servicio por transacción (交易服务费) de cada pedido: un 0,9 % fijo en JD Worldwide, calculado sobre el GMV.',
  annualFee:
    'La cuota anual de uso de la plataforma (平台使用费) que cobra JD Worldwide, venda o no venda. Son unos 1.000 USD, así que el valor por defecto en RMB sale del tipo de cambio. Algunas categorías tienen un periodo de prueba sin cuota, así que confirme el suyo al darse de alta.',
  agentFee:
    'Una cuota anual opcional para un agente aduanero en China continental (境内代理人). En el modelo de zona franca, el despacho suele hacerlo el TP o el propio almacén, así que muchas marcas lo dejan a cero. Ponga una cifra solo si contrata un agente aparte.',
  trademark:
    'El coste, una sola vez, de registrar su marca en China en la clase que corresponda. Hacerlo pronto protege el nombre antes de que otro lo reclame. Unos 8.000 RMB por clase.',
  brandSetup:
    'Lo que cuesta montar la tienda y sus contenidos de lanzamiento: banner, fichas de producto, una sesión de fotos o de vídeo. Se paga una vez, al principio.',
  coFund:
    'Un fondo conjunto anual que se añade al retainer del TP y se reserva para los momentos grandes: el Doble 11, el lanzamiento de la marca, una campaña insignia. Paga el trabajo que queda fuera del día a día que ya cubre el retainer.',
  kolShare:
    'La parte de la venta total que pasa por creadores (livestream y vídeo corto) en lugar de por su propia ficha de tienda o la búsqueda de pago. De ahí sale la comisión de KOL que acaba pagando.',
  organicShare:
    'La venta que llega sin anuncios de pago ni comisión de creador detrás: su ficha de tienda, la búsqueda, los seguidores, los clientes que repiten. Es lo que queda después de los medios pagados y los KOL. Que esta parte suba es lo que abarata el año 2 frente al año 1.',
  gmvGrowth:
    'Cuánto más vende la tienda en el año 2 que en el año 1. Una tienda que sobrevive a su primer año suele acumular: tiene reseñas, seguidores y compradores que repiten, y su peso en el buscador de JD mejora. Un 50 % es una hipótesis razonable para una tienda que ha encontrado su sitio; ponga cero para simular una repetición plana del año 1. Todo coste ligado a la venta escala con este número en la columna del año 2.',
  paidShare2:
    'La parte de la venta del año 2 que empujan los anuncios de pago. A esas alturas la tienda ya tiene historial, reseñas y comunidad, así que muchas marcas mantienen o recortan esta partida mientras lo orgánico coge el relevo.',
  kolShare2:
    'La parte de la venta del año 2 que pasa por creadores. Casi todas las marcas siguen trabajando con livestream y KOL, aunque con menos peso, a medida que la ficha de tienda y los clientes que repiten empiezan a vender solos.',
  organicShare2:
    'La parte del año 2 que llega sin inversión publicitaria ni comisión de creador: ficha de tienda, buscador de JD, seguidores, clientes que repiten. Este es el número que debería subir y la razón principal de que el año 2 salga más barato que el año 1.',
  period:
    'El modelo se construye sobre un contrato de doce meses. El objetivo de GMV, el retainer del TP, la cuota de uso de la plataforma y el fondo de campañas cubren un año completo, y el año 2 de los resultados muestra esos mismos doce meses sin el alta inicial. Está aquí para que la hipótesis quede a la vista; no se puede tocar.',
  whDeposit:
    'Un depósito recuperable que el almacén en zona franca retiene como fondo de maniobra mientras guarda su mercancía. Lo recupera al salir, así que no es dinero perdido.',
  whTaxPrepay:
    'Dinero adelantado al almacén en zona franca a cuenta del impuesto de importación que devenga la mercancía al despacharse. Se va consumiendo conforme entran los envíos en China, así que trátelo como dinero que recupera más adelante, no como gasto.',
  storage:
    'Lo que cobra el almacén en zona franca por guardar una unidad durante un mes. Multiplicado por su volumen de pedidos y por una permanencia media de dos meses, sale la factura de almacenaje.',
  fulfillment:
    'El coste de recoger, empaquetar y manipular un pedido dentro del almacén en zona franca, antes de que salga. Va aparte de la entrega de última milla que viene abajo. Multiplíquelo por el número de pedidos y tendrá la factura anual de preparación.',
  shipping:
    'El coste de la entrega de última milla por paquete, del almacén en zona franca a la puerta del comprador. Multiplíquelo por el número de pedidos y tendrá la factura anual de transporte. Se suma a la preparación de pedidos.',
  returnRate:
    'El porcentaje de pedidos que vuelven. En cross-border las devoluciones suelen ser bajas, en torno al cinco por ciento. Cada una tiene un coste de gestión.',
  returnHandling:
    'Lo que cuesta procesar un paquete devuelto: revisarlo y luego reponerlo o destruirlo. Se multiplica por su tasa de devoluciones y por el volumen de pedidos.',
  grossMargin:
    'Su margen bruto en un pedido: lo que queda del precio de venta después del coste del producto, pero antes de los costes de canal de este modelo. El mismo porcentaje se aplica a todos los pedidos. Introdúzcalo y el modelo abre el resultado de explotación de los dos años y su GMV de equilibrio.',
  amortYears:
    'Los años en los que se amortiza el alta. El montaje de la tienda y el registro de marca son costes reales, así que la contabilidad los reparte entre los ejercicios en los que rinden, en vez de cargarle la factura entera al año 1. Tres años es la convención habitual para una inversión así. Los depósitos y el anticipo de impuestos no entran aquí: los recupera, de modo que son fondo de maniobra y no coste.',
};

const notes = [
  'El alta se paga una vez, pero no todo es coste del año 1. El montaje de la tienda y el registro de marca se amortizan durante el periodo que usted fije, así que cada ejercicio carga con su parte y el resultado de explotación no queda aplastado por una factura de la que va a vivir varios años. Los depósitos y el anticipo de impuestos son otra cosa: los recupera al salir, de modo que son fondo de maniobra y no llegan nunca a la cuenta de resultados. Por eso la columna de caja y la de resultado no cuadran entre sí, y las dos tienen razón.',
  'El modelo trabaja solo en cross-border, a través del almacén en zona franca (京东全球购). El depósito del almacén y el anticipo de impuestos vuelven a su bolsillo al salir, así que la calculadora los cuenta como dinero que recupera, no como dinero que gasta.',
  'El retainer del TP más su comisión sobre el GMV es una de las mayores partidas, a la altura de los medios pagados. La publicidad la financia usted directamente en la cuenta de anuncios, no se factura a través del TP. La separación es deliberada: el socio que intenta adelantar la inversión publicitaria acaba cayéndose.',
  'JD Worldwide factura dos conceptos distintos en cada venta: la comisión de plataforma (运营支持服务费), entre el 2 % y el 6 % según categoría, y una tasa fija del 0,9 % por transacción (交易服务费). Los dos están en el modelo. La cuota anual de uso de la plataforma ronda los 1.000 USD y se calcula con el tipo de cambio en vivo.',
  'El depósito de garantía va por tramos, se cotiza en dólares y sube con las ventas acumuladas. La mayoría de categorías arrancan cerca de los 5.000 USD, la alimentación fresca cerca de los 2.000 y la electrónica de alto valor y la farmacia bastante más. El selector de categoría carga el tramo de entrada en RMB. Como es recuperable, queda fuera del cálculo de resultado y cuenta como fondo de maniobra.',
  'El IVA cross-border es el 9,1 % de la venta en mercancía general: 13 puntos de IVA sobre el 70 % del precio. En casi todas las tiendas lo paga el consumidor al pasar por caja, así que por defecto queda fuera de su coste. Cambie el pagador a la marca si lo absorbe usted, y tenga presente que la cosmética, la perfumería y el alcohol suben.',
  'El año 1 suele cerrar en pérdidas con un GMV de 3,5 millones de RMB. La tabla enfrenta el año 1 al año 2, cuando desaparece el alta inicial, el reparto por canal pasa a sus deslizadores del año 2 y el GMV crece según su hipótesis. El GMV de equilibrio le dice a qué escala tiene que llegar para que el margen bruto cubra la factura, y suele quedar varias veces por encima del objetivo del primer año.',
];

const refreshIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>`;

// WO-P3. WebApplication node plus breadcrumb, merged into the site graph by Layout.
const calcSchema = webApplicationSchema({
  url: Astro.url.pathname,
  name: "Calculadora de costes de JD Worldwide",
  description: "Calcule lo que cuesta el primer año de una tienda en JD Worldwide: depósito por tramos y comisión según categoría, la tasa del 0,9 % por transacción, retainer y comisión del TP, almacén en zona franca, transporte y el IVA cross-border, en RMB y en USD.",
  inLanguage: 'es',
  breadcrumb: [
    { name: "Inicio", url: "/es" },
    { name: "Calculadoras", url: "/es/herramientas" },
    { name: "Calculadora de costes de JD Worldwide", url: Astro.url.pathname },
  ],
});
---

<Layout
  schema={calcSchema}
  title="Calculadora de costes de JD Worldwide | TheChinaPath"
  description="Calcule lo que cuesta el primer año de una tienda en JD Worldwide: depósito por tramos y comisión según categoría, la tasa del 0,9 % por transacción, retainer y comisión del TP, almacén en zona franca, transporte y el IVA cross-border, en RMB y en USD."
>
  <section
    class="tool-hero tool-hero--image"
    style="--tool-hero-img: url('/Images/tools/tmall-jd-hero-bg.png')"
  >
    <div class="container tool-hero__inner">
      <nav class="tool-hero__crumbs" aria-label="Ruta de navegación">
        <a href="/es">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/es/herramientas">Calculadoras</a>
        <span aria-hidden="true">/</span>
        <span>JD Worldwide: alta y operación</span>
      </nav>
      <span class="eyebrow">Calculadora de costes</span>
      <h1 class="tool-hero__title">Lo que cuesta <em>de verdad</em> una tienda en JD Worldwide.</h1>
      <p class="tool-hero__lead">
        Simule lo que cuesta operar una tienda en JD Worldwide con un socio operador (TP), en el
        modelo cross-border de zona franca (京东全球购), a lo largo de sus dos primeros años. El
        depósito por tramos y la comisión cambian con su categoría.
      </p>
      <div class="tool-hero__meta">
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">Año 1 + 2</span>
          <span class="tool-hero__meta-label">los dos ejercicios, cara a cara</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">RMB + USD</span>
          <span class="tool-hero__meta-label">la factura completa, en las dos divisas</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">En vivo</span>
          <span class="tool-hero__meta-label">todas las hipótesis las cambia usted</span>
        </div>
      </div>
      <a href="#calculator" class="tool-hero__scroll">
        <span>Empezar a calcular</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
      </a>
    </div>
  </section>

  {/* ---------- How it works ---------- */}
  <section class="section calc-how">
    <div class="container">
      <div class="calc-how__head reveal">
        <span class="eyebrow">Cómo funciona el modelo</span>
        <h2 class="calc-how__title">Cuatro piezas móviles, dos años de coste.</h2>
      </div>
      <ol class="calc-flow">
        {
          steps.map((s, idx) => (
            <li class="calc-flow__step reveal" style={`--i:${idx}`}>
              <span class="calc-flow__icon" set:html={s.icon} />
              <h3 class="calc-flow__step-title">{s.title}</h3>
              <p class="calc-flow__step-body">{s.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="calc-perks reveal">
        <span class="calc-perks__label">Lo que obtiene</span>
        <ul class="calc-perks__list">
          {
            perks.map((p) => (
              <li class="calc-perks__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8" /></svg>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- Calculator ---------- */}
  <section class="section section--alt calc" id="calculator">
    <div class="container">
      <div class="calc__head reveal">
        <span class="eyebrow">La calculadora</span>
        <h2 class="calc__title">Fije sus hipótesis</h2>
      </div>

      <form class="calc-form" id="calc-form" novalidate>
        <div class="calc-shell">
          <div class="calc-main">
            {/* Key drivers as sliders */}
            <div class="calc-card calc-drivers reveal">
              <div class="calc-card__head">
                <h3 class="calc-card__title">Hipótesis principales</h3>
                <span class="calc-card__hint">Los números que más mueven el total.</span>
              </div>
              <div class="calc-drivers__grid">
                {
                  mainDrivers.map((d) => (
                    <div class="driver" data-driver>
                      <div class="driver__top">
                        <span class="calc-label-wrap">
                          <label class="driver__label" for={d.id}>
                            {d.label}
                          </label>
                          {help[d.id] && (
                            <button
                              type="button"
                              class="calc-help__btn"
                              data-help={help[d.id]}
                              aria-label={`¿Qué es ${d.label}?`}
                            >
                              ?
                            </button>
                          )}
                        </span>
                        <span class="driver__value">
                          <input
                            class="driver__num"
                            type="number"
                            id={d.id}
                            name={d.id}
                            value={d.value}
                            data-kind={d.kind}
                            data-label={d.label}
                            step={d.step}
                            min={d.min}
                            max={d.max}
                          />
                          <span class="driver__unit">{d.kind === 'percent' ? '%' : d.kind === 'money' ? 'RMB' : 'x'}</span>
                        </span>
                      </div>
                      <input
                        class="driver__range"
                        type="range"
                        min={d.min}
                        max={d.max}
                        step={d.step}
                        value={d.value}
                        data-target={d.id}
                        aria-hidden="true"
                        tabindex="-1"
                      />
                    </div>
                  ))
                }
              </div>

              {/* Channel mix: paid + KOL + organic, 100% of GMV, one row per year */}
              <div class="driver-group">
                <div class="driver-group__head">
                  <span class="driver-group__title">Reparto por canal</span>
                  <span class="driver-group__sub">De dónde sale la venta, año a año. Cada fila suma el 100 % del GMV.</span>
                </div>
                {
                  mixRows.map((row) => (
                    <div class="driver-group__row">
                      <span class="driver-group__year">{row.title}</span>
                      <div class="driver-group__grid">
                        {row.drivers.map((d) => (
                          <div class="driver driver--share" data-driver>
                            <div class="driver__top">
                              <span class="calc-label-wrap">
                                <label class="driver__label" for={d.id}>
                                  {d.label}
                                </label>
                                {help[d.id] && (
                                  <button
                                    type="button"
                                    class="calc-help__btn"
                                    data-help={help[d.id]}
                                    aria-label={`¿Qué es ${d.label} (${row.title})?`}
                                  >
                                    ?
                                  </button>
                                )}
                              </span>
                              <span class="driver__value">
                                <input
                                  class="driver__num"
                                  type="number"
                                  id={d.id}
                                  name={d.id}
                                  value={d.value}
                                  data-kind={d.kind}
                                  data-label={`${d.label} (${row.title})`}
                                  step={d.step}
                                  min={d.min}
                                  max={d.max}
                                />
                                <span class="driver__unit">%</span>
                              </span>
                            </div>
                            <input
                              class="driver__range"
                              type="range"
                              min={d.min}
                              max={d.max}
                              step={d.step}
                              value={d.value}
                              data-target={d.id}
                              aria-hidden="true"
                              tabindex="-1"
                            />
                          </div>
                        ))}
                      </div>
                      <p class="calc-mix" id={row.noteId} aria-live="polite"></p>
                    </div>
                  ))
                }
              </div>
            </div>

            {/* Advanced inputs, collapsible */}
            <div class="calc-card calc-advanced reveal">
              <button type="button" class="calc-advanced__toggle" id="advanced-toggle" aria-expanded="false" aria-controls="advanced-body">
                <span class="calc-advanced__toggle-text">
                  <span class="calc-advanced__toggle-title">Ajuste cada variable</span>
                  <span class="calc-advanced__toggle-sub">Comisiones, depósitos, logística, impuestos y margen</span>
                </span>
                <span class="calc-advanced__chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                </span>
              </button>
              <div class="calc-advanced__body" id="advanced-body" hidden>
                <div class="calc-advanced__body-inner">
                <div class="calc-tabs" role="tablist" aria-label="Grupos de variables">
                  {
                    groups.map((group, idx) => (
                      <button
                        type="button"
                        class:list={['calc-tab', { 'is-active': idx === 0 }]}
                        role="tab"
                        id={`tab-${idx}`}
                        data-tab={idx}
                        aria-controls={`panel-${idx}`}
                        aria-selected={idx === 0 ? 'true' : 'false'}
                      >
                        <span class="calc-tab__icon" set:html={group.icon} />
                        <span class="calc-tab__label">{group.title}</span>
                      </button>
                    ))
                  }
                </div>
                <div class="calc-tabpanels">
                  {
                    groups.map((group, idx) => (
                      <div
                        class:list={['calc-tabpanel', { 'is-active': idx === 0 }]}
                        id={`panel-${idx}`}
                        data-panel={idx}
                        role="tabpanel"
                        aria-labelledby={`tab-${idx}`}
                        hidden={idx !== 0}
                      >
                        {group.note && <p class="calc-group__note">{group.note}</p>}
                        <div class="calc-tabpanel__fields">
                          {group.fields.map((f) => (
                            <div class="calc-field">
                              <span class="calc-label-wrap">
                                <label class="calc-field__label" for={f.id}>
                                  {f.label}
                                </label>
                                {help[f.id] && (
                                  <button
                                    type="button"
                                    class="calc-help__btn"
                                    data-help={help[f.id]}
                                    aria-label={`¿Qué es ${f.label}?`}
                                  >
                                    ?
                                  </button>
                                )}
                              </span>
                              {f.kind === 'select' ? (
                                <select class="calc-select" id={f.id} name={f.id}>
                                  {(f.options ?? []).map((o) => (
                                    <option
                                      value={o.value}
                                      data-deposit={o.deposit}
                                      data-fee={o.fee}
                                      data-annual={o.annual}
                                      selected={o.value === f.value}
                                    >
                                      {o.label}
                                    </option>
                                  ))}
                                </select>
                              ) : (
                                <div class="calc-input-wrap" data-kind={f.kind}>
                                  {f.kind === 'money' && <span class="calc-input-affix">RMB</span>}
                                  <input
                                    class:list={['calc-input', { 'calc-input--static': f.readonly }]}
                                    type="number"
                                    inputmode="decimal"
                                    id={f.id}
                                    name={f.id}
                                    value={f.value}
                                    data-kind={f.kind}
                                    data-label={f.label}
                                    step={f.step ?? '1'}
                                    min="0"
                                    placeholder={f.kind === 'percent' ? '%' : ''}
                                    readonly={f.readonly}
                                    tabindex={f.readonly ? '-1' : undefined}
                                    aria-readonly={f.readonly ? 'true' : undefined}
                                  />
                                  {f.kind === 'percent' && <span class="calc-input-affix calc-input-affix--suffix">%</span>}
                                  {f.suffix && <span class="calc-input-affix calc-input-affix--suffix">{f.suffix}</span>}
                                </div>
                              )}
                              {f.fx && (
                                <button type="button" class="calc-fx-link" id="fx-refresh">
                                  <span class="calc-fx-link__icon" set:html={refreshIcon} />
                                  Actualizar el tipo de cambio
                                </button>
                              )}
                              {f.id === 'category' && (
                                <div class="calc-impact" id="category-impact" aria-live="polite" hidden>
                                  <span class="calc-impact__label">Actualiza estos campos</span>
                                  <span class="calc-impact__chips">
                                    <span class="calc-impact__chip">
                                      Depósito
                                      <strong id="impact-deposit"></strong>
                                    </span>
                                    <span class="calc-impact__chip">
                                      Comisión
                                      <strong id="impact-fee"></strong>
                                    </span>
                                    <span class="calc-impact__chip">
                                      Cuota anual
                                      <strong id="impact-annual"></strong>
                                    </span>
                                  </span>
                                </div>
                              )}
                              {f.hint && <p class="calc-field__hint">{f.hint}</p>}
                              {f.fx && <p class="calc-field__hint" id="fx-note"></p>}
                            </div>
                          ))}
                        </div>
                      </div>
                    ))
                  }
                </div>
                </div>
              </div>
            </div>
          </div>

          {/* Sticky live preview rail */}
          <aside class="calc-rail reveal">
            <div class="calc-preview">
              <div class="calc-preview__glow" aria-hidden="true"></div>
              <span class="calc-preview__eyebrow">Vista en vivo</span>
              <div class="calc-preview__orders">
                <span class="calc-preview__orders-num" id="live-orders" data-pulse>20.000</span>
                <span class="calc-preview__orders-label">pedidos al año con sus datos</span>
              </div>

              <div class="calc-preview__locked">
                <div class="calc-preview__locked-row">
                  <span>Coste total del año 1</span>
                  <span class="calc-preview__blur">RMB 0.000.000</span>
                </div>
                <div class="calc-preview__locked-row">
                  <span>Caja realmente gastada</span>
                  <span class="calc-preview__blur">RMB 0.000.000</span>
                </div>
                <div class="calc-preview__locked-row">
                  <span>Coste por pedido</span>
                  <span class="calc-preview__blur">RMB 000</span>
                </div>
                <div class="calc-preview__lock" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                </div>
              </div>

              <button type="submit" class="btn btn--primary calc-preview__cta" id="calc-submit">
                Ver el desglose completo
              </button>
              <p class="calc-preview__note">
                Con un correo profesional abre aquí mismo el desglose completo. Y lo exporta a PDF
                cuando termine.
              </p>
            </div>
          </aside>
        </div>
      </form>

      {/* ---------- Results, hidden until the email gate is cleared ---------- */}
      <div class="calc-results" id="calc-results" hidden>
        {/* Print-only header: brand mark on the exported PDF */}
        <div class="calc-print calc-print__head" aria-hidden="true">
          <img src="/Images/thechinapath-horizontal.png" alt="TheChinaPath" class="calc-print__logo" />
          <div class="calc-print__meta">
            <span>Estimación de costes de una tienda en JD Worldwide</span>
            <span>thechinapath.com · hello@thechinapath.com</span>
          </div>
        </div>

        <div class="calc-results__head reveal">
          <div class="calc-results__head-text">
            <span class="eyebrow">Su estimación</span>
            <h2 class="calc-results__title">Desglose de costes del año 1 y del año 2</h2>
            <p class="calc-results__sub" id="calc-results-sub"></p>
          </div>
          <button type="button" class="btn btn--secondary btn--sm calc-results__pdf" id="calc-pdf" data-export-pdf>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M8 11l4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
            Exportar a PDF
          </button>
        </div>

        <div class="calc-scenario reveal">
          <div class="calc-view-toolbar">
            <div class="calc-period__tabs" role="tablist" aria-label="Año">
              <button type="button" class="calc-period__tab is-active" data-year="1" role="tab" aria-selected="true">Año 1</button>
              <button type="button" class="calc-period__tab" data-year="2" role="tab" aria-selected="false">Año 2</button>
            </div>
          </div>

          <div class="calc-focus">
            <div class="calc-focus__hero">
              <span class="calc-focus__hero-label" id="focus-hero-label">Coste total del año 1</span>
              <span class="calc-focus__hero-num" id="focus-total">RMB 0</span>
              <span class="calc-focus__hero-usd" id="focus-usd">$0</span>
            </div>
            <div class="calc-focus__stats">
              <div class="calc-stat calc-stat--pl" id="focus-pl1-wrap">
                <span class="calc-stat__label" id="focus-pl1-label">Resultado de explotación</span>
                <span class="calc-stat__value" id="focus-pl1">Falta el margen</span>
                <span class="calc-stat__foot" id="focus-pl1-foot">con su margen bruto, sin contar el alta</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Margen neto de canal</span>
                <span class="calc-stat__value" id="focus-ncm">RMB 0</span>
                <span class="calc-stat__foot" id="focus-ncm-foot">GMV menos coste corriente, antes del coste de producto</span>
              </div>
              <div class="calc-stat calc-stat--capex" id="focus-capex-wrap">
                <span class="calc-stat__label">Amortización del alta</span>
                <span class="calc-stat__value" id="focus-capex">RMB 0</span>
                <span class="calc-stat__foot" id="focus-capex-foot">la parte del alta que carga este año</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Caja realmente gastada</span>
                <span class="calc-stat__value" id="focus-sunk">RMB 0</span>
                <span class="calc-stat__foot" id="focus-sunk-foot">descontados los depósitos recuperables</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Coste por pedido</span>
                <span class="calc-stat__value" id="focus-cpo">RMB 0</span>
                <span class="calc-stat__foot" id="focus-cpo-foot">frente a su ticket medio</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Coste sobre el GMV</span>
                <span class="calc-stat__value" id="focus-pct">0%</span>
                <span class="calc-stat__foot">el gasto frente a los ingresos</span>
              </div>
              <div class="calc-stat" id="focus-be-wrap">
                <span class="calc-stat__label">GMV de equilibrio</span>
                <span class="calc-stat__value" id="focus-be">Falta el margen</span>
                <span class="calc-stat__foot" id="focus-be-foot">para cubrir el año entero</span>
              </div>
            </div>
          </div>

          {/* Animated cost composition */}
          <div class="calc-compo" id="calc-compo">
            <div class="calc-compo__head">
              <div class="calc-compo__head-text">
                <h3 class="calc-compo__title">Adónde va el dinero</h3>
                <p class="calc-compo__sub" id="compo-sub">Su coste del primer año, de mayor a menor.</p>
                <div class="calc-period__tabs calc-period__tabs--sm" role="tablist" aria-label="Año">
                  <button type="button" class="calc-period__tab is-active" data-year="1" role="tab" aria-selected="true">Año 1</button>
                  <button type="button" class="calc-period__tab" data-year="2" role="tab" aria-selected="false">Año 2</button>
