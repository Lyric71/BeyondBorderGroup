---
import Layout from '../../../layouts/Layout.astro';

// ---- Key drivers, shown as sliders at the top of the calculator ----
type Driver = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number';
  min: string;
  max: string;
  step: string;
  hint?: string;
};

const drivers: Driver[] = [
  { id: 'gmv', label: 'GMV objetivo del año 1', value: '3500000', kind: 'money', min: '200000', max: '10000000', step: '100000' },
  { id: 'aov', label: 'Ticket medio', value: '250', kind: 'money', min: '20', max: '2000', step: '5' },
  { id: 'gmvGrowth', label: 'Crecimiento del GMV en el año 2', value: '50', kind: 'percent', min: '0', max: '200', step: '5' },
  { id: 'dpRetainer', label: 'Retainer mensual del TP', value: '35000', kind: 'money', min: '0', max: '200000', step: '5000' },
  { id: 'coFund', label: 'Fondo conjunto de campañas', value: '0', kind: 'money', min: '0', max: '500000', step: '10000' },
  { id: 'dpCommission', label: 'Comisión del TP sobre el GMV', value: '10', kind: 'percent', min: '0', max: '20', step: '0.5' },
  { id: 'paidShare', label: 'Publicidad de pago', value: '60', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolShare', label: 'KOL y livestream', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'organicShare', label: 'Orgánico', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolCommission', label: 'Comisión de los KOL', value: '20', kind: 'percent', min: '0', max: '40', step: '1' },
  { id: 'roas', label: 'ROAS (retorno de la inversión publicitaria)', value: '2', kind: 'number', min: '0.5', max: '8', step: '0.1' },
];

// The three channel shares are grouped together and must always total 100%.
const shareIds = ['paidShare', 'kolShare', 'organicShare'];
const mainDrivers = drivers.filter((d) => !shareIds.includes(d.id));
const shareDrivers = drivers.filter((d) => shareIds.includes(d.id));

// Year 2 carries its own mix: organic normally climbs once the flagship has
// reviews and repeat buyers, which is what makes the second year cheaper to run.
const shareDrivers2: Driver[] = [
  { id: 'paidShare2', label: 'Publicidad de pago', value: '50', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolShare2', label: 'KOL y livestream', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'organicShare2', label: 'Orgánico', value: '30', kind: 'percent', min: '0', max: '100', step: '1' },
];
const mixRows = [
  { year: '1', title: 'Año 1', drivers: shareDrivers, noteId: 'mix-note' },
  { year: '2', title: 'Año 2', drivers: shareDrivers2, noteId: 'mix-note-2' },
];

// ---- Advanced inputs, grouped in the collapsible section ----
type Field = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number' | 'select';
  step?: string;
  hint?: string;
  fx?: boolean;
  readonly?: boolean;
  suffix?: string;
  options?: { value: string; label: string; deposit?: string; fee?: string; annual?: string }[];
};

// Tmall Global (天猫国际) categories. Each one sets three numbers that move with
// the product category: the security deposit (保证金), the platform commission
// (技术服务费, capped at 5%) and the annual software service fee (软件服务年费,
// 30k or 60k). Directional 2025 bands from the published 招商 standards; the
// exact rate is confirmed at onboarding. A TM trademark or a 专营店 raises the
// deposit above the R-flagship 50k baseline shown here.
const categories: { value: string; label: string; deposit: string; fee: string; annual: string }[] = [
  { value: 'food', label: 'Alimentación envasada, cereales, aceites y snacks', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'tea', label: 'Té y bebidas en polvo', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'alcohol', label: 'Bebidas alcohólicas', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'supplements', label: 'Complementos alimenticios (categoría especial)', deposit: '300000', fee: '3', annual: '30000' },
  { value: 'baby', label: 'Madre, bebé y leche infantil', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'skincare', label: 'Cuidado de la piel', deposit: '50000', fee: '4', annual: '30000' },
  { value: 'makeup', label: 'Maquillaje y perfumería', deposit: '50000', fee: '4', annual: '30000' },
  { value: 'personal-care', label: 'Higiene personal y limpieza', deposit: '50000', fee: '2.5', annual: '60000' },
  { value: 'apparel', label: 'Moda y confección', deposit: '50000', fee: '5', annual: '60000' },
  { value: 'footwear', label: 'Calzado', deposit: '50000', fee: '5', annual: '60000' },
  { value: 'bags', label: 'Bolsos y maletas', deposit: '50000', fee: '5', annual: '60000' },
  { value: 'jewellery', label: 'Bisutería y complementos', deposit: '50000', fee: '5', annual: '60000' },
  { value: 'watches', label: 'Relojería', deposit: '50000', fee: '2', annual: '60000' },
  { value: '3c', label: 'Electrónica de consumo y accesorios (3C)', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'phones', label: 'Móviles, portátiles y tabletas', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'home', label: 'Hogar, textil y menaje', deposit: '50000', fee: '5', annual: '30000' },
  { value: 'appliances', label: 'Pequeño electrodoméstico', deposit: '50000', fee: '2', annual: '30000' },
  { value: 'sports', label: 'Deporte y aire libre', deposit: '50000', fee: '5', annual: '60000' },
  { value: 'pet', label: 'Alimentación y accesorios para mascotas', deposit: '50000', fee: '5', annual: '30000' },
  { value: 'custom', label: 'Personalizado (fije a mano el depósito, la comisión y la cuota anual)', deposit: '', fee: '', annual: '' },
];

const gicon = {
  tax: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  platform: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 18v3"/></svg>`,
  kol: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 15z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
  logistics: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h12v9H2z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>`,
  media: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4a1 1 0 0 0 1 1h2l9 5V4L6 9H4a1 1 0 0 0-1 1z"/><path d="M18 9a4 4 0 0 1 0 6"/></svg>`,
  margin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l3-4 3 2 4-6"/></svg>`,
};

const groups: { title: string; icon: string; note?: string; fields: Field[] }[] = [
  {
    title: 'Categoría',
    icon: gicon.platform,
    note: 'Elija su categoría de producto. En Tmall Global el depósito, la comisión de la plataforma y la cuota anual dependen de la categoría, así que esta selección rellena esas tres cifras. Si su TP le cotiza otra cosa, sobrescriba los campos a mano.',
    fields: [
      {
        id: 'category',
        label: 'Categoría de producto (天猫国际)',
        value: 'food',
        kind: 'select',
        options: categories,
      },
    ],
  },
  {
    title: 'Divisa e impuestos',
    icon: gicon.tax,
    fields: [
      { id: 'fx', label: 'Tipo de cambio USD / RMB', value: '7.1', kind: 'number', step: '0.01', fx: true },
      { id: 'cbecTax', label: 'IVA cross-border (综合税)', value: '9.1', kind: 'percent', step: '0.1', hint: 'Un 13 % de IVA sobre el 70 % del precio de venta, o sea un 9,1 % para la mercancía general. La cosmética, la perfumería y el alcohol pagan además impuesto de consumo y suben.' },
      { id: 'cbecTaxPayer', label: 'Quién asume el IVA', value: 'consumer', kind: 'select', options: [ { value: 'consumer', label: 'Lo paga el consumidor, sobre el precio' }, { value: 'brand', label: 'Lo absorbe la marca' } ] },
    ],
  },
  {
    title: 'Plataforma y TP',
    icon: gicon.platform,
    fields: [
      { id: 'period', label: 'Duración del contrato', value: '12', kind: 'number', readonly: true, suffix: 'meses', hint: 'Fija. El modelo valora un ejercicio completo de doce meses y todas las cifras anuales se ajustan a esa ventana.' },
      { id: 'platformDeposit', label: 'Depósito de garantía de Tmall Global', value: '50000', kind: 'money', hint: 'Se devuelve si cierra la tienda sin incidencias. Lo fija la categoría elegida arriba; una marca TM o una 专营店 lo elevan.' },
      { id: 'techFee', label: 'Comisión de plataforma (技术服务费)', value: '2', kind: 'percent', step: '0.1', hint: 'Se cobra en cada venta, con un tope del 5 %. La fija la categoría elegida arriba.' },
      { id: 'paymentFee', label: 'Comisión de pago (Alipay)', value: '1', kind: 'percent', step: '0.1', hint: 'Comisión de la pasarela de pago en cada pedido, en torno al 1 % con Alipay.' },
      { id: 'annualFee', label: 'Cuota anual de servicio de software (软件服务年费)', value: '30000', kind: 'money', hint: '30.000 o 60.000 al año según la categoría de primer nivel. La fija la categoría elegida arriba.' },
      { id: 'agentFee', label: 'Agente de aduanas, anual', value: '0', kind: 'money', hint: 'Opcional. Muchas marcas dejan el despacho en manos del TP o del almacén, así que déjelo a cero salvo que contrate un 境内代理人 aparte.' },
      { id: 'trademark', label: 'Registro de marca en China', value: '0', kind: 'money' },
      { id: 'brandSetup', label: 'Montaje de la tienda y contenidos de lanzamiento', value: '25000', kind: 'money' },
    ],
  },
  {
    title: 'Logística',
    icon: gicon.logistics,
    fields: [
      { id: 'whDeposit', label: 'Depósito del almacén en zona franca', value: '100000', kind: 'money' },
      { id: 'whTaxPrepay', label: 'Anticipo de impuestos al almacén', value: '300000', kind: 'money' },
      { id: 'storage', label: 'Almacenaje por unidad y mes', value: '0.8', kind: 'number', step: '0.1' },
      { id: 'fulfillment', label: 'Preparación por pedido (picking y packing)', value: '4', kind: 'money', step: '0.5' },
      { id: 'shipping', label: 'Última milla por paquete', value: '11', kind: 'money' },
      { id: 'returnRate', label: 'Tasa de devoluciones', value: '5', kind: 'percent', step: '0.1' },
      { id: 'returnHandling', label: 'Gestión de cada devolución', value: '15', kind: 'money' },
    ],
  },
  {
    title: 'Sus márgenes',
    icon: gicon.margin,
    note: 'Indique su margen bruto por pedido y la calculadora abre el resultado operativo de los dos años y su GMV de equilibrio. El montaje de la tienda y la marca se amortizan a lo largo del periodo que fije abajo; los depósitos reembolsables no pasan nunca por la cuenta de resultados.',
    fields: [
      { id: 'grossMargin', label: 'Margen bruto por pedido', value: '75', kind: 'percent' },
      { id: 'amortYears', label: 'Periodo de amortización del arranque', value: '3', kind: 'number', step: '1', suffix: 'años', hint: 'El montaje de la tienda y el registro de marca se amortizan en partes iguales durante estos años. Tres es la convención habitual.' },
    ],
  },
];

const steps = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 11h18M7 15h4"/></svg>`,
    title: 'Usted pone el dinero',
    body: 'Depósitos de plataforma y de almacén, registro de marca, contenidos de lanzamiento. El desembolso único que pone la tienda en pie.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>`,
    title: 'El TP opera',
    body: 'Un Tmall Partner (TP) aporta el equipo y lleva la flagship en el día a día, a cambio de un retainer mensual fijo y una comisión sobre las ventas.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 15z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
    title: 'El tráfico vende',
    body: 'La búsqueda de pago y el display llenan la tienda. Encima, el livestream y los KOL mueven volumen a comisión.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 2 5-6"/></svg>`,
    title: 'Usted mide',
    body: 'La calculadora suma todas las partidas, separa el arranque del coste recurrente y señala qué recupera al salir.',
  },
];

const perks = [
  'El año 1 y el año 2, uno al lado del otro',
  'Toda la estructura de costes en RMB y en USD',
  'Depósito y comisión según su categoría',
  'Depósitos reembolsables frente a caja real quemada',
  'GMV de equilibrio a partir de su margen',
];

// Plain-language explanation for every field, shown in the overlay bubble.
const help: Record<string, string> = {
  gmv: 'El GMV (Gross Merchandise Value) son las ventas totales que espera facturar la flagship de Tmall Global en sus primeros doce meses, antes de descontar ningún coste. Es la cifra de partida sobre la que escala todo el modelo. Si duda, empiece por un objetivo prudente y súbalo cuando la tienda demuestre lo que da de sí.',
  aov: 'Lo que gasta de media un comprador en un solo pedido. Divida las ventas previstas del primer año entre el número de pedidos y sale esta cifra. De ella depende cuántos paquetes envía, y con ellos el coste de preparación, transporte y devoluciones.',
  paidShare:
    'La parte de sus ventas que empuja la publicidad de pago, es decir las herramientas de búsqueda y display de Tmall (直通车, 引力魔方), y no el alcance orgánico ni un creador. Cuanto más la suba, más presupuesto tendrá que quemar en anuncios para llegar a la misma cifra de ventas.',
  dpRetainer:
    'La cuota fija mensual que le cobra su TP (Tmall Partner) por llevar la flagship: el escaparate, el calendario de campañas, la operativa publicitaria, la atención al cliente. Suele ser la mayor partida fija de todas. Para una marca internacional seria la cifra habitual ronda los 35.000 RMB al mes, y sube si el montaje es más pesado.',
  dpCommission:
    'Un porcentaje que el TP se lleva sobre las ventas que genera, además del retainer. Un 10 % es lo corriente. No tiene nada que ver con la publicidad de pago, que usted financia directamente en la cuenta de anuncios.',
  category:
    'Su categoría de producto en Tmall Global (天猫国际). Fija tres cifras que varían con ella: el depósito de garantía, la comisión de la plataforma (技术服务费) y la cuota anual de software. Elija la que más se acerque y los campos de abajo se rellenan solos. Con «Personalizado» los escribe usted.',
  kolCommission:
    'La tajada que se queda un presentador de livestream o un creador de vídeo corto por cada venta que consigue. Es comisión pura: solo cobra si vende. En alimentación y producto de consumo diario se mueve entre el 8 % y el 20 %; en belleza y lujo sube.',
  roas:
    'El ROAS (Return On Ad Spend) son las ventas divididas entre la inversión publicitaria. Un ROAS de 2 significa que cada RMB de anuncios devuelve 2 RMB de ventas. La regla de equilibrio que maneja todo el sector en China es 1 dividido entre su margen bruto: con un margen del 50 % necesita un 2 solo para cubrir la economía del producto, y las categorías de margen fino piden más. La búsqueda de pago de Tmall madura más deprisa que una cuenta social arrancada en frío, porque el comprador ya llega con intención. Ponga la cifra que espera promediar en el primer año.',
  fx: 'Cuántos RMB compra un dólar. Solo afecta a la cifra en USD que aparece al final: todo el cálculo se hace en RMB. Pulse el botón de actualizar para traer el tipo de cambio del día.',
  cbecTax:
    'El impuesto integral cross-border, en la práctica un IVA de importación sobre la mercancía vendida por el régimen de zona franca. Son 13 % de IVA aplicados sobre el 70 % del precio de venta, lo que deja un 9,1 % sobre las ventas para la mercancía general que no paga impuesto de consumo. La cosmética, la perfumería y el alcohol sí lo pagan y suben.',
  cbecTaxPayer:
    'Quién carga con el IVA cross-border. En casi todas las flagship lo paga el consumidor en caja, encima del precio de venta, así que no le cuesta nada a usted y el modelo lo deja fuera. Si cambia a «Lo absorbe la marca», la calculadora se lo descuenta directamente.',
  platformDeposit:
    'Un depósito de garantía reembolsable que Tmall Global retiene mientras la tienda esté abierta y le devuelve al cerrarla sin incidencias. Para una flagship con marca registrada R la referencia son 50.000 RMB. Una marca TM, una 专营店 o una categoría especial como los complementos alimenticios lo elevan. El selector de categoría pone una cifra orientativa.',
  techFee:
    'La comisión (技术服务费) que Tmall Global se queda en cada venta, como porcentaje del GMV. Va del 0,5 % al 5 % según la categoría, con un tope del 5 %. El selector de categoría la fija por usted.',
  paymentFee:
    'La comisión de la pasarela de pago en cada pedido, calculada sobre el GMV. En Tmall Global la pasarela es Alipay y ronda el 1 %.',
  annualFee:
    'La cuota anual de servicio de software (软件服务年费) que cobra Tmall Global, venda o no venda. Son 30.000 o 60.000 RMB según su categoría de primer nivel. El selector de categoría la fija por usted. Ojo: es una cuota de Tmall Global. El Tmall doméstico suprimió la suya en 2024, pero Tmall Global la mantuvo.',
  agentFee:
    'Una cuota anual opcional para un agente aduanero en China continental (境内代理人). En el modelo de flagship en zona franca, el despacho lo suele llevar el TP o el propio almacén, así que muchas marcas dejan esta casilla a cero. Ponga una cifra solo si contrata un agente aparte.',
  trademark:
    'El coste, por una sola vez, de registrar su marca en China en la clase que corresponda. Hacerlo pronto protege el nombre antes de que otro se lo apropie. Unos 8.000 RMB para una clase.',
  brandSetup:
    'La inversión inicial para montar la tienda y sus contenidos de lanzamiento: banner, fichas de producto, una sesión de foto o vídeo. Se paga una vez, al principio.',
  coFund:
    'Un fondo anual conjunto, aparte del retainer del TP, reservado para los grandes momentos: el 11 del 11, el lanzamiento de la marca, una campaña insignia. Cubre trabajo que queda fuera del día a día que ya paga el retainer.',
  kolShare:
    'El porcentaje de las ventas totales que pasa por creadores (livestream y vídeo corto) en lugar de por su propia ficha de tienda o por la búsqueda de pago. Determina cuánta comisión de KOL acaba pagando.',
  organicShare:
    'Las ventas que llegan sin anuncios de pago ni comisión de creador detrás: su ficha de tienda, la búsqueda, los seguidores, los clientes que repiten. Es lo que queda después de la publicidad de pago y los KOL. Que esta parte suba es lo que abarata el año 2 frente al año 1.',
  gmvGrowth:
    'Cuánto más vende la flagship en el año 2 que en el año 1. La tienda que sobrevive a su primer ejercicio suele componer: acumula reseñas, seguidores y recurrencia, y gana peso en el buscador de Tmall. Un 50 % es una hipótesis de planificación razonable para una tienda que ya ha encontrado su sitio. Póngalo a cero para modelar una repetición plana del año 1. Todo coste ligado a las ventas escala con esta cifra en la columna del año 2.',
  paidShare2:
    'El porcentaje de las ventas del año 2 que empuja la publicidad de pago. A esas alturas la tienda ya tiene historial, reseñas y comunidad, así que muchas marcas mantienen o recortan esta partida mientras lo orgánico toma el relevo.',
  kolShare2:
    'El porcentaje de las ventas del año 2 que pasa por creadores. Casi todas las marcas siguen trabajando el livestream y los KOL, aunque con menos peso, porque la ficha de tienda y los clientes que repiten empiezan a vender solos.',
  organicShare2:
    'La parte del año 2 que entra sin inversión publicitaria ni comisión de creador: ficha de tienda, buscador de Tmall, seguidores, recurrencia. Esta es la cifra que debería subir, y es la razón principal de que el año 2 salga más barato que el año 1.',
  period:
    'El modelo está construido sobre un contrato de doce meses. El objetivo de GMV, el retainer del TP, la cuota anual de la plataforma y el fondo de campañas cubren un ejercicio completo, y el año 2 de los resultados muestra los mismos doce meses sin el desembolso de arranque. Aparece aquí para que la hipótesis quede explícita; no se puede tocar.',
  whDeposit:
    'Un depósito reembolsable que el almacén en zona franca retiene como fondo de maniobra mientras su mercancía esté allí. Lo recupera al salir, así que es dinero recuperable, no dinero perdido.',
  whTaxPrepay:
    'Dinero adelantado al almacén en zona franca a cuenta de los impuestos de importación que devenga la mercancía al despacharse. Se va consumiendo a medida que los envíos entran en China, de modo que tómelo como dinero que vuelve, no como gasto.',
  storage:
    'Lo que cobra el almacén en zona franca por guardar una unidad durante un mes. Multiplicado por su volumen de pedidos y por una permanencia media de dos meses, se convierte en su factura de almacenaje.',
  fulfillment:
    'El coste de recoger, empaquetar y manipular un pedido dentro del almacén en zona franca, antes de que salga. Va aparte de la última milla que viene abajo. Multiplíquelo por el número de pedidos y obtendrá la factura anual de preparación.',
  shipping:
    'El coste de la entrega de última milla por paquete, del almacén en zona franca a la puerta del comprador. Multiplíquelo por el número de pedidos y obtendrá la factura anual de transporte. Se suma a la tarifa de preparación.',
  returnRate:
    'El porcentaje de pedidos que vuelven. En cross-border las devoluciones suelen ser bajas, alrededor de un 5 %. Cada una lleva un coste de gestión.',
  returnHandling:
    'Lo que cuesta procesar un paquete devuelto: inspeccionarlo y luego devolverlo al stock o destruirlo. Se multiplica por su tasa de devoluciones y por el volumen de pedidos.',
  grossMargin:
    'Su margen bruto en un pedido: la parte del precio de venta que queda después del coste del producto, pero antes de los costes de canal que recoge este modelo. El mismo porcentaje se aplica a todos los pedidos. Introdúzcalo y se abren el resultado operativo de los dos años y su GMV de equilibrio.',
  amortYears:
    'Los años en los que se amortiza el desembolso inicial. El montaje de la tienda y el registro de marca son costes reales, así que la contabilidad los reparte entre los ejercicios en los que rinden en vez de cargar la factura entera al año 1. Tres años es la convención habitual para una inversión así. Ni los depósitos ni el anticipo de impuestos entran aquí: como los recupera, son fondo de maniobra y no coste.',
};

const notes = [
  'El arranque se paga una sola vez, pero no todo él es coste del año 1. El montaje de la tienda y el registro de marca se amortizan durante el periodo que usted fije, de modo que cada ejercicio carga con su parte y el resultado operativo no queda aplastado por una factura de la que se beneficiará durante años. Los depósitos y el anticipo de impuestos son otra cosa: los recupera al salir, así que son fondo de maniobra y jamás llegan a la cuenta de resultados. Por eso la columna de caja y la de beneficio no cuadran entre sí, y las dos tienen razón.',
  'El modelo trabaja solo en cross-border, por el almacén en zona franca (天猫国际). El depósito del almacén y el anticipo de impuestos vuelven a su bolsillo cuando cierra, así que la calculadora los cuenta como dinero que recupera, no como dinero que gasta.',
  'El retainer del TP y su comisión sobre el GMV forman, junto con la publicidad de pago, una de las partidas más gruesas. La publicidad la financia usted directamente en la cuenta de anuncios, no se factura a través del TP. La separación es deliberada: los partners que intentan adelantar la inversión publicitaria acaban tropezando.',
  'El TP lleva la flagship. El coste de su equipo va dentro del retainer y de la comisión, así que no hay una línea aparte de plantilla. La comisión de los KOL sí se factura por separado, sobre las ventas que los creadores traen de verdad.',
  'El depósito de garantía, la comisión de la plataforma y la cuota anual dependen de su categoría de producto. Elija una en el panel de ajuste fino y las tres se rellenan con las bandas publicadas de Tmall Global. Una marca TM o una 专营店 elevan el depósito por encima de la cifra que se muestra para la flagship con marca R.',
  'El IVA cross-border equivale al 9,1 % de las ventas para la mercancía general: un 13 % de IVA aplicado sobre el 70 % del precio. En casi todas las flagship lo asume el consumidor en caja, así que por defecto queda fuera de su coste. Cambie el pagador a la marca si lo absorbe usted, y tenga en cuenta que la cosmética, la perfumería y el alcohol pagan más.',
  'Con un GMV de 3,5 millones de RMB, el año 1 suele cerrar en pérdidas. La tabla enfrenta el año 1 al año 2, cuando el desembolso inicial ya no aparece, el mix de canales pasa a los deslizadores del año 2 y el GMV sube según su hipótesis de crecimiento. El GMV de equilibrio indica el tamaño que necesita para que el margen bruto cubra la factura, y suele quedar varias veces por encima del objetivo del primer año.',
];

const refreshIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>`;
---

<Layout
  title="Calculadora de costes de Tmall Global | TheChinaPath"
  description="Calcule lo que cuesta el primer año de una flagship en Tmall Global: depósito, cuota anual y comisión según categoría, retainer y comisión del TP, almacén en zona franca, transporte y el IVA cross-border, en RMB y en USD."
>
  <section
    class="tool-hero tool-hero--image"
    style="--tool-hero-img: url('/Images/tools/tmall-jd-hero-bg.png')"
  >
    <div class="container tool-hero__inner">
      <nav class="tool-hero__crumbs" aria-label="Migas de pan">
        <a href="/es">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/es/herramientas">Calculadoras</a>
        <span aria-hidden="true">/</span>
        <span>Tmall Global: alta y operación</span>
      </nav>
      <span class="eyebrow">Calculadora de costes</span>
      <h1 class="tool-hero__title">Lo que cuesta <em>de verdad</em> una flagship en Tmall Global.</h1>
      <p class="tool-hero__lead">
        Modele lo que cuesta operar una flagship de Tmall Global a través de un Tmall Partner (TP),
        con el régimen cross-border en zona franca (天猫国际), a lo largo de sus dos primeros años.
        El depósito, la comisión y la cuota anual dependen de su categoría.
      </p>
      <div class="tool-hero__meta">
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">Años 1 y 2</span>
          <span class="tool-hero__meta-label">la estructura de costes, en paralelo</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">RMB + USD</span>
          <span class="tool-hero__meta-label">todo el coste, en las dos divisas</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">En vivo</span>
          <span class="tool-hero__meta-label">cada hipótesis la cambia usted</span>
        </div>
      </div>
      <a href="#calculator" class="tool-hero__scroll">
        <span>Empezar a calcular</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
      </a>
    </div>
  </section>

  {/* ---------- How it works ---------- */}
  <section class="section calc-how">
    <div class="container">
      <div class="calc-how__head reveal">
        <span class="eyebrow">Cómo funciona el modelo</span>
        <h2 class="calc-how__title">Cuatro piezas móviles, dos años de coste.</h2>
      </div>
      <ol class="calc-flow">
        {
          steps.map((s, idx) => (
            <li class="calc-flow__step reveal" style={`--i:${idx}`}>
              <span class="calc-flow__icon" set:html={s.icon} />
              <h3 class="calc-flow__step-title">{s.title}</h3>
              <p class="calc-flow__step-body">{s.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="calc-perks reveal">
        <span class="calc-perks__label">Lo que obtiene</span>
        <ul class="calc-perks__list">
          {
            perks.map((p) => (
              <li class="calc-perks__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8" /></svg>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- Calculator ---------- */}
  <section class="section section--alt calc" id="calculator">
    <div class="container">
      <div class="calc__head reveal">
        <span class="eyebrow">La calculadora</span>
        <h2 class="calc__title">Fije sus hipótesis</h2>
      </div>

      <form class="calc-form" id="calc-form" novalidate>
        <div class="calc-shell">
          <div class="calc-main">
            {/* Key drivers as sliders */}
            <div class="calc-card calc-drivers reveal">
              <div class="calc-card__head">
                <h3 class="calc-card__title">Hipótesis clave</h3>
                <span class="calc-card__hint">Las cifras que más mueven el total.</span>
              </div>
              <div class="calc-drivers__grid">
                {
                  mainDrivers.map((d) => (
                    <div class="driver" data-driver>
                      <div class="driver__top">
                        <span class="calc-label-wrap">
                          <label class="driver__label" for={d.id}>
                            {d.label}
                          </label>
                          {help[d.id] && (
                            <button
                              type="button"
                              class="calc-help__btn"
                              data-help={help[d.id]}
                              aria-label={`¿Qué es ${d.label}?`}
                            >
                              ?
                            </button>
                          )}
                        </span>
                        <span class="driver__value">
                          <input
                            class="driver__num"
                            type="number"
                            id={d.id}
                            name={d.id}
                            value={d.value}
                            data-kind={d.kind}
                            data-label={d.label}
                            step={d.step}
                            min={d.min}
                            max={d.max}
                          />
                          <span class="driver__unit">{d.kind === 'percent' ? '%' : d.kind === 'money' ? 'RMB' : 'x'}</span>
                        </span>
                      </div>
                      <input
                        class="driver__range"
                        type="range"
                        min={d.min}
                        max={d.max}
                        step={d.step}
                        value={d.value}
                        data-target={d.id}
                        aria-hidden="true"
                        tabindex="-1"
                      />
                    </div>
                  ))
                }
              </div>

              {/* Channel mix: paid + KOL + organic, 100% of GMV, one row per year */}
              <div class="driver-group">
                <div class="driver-group__head">
                  <span class="driver-group__title">Mix de canales</span>
                  <span class="driver-group__sub">De dónde salen las ventas, año a año. Cada fila suma el 100 % del GMV.</span>
                </div>
                {
                  mixRows.map((row) => (
                    <div class="driver-group__row">
                      <span class="driver-group__year">{row.title}</span>
                      <div class="driver-group__grid">
                        {row.drivers.map((d) => (
                          <div class="driver driver--share" data-driver>
                            <div class="driver__top">
                              <span class="calc-label-wrap">
                                <label class="driver__label" for={d.id}>
                                  {d.label}
                                </label>
                                {help[d.id] && (
                                  <button
                                    type="button"
                                    class="calc-help__btn"
                                    data-help={help[d.id]}
                                    aria-label={`¿Qué es ${d.label} (${row.title})?`}
                                  >
                                    ?
                                  </button>
                                )}
                              </span>
                              <span class="driver__value">
                                <input
                                  class="driver__num"
                                  type="number"
                                  id={d.id}
                                  name={d.id}
                                  value={d.value}
                                  data-kind={d.kind}
                                  data-label={`${d.label} (${row.title})`}
                                  step={d.step}
                                  min={d.min}
                                  max={d.max}
                                />
                                <span class="driver__unit">%</span>
                              </span>
                            </div>
                            <input
                              class="driver__range"
                              type="range"
                              min={d.min}
                              max={d.max}
                              step={d.step}
                              value={d.value}
                              data-target={d.id}
                              aria-hidden="true"
                              tabindex="-1"
                            />
                          </div>
                        ))}
                      </div>
                      <p class="calc-mix" id={row.noteId} aria-live="polite"></p>
                    </div>
                  ))
                }
              </div>
            </div>

            {/* Advanced inputs, collapsible */}
            <div class="calc-card calc-advanced reveal">
              <button type="button" class="calc-advanced__toggle" id="advanced-toggle" aria-expanded="false" aria-controls="advanced-body">
                <span class="calc-advanced__toggle-text">
                  <span class="calc-advanced__toggle-title">Ajuste fino de cada dato</span>
                  <span class="calc-advanced__toggle-sub">Comisiones, depósitos, logística, impuestos y margen</span>
                </span>
                <span class="calc-advanced__chevron" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                </span>
              </button>
              <div class="calc-advanced__body" id="advanced-body" hidden>
                <div class="calc-advanced__body-inner">
                <div class="calc-tabs" role="tablist" aria-label="Grupos de datos">
                  {
                    groups.map((group, idx) => (
                      <button
                        type="button"
                        class:list={['calc-tab', { 'is-active': idx === 0 }]}
                        role="tab"
                        id={`tab-${idx}`}
                        data-tab={idx}
                        aria-controls={`panel-${idx}`}
                        aria-selected={idx === 0 ? 'true' : 'false'}
                      >
                        <span class="calc-tab__icon" set:html={group.icon} />
                        <span class="calc-tab__label">{group.title}</span>
                      </button>
                    ))
                  }
                </div>
                <div class="calc-tabpanels">
                  {
                    groups.map((group, idx) => (
                      <div
                        class:list={['calc-tabpanel', { 'is-active': idx === 0 }]}
                        id={`panel-${idx}`}
                        data-panel={idx}
                        role="tabpanel"
                        aria-labelledby={`tab-${idx}`}
                        hidden={idx !== 0}
                      >
                        {group.note && <p class="calc-group__note">{group.note}</p>}
                        <div class="calc-tabpanel__fields">
                          {group.fields.map((f) => (
                            <div class="calc-field">
                              <span class="calc-label-wrap">
                                <label class="calc-field__label" for={f.id}>
                                  {f.label}
                                </label>
                                {help[f.id] && (
                                  <button
                                    type="button"
                                    class="calc-help__btn"
                                    data-help={help[f.id]}
                                    aria-label={`¿Qué es ${f.label}?`}
                                  >
                                    ?
                                  </button>
                                )}
                              </span>
                              {f.kind === 'select' ? (
                                <select class="calc-select" id={f.id} name={f.id}>
                                  {(f.options ?? []).map((o) => (
                                    <option
                                      value={o.value}
                                      data-deposit={o.deposit}
                                      data-fee={o.fee}
                                      data-annual={o.annual}
                                      selected={o.value === f.value}
                                    >
                                      {o.label}
                                    </option>
                                  ))}
                                </select>
                              ) : (
                                <div class="calc-input-wrap" data-kind={f.kind}>
                                  {f.kind === 'money' && <span class="calc-input-affix">RMB</span>}
                                  <input
                                    class:list={['calc-input', { 'calc-input--static': f.readonly }]}
                                    type="number"
                                    inputmode="decimal"
                                    id={f.id}
                                    name={f.id}
                                    value={f.value}
                                    data-kind={f.kind}
                                    data-label={f.label}
                                    step={f.step ?? '1'}
                                    min="0"
                                    placeholder={f.kind === 'percent' ? '%' : ''}
                                    readonly={f.readonly}
                                    tabindex={f.readonly ? '-1' : undefined}
                                    aria-readonly={f.readonly ? 'true' : undefined}
                                  />
                                  {f.kind === 'percent' && <span class="calc-input-affix calc-input-affix--suffix">%</span>}
                                  {f.suffix && <span class="calc-input-affix calc-input-affix--suffix">{f.suffix}</span>}
                                </div>
                              )}
                              {f.fx && (
                                <button type="button" class="calc-fx-link" id="fx-refresh">
                                  <span class="calc-fx-link__icon" set:html={refreshIcon} />
                                  Actualizar el tipo de cambio
                                </button>
                              )}
                              {f.id === 'category' && (
                                <div class="calc-impact" id="category-impact" aria-live="polite" hidden>
                                  <span class="calc-impact__label">Actualiza abajo</span>
                                  <span class="calc-impact__chips">
                                    <span class="calc-impact__chip">
                                      Depósito
                                      <strong id="impact-deposit"></strong>
                                    </span>
                                    <span class="calc-impact__chip">
                                      Comisión
                                      <strong id="impact-fee"></strong>
                                    </span>
                                    <span class="calc-impact__chip">
                                      Cuota anual
                                      <strong id="impact-annual"></strong>
                                    </span>
                                  </span>
                                </div>
                              )}
                              {f.hint && <p class="calc-field__hint">{f.hint}</p>}
                              {f.fx && <p class="calc-field__hint" id="fx-note"></p>}
                            </div>
                          ))}
                        </div>
                      </div>
                    ))
                  }
                </div>
                </div>
              </div>
            </div>
          </div>

          {/* Sticky live preview rail */}
          <aside class="calc-rail reveal">
            <div class="calc-preview">
              <div class="calc-preview__glow" aria-hidden="true"></div>
              <span class="calc-preview__eyebrow">Vista previa en vivo</span>
              <div class="calc-preview__orders">
                <span class="calc-preview__orders-num" id="live-orders" data-pulse>20.000</span>
                <span class="calc-preview__orders-label">pedidos al año con sus datos</span>
              </div>

              <div class="calc-preview__locked">
                <div class="calc-preview__locked-row">
                  <span>Coste total del año 1</span>
                  <span class="calc-preview__blur">RMB 0.000.000</span>
                </div>
                <div class="calc-preview__locked-row">
                  <span>Caja realmente gastada</span>
                  <span class="calc-preview__blur">RMB 0.000.000</span>
                </div>
                <div class="calc-preview__locked-row">
                  <span>Coste por pedido</span>
                  <span class="calc-preview__blur">RMB 000</span>
                </div>
                <div class="calc-preview__lock" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                </div>
              </div>

              <button type="submit" class="btn btn--primary calc-preview__cta" id="calc-submit">
                Ver el desglose completo
              </button>
              <p class="calc-preview__note">
                Con un correo profesional se abre aquí mismo el desglose completo. Cuando termine,
                expórtelo a PDF.
              </p>
            </div>
          </aside>
        </div>
      </form>

      {/* ---------- Results, hidden until the email gate is cleared ---------- */}
      <div class="calc-results" id="calc-results" hidden>
        {/* Print-only header: brand mark on the exported PDF */}
        <div class="calc-print calc-print__head" aria-hidden="true">
          <img src="/Images/thechinapath-horizontal.png" alt="TheChinaPath" class="calc-print__logo" />
          <div class="calc-print__meta">
            <span>Estimación de coste de una flagship en Tmall Global</span>
            <span>thechinapath.com · hello@thechinapath.com</span>
          </div>
        </div>

        <div class="calc-results__head reveal">
          <div class="calc-results__head-text">
            <span class="eyebrow">Su estimación</span>
            <h2 class="calc-results__title">Desglose de costes del año 1 y del año 2</h2>
            <p class="calc-results__sub" id="calc-results-sub"></p>
          </div>
          <button type="button" class="btn btn--secondary btn--sm calc-results__pdf" id="calc-pdf" data-export-pdf>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M8 11l4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
            Exportar a PDF
          </button>
        </div>

        <div class="calc-scenario reveal">
          <div class="calc-view-toolbar">
            <div class="calc-period__tabs" role="tablist" aria-label="Año">
              <button type="button" class="calc-period__tab is-active" data-year="1" role="tab" aria-selected="true">Año 1</button>
              <button type="button" class="calc-period__tab" data-year="2" role="tab" aria-selected="false">Año 2</button>
            </div>
          </div>

          <div class="calc-focus">
            <div class="calc-focus__hero">
              <span class="calc-focus__hero-label" id="focus-hero-label">Coste total del año 1</span>
              <span class="calc-focus__hero-num" id="focus-total">RMB 0</span>
              <span class="calc-focus__hero-usd" id="focus-usd">$0</span>
            </div>
            <div class="calc-focus__stats">
              <div class="calc-stat calc-stat--pl" id="focus-pl1-wrap">
                <span class="calc-stat__label" id="focus-pl1-label">Resultado operativo</span>
                <span class="calc-stat__value" id="focus-pl1">Añada su margen</span>
                <span class="calc-stat__foot" id="focus-pl1-foot">con su margen bruto, sin contar el arranque</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Margen neto de canal</span>
                <span class="calc-stat__value" id="focus-ncm">RMB 0</span>
                <span class="calc-stat__foot" id="focus-ncm-foot">GMV menos costes recurrentes, antes del coste de producto</span>
              </div>
              <div class="calc-stat calc-stat--capex" id="focus-capex-wrap">
                <span class="calc-stat__label">Amortización del arranque</span>
                <span class="calc-stat__value" id="focus-capex">RMB 0</span>
                <span class="calc-stat__foot" id="focus-capex-foot">la parte del arranque que carga este año</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Caja realmente gastada</span>
                <span class="calc-stat__value" id="focus-sunk">RMB 0</span>
                <span class="calc-stat__foot" id="focus-sunk-foot">descontados los depósitos reembolsables</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Coste por pedido</span>
                <span class="calc-stat__value" id="focus-cpo">RMB 0</span>
                <span class="calc-stat__foot" id="focus-cpo-foot">frente a su ticket medio</span>
              </div>
              <div class="calc-stat">
                <span class="calc-stat__label">Coste sobre el GMV</span>
                <span class="calc-stat__value" id="focus-pct">0%</span>
                <span class="calc-stat__foot">lo que quema frente a lo que ingresa</span>
              </div>
              <div class="calc-stat" id="focus-be-wrap">
                <span class="calc-stat__label">GMV de equilibrio</span>
                <span class="calc-stat__value" id="focus-be">Añada su margen</span>
                <span class="calc-stat__foot" id="focus-be-foot">para cubrir el año entero</span>
              </div>
            </div>
          </div>

          {/* Animated cost composition */}
          <div class="calc-compo" id="calc-compo">
            <div class="calc-compo__head">
              <div class="calc-compo__head-text">
                <h3 class="calc-compo__title">A dónde va el dinero</h3>
                <p class="calc-compo__sub" id="compo-sub">Su coste del primer año, de mayor a menor.</p>
                <div class="calc-period__tabs calc-period__tabs--sm" role="tablist" aria-label="Año">
                  <button type="button" class="calc-period__tab is-active" data-year="1" role="tab" aria-selected="true">Año 1</button>
                  <button type="button" class="calc-period__tab" data-year="2" role="tab" aria-selected="false">Año 2</button>
                </div>
              </div>
              <div class="calc-compo__total-wrap">
                <span class="calc-compo__total-label" id="compo-total-label">Total del año 1</span>
                <span class="calc-compo__total" id="compo-total">RMB 0</span>
              </div>
            </div>
            <div class="calc-compo__spine" id="compo-bar" role="img" aria-label="Composición del coste">
              <div class="calc-compo__tip" id="compo-tip" aria-hidden="true"></div>
            </div>
            <div class="calc-compo__cards" id="compo-cards"></div>
          </div>
        </div>

        <details class="calc-detail reveal">
          <summary class="calc-detail__summary">
            <span>Ver el desglose partida a partida</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
          </summary>
          <div class="calc-table-bar">
            <span class="calc-table-bar__label">Desglose completo del año 1 y del año 2</span>
            <button type="button" class="btn btn--secondary btn--sm calc-table-bar__pdf" data-export-pdf>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M8 11l4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
              Exportar esta tabla a PDF
            </button>
          </div>
          <div class="calc-table-wrap">
            <table class="calc-table" id="calc-table">
              <thead>
                <tr>
                  <th scope="col">Partida de coste</th>
                  <th scope="col">Año 1</th>
                  <th scope="col">Año 2</th>
                </tr>
              </thead>
              <tbody id="calc-table-body"></tbody>
            </table>
          </div>
        </details>

        <div class="calc-notes reveal">
          <h3 class="calc-notes__title">Cómo leer estas cifras</h3>
          <ul class="calc-notes__list">
            {notes.map((n) => <li>{n}</li>)}
          </ul>
        </div>

        <div class="calc-cta reveal">
          <p>¿Quiere que pongamos a prueba estas hipótesis con su propio briefing?</p>
          <a class="btn btn--secondary" href="/es/contacto">Hable con nuestro equipo en China</a>
        </div>

        {/* Print-only footer: contact + disclaimer on the exported PDF */}
        <div class="calc-print calc-print__foot" aria-hidden="true">
          <div class="calc-print__foot-brand">
            <img src="/Images/thechinapath-horizontal.png" alt="TheChinaPath" class="calc-print__logo" />
            <span>thechinapath.com · hello@thechinapath.com</span>
          </div>
          <p class="calc-print__disclaimer">
            Estimación de planificación, no un presupuesto. Se construye con referencias públicas y
            con las cifras que usted ha introducido, así que el resultado es solo orientativo.
            TheChinaPath no garantiza los totales, las hipótesis ni los cálculos. Sirve únicamente
            de información. Antes de comprometerse, contraste cada línea con presupuestos reales de
            su TP, de su almacén y de la plataforma.
          </p>
        </div>
      </div>

      <p class="calc-disclaimer">
        Un apunte rápido. Estas cifras son una estimación de planificación, no un presupuesto. El
        modelo funciona con referencias públicas y con los números que usted teclea, así que el
        resultado es solo orientativo. No garantizamos los totales, ni las hipótesis, ni las cuentas
        que hay detrás. Está aquí para enseñar y para informar, nada más. Antes de poner dinero de
        verdad, contraste cada línea con presupuestos reales de su TP, de su almacén y de la
        plataforma.
      </p>
      <p class="calc-more">
        ¿Está comparando plataformas? También puede <a
          href="/es/herramientas/calculadora-de-costes-jd-worldwide"
          >calcular lo que cuesta una tienda en JD Worldwide</a
        > o <a href="/es/herramientas/calculadora-de-costes-douyin"
          >modelar un canal cross-border en Douyin</a
        > con el mismo tipo de desglose.
      </p>
    </div>
  </section>

  {/* ---------- Email gate ---------- */}
  <div class="calc-gate" id="calc-gate" hidden aria-hidden="true">
    <div class="calc-gate__backdrop" data-close></div>
    <div class="calc-gate__panel" role="dialog" aria-modal="true" aria-labelledby="calc-gate-title">
      <button class="calc-gate__close" type="button" data-close aria-label="Cerrar">×</button>
      <span class="eyebrow">Un paso</span>
      <h2 class="calc-gate__title" id="calc-gate-title">Desbloquee su desglose completo</h2>
      <p class="calc-gate__lead">
        Sus cifras ya están listas. Deje su correo profesional y le abrimos el desglose completo
        aquí mismo. Una vez en pantalla, puede exportarlo a PDF.
      </p>

      <form class="calc-gate__form" id="calc-gate-form" novalidate>
        <div class="calc-field">
          <label class="calc-field__label" for="lead-name">Nombre</label>
          <input class="calc-input calc-input--text" type="text" id="lead-name" name="name" autocomplete="name" required />
        </div>
        <div class="calc-field">
          <label class="calc-field__label" for="lead-email">Correo profesional</label>
          <input class="calc-input calc-input--text" type="email" id="lead-email" name="email" autocomplete="email" required />
        </div>
        <div class="calc-field">
          <label class="calc-field__label" for="lead-company">Empresa</label>
          <input class="calc-input calc-input--text" type="text" id="lead-company" name="company" autocomplete="organization" />
        </div>

        <button type="submit" class="btn btn--primary calc-gate__submit" id="lead-submit">
          Ver mis resultados
        </button>
        <p class="calc-gate__note">
          Usamos su correo para hacer seguimiento y, de vez en cuando, mandarle apuntes sobre vender
          en China. Nada de spam, y puede darse de baja cuando quiera.
        </p>
        <p class="calc-gate__status" id="lead-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  {/* Shared field-explanation bubble, positioned by JS to dodge clipping */}
  <div class="field-pop" id="field-pop" role="tooltip" hidden></div>
</Layout>

<script is:inline>
  (function () {
    const form = document.getElementById('calc-form');
    const gate = document.getElementById('calc-gate');
    const gateForm = document.getElementById('calc-gate-form');
    const gateStatus = document.getElementById('lead-status');
    const leadSubmit = document.getElementById('lead-submit');
    const results = document.getElementById('calc-results');
    if (!form || !gate || !gateForm) return;

    const prefersReduced =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- number helpers ----
    const rmb0 = (n) => 'RMB ' + Math.round(n).toLocaleString('es-ES');
    const usd0 = (n) => '$' + Math.round(n).toLocaleString('es-ES');
    const pct1 = (n) => (n * 100).toFixed(1).replace('.', ',') + '%';

    // ---------- scroll reveal ----------
    if ('IntersectionObserver' in window && !prefersReduced) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
    }

    // ---------- slider <-> number sync + fill ----------
    function paintRange(range) {
      const min = parseFloat(range.min || '0');
      const max = parseFloat(range.max || '100');
      const val = parseFloat(range.value || '0');
      const pct = max > min ? ((val - min) / (max - min)) * 100 : 0;
      range.style.setProperty('--pct', pct + '%');
    }
    document.querySelectorAll('.driver__range').forEach((range) => {
      const num = document.getElementById(range.getAttribute('data-target'));
      paintRange(range);
      range.addEventListener('input', () => {
        if (num) {
          num.value = range.value;
          num.dispatchEvent(new Event('input', { bubbles: true }));
        }
        paintRange(range);
      });
      if (num) {
        num.addEventListener('input', () => {
          range.value = num.value;
          paintRange(range);
        });
      }
    });

    // ---------- live preview ----------
    const liveOrders = document.getElementById('live-orders');
    function updatePreview() {
      const gmv = parseFloat(document.getElementById('gmv').value) || 0;
      const aov = parseFloat(document.getElementById('aov').value) || 0;
      const orders = aov > 0 ? gmv / aov : 0;
      if (liveOrders) {
        liveOrders.textContent = Math.round(orders).toLocaleString('es-ES');
        if (!prefersReduced) {
          liveOrders.classList.remove('is-pulse');
          void liveOrders.offsetWidth;
          liveOrders.classList.add('is-pulse');
        }
      }
    }
    form.addEventListener('input', updatePreview);
    updatePreview();

    // ---------- channel mix: each year's three shares must total 100% (no auto-edit) ----------
    let mixIs100 = true;
    let mix2Is100 = true;
    function wireMix(ids, noteId, setOk) {
      const labels = ['publicidad de pago', 'KOL', 'orgánico'];
      const els = ids.map((id) => document.getElementById(id));
      if (els.some((e) => !e)) return;
      const mixNote = document.getElementById(noteId);
      function validateMix() {
        const v = els.map((e) => Math.max(0, Math.round(parseFloat(e.value) || 0)));
        const sum = v[0] + v[1] + v[2];
        const ok = sum === 100;
        setOk(ok);
        if (!mixNote) return;
        const chips = ids
          .map(
            (id, k) =>
              '<span class="calc-mix__seg calc-mix__seg--' +
              id.replace(/2$/, '') +
              '"><span class="calc-mix__dot"></span>' +
              v[k] +
              '% ' +
              labels[k] +
              '</span>',
          )
          .join('');
        const status = ok
          ? '<span class="calc-mix__status calc-mix__status--ok">Total 100 % ✓</span>'
          : '<span class="calc-mix__status calc-mix__status--bad">Total ' +
            sum +
            ' %, tiene que sumar 100 %</span>';
        mixNote.innerHTML = chips + status;
        mixNote.classList.toggle('calc-mix--bad', !ok);
      }
      els.forEach((e) => e.addEventListener('input', validateMix));
      validateMix();
    }
    wireMix(['paidShare', 'kolShare', 'organicShare'], 'mix-note', (ok) => (mixIs100 = ok));
    wireMix(['paidShare2', 'kolShare2', 'organicShare2'], 'mix-note-2', (ok) => (mix2Is100 = ok));

    // ---------- advanced accordion ----------
    const advToggle = document.getElementById('advanced-toggle');
    const advBody = document.getElementById('advanced-body');
    if (advToggle && advBody) {
      advToggle.addEventListener('click', () => {
        const open = advToggle.getAttribute('aria-expanded') === 'true';
        advToggle.setAttribute('aria-expanded', String(!open));
        if (open) {
          advBody.style.maxHeight = advBody.scrollHeight + 'px';
          void advBody.offsetWidth;
          advBody.style.maxHeight = '0px';
          advBody.addEventListener(
            'transitionend',
            () => {
              if (advToggle.getAttribute('aria-expanded') === 'false') advBody.hidden = true;
            },
            { once: true },
          );
        } else {
          advBody.hidden = false;
          advBody.style.maxHeight = advBody.scrollHeight + 'px';
          advBody.addEventListener(
            'transitionend',
            () => {
              if (advToggle.getAttribute('aria-expanded') === 'true') advBody.style.maxHeight = 'none';
            },
            { once: true },
          );
        }
      });
    }

    // ---------- fine-tune tabs ----------
    const tabs = Array.from(document.querySelectorAll('.calc-tab'));
    const panels = Array.from(document.querySelectorAll('.calc-tabpanel'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const idx = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', String(on));
        });
        panels.forEach((p) => {
          const on = p.getAttribute('data-panel') === idx;
          p.classList.toggle('is-active', on);
          p.hidden = !on;
        });
        // panel height may differ; let the open accordion grow to fit
        if (advBody && advToggle && advToggle.getAttribute('aria-expanded') === 'true') {
          advBody.style.maxHeight = 'none';
        }
      });
    });

    // ---------- field help bubbles ----------
    const pop = document.getElementById('field-pop');
    let popTrigger = null;
    function showPop(btn) {
      pop.textContent = btn.getAttribute('data-help') || '';
      pop.hidden = false;
      const pw = Math.min(320, window.innerWidth - 24);
      pop.style.width = pw + 'px';
      const r = btn.getBoundingClientRect();
      let left = r.left + r.width / 2 - pw / 2;
      left = Math.max(12, Math.min(left, window.innerWidth - pw - 12));
      pop.style.left = left + 'px';
      const ph = pop.offsetHeight;
      let top = r.bottom + 8;
      if (top + ph > window.innerHeight - 8) top = r.top - ph - 8;
      pop.style.top = Math.max(8, top) + 'px';
      pop.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      popTrigger = btn;
    }
    let popPinned = false;
    function hidePop() {
      if (!pop) return;
      pop.hidden = true;
      pop.classList.remove('is-open');
      if (popTrigger) popTrigger.setAttribute('aria-expanded', 'false');
      popTrigger = null;
      popPinned = false;
    }
    if (pop) {
      const canHover = window.matchMedia && window.matchMedia('(hover: hover)').matches;
      document.querySelectorAll('.calc-help__btn').forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        // click pins the bubble open (works on touch too)
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (popTrigger === btn && popPinned) {
            hidePop();
          } else {
            showPop(btn);
            popPinned = true;
          }
        });
        // hover shows it transiently on pointer devices
        if (canHover) {
          btn.addEventListener('mouseenter', () => {
            if (!popPinned) showPop(btn);
          });
          btn.addEventListener('mouseleave', () => {
            if (!popPinned) hidePop();
          });
          btn.addEventListener('focus', () => {
            if (!popPinned) showPop(btn);
          });
          btn.addEventListener('blur', () => {
            if (!popPinned) hidePop();
          });
        }
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest || !e.target.closest('.calc-help__btn')) hidePop();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') hidePop();
      });
      window.addEventListener('scroll', hidePop, true);
      window.addEventListener('resize', hidePop);
    }

    // ---------- FX live rate ----------
    const fxBtn = document.getElementById('fx-refresh');
    const fxNote = document.getElementById('fx-note');
    async function refreshFx() {
      if (fxBtn) fxBtn.classList.add('is-spinning');
      if (fxNote) {
        fxNote.textContent = 'Consultando el tipo de cambio…';
        fxNote.className = 'calc-field__hint';
      }
      try {
        const res = await fetch('/api/fx-rate');
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.rate) throw new Error(data.error || 'No se ha recibido ningún tipo de cambio.');
        const fxInput = document.getElementById('fx');
        fxInput.value = data.rate;
        fxInput.dispatchEvent(new Event('input', { bubbles: true }));
        if (fxNote) {
          fxNote.textContent = 'Tipo de cambio en vivo: 1 USD = ' + data.rate + ' RMB.';
          fxNote.className = 'calc-field__hint calc-field__hint--ok';
        }
      } catch (err) {
        if (fxNote) {
          fxNote.textContent = 'No hemos podido traer el tipo de cambio. Mantenemos su valor.';
          fxNote.className = 'calc-field__hint calc-field__hint--err';
        }
      } finally {
        if (fxBtn) fxBtn.classList.remove('is-spinning');
      }
    }
    if (fxBtn) fxBtn.addEventListener('click', refreshFx);
    // Pull today's rate on load so the USD figure starts current.
    refreshFx();

    // ---------- category picker sets deposit + commission + annual fee ----------
    const catSelect = document.getElementById('category');
    if (catSelect) {
      const impactBox = document.getElementById('category-impact');
      const impactDeposit = document.getElementById('impact-deposit');
      const impactFee = document.getElementById('impact-fee');
      const impactAnnual = document.getElementById('impact-annual');

      function applyCategory(fillForm) {
        const opt = catSelect.options[catSelect.selectedIndex];
        const deposit = opt.getAttribute('data-deposit');
        const fee = opt.getAttribute('data-fee');
        const annual = opt.getAttribute('data-annual');
        // Custom leaves the fields untouched, so there is nothing to preview.
        if (!deposit && !fee && !annual) {
          if (impactBox) impactBox.hidden = true;
          return;
        }
        const setField = (id, val) => {
          if (!val) return;
          const el = document.getElementById(id);
          if (el) {
            el.value = val;
            el.dispatchEvent(new Event('input', { bubbles: true }));
          }
        };
        if (fillForm) {
          setField('platformDeposit', deposit);
          setField('techFee', fee);
          setField('annualFee', annual);
        }
        if (impactBox) {
          if (impactDeposit && deposit)
            impactDeposit.textContent = 'RMB ' + Number(deposit).toLocaleString('es-ES');
          if (impactFee && fee) impactFee.textContent = fee.replace('.', ',') + '%';
          if (impactAnnual && annual)
            impactAnnual.textContent = 'RMB ' + Number(annual).toLocaleString('es-ES');
          impactBox.hidden = false;
        }
      }

      catSelect.addEventListener('change', () => applyCategory(true));
      // Show what the default category drives, without overwriting the fields.
      applyCategory(false);
    }

    // ---------- compute (faithful port of the DP cost model spec) ----------
    function readInputs() {
      const out = {};
      form.querySelectorAll('input[data-kind]').forEach((el) => {
        const kind = el.getAttribute('data-kind');
        const raw = el.value.trim();
        if (raw === '') {
          out[el.name] = null;
          return;
        }
        let v = parseFloat(raw);
        if (!Number.isFinite(v)) v = 0;
        if (kind === 'percent') v = v / 100;
        out[el.name] = v;
      });
      return out;
    }

    function compute(i) {
      const gmv = i.gmv || 0;
      const aov = i.aov || 1;
      const orders = gmv / aov;
      const taxPayer = (document.getElementById('cbecTaxPayer') || {}).value || 'consumer';
      const brandPaysTax = taxPayer === 'brand';
      // Year 2 sells more: its stack scales off Year 1 GMV grown by the
      // "Year 2 GMV growth" assumption.
      const gmv2 = gmv * (1 + (i.gmvGrowth || 0));
      const orders2 = gmv2 / aov;

      const setup = {
        'Depósito de plataforma (reembolsable)': i.platformDeposit || 0,
        'Depósito del almacén en zona franca (reembolsable)': i.whDeposit || 0,
        'Anticipo de impuestos al almacén': i.whTaxPrepay || 0,
        'Registro de marca en China': i.trademark || 0,
        'Montaje de la tienda y contenidos de lanzamiento': i.brandSetup || 0,
      };
      const setupTotal = Object.values(setup).reduce((a, b) => a + b, 0);

      // Setup splits in two. The deposits and the tax prepayment come back on
      // exit, so they are working capital and never touch the P&L. The trademark
      // and the store build are spent for good: a real cost, but one that earns
      // over several years, so it is amortized rather than charged to Year 1.
      const refundableCapex = (i.platformDeposit || 0) + (i.whDeposit || 0) + (i.whTaxPrepay || 0);
      const sunkCapex = (i.trademark || 0) + (i.brandSetup || 0);
      const amortYears = Math.max(1, Math.round(i.amortYears || 1));
      const amortAnnual = sunkCapex / amortYears;
      // A one-year write-off is fully expensed in Year 1, so Year 2 carries none.
      const amortY1 = amortAnnual;
      const amortY2 = amortYears >= 2 ? amortAnnual : 0;
      const amortLabel =
        'Amortización del arranque (' + amortYears + (amortYears === 1 ? ' año' : ' años') + ')';

      // Fixed and per-order coefficients for break-even. The fixed side is the
      // running services plus the year's amortization: break-even asks what GMV
      // covers the annual bill the P&L actually carries.
      const tpRetainerAnnual = (i.dpRetainer || 0) * 12;
      // The platform annual fee, the TP retainer, the co-fund and any clearance
      // agent are the fixed running cost. Service-side VAT on those fees is
      // assumed baked into the quotes, so it is not modelled separately.
      const fixedServices =
        (i.agentFee || 0) + tpRetainerAnnual + (i.coFund || 0) + (i.annualFee || 0);
      const F = fixedServices + amortY1;
      const F2 = fixedServices + amortY2;
      const vQ =
        (i.storage || 0) * 2 +
        (i.fulfillment || 0) +
        (i.shipping || 0) +
        (i.returnRate || 0) * (i.returnHandling || 0);

      function scenario(roas) {
        // One operating stack per year. Year 2 differs on three inputs: its own
        // channel mix (paid vs KOL vs organic), a grown GMV, and the share of
        // the setup write-off it still carries.
        function opStack(paidShare, kolShare, g, o, amort) {
          const media = roas > 0 ? (g * (paidShare || 0)) / roas : 0;
          const tpCommission = g * (i.dpCommission || 0);
          const commission = g * (i.techFee || 0);
          const payment = g * (i.paymentFee || 0);
          const vat = brandPaysTax ? g * (i.cbecTax || 0) : 0;
          const op = {
            'Retainer mensual del TP (× 12)': tpRetainerAnnual,
            'Comisión del TP sobre el GMV': tpCommission,
            'Cuota anual de la plataforma': i.annualFee || 0,
            'Comisión de plataforma (技术服务费)': commission,
            'Comisión de pago': payment,
            'Publicidad de pago (直通车 y display)': media,
            'Comisión de KOL y livestream': g * (kolShare || 0) * (i.kolCommission || 0),
            'Fondo conjunto de campañas': i.coFund || 0,
            'Agente de aduanas': i.agentFee || 0,
            'Almacenaje en zona franca': o * (i.storage || 0) * 2,
            'Preparación de pedidos (picking y packing)': o * (i.fulfillment || 0),
            'Transporte de última milla': o * (i.shipping || 0),
            'Gestión de devoluciones': o * (i.returnRate || 0) * (i.returnHandling || 0),
          };
          // Consumer carries the VAT in most flagship setups, so it only lands on
          // the brand P&L when the payer toggle says so.
          if (brandPaysTax) op['IVA cross-border (综合税)'] = vat;

          // Cash leaving the building this year, before the write-off.
          const cashOp = Object.values(op).reduce((a, b) => a + b, 0);
          // The write-off is a P&L cost with no cash behind it: the money was
          // already paid at setup. It is charged here and nowhere else, so the
          // cash column and the profit column never double-count it.
          op[amortLabel] = amort;
          const opTotal = cashOp + amort;

          // %-of-GMV variable rate for this ROAS and mix.
          const paidRate = roas > 0 ? (paidShare || 0) / roas : 0;
          const vG =
            (i.dpCommission || 0) +
            (kolShare || 0) * (i.kolCommission || 0) +
            (i.techFee || 0) +
            (i.paymentFee || 0) +
            (brandPaysTax ? i.cbecTax || 0 : 0) +
            paidRate;

          // Buckets for the composition bar
          const buckets = [
            { key: 'Arranque', color: '#c8102e', value: setupTotal },
            { key: 'Retainer y comisión del TP', color: '#e2683b', value: tpRetainerAnnual + tpCommission },
            { key: 'Publicidad de pago', color: '#f4874b', value: op['Publicidad de pago (直通车 y display)'] },
            { key: 'KOL y livestream', color: '#f4b740', value: op['Comisión de KOL y livestream'] },
            { key: 'Comisiones de plataforma y pago', color: '#7b61a8', value: op['Comisión de plataforma (技术服务费)'] + op['Comisión de pago'] + (op['Cuota anual de la plataforma'] || 0) },
            { key: 'IVA cross-border', color: '#9b5bb0', value: vat },
            { key: 'Logística', color: '#3aa0c8', value: op['Almacenaje en zona franca'] + op['Preparación de pedidos (picking y packing)'] + op['Transporte de última milla'] + op['Gestión de devoluciones'] },
            { key: 'Agente y fondo de campañas', color: '#2fb67f', value: op['Agente de aduanas'] + op['Fondo conjunto de campañas'] },
          ];
          return { op, opTotal, cashOp, vG, buckets };
        }

        const y1 = opStack(i.paidShare, i.kolShare, gmv, orders, amortY1);
        const y2 = opStack(i.paidShare2, i.kolShare2, gmv2, orders2, amortY2);

        const opTotal = y1.opTotal;
        const vG = y1.vG;
        // total = every RMB that leaves the building in Year 1: the setup cheque
        // in full, plus the running cash. The write-off is excluded here, since
        // the cash it represents is already in setupTotal.
        const total = setupTotal + y1.cashOp;
        const refundable = refundableCapex;
        const netSunk = total - refundable;
        const totalUSD = i.fx > 0 ? total / i.fx : 0;
        const costPerOrder = orders > 0 ? total / orders : 0;
        const totalPctGmv = gmv > 0 ? total / gmv : 0;
        const opPctGmv = gmv > 0 ? opTotal / gmv : 0;

        let breakeven = null;
        let breakevenMonthly = null;
        let breakevenOrders = null;
        let contribution = null;
        if (i.grossMargin != null) {
          // Operating P&L: gross profit less the running cost and this year's
          // share of the setup write-off.
          contribution = gmv * i.grossMargin - opTotal;
          const denom = i.grossMargin - vG - (aov > 0 ? vQ / aov : 0);
          if (denom <= 0) {
            breakeven = 'Margen demasiado bajo';
          } else {
            breakeven = F / denom;
            breakevenMonthly = breakeven / 12;
            breakevenOrders = aov > 0 ? breakeven / aov : 0;
          }
        }

        return {
          op: y1.op,
          opTotal,
          cashOp: y1.cashOp,
          vG,
          buckets: y1.buckets,
          op2: y2.op,
          opTotal2: y2.opTotal,
          cashOp2: y2.cashOp,
          vG2: y2.vG,
          buckets2: y2.buckets,
          total,
          refundable,
          netSunk,
          totalUSD,
          costPerOrder,
          totalPctGmv,
          opPctGmv,
          breakeven,
          breakevenMonthly,
          breakevenOrders,
          contribution,
        };
      }

      return {
        orders,
        aov,
        gmv,
        gmv2,
        orders2,
        setup,
        setupTotal,
        refundableCapex,
        sunkCapex,
        amortYears,
        amortY1,
        amortY2,
        F,
        F2,
        vQ,
        s: scenario(i.roas || 0),
        hasGm: i.grossMargin != null,
      };
    }

    // ---------- count-up ----------
    function animateCount(el, target, fmt) {
      if (prefersReduced) {
        el.textContent = fmt(target);
        return;
      }
      const start = performance.now();
      const dur = 850;
      function tick(now) {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(target * eased);
        if (p < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    // ---------- results rendering ----------
    let state = null; // { i, r }
    let activeYear = '1'; // '1' or '2', driven by the Year 1 / Year 2 tabs
    // Once the visitor has handed over their email, they can tweak assumptions
    // and re-run as many times as they like without seeing the gate again. Scoped
    // to the browser session: a refresh keeps them in, a new session re-gates.
    let unlocked = false;
    try {
      unlocked = sessionStorage.getItem('tmallCalcUnlocked') === '1';
    } catch (_) {
      /* private mode or storage disabled: fall back to in-session unlock */
    }
    // When they're already unlocked, the CTA is a re-run, not a locked gate.
    function paintCta() {
      if (!unlocked) return;
      const cta = document.getElementById('calc-submit');
      const note = document.querySelector('.calc-preview__note');
      // The blurred teaser only makes sense while the numbers are still hidden.
      // Once they are on the page, the rail is just a re-run button.
      const locked = document.querySelector('.calc-preview__locked');
      if (locked) locked.remove();
      if (cta) cta.textContent = 'Actualizar mi desglose';
      if (note)
        note.textContent =
          'Cambie cualquier hipótesis de arriba y vuelva a calcular. No hace falta identificarse otra vez.';
    }
    paintCta();

    function renderFocus() {
      if (!state) return;
      const r = state.r;
      const s = r.s;
      const i = state.i;
      const y2 = activeYear === '2';

      // period-dependent figures, on a CASH basis: Year 2 writes no setup cheque
      // and runs on its own channel mix, so its cash cost is the Year 2 running
      // stack. The amortization is a P&L line and is deliberately not in here.
      const cost = y2 ? s.cashOp2 : s.total;
      const costUSD = i.fx > 0 ? cost / i.fx : 0;
      const cash = y2 ? s.cashOp2 : s.netSunk;
      // Year 2 runs on grown GMV, so its per-order and %-of-GMV figures
      // divide by the Year 2 volumes.
      const gmvYear = y2 ? r.gmv2 : r.gmv;
      const ordersYear = y2 ? r.orders2 : r.orders;
      const cpo = ordersYear > 0 ? cost / ordersYear : 0;
      const pctGmv = gmvYear > 0 ? cost / gmvYear : 0;

      document.getElementById('focus-hero-label').textContent = y2
        ? 'Coste total del año 2'
        : 'Salida de caja total del año 1 (arranque y operación)';
      animateCount(document.getElementById('focus-total'), cost, rmb0);
      animateCount(document.getElementById('focus-usd'), costUSD, usd0);
      animateCount(document.getElementById('focus-sunk'), cash, rmb0);
      document.getElementById('focus-sunk-foot').textContent = y2
        ? 'costes recurrentes, los depósitos ya están aparcados'
        : 'descontados los depósitos reembolsables';
      animateCount(document.getElementById('focus-cpo'), cpo, rmb0);
      document.getElementById('focus-cpo-foot').textContent =
        'frente a un ticket medio de ' + rmb0(i.aov || 0);
      document.getElementById('focus-pct').textContent = pct1(pctGmv);

      // breakeven, year aware (Year 2 drops the sunk setup and runs its own mix)
      const Fyear = y2 ? r.F2 : r.F;
      const be = document.getElementById('focus-be');
      const beWrap = document.getElementById('focus-be-wrap');
      const beFoot = document.getElementById('focus-be-foot');
      if (r.hasGm) {
        const denom = i.grossMargin - (y2 ? s.vG2 : s.vG) - (r.aov > 0 ? r.vQ / r.aov : 0);
        if (denom <= 0) {
          be.textContent = 'Margen demasiado bajo';
          beFoot.textContent = 'suba antes su margen';
        } else {
          const beVal = Fyear / denom;
          be.textContent = rmb0(beVal);
          beFoot.textContent =
            'unos ' +
            rmb0(beVal / 12) +
            '/mes · ' +
            Math.round(r.aov > 0 ? beVal / r.aov : 0).toLocaleString('es-ES') +
            ' pedidos al año';
        }
        beWrap.classList.remove('is-muted');
      } else {
        be.textContent = 'Añada su margen';
        beFoot.textContent = 'para cubrir el año';
        beWrap.classList.add('is-muted');
      }

      // Operating profit or loss: gross profit less the running cost and this
      // year's share of the setup write-off. The refundable deposits stay out.
      const opYear = y2 ? s.opTotal2 : s.opTotal;
      const plEl = document.getElementById('focus-pl1');
      const plFoot = document.getElementById('focus-pl1-foot');
      const plWrap = document.getElementById('focus-pl1-wrap');
      plEl.classList.remove('is-profit', 'is-loss');
      if (r.hasGm) {
        const grossProfit = gmvYear * i.grossMargin;
        const amount = grossProfit - opYear;
        const sign = amount >= 0 ? '+' : '−';
        plEl.textContent = sign + rmb0(Math.abs(amount));
        plEl.classList.add(amount >= 0 ? 'is-profit' : 'is-loss');
        plFoot.textContent =
          (amount >= 0 ? 'beneficio. ' : 'pérdida. ') +
          'tras los costes recurrentes y la amortización del arranque';
        plWrap.classList.remove('is-muted');
      } else {
        plEl.textContent = 'Añada su margen';
        plFoot.textContent = 'indique el margen bruto por pedido';
        plWrap.classList.add('is-muted');
      }

      // Setup capex: the cheque is written in Year 1, but the P&L only carries
      // the year's amortized share, which is what this card reports per year.
      const capexEl = document.getElementById('focus-capex');
      const capexFoot = document.getElementById('focus-capex-foot');
      const capexWrap = document.getElementById('focus-capex-wrap');
      const amortYear = y2 ? r.amortY2 : r.amortY1;
      if (y2) {
        animateCount(capexEl, amortYear, rmb0);
        capexFoot.textContent =
          amortYear > 0
            ? 'parte amortizada, sin salida de caja. El arranque se pagó en el año 1'
            : 'amortizado por completo en el año 1, ya no queda nada que imputar';
        capexWrap.classList.add('is-muted');
      } else {
        animateCount(capexEl, amortYear, rmb0);
        capexFoot.textContent =
          'la parte que carga este año de ' +
          rmb0(r.sunkCapex) +
          ', amortizados en ' +
          r.amortYears +
          (r.amortYears === 1 ? ' año' : ' años') +
          '. Recupera ' +
          rmb0(r.refundableCapex) +
          ' en depósitos';
        capexWrap.classList.remove('is-muted');
      }

      // Net channel margin: GMV less the operating cost (which now carries the
      // write-off), before product cost.
      const ncm = gmvYear - opYear;
      const ncmEl = document.getElementById('focus-ncm');
      ncmEl.classList.remove('is-profit', 'is-loss');
      ncmEl.textContent = (ncm >= 0 ? '+' : '−') + rmb0(Math.abs(ncm));
      ncmEl.classList.add(ncm >= 0 ? 'is-profit' : 'is-loss');
      document.getElementById('focus-ncm-foot').textContent =
        'GMV menos costes recurrentes, antes del coste de producto';

      document.getElementById('compo-sub').textContent = y2
        ? 'Su coste recurrente del año 2, de mayor a menor.'
        : 'Su coste del primer año, de mayor a menor.';
      document.getElementById('compo-total-label').textContent = y2
        ? 'Total del año 2'
        : 'Total del año 1';
      // The composition bar is a cash picture: Year 1 shows the setup cheque in
      // full, Year 2 shows running cash only. The write-off is not a bucket.
      const compoBuckets = y2 ? s.buckets2.filter((b) => b.key !== 'Arranque') : s.buckets;
      renderCompo(compoBuckets, y2 ? s.cashOp2 : s.total);
    }

    // line icons keyed by bucket, drawn in currentColor
    const BUCKET_ICONS = {
      Arranque:
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1.5-4.5A2 2 0 0 1 6.4 3h11.2a2 2 0 0 1 1.9 1.5L21 9"/><path d="M3 9v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9"/><path d="M3 9h18"/><path d="M9 13h6"/></svg>',
      'Retainer y comisión del TP':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M2 20a7 7 0 0 1 14 0"/><path d="M16 6a3 3 0 0 1 0 6"/><path d="M20 20a6 6 0 0 0-4-5.6"/></svg>',
      'Publicidad de pago':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4"/></svg>',
      'KOL y livestream':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4a1 1 0 0 0 1 1h2l9 5V4L6 9H4a1 1 0 0 0-1 1z"/><path d="M18 9a4 4 0 0 1 0 6"/></svg>',
      'Comisiones de plataforma y pago':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>',
      'IVA cross-border':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h10a1 1 0 0 1 1 1v17l-3-2-3 2-3-2-3 2V4a1 1 0 0 1 1-1z"/><path d="M14.5 9.5l-5 5"/><circle cx="9.7" cy="9.7" r=".6"/><circle cx="14.3" cy="14.3" r=".6"/></svg>',
      'Logística':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h12v9H2z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>',
      'Agente y fondo de campañas':
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M3 12h18"/></svg>',
    };

    let compoTipHideT = null;
    function renderCompo(buckets, grandTotal) {
      const bar = document.getElementById('compo-bar');
      const cards = document.getElementById('compo-cards');
      const tip = document.getElementById('compo-tip');
      const totalEl = document.getElementById('compo-total');
      if (!bar || !cards) return;
      const total = grandTotal || 1;
      animateCount(totalEl, grandTotal, rmb0);

      const items = buckets
        .filter((b) => b.value > 0)
        .slice()
        .sort((a, b) => b.value - a.value)
        .map((b) => ({ ...b, pct: (b.value / total) * 100 }));

      // spine segments (keep the tooltip node)
      bar.querySelectorAll('.calc-compo__seg').forEach((el) => el.remove());
      items.forEach((b) => {
        const seg = document.createElement('span');
        seg.className = 'calc-compo__seg';
        seg.dataset.key = b.key;
        seg.style.setProperty('--w', b.pct + '%');
        seg.style.setProperty('--c', b.color);
        bar.appendChild(seg);
      });

      // ranked cost cards
      cards.innerHTML = items
        .map((b, idx) => {
          const icon = BUCKET_ICONS[b.key] || '';
          return (
            '<article class="cost-card" data-key="' +
            b.key +
            '" style="--c:' +
            b.color +
            ';--i:' +
            idx +
            '">' +
            '<span class="cost-card__icon">' +
            icon +
            '</span>' +
            '<div class="cost-card__body">' +
            '<div class="cost-card__top"><span class="cost-card__name">' +
            b.key +
            '</span><span class="cost-card__pct">' +
            b.pct.toFixed(0) +
            '%</span></div>' +
            '<span class="cost-card__value" data-val="' +
            b.value +
            '">' +
            rmb0(b.value) +
            '</span>' +
            '<div class="cost-card__meter"><span class="cost-card__meter-fill" style="--w:' +
            b.pct +
            '%"></span></div>' +
            '</div>' +
            '</article>'
          );
        })
        .join('');

      const segEls = Array.from(bar.querySelectorAll('.calc-compo__seg'));
      const cardEls = Array.from(cards.querySelectorAll('.cost-card'));

      // grow the spine, meters and count up the card values
      const grow = () => {
        segEls.forEach((el) => el.classList.add('is-grown'));
        cardEls.forEach((el, idx) => {
          el.classList.add('is-in');
          const fill = el.querySelector('.cost-card__meter-fill');
          if (fill) fill.classList.add('is-grown');
          const valEl = el.querySelector('.cost-card__value');
          if (valEl) {
            const target = parseFloat(valEl.getAttribute('data-val')) || 0;
            if (prefersReduced) valEl.textContent = rmb0(target);
            else setTimeout(() => animateCount(valEl, target, rmb0), 120 + idx * 60);
          }
        });
      };
      if (prefersReduced) grow();
      else requestAnimationFrame(grow);

      // link the spine and the cards on hover / focus
      const focus = (key, on) => {
        segEls.forEach((el) => {
          el.classList.toggle('is-focus', on && el.dataset.key === key);
          el.classList.toggle('is-dim', on && el.dataset.key !== key);
        });
        cardEls.forEach((el) => {
          el.classList.toggle('is-focus', on && el.dataset.key === key);
          el.classList.toggle('is-dim', on && el.dataset.key !== key);
        });
      };
      const showTip = (seg) => {
        if (!tip) return;
        if (compoTipHideT) clearTimeout(compoTipHideT);
        const item = items.find((x) => x.key === seg.dataset.key);
        if (!item) return;
        tip.innerHTML =
          '<span class="calc-compo__tip-key">' +
          item.key +
          '</span><span class="calc-compo__tip-val">' +
          rmb0(item.value) +
          ' · ' +
          item.pct.toFixed(1) +
          '%</span>';
        tip.style.left = seg.offsetLeft + seg.offsetWidth / 2 + 'px';
        tip.classList.add('is-open');
      };
      const hideTip = () => {
        if (!tip) return;
        compoTipHideT = setTimeout(() => tip.classList.remove('is-open'), 60);
      };
      segEls.forEach((seg) => {
        seg.addEventListener('mouseenter', () => {
          focus(seg.dataset.key, true);
          showTip(seg);
        });
        seg.addEventListener('mouseleave', () => {
          focus(seg.dataset.key, false);
          hideTip();
        });
      });
      cardEls.forEach((card) => {
        card.addEventListener('mouseenter', () => focus(card.dataset.key, true));
        card.addEventListener('mouseleave', () => focus(card.dataset.key, false));
      });
    }

    function renderTable() {
      const r = state.r;
      const i = state.i;
      const s = r.s;
      const gmv = i.gmv || 0;
      const fx = i.fx > 0 ? i.fx : 0;
      const body = document.getElementById('calc-table-body');
      const sectionRow = (label) =>
        '<tr class="calc-table__section"><td colspan="3">' + label + '</td></tr>';
      // A null year-2 value means the line does not recur (setup, deposits).
      const cell = (v) => (v === null ? '<span class="calc-table__na">-</span>' : rmb0(v));
      const dataRow = (label, y1, y2, strong) =>
        '<tr' + (strong ? ' class="calc-table__total"' : '') + '><td>' + label + '</td><td>' + cell(y1) + '</td><td>' + cell(y2) + '</td></tr>';
      // signed profit/loss cell, coloured by sign
      const plCell = (n) => {
        const cls = n >= 0 ? 'calc-pl--pos' : 'calc-pl--neg';
        const sign = n >= 0 ? '+' : '−';
        return '<td class="calc-pl ' + cls + '">' + sign + rmb0(Math.abs(n)) + '</td>';
      };
      const plRow = (label, y1, y2) =>
        '<tr class="calc-table__total calc-table__pl"><td>' + label + '</td>' + plCell(y1) + plCell(y2) + '</tr>';

      // The setup cheque is written once, in Year 1. Part of it comes back on
      // exit; the rest is amortized into the operating lines below.
      let rows = sectionRow('Arranque, desembolso único (año 1)');
      Object.keys(r.setup).forEach((k) => {
        rows += dataRow(k, r.setup[k], null, false);
      });
      rows += dataRow('Subtotal del arranque', r.setupTotal, null, true);
      rows += dataRow(
        'De los cuales reembolsables al salir (nunca son coste)',
        r.refundableCapex,
        null,
        false,
      );
      rows += dataRow(
        'De los cuales gastados a fondo perdido (amortizados en ' +
          r.amortYears +
          (r.amortYears === 1 ? ' año' : ' años') +
          ')',
        r.sunkCapex,
        null,
        false,
      );

      // Operating cost recurs, but Year 2 runs on its own channel mix and a
      // grown GMV, so the sales-driven lines differ between the two columns.
      // The last line is the write-off: a cost with no cash behind it.
      rows += sectionRow('Operación, anual (la cuenta de resultados)');
      Object.keys(s.op).forEach((k) => {
        rows += dataRow(k, s.op[k], s.op2[k], false);
      });
      rows += dataRow('Subtotal de operación', s.opTotal, s.opTotal2, true);

      rows += sectionRow('Visión de caja (sin amortización: no mueve dinero)');
      rows += dataRow('GMV previsto', gmv, r.gmv2, false);
      rows += dataRow('Salida de caja total (arranque y operación)', s.total, s.cashOp2, true);
      rows += dataRow('Caja realmente gastada, tras los reembolsos', s.netSunk, s.cashOp2, true);
      if (fx) {
        rows +=
          '<tr class="calc-table__total"><td>Salida de caja total (USD)</td><td>' +
          usd0(s.totalUSD) +
          '</td><td>' +
          usd0(s.cashOp2 / fx) +
          '</td></tr>';
      }
      rows += dataRow('Ahorro del año 1 al año 2', s.total - s.cashOp2, null, false);
      rows += plRow(
        'Margen neto de canal (GMV menos coste operativo, antes del coste de producto)',
        gmv - s.opTotal,
        r.gmv2 - s.opTotal2,
      );

      rows += sectionRow('Resultado operativo con su margen');
      if (r.hasGm) {
        // Break-even asks what GMV covers the running bill, so the fixed side is
        // services only. The two years differ on their channel mix (vG vs vG2).
        const beCell = (F, vG) => {
          const denom = i.grossMargin - vG - (r.aov > 0 ? r.vQ / r.aov : 0);
          return denom <= 0 ? 'Margen demasiado bajo' : rmb0(F / denom);
        };
        const grossProfit = gmv * i.grossMargin;
        const grossProfit2 = r.gmv2 * i.grossMargin;
        rows += dataRow('Margen bruto (GMV × margen)', grossProfit, grossProfit2, false);
        rows += dataRow(
          'Menos el coste operativo (con la amortización del arranque)',
          s.opTotal,
          s.opTotal2,
          false,
        );
        rows += plRow('Resultado operativo (beneficio o pérdida)', s.contribution, grossProfit2 - s.opTotal2);
        rows +=
          '<tr><td>GMV de equilibrio</td><td>' + beCell(r.F, s.vG) + '</td><td>' + beCell(r.F2, s.vG2) + '</td></tr>';
        rows +=
          '<tr class="calc-table__memo"><td>Nota: depósitos reembolsables, salen de caja pero nunca son coste</td><td>' +
          rmb0(r.refundableCapex) +
          '</td><td><span class="calc-table__na">-</span></td></tr>';
      } else {
        rows +=
          '<tr class="calc-table__prompt"><td colspan="3">Introduzca su margen bruto abajo (abra «Ajuste fino de cada dato» y vaya a la pestaña «Sus márgenes») para ver el resultado operativo del año 1 y del año 2.</td></tr>';
      }
      body.innerHTML = rows;
    }

    function renderResults() {
      const i = state.i;
      const r = state.r;
      const roas = i.roas || 0;
      document.getElementById('calc-results-sub').textContent =
        'Sobre un GMV de ' + rmb0(i.gmv || 0) + ', ' + Math.round(r.orders).toLocaleString('es-ES') + ' pedidos al año con un ticket medio de ' + rmb0(i.aov || 0) + ' y un ROAS de ' + roas + 'x. El año 2 asume un GMV de ' + rmb0(r.gmv2) + ' (+' + Math.round((i.gmvGrowth || 0) * 100) + ' %).';
      renderFocus();
      renderTable();
      results.hidden = false;
      results.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
    }

    // export to PDF via the browser print dialog (no dependency, China-safe)
    function exportPdf() {
      const detail = document.querySelector('.calc-detail');
      if (detail) detail.open = true; // make sure the full table prints
      window.print();
    }
    document.querySelectorAll('[data-export-pdf]').forEach((btn) => btn.addEventListener('click', exportPdf));

    // year tabs (Year 1 / Year 2). There is more than one group on the page
    // (the toolbar and the "Where the money goes" header), so switching one
    // keeps every group in sync by matching on data-year.
    function setYear(year) {
      activeYear = year;
      document.querySelectorAll('.calc-period__tab').forEach((t) => {
        const on = t.getAttribute('data-year') === year;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      renderFocus();
    }
    document.querySelectorAll('.calc-period__tab').forEach((tab) => {
      tab.addEventListener('click', () => setYear(tab.getAttribute('data-year')));
    });

    // ---------- lead payload ----------
    function leadPayloadExtras(r) {
      const inputs = [];
      form.querySelectorAll('input[data-kind]').forEach((el) => {
        const label = el.getAttribute('data-label') || el.name;
        const kind = el.getAttribute('data-kind');
        let val = el.value.trim();
        if (val === '') val = '(sin definir)';
        else if (kind === 'money') val = 'RMB ' + Number(val).toLocaleString('es-ES');
        else if (kind === 'percent') val = val + '%';
        inputs.push({ label, value: val });
      });
      const out = [
        { label: 'Salida de caja total del año 1', value: rmb0(r.s.total) + ' / ' + usd0(r.s.totalUSD) },
        { label: 'Arranque, desembolso único', value: rmb0(r.setupTotal) + ', de los cuales ' + rmb0(r.refundableCapex) + ' reembolsables' },
        { label: 'Amortización del arranque, por año', value: rmb0(r.amortY1) + ' en ' + r.amortYears + ' años' },
        { label: 'Coste operativo, año 1 (con amortización)', value: rmb0(r.s.opTotal) },
        { label: 'Coste operativo, año 2 (con amortización)', value: rmb0(r.s.opTotal2) },
        { label: 'GMV previsto para el año 2', value: rmb0(r.gmv2) },
        { label: 'Caja realmente gastada, año 1', value: rmb0(r.s.netSunk) },
        { label: 'Coste por pedido', value: rmb0(r.s.costPerOrder) },
        { label: 'Coste sobre el GMV', value: pct1(r.s.totalPctGmv) },
      ];
      if (r.hasGm) {
        const be = typeof r.s.breakeven === 'string' ? r.s.breakeven : rmb0(r.s.breakeven);
        out.push({ label: 'Resultado operativo, año 1 (con amortización)', value: rmb0(r.s.contribution) });
        out.push({ label: 'GMV de equilibrio', value: be });
      }
      return { inputs, results: out };
    }

    // ---------- gate ----------
    let lastFocus = null;
    function openGate() {
      lastFocus = document.activeElement;
      gate.hidden = false;
      gate.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      const first = document.getElementById('lead-name');
      if (first) first.focus();
    }
    function closeGate() {
      gate.hidden = true;
      gate.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }
    gate.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeGate));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !gate.hidden) closeGate();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const badMixNote = !mixIs100 ? 'mix-note' : !mix2Is100 ? 'mix-note-2' : null;
      if (badMixNote) {
        const note = document.getElementById(badMixNote);
        if (note) {
          note.classList.add('calc-mix--shake');
          note.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(() => note.classList.remove('calc-mix--shake'), 500);
        }
        return;
      }
      const i = readInputs();
      state = { i, r: compute(i) };
      if (unlocked) {
        // Already gave us their email: recompute and reveal, no gate.
        renderResults();
        results.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        openGate();
      }
    });

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    gateForm.addEventListener('submit', (e) => {
      e.preventDefault();
      gateStatus.textContent = '';
      gateStatus.className = 'calc-gate__status';
      const data = new FormData(gateForm);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const company = String(data.get('company') || '').trim();
      if (!name || !EMAIL_RE.test(email)) {
        gateStatus.textContent = 'Indique su nombre y un correo profesional válido.';
        gateStatus.classList.add('calc-gate__status--error');
        return;
      }

      // Capture the lead in the background. The reveal never waits on it, so a
      // mail-backend hiccup can't block the visitor from seeing their numbers.
      const extras = state ? leadPayloadExtras(state.r) : { inputs: [], results: [] };
      fetch('/api/calculator-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, company, inputs: extras.inputs, results: extras.results }),
      }).catch(() => {
        /* lead capture is best-effort; ignore failures */
      });

      // Remember the visitor so re-runs never ask again.
      unlocked = true;
      try {
        sessionStorage.setItem('tmallCalcUnlocked', '1');
      } catch (_) {
        /* storage disabled: unlock still holds for this session */
      }
      paintCta();

      // Reveal the Cost Stack results immediately.
      closeGate();
      renderResults();
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

