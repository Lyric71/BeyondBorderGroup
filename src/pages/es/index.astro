const allCases = await getCollection('casesEs', ({ data }) => !data.draft);
const featuredCases = allCases
  .slice()
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const allInsights = await getCollection('insightsEs', ({ data }) => !data.draft);

const insightCategoryEs: Record<string, string> = {
  Platforms: 'Plataformas',
  'E-Commerce': 'eCommerce',
  'KOLs & Livestream': 'KOL y livestream',
  'Brand & Localization': 'Marca y localización',
  'AI & Innovation': 'IA e innovación',
  'Market Strategy': 'Estrategia de mercado',
  'Compliance & Setup': 'Cumplimiento y puesta en marcha',
};

const latestInsights = allInsights
  .slice()
  .sort((a, b) => {
    const da = a.data.pubDate?.valueOf() ?? 0;
    const db = b.data.pubDate?.valueOf() ?? 0;
    return db - da;
  })
  .slice(0, 3);

function readingTime(body: string | undefined) {
  if (!body) return '';
  const words = body.trim().split(/\s+/).length;
  return `${Math.max(1, Math.round(words / 200))} min de lectura`;
}

function formatInsightDate(d?: Date) {
  if (!d) return '';
  return d.toLocaleDateString('es-ES', { month: 'short', year: 'numeric' });
}
---

<Layout
  title="Agencia de marketing y eCommerce en China | TheChinaPath"
  description="Agencia de marketing, eCommerce y distribución para marcas internacionales en China. Operamos Tmall, JD, Douyin, WeChat y RED a diario. Shanghái, Hong Kong, París."
  preloadImage="/Images/hero-livestream.webp"
>
  {/* ---------- SCROLL PROGRESS ---------- */}
  <div class="home-progress" aria-hidden="true"><div class="home-progress__bar"></div></div>

  {/* ---------- HERO ---------- */}
  <section class="home-hero" data-home-hero>
    <div class="home-hero__bg" aria-hidden="true" data-home-parallax>
      <picture>
        <source srcset="/Images/hero-livestream.webp" type="image/webp" />
        <img
          src="/Images/hero-livestream.jpg"
          alt="Presentadora china de livestream commerce en plató, mostrando productos a una audiencia conectada"
          width="1376"
          height="768"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>
    <div class="home-hero__overlay" aria-hidden="true"></div>
    <div class="home-hero__grain" aria-hidden="true"></div>

    <div class="container home-hero__inner">
      <span class="eyebrow eyebrow--on-dark home-reveal">Marketing y eCommerce en China</span>
      <h1 class="home-hero__title home-reveal" style="--reveal-delay: 80ms;">
        <span class="home-hero__title-row">Vender en China.</span>
        <span class="home-hero__title-row home-hero__title-row--accent">Crecer en China.</span>
        <span class="home-hero__title-row home-hero__title-row--highlight">Entender China.</span>
      </h1>
      <p class="home-hero__lead home-reveal" style="--reveal-delay: 200ms;">
        Ponemos a las marcas a facturar en China. Tiendas en Tmall y JD, social commerce en Douyin y
        RED, y el distribuidor que encaja con su categoría.
      </p>
      <div class="home-hero__actions home-reveal" style="--reveal-delay: 280ms;">
        <a class="btn btn--primary home-magnetic" href="/es/contacto">Hablemos</a>
        <a class="btn btn--primary home-magnetic" href="/es/herramientas">Budget Calculator</a>
        <a class="btn btn--ghost-light home-magnetic" href="/es/proyectos">Ver nuestros proyectos</a
        >
      </div>

      <div class="home-hero__meta home-reveal" style="--reveal-delay: 360ms;">
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num" data-home-counter="15" data-suffix="+">0</span>
          <span class="home-hero__meta-label">años en China</span>
        </div>
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num" data-home-counter="75" data-suffix="+">0</span>
          <span class="home-hero__meta-label">marcas lanzadas</span>
        </div>
        <div class="home-hero__meta-item">
          <span class="home-hero__meta-num">Millones</span>
          <span class="home-hero__meta-label">de GMV bajo gestión</span>
        </div>
      </div>
    </div>

    <a href="#day-commerce" class="home-hero__scroll" aria-label="Bajar a la siguiente sección">
      <span class="home-hero__scroll-line"></span>
      <span class="home-hero__scroll-text">Bajar</span>
    </a>
  </section>

  {/* ---------- DAY IN CHINESE COMMERCE ---------- */}
  <section id="day-commerce" class="section day-timeline-section">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Un día en el comercio chino</span>
        <h2>Su marca, en cada momento del día</h2>
        <p class="section-header__lead">
          El consumidor chino salta entre media docena de apps antes de comer. Cada una tiene su
          público y su forma de vender.
        </p>
      </header>

      <ol class="day-timeline" aria-label="Un día en las plataformas chinas">
        {
          dayStops.map((s) => (
            <li class="day-stop">
              <figure class="day-stop__photo">
                <img src={s.photo} alt="" loading="lazy" decoding="async" />
              </figure>
              <div class="day-stop__info">
                <span class="day-stop__time">{s.time}</span>
                <span class="day-stop__moment">{s.moment}</span>
                <span class="day-stop__platform">
                  <img class="day-stop__logo" src={s.logo} alt="" loading="lazy" decoding="async" />
                  <span class="day-stop__platform-text">
