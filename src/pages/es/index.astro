            <figure class="studio__frame studio__frame--sub" aria-hidden="true">
              <img src="/Images/hub-studio/production.jpg" alt="" loading="lazy" decoding="async" />
            </figure>
            <div class="studio__brace studio__brace--tl" aria-hidden="true"></div>
            <div class="studio__brace studio__brace--br" aria-hidden="true"></div>
          </div>
        </div>

        {/* ----- Capability switcher ----- */}
        <div class="studio__switch" data-reveal>
          <div class="studio__tabs" role="tablist" aria-label="Capacidades de Hub Studio">
            <span class="studio__tabs-indicator" aria-hidden="true"></span>
            <button
              type="button"
              class="studio__tab is-active"
              role="tab"
              data-tab="creative"
              aria-selected="true"
              aria-controls="studio-panel-creative"
              id="studio-tab-creative"
            >
              <span class="studio__tab-mark" aria-hidden="true"></span>
              <span class="studio__tab-label">Creatividad</span>
              <span class="studio__tab-sub">Concepto · dirección</span>
            </button>
            <button
              type="button"
              class="studio__tab"
              role="tab"
              data-tab="production"
              aria-selected="false"
              aria-controls="studio-panel-production"
              id="studio-tab-production"
            >
              <span class="studio__tab-mark" aria-hidden="true"></span>
              <span class="studio__tab-label">Producción</span>
              <span class="studio__tab-sub">Foto · cine · live</span>
            </button>
            <button
              type="button"
              class="studio__tab"
              role="tab"
              data-tab="ai"
              aria-selected="false"
              aria-controls="studio-panel-ai"
              id="studio-tab-ai"
            >
              <span class="studio__tab-mark" aria-hidden="true"></span>
              <span class="studio__tab-label">Producción IA</span>
              <span class="studio__tab-sub">Pipelines a medida</span>
            </button>
          </div>

          <div class="studio__panels">
            <article
              class="studio__panel is-active"
              data-panel="creative"
              id="studio-panel-creative"
              role="tabpanel"
              aria-labelledby="studio-tab-creative"
            >
              <div class="studio__panel-visual">
                <img src="/Images/hub-studio/creative.jpg" alt="" loading="lazy" decoding="async" />
                <div class="studio__tags">
                  <span>Concepto</span>
                  <span>Dirección artística</span>
                  <span>Visuales clave</span>
                </div>
              </div>
              <div class="studio__panel-copy">
                <span class="studio__panel-kicker">
                  <span class="studio__panel-kicker-dot" aria-hidden="true"></span>
                  Creatividad
                </span>
                <h3 class="studio__panel-title">
                  Trabajo que aguanta junto al de las marcas chinas.
                </h3>
                <p class="studio__panel-body">
                  Visuales clave, ideas de campaña, packaging, OOH. Pensados para las apps en las
                  que entra de verdad su comprador: Xiaohongshu, Douyin, WeChat, Tmall.
                </p>
                <ul class="studio__list">
                  <li>Dirección creativa al servicio de la marca</li>
                  <li>Visuales clave para Xiaohongshu y Douyin</li>
                  <li>Packaging y OOH que viajan</li>
                </ul>
              </div>
            </article>

            <article
              class="studio__panel"
              data-panel="production"
              id="studio-panel-production"
              role="tabpanel"
              aria-labelledby="studio-tab-production"
              hidden
            >
              <div class="studio__panel-visual">
                <img
                  src="/Images/hub-studio/production.jpg"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <div class="studio__tags">
                  <span>Foto</span>
                  <span>Cine</span>
                  <span>Livestream</span>
                </div>
              </div>
              <div class="studio__panel-copy">
                <span class="studio__panel-kicker">
                  <span class="studio__panel-kicker-dot" aria-hidden="true"></span>
                  Producción
                </span>
                <h3 class="studio__panel-title">Equipos sobre el terreno, edición en casa.</h3>
                <p class="studio__panel-body">
                  Equipo base en Shanghái. Rodajes en Pekín, Shenzhen y Cantón cuando el brief lo
                  pide. Días de estudio, días de localización, sala de edición. Todo bajo un mismo
                  techo.
                </p>
                <ul class="studio__list">
                  <li>Rodajes en estudio y en localización</li>
                  <li>Equipo y montaje, todo en casa</li>
                  <li>Platós de livestream y operación en directo</li>
                </ul>
              </div>
            </article>

            <article
              class="studio__panel"
              data-panel="ai"
              id="studio-panel-ai"
              role="tabpanel"
              aria-labelledby="studio-tab-ai"
              hidden
            >
              <div class="studio__panel-visual">
                <img src="/Images/hub-studio/aigc.jpg" alt="" loading="lazy" decoding="async" />
                <div class="studio__tags">
                  <span>AIGC</span>
                  <span>Últimos modelos</span>
                  <span>Volumen</span>
                </div>
              </div>
              <div class="studio__panel-copy">
                <span class="studio__panel-kicker">
                  <span class="studio__panel-kicker-dot" aria-hidden="true"></span>
                  Producción IA
                </span>
                <h3 class="studio__panel-title">
                  AIGC con los modelos que de verdad valen la pena.
                </h3>
                <p class="studio__panel-body">
                  Contenido generado con IA sobre los mejores modelos de texto a imagen y de vídeo
                  del momento. Producto, moda, lifestyle, social, eCommerce de gran volumen. Cada
                  frame pasa por ojo humano antes de salir.
                </p>
                <ul class="studio__list">
                  <li>Últimos modelos de texto a imagen y de vídeo</li>
                  <li>Estilo y mirada propios de cada marca</li>
                  <li>Revisión humana en cada frame</li>
                </ul>
              </div>
            </article>
          </div>
        </div>

        {/* ----- Capability ribbon ----- */}
        <div class="studio__ribbon" aria-hidden="true">
          <div class="studio__ribbon-track">
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Foto</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Cine</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Livestream</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Pipelines IA</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Packaging</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>OOH</span>
            <span class="studio__chip"
              ><span class="studio__chip-bullet"></span>Visuales de marca</span
            >
            <span class="studio__chip"
              ><span class="studio__chip-bullet"></span>Montajes social-first</span
            >
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Foto</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Cine</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Livestream</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Pipelines IA</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>Packaging</span>
            <span class="studio__chip"><span class="studio__chip-bullet"></span>OOH</span>
            <span class="studio__chip"
              ><span class="studio__chip-bullet"></span>Visuales de marca</span
            >
            <span class="studio__chip"
              ><span class="studio__chip-bullet"></span>Montajes social-first</span
            >
          </div>
        </div>

        {/* ----- Footer CTA ----- */}
        <div class="studio__foot" data-reveal>
          <a class="studio__cta" href="/es/crecer-en-china/estudio-de-produccion">
            <span class="studio__cta-text">Ver el trabajo de producción</span>
            <span class="studio__cta-arrow" aria-hidden="true">
              <svg
                width="22"
                height="14"
                viewBox="0 0 22 14"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M1 7H21M21 7L15 1M21 7L15 13"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </a>
          <a
            class="studio__cta studio__cta--secondary"
            href="https://www.hubstudio.ai"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="studio__cta-text">O visite hubstudio.ai</span>
            <span class="studio__cta-external" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- OUR WORK ---------- */}
  <section class="section section--alt">
    <div class="container">
      <header class="section-header section-header--split">
        <div>
          <span class="eyebrow">Proyectos</span>
          <h2>Marcas que hemos construido en China</h2>
        </div>
        <a href="/es/proyectos" class="btn btn--secondary btn--sm">Ver todos los casos</a>
      </header>

      <div class="grid grid-3">
        {
          featuredCases.map((c) => (
            <a href={`/es/proyectos/${c.id}`} class="work-card">
              <div class="work-card__image">
                <img
                  src={c.data.heroImage}
                  alt={c.data.heroImageAlt || `Caso ${c.data.brand}`}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="400"
                />
              </div>
              <div class="work-card__body">
                <span class="work-card__tag">{c.data.category}</span>
                <h3 class="work-card__title">{c.data.brand}</h3>
                <p class="work-card__summary">{c.data.title}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- INSIGHTS ---------- */}
  <section class="section">
    <div class="container">
      <header class="insights-header">
        <span class="insights-header__rule" aria-hidden="true"></span>
        <span class="eyebrow">Análisis</span>
        <h2>Nuestra lectura del mercado chino, ahora mismo</h2>
      </header>

      <div class="grid grid-3">
        {
          latestInsights.map((post) => (
            <a href={`/es/analisis/${post.id}`} class="insight-card">
              <div class="insight-card__image">
                {post.data.heroImage && (
                  <img
                    src={post.data.heroImage}
                    alt={post.data.heroImageAlt}
                    loading="lazy"
                    decoding="async"
                    width="600"
                    height="400"
                  />
                )}
              </div>
              <div class="insight-card__body">
                <span class="insight-card__tag">
                  {insightCategoryEs[post.data.category] ?? post.data.category}
                </span>
                <h3 class="insight-card__title">{post.data.title}</h3>
                <div class="insight-card__meta">
                  <span>{readingTime(post.body)}</span>
                  {post.data.pubDate && (
                    <>
                      <span class="insight-card__meta-sep" aria-hidden="true">
                        |
                      </span>
                      <span>{formatInsightDate(post.data.pubDate)}</span>
                    </>
                  )}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------- FINAL CTA CARD ---------- */}
  <section class="section section--tight">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__copy">
          <span class="eyebrow">Diga hola</span>
          <h2>¿Pensando en China? Tomemos un café.</h2>
          <p class="cta-card__lead">
            Cuéntenos dónde está hoy y adónde quiere llegar. Le contesta un sénior del equipo, no un
            chatbot ni un embudo de ventas.
          </p>
          <div class="cta-card__actions">
            <a href="/es/contacto" class="btn btn--primary">Empezar la conversación</a>
          </div>
        </div>

        <div class="cta-card__visual" aria-hidden="true">
          <div class="hello-stack">
            <article class="hello-card hello-card--1">
              <header class="hello-card__head">
                <span class="hello-card__avatar">上</span>
                <div>
                  <span class="hello-card__city">Shanghái</span>
                  <span class="hello-card__role">Operaciones</span>
                </div>
                <span class="hello-card__dot" title="en línea"></span>
              </header>
              <p class="hello-card__hi">
                <span class="hello-card__zh">你好</span>
                <span class="hello-card__latin">Nǐ hǎo</span>
              </p>
            </article>

            <article class="hello-card hello-card--2">
              <header class="hello-card__head">
                <span class="hello-card__avatar">港</span>
                <div>
                  <span class="hello-card__city">Hong Kong</span>
                  <span class="hello-card__role">Cross-border</span>
                </div>
                <span class="hello-card__dot" title="en línea"></span>
              </header>
              <p class="hello-card__hi">
                <span class="hello-card__zh">你好</span>
                <span class="hello-card__latin">Neih hóu</span>
              </p>
            </article>

            <article class="hello-card hello-card--3">
              <header class="hello-card__head">
                <span class="hello-card__avatar">P</span>
                <div>
                  <span class="hello-card__city">París</span>
                  <span class="hello-card__role">Entrada al mercado</span>
                </div>
                <span class="hello-card__dot" title="en línea"></span>
              </header>
              <p class="hello-card__hi"><span class="hello-card__zh">Hola</span></p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  <HomeAssets />
</Layout>
