---
import Layout from '../../layouts/Layout.astro';
import { personSchema, aboutPageSchema, PERSON_IDS } from '../../lib/seo';

const team = [
  {
    name: 'Cyril Drouin',
    role: 'Fundador y CEO',
    base: 'Shanghái / París',
    photo: '/Images/team/cyril-drouin.jpg',
    bio: 'Veinticinco años entre digital, publicidad y comercio. Ex CEO de Publicis Commerce y Performance Marketing para China y el norte de Asia. Pone la estrategia sobre el papel. Lleva la casa.',
    linkedin: 'https://www.linkedin.com/in/cyril-d-68835729/',
    twitter: 'https://twitter.com/CyrilDrouin',
    substack: 'https://cyrildrouin.substack.com',
  },
  {
    name: 'Echo Peng',
    role: 'Directora sénior y socia',
    base: 'Shanghái',
    photo: '/Images/team/echo-peng.jpg',
    bio: 'Dieciocho años al frente del eCommerce y el digital de marcas internacionales en China. Ex directora de operaciones en Publicis China. Manda en las plataformas y en el día a día de cada cuenta.',
    linkedin: 'https://www.linkedin.com/in/echo-peng-aa241751/',
  },
];

const credentials = [
  {
    title: 'Ex directores en agencias 4A',
    body: 'En Publicis montábamos estrategias de crecimiento en China y el norte de Asia para carteras globales. Planes de entrada al mercado, manuales de plataforma, dosieres de distribuidores. El trabajo por el que las marcas pagan a las 4A lo firmábamos nosotros.',
    image: '/Images/about/credentials/01-4a-directors.png',
  },
  {
    title: 'Operadores de plataforma, no comentaristas',
    body: 'Comercio y contenido en Tmall, JD, Douyin y Xiaohongshu. Sabemos cómo premia cada plataforma a una marca de verdad, no la versión que cabe en una presentación de venta.',
    image: '/Images/about/credentials/02-platform-strategists.png',
  },
  {
    title: 'Hemos atravesado China en tres ciclos',
    body: 'Hemos hecho aterrizar en China a docenas de marcas internacionales. Cambios regulatorios, recolocación del tablero competitivo y el vuelco de un comercio guiado por la tienda a uno guiado por el contenido. El manual de 2018 no aguanta en 2025. Sabemos qué hay que tirar.',
    image: '/Images/about/credentials/03-brand-architects.png',
  },
  {
    title: 'Sin hueco entre estrategia y ejecución',
    body: 'Quien escribe su hoja de ruta china es quien cuadra su cuenta de Tmall a cierre de mes. El mismo hilo de correo del kickoff a la revisión trimestral. Sin reenvíos a un equipo júnior al que usted nunca le ha visto la cara.',
    image: '/Images/about/credentials/04-no-gap.png',
  },
  {
    title: 'Probado en todas las categorías',
    body: 'Hemos lanzado marcas de belleza en Xiaohongshu. Hemos sacado del bache las ventas de alimentación en Tmall. Hemos construido consideración para automoción en Douyin desde cero. Categorías distintas, los mismos operadores al pie del cañón.',
    image: '/Images/about/credentials/05-categories.png',
  },
];

const principles = [
  {
    title: 'Su éxito no se subcontrata',
    body: 'La estratega que planifica su entrada en China es la misma que lanza sus anuncios en Douyin a las dos de la madrugada, hora de Pekín. Sin relevos júnior por el camino.',
    icon: 'hands',
  },
  {
    title: 'Solo cogemos proyectos que sabemos ganar',
    body: 'Si un proyecto queda fuera de nuestro terreno, lo rechazamos. Y si no vemos manera de mover la aguja en China, será lo primero que le digamos.',
    icon: 'target',
  },
  {
    title: 'Pensamos cross-border, no exportación',
    body: 'China no es su mercado de origen traducido. Las pasarelas de pago, las plataformas y los hábitos del consumidor juegan por su cuenta, y una marca que no lo pilla entrega trabajo elegante que no compra nadie.',
    icon: 'globe',
  },
  {
    title: 'Conocemos la mecánica por dentro',
    body: 'Ranking en Tmall, moderación en Xiaohongshu, tracking en WeChat. Llevamos quince años rompiendo estas plataformas, arreglándolas y montándonos encima.',
    icon: 'gears',
  },
  {
    title: 'Tenemos los teléfonos',
    body: 'Veinticinco años en China quieren decir saber a quién llamar cuando una plataforma cambia las reglas de la noche a la mañana. Distribuidores que descuelgan, partners TP que no desaparecen después del onboarding, agencias de KOL que sí filtran a sus talentos.',
    icon: 'network',
  },
  {
    title: 'Hemos pasado por su silla',
    body: 'Antes de TheChinaPath llevábamos equipos de commerce en Publicis. P&L de tiendas flagship. Sanciones de plataforma negociadas a las tres de la madrugada, hora de Pekín.',
    icon: 'chair',
  },
];

const principleIcon: Record<string, string> = {
  hands:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11V5a1.5 1.5 0 0 1 3 0v5"/><path d="M12 10V4a1.5 1.5 0 0 1 3 0v7"/><path d="M15 11V6a1.5 1.5 0 0 1 3 0v9"/><path d="M18 11V8a1.5 1.5 0 0 1 3 0v7a6 6 0 0 1-6 6H9a5 5 0 0 1-4.5-2.8L2 13.5a1.5 1.5 0 0 1 2.6-1.4L6 14"/></svg>',
  target:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><circle cx="12" cy="12" r="2" fill="currentColor" stroke="none"/></svg>',
  globe:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a13 13 0 0 1 0 18"/><path d="M12 3a13 13 0 0 0 0 18"/></svg>',
  gears:
