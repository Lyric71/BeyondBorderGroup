const aboutSchema = [
  aboutPageSchema('es'),
  personSchema({
    id: PERSON_IDS.cyril,
    name: 'Cyril Drouin',
    jobTitle: 'Fundador y CEO',
    description:
      '25 años en digital, publicidad y comercio. Antiguo CEO de Publicis Commerce y Performance Marketing para China y el norte de Asia.',
    image: '/Images/team/cyril-drouin.jpg',
    sameAs: [
      'https://www.linkedin.com/in/cyril-d-68835729/',
      'https://twitter.com/CyrilDrouin',
      'https://cyrildrouin.substack.com',
    ],
    workLocations: ['Shanghái', 'París'],
  }),
  personSchema({
    id: PERSON_IDS.echo,
    name: 'Echo Peng',
