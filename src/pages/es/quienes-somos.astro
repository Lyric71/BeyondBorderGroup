  }
  :global(.home-hero__meta-label) {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.66);
    letter-spacing: 0.02em;
  }

  :global(.home-hero__scroll) {
    position: absolute;
    bottom: var(--space-5);
    right: clamp(var(--space-5), 4vw, var(--space-7));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    transition: color 200ms ease;
  }
  :global(.home-hero__scroll:hover) {
    color: var(--bbg-white);
  }
  :global(.home-hero__scroll-line) {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.6) 100%);
    position: relative;
    overflow: hidden;
  }
  :global(.home-hero__scroll-line::after) {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(180deg, transparent 0%, var(--bbg-white) 100%);
    animation: about-home-scroll-tick 1.8s ease-in-out infinite;
  }
  @keyframes about-home-scroll-tick {
    0% {
      top: -50%;
    }
    100% {
      top: 100%;
    }
  }
  @media (max-width: 720px) {
    :global(.home-hero__scroll) {
      display: none;
    }
    :global(.home-hero__meta) {
      gap: var(--space-4);
    }
  }

  /* Reveal motion + magnetic hover (scoped to hero) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.home-hero .home-reveal) {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
        transform 700ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms);
    }
    :global(.home-hero .home-reveal.is-in) {
      opacity: 1;
      transform: translateY(0);
    }
    :global(.home-hero .home-magnetic) {
      will-change: transform;
      transition:
        transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1),
        box-shadow 220ms ease,
        background-color 200ms ease,
        color 200ms ease;
    }
    :global(.home-hero .home-magnetic:hover) {
      transform: translateY(-2px);
    }
  }

  /* ---------- Why we exist: split with signature ---------- */
  .about-split {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }
  .about-split__copy {
    max-width: 62ch;
  }

  .about-signature {
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    border-left: 3px solid var(--bbg-blue);
  }
  .about-signature figure {
    margin: 0;
  }
  .about-signature img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 360px;
    margin: 0 auto var(--space-4);
  }
  .about-signature figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: var(--space-4);
    border-top: 1px solid var(--bbg-border);
    text-align: center;
  }
  .about-signature figcaption strong {
    color: var(--bbg-ink);
    font-weight: 600;
    font-size: var(--fs-body);
  }
  .about-signature figcaption span {
    color: var(--bbg-text-muted);
    font-size: var(--fs-small);
  }

  @media (max-width: 1024px) {
    .about-split {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Team cards ---------- */
  .team-grid {
    gap: var(--space-6);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 760px;
    margin-inline: auto;
  }
  .team-card {
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .team-card:hover {
    transform: translateY(-4px);
    border-color: var(--bbg-blue);
    box-shadow: var(--shadow-md);
  }
  .team-card__photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bbg-surface);
  }
  .team-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 400ms var(--ease);
  }
  .team-card:hover .team-card__photo img {
    transform: scale(1.03);
  }

  .team-card__body {
    padding: var(--space-5) var(--space-6) var(--space-6);
  }
  .team-card__name {
    font-size: var(--fs-h3);
    margin-bottom: 2px;
    color: var(--bbg-ink);
  }
  .team-card__role {
    display: block;
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--bbg-blue);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 2px;
  }
  .team-card__base {
    display: block;
    font-size: var(--fs-small);
    color: var(--bbg-text-muted);
    margin-bottom: var(--space-4);
  }
  .team-card__body p {
    font-size: var(--fs-body);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .team-card__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-3);
  }
  .team-card__links a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--bbg-blue-light);
    color: var(--bbg-blue);
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .team-card__links a:hover {
    background: var(--bbg-blue);
    color: var(--bbg-white);
    transform: translateY(-2px);
  }
  .team-card__links svg {
    width: 16px;
    height: 16px;
  }

  /* ============================================================
     Strategic leadership / Credentials rotator
     ============================================================ */
  .creds {
    position: relative;
    overflow: hidden;
  }
  .creds__decor {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .creds__decor-rule {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.06) 30%,
      rgba(0, 0, 0, 0.06) 70%,
      transparent 100%
    );
  }
  .creds__decor-rule:nth-child(1) {
    left: 12%;
  }
  .creds__decor-rule:nth-child(2) {
    right: 12%;
  }

  .creds__header {
    max-width: 880px;
  }
  .creds__eyebrow-bar {
    display: inline-block;
    width: 28px;
    height: 1px;
    background: var(--bbg-blue);
    vertical-align: middle;
    margin-right: var(--space-2);
  }
  .creds__lead {
    color: var(--bbg-text-muted);
    margin-top: var(--space-3);
    max-width: 60ch;
  }

  /* Scroll reveal scoped to credentials */
  [data-creds-reveal] {
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    transition:
      opacity 650ms var(--ease),
      transform 650ms var(--ease);
  }
  [data-creds-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }

  .creds__stage {
    position: relative;
    margin-top: var(--space-7);
    display: grid;
    grid-template-rows: auto auto;
    gap: var(--space-5);
  }

  /* ---- Featured slide panel ---- */
  .cred-feature {
    position: relative;
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    min-height: 460px;
    isolation: isolate;
  }
  .cred-feature__slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    opacity: 0;
    visibility: hidden;
    transform: scale(1.01);
    transition:
      opacity 600ms var(--ease),
      transform 800ms var(--ease),
      visibility 600ms;
    pointer-events: none;
  }
  .cred-feature__slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    pointer-events: auto;
    z-index: 1;
  }
  .cred-feature__visual {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--bbg-surface);
  }
  .cred-feature__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transform: scale(1.04);
    transition: transform 9s linear;
  }
  .cred-feature__slide.is-active .cred-feature__visual img {
    transform: scale(1.12);
  }
  .cred-feature__visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, transparent 55%, rgba(255, 255, 255, 0.6) 100%);
    pointer-events: none;
  }
  .cred-feature__chip {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(8, 14, 24, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--bbg-white);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
    z-index: 2;
  }
  .cred-feature__body {
    padding: clamp(var(--space-5), 3.5vw, var(--space-7));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
  }
  .cred-feature__eyebrow {
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--bbg-blue);
  }
  .cred-feature__title {
    font-size: clamp(1.5rem, 1.4vw + 0.9rem, 2.1rem);
    line-height: 1.15;
    margin: 0;
    color: var(--bbg-ink);
  }
  .cred-feature__copy {
    color: var(--bbg-text);
    line-height: 1.65;
    margin: 0;
  }
  .cred-feature__progress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: rgba(200, 16, 46, 0.1);
    z-index: 3;
  }
  .cred-feature__progress span {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--bbg-blue), #c8102e);
    transition: width 100ms linear;
  }

  /* ---- Thumbnail rail ---- */
  .cred-rail {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .cred-rail__item {
    display: flex;
  }
  .cred-thumb {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: var(--bbg-ink);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }
  .cred-thumb:hover {
    border-color: var(--bbg-blue);
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
  }
  .cred-thumb.is-active {
    border-color: var(--bbg-blue);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
    background: linear-gradient(180deg, var(--bbg-white) 0%, var(--bbg-blue-light) 100%);
  }
  .cred-thumb__visual {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--bbg-surface);
    border: 1px solid var(--bbg-border);
  }
  .cred-thumb__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.85);
    transition:
      filter var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .cred-thumb:hover .cred-thumb__visual img,
  .cred-thumb.is-active .cred-thumb__visual img {
    filter: saturate(1.05);
    transform: scale(1.04);
  }
  .cred-thumb__title {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--bbg-ink);
    line-height: 1.35;
  }
  .cred-thumb__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    color: rgba(0, 0, 0, 0.3);
    transition:
      color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .cred-thumb__arrow svg {
    width: 16px;
    height: 16px;
  }
  .cred-thumb:hover .cred-thumb__arrow,
  .cred-thumb.is-active .cred-thumb__arrow {
    color: var(--bbg-blue);
    transform: translateX(3px);
  }

  /* Restack the feature slide at tablet portrait too. At 721-1024 the
     1.05fr/1fr split crushed the visual to ~50% of an 800px viewport. */
  @media (max-width: 1024px) {
    .cred-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .cred-feature {
      min-height: auto;
    }
    .cred-feature__slide {
      position: relative;
      grid-template-columns: 1fr;
      opacity: 1;
      visibility: visible;
      transform: none;
      pointer-events: auto;
      display: none;
    }
    .cred-feature__slide.is-active {
      display: grid;
    }
    .cred-feature__visual {
      aspect-ratio: 16 / 10;
    }
    .cred-feature__visual img {
      transform: none;
    }
    .cred-feature__slide.is-active .cred-feature__visual img {
      transform: none;
    }
  }
  @media (max-width: 720px) {
    .cred-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-creds-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .cred-feature__visual img,
    .cred-feature__slide.is-active .cred-feature__visual img {
      transform: none !important;
      transition: none !important;
    }
    .cred-feature__slide {
      transition:
        opacity 200ms linear,
        visibility 200ms;
      transform: none;
    }
    .cred-feature__progress span {
      transition: none;
    }
  }

  /* ---------- Principles ---------- */
  .principles {
    gap: var(--space-5);
  }
  .principle {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }
  .principle__head {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-5);
  }
  .principle__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--bbg-blue-light);
    color: var(--bbg-blue);
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .principle__icon svg {
    width: 26px;
    height: 26px;
    display: block;
  }
  .principle:hover .principle__icon {
    background: var(--bbg-blue);
    color: var(--bbg-white);
  }

  /* (hub Studio styles moved to /grow-in-china/production-studio.astro) */

  /* ---------- Proof / Clients ---------- */
  .proof-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-7);
    padding: var(--space-6);
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-md);
  }
  .proof-metric {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: center;
  }
  .proof-metric__value {
    font-size: clamp(2rem, 2.4vw + 1rem, 3rem);
    font-weight: 700;
    line-height: 1;
    color: var(--bbg-blue);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
  }
  .proof-metric__num {
    display: inline-block;
  }
  .proof-metric__suffix {
    display: inline-block;
  }
  .proof-metric__label {
    font-size: var(--fs-small);
    color: var(--bbg-text-muted);
    line-height: 1.4;
  }

  .client-ticker {
    --ticker-logo-h: 64px;
    --ticker-logo-w: 200px;
    --ticker-gap: clamp(36px, 4.5vw, 72px);
    --ticker-duration: 95s;
    width: 100%;
    margin: var(--space-5) 0 var(--space-4);
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 12%,
      black 88%,
      transparent 100%
    );
    mask-image: linear-gradient(to right, transparent 0, black 12%, black 88%, transparent 100%);
  }
  .client-ticker__row {
    overflow: hidden;
    padding-block: var(--space-3);
  }

  .client-ticker__track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: var(--ticker-gap);
    animation: client-ticker-scroll var(--ticker-duration) linear infinite;
    will-change: transform;
  }
  .client-ticker__row--reverse .client-ticker__track {
    animation-direction: reverse;
    animation-duration: calc(var(--ticker-duration) * 1.2);
  }
  .client-ticker:hover .client-ticker__track,
  .client-ticker:focus-within .client-ticker__track {
    animation-play-state: paused;
  }

  .client-ticker__item {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .client-ticker .client-ticker__item img {
    display: block;
    width: auto;
    height: auto;
    max-height: var(--ticker-logo-h);
    max-width: var(--ticker-logo-w);
    object-fit: contain;
    opacity: 0.5;
    filter: grayscale(1);
    transition:
      opacity var(--dur) var(--ease),
      filter var(--dur) var(--ease);
  }
  .client-ticker .client-ticker__item:hover img {
    opacity: 1;
    filter: grayscale(0);
  }

  @keyframes client-ticker-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-50% - (var(--ticker-gap) / 2)), 0, 0);
    }
  }

  @media (max-width: 1024px) {
    .client-ticker {
      --ticker-logo-h: 52px;
      --ticker-logo-w: 168px;
    }
  }
  @media (max-width: 520px) {
    .client-ticker {
      --ticker-logo-h: 40px;
      --ticker-logo-w: 132px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-ticker__track {
      animation: none;
      transform: none !important;
    }
    .client-ticker {
      -webkit-mask-image: none;
      mask-image: none;
      overflow-x: auto;
    }
  }

  .proof-note {
    text-align: center;
    color: var(--bbg-text-muted);
    font-size: var(--fs-small);
    max-width: 720px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .proof-metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .proof-metrics {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================================
     Industry recognition / Speaking slider
     ============================================================ */
  .speaking {
    position: relative;
  }
  .speaking__header {
    max-width: 820px;
  }
  .speaking__title {
    margin-bottom: var(--space-4);
  }
  .speaking__lead {
    color: var(--bbg-text);
    margin-bottom: var(--space-4);
  }
  .speaking__lead a {
    color: var(--bbg-blue);
    border-bottom: 1px solid currentColor;
  }
  .speaking__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--bbg-text-muted);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .speaking__meta-dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--bbg-blue);
  }

  /* Reveal scoped to speaking */
  [data-speak-reveal] {
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    transition:
      opacity 700ms var(--ease),
      transform 700ms var(--ease);
  }
  [data-speak-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }

  .speaking__wrap {
    margin-top: var(--space-7);
  }

  /* ---- Ticker (two rows, opposite directions) ---- */
  .speak-ticker {
    --speak-row-h: clamp(180px, 22vw, 280px);
    --speak-gap: clamp(16px, 1.8vw, 28px);
    --speak-duration: 60s;
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--speak-gap);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 6%,
      black 94%,
      transparent 100%
    );
    mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
  }
  .speak-ticker__row {
    overflow: hidden;
  }
  .speak-ticker__track {
    display: flex;
    align-items: center;
