const metrics = [
  { target: 15, suffix: '+', label: 'Años levantando marcas en China' },
  { target: 60, suffix: '+', label: 'Marcas acompañadas en eCommerce, medios y distribución' },
  { target: 100, suffix: '+', label: 'Campañas entregadas en plataformas chinas' },
  { target: 50, suffix: '+', label: 'Proyectos de consultoría para marcas internacionales' },
