const clients = [
  { name: 'Shiseido', logo: '/Images/Clients%20Logos/shiseiso-black-scaled.png' },
  { name: 'Pierre Fabre', logo: '/Images/Clients%20Logos/pierre-black.png' },
  { name: 'iFlytek', logo: '/Images/Clients%20Logos/iflytek-black.png' },
