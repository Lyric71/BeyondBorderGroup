const halfIndex = Math.ceil(clients.length / 2);
const clientsRowA = clients.slice(0, halfIndex);
const clientsRowB = clients.slice(halfIndex);

const speakingPhotos = [
  '/Images/public-speaking/17b417b78e0a412bc58482b29ac8c6b.jpg',
  '/Images/public-speaking/2510bca44deb48662fe871daf352150.jpg',
  '/Images/public-speaking/2cf7dc73b6b0607d091bb88345e2af4.jpg',
  '/Images/public-speaking/30760687b937fdc6fc6282706ce33e6.jpg',
