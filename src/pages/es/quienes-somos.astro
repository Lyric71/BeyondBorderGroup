  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const revealEls = document.querySelectorAll('.home-hero .home-reveal');
      if (revealEls.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-in');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
          );
          revealEls.forEach((el) => io.observe(el));
        }
      }

      const counters = document.querySelectorAll('[data-home-counter]');
      if (counters.length && !reduced && 'IntersectionObserver' in window) {
        const animate = (el) => {
          const target = parseFloat(el.dataset.homeCounter || '0');
          const suffix = el.dataset.suffix || '';
          const duration = 1400;
          const start = performance.now();
          const tick = (now) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = Math.round(target * eased);
            el.textContent = value + suffix;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const counterIo = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animate(entry.target);
                counterIo.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.5 },
        );
        counters.forEach((el) => counterIo.observe(el));
      } else {
        counters.forEach((el) => {
          el.textContent = (el.dataset.homeCounter || '0') + (el.dataset.suffix || '');
        });
      }

      const parallaxImg = document.querySelector('[data-home-parallax] img');
      const heroEl = document.querySelector('[data-home-hero]');
      const progressEl = document.querySelector('.home-progress__bar');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;
          if (parallaxImg && heroEl && !reduced) {
            const heroH = heroEl.offsetHeight;
            if (scrollY < heroH) {
              parallaxImg.style.setProperty('--parallax-y', scrollY * 0.18 + 'px');
            }
          }
          if (progressEl) {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
            progressEl.style.setProperty('--progress', pct + '%');
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const scrollLink = document.querySelector('.home-hero__scroll');
      if (scrollLink) {
        scrollLink.addEventListener('click', (e) => {
          const id = scrollLink.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        });
      }
    })();
  </script>

  <script is:inline>
    (function () {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Counter animation ---- */
      const counters = document.querySelectorAll('[data-counter]');
      const animateCounter = (numEl, target) => {
        if (reduced) {
          numEl.textContent = target.toString();
          return;
        }
        const duration = 1600;
        const start = performance.now();
        const tick = (now) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          numEl.textContent = Math.round(target * eased).toString();
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const counterObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target;
            const target = parseInt(el.dataset.target, 10);
            const numEl = el.querySelector('.proof-metric__num');
            if (!Number.isFinite(target) || !numEl) return;
            numEl.textContent = reduced ? target.toString() : '0';
            animateCounter(numEl, target);
            counterObserver.unobserve(el);
          });
        },
        { threshold: 0.35 },
      );
      counters.forEach((el) => counterObserver.observe(el));

      /* ---- Credentials rotator ---- */
      const credsRoot = document.querySelector('[data-creds]');
      if (credsRoot) {
        const slides = credsRoot.querySelectorAll('.cred-feature__slide');
        const thumbs = credsRoot.querySelectorAll('.cred-thumb');
        const progress = credsRoot.querySelector('.cred-feature__progress span');
        const ROTATE_MS = 7000;
        let activeIdx = 0;
        let timerStart = 0;
        let paused = false;
        let started = false;

        const activate = (idx) => {
          activeIdx = idx;
          slides.forEach((s, i) => {
            const on = i === idx;
            s.classList.toggle('is-active', on);
            s.setAttribute('aria-hidden', on ? 'false' : 'true');
          });
          thumbs.forEach((t, i) => {
            const on = i === idx;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          timerStart = performance.now();
          if (progress) progress.style.width = '0%';
        };

        const tick = (now) => {
          if (paused) {
            requestAnimationFrame(tick);
            return;
          }
          const elapsed = now - timerStart;
          if (progress) progress.style.width = Math.min(100, (elapsed / ROTATE_MS) * 100) + '%';
          if (elapsed >= ROTATE_MS) {
            activate((activeIdx + 1) % slides.length);
          }
          requestAnimationFrame(tick);
        };

        thumbs.forEach((t, i) => {
          t.addEventListener('click', () => activate(i));
          t.addEventListener('mouseenter', () => {
            paused = true;
            activate(i);
          });
          t.addEventListener('mouseleave', () => {
            paused = false;
          });
          t.addEventListener('focus', () => {
            paused = true;
            activate(i);
          });
          t.addEventListener('blur', () => {
            paused = false;
          });
        });

        credsRoot.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          const next =
            e.key === 'ArrowRight'
              ? (activeIdx + 1) % slides.length
              : (activeIdx - 1 + slides.length) % slides.length;
          activate(next);
          const target = thumbs[next];
          if (target instanceof HTMLElement) target.focus();
          e.preventDefault();
        });

        if (!reduced) {
          const startObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting || started) return;
                started = true;
                timerStart = performance.now();
                requestAnimationFrame(tick);
                startObserver.unobserve(credsRoot);
              });
            },
            { threshold: 0.2 },
          );
          startObserver.observe(credsRoot);
        }
      }

      /* ---- Reveal on scroll (scoped) ---- */
      const credsReveals = document.querySelectorAll('[data-creds-reveal]');
      if (credsReveals.length) {
        if (reduced) {
          credsReveals.forEach((el) => el.classList.add('is-revealed'));
        } else {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-revealed');
                revealObserver.unobserve(entry.target);
              });
            },
            { threshold: 0.15, rootMargin: '0px 0px -60px 0px' },
          );
          credsReveals.forEach((el) => revealObserver.observe(el));
        }
      }

      /* ---- Speak reveals ---- */
      const speakReveals = document.querySelectorAll('[data-speak-reveal]');
      if (speakReveals.length) {
        if (reduced) {
          speakReveals.forEach((el) => el.classList.add('is-revealed'));
        } else {
          const speakObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-revealed');
                speakObserver.unobserve(entry.target);
              });
            },
            { threshold: 0.15, rootMargin: '0px 0px -60px 0px' },
          );
          speakReveals.forEach((el) => speakObserver.observe(el));
        }
      }
    })();
  </script>
</Layout>

