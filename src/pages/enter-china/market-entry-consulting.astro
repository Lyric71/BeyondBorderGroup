---
import Layout from '../../layouts/Layout.astro';

const phaseIcons: Record<string, string> = {
  diagnosis: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6"/><line x1="20" y1="20" x2="15.5" y2="15.5"/></svg>`,
  channel: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>`,
  benchmark: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><rect x="4" y="13" width="3" height="7"/><rect x="10" y="8" width="3" height="12"/><rect x="16" y="4" width="3" height="16"/></svg>`,
  blueprint: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="9" x2="9" y2="20"/><line x1="13" y1="13" x2="17" y2="13"/><line x1="13" y1="16" x2="17" y2="16"/></svg>`,
  handshake: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M11 13l2-2 4 4-2 2z"/><path d="M3 12l4-4 5 5"/><path d="M21 12l-4 4-5-5"/><path d="M7 8l5 5"/></svg>`,
  check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 12 10 17 19 8"/></svg>`,
};

const promises = [
  {
    title: 'Decisions backed by operational experience',
    desc: 'Every recommendation tested against the platforms, the regulations and the partners you will work with on the ground. Not desk research.',
  },
  {
    title: 'Phased commitment, not all-in upfront',
    desc: 'Engage one phase at a time. Stop if the answer changes. You stay in control of scope and spend.',
  },
  {
    title: 'Independent distributor sourcing',
    desc: 'We do not take commission from distributors. Your interests, not theirs, sit on our side of the table.',
  },
];

const phases = [
  {
    icon: 'diagnosis',
    phase: 'Phase one',
    duration: '3 to 4 weeks',
    title: 'Market and regulatory diagnosis',
    image: '/Images/enter-china/phase-1-diagnosis.png',
    imageAlt: 'A regulatory specialist reviewing product compliance documents in a Shanghai office',
    intro:
      'We evaluate whether your product can legally sell through Cross-Border eCommerce and assess the competitive landscape.',
    outcome: 'You know if your product can legally land in China, and at what cost.',
    does: [
      'CBEC eligibility assessment (formulation, packaging, labeling compliance)',
      'Regulatory environment analysis and compliance requirements',
      'Competitive landscape mapping and positioning analysis',
      'Market opportunity sizing with realistic demand projections',
    ],
    deliverables: [
      { kind: 'doc', name: 'Feasibility and compliance checklist' },
      { kind: 'report', name: 'Competitor benchmark report' },
      { kind: 'sheet', name: 'Price positioning analysis' },
      { kind: 'sheet', name: 'Opportunity sizing model' },
    ],
  },
  {
    icon: 'channel',
    phase: 'Phase two',
    duration: '2 to 3 weeks',
    title: 'Channel and consumer model assessment',
    image: '/Images/enter-china/phase-2-channel.png',
    imageAlt: 'A consumer scrolling a Chinese eCommerce app on a smartphone in a Shanghai cafe',
    intro:
      'We assess platform options and determine which distribution model makes commercial sense for your product.',
    outcome: 'You know which platforms fit, and which distribution model makes the math work.',
    does: [
      'Platform evaluation (Tmall Global, JD Worldwide, Douyin, RED)',
      'Bonded warehouse vs. direct-mail logistics assessment',
      'Consumer price sensitivity analysis',
      'Platform-specific requirement mapping',
    ],
    deliverables: [
      { kind: 'sheet', name: 'Channel matrix with platform strengths' },
      { kind: 'diagram', name: 'Operations flow diagram' },
      { kind: 'sheet', name: 'Pricing validation across models' },
      { kind: 'report', name: 'Consumer insight report' },
    ],
  },
  {
    icon: 'benchmark',
    phase: 'Phase three',
    duration: '4 to 6 weeks',
    title: 'Competitor deep-dive',
    image: '/Images/enter-china/phase-3-competitors.png',
    imageAlt:
      'A market analyst reviewing competitor dashboards on three monitors in an evening Shanghai office',
    intro:
      'We analyze how successful brands operate in your category across the dimensions that move the needle.',
    outcome: "You know who you're up against, how they price, and where the white space is.",
    does: [
      'Portfolio structure analysis (device coverage, SKU breadth)',
      'Pricing ladder mapping (price points, promotional mechanics)',
      'Bundling strategy evaluation (AOV tactics)',
      'Store presence audit (merchandising on Tmall and JD)',
      'Content and social analysis (proof formats, platform strategies)',
    ],
    deliverables: [
      { kind: 'deck', name: 'Competitor benchmark book (deck)' },
      { kind: 'doc', name: 'Competitor scorecards (1 page each)' },
      { kind: 'sheet', name: 'Competitor eComm data tables (Excel)' },
    ],
  },
  {
    icon: 'blueprint',
    phase: 'Phase four',
    duration: '3 to 4 weeks',
    title: 'Financial model and strategy blueprint',
    image: '/Images/enter-china/phase-4-financial.png',
    imageAlt:
      'A finance analyst reviewing a Tmall Global financial model on a desktop in a Shanghai office',
    intro:
      'We build the complete business case with transparent cost structures and a decision-ready recommendation.',
    outcome: 'You have a board-ready Go or No-Go with the numbers behind it.',
    does: [
      'Import cost modeling (COGS and cross-border logistics)',
      'Platform and payment fee structures',
      'Distribution model comparison (Sell-in vs. Sell-out economics)',
      'Marketing budget framework',
      '12-month roadmap development',
    ],
    deliverables: [
      { kind: 'deck', name: 'China Market Entry Blueprint (deck)' },
      { kind: 'sheet', name: 'Financial model with scenarios (Excel)' },
      { kind: 'doc', name: 'Go or No-Go recommendation' },
    ],
  },
];

const docIcons: Record<string, string> = {
  doc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>`,
  sheet: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><line x1="4" y1="10" x2="20" y2="10"/><line x1="10" y1="4" x2="10" y2="20"/></svg>`,
  deck: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="1"/><line x1="12" y1="17" x2="12" y2="21"/><line x1="8" y1="21" x2="16" y2="21"/></svg>`,
  report: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"/><path d="M15 2v5h5"/><path d="M9 13l2 2 4-4"/></svg>`,
  diagram: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="6" height="6" rx="1"/><rect x="15" y="3" width="6" height="6" rx="1"/><rect x="9" y="15" width="6" height="6" rx="1"/><path d="M6 9v3h12V9"/><path d="M12 12v3"/></svg>`,
};

const models = [
  {
    name: 'Sell in',
    tag: 'Distributor partnership',
    tagline: 'Validate without committing.',
    image: '/Images/enter-china/route-sellin.png',
    imageAlt:
      'A Chinese eCommerce distributor team reviewing inventory in a Shanghai fulfillment warehouse',
    desc: 'You sell products to a qualified CBEC distributor at wholesale pricing. They purchase inventory, own operational risk, and manage all in-market operations.',
    when: 'You are validating market fit, you do not have an Asia team, or your category calls for specialised local expertise you would rather rent than build.',
    split: { you: 20, them: 80, themLabel: 'Distributor' },
    dims: [
      { label: 'Capital needed', value: 'Low', level: 1 },
      { label: 'Risk you carry', value: 'Low', level: 1 },
      { label: 'Time to market', value: 'Fast', level: 4 },
      { label: 'Brand control', value: 'Shared', level: 2 },
    ],
    youGet: [
      'Wholesale revenue',
      'Zero inventory risk',
      'Immediate cash flow',
      'Limited capital commitment',
    ],
    they: [
      'Platform operations on Tmall Global, JD Worldwide, Douyin',
      'Marketing and content',
      'Logistics and bonded warehouse',
      'Customer service in Mandarin',
    ],
    pricing:
      'Wholesale margin agreed upfront. We earn from your engagement fee, not from the distributor.',
    highlight: true,
    ctaText: 'Talk about sell in',
  },
  {
    name: 'Sell out',
    tag: 'Direct operations',
    tagline: 'Commit to control.',
    image: '/Images/enter-china/route-sellout.png',
    imageAlt:
      'A foreign brand manager and Chinese operator reviewing a Tmall flagship dashboard in a Shanghai office',
    desc: 'Your brand owns the complete China operation. You finance inventory, control all touchpoints, and manage platform and logistics relationships.',
    when: 'You have proven demand, the China P&L is a strategic priority, and full control of pricing, customer data and brand positioning justifies the capital and the complexity.',
    split: { you: 100, them: 0, themLabel: 'External' },
    dims: [
      { label: 'Capital needed', value: 'High', level: 5 },
      { label: 'Risk you carry', value: 'High', level: 4 },
      { label: 'Time to market', value: 'Slow', level: 2 },
      { label: 'Brand control', value: 'Full', level: 5 },
    ],
    youGet: [
      'Full retail revenue',
      'Complete brand control',
      'Customer data ownership',
      'Pricing autonomy',
    ],
    they: [
      'Inventory financing',
      'Platform fees and operations',
      'Marketing execution and media',
      'Operational costs (warehouse, returns, service)',
    ],
    pricing:
      'You carry every cost line. The model in Phase 4 shows you the full picture before you commit.',
    highlight: false,
    ctaText: 'Talk about sell out',
  },
];

const faqs = [
  {
    cat: 'Strategy',
    q: 'What is Cross-Border eCommerce (CBEC)?',
    a: 'CBEC lets you sell to Chinese consumers without setting up a Chinese entity. Products ship from bonded warehouses or by direct mail, and customs clears at the consumer level. You get access to JD Worldwide, Tmall Global, Douyin and RED. You do not get offline retail, and you do not get domestic eCommerce until you complete NMPA or SAMR registration. Most brands use it as a lighter way to test demand before committing to full infrastructure.',
  },
  {
    cat: 'Strategy',
    q: 'Which distribution model should I choose, sell-in or sell-out?',
    a: 'Start with sell-in if you are still validating the market. A qualified distributor buys your inventory at wholesale, owns the operational risk, and your team stays focused on global. Move to sell-out once demand is proven and you need full control over pricing, customer data and brand experience. A lot of brands we work with start sell-in for 18 to 24 months, then transition. Some never do, and that is fine if the distributor performs.',
  },
  {
    cat: 'Strategy',
    q: 'What if the answer is "do not enter China right now"?',
    a: 'It happens. Roughly one in four engagements ends on a No-Go. Bad timing, wrong product fit, regulatory cost too high, the category already crowded. We tell you why, what would need to change, and when to revisit. You still get the full analysis. A clear No saves you twelve months and several million euros you would have burned figuring it out the hard way.',
  },
  {
    cat: 'Strategy',
    q: 'Can you guarantee my brand will succeed in China?',
    a: 'No. Nobody can. We can tell you whether the market math works, whether your category is winnable, and which model gives you the best odds. Execution still depends on your product, your patience, and your willingness to adapt. Anyone who promises a guarantee is selling you a story.',
  },
  {
    cat: 'Strategy',
    q: 'Why work with you instead of a Big Four firm?',
    a: 'Big Four delivers great frameworks. We deliver the answer plus the operator who can build it. Our team has run Tmall stores, handled platform takedowns, negotiated with distributors, and shipped through bonded warehouses. When you ask us about CBEC compliance, you are asking someone who has filed the paperwork, not someone who read about it. Most of our work picks up where a strategy deck stopped helping.',
  },
  {
    cat: 'Compliance',
    q: 'Can my product sell through CBEC?',
    a: 'Depends on what you sell and what you claim. Anti-aging cosmetics need NMPA special-use registration. Health supplements with functional ingredients need SAMR approval. Medical devices have strict classifications. Foods are restricted by ingredient. Phase 1 of our engagement checks CBEC eligibility before you spend another euro on the project.',
  },
  {
    cat: 'Compliance',
    q: 'What if I cannot use my home market product claims in China?',
    a: 'Common problem. "Diabetic wound care" becomes "fragile skin daily care." "Immune support" may need full health-food registration. "Clinically proven" usually has to be rewritten. We adapt positioning to fit platform rules without throwing out the brand equity. The trick is knowing what passes review before you build the launch around it.',
  },
  {
    cat: 'Compliance',
    q: 'What if my product was already rejected by a platform?',
    a: 'We pull the rejection notice, identify what triggered it, and tell you whether repositioning fixes it, whether a different platform works, or whether the product really cannot enter through CBEC. Sometimes the fix is a label change. Sometimes it is a Chinese formula adjustment. Sometimes it is a hard structural No. We give you the real answer instead of pretending the rejection did not happen.',
  },
  {
    cat: 'Compliance',
    q: 'What happens if Chinese regulation changes mid-engagement?',
    a: 'We flag the change, pause the affected workstream and reassess. Recent examples include the 2021 cosmetic regulation overhaul, the 2023 NMPA updates, and ongoing CBEC positive-list revisions. Our compliance partners track this daily. If a new rule reopens or kills your case, we tell you immediately and adjust the plan, not at the end of the engagement.',
  },
  {
    cat: 'Process',
    q: 'What information do you need from us to start?',
    a: 'Product specs, packaging artwork in editable format, current home-market pricing, regulatory certificates you already hold, your China objective, and your timeline. More detail upfront means a faster Phase 1. If you do not have everything, that is OK. We work from what you have and flag the gaps.',
  },
  {
    cat: 'Process',
    q: 'How long does the full engagement take?',
    a: 'Phases 1 and 2 together run roughly 6 to 8 weeks. Phase 3 competitor deep-dive runs 4 to 6 weeks in parallel. Phase 4 financial model adds 3 to 4 weeks. From kickoff to a clear Go or No-Go, you are looking at 10 to 14 weeks. If you want us to source and negotiate a distributor on top of that, plan another 8 to 12 weeks.',
  },
  {
    cat: 'Process',
    q: 'What do I get at the end of the engagement?',
    a: 'A board-ready package. Feasibility and compliance report. Competitive benchmark book with one-pagers per competitor. Full financial model in Excel with scenario planning. Channel strategy with platform-specific recommendations. A clear Go or No-Go recommendation. If you add the distributor track, a signed term sheet or contract with a vetted partner. Everything in English. Translated assets on request.',
  },
  {
    cat: 'Process',
    q: 'What happens if a finding kills the business case mid-way?',
    a: 'We stop and talk to you, not to the file. If Phase 1 surfaces a compliance issue that breaks the case, we will not run Phase 4 and bill you for the model. We adjust scope, refund the unused portion, and you walk away with what you have. The engagement is structured in phases for exactly this reason.',
  },
  {
    cat: 'Cost',
    q: 'What does this cost?',
    a: 'Fees depend on scope and which phases you take. We structure as fixed-fee per phase, not hourly. Most full engagements through Phase 4 land between eighty and two hundred and twenty thousand euros. Distributor sourcing, if you add it, is quoted separately, usually a project fee plus a success component. We share full pricing once we have scoped the work in the first call.',
  },
  {
    cat: 'Cost',
    q: 'Do you take a commission from distributors you introduce?',
    a: 'No. We bill you on the engagement. The distributor does not pay us referral fees. That is deliberate. If we took commission, our incentive would flip toward closing a deal instead of finding the right partner. You can verify this in the contract. Some clients ask. We are glad they do.',
  },
  {
    cat: 'Cost',
    q: 'What is the typical budget needed to launch after the engagement?',
    a: 'Cross-Border launch through a distributor: from around two hundred thousand euros in working capital, then growth spend from there. Sell-out direct on Tmall Global or JD Worldwide: eight hundred thousand to one and a half million euros over the first twelve months for store setup, content, media and inventory. We model the exact number for your category in Phase 4 so you are not budgeting blind.',
  },
  {
    cat: 'Operations',
    q: 'How do you source distributors?',
    a: 'Our network covers beauty, consumer tech, F&B, mother-and-baby, premium home and select health categories. We start from a longlist of 8 to 12 names, screen for category track record and platform credentials, then sit with you to pick the 2 to 3 finalists you actually meet. We sit on your side of the table for the commercial negotiation.',
  },
  {
    cat: 'Operations',
    q: "How much of my team's time will the engagement need?",
    a: 'Lighter than most clients expect. Roughly two hours a week from your project lead during Phases 1 to 3. Three or four working sessions of half a day each across the engagement. More involvement if you add the distributor track, because you are the one meeting the partners. We do the heavy lifting on research and modeling.',
  },
  {
    cat: 'Legal',
    q: 'Do I need a legal entity in China?',
    a: 'Through a distributor, no. They use their own licenses and assume the regulatory burden. For direct CBEC operations, yes, but not necessarily your own company. Chinese rules require any foreign brand selling through CBEC to designate a domestic service provider (境内服务商) who files with customs and assumes joint liability. You can set up your own WFOE or partner with a qualified third-party service provider. We help you decide which fits.',
  },
  {
    cat: 'Legal',
    q: 'Who owns the strategy and the data once the engagement ends?',
    a: 'You do. All deliverables, models, competitor data, distributor research and contract templates transfer to you on completion. No retention clauses on the strategy. We do not resell findings to competitors, which is also written into the contract. Common-sense ownership, not legal trickery.',
  },
];

const faqCategories = ['All', 'Strategy', 'Compliance', 'Process', 'Cost', 'Operations', 'Legal'];

const contextCards = [
  {
    image: '/Images/enter-china/ops-strategy-desk.webp',
    alt: 'Two Chinese eCommerce operators reviewing a Tmall flagship dashboard at a Shanghai desk in the evening',
    title: 'Strategy that gets used, not filed',
    body: 'Most market entry decks describe the market. Ours tells you what to do on Monday morning. Every recommendation is built from operational reality, not desk research, and tested against the platforms and partners you will actually work with.',
  },
  {
    image: '/Images/enter-china/team.png',
    alt: 'The TheChinaPath consulting team in China',
    title: 'Architects of the entry, not the building',
    body: 'Think of us as the architects, not the contractors. We design the blueprint, source the partners, set up the framework. You decide if and when to build. No pressure to launch, no incentive to oversell the case.',
  },
];
---

<Layout
  title="China Market Entry Consulting | Cross-Border eCommerce | TheChinaPath"
  description="Market entry consulting for brands going to China. Cross-Border eCommerce feasibility, channel strategy, competitor deep-dive, financial modeling, and distributor sourcing."
>
  <div class="mec-progress" aria-hidden="true"><div class="mec-progress__bar"></div></div>
  <article class="mec">
    {/* ---------- HERO (dark, parallax) ---------- */}
    <section class="mec-hero" data-hero>
      <div class="mec-hero__bg" aria-hidden="true" data-parallax>
        <img
          src="/Images/enter-china/hero-tier3-mall.png"
          alt="Families and shoppers inside a busy shopping mall in a tier-3 Chinese city"
        />
      </div>
      <div class="mec-hero__overlay" aria-hidden="true"></div>
      <div class="mec-hero__grain" aria-hidden="true"></div>

      <div class="container mec-hero__inner">
        <nav class="mec-hero__crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/#services">Enter China</a>
        </nav>
        <span class="eyebrow eyebrow--on-dark mec-reveal">Market entry consulting</span>
        <h1 class="mec-hero__title mec-reveal" style="--reveal-delay: 80ms;">
          <span class="mec-hero__title-row">China market entry is</span>
          <span class="mec-hero__title-row mec-hero__title-row--accent">complex and crowded.</span>
          <span class="mec-hero__title-row">We make the path</span>
          <span class="mec-hero__title-row mec-hero__title-row--highlight"
            >clear before you build.</span
          >
        </h1>
        <p class="mec-hero__lead mec-reveal" style="--reveal-delay: 200ms;">
          We design China market entry blueprints for global brands. Feasibility, financial models,
          competitor analysis, and distributor partnerships. The architecture before the
          construction.
        </p>
        <div class="mec-hero__actions mec-reveal" style="--reveal-delay: 280ms;">
          <a href="/contact" class="btn btn--primary mec-magnetic">Talk to us</a>
          <a href="#how-we-work" class="btn btn--ghost-light mec-magnetic">See how we work</a>
        </div>

        <div class="mec-hero__meta mec-reveal" style="--reveal-delay: 360ms;">
          <div class="mec-hero__meta-item">
            <span class="mec-hero__meta-num" data-counter="15" data-suffix="+">0</span>
            <span class="mec-hero__meta-label">years of China operations</span>
          </div>
          <div class="mec-hero__meta-item">
            <span class="mec-hero__meta-num" data-counter="75" data-suffix="+">0</span>
            <span class="mec-hero__meta-label">brand launches</span>
          </div>
          <div class="mec-hero__meta-item">
            <span class="mec-hero__meta-num">Three</span>
            <span class="mec-hero__meta-label">offices: Shanghai, Hong Kong, Paris</span>
          </div>
        </div>
      </div>

      <a href="#two-truths" class="mec-hero__scroll" aria-label="Scroll to next section">
        <span class="mec-hero__scroll-line"></span>
        <span class="mec-hero__scroll-text">Scroll</span>
      </a>
    </section>

    {/* ---------- TWO TRUTHS / CONTEXT ---------- */}
    <section id="two-truths" class="section">
      <div class="container">
        <header class="section-header section-header--center mec-reveal">
          <span class="eyebrow">Our approach</span>
          <h2>Two things to know before we start</h2>
          <p class="section-header__lead">
            Most brands approach China the way they approach any new market. China does not reward
            that approach. Here is what shapes how we work.
          </p>
        </header>

        <div class="mec-context">
          {
            contextCards.map((c, i) => (
              <article
                class={`mec-context__card${i === 1 ? ' mec-context__card--alt' : ''} mec-reveal`}
                style={`--reveal-delay: ${i * 120}ms;`}
              >
                <figure class="mec-context__media">
                  <img src={c.image} alt={c.alt} loading="lazy" decoding="async" />
                </figure>
                <div class="mec-context__body">
                  <h3>{c.title}</h3>
                  <p>{c.body}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- VALUE PROPOSITION + PROMISES ---------- */}
    <section class="section section--alt">
      <div class="container">
        <div class="mec-value">
          <div class="mec-value__copy">
            <span class="eyebrow">Why brands choose us</span>
            <h2>Most China consultants have never run operations there. We have.</h2>
            <p>
              Our team comes from Publicis Commerce China. We built the eCommerce practices for GSK,
              Nestlé, Ferrero and Beiersdorf across Tmall, JD, Douyin and RED.
            </p>
            <blockquote class="mec-value__quote">
              We consult based on operational experience, not research reports.
            </blockquote>
            <p>
              We know which distributors perform because we have evaluated them. We know what
              platforms require because we filed the applications ourselves.
            </p>
            <a href="/about" class="btn btn--secondary btn--sm">Meet the team</a>
          </div>

          <ul class="mec-promise">
            <li>
              <span class="eyebrow">What you can expect</span>
            </li>
            {
              promises.map((p) => (
                <li class="mec-promise__item">
                  <span class="mec-promise__check" aria-hidden="true">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="5 12 10 17 19 8" />
                    </svg>
                  </span>
                  <div>
                    <h4>{p.title}</h4>
                    <p>{p.desc}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

