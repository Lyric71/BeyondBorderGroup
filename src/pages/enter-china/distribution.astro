                                <span
                                  class="dis-phase__doc-icon"
                                  aria-hidden="true"
                                  set:html={docIcons[d.kind]}
                                />
                                <span class="dis-phase__doc-name">{d.name}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* ---------- FAQ (with category filter) ---------- */}
    <section class="section">
      <div class="container container--narrow">
        <header class="section-header section-header--center dis-reveal">
          <span class="eyebrow">FAQ</span>
          <h2>Twenty questions, answered straight</h2>
          <p class="section-header__lead">
