    .dis-route__split-bar-you:only-child,
    .dis-route__split-bar-them:only-child {
      border-radius: 6px;
    }
    @keyframes route-grow {
      from {
        transform: scaleX(0);
        transform-origin: left center;
      }
      to {
        transform: scaleX(1);
        transform-origin: left center;
      }
    }
    .dis-route__split-caption {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-top: 0.2rem;
    }

    /* Dimensions grid */
    .dis-route__dims {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .dis-route__dim {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: var(--space-3);
      font-size: 0.875rem;
      padding: 0.55rem 0;
      border-bottom: 1px solid var(--bbg-border);
    }
    .dis-route__dim:last-child {
      border-bottom: none;
    }
    .dis-route__dim-label {
      color: var(--bbg-text);
      font-weight: 500;
    }
    .dis-route__dim-dots {
      display: inline-flex;
      gap: 4px;
      align-items: center;
    }
    .dis-route__dim-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--bbg-border);
      transition: background 240ms ease;
    }
    .dis-route__dim-dot.is-on {
      background: var(--bbg-blue);
    }
    .dis-route__dim-value {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--bbg-ink);
      min-width: 56px;
      text-align: right;
      letter-spacing: -0.005em;
      flex-shrink: 0;
    }
    @media (max-width: 640px) {
      .dis-route__dim-value {
        min-width: 0;
        font-size: 0.8rem;
      }
    }

    /* Lists block */
    .dis-route__lists {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid var(--bbg-border);
    }
    .dis-route__list-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: var(--space-3);
    }
    .dis-route__list--muted .dis-route__list-label {
      color: var(--bbg-text-muted);
    }
    .dis-route__list ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }
    .dis-route__list li {
      display: grid;
      grid-template-columns: 18px 1fr;
      gap: 0.5rem;
      align-items: start;
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--bbg-text);
    }
    .dis-route__check {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 1px;
    }
    .dis-route__check svg {
      width: 11px;
      height: 11px;
    }
    .dis-route__dash {
      display: inline-block;
      width: 12px;
      height: 2px;
      background: var(--bbg-text-muted);
      border-radius: 2px;
      margin-top: 0.6em;
      justify-self: center;
    }

    /* Best when callout */
    .dis-route__when {
      padding: var(--space-4);
      background: var(--bbg-blue-light);
      border-radius: 12px;
      border-left: 3px solid var(--bbg-blue);
    }
    .dis-route__when-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.4rem;
    }
    .dis-route__when p {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--bbg-ink);
    }

    /* CTA */
    .dis-route__cta {
      align-self: flex-start;
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .dis-route__cta-arrow {
      display: inline-block;
      transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .dis-route__cta:hover .dis-route__cta-arrow {
      transform: translateX(4px);
    }

    @media (max-width: 1024px) {
      .dis-routes {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 560px) {
      .dis-route__lists {
        grid-template-columns: 1fr;
      }
      .dis-route__body {
        padding: var(--space-5);
      }
    }

    /* ---------- BUSINESS MODELS TABS ---------- */
    .dis-tabs {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 16px 48px -28px rgba(8, 18, 28, 0.18);
    }
    .dis-tabs__nav {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
      background: linear-gradient(180deg, var(--bbg-surface) 0%, var(--bbg-white) 100%);
      border-bottom: 1px solid var(--bbg-border);
    }
    .dis-tabs__tab {
      position: relative;
      background: transparent;
      border: none;
      padding: var(--space-5) var(--space-5);
      text-align: left;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      color: var(--bbg-text-muted);
      transition:
        color 240ms ease,
        background 240ms ease;
      border-right: 1px solid var(--bbg-border);
      font-family: inherit;
    }
    .dis-tabs__tab:last-child {
      border-right: none;
    }
    .dis-tabs__tab:hover {
      color: var(--bbg-ink);
      background: rgba(200, 16, 46, 0.04);
    }
    .dis-tabs__tab.is-active {
      color: var(--bbg-ink);
      background: var(--bbg-white);
    }
    .dis-tabs__tab-label {
      font-size: 1.0625rem;
      font-weight: 700;
      letter-spacing: -0.005em;
      line-height: 1.2;
    }
    .dis-tabs__tab-tag {
      font-size: 0.85rem;
      color: var(--bbg-text-muted);
      line-height: 1.35;
    }
    .dis-tabs__tab.is-active .dis-tabs__tab-tag {
      color: var(--bbg-blue);
    }
    .dis-tabs__tab-pop {
      position: absolute;
      top: var(--space-3);
      right: var(--space-3);
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .dis-tabs__indicator {
      position: absolute;
      bottom: -1px;
      left: 0;
      width: 50%;
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 100%);
      border-radius: 2px 2px 0 0;
      transform: translateX(0);
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }
    .dis-tabs__panels {
      background: var(--bbg-white);
    }
    .dis-tabs__panel {
      padding: clamp(var(--space-5), 4vw + 1rem, var(--space-7));
      animation: dis-tab-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes dis-tab-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .dis-tabs__panel[hidden] {
      display: none;
    }
    .dis-tabs__panel-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: start;
    }
    .dis-tabs__lead {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .dis-tabs__pillset {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .dis-tabs__pill {
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.35em 0.85em;
      border-radius: 999px;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      letter-spacing: 0.01em;
    }
    .dis-tabs__pill--soft {
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
    }
    .dis-tabs__title {
      font-size: clamp(1.625rem, 1.8vw + 1rem, 2.25rem);
      line-height: 1.1;
      margin: 0;
      letter-spacing: -0.015em;
    }
    .dis-tabs__desc {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .dis-tabs__when {
      padding: var(--space-4);
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      border-left: 3px solid var(--bbg-blue);
    }
    .dis-tabs__when-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.35rem;
    }
    .dis-tabs__when p {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.55;
      color: var(--bbg-text);
    }
    .dis-tabs__body {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .dis-tabs__list-wrap {
      background: var(--bbg-surface);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }
    .dis-tabs__list-wrap--muted {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
    }
    .dis-tabs__list-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .dis-tabs__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .dis-tabs__list li {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 0.75rem;
      align-items: start;
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--bbg-text);
    }
    .dis-tabs__check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .dis-tabs__check svg {
      width: 12px;
      height: 12px;
    }
    .dis-tabs__list--muted li {
      grid-template-columns: 14px 1fr;
    }
    .dis-tabs__dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--bbg-text-muted);
      margin-top: 0.55em;
      margin-left: 3px;
    }
    .dis-tabs__pricing {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      padding: var(--space-4);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.12) 100%);
      border-radius: var(--radius-md);
      border: 1px solid rgba(200, 16, 46, 0.2);
    }
    .dis-tabs__pricing-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-blue-dark);
      flex-shrink: 0;
    }
    .dis-tabs__pricing-value {
      font-size: 1rem;
      font-weight: 600;
      color: var(--bbg-ink);
      line-height: 1.4;
    }
    @media (max-width: 1024px) {
      .dis-tabs__nav {
        grid-template-columns: repeat(2, 1fr);
      }
      .dis-tabs__panel-grid {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 560px) {
      .dis-tabs__nav {
        grid-template-columns: 1fr;
      }
      .dis-tabs__tab {
        border-right: none;
        border-bottom: 1px solid var(--bbg-border);
      }
      .dis-tabs__indicator {
        display: none;
      }
    }

    /* ---------- PHASE PANEL (new visual layout) ---------- */
    .dis-phase-panel {
      padding: 0 !important;
    }
    .dis-phase {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 0;
      align-items: stretch;
    }
    .dis-phase__media {
      position: relative;
      margin: 0;
      min-height: 100%;
      overflow: hidden;
      background: var(--bbg-surface);
    }
    .dis-phase__media img {
      width: 100%;
      height: 100%;
      min-height: 360px;
      object-fit: cover;
      display: block;
    }
    .dis-phase__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(8, 18, 28, 0) 50%, rgba(8, 18, 28, 0.75) 100%);
      pointer-events: none;
    }
    .dis-phase__media-overlay {
      position: absolute;
      left: var(--space-5);
      bottom: var(--space-5);
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      align-items: center;
      z-index: 2;
    }
    .dis-phase__media-phase {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bbg-white);
      background: rgba(8, 18, 28, 0.75);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      padding: 0.45em 0.85em;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .dis-phase__media-duration {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--bbg-blue-dark);
      background: var(--bbg-white);
      padding: 0.4em 0.85em;
      border-radius: 999px;
      box-shadow: 0 4px 12px -4px rgba(8, 18, 28, 0.35);
    }
    .dis-phase__media-duration svg {
      width: 14px;
      height: 14px;
    }

    .dis-phase__content {
      padding: clamp(var(--space-5), 2.4vw + 1rem, var(--space-7));
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .dis-phase__head {
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .dis-phase__icon {
      flex-shrink: 0;
      width: 52px;
      height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.18) 100%);
      color: var(--bbg-blue);
      box-shadow: inset 0 0 0 1px rgba(200, 16, 46, 0.15);
    }
    .dis-phase__icon svg {
      width: 26px;
      height: 26px;
    }
    .dis-phase__phase-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      margin-bottom: 0.3rem;
    }
    .dis-phase__title {
      font-size: clamp(1.375rem, 1.4vw + 1rem, 1.875rem);
      line-height: 1.15;
      margin: 0;
      letter-spacing: -0.015em;
      color: var(--bbg-ink);
      font-weight: 700;
    }
    .dis-phase__intro {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }

    /* Outcome callout */
    .dis-phase__outcome {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: var(--space-4);
      padding: var(--space-4);
      background: linear-gradient(135deg, var(--bbg-blue-light) 0%, rgba(200, 16, 46, 0.12) 100%);
      border-radius: 14px;
      border-left: 3px solid var(--bbg-blue);
    }
    .dis-phase__outcome-label {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-blue-dark);
    }
    .dis-phase__outcome-label svg {
      width: 16px;
      height: 16px;
      fill: var(--bbg-blue);
      stroke: var(--bbg-blue);
    }
    .dis-phase__outcome p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.45;
      color: var(--bbg-ink);
      font-weight: 600;
      letter-spacing: -0.005em;
    }

    /* Two columns: checks + docs */
    .dis-phase__columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
      padding-top: var(--space-4);
      border-top: 1px solid var(--bbg-border);
    }
    .dis-phase__col-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .dis-phase__checks {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .dis-phase__checks li {
      display: grid;
      grid-template-columns: 20px 1fr;
      gap: 0.55rem;
      align-items: start;
      font-size: 0.92rem;
      line-height: 1.45;
      color: var(--bbg-text);
      animation: phase-fade-in 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--seq, 0) * 90ms + 80ms);
    }
    .dis-phase__check {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--bbg-blue);
      color: var(--bbg-white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 1px;
    }
    .dis-phase__check svg {
      width: 11px;
      height: 11px;
    }

    /* Document tiles */
    .dis-phase__docs {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }
    .dis-phase__doc {
      display: grid;
      grid-template-columns: 36px 1fr;
      gap: 0.7rem;
      align-items: center;
      padding: 0.7rem 0.9rem;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 10px;
      transition:
        border-color 220ms ease,
        transform 220ms ease,
        box-shadow 220ms ease;
      animation: phase-fade-in 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--seq, 0) * 90ms + 200ms);
    }
    .dis-phase__doc:hover {
      border-color: var(--bbg-blue);
      transform: translateX(2px);
      box-shadow: 0 8px 20px -12px rgba(200, 16, 46, 0.4);
    }
    .dis-phase__doc-icon {
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      flex-shrink: 0;
    }
    .dis-phase__doc-icon svg {
      width: 18px;
      height: 18px;
    }
    .dis-phase__doc-name {
      font-size: 0.9rem;
      line-height: 1.35;
      color: var(--bbg-ink);
      font-weight: 600;
      letter-spacing: -0.005em;
    }

    @keyframes phase-fade-in {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .dis-phase__checks li,
      .dis-phase__doc {
        animation: none;
      }
    }

    @media (max-width: 1024px) {
      .dis-phase {
        grid-template-columns: 1fr;
      }
      .dis-phase__media img {
        min-height: 0;
        aspect-ratio: 16 / 9;
      }
    }
    @media (max-width: 600px) {
      .dis-phase__columns {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- TABS â€” PHASES VARIANT (4 columns, eyebrow above label) ---------- */
    .dis-tabs__nav--phases {
      grid-template-columns: repeat(4, 1fr);
    }
    .dis-tabs__nav--phases + .dis-tabs__panels {
      /* keep panel layout shared */
    }
    .dis-tabs--phases .dis-tabs__tab {
      gap: 0.5rem;
    }
    .dis-tabs__tab-eyebrow {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      line-height: 1;
    }
    .dis-tabs__tab:not(.is-active) .dis-tabs__tab-eyebrow {
      color: var(--bbg-text-muted);
    }
    .dis-tabs--phases .dis-tabs__tab-label {
      font-size: 1rem;
      line-height: 1.25;
    }
    .dis-phase-head {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }
    .dis-phase-head__icon {
      display: inline-flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      flex-shrink: 0;
      box-shadow: inset 0 0 0 1px rgba(200, 16, 46, 0.15);
    }
    .dis-phase-head__icon svg {
      width: 22px;
      height: 22px;
    }
    .dis-phase-head .dis-tabs__title {
      margin: 0;
    }

    @media (max-width: 1024px) {
      .dis-tabs__nav--phases {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .dis-tabs__nav--phases {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- MATRIX ---------- */
    .dis-matrix {
      margin-top: var(--space-8);
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: clamp(var(--space-5), 3vw + 1rem, var(--space-7));
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.02);
    }
    .dis-matrix__intro {
      text-align: center;
      margin-bottom: var(--space-6);
    }
    .dis-matrix__intro h3 {
      font-size: clamp(1.375rem, 1.2vw + 1rem, 1.75rem);
      margin: var(--space-2) 0 var(--space-3);
      letter-spacing: -0.01em;
    }
    .dis-matrix__intro p {
      color: var(--bbg-text);
      max-width: 56ch;
      margin: 0 auto;
      line-height: 1.6;
      font-size: 1rem;
    }
    .dis-matrix__grid {
      display: grid;
      grid-template-columns: minmax(140px, 0.8fr) 1fr 1fr;
      gap: 1px;
      background: var(--bbg-border);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .dis-matrix__corner,
    .dis-matrix__head,
    .dis-matrix__row-head,
    .dis-matrix__cell {
      background: var(--bbg-white);
      padding: var(--space-4);
    }
    .dis-matrix__corner {
      background: var(--bbg-surface);
    }
    .dis-matrix__head {
      background: var(--bbg-surface);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .dis-matrix__row-head {
      background: var(--bbg-surface);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      display: flex;
      align-items: center;
    }
    .dis-matrix__cell {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      transition: background var(--dur) var(--ease);
      cursor: pointer;
      border: none;
      text-align: left;
      font-family: inherit;
    }
    .dis-matrix__cell:hover {
      background: var(--bbg-blue-light);
    }
    .dis-matrix__cell:focus-visible {
      outline: 3px solid var(--bbg-blue);
      outline-offset: -3px;
    }
    .dis-matrix__cell-label {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--bbg-ink);
      letter-spacing: -0.005em;
    }
    .dis-matrix__cell-sub {
      font-size: 0.9rem;
      color: var(--bbg-text);
      line-height: 1.45;
    }
    .dis-matrix__note {
      margin: var(--space-5) auto 0;
      max-width: 68ch;
      text-align: center;
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 0.975rem;
    }
    .dis-matrix__grid.is-hover-row .dis-matrix__cell {
      opacity: 0.4;
    }
    .dis-matrix__grid.is-hover-row .dis-matrix__cell.is-row-active,
    .dis-matrix__grid.is-hover-row .dis-matrix__cell.is-col-active {
      opacity: 1;
      background: var(--bbg-blue-light);
    }
    .dis-matrix__grid.is-hover-row .dis-matrix__row-head,
    .dis-matrix__grid.is-hover-row .dis-matrix__head {
      opacity: 0.4;
    }
    .dis-matrix__grid.is-hover-row .dis-matrix__row-head.is-active,
    .dis-matrix__grid.is-hover-row .dis-matrix__head.is-active {
      opacity: 1;
      background: var(--bbg-blue);
      color: var(--bbg-white);
    }
    @media (max-width: 720px) {
      .dis-matrix__grid {
        grid-template-columns: 1fr 1fr;
      }
      .dis-matrix__corner {
        display: none;
      }
      .dis-matrix__head {
        font-size: 0.75rem;
        padding: var(--space-3);
      }
      .dis-matrix__row-head {
        grid-column: 1 / -1;
        background: var(--bbg-blue-light);
        color: var(--bbg-blue-dark);
        justify-content: center;
        padding: var(--space-3);
      }
    }

    /* ---------- JOURNEY (vertical timeline) ---------- */
    .dis-journey-section {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    .dis-journey-section__bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
      opacity: 0.1;
      pointer-events: none;
    }
    .dis-journey-section__bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        var(--bbg-surface) 0%,
        rgba(247, 249, 251, 0.6) 40%,
        rgba(247, 249, 251, 0.9) 100%
      );
    }
    .dis-journey-section__bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: saturate(0.55);
    }

    .dis-journey {
      position: relative;
      max-width: 920px;
      margin: 0 auto;
      padding-left: 64px;
    }
    .dis-journey__rail {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 26px;
      width: 2px;
    }
    .dis-journey__rail-track {
      position: absolute;
      inset: 0;
      background: var(--bbg-border);
      border-radius: 2px;
    }
    .dis-journey__rail-fill {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: var(--journey-progress, 0%);
      background: linear-gradient(180deg, var(--bbg-blue) 0%, #e84a60 100%);
      border-radius: 2px;
      transition: height 120ms linear;
      box-shadow: 0 0 8px rgba(200, 16, 46, 0.4);
    }
    .dis-journey__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }
    .dis-journey__item {
      position: relative;
    }
    .dis-journey__dot {
      position: absolute;
      left: -64px;
      top: 8px;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--bbg-white);
      border: 2px solid var(--bbg-border);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      transition: border-color 320ms ease;
    }
    .dis-journey__dot-inner {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--bbg-border);
      transition:
        background 320ms ease,
        transform 320ms ease;
    }
    .dis-journey__item.is-active .dis-journey__dot {
      border-color: var(--bbg-blue);
    }
    .dis-journey__item.is-active .dis-journey__dot-inner {
      background: var(--bbg-blue);
      transform: scale(1.1);
      box-shadow: 0 0 0 4px var(--bbg-blue-light);
    }
    .dis-journey__phase {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
      transition: color 320ms ease;
    }
    .dis-journey__item.is-active .dis-journey__phase {
      color: var(--bbg-blue);
    }
    .dis-journey__card {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6) var(--space-7);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      transition:
        border-color 320ms ease,
        box-shadow 320ms ease,
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .dis-journey__item:hover .dis-journey__card,
    .dis-journey__item.is-active .dis-journey__card {
      border-color: var(--bbg-blue);
      box-shadow: 0 18px 38px -22px rgba(200, 16, 46, 0.4);
      transform: translateX(4px);
    }
    .dis-journey__card-head {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }
    .dis-journey__icon {
      display: inline-flex;
      width: 48px;
      height: 48px;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
      flex-shrink: 0;
    }
    .dis-journey__icon svg {
      width: 24px;
      height: 24px;
    }
    .dis-journey__title {
      font-size: clamp(1.25rem, 1vw + 0.875rem, 1.625rem);
      line-height: 1.2;
      margin: 0;
      letter-spacing: -0.01em;
      font-weight: 700;
      color: var(--bbg-ink);
    }
    .dis-journey__desc {
      font-size: 1.0625rem;
      line-height: 1.6;
      color: var(--bbg-text);
      margin: 0;
    }
    .dis-journey__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
      padding-top: var(--space-4);
      border-top: 1px solid var(--bbg-border);
    }
    .dis-journey__label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--bbg-text-muted);
      margin-bottom: var(--space-3);
    }
    .dis-journey__label--blue {
      color: var(--bbg-blue);
    }
    .dis-journey__bullets {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .dis-journey__bullets li {
      position: relative;
      padding-left: 1.25rem;
      color: var(--bbg-text);
      line-height: 1.5;
      font-size: 0.95rem;
    }
    .dis-journey__bullets li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.55em;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--bbg-border);
    }
    .dis-journey__bullets--blue li::before {
      background: var(--bbg-blue);
    }

    @media (max-width: 720px) {
      .dis-journey {
        padding-left: 40px;
      }
      .dis-journey__rail {
        left: 16px;
      }
      .dis-journey__dot {
        left: -40px;
        width: 36px;
        height: 36px;
        top: 4px;
      }
      .dis-journey__dot-inner {
        width: 12px;
        height: 12px;
      }
      .dis-journey__card {
        padding: var(--space-5);
      }
      .dis-journey__grid {
        grid-template-columns: 1fr;
        gap: var(--space-4);
      }
    }

    /* ---------- BEYONDCOMPASS ---------- */
    .dis-compass {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      border-radius: 24px;
      color: var(--bbg-white);
      padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8));
      box-shadow: 0 24px 60px -30px rgba(8, 18, 28, 0.55);
    }
    .dis-compass__bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(80% 60% at 100% 0%, rgba(200, 16, 46, 0.42) 0%, rgba(200, 16, 46, 0) 60%),
        radial-gradient(60% 50% at 0% 100%, rgba(200, 16, 46, 0.22) 0%, rgba(200, 16, 46, 0) 60%),
        linear-gradient(160deg, #0e2030 0%, #08141f 60%);
    }
    .dis-compass__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(var(--space-5), 3vw, var(--space-7));
      align-items: center;
    }
    .dis-compass__copy {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      min-width: 0;
    }
    .dis-compass__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      flex-wrap: wrap;
    }
    .dis-compass__logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--bbg-white);
      border-radius: 12px;
      padding: 10px 18px;
      box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.35);
      height: 56px;
    }
    .dis-compass__logo img {
      height: 100%;
      width: auto;
      display: block;
    }
    @media (max-width: 1024px) {
      .dis-compass__grid {
        grid-template-columns: 1fr;
      }
    }
    .dis-compass__chip {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #c8102e;
      background: rgba(200, 16, 46, 0.18);
      padding: 0.4em 0.85em;
      border-radius: 999px;
      border: 1px solid rgba(155, 217, 245, 0.25);
    }
    .dis-compass__pitch {
      font-size: clamp(1.5rem, 1.4vw + 1rem, 2.125rem);
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--bbg-white);
      font-weight: 700;
      margin: 0;
      max-width: 22ch;
    }
    .dis-compass__body {
      font-size: 1.0625rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.82);
      margin: 0;
      max-width: 64ch;
    }
    .dis-compass__stats {
      list-style: none;
      padding: var(--space-5) 0 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }
    .dis-compass__stats li {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .dis-compass__stat-num {
      font-size: clamp(1.75rem, 1.4vw + 1rem, 2.375rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1;
      color: #c8102e;
      font-feature-settings: 'tnum';
    }
    .dis-compass__stat-label {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.66);
      letter-spacing: 0.01em;
      line-height: 1.4;
    }
    .dis-compass__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-top: var(--space-3);
    }
    .dis-compass__btn-primary {
      background: var(--bbg-white);
      color: var(--bbg-ink);
      border: 1px solid var(--bbg-white);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .dis-compass__btn-primary:hover {
      background: rgba(255, 255, 255, 0.92);
      color: var(--bbg-blue-dark);
    }
    .dis-compass__btn-arrow {
      display: inline-block;
      transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .dis-compass__btn-primary:hover .dis-compass__btn-arrow {
      transform: translate(2px, -2px);
    }
    .dis-compass__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.4);
      color: var(--bbg-white);
    }
    .dis-compass__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }
    @media (max-width: 1024px) {
      .dis-compass__stats {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 560px) {
      .dis-compass__stats {
        grid-template-columns: 1fr;
        gap: var(--space-4);
      }
    }

    /* ---------- COMPASS ART (vetted database SVG) ---------- */
    .dis-compass__art {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      min-width: 0;
    }
    .dis-compass__art > svg {
      width: 100%;
      height: auto;
      max-width: 480px;
      margin-left: auto;
      display: block;
      filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.4));
    }
    /* Animations on SVG groups: only animate opacity to avoid clobbering
       the SVG `transform` attribute on the same element. Pop / pulse effects
       are scoped to elements with transform-box: fill-box. */
    .dis-compass__art .cmp-card {
      animation: cmp-fade-in 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .dis-compass__art .cmp-card--4 {
      animation-delay: 80ms;
    }
    .dis-compass__art .cmp-card--3 {
      animation-delay: 200ms;
    }
    .dis-compass__art .cmp-card--2 {
      animation-delay: 320ms;
    }
    .dis-compass__art .cmp-card--1 {
      animation-delay: 460ms;
    }
    .dis-compass__art .cmp-check {
      animation: cmp-fade-in 500ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
    .dis-compass__art .cmp-card--4 .cmp-check {
      animation-delay: 360ms;
    }
    .dis-compass__art .cmp-card--3 .cmp-check {
      animation-delay: 480ms;
    }
    .dis-compass__art .cmp-card--2 .cmp-check {
      animation-delay: 600ms;
    }
    .dis-compass__art .cmp-card--1 .cmp-check {
      animation-delay: 740ms;
    }
    .dis-compass__art .cmp-seal {
      animation: cmp-fade-in 800ms cubic-bezier(0.16, 1, 0.3, 1) 600ms both;
    }
    .dis-compass__art .cmp-live {
      animation: cmp-live-pulse 2.2s ease-in-out 1.5s infinite;
    }
    @keyframes cmp-fade-in {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
    @keyframes cmp-live-pulse {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.35;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .dis-compass__art .cmp-card,
      .dis-compass__art .cmp-check,
      .dis-compass__art .cmp-seal,
      .dis-compass__art .cmp-live {
        animation: none;
      }
    }
    .dis-compass__art-key {
      list-style: none;
      padding: var(--space-4) 0 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      max-width: 480px;
      margin-left: auto;
      width: 100%;
    }
    .dis-compass__art-key li {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.4;
    }
    .dis-compass__art-dot {
      flex-shrink: 0;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--bbg-blue);
      box-shadow: 0 0 0 3px rgba(200, 16, 46, 0.2);
    }
    .dis-compass__art-dot--vetted {
      background: #fff;
      box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.15);
    }
    .dis-compass__art-dot--live {
      background: #e84a60;
      box-shadow: 0 0 0 3px rgba(91, 194, 240, 0.25);
    }
    .dis-compass__art-dot--reject {
      background: transparent;
      border: 1px dashed rgba(255, 255, 255, 0.4);
      box-shadow: none;
    }
    @media (max-width: 900px) {
      .dis-compass__art > svg {
        max-width: 100%;
        margin: 0 auto;
      }
      .dis-compass__art-key {
        margin: 0 auto;
      }
    }

    /* ---------- COMPASS TIERS ---------- */
    .dis-compass-tiers {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
      margin-top: var(--space-5);
    }
    .dis-compass-tier {
      position: relative;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 280ms ease,
        box-shadow 280ms ease;
    }
    .dis-compass-tier::before {
      content: '';
      position: absolute;
      top: 0;
      left: var(--space-6);
      right: var(--space-6);
      height: 3px;
      background: linear-gradient(90deg, var(--bbg-blue) 0%, #e84a60 100%);
      transform: scaleX(0.3);
      transform-origin: left center;
      transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
      border-radius: 0 0 2px 2px;
    }
    .dis-compass-tier:hover {
      transform: translateY(-4px);
      border-color: var(--bbg-blue);
      box-shadow: 0 16px 32px -20px rgba(200, 16, 46, 0.4);
    }
    .dis-compass-tier:hover::before {
      transform: scaleX(1);
    }
    .dis-compass-tier__label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--bbg-blue);
    }
    .dis-compass-tier__lead {
      font-size: 1.0625rem;
      line-height: 1.5;
      color: var(--bbg-ink);
      font-weight: 600;
      margin: 0;
      letter-spacing: -0.005em;
    }
    .dis-compass-tier__when {
      font-size: 0.9rem;
      line-height: 1.55;
      color: var(--bbg-text-muted);
      margin-top: auto;
    }
    @media (max-width: 1024px) {
      .dis-compass-tiers {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 600px) {
      .dis-compass-tiers {
        grid-template-columns: 1fr;
      }
    }

    /* ---------- FAQ FILTER ---------- */
    .dis-faq-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-bottom: var(--space-6);
    }
    .dis-faq-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.95rem;
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: 999px;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--bbg-text);
      transition: all 220ms ease;
      font-family: inherit;
    }
    .dis-faq-chip:hover {
      border-color: var(--bbg-blue);
      color: var(--bbg-blue);
    }
    .dis-faq-chip.is-active {
      background: var(--bbg-blue);
      border-color: var(--bbg-blue);
      color: var(--bbg-white);
    }
    .dis-faq-chip__count {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.15em 0.5em;
      border-radius: 999px;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition: all 220ms ease;
    }
    .dis-faq-chip:hover .dis-faq-chip__count {
      background: var(--bbg-blue-light);
      color: var(--bbg-blue);
    }
    .dis-faq-chip.is-active .dis-faq-chip__count {
      background: rgba(255, 255, 255, 0.2);
      color: var(--bbg-white);
    }

    /* ---------- FAQ ITEMS ---------- */
    .dis-faq {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .dis-faq__item {
      background: var(--bbg-white);
      border: 1px solid var(--bbg-border);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition:
        border-color 240ms ease,
        box-shadow 240ms ease,
        transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .dis-faq__item:hover {
      transform: translateX(2px);
      border-color: rgba(200, 16, 46, 0.4);
    }
    .dis-faq__item[open] {
      border-color: var(--bbg-blue);
      box-shadow: 0 8px 22px -14px rgba(200, 16, 46, 0.4);
    }
    .dis-faq__item.is-hidden {
      display: none;
    }
    .dis-faq__q {
      cursor: pointer;
      padding: var(--space-5);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      font-weight: 600;
      font-size: 1.0625rem;
      line-height: 1.3;
      color: var(--bbg-ink);
      list-style: none;
      transition: color var(--dur) var(--ease);
    }
    .dis-faq__q::-webkit-details-marker {
      display: none;
    }
    .dis-faq__q::marker {
      display: none;
    }
    .dis-faq__item:hover .dis-faq__q {
      color: var(--bbg-blue);
    }
    .dis-faq__cat-tag {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--bbg-blue);
      background: var(--bbg-blue-light);
      padding: 0.25em 0.6em;
      border-radius: 4px;
      margin-right: var(--space-3);
      flex-shrink: 0;
    }
    .dis-faq__q-text {
      flex-grow: 1;
    }
    .dis-faq__icon {
      flex-shrink: 0;
      width: 28px;
      height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--bbg-surface);
      color: var(--bbg-text-muted);
      transition:
        transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
        color var(--dur) var(--ease),
        background var(--dur) var(--ease);
    }
    .dis-faq__item[open] .dis-faq__icon {
      transform: rotate(180deg);
      color: var(--bbg-white);
      background: var(--bbg-blue);
    }
    .dis-faq__a {
      padding: 0 var(--space-5) var(--space-5);
      color: var(--bbg-text);
      line-height: 1.65;
      font-size: 1rem;
      animation: dis-faq-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes dis-faq-in {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .dis-faq__a p {
      margin: 0;
    }

    /* ---------- FINAL CTA ---------- */
    .dis-cta {
      padding: clamp(var(--space-6), 4vw + 1rem, var(--space-8)) var(--space-6);
      background: linear-gradient(135deg, var(--bbg-blue) 0%, var(--bbg-blue-dark) 100%);
      color: var(--bbg-white);
      border-radius: var(--radius-lg);
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .dis-cta::before {
      content: '';
      position: absolute;
      top: -40%;
      right: -10%;
      width: 420px;
      height: 420px;
      background: radial-gradient(
        circle at center,
        rgba(255, 255, 255, 0.18) 0%,
        rgba(255, 255, 255, 0) 65%
      );
      pointer-events: none;
    }
    .dis-cta .eyebrow--on-dark {
      display: inline-block;
      margin-bottom: var(--space-4);
      color: rgba(255, 255, 255, 0.9);
    }
    .dis-cta__title {
      font-size: clamp(1.75rem, 1.5vw + 1rem, 2.5rem);
      line-height: 1.15;
      color: var(--bbg-white);
      margin: 0 0 var(--space-4);
      letter-spacing: -0.015em;
    }
    .dis-cta__lead {
      color: rgba(255, 255, 255, 0.92);
      font-size: 1.0625rem;
      max-width: 52ch;
      margin: 0 auto var(--space-5);
      line-height: 1.55;
    }
    .dis-cta__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      justify-content: center;
      position: relative;
    }
    .dis-cta__btn-primary {
      background: var(--bbg-white);
      color: var(--bbg-blue-dark);
      border: 1px solid var(--bbg-white);
    }
    .dis-cta__btn-primary:hover {
      background: rgba(255, 255, 255, 0.92);
      color: var(--bbg-blue-dark);
    }
    .dis-cta__btn-ghost {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.5);
      color: var(--bbg-white);
    }
    .dis-cta__btn-ghost:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--bbg-white);
      color: var(--bbg-white);
    }
  </style>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Reveal-on-scroll
      const revealEls = document.querySelectorAll('.dis-reveal');
      if (revealEls.length) {
        if (reduced || !('IntersectionObserver' in window)) {
          revealEls.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-in');
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
          );
          revealEls.forEach((el) => io.observe(el));
        }
      }

      // 2. Hero meta counters
      const counters = document.querySelectorAll('[data-counter]');
      if (counters.length && !reduced && 'IntersectionObserver' in window) {
        const animate = (el) => {
          const target = parseFloat(el.dataset.counter || '0');
          const suffix = el.dataset.suffix || '';
          const duration = 1400;
          const start = performance.now();
          const tick = (now) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const value = Math.round(target * eased);
            el.textContent = value + suffix;
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const counterIo = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animate(entry.target);
                counterIo.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.5 },
        );
        counters.forEach((el) => counterIo.observe(el));
      } else {
        counters.forEach((el) => {
          el.textContent = (el.dataset.counter || '0') + (el.dataset.suffix || '');
        });
      }

      // 3. Hero parallax + scroll progress bar
      const parallaxEl = document.querySelector('[data-parallax]');
      const progressEl = document.querySelector('.dis-progress__bar');
      const heroEl = document.querySelector('[data-hero]');
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const scrollY = window.scrollY || window.pageYOffset;
          if (parallaxEl && heroEl && !reduced) {
            const heroH = heroEl.offsetHeight;
            if (scrollY < heroH) {
              parallaxEl.style.setProperty('--parallax-y', scrollY * 0.18 + 'px');
            }
          }
          if (progressEl) {
            const docH = document.documentElement.scrollHeight - window.innerHeight;
            const pct = docH > 0 ? Math.min(100, (scrollY / docH) * 100) : 0;
            progressEl.style.setProperty('--progress', pct + '%');
          }
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // 4. Smooth scroll for in-page anchors
      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = link.getAttribute('href');
          if (!id || id === '#') return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        });
      });

      // 5. FAQ accordion behaviour: close others when one opens
      const faqItems = document.querySelectorAll('.dis-faq__item');
      faqItems.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (item.open) {
            faqItems.forEach((other) => {
              if (other !== item && other.open) other.open = false;
            });
          }
        });
      });

      // 6. Tabs (business models + phases) â€” supports multiple [data-tabs] instances
      document.querySelectorAll('[data-tabs]').forEach((tabsRoot) => {
        const tabs = Array.from(
          tabsRoot.querySelectorAll(':scope > .dis-tabs__nav .dis-tabs__tab'),
        );
        const panels = Array.from(
          tabsRoot.querySelectorAll(':scope > .dis-tabs__panels > .dis-tabs__panel'),
        );
        const indicator = tabsRoot.querySelector(':scope > .dis-tabs__nav > .dis-tabs__indicator');
        if (!tabs.length || !panels.length) return;
        const setActive = (tab) => {
          tabs.forEach((t) => {
            const active = t === tab;
            t.classList.toggle('is-active', active);
            t.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          const targetId = tab.getAttribute('data-tab-target');
          panels.forEach((p) => {
            const active = p.id === targetId;
            p.classList.toggle('is-active', active);
            if (active) p.removeAttribute('hidden');
            else p.setAttribute('hidden', '');
          });
          if (indicator) {
            const idx = tabs.indexOf(tab);
            const w = 100 / tabs.length;
            indicator.style.width = w + '%';
            indicator.style.transform = `translateX(${idx * 100}%)`;
          }
        };
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => setActive(tab));
          tab.addEventListener('keydown', (e) => {
            const idx = tabs.indexOf(tab);
            if (e.key === 'ArrowRight') {
              e.preventDefault();
              const next = tabs[(idx + 1) % tabs.length];
              next.focus();
              setActive(next);
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              const prev = tabs[(idx - 1 + tabs.length) % tabs.length];
              prev.focus();
              setActive(prev);
            }
          });
        });
        const initialActive = tabs.find((t) => t.classList.contains('is-active')) || tabs[0];
        if (initialActive) setActive(initialActive);
      });

      // 7. Matrix hover + click
      const matrix = document.querySelector('[data-matrix] .dis-matrix__grid');
      if (matrix) {
        const cells = Array.from(matrix.querySelectorAll('.dis-matrix__cell'));
        const heads = Array.from(matrix.querySelectorAll('.dis-matrix__head'));
        const rowHeads = Array.from(matrix.querySelectorAll('.dis-matrix__row-head'));
        const clearHighlight = () => {
          matrix.classList.remove('is-hover-row');
          cells.forEach((c) => c.classList.remove('is-row-active', 'is-col-active'));
          heads.forEach((h) => h.classList.remove('is-active'));
          rowHeads.forEach((h) => h.classList.remove('is-active'));
        };
        cells.forEach((cell) => {
          const row = cell.dataset.row;
          const col = cell.dataset.col;
          cell.addEventListener('mouseenter', () => {
            matrix.classList.add('is-hover-row');
            cells.forEach((c) => {
              c.classList.toggle('is-row-active', c.dataset.row === row);
              c.classList.toggle('is-col-active', c.dataset.col === col);
            });
            heads.forEach((h) => h.classList.toggle('is-active', h.dataset.col === col));
            rowHeads.forEach((h) => h.classList.toggle('is-active', h.dataset.row === row));
          });
          cell.addEventListener('mouseleave', clearHighlight);
          cell.addEventListener('click', () => {
            const targetTabId = cell.dataset.tabJump;
            const tab = targetTabId && document.getElementById(targetTabId);
            if (tab) {
              tab.click();
              tab.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
              tab.focus();
            }
          });
        });
      }

      // 8. FAQ category filter
      const faqFilter = document.querySelector('[data-faq-filter]');
      const faqList = document.querySelector('[data-faq-list]');
      if (faqFilter && faqList) {
        const chips = Array.from(faqFilter.querySelectorAll('.dis-faq-chip'));
        const items = Array.from(faqList.querySelectorAll('.dis-faq__item'));
        chips.forEach((chip) => {
          chip.addEventListener('click', () => {
            const cat = chip.dataset.faqCat;
            chips.forEach((c) => {
              const on = c === chip;
              c.classList.toggle('is-active', on);
              c.setAttribute('aria-selected', on ? 'true' : 'false');
            });
            items.forEach((item) => {
              const matches = cat === 'All' || item.dataset.faqCat === cat;
              item.classList.toggle('is-hidden', !matches);
            });
          });
        });
      }
    })();
  </script>
</Layout>
