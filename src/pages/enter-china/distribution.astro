          aria-label="Filter FAQs by category"
        >
          {
            faqCategories.map((c, i) => (
              <button
                type="button"
                class={`dis-faq-chip${i === 0 ? ' is-active' : ''}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-faq-cat={c}
              >
                <span class="dis-faq-chip__label">{c}</span>
                <span class="dis-faq-chip__count">
                  {c === 'All' ? faqs.length : faqs.filter((f) => f.cat === c).length}
                </span>
              </button>
            ))
          }
        </div>

        <div class="dis-faq" data-faq-list>
          {
            faqs.map((f, i) => (
              <details
                class="dis-faq__item dis-reveal"
                data-faq-cat={f.cat}
                open={i === 0}
                style={`--reveal-delay: ${Math.min(i, 6) * 40}ms;`}
