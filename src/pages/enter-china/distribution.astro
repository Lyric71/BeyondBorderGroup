                                    <polyline points="5 12 10 17 19 8" />
                                  </svg>
                                </span>
                                <span>{b}</span>
                              </li>
                            ))}
                          </ul>
                        </div>

                        <div class="dis-phase__col">
                          <span class="dis-phase__col-label">Deliverables</span>
                          <ul class="dis-phase__docs">
                            {p.deliverables.map((d, j) => (
