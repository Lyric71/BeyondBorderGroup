    ],
    they: [
      'Brief and scoping',
      'Longlist from Compass',
      'Due diligence and reference checks',
      'Negotiation and contract drafting',
    ],
    pricing:
      'Project fee. Quoted in the first call once the brief is clear. No commission from distributors.',
    highlight: false,
    ctaText: 'Talk about a sourcing project',
  },
  {
    name: 'Source and stay',
    tag: 'Long-term partnership',
    tagline: 'Find the partner. Keep the brand intact.',
    image: '/Images/enter-china/dist-route-agency.png',
    imageAlt:
      'A Chinese marketing team running Tmall and Douyin operations for a foreign brand in a Shanghai office',
    desc: 'We source the distributor and stay on as your local team. Brand guardian, marketing operator, monthly business reviews. The contract becomes the start of the relationship, not the finish line.',
    when: 'You do not have an Asia team, the China P&L is strategic, or your last distributor partnership drifted and you need someone in-country protecting the brand.',
    split: { you: 30, them: 70, themLabel: 'TheChinaPath' },
    dims: [
      { label: 'Budget required', value: 'Medium', level: 3 },
      { label: 'Speed to signed', value: 'Fast', level: 4 },
      { label: 'Local presence after', value: 'High', level: 5 },
      { label: 'Brand control', value: 'Shared', level: 3 },
    ],
