const promises = [
  {
    title: 'A partner database competitors do not have',
    desc: 'Compass holds fifteen years of vetted distributor relationships across beauty, F&B, fashion, wellness and pet. Hand-vetted, met in person, kept current. Not scraped off Alibaba.',
  },
  {
    title: 'No commission from distributors. Ever.',
    desc: 'We bill you on the engagement. Distributors do not pay us referral fees. That keeps our incentive on finding the right partner, not the fastest deal.',
  },
  {
    title: 'We stay after the signature',
    desc: 'Most agencies disappear once the contract is signed. We stay on as your brand guardian, your marketing team or your eyes inside the operation. Whatever the contract needs.',
  },
];

const phases = [
  {
    icon: 'blueprint',
    phase: 'Phase one',
    duration: '1 to 2 weeks',
    title: 'Brief and scoping',
    image: '/Images/enter-china/dist-phase-1-scoping.png',
    imageAlt:
      'A foreign brand founder and a Chinese distribution consultant reviewing a category brief in a Shanghai conference room',
    intro:
      'We sit with you to define category, positioning, volumes, margins and the kind of partner that fits. The brief that comes out of this meeting drives everything downstream.',
    outcome: 'A written category brief signed off by both sides, plus a clear partner profile.',
    does: [
      'Category, volumes, target SKUs and margin walk-through',
      'Channel and city tier strategy review',
      'Distributor profile definition (size, region, channel mix)',
      'Regulatory check (NMPA, SAMR) and timeline impact',
    ],
    deliverables: [
      { kind: 'doc', name: 'Category brief and partner profile' },
      { kind: 'sheet', name: 'Target volume and pricing grid' },
      { kind: 'report', name: 'Regulatory readiness check' },
    ],
  },
  {
    icon: 'diagnosis',
    phase: 'Phase two',
    duration: '2 to 3 weeks',
    title: 'Longlist from Compass',
    image: '/Images/enter-china/dist-phase-2-longlist.png',
    imageAlt:
      'A senior consultant reviewing eight to twelve distributor partner profiles on a desk and laptop in Shanghai',
    intro:
      'We pull a longlist of 8 to 12 candidates from Compass, our partner database. Distributors we know personally, met in the last twelve months, with active retail or platform credentials.',
    outcome: 'A longlist of 8 to 12 qualified names, each with a one-page profile.',
    does: [
      'Pull candidates from Compass by category and channel',
      'Cross-check active retail or platform credentials',
      'Confirm category fit, scale and SKU appetite',
      'Refresh the file if anyone has gone quiet in the last quarter',
    ],
    deliverables: [
      { kind: 'sheet', name: 'Longlist with profiles and contact tier' },
      { kind: 'doc', name: 'Category fit notes for each candidate' },
      { kind: 'report', name: 'Channel coverage map' },
    ],
  },
  {
    icon: 'benchmark',
    phase: 'Phase three',
    duration: '3 to 4 weeks',
    title: 'Shortlist, interviews and due diligence',
    image: '/Images/enter-china/dist-phase-3-shortlist.png',
    imageAlt:
      'A video call between a foreign brand team and a Chinese distributor candidate, shortlist printouts on the desk',
    intro:
      'We narrow to three to five finalists, run the calls with you, translate where useful, and put each one through financial, licensing and reference checks.',
    outcome: 'Three to five finalists with full diligence files, ready to negotiate.',
    does: [
      'Shortlist interviews (we sit on your side, translate live)',
      'Financial and license verification',
      'Warehouse, logistics and platform-account inspection',
      'Reference checks with current and former brand partners',
      'Track-record audit on Tmall, JD, Douyin if relevant',
    ],
    deliverables: [
      { kind: 'deck', name: 'Shortlist comparison book (deck)' },
      { kind: 'doc', name: 'Due diligence file per candidate' },
      { kind: 'sheet', name: 'Side-by-side commercial offers' },
    ],
  },
  {
    icon: 'handshake',
    phase: 'Phase four',
    duration: 'Variable',
    title: 'Negotiation and signature',
    image: '/Images/enter-china/dist-phase-4-negotiation.png',
    imageAlt:
      'A contract negotiation moment between two parties at a polished conference table in a Shanghai law firm',
    intro:
      'Territory, exclusivity, pricing, MOQ, payment terms, marketing contribution, brand protection, termination. We sit at the table with you, in Mandarin and English, until the contract works for both sides.',
    outcome: 'A signed distribution contract you can defend in court. Plus a clean handover plan.',
    does: [
      'Term sheet drafting and bilingual negotiation',
      'Exclusivity, territory and channel-split clauses',
      'MOQ, payment terms and marketing contribution carve-outs',
      'Brand protection, IP and termination clauses',
      'Handover plan with first-90-day milestones',
    ],
    deliverables: [
      { kind: 'doc', name: 'Signed distribution contract (bilingual)' },
      { kind: 'sheet', name: '90-day handover and KPI tracker' },
      { kind: 'report', name: 'Brand-protection playbook' },
    ],
  },
];

const docIcons: Record<string, string> = {
  doc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>`,
  sheet: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><line x1="4" y1="10" x2="20" y2="10"/><line x1="10" y1="4" x2="10" y2="20"/></svg>`,
  deck: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="1"/><line x1="12" y1="17" x2="12" y2="21"/><line x1="8" y1="21" x2="16" y2="21"/></svg>`,
  report: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"/><path d="M15 2v5h5"/><path d="M9 13l2 2 4-4"/></svg>`,
  diagram: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="6" height="6" rx="1"/><rect x="15" y="3" width="6" height="6" rx="1"/><rect x="9" y="15" width="6" height="6" rx="1"/><path d="M6 9v3h12V9"/><path d="M12 12v3"/></svg>`,
};

const models = [
  {
    name: 'Source and step back',
    tag: 'Project engagement',
    tagline: 'Find the partner. Hand the keys back.',
    image: '/Images/enter-china/dist-route-agent.png',
    imageAlt:
      'A Chinese sales agent reviewing distributor reports with a foreign brand operator in a Shanghai office',
    desc: 'We run the full sourcing process from brief to signed contract. Once the distributor is on board, we hand over and step back. You run the relationship yourself.',
    when: 'You have a China rep on the team, you want to keep the operating budget tight, or you simply need the right partner without the long retainer.',
    split: { you: 80, them: 20, themLabel: 'TheChinaPath' },
    dims: [
      { label: 'Budget required', value: 'Low', level: 1 },
      { label: 'Speed to signed', value: 'Fast', level: 4 },
      { label: 'Local presence after', value: 'Low', level: 1 },
      { label: 'Brand control', value: 'Full', level: 5 },
    ],
    youGet: [
      'Signed distribution contract',
      'Vetted shortlist of finalists',
      'Bilingual negotiation support',
