                  </span>
                </summary>
                <div class="dis-faq__a">
                  <p>{f.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- FINAL CTA ---------- */}
    <CaseStudyStrip slugs={["langnese","mission-foods","valio"]} />

    <section class="section section--tight">
      <div class="container container--narrow">
        <div class="dis-cta">
          <span class="eyebrow eyebrow--on-dark">Let's talk</span>
