---
import Layout from '../../layouts/Layout.astro';

// ---- Key drivers, shown as sliders at the top of the calculator ----
type Driver = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number';
  min: string;
  max: string;
  step: string;
  hint?: string;
};

const drivers: Driver[] = [
  { id: 'gmv', label: 'Target Year 1 GMV', value: '2000000', kind: 'money', min: '200000', max: '10000000', step: '100000' },
  { id: 'aov', label: 'Average order value', value: '250', kind: 'money', min: '20', max: '500', step: '5' },
  { id: 'gmvGrowth', label: 'Year 2 GMV growth', value: '50', kind: 'percent', min: '0', max: '200', step: '5' },
  { id: 'dpRetainer', label: 'DP monthly retainer', value: '30000', kind: 'money', min: '20000', max: '150000', step: '5000' },
  { id: 'coFund', label: 'Campaign co-fund', value: '0', kind: 'money', min: '0', max: '300000', step: '10000' },
  { id: 'dpCommission', label: 'DP commission on GMV', value: '5', kind: 'percent', min: '0', max: '12', step: '0.5' },
  { id: 'paidShare', label: 'Paid media', value: '15', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolShare', label: 'KOLs', value: '80', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'organicShare', label: 'Organic', value: '5', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolCommission', label: 'KOL commission rate', value: '20', kind: 'percent', min: '0', max: '40', step: '1' },
  { id: 'roas', label: 'ROAS (return on ad spend)', value: '2.5', kind: 'number', min: '0.5', max: '6', step: '0.1' },
];

// The three channel shares are grouped together and must always total 100%.
const shareIds = ['paidShare', 'kolShare', 'organicShare'];
const mainDrivers = drivers.filter((d) => !shareIds.includes(d.id));
const shareDrivers = drivers.filter((d) => shareIds.includes(d.id));

// Year 2 carries its own mix: organic normally climbs once the channel matures,
// which is what makes the second year cheaper to run.
const shareDrivers2: Driver[] = [
  { id: 'paidShare2', label: 'Paid media', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'kolShare2', label: 'KOLs', value: '60', kind: 'percent', min: '0', max: '100', step: '1' },
  { id: 'organicShare2', label: 'Organic', value: '20', kind: 'percent', min: '0', max: '100', step: '1' },
];
const mixRows = [
  { year: '1', title: 'Year 1', drivers: shareDrivers, noteId: 'mix-note' },
  { year: '2', title: 'Year 2', drivers: shareDrivers2, noteId: 'mix-note-2' },
];

// ---- Advanced inputs, grouped in the collapsible section ----
type Field = {
  id: string;
  label: string;
  value: string;
  kind: 'money' | 'percent' | 'number' | 'select';
  step?: string;
  hint?: string;
  fx?: boolean;
  readonly?: boolean;
  suffix?: string;
  options?: { value: string; label: string; deposit?: string; fee?: string }[];
};

// CBEC 抖音全球购 categories. Each one sets the platform deposit and the tech
// service fee, the only two model inputs that move with product category
// (see Section 8 of the model spec). Fee is the mid of the published band.
const categories: { value: string; label: string; deposit: string; fee: string }[] = [
  { value: 'food-packaged', label: 'Packaged food (grain, oil, dry goods, seasoning)', deposit: '50000', fee: '4' },
  { value: 'snacks', label: 'Snacks, nuts, specialty', deposit: '50000', fee: '5' },
  { value: 'drinks', label: 'Coffee, oats, drink powders', deposit: '50000', fee: '5' },
  { value: 'tea', label: 'Tea', deposit: '50000', fee: '2' },
  { value: 'supplements', label: 'Dietary supplements', deposit: '50000', fee: '4' },
  { value: 'tonics', label: "Traditional tonics (bird's nest and the like)", deposit: '200000', fee: '5' },
  { value: 'alcohol', label: 'Alcohol', deposit: '100000', fee: '5' },
  { value: 'skincare', label: 'Skincare', deposit: '100000', fee: '5' },
  { value: 'makeup', label: 'Makeup, fragrance', deposit: '100000', fee: '5' },
  { value: 'beauty-device', label: 'Beauty and personal-care devices', deposit: '100000', fee: '4' },
  { value: 'personal-care', label: 'Personal care', deposit: '50000', fee: '4' },
  { value: 'home', label: 'Home, bedding, kitchenware', deposit: '50000', fee: '3' },
  { value: 'appliances', label: 'Small appliances', deposit: '75000', fee: '4' },
  { value: '3c', label: '3C accessories, cameras', deposit: '50000', fee: '4' },
  { value: 'phones', label: 'Phones, laptops, tablets', deposit: '100000', fee: '2.5' },
  { value: 'apparel', label: 'Apparel, underwear', deposit: '100000', fee: '5' },
  { value: 'footwear', label: 'Footwear', deposit: '100000', fee: '5' },
  { value: 'bags', label: 'Bags, belts, accessories', deposit: '100000', fee: '5' },
  { value: 'jewellery', label: 'Fashion jewellery', deposit: '100000', fee: '5.5' },
  { value: 'sports', label: 'Sports, outdoor', deposit: '75000', fee: '5' },
  { value: 'infant-formula', label: 'Infant formula', deposit: '100000', fee: '4' },
  { value: 'baby', label: 'Baby products, toys', deposit: '50000', fee: '5' },
  { value: 'pet', label: 'Pet food, supplies', deposit: '50000', fee: '5' },
  { value: 'custom', label: 'Custom (set the deposit and fee by hand)', deposit: '', fee: '' },
];

const gicon = {
  tax: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  platform: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 18v3"/></svg>`,
  kol: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-5v12L3 15z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>`,
  logistics: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h12v9H2z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>`,
  media: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10v4a1 1 0 0 0 1 1h2l9 5V4L6 9H4a1 1 0 0 0-1 1z"/><path d="M18 9a4 4 0 0 1 0 6"/></svg>`,
  margin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l3-4 3 2 4-6"/></svg>`,
};

const groups: { title: string; icon: string; note?: string; fields: Field[] }[] = [
  {
    title: 'Category',
    icon: gicon.platform,
    note: 'Pick your product category. On 抖音全球购 the deposit and the tech service fee both move with the category, so this sets the two numbers below. Your DP may quote something different; override by hand if so.',
    fields: [
      {
        id: 'category',
        label: 'Product category (CBEC 抖音全球购)',
        value: 'food-packaged',
        kind: 'select',
        options: categories,
      },
    ],
  },
  {
    title: 'FX and tax',
    icon: gicon.tax,
    fields: [
      { id: 'fx', label: 'USD / RMB exchange rate', value: '7.1', kind: 'number', step: '0.01', fx: true },
      { id: 'cbecTax', label: 'Cross-border import tax (综合税)', value: '9.1', kind: 'percent', step: '0.1', hint: '13% VAT on 70% of retail value. Most food and home goods carry no consumption tax.' },
    ],
  },
  {
    title: 'Platform and DP',
    icon: gicon.platform,
    fields: [
      { id: 'period', label: 'Engagement period', value: '12', kind: 'number', readonly: true, suffix: 'months', hint: 'Fixed. The model prices a full twelve-month run; every yearly figure follows this window.' },
      { id: 'platformDeposit', label: 'Douyin 全球购 platform deposit', value: '50000', kind: 'money', hint: 'Refundable when the store closes. Set by your category above.' },
      { id: 'techFee', label: 'Platform tech service fee', value: '4', kind: 'percent', step: '0.1', hint: 'Taken on each sale. Set by your category above.' },
      { id: 'agentFee', label: 'Customs clearance agent, annual', value: '0', kind: 'money', hint: 'Optional. Many brands let the DP or the bonded warehouse act as the 境内代理人, so leave it at zero unless you retain a separate one.' },
      { id: 'trademark', label: 'CN trademark registration', value: '0', kind: 'money' },
      { id: 'brandSetup', label: 'Brand setup contribution', value: '25000', kind: 'money' },
    ],
  },
  {
    title: 'Logistics',
    icon: gicon.logistics,
    fields: [
      { id: 'whDeposit', label: 'Bonded warehouse deposit', value: '100000', kind: 'money' },
      { id: 'whTaxPrepay', label: 'Bonded warehouse tax prepayment', value: '300000', kind: 'money' },
      { id: 'storage', label: 'Warehouse storage per unit per month', value: '0.8', kind: 'number', step: '0.1' },
      { id: 'fulfillment', label: 'Fulfillment per order (pick and pack)', value: '4', kind: 'money', step: '0.5' },
      { id: 'shipping', label: 'Last-mile shipping per parcel', value: '11', kind: 'money' },
      { id: 'returnRate', label: 'Return rate', value: '5', kind: 'percent', step: '0.1' },
      { id: 'returnHandling', label: 'Return handling per parcel', value: '15', kind: 'money' },
    ],
  },
  {
    title: 'Your economics',
    icon: gicon.margin,
    note: 'Add your gross margin per order to unlock the operating profit or loss for both years and your breakeven GMV. The launch content and the trademark are written off over the amortization period below; the refundable deposits never hit the P&L.',
    fields: [
      { id: 'grossMargin', label: 'Gross margin per order', value: '75', kind: 'percent' },
      { id: 'amortYears', label: 'Setup amortization period', value: '3', kind: 'number', step: '1', suffix: 'years', hint: 'The launch content and the trademark are written off in equal parts over this many years. Three is the common convention.' },
    ],
  },
];

const steps = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M3 11h18M7 15h4"/></svg>`,
    title: 'You fund',
    body: 'Platform and bonded deposits, trademark, launch content. The one-time money that gets the store live.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>`,
    title: 'The DP runs',
    body: 'A Douyin Partner (DP) owns the team and runs the storefront and livestreams day to day.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4v10.5a3.5 3.5 0 1 1-3-3.46"/><path d="M9 4c.4 2.4 2.2 4.2 4.6 4.6"/></svg>`,
    title: 'Creators sell',
    body: 'KOLs move the volume on commission. Paid media on 千川 warms the algorithm and fills the room.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 2 5-6"/></svg>`,
    title: 'You measure',
    body: 'The calculator totals every line, splits setup from running cost, and flags what comes back on exit.',
  },
];

const perks = [
  'Year 1 and Year 2, side by side',
  'Full cost stack in RMB and USD',
  'Cost per order vs your AOV',
  'Refundable deposits vs real burn',
  'Breakeven GMV from your margin',
];

// Plain-English explanation for every field, shown in the overlay bubble.
const help: Record<string, string> = {
  gmv: 'Gross Merchandise Value is the total sales you expect the Douyin channel to bring in over its first twelve months, before any cost is taken out. It is the top line the whole model scales from. If you are unsure, start with a conservative target and raise it once the channel proves itself.',
  aov: 'The average amount a shopper spends in a single order. Take your expected first-year sales and divide by the number of orders and you land here. It decides how many parcels you ship, which in turn drives your logistics and returns cost.',
  paidShare:
    "The slice of your sales pushed by paid advertising on Douyin's ad platform (千川 Qianchuan), rather than by organic reach or a creator's own following. Turn it up and you spend more on ads to hit the same sales number. Paid also works as the amplifier behind your creators: Qianchuan can take a KOL video that already converts and buy it more reach, which shortens the cold start and steadies weekly volume. In 2025 Douyin merged Qianchuan into its e-commerce arm and unified the paid and organic algorithms, so a channel with no ad budget leaves reach on the table.",
  dpRetainer:
    'The flat monthly fee your Douyin Partner charges to run the channel: the storefront, the livestream calendar, ad operations, customer service. Over a year it is usually the single biggest line. Retainers run from about 30,000 RMB a month for a lean setup to 100,000 for the international-brand tier.',
  dpCommission:
    'A percentage the DP takes on the sales they generate, on top of the retainer. The international-brand tier sits at 5 to 8 percent, and the industry caps it near 10 percent. This is separate from the paid media you fund directly.',
  category:
    'Your product category on the cross-border store (抖音全球购). It sets two numbers: the platform deposit and the tech service fee, which both change by category. Pick the closest fit and the fields below fill in. Choose Custom to type your own.',
  kolCommission:
    'The cut a livestream host or short-video creator keeps on each sale they drive. It is pure commission, paid only when they actually sell. Food and agricultural products tend to sit around 8 to 20 percent; beauty and luxury run higher.',
  roas:
    'Return On Ad Spend is sales divided by ad spend. A ROAS of 2.5 means every 1 RMB of ads brings back 2.5 RMB of sales. The breakeven rule of thumb used across the industry in China is 1 divided by your gross margin: at a 40% margin you need 2.5 just to cover the product economics, and high-return categories need closer to 4. A fresh Douyin account tends to run below that in the early months, then climbs as the algorithm learns who to show you to. Set the figure you expect to average across the first year.',
  fx: 'How many RMB one US dollar buys. It only affects the USD figure shown at the end; every calculation runs in RMB. Use the refresh button to pull today’s live rate.',
  cbecTax:
    'The cross-border e-commerce import tax on goods sold through the bonded model. It is 13 percent VAT charged on 70 percent of the retail price, which lands at 9.1 percent of sales for most food and home goods, since they carry no consumption tax. Cosmetics, perfume and alcohol trigger consumption tax and run higher, near 23 percent.',
  period:
    'The model is built on a twelve-month engagement. The GMV target, the DP retainer, the agent fee and the co-fund all cover one full year, and Year 2 in the results shows the same twelve months without the one-time setup. It sits here so the assumption is explicit; it is not adjustable.',
  platformDeposit:
    'A security deposit Douyin holds while your store is open, returned when you close in good standing. The cross-border baseline is 50,000 RMB, and some categories run to 100,000 or 200,000. The category picker sets it for you.',
  techFee:
    'A technology service fee Douyin charges on each sale, taken as a share of GMV. It runs from about 2 to 6 percent depending on the category. The category picker sets it for you.',
  agentFee:
    'An optional yearly fee for a mainland customs agent (境内代理人). Selling cross-border from an offshore entity, you do need a China-registered company to file with customs in your name and carry the liability that comes with it. What you do not need is a separate one: on the bonded model the DP or the warehouse usually takes the role and folds it into their fees, which is why most brands leave this at zero. Add a figure only if you retain a standalone agent.',
  trademark:
    'A one-time cost to register your brand as a trademark in China, in the relevant class. Doing it early protects the name before anyone else can claim it. Roughly 8,000 RMB for a single class.',
  brandSetup:
    'The upfront cost to build the store and its launch content: banner, product listings, a hero photo or video shoot. Paid once, at the start.',
  coFund:
    'A yearly joint fund on top of the DP retainer, earmarked for big moments: Double 11, a brand launch, a hero campaign. It pays for work that sits outside the day-to-day the retainer already covers.',
  kolShare:
    'The share of total sales that flows through creators (livestream and short video), rather than your own store page or ads. It sets how much KOL commission you end up paying. Bear in mind that creators alone rarely carry a brand: platform-wide they drive only about 30% of Douyin GMV, and even standout creator-led brands cap out near 60 to 80% of their own sales, usually with paid traffic working underneath. Head KOLs charge 30 to 50% commission and their volumes swing, which is why most brands shift toward paid and organic as the channel matures.',
  organicShare:
    'Sales that come without paid ads or a creator commission behind them: your own store page, search, followers, reposts. It is whatever is left after paid media and KOLs. A rising organic share is what makes Year 2 cheaper than Year 1.',
  gmvGrowth:
    'How much more the channel sells in Year 2 than in Year 1. A store that survives its first year usually compounds: it has reviews, followers and algorithm history working for it. 50% is a reasonable planning figure for a channel that found its footing; set it to zero to model a flat repeat of Year 1. Every sales-driven cost in the Year 2 column scales with it.',
  paidShare2:
    'The share of Year 2 sales pushed by paid ads. By then the account has history and the algorithm knows your buyer, so many brands hold or trim this line while organic picks up the slack.',
  kolShare2:
    'The share of Year 2 sales that flows through creators. Most brands keep KOLs central in Year 2, just less dominant, as the store page and its followers start selling on their own.',
  organicShare2:
    'The Year 2 share that arrives without ad spend or creator commission: store page, search, followers. This is the number that should climb, and it is the main reason Year 2 runs cheaper than Year 1.',
  whDeposit:
    'A refundable deposit the bonded warehouse holds as working capital while your goods are stored there. You get it back on exit, so it is recoverable rather than sunk.',
  whTaxPrepay:
    'Money paid into the bonded warehouse up front against the import tax on goods as they clear. It is drawn down as shipments enter China, so treat it as money you get back later, not money you spend.',
  storage:
    'What the bonded warehouse charges to store one unit for one month. Multiplied by your order volume and an average two-month dwell time, it becomes your storage bill.',
  fulfillment:
    'The pick, pack and handling cost inside the bonded warehouse for one order, before it ships. This is separate from the last-mile shipping below. Multiply by the number of orders to get the yearly fulfillment bill.',
  shipping:
    "The last-mile delivery cost per parcel, from the bonded warehouse to the shopper's door. Multiply by the number of orders to get the yearly shipping bill. It sits on top of the fulfillment fee.",
  returnRate:
    'The share of orders that come back. Food and CBEC returns are usually low, around five percent. Each return carries a handling cost.',
  returnHandling:
    'What it costs to process one returned parcel: inspection, then restocking or disposal. Multiplied by your return rate and order volume.',
  grossMargin:
    'Your gross margin on a single order: the share of the sale price left after the product cost, but before the Douyin channel costs in this model. The same percentage applies across every order. Enter it to unlock the operating profit or loss for both years and your breakeven GMV.',
  amortYears:
    'How many years the one-time setup is written off over. The launch content and the trademark are real costs, so accounting spreads them across the years they earn their keep rather than dumping the whole bill on Year 1. Three years is the usual convention for this kind of investment. The deposits and the tax prepayment are not in this figure: you get them back, so they are working capital, not cost.',
};

const notes = [
  'Setup is paid once but it is not all a Year 1 cost. The launch content and the trademark are written off over the amortization period you set, so each year carries its share and the operating result is not crushed by a bill it will benefit from for years. The deposits and the tax prepayment are different: you get them back on exit, so they are working capital and never reach the profit and loss at all. That is why the cash column and the profit column disagree, and both are right.',
  'The model runs cross-border only, through the bonded warehouse (抖音全球购). The warehouse deposit and the tax prepayment come back to you on exit, so the calculator counts them as money you get back, not money you spend.',
  'The DP retainer plus its commission on GMV is one of the largest lines, alongside paid media. Paid media on 千川 is funded by you directly into the ad account, not billed through the DP. That split is deliberate: DPs that try to front the ad spend tend to fall over.',
  'The DP runs Douyin only. Their team cost sits inside the retainer and the commission, so there is no separate headcount line. KOL commission is billed apart, on sales the creators actually drive.',
  'A pure KOL mix is a launch tactic, not an end state. Creator livestreams account for roughly 30% of Douyin GMV platform-wide, top hosts take 30 to 50% commission, and their volumes are hard to repeat month over month. Brands that scale on Douyin pair creators with 千川 paid media, which re-runs the creator content that already converts, and let organic and store traffic climb from there.',
  'ROAS is one number here: what you expect the account to average across the first year. A fresh Douyin account runs low in the early months and climbs once the algorithm learns who to show you to, so set a blended figure rather than a best case.',
  'The platform deposit and the tech service fee move with your product category. Pick a category in the fine-tune panel and both fill in from the published cross-border bands.',
  'Year 1 usually runs at a loss at RMB 2M GMV. The table sets Year 1 against Year 2, when the one-time setup drops off, the channel mix switches to your Year 2 sliders and GMV steps up by your growth assumption. Breakeven GMV shows the scale you need for gross profit to cover the bill, and it often lands several times above a first-year target.',
];

const refreshIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>`;
---

<Layout
  title="Douyin cross-border cost calculator | TheChinaPath"
  description="Estimate what it costs to set up and run a cross-border Douyin channel in China through a Douyin Partner. Works for any product category. Bonded logistics, KOL commission, paid media, tax and platform fees, in RMB and USD."
>
  <section
    class="tool-hero tool-hero--image"
    style="--tool-hero-img: url('/Images/tools/douyin-hero-bg.png')"
  >
    <div class="container tool-hero__inner">
      <nav class="tool-hero__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/tools">Calculators</a>
        <span aria-hidden="true">/</span>
        <span>Douyin cross-border cost</span>
      </nav>
      <span class="eyebrow">Cost calculator</span>
      <h1 class="tool-hero__title">What a cross-border Douyin channel <em>really</em> costs.</h1>
      <p class="tool-hero__lead">
        Model what it costs to sell on Douyin through a Douyin Partner (DP), on the cross-border
        bonded model (抖音全球购), across your first two years. It works for any product category.
      </p>
      <div class="tool-hero__meta">
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">Year 1 + 2</span>
          <span class="tool-hero__meta-label">the cost stack, side by side</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">RMB + USD</span>
          <span class="tool-hero__meta-label">the full cost stack, both currencies</span>
        </div>
        <div class="tool-hero__meta-item">
          <span class="tool-hero__meta-num">Live</span>
          <span class="tool-hero__meta-label">every assumption is yours to change</span>
        </div>
      </div>
      <a href="#calculator" class="tool-hero__scroll">
        <span>Start calculating</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
      </a>
    </div>
  </section>

  {/* ---------- How it works ---------- */}
  <section class="section calc-how">
    <div class="container">
      <div class="calc-how__head reveal">
        <span class="eyebrow">How the model works</span>
        <h2 class="calc-how__title">Four moving parts, two years of cost.</h2>
      </div>
      <ol class="calc-flow">
        {
          steps.map((s, idx) => (
            <li class="calc-flow__step reveal" style={`--i:${idx}`}>
              <span class="calc-flow__icon" set:html={s.icon} />
              <h3 class="calc-flow__step-title">{s.title}</h3>
              <p class="calc-flow__step-body">{s.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="calc-perks reveal">
        <span class="calc-perks__label">What you get</span>
        <ul class="calc-perks__list">
          {
