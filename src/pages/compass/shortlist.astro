---
/**
 * WO-2.1 and WO-2.2 — /compass/shortlist
 * 301 target for compass.bearingbridge.com/en/contact.
 *
 * The brief form. Fields per the spec: company, category, stage, what they are
 * trying to solve, contact. It posts to /api/contact, the site's existing
 * handler, so submissions land in the same inbox as every other enquiry and no
 * new form service is introduced. The `source` field tags it as a Compass brief
 * on arrival. Confirmation reuses the existing /thank-you pattern.
 *
 * The captcha, honeypot and status-message behaviour are the same as
 * /contact.astro, deliberately: one pattern, one set of bugs.
 */
import Layout from '../../layouts/Layout.astro';
import { STEPS, CATEGORIES, NO_COMMISSION, APP_URL } from '../../data/compass';

const stages = [
  'Not in China yet, working out the model',
  'Entering now, need a first partner',
  'Already selling, replacing a partner',
  'Already selling, adding a channel or region',
];

const title = 'Get your China partner shortlist | Compass | TheChinaPath';
const description =
  'Brief us on your category and your stage. We come back with a shortlist of China distributors and platform partners worth meeting, usually in two to three weeks.';
---

<Layout title={title} description={description}>
  <section class="section section--dark cmp-hero">
    <div class="container">
      <span class="eyebrow">Get your shortlist</span>
      <h1 class="h1">Tell us a little about your brand.</h1>
      <p class="lead cmp-hero__lead">
        A few quick questions to get the conversation started. The first call is short and there is
        no obligation on either side. A senior partner will write back inside one working day, not a
        form-letter from an intake bot.
      </p>
      <p class="cmp-hero__body">{NO_COMMISSION}</p>
    </div>
  </section>

  <section class="section">
    <div class="container sl-layout">
      <!-- The form -->
      <div class="sl-form-card">
        <h2 class="sl-form-title">Brief us</h2>
        <form class="form" id="shortlist-form" novalidate>
          <div class="form__row form__row--2">
            <div class="field">
              <label class="field__label" for="name"
                >Your name <span aria-hidden="true">*</span></label
              >
              <input
                class="field__input"
                type="text"
                id="name"
                name="name"
                autocomplete="name"
                required
              />
            </div>
            <div class="field">
              <label class="field__label" for="email"
                >Work email <span aria-hidden="true">*</span></label
              >
              <input
                class="field__input"
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
              />
            </div>
          </div>

          <div class="form__row form__row--2">
            <div class="field">
              <label class="field__label" for="company"
                >Company <span aria-hidden="true">*</span></label
              >
              <input
                class="field__input"
                type="text"
                id="company"
                name="company"
                autocomplete="organization"
                required
              />
            </div>
            <div class="field">
              <label class="field__label" for="website">Website</label>
              <input
                class="field__input"
                type="url"
                id="website"
                name="website"
                autocomplete="url"
                placeholder="https://"
              />
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="category"
              >Category <span aria-hidden="true">*</span></label
            >
            <select class="field__input" id="category" name="category" required>
              <option value="">Choose a category</option>
              {CATEGORIES.map((c) => <option value={c}>{c}</option>)}
              <option value="Other">Something else</option>
            </select>
          </div>

          <fieldset class="field field--fieldset">
            <legend class="field__label">
              Where you are today <span aria-hidden="true">*</span>
            </legend>
            {
              stages.map((s, i) => (
                <label class="sl-radio">
                  <input type="radio" name="stage" value={s} required={i === 0} />
                  <span>{s}</span>
                </label>
              ))
            }
          </fieldset>

          <div class="field">
            <label class="field__label" for="message"
              >What are you trying to solve? <span aria-hidden="true">*</span></label
            >
            <textarea
              class="field__input field__textarea"
              id="message"
              name="message"
              rows="5"
              placeholder="The channel you are aiming at, the timeline you are working to, and anything that has already been tried."
              required></textarea>
          </div>

          <div class="field field--captcha">
            <label class="field__label" for="captcha">
              A quick check to keep bots out: what is <span id="captchaA">?</span> + <span
                id="captchaB">?</span
              >?
              <span aria-hidden="true">*</span>
            </label>
            <input
              class="field__input field__input--captcha"
              type="text"
              inputmode="numeric"
              pattern="[0-9]*"
              id="captcha"
              name="captcha"
              autocomplete="off"
              required
            />
          </div>

          {/* honeypot, bots fill this, humans don't see it */}
          <div class="form__honeypot" aria-hidden="true">
            <label for="website_url">Leave this field empty</label>
            <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form__footer">
            <button type="submit" class="btn btn--primary form__submit" id="shortlist-submit">
              Send the brief
            </button>
            <p class="form__note">
              By sending this form, you allow us to come back to you about your enquiry. Your
              details stay strictly with our team.
            </p>
          </div>

          <p class="form__status" id="shortlist-status" role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- What happens next -->
      <aside class="sl-aside">
        <span class="eyebrow">What happens next</span>
        <h2 class="h3">Three steps, two or three weeks.</h2>
        <div class="sl-steps">
          {
            STEPS.items.map((step) => (
              <div class="sl-step">
                <p class="sl-step__label">{step.label}</p>
                <p class="sl-step__body">{step.body}</p>
              </div>
            ))
          }
        </div>
        <p class="sl-aside__note">
          Already a Compass partner? Sign in at <a href={APP_URL}>compass.thechinapath.com</a>.
        </p>
      </aside>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    const form = document.getElementById('shortlist-form');
    if (!form) return;
    const status = document.getElementById('shortlist-status');
    const submit = document.getElementById('shortlist-submit');
    const captchaA = document.getElementById('captchaA');
    const captchaB = document.getElementById('captchaB');
    const captchaInput = document.getElementById('captcha');

    function rollCaptcha() {
      const a = 1 + Math.floor(Math.random() * 9);
      const b = 1 + Math.floor(Math.random() * 9);
      captchaA.textContent = a;
      captchaB.textContent = b;
      form.dataset.captchaSum = String(a + b);
      if (captchaInput) captchaInput.value = '';
    }
    rollCaptcha();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.className = 'form__status';

      const data = new FormData(form);
      if (data.get('website_url')) return; // honeypot tripped, silently drop

      const category = String(data.get('category') || '').trim();
      const stage = String(data.get('stage') || '').trim();

      const payload = {
        source: 'Compass shortlist',
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        company: String(data.get('company') || '').trim(),
        website: String(data.get('website') || '').trim(),
        services: category ? [category] : [],
        budget: '',
        profile: stage,
        message: String(data.get('message') || '').trim(),
        captcha: String(data.get('captcha') || '').trim(),
        captchaExpected: String(form.dataset.captchaSum || ''),
      };

      const captchaNum = parseInt(payload.captcha, 10);
      const expectedNum = parseInt(payload.captchaExpected, 10);
      if (!Number.isFinite(captchaNum) || captchaNum !== expectedNum) {
        status.textContent =
          'That result is not quite right. The numbers have just refreshed, please try again.';
        status.classList.add('form__status--error');
        rollCaptcha();
        return;
      }

      if (!payload.name || !payload.email || !payload.company || !category || !stage) {
        status.textContent = 'Please fill in your name, email, company, category and stage.';
        status.classList.add('form__status--error');
        return;
      }
      if (!payload.message) {
        status.textContent = 'Please tell us in a line or two what you are trying to solve.';
        status.classList.add('form__status--error');
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Sending the brief…';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok)
          throw new Error(
            body.error ||
              'The brief did not go through. Please try again in a moment. If it keeps failing, you can write to us directly at hello@thechinapath.com.',
          );

        form.reset();
        rollCaptcha();
        status.textContent = 'Brief received. We will come back to you shortly. Redirecting…';
        status.classList.add('form__status--success');
        window.location.assign('/thank-you');
        return;
      } catch (err) {
        status.textContent =
          err && err.message
            ? err.message
            : 'The brief did not go through. Please try again in a moment. If it keeps failing, you can write to us directly at hello@thechinapath.com.';
        status.classList.add('form__status--error');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Send the brief';
      }
    });
  })();
</script>

<style>
  .cmp-hero .h1 {
    max-width: 18ch;
  }

  .sl-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }
  @media (max-width: 980px) {
    .sl-layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .sl-form-card {
    background: var(--bbg-white);
    border: 1px solid var(--bbg-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }
  @media (max-width: 560px) {
    .sl-form-card {
      padding: var(--space-5);
    }
  }
  .sl-form-title {
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-5);
  }

  .field--fieldset {
    border: none;
    padding: 0;
    margin: 0 0 var(--space-5);
  }
  .sl-radio {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    line-height: 1.5;
    cursor: pointer;
  }
  .sl-radio input {
    margin-top: 0.3em;
    accent-color: var(--bbg-blue);
  }

  .sl-aside {
    position: sticky;
    top: 7rem;
  }
  @media (max-width: 980px) {
    .sl-aside {
      position: static;
    }
  }
  .sl-steps {
    margin-top: var(--space-5);
  }
  .sl-step {
    border-top: 2px solid var(--bbg-blue);
    padding-top: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .sl-step__label {
    font-weight: 600;
    color: var(--bbg-ink);
    margin-bottom: var(--space-2);
  }
  .sl-step__body {
    font-size: var(--fs-small);
    color: var(--bbg-text-muted);
    line-height: 1.6;
  }
  .sl-aside__note {
    font-size: var(--fs-small);
    color: var(--bbg-text-muted);
    padding-top: var(--space-4);
    border-top: 1px solid var(--bbg-border);
  }
  .sl-aside__note a {
    color: var(--bbg-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
